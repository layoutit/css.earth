---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from './SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

const { editUrl, object } = Astro.locals.starlightRoute.entry.data;
---
{/* One header across the sidebar, the README and the scene. */}
<div class="sb-header">
  <SiteTitle />
  <Search />
  <div class="sb-header-tools">
    {object?.appUrl && <a class="sb-tool-button" href={object.appUrl}>Open in cssEarth</a>}
    {typeof editUrl === 'string' && <a class="sb-tool-button" href={editUrl}>Edit README</a>}
    <SocialIcons />
  </div>
</div>
