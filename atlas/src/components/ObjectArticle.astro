---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { REPOSITORY_URL } from '../objects.mts';

const { title, description, editUrl, object } = Astro.locals.starlightRoute.entry.data;
const rows = object ? [
  { name: 'Classification', value: object.groupLabel },
  ...(object.status ? [{ name: 'Status', value: object.status }] : []),
  ...(object.system ? [{ name: 'System', value: object.system }] : []),
  ...object.facts.map(fact => ({ name: fact.label, value: fact.value })),
  { name: 'Minimaps', value: String(object.maps) },
  { name: 'Unresolved investigations', value: String(object.openQuestions) },
  { name: 'Source files', value: `${object.sourceFiles} (${object.sourceSize})` },
  { name: 'Runtime assets', value: object.runtimeSize },
] : [];
---
<Default>
  {object ? <div class="sb-viewer">
    <article class="sb-readme">
      <header class="sb-readme-head not-content">
        <div>
          <h1 id="_top">{title}</h1>
          {description && <p class="sb-subtitle">{description}</p>}
        </div>
        <div class="sb-readme-tools">
          {object.appUrl && <a class="sb-tool-button" href={object.appUrl}>Open in cssEarth</a>}
          {typeof editUrl === 'string' && <a class="sb-tool-button" href={editUrl}>Edit README</a>}
        </div>
      </header>
      <slot />
    </article>
    {/* Storybook's canvas mode after the docs: the preview above an addon panel. */}
    <section class="sb-object not-content" aria-label={`${title} viewer`}>
      <figure class="sb-canvas">
        <div class="sb-canvas-stage">
          {object.sceneUrl ? <iframe class="sb-scene" src={object.sceneUrl} title={`${title} scene`} loading="eager" allow="fullscreen"></iframe> : <p class="sb-canvas-empty">This object has no scene page.</p>}
          <a class="sb-canvas-source" href={`${REPOSITORY_URL}/tree/main/src/objects/${object.id}`}>Show package</a>
        </div>
      </figure>
      <div class="sb-panel">
        <div class="sb-panel-tabs"><span class="sb-panel-tab">Facts <span class="sb-count">{rows.length}</span></span></div>
        <div class="sb-panel-body">
          <table class="sb-args">
            <thead><tr><th scope="col">Name</th><th scope="col">Value</th></tr></thead>
            <tbody>{rows.map(row => <tr><th scope="row">{row.name}</th><td>{row.value}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>
  </div> : <slot />}
</Default>
