         INS-61411_FOV_CLASS_SPEC            = 'ANGLES'
         INS-61411_FOV_REF_VECTOR            = ( 1.0, 0.0, 0.0 )
         INS-61411_FOV_REF_ANGLE             = ( 0.872 )
