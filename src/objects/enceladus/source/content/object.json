        },
        "legend": {
          "kind": "scale",
          "title": "Elevation",
          "width": 256,
          "height": 16,
          "labels": [
            "≤ −1",
            "0",
            "≥ 1"
          ],
          "meta": "km",
          "sourceUrl": "https://astrogeology.usgs.gov/search/map/enceladus-cassini-global-dem-200m-schenk",
          "image": "/scenes/enceladus/enceladus-elevation-legend.webp"
        },
        "notes": "Color shows height above the reference ellipsoid with semi-axes 256.2 × 251.4 × 248.6 km. Colors saturate below −1 and above +1 km. Brightness shows relief under fixed northwest light, without height exaggeration. Gray grid marks missing model values. The 200 m grid contains stereogrammetric and photogrammetric terrain estimates; effective detail varies. This Schenk terrain grid and the corrected JPL v2 shape use different control solutions; local registration differences may remain.",
        "noData": true
      },
      {
        "id": "shape",
        "label": "Shape",
        "thumbnail": "/scenes/enceladus/enceladus-shape-thumbnail.webp",
        "surface": "enceladus-shape-surface@2x.webp",
        "poles": "enceladus-shape-poles@2x.webp",
        "source": {
          "id": "jpl-spc-enceladus-v2-q256",
          "path": "../manifest.json"
        },
        "notes": "Neutral gray over a simplified source shape, without photographic texture or height exaggeration. Source model detail and accuracy vary. Corrected JPL v2 SPC model; the original v1 solution is excluded. Neutral gray (#808080 sRGB) is a shared display convention, not measured surface color or albedo.",
        "noData": true
      },
      {
        "id": "ice-absorption",
        "label": "Ice absorption",
        "thumbnail": "/scenes/enceladus/enceladus-ice-absorption-thumbnail.webp",
        "surface": "enceladus-ice-absorption-surface@2x.webp",
        "poles": "enceladus-ice-absorption-poles@2x.webp",
        "source": {
          "id": "enceladus-vims-ice-absorption",
          "path": "../manifest.json",
          "url": "https://vims.univ-nantes.fr/cube/1487299582_1"
        },
        "falseColor": true,
        "legend": {
          "kind": "scale",
          "title": "Ice absorption",
          "width": 256,
          "height": 16,
          "labels": [
            "0.55",
            "0.68",
            "0.81"
          ],
          "meta": "band-depth fraction",
          "sourceUrl": "https://vims.univ-nantes.fr/cube/1487299582_1",
          "image": "/scenes/enceladus/enceladus-ice-absorption-legend.webp"
        },
        "notes": "Water-ice absorption relative to a native 1.82–2.20 µm continuum. Six calibrated Cassini VIMS observations cover selected regions; gray grid marks unsupported areas. Strength also varies with viewing geometry and grain size. Archive noise filtering is retained; no photometric correction is applied. This is not ice percentage.",
        "noData": true
      },
      {
        "id": "infrared-ratio",
        "label": "Infrared ratio",
        "thumbnail": "/scenes/enceladus/enceladus-infrared-ratio-thumbnail.webp",
        "surface": "enceladus-infrared-ratio-surface@2x.webp",
        "poles": "enceladus-infrared-ratio-poles@2x.webp",
        "source": {
          "id": "enceladus-vims-infrared-ratio",
          "path": "../manifest.json",
          "url": "https://vims.univ-nantes.fr/cube/1487299582_1"
        },
        "falseColor": true,
        "legend": {
          "kind": "scale",
          "title": "Infrared ratio",
          "width": 256,
          "height": 16,
          "labels": [
            "0.01",
            "0.055",
            "0.10"
          ],
          "meta": "reflectance ratio",
          "sourceUrl": "https://vims.univ-nantes.fr/cube/1487299582_1",
          "image": "/scenes/enceladus/enceladus-infrared-ratio-legend.webp"
        },
        "notes": "Median reflectance in three channels near 3.1 µm divided by the near-1.66 µm channel. This samples an ice-sensitive infrared feature in six calibrated Cassini observations. Illumination, grain size and noise affect the ratio; it is not a crystallinity percentage or a temperature map. Archive filtering remains; no photometric correction. Gray grid marks unsupported areas.",
        "noData": true
      }
