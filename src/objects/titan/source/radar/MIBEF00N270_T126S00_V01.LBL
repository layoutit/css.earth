OBJECT                         = IMAGE
  LINES                        = 5760
  LINE_SAMPLES                 = 5760
  SAMPLE_TYPE                  = "UNSIGNED_INTEGER"
  SAMPLE_BITS                  = 8
  CHECKSUM                     = 3110029627
  SCALING_FACTOR               = 1.0000012E-01
  OFFSET                       = -2.0100010E+01
  MISSING_CONSTANT             = 0
  NOTE                         = "The data values in this file are Synthetic
    Aperture Radar (SAR) normalized backscatter cross-section values in
    logarithmic form. The observed values have been corrected for
    incidence-angle effects and converted to decibels (db).  The raw
    backscatter values have been multiplied by the function f(I), where I is
    the incidence angle and f(I) = 0.2907/(f1(I)+f2(I)+f3(I)), for
    f1(I)=2.8126*(cos(I)^4+893.9677*sin(I)^2)^(-1.5),
    f2(I)=0.5824*(cos(I)^4+34.1366*sin(I)^2)^(-1.5), and
    f3(I)=0.3767*cos(I)^1.9782. The corresponding decibel value is db = 10
    log10 (cross-section * f(I)). The scaling between raw data number and db
    is specified by the SCALING_FACTOR and OFFSET."
END_OBJECT                     = IMAGE

