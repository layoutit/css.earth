        <Header>
            <offset unit="byte">1331547</offset>
            <object_length unit="byte">10</object_length>
            <parsing_standard_id>UTF-8 Text</parsing_standard_id>
            <description>Header for Normals section.</description>
        </Header>
        <Table_Character>
            <local_identifier>normals_table</local_identifier>
            <offset unit="byte">1331557</offset>
            <records>20484</records>
            <description>The NORMALS_TABLE is the fourth section. It describes the vertex normals.
                The floating point numbers x1 y1 z1 are the coordinates of normal 1, and so on
                (normals are implicitly numbered beginning with 1). Normals might not be
                unit vectors.
            </description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>4</fields>
                <groups>0</groups>
                <record_length unit="byte">39</record_length>
                <Field_Character>
                    <name>Normals_Flag</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">2</field_length>
                    <description>A 'vn', indicating this record contains vertex normal values.</description>
                </Field_Character>
                <Field_Character>
                    <name>X_Coordinate</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">5</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <description>X normal coordinate</description>
                </Field_Character>
                <Field_Character>
                    <name>Y_Coordinate</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">17</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <description>Y normal coordinate</description>
                </Field_Character>
                <Field_Character>
                    <name>Z_Coordinate</name>
                    <field_number>4</field_number>
                    <field_location unit="byte">29</field_location>
