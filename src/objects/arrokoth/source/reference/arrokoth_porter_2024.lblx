        <Header>
            <offset unit="byte">53</offset>
            <object_length unit="byte">12</object_length>
            <parsing_standard_id>UTF-8 Text</parsing_standard_id>
            <description>Header for Vertices section.</description>
        </Header>
        <Table_Character>
            <local_identifier>vertex_table</local_identifier>
            <offset unit="byte">65</offset>
            <records>20484</records>
            <description>The VERTEX_TABLE is the second section. It describes the positions of the
                model vertices. The floating point numbers x1 y1 z1 are the coordinates of vertex 1,
                and so on (vertices are implicitly numbered beginning with 1). The origin is the
                center of mass, and the axes are the principle axes of the shape model. The units
                are kilometers.
            </description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>4</fields>
                <groups>0</groups>
                <record_length unit="byte">38</record_length>
                <Field_Character>
                    <name>Vertex_Flag</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">1</field_length>
                    <description>A 'v', indicating this record contains the coordinates of a vertex.</description>
                </Field_Character>
                <Field_Character>
                    <name>X_Coordinate</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">4</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <unit>km</unit>
                    <description>X coordinate of the vertex</description>
                </Field_Character>
                <Field_Character>
                    <name>Y_Coordinate</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">16</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <unit>km</unit>
                    <description>Y coordinate of the vertex</description>
                </Field_Character>
                <Field_Character>
                    <name>Z_Coordinate</name>
                    <field_number>4</field_number>
                    <field_location unit="byte">28</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">10</field_length>
                    <unit>km</unit>
                    <description>Z coordinate of the vertex</description>
                </Field_Character>
            </Record_Character>
        </Table_Character>
        <Header>
            <offset unit="byte">778457</offset>
            <object_length unit="byte">22</object_length>
            <parsing_standard_id>UTF-8 Text</parsing_standard_id>
            <description>Header for Texture Coordinate section.</description>
        </Header>
        <Table_Character>
            <local_identifier>texture_coordinate_table</local_identifier>
            <offset unit="byte">778479</offset>
            <records>20484</records>
            <description>The TEXTURE_COORDINATE_TABLE is the third section. It describes the
                texture coordinates.
            </description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>3</fields>
                <groups>0</groups>
                <record_length unit="byte">27</record_length>
                <Field_Character>
                    <name>Texture_Coordinate_Flag</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">2</field_length>
                    <description>A 'vt', indicating this record contains texture coordinates.</description>
                </Field_Character>
                <Field_Character>
                    <name>U_Coordinate</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">7</field_location>
                    <data_type>ASCII_Real</data_type>
                    <field_length unit="byte">8</field_length>
