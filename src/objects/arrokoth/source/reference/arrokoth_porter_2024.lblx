                    <field_length unit="byte">10</field_length>
                    <description>Z normal coordinate</description>
                </Field_Character>
            </Record_Character>
        </Table_Character>
        <Header>
            <offset unit="byte">2130433</offset>
            <object_length unit="byte">8</object_length>
            <parsing_standard_id>UTF-8 Text</parsing_standard_id>
            <description>Header for Facet section.</description>
        </Header>
        <Table_Character>
            <local_identifier>facet_table</local_identifier>
            <offset unit="byte">2130441</offset>
            <records>40960</records>
            <description>The FACET_TABLE is the fifth section. It provides the linking of vertices
                into triangular polygon faces. Each face is defined by three vertex (v1 v2 v3) and
                vertex texture (vt1 vt2 vt3) index pairs, linked as follows:

                v1/vt1 v2/vt2 v3/vt3
            </description>
            <record_delimiter>Line-Feed</record_delimiter>
            <Record_Character>
                <fields>4</fields>
                <groups>0</groups>
                <record_length unit="byte">38</record_length>
                <Field_Character>
                    <name>Facet_Flag</name>
                    <field_number>1</field_number>
                    <field_location unit="byte">1</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">1</field_length>
                    <description>A 'f', indicating this record contains the indices of three
                        vertex/texture pairs defining a single, triangular face.
                    </description>
                </Field_Character>
                <Field_Character>
                    <name>Facet_1</name>
                    <field_number>2</field_number>
                    <field_location unit="byte">3</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">11</field_length>
                    <description>Indexes of the first vertex/texture pair.</description>
                </Field_Character>
                <Field_Character>
                    <name>Facet_2</name>
                    <field_number>3</field_number>
                    <field_location unit="byte">15</field_location>
                    <data_type>ASCII_String</data_type>
                    <field_length unit="byte">11</field_length>
                    <description>Indexes of the second vertex/texture pair.</description>
                </Field_Character>
                <Field_Character>
