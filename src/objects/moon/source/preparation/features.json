  },
  "lensIds": [
    "surface",
    "midnight-temperature",
    "heat-anomalies",
    "rock-abundance",
    "topography",
    "crust",
    "silicate-signature",
    "geology"
  ],
  "kinds": {
    "point": [
      "AA",
      "FA",
      "SF"
    ],
    "linear": [
      "RU",
      "DO",
      "VA",
      "CA",
      "FO"
    ],
    "region": [
      "PL",
      "PM",
      "MO"
    ]
  },
  "excludedTypeCodes": {
