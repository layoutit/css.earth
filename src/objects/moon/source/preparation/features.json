{
  "schema": "cssearth-surface-features@1",
  "directory": "features",
  "archive": "MOON_nomenclature_center_pts.zip",
  "members": {
    "attributes": "MOON_nomenclature_center_pts.dbf",
    "projection": "MOON_nomenclature_center_pts.prj",
