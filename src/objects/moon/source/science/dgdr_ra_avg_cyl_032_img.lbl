SOURCE_PRODUCT_ID         = "NONE"
INSTRUMENT_HOST_NAME      = "LUNAR RECONNAISSANCE ORBITER"
INSTRUMENT_HOST_ID        = "LRO"
INSTRUMENT_NAME           = "DIVINER LUNAR RADIOMETER EXPERIMENT"
INSTRUMENT_ID             = "DLRE"
MISSION_PHASE_NAME        = {"NOMINAL MISSION"}
