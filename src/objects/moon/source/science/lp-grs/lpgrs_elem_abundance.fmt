  OBJECT                      = COLUMN
    COLUMN_NUMBER             = 1
    NAME                      = "PIXEL_INDEX"
    DATA_TYPE                 = ASCII_INTEGER
    START_BYTE                = 1
    BYTES                     = 10
    FORMAT                    = "I10"
    DESCRIPTION               = "Index of the pixel in the map 
       to which the remaining values in this row apply. The map
       covers -90 to 90 degrees latitude and -180 to 180 degrees 
       longitude. Pixels are indexed from west to east and from 
       south to north in the map, beginning with 0."
  END_OBJECT                  = COLUMN

  OBJECT                      = COLUMN
    COLUMN_NUMBER             = 2
    NAME                      = "MIN_LAT"
    DATA_TYPE                 = ASCII_REAL
    UNIT                      = "deg"
    START_BYTE                = 11
    BYTES                     = 7
    FORMAT                    = "F7.1"
    DESCRIPTION               = "Pixel latitude southernmost boundary"
  END_OBJECT                  = COLUMN

  OBJECT                      = COLUMN
    COLUMN_NUMBER             = 3
    NAME                      = "MAX_LAT"
    DATA_TYPE                 = ASCII_REAL
    UNIT                      = "deg"
    START_BYTE                = 18
    BYTES                     = 7
    FORMAT                    = "F7.1"
    DESCRIPTION               = "Pixel latitude northernmost boundary"
  END_OBJECT                  = COLUMN

  OBJECT                      = COLUMN
    COLUMN_NUMBER             = 4
    NAME                      = "MIN_LON"
    DATA_TYPE                 = ASCII_REAL
    UNIT                      = "deg"
    START_BYTE                = 25
    BYTES                     = 7
    FORMAT                    = "F7.1"
    DESCRIPTION               = "Pixel longitude westernmost boundary.
       Longitude increases to the east."
  END_OBJECT                  = COLUMN

  OBJECT                      = COLUMN
    COLUMN_NUMBER             = 5
    NAME                      = "MAX_LON"
    DATA_TYPE                 = ASCII_REAL
    UNIT                      = "deg"
    START_BYTE                = 32
    BYTES                     = 7
    FORMAT                    = "F7.1"
    DESCRIPTION               = "Pixel longitude easternmost boundary.
