    "controls": [
      {
        "id": "normal",
        "label": "Monochrome",
        "thumbnail": "/scenes/tethys/tethys-normal-thumbnail.webp",
        "surface": "tethys-normal-surface@2x.webp",
        "poles": "tethys-normal-poles@2x.webp",
        "source": {
          "id": "cassini-iss-2012-tethys",
          "path": "../manifest.json"
        },
        "notes": "Cassini 2012 mosaic, 293 m per source pixel, delivered on the shared 8192 × 4096 layout. Photographed shadows and variable resolution remain; globe Shadows add approximate lighting. Gray grid marks explicit source no-data. Mapped onto a simplified Cassini SPC shape; independent image control can leave local registration differences.",
        "noData": true
      },
      {
        "id": "enhanced",
        "label": "Enhanced color",
        "thumbnail": "/scenes/tethys/tethys-enhanced-thumbnail.webp",
        "surface": "tethys-enhanced-surface@2x.webp",
        "poles": "tethys-enhanced-poles@2x.webp",
        "source": {
          "id": "cassini-iss-2014-tethys-color",
          "path": "../manifest.json"
        },
        "notes": "Published 2014 infrared–green–ultraviolet composite, photometrically corrected by Paul Schenk. Enhanced colors extend beyond human vision. Source resolution varies; seams and residual photographed shading remain. Mapped onto a simplified Cassini SPC shape; independent image control can leave local registration differences."
      },
      {
        "id": "iss",
        "label": "ISS photograph",
        "thumbnail": "/scenes/tethys/tethys-iss-thumbnail.webp",
        "surface": "tethys-iss-surface@2x.webp",
        "poles": "tethys-iss-poles@2x.webp",
        "source": {
          "id": "n1807429484",
          "path": "../manifest.json",
          "url": "https://opus.pds-rings.seti.org/opus/#/detail/co-iss-n1807429484"
        },
        "falseColor": false,
        "facts": [
          {
            "id": "observed",
            "label": "Observed",
            "value": "11 April 2015, 06:43 UTC"
          },
          {
            "id": "footprint",
            "label": "Pixel footprint",
            "value": "1.1 km from 190,000 km"
          },
          {
            "id": "filter",
            "label": "Camera filter",
            "value": "CL1 and CL2 · clear"
          }
        ],
        "notes": "One Cassini narrow-angle photograph from 11 April 2015, projected onto the shape model through a camera derived from Cassini's SPICE kernels and refined to the limb. Grid marks surface the camera did not see or that lay in shadow. Brightness is disk-normalized with an empirical Lommel-Seeliger law; it is not measured albedo.",
        "noData": true
      },
      {
        "id": "elevation",
        "label": "Elevation",
        "thumbnail": "/scenes/tethys/tethys-elevation-thumbnail.webp",
        "surface": "tethys-elevation-surface@2x.webp",
        "poles": "tethys-elevation-poles@2x.webp",
        "source": {
          "id": "cassini-spc-2025-tethys-eq",
          "path": "../manifest.json"
        },
        "legend": {
          "kind": "scale",
          "title": "Elevation",
          "width": 256,
          "height": 16,
          "labels": [
            "−12.5",
            "0",
            "+12.5"
          ],
          "meta": "km",
          "sourceUrl": "https://sbn.psi.edu/pds/resource/weirichtethysshape.html",
          "image": "/scenes/tethys/tethys-elevation-legend.webp"
        },
        "notes": "Color shows height above the PDS 531 km reference sphere. Brightness shows fixed northwest relief lighting at true height scale; Shadows adds the shared approximate globe lighting. Cassini SPC model released in 2025, about 1.5 km grid spacing. The globe uses a simplified version of the released Q128 shape; grid and geometry resolutions differ. Model detail and accuracy vary.",
        "noData": true
      },
      {
        "id": "relative-albedo",
        "label": "Relative albedo",
        "thumbnail": "/scenes/tethys/tethys-relative-albedo-thumbnail.webp",
        "surface": "tethys-relative-albedo-surface@2x.webp",
        "poles": "tethys-relative-albedo-poles@2x.webp",
        "source": {
          "id": "cassini-spc-2025-tethys-tethys_eqalbedo_g",
          "path": "../manifest.json"
        },
        "legend": {
          "kind": "scale",
          "title": "Relative albedo",
          "width": 256,
          "height": 16,
          "labels": [
            "0.5",
            "1",
            "≥ 1.5"
          ],
          "meta": "relative to mean ≈ 1",
          "sourceUrl": "https://sbn.psi.edu/pds/resource/weirichtethysshape.html",
          "image": "/scenes/tethys/tethys-relative-albedo-legend.webp"
        },
        "notes": "Relative brightness solved together with the Cassini SPC shape model, normalized around 1. This secondary model product is less validated than topography. It is neither visible color nor calibrated reflectance. Colors show 0.5–1.5; values above 1.5 saturate. Gray grid preserves source gaps.",
        "noData": true
      },
      {
        "id": "shape",
        "label": "Shape",
        "thumbnail": "/scenes/tethys/tethys-shape-thumbnail.webp",
        "surface": "tethys-shape-surface@2x.webp",
        "poles": "tethys-shape-poles@2x.webp",
        "source": {
          "id": "cassini-spc-2025-tethys-q128-shape",
          "path": "../manifest.json"
        },
        "notes": "Neutral gray over a simplified source shape, without photographic texture or height exaggeration. Source model detail and accuracy vary. Cassini SPC Q128 model released in 2025. The 2,000-face view retains broad shape; small terrain details are omitted. Neutral gray (#808080 sRGB) is a shared display convention, not measured surface color or albedo.",
        "noData": true
      },
      {
        "id": "infrared",
        "label": "Infrared",
        "thumbnail": "/scenes/tethys/tethys-infrared-thumbnail.webp",
        "surface": "tethys-infrared-surface@2x.webp",
        "poles": "tethys-infrared-poles@2x.webp",
        "source": {
          "id": "tethys-cassini-infrared",
          "path": "../manifest.json",
          "url": "https://vims.univ-nantes.fr/cube/1719616836_1"
        },
        "falseColor": true,
        "notes": "Seven Cassini VIMS observations from 2007–2015. False color assigns red to about 2.02 µm, green to 1.59 µm and blue to 1.28 µm. All three channels share a 0–0.65 I/F display range and gamma 2.2; this stretch changes the display only. No photometric correction is applied, so illumination remains. Archive noise filtering and local replacement are retained; original detector defects and potentially affected neighbors are excluded. Gray grid marks unsupported areas and scan gaps.",
        "noData": true
      },
      {
        "id": "ice-absorption",
        "label": "Ice absorption",
        "thumbnail": "/scenes/tethys/tethys-ice-absorption-thumbnail.webp",
        "surface": "tethys-ice-absorption-surface@2x.webp",
        "poles": "tethys-ice-absorption-poles@2x.webp",
        "source": {
          "id": "tethys-cassini-ice-absorption",
          "path": "../manifest.json",
          "url": "https://vims.univ-nantes.fr/cube/1719616836_1"
        },
        "falseColor": true,
        "legend": {
          "kind": "scale",
          "title": "Ice absorption",
          "width": 256,
          "height": 16,
          "labels": [
            "≤ 0.55",
            "0.65",
            "≥ 0.75"
          ],
          "meta": "band-depth fraction",
          "sourceUrl": "https://vims.univ-nantes.fr/cube/1719616836_1",
          "image": "/scenes/tethys/tethys-ice-absorption-legend.webp"
        },
        "notes": "Near-2.02 µm water-ice band depth relative to a linear 1.82–2.20 µm continuum, using nine Cassini VIMS observations from 2007–2015. This measures absorption strength, not ice abundance. Viewing angle, grain size and noise also affect the values; no photometric correction is applied. Archive noise filtering and local replacement remain; original detector defects and potentially affected neighbors are excluded. Display colors saturate outside 0.55–0.75; original numerical values are retained. Gray grid marks unsupported areas and scan gaps.",
        "noData": true
      }
    ]
  },
