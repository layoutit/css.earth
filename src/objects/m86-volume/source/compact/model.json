          "axialSigma": 1,
          "weight": 1,
          "sersicIndex": 10.27,
          "axisRatio": 0.625
        }
      ],
      "sigmaCutoff": 0.342
    },
    "modelReference": {
      "paper": "https://arxiv.org/abs/0810.1681"
    }
