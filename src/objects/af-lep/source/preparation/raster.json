{
  "schema": "cssearth-raster-recipe@2",
  "publicBase": "/scenes/af-lep/",
  "sourceWidth": 1024,
  "sourceHeight": 512,
  "width": 1024,
  "height": 512,
  "latitudeBands": 16,
  "polarTile": 256,
  "resample": "density-before-pack",
  "polarProjection": "orthographic-bilinear",
  "polesOutput": "af-lep-poles-{id}{suffix}.webp",
  "surfaceMetadata": {
    "schema": "cssaf-lep-prepared-assets@1"
  },
  "thumbnail": {
    "size": 64,
    "centerLongitudeDegrees": 0
  },
  "surfaces": [
    {
      "id": "color",
      "output": "af-lep-surface-{id}{suffix}.webp",
      "thumbnail": "af-lep-dataset-{id}.webp",
      "source": "photometry/stellar-color.json",
      "falseColor": false,
      "science": {
        "kind": "stellar-photometric-color",
        "qualification": "Photosphere color from the star's Gaia DR3 BP/RP spectrum, dimmed toward the limb by the quadratic law Claret & Bloemen (2011), A&A 529, A75 computes from ATLAS model atmospheres for the Johnson V band at 6,076 K (the record) and log g 4.32 (from the record's mass and radius (packages/astronomy/data/bodies/af-lep.json)): a model, because no fit of this star's limb is used. The disc is unresolved: no map or absolute brightness is implied. Self-luminous, so no lighting.",
        "limbDarkening": {
          "law": "quadratic",
          "path": "photometry/claret-2011-v-quadratic.tsv",
          "grid": {
            "teffK": 6076,
            "logg": 4.32,
            "models": {
              "Filt": "V",
              "Met": "L",
              "Mod": "A"
            }
          },
          "columns": {
            "teff": "Teff",
            "logg": "logg",
            "u1": "a",
            "u2": "b"
          }
        }
      }
    },
    {
      "id": "radial-field-2007-12",
      "output": "af-lep-surface-{id}{suffix}.webp",
      "thumbnail": "af-lep-dataset-{id}.webp",
      "source": "science/espadons/af-lep-2007-12.dat",
      "falseColor": true,
      "science": {
        "kind": "terrestrial-scientific",
        "id": "radial-field-2007-12",
        "label": "Dec 2007",
        "format": "tecplot-lonlat-map",
        "path": "science/espadons/af-lep-2007-12.dat",
        "variable": "B<sub>R</sub> [G]",
        "outlineLatitudes": [
          -57
        ],
        "consumer": "espadons-zdi",
        "sampling": "bilinear",
        "displaySampling": "bilinear",
        "outputLongitudeOrigin": 0,
        "units": "G",
        "minimum": -150,
        "maximum": 150,
        "colors": [
          "#0000ff",
          "#00ffff",
          "#ffffff",
          "#ff8000",
          "#ff0000"
        ],
        "labels": [
          "-150",
          "0",
          "+150"
        ],
        "description": "Radial component of the star's large-scale magnetic field, fitted with ZDIpy to 19 ESPaDOnS spectra of 27 December 2007 to 30 December 2007 (reduced chi-square 1.30, against 1.9 with no field); mean field 20 G. A reduction made in this project, not a published map. Black line: 57 degrees south, below which the star never faces us.",
        "title": "ESPaDOnS · magnetic map made here · Dec 2007",
        "sourceUrl": "https://www.cadc-ccda.hia-iha.nrc-cnrc.gc.ca/en/cfht/"
      }
    }
  ],
  "emission": {
    "offLimbSize": 600,
    "limbSize": 512,
    "bodyDiameter": 496,
    "offLimbOutput": "af-lep-context-{id}{suffix}.webp",
    "limbOutput": "af-lep-limb-{id}{suffix}.webp",
    "metadata": {
      "schema": "cssaf-lep-prepared-emission@1",
      "presentation": "prepared-emissive-surface-with-stationary-off-limb-context-and-limb-plate",
      "offLimbContext": {
        "logicalSize": 600,
        "source": "none: no observation, a transparent plate",
        "composition": "transparent",
        "rotation": "none",
        "runtimeAlphaProcessing": false
      },
      "limbMaterial": {
        "logicalSize": 496,
        "composition": "black alpha darkens the photosphere according to the selected quadratic limb-darkening law; transparent outside the silhouette",
        "surfaceReplacement": false,
        "runtimeAlphaProcessing": false
      },
      "lighting": false,
      "shadows": false,
      "runtimeLighting": false
    }
  }
}
