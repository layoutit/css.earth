        "id": "normal",
        "label": "Monochrome",
        "description": "Cassini clear-filter observations projected onto the released PDS shape using its measured camera geometry. Bounded illumination correction and exposure matching reduce photographed lighting. Gray grid marks unavailable samples; cast-shadow terrain is not reconstructed.",
        "title": "ISS mosaic",
        "detail": "Cassini \u00b7 corrected mosaic",
        "thumbnail": "/scenes/pandora/pandora-normal-thumbnail.webp",
        "surface": "pandora-normal-surface@2x.webp",
        "poles": "pandora-normal-surface@2x.webp",
        "source": {
          "id": "n1504611846_1",
          "path": "../manifest.json",
          "url": "https://pds-rings.seti.org/cassini/iss/"
        },
        "summary": "Brightness matching reduces photographed shading. The gray grid marks missing coverage and terrain hidden in cast shadows."
      },
      {
        "id": "filter-color",
        "label": "False color",
        "description": "Cassini IR3, GRN, UV3 filters displayed as red, green and blue; observed illumination and common coverage only.",
        "title": "Cassini false color",
        "detail": "Cassini",
        "thumbnail": "/scenes/pandora/pandora-filter-color-thumbnail.webp",
        "surface": "pandora-filter-color-surface@2x.webp",
        "poles": "pandora-filter-color-surface@2x.webp",
        "source": {
          "id": "n1860790942",
          "path": "../manifest.json",
          "url": "https://pds-rings.seti.org/cassini/iss/"
        },
        "summary": "Measured filter bands in false color; this does not reproduce human-visible color. Gray grid marks missing common coverage; photographed shadows remain."
      },
      {
        "id": "elevation",
        "label": "Elevation",
        "description": "Radial height above a 40.6 km reference sphere from the Cassini shape model. Includes the moon\u2019s broad irregular shape; it is not local height above a geoid. Fixed relief lighting reveals model slopes. Small craters are not reliably resolved.",
        "title": "Shape-derived radial height",
        "detail": "Cassini shape \u00b7 radial height",
        "thumbnail": "/scenes/pandora/pandora-elevation-thumbnail.webp",
        "surface": "pandora-elevation-surface@2x.webp",
