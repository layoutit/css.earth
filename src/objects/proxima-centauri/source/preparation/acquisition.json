{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "url": "https://mast.stsci.edu/api/v0.1/Download/file?uri=mast:HLSP/lowlib/hlsp_lowlib_hst_stis_gj551_g230lb-g430l-g750l_v1.0_spect.fits",
      "path": "photometry/hlsp_lowlib_gj551.fits"
    },
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/crosscheck-gaia-dr3-xp-sampled.csv",
      "url": "https://gea.esac.esa.int/data-server/data?RETRIEVAL_TYPE=XP_SAMPLED&ID=5853498713190525696&FORMAT=csv&DATA_STRUCTURE=RAW&RELEASE=Gaia+DR3"
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/claret-2017-tess-quadratic.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/A+A/600/A30/tableab",
        "-out.max": "500",
        "Teff": "2900..3100",
        "logg": "4.5..5",
        "Z": "=0",
        "Type": "q",
        "Mod": "PC",
        "-out": "logg,Teff,Z,L/HP,aLSM,bLSM,Type,Mod"
      },
      "requiredText": [
        "logg\tTeff"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ]
    }
  ]
}
