  "surfaces": [
    {
      "id": "color",
      "output": "proxima-centauri-surface-{id}{suffix}.webp",
      "thumbnail": "proxima-centauri-lens-{id}.webp",
      "source": "photometry/stellar-color.json",
      "falseColor": false,
      "science": {
        "kind": "stellar-photometric-color",
        "qualification": "Uniform photosphere colour from the star's HST/STIS spectrum (LowLib). No limb darkening is drawn: at its 3,098 K (Demory et al. 2009) and log g 5.0 (Pavlenko et al. 2017) the Claret (2017) PHOENIX-COND grid has no node at 3,000 K, log g 5.0 to interpolate from, and its PHOENIX-DRIFT grid stops at 3,000 K. The disc is unresolved: no map or absolute brightness is implied. Self-luminous, so no lighting."
      }
    }
  ],
  "emission": {
    "offLimbSize": 600,
    "limbSize": 512,
    "bodyDiameter": 496,
    "offLimbOutput": "proxima-centauri-context-{id}{suffix}.webp",
    "limbOutput": "proxima-centauri-limb-{id}{suffix}.webp",
    "metadata": {
      "schema": "cssproxima-centauri-prepared-emission@1",
      "presentation": "prepared-emissive-surface-with-stationary-off-limb-context-and-limb-plate",
