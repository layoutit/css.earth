{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/claret-2011-v-quadratic.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/A+A/529/A75/table-af",
        "-out.max": "500",
        "Teff": "4750..5000",
        "logg": "0.5..1",
        "Z": "=0",
        "xi": "=2",
        "Filt": "V",
        "Met": "L",
        "Mod": "A",
        "-out": "logg,Teff,Z,xi,a,b,Filt,Met,Mod"
      },
      "requiredText": [
        "logg\tTeff"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ]
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/catalogue-row.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/ApJ/951/118/table9",
        "-out.all": "",
        "-out.max": "2",
        "ID": "01333291+3035490"
      },
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ],
      "requiredText": [
        "RAJ2000",
        "01333291+3035490"
      ]
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/gaia-dr3-vari-cepheid.csv",
      "url": "https://gea.esac.esa.int/tap-server/tap/sync",
      "form": {
        "REQUEST": "doQuery",
        "LANG": "ADQL",
        "FORMAT": "csv",
        "QUERY": "SELECT source_id, pf, pf_error, fund_freq1, reference_time_g, zp_mag_g, num_harmonics_for_p1_g, fund_freq1_harmonic_ampl_g, fund_freq1_harmonic_phase_g, epoch_g, epoch_g_error, peak_to_peak_g, r21_g, phi21_g, mode_best_classification, type_best_classification FROM gaiadr3.vari_cepheid WHERE source_id = 303377768027732608"
      },
      "requiredPrefix": "source_id,pf,"
    }
  ]
}
