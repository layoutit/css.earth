{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/reeve-2016-b-v-quadratic.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/MNRAS/456/1294/summary1",
        "-out.max": "500",
        "FileName": "BG*v02",
        "Filter": "Bessell-V",
        "-out": "FileName,quad2.2,quad2.3"
      },
      "requiredText": [
        "logg\tTeff"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^FileName\\tquad2\\.2\\tquad2\\.3",
          "flags": "m",
          "replacement": "logg\tTeff\ta\tb\n[cgs]\tK\t\t"
        },
        {
          "pattern": "^B[A-Z](\\d{5})g(\\d)(\\d{2})v\\d+\\t",
          "flags": "gm",
          "replacement": "$2.$3\t$1\t"
        }
      ]
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/catalogue-row.tsv",
      "url": "https://simbad.cds.unistra.fr/simbad/sim-tap/sync",
      "form": {
        "REQUEST": "doQuery",
        "LANG": "ADQL",
        "FORMAT": "tsv",
        "QUERY": "SELECT main_id, ra, dec, coo_bibcode FROM basic WHERE main_id = '[SVF2019] NGC 4736-1'"
      },
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ],
      "requiredText": [
        "ra",
        "[SVF2019] NGC 4736-1"
      ]
    }
  ]
}
