            "falseColor": false,
            "science": {
              "kind": "stellar-photometric-color",
              "colorMatching": "reference/CIE_xyz_1931_2deg.csv",
              "qualification": "Uniform photosphere colour from the star's ground-based spectrophotometry (Pulkovo catalogue). The surface is darkened by latitude from the published Roche-von Zeipel fit of Monnier et al. (2007), Science 317, 342: the hot poles brighter and bluer, the cool equator dimmer and redder. The disc is unresolved: it is darkened toward the limb by the quadratic V-band law Claret & Bloemen (2011) compute from ATLAS model atmospheres at the star's temperature and gravity, a model rather than a measurement; no map or absolute brightness is implied. Self-luminous, so no lighting.",
              "limbDarkening": {
                "law": "quadratic",
                "path": "photometry/claret-2011-v-quadratic.tsv",
                "grid": {
                  "teffK": 7680,
                  "logg": 4.13,
                  "models": {
