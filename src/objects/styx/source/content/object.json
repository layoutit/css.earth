        "value": "About 20.16 days"
      },
      {
        "id": "distance-from-parent",
        "label": "Distance from system center",
        "value": "About 42,656 km"
      },
      {
        "id": "rotation-period",
        "label": "Rotation period",
        "value": "About 3.24 days"
      },
      {
        "id": "discovery",
