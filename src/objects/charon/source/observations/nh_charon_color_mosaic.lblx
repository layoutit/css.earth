            </comment>
        </File>
        
        <Array_3D_Spectrum>
            <local_identifier>ImageCube</local_identifier>
            <offset unit="byte">0</offset>
            <axes>3</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <Element_Array>
