    "patches": "diff --git a/site/application-world-context.mts b/site/application-world-context.mts\nindex 3cf6dd757..3abed1b00 100644\n--- a/site/application-world-context.mts\n+++ b/site/application-world-context.mts\n@@ -81,7 +81,7 @@ function loadApplicationUniverse(): Promise<ApplicationUniverse> {\n     const sprites = Object.fromEntries(Object.entries(PREPARED_NAVIGATION_MARKERS)\n       .map(([id, sprite]) => [id, { ...contextMarkerSprite(sprite),\n         minimumDiameterPixels: asteroidIds.includes(id) ? 2 : 2.4 }]));\n-    const volumeLenses = await Promise.all(Object.values(descriptors).map(parseObjectDescriptor).filter(descriptor => descriptor.type === 'volume-lens-bank')\n+    const volumeLenses = await Promise.all(Object.values(descriptors).map(parseObjectDescriptor).filter(descriptor => descriptor.type === 'volume-lens-bank' && typeof assets[`../src/objects/${descriptor.id}/${descriptor.prepared.url}`] === 'string')\n       .map(async descriptor => {\n         const set = resourceSet(descriptor.id);\n         return { payload: await loadPreparedVolumeLenses(set.descriptor, set.transport),\ndiff --git a/site/components/PreparedFocusLenses.astro b/site/components/PreparedFocusLenses.astro\nindex bed55449a..47d580197 100644\n--- a/site/components/PreparedFocusLenses.astro\n+++ b/site/components/PreparedFocusLenses.astro\n@@ -10,7 +10,7 @@ const descriptors = import.meta.glob<Descriptor>('../../src/objects/*/object.jso\n const prepared = import.meta.glob<{ data: PreparedVolumeLensBank }>('../../src/objects/*/prepared/*.json', { eager: true, import: 'default' });\n const presentations = import.meta.glob<unknown>('../../src/objects/*/prepared/presentation.json', { eager: true, import: 'default' });\n const provenanceDocuments = import.meta.glob<unknown>('../../src/objects/*/prepared/provenance.json', { eager: true, import: 'default' });\n-const banks = Object.entries(descriptors).filter(([, descriptor]) => descriptor.type === 'volume-lens-bank').map(([path, descriptor]) => {\n+const banks = Object.entries(descriptors).filter(([path, descriptor]) => descriptor.type === 'volume-lens-bank' && prepared[path.replace(/object\\.json$/u, descriptor.prepared?.url ?? '')]?.data).map(([path, descriptor]) => {\n   const bank = prepared[path.replace(/object\\.json$/u, descriptor.prepared?.url ?? '')]?.data;\n   if (!bank || bank.id !== descriptor.id) throw new TypeError(`Prepared focus lenses unavailable: ${descriptor.id}.`);\n   const provenance = validateObjectProvenance(provenanceDocuments[path.replace(/object\\.json$/u, 'prepared/provenance.json')], bank.id);",
