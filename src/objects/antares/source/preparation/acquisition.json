{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/neilson-2013-v-quadratic.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/A+A/554/A98/table3",
        "-out.max": "5000",
        "Teff": "3600..3700",
        "logg": "-0.25..0",
        "M": "12.5..15",
        "-out": "Teff,logg,M,a(V),b(V)"
      },
      "requiredText": [
        "Teff\tlogg"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ]
    }
  ]
}
