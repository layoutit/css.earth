OBJECT     = EXT_RESIDUAL_HEADER                                              
  BYTES              = 2880                                                   
  HEADER_TYPE        = "FITS"                                                 
  INTERCHANGE_FORMAT = "BINARY"                                               
  RECORDS            = 1                                                      
  DESCRIPTION        = "                                                      
    This extension contains the residual image number (or count)              
    of sigma error for each pixel:  (archived RADREV image) minus             
    (restored image reconvolved with the PSF) normalized by the               
    estimated error in the pixel.  Pixels with bad data have                  
    the sigma set to zero."                                                   
END_OBJECT = EXT_RESIDUAL_HEADER                                              
                                                                              
