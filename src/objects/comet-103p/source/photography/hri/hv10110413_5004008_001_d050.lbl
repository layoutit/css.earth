OBJECT     = HEADER                                                           
  BYTES              = 51840                                                  
  HEADER_TYPE        = "FITS"                                                 
  INTERCHANGE_FORMAT = "BINARY"                                               
  RECORDS            = 18                                                     
  DESCRIPTION        = "FITS format defined in NASA/Science Office            
    Standards Technology 100-1.0.  This array contains the deconvolved        
    image of the target, derived from the reversibly calibrated, radiance     
    (RADREV) image.  This header was copied from the RADREV primary header    
    and the number of deconvolutions was appended."                           
END_OBJECT = HEADER                                                           
                                                                              
