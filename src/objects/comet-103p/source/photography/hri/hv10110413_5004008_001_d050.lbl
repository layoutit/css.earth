OBJECT     = EXT_MASK_HEADER                                                  
  BYTES              = 2880                                                   
  HEADER_TYPE        = "FITS"                                                 
  INTERCHANGE_FORMAT = "BINARY"                                               
  RECORDS            = 1                                                      
  DESCRIPTION        = "                                                      
    This extension contains the mask of the data points (pixels)              
    used in deconvolution.  Saturated data, detected cosmic rays,             
    and bad pixels were ignored and set to zero in this mask.                 
    A value of one indicates good data."                                      
