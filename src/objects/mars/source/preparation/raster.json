{
  "schema": "cssearth-raster-recipe@1",
  "publicBase": "/scenes/mars/",
  "sourceWidth": 4096,
  "sourceHeight": 2048,
  "width": 2048,
  "height": 1024,
  "latitudeBands": 16,
  "polarTile": 256,
  "resample": "density-before-pack",
  "polarProjection": "orthographic-bilinear",
  "polesOutput": "mars-poles-{id}{suffix}.webp",
  "surfaceMetadata": {
    "schema": "cssmars-prepared-assets@1"
  },
  "thumbnail": {
    "size": 64
  },
  "surfaces": [
    {
      "id": "normal",
      "source": "surface/mars-viking-mdim21-color-1km.jpg",
      "falseColor": false,
      "output": "mars-surface-{id}{suffix}.webp",
      "thumbnail": "mars-lens-{id}.webp",
      "nativeSourcePoles": true
    },
    {
      "id": "elevation",
      "source": "lenses/mola-pseudocolor-z3.png",
      "falseColor": true,
      "output": "mars-surface-{id}{suffix}.webp",
      "thumbnail": "mars-lens-{id}.webp"
    },
    {
      "id": "thermal",
      "source": "lenses/themis-ir-day-z3.png",
      "falseColor": false,
      "output": "mars-surface-{id}{suffix}.webp",
      "thumbnail": "mars-lens-{id}.webp"
    }
  ],
  "atmosphere": {
    "source": "atmosphere/model.json",
    "tileSize": 256,
    "logicalSize": 512,
    "frameCount": 32,
    "directionalFrameCount": 31,
    "columns": 8,
    "rows": 4,
    "minimumLightViewZ": -0.98,
    "maximumLightViewZ": 0.98,
    "bodyRadius": 230,
    "supersampling": 2,
    "contentScale": 0.992,
    "coverageScale": 1.002,
    "directionalShadowRelease": 0,
    "floodShadowRelease": 0.3,
    "sunwardShadowRelease": [
      0.45,
      0.92
    ],
    "terminator": [
      0,
      0.1
    ],
    "materialOutput": "mars-material{suffix}.webp",
    "observationOutput": "mars-observation-material{suffix}.webp",
    "lightingOutput": "mars-lighting{suffix}.webp"
  }
}
