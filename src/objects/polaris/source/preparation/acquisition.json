{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "presentation/InterVariable.ttf",
      "url": "https://raw.githubusercontent.com/rsms/inter/9221beed3/docs/font-files/InterVariable.ttf"
    },
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "url": "https://archive.stsci.edu/pub/hlsp/stisngsl/v2/hd008890/h_stis_ngsl_hd008890_v2.fits",
      "path": "photometry/h_stis_ngsl_hd008890_v2.fits"
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/claret-2011-v-quadratic.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/A+A/529/A75/table-af",
        "-out.max": "500",
        "Teff": "5750..6500",
        "logg": "1.5..2.0",
        "Z": "=0",
        "xi": "=2",
        "Filt": "V",
        "Met": "L",
        "Mod": "A",
        "-out": "logg,Teff,Z,xi,a,b,Filt,Met,Mod"
      },
      "requiredText": [
        "logg\tTeff"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ]
    },
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/crosscheck-kharitonov-catalog.dat",
      "url": "https://cdsarc.cds.unistra.fr/ftp/III/202/catalog.dat"
    }
  ]
}
