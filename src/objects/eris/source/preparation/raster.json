{
  "schema": "cssearth-raster-recipe@2",
  "publicBase": "/scenes/eris/",
  "sourceWidth": 2048,
  "sourceHeight": 1024,
  "width": 2048,
  "height": 1024,
  "latitudeBands": 16,
  "polarTile": 256,
  "resample": "density-before-pack",
  "polarProjection": "orthographic-bilinear",
  "polesOutput": "eris-poles-{id}{suffix}.webp",
  "surfaceMetadata": {
    "schema": "csseris-prepared-assets@1"
  },
  "thumbnail": {
    "size": 64
  },
  "surfaces": [
    {
      "id": "color",
      "output": "eris-{id}{suffix}.webp",
      "thumbnail": "eris-dataset-{id}.webp",
      "source": "photometry/disc-color.json",
      "falseColor": false,
      "science": {
        "kind": "disc-integrated-color",
        "illuminant": "reference/CIE_std_illum_D65.csv",
        "qualification": "Uniform whole-disc color and V geometric albedo from published photometry; the surface is unresolved and no map is implied."
      }
    },
    {
      "id": "illustration",
      "output": "eris-{id}{suffix}.webp",
      "thumbnail": "eris-dataset-{id}.webp",
      "source": "nasa-eris.glb",
      "falseColor": false,
      "science": {
        "kind": "glb-base-color",
        "model": "nasa-eris.glb"
      }
    }
  ],
  "lighting": {
    "bank": "sphere",
    "presentationSize": 460
  }
}
