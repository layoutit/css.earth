  "lighting": {
    "bank": "sphere",
    "presentationSize": 460,
    "defaultFrame": 230,
    "bankSchema": "csseris-prepared-lighting-bank@1",
    "billboardSchema": "csseris-prepared-lighting-billboard@1",
    "metadata": {
      "schema": "csseris-prepared-lighting@1",
      "storageModel": "prepared-full-resolution-density-row-shards",
