{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "presentation/InterVariable.ttf",
      "url": "https://raw.githubusercontent.com/rsms/inter/9221beed3/docs/font-files/InterVariable.ttf"
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "III/124/spectra",
        "-out": "lambda,m(HR1457)",
        "-out.max": "1000"
      },
      "requiredText": [
        "m(HR1457)"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ],
      "path": "photometry/kiehling-1987.tsv"
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/claret-2011-v-quadratic.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/A+A/529/A75/table-af",
        "-out.max": "500",
        "Teff": "3500..4250",
        "logg": "1.0..1.5",
        "Z": "=0",
        "xi": "=2",
        "Filt": "V",
        "Met": "L",
        "Mod": "A",
        "-out": "logg,Teff,Z,xi,a,b,Filt,Met,Mod"
      },
      "requiredText": [
        "logg\tTeff"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ]
    },
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/crosscheck-III_126_part2.dat.gz",
      "url": "https://cdsarc.cds.unistra.fr/ftp/III/126/part2.dat.gz"
    }
  ]
}
