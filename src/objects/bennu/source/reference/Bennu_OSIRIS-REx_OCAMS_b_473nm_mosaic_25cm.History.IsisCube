Object = fx
  IsisVersion       = "3.6.1  | 2019-03-14"
  ProgramVersion    = 2016-10-13
  ProgramPath       = /opt/isis3dev/isis3bbdrtf/isis/bin
  ExecutionDateTime = 2020-03-09T13:08:56
  HostName          = ipwg-5
  UserName          = dgolish
  Description       = "Apply generalized arithmetic operations using multiple
                       cube files"

  Group = UserParameters
    F1       = data/20190926T173825S519_map_iofL2b_V004.pho.cub+1
    F2       = 20190926T173825S519_map_iofL2b_V004.pho_pmeas.cub
    F3       = 20190926T173825S519_map_iofL2b_V004.pho_pref.cub
    TO       = ./outtmp.bDbcYG.cub
    EQUATION = f1*f3/f2
    MODE     = CUBES
  End_Group
End_Object

Object = handmos
  IsisVersion       = "3.6.1  | 2019-03-14"
  ProgramVersion    = 2018-08-13
