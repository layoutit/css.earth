    INLINE         = 1
    INBAND         = 1
    OUTSAMPLE      = 1
    OUTLINE        = 1
    OUTBAND        = 1
    MATCHBANDBIN   = FALSE
    MATCHDEM       = FALSE
    HIGHSATURATION = FALSE
    LOWSATURATION  = FALSE
    NULL           = FALSE
    CREATE         = NO
  End_Group
End_Object

