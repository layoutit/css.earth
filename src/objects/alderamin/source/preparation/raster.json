{
  "schema": "cssearth-raster-recipe@1",
  "publicBase": "/scenes/alderamin/",
  "sourceWidth": 1024,
  "sourceHeight": 512,
  "width": 1024,
  "height": 512,
  "latitudeBands": 16,
  "polarTile": 256,
  "resample": "density-before-pack",
  "polarProjection": "orthographic-bilinear",
  "polesCombined": false,
  "polesOutput": "alderamin-poles-{id}{suffix}.webp",
  "surfaceMetadata": {
    "schema": "cssalderamin-prepared-assets@1"
  },
  "thumbnail": {
    "size": 64,
    "quality": 88,
    "centerLongitudeDegrees": 0
  },
  "surfaces": [
    {
      "id": "color",
      "output": "alderamin-surface-{id}{suffix}.webp",
      "thumbnail": "alderamin-lens-{id}.webp",
      "source": "photometry/stellar-color.json",
      "falseColor": false,
      "science": {
        "kind": "stellar-photometric-color",
        "colorMatching": "reference/CIE_xyz_1931_2deg.csv",
        "qualification": "Uniform photosphere colour from the star's ground-based spectrophotometry (Pulkovo catalogue). The surface is darkened by latitude from the published Roche-von Zeipel fit of Zhao et al. (2009): the hot poles brighter and bluer, the cool equator dimmer and redder. The disc is unresolved: it is darkened toward the limb by the quadratic V-band law Claret & Bloemen (2011) compute from ATLAS model atmospheres at the star's temperature and gravity, a model rather than a measurement; no map or absolute brightness is implied. Self-luminous, so no lighting.",
        "gravityDarkening": "photometry/gravity-darkening.json",
        "limbDarkening": {
          "law": "quadratic",
          "path": "photometry/claret-2011-v-quadratic.tsv",
          "grid": {
            "teffK": 7510,
            "logg": 3.91,
            "models": {
              "Filt": "V",
              "Met": "L",
              "Mod": "A"
            }
          },
          "columns": {
            "teff": "Teff",
            "logg": "logg",
            "u1": "a",
            "u2": "b"
          }
        }
      }
    }
  ],
  "emission": {
    "offLimbSize": 600,
    "limbSize": 512,
    "bodyDiameter": 496,
    "offLimbOutput": "alderamin-context-{id}{suffix}.webp",
    "limbOutput": "alderamin-limb-{id}{suffix}.webp",
    "metadata": {
      "schema": "cssalderamin-prepared-emission@1",
      "presentation": "prepared-emissive-surface-with-stationary-off-limb-context-and-limb-plate",
      "offLimbContext": {
        "logicalSize": 600,
        "source": "none: no observation, a transparent plate",
        "composition": "transparent",
        "rotation": "none",
        "runtimeAlphaProcessing": false
      },
      "limbMaterial": {
        "logicalSize": 496,
        "composition": "transparent: the sphere's own silhouette is the limb; the light just outside it is on the off-limb plate",
        "surfaceReplacement": false,
        "runtimeAlphaProcessing": false
      },
      "lighting": false,
      "shadows": false,
      "runtimeLighting": false
    }
  }
}
