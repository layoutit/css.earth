{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/gaia-dr3-source.csv",
      "url": "https://gea.esac.esa.int/tap-server/tap/sync",
      "form": {
        "REQUEST": "doQuery",
        "LANG": "ADQL",
        "FORMAT": "csv",
        "QUERY": "SELECT source_id, ra, dec, phot_g_mean_mag, phot_bp_mean_mag, phot_rp_mean_mag, bp_rp, teff_gspphot, teff_gspphot_lower, teff_gspphot_upper, logg_gspphot, mh_gspphot FROM gaiadr3.gaia_source WHERE source_id = 3767805209112436736"
      },
      "requiredPrefix": "source_id,"
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/patel-2022-limb-darkening.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/AJ/163/228/table4",
        "Name": "WASP-43",
        "-out": "Name,u1-j,u1-j-p,u1-j-n,u2-j,u2-j-p,u2-j-n",
        "-out.meta": "hu"
      },
      "requiredText": [
        "WASP-43"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ]
    }
  ]
}
