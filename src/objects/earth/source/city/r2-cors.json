{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://css.earth",
          "https://www.css.earth",
          "http://127.0.0.1:4210",
          "http://127.0.0.1:4211",
          "http://127.0.0.1:4228",
          "http://127.0.0.1:4430"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "Range"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Range",
        "Content-Length",
        "Accept-Ranges",
        "CF-Cache-Status",
        "Age"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
