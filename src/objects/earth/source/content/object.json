        "falseColor": true,
        "legendNote": "GLAD-M35 r0.1 · 10–2,890 km depth · 1° / 10 km sample grid. Gray: outside model depth coverage. Grid spacing is not resolving power.",
        "facts": [
          {
            "id": "mapped-depth",
