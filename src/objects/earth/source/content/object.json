        "falseColor": true,
        "legend": {
          "kind": "scale",
          "title": "Height / depth · m",
          "sourceUrl": "https://www.gebco.net/data-products-gridded-bathymetry-data/gebco2026-grid",
          "image": "earth-topography-legend.png",
          "width": 620,
          "height": 16,
          "labels": [
            "≤ −10,000 m",
            "0 m",
            "+10,000 m"
          ]
        },
        "legendNote": "0 = mean sea level. Shading emphasizes relief; the color scale is unshaded. Some coastal source datums differ.",
        "notes": "GEBCO_2026 terrain model. Colors show meters above and below mean sea level; relief is shaded for readability. Ocean depths combine measured and estimated terrain. Land includes the ice surface."
      },
      {
        "id": "night-lights",
        "label": "Night lights",
        "thumbnail": "/scenes/earth/earth-lens-night-lights.webp",
        "source": {
          "id": "nasa-black-marble-2025-public-radiance",
          "url": "https://www.lightpollutionmap.info/help.html"
        },
        "falseColor": true,
        "legend": {
          "kind": "scale",
          "title": "Annual radiance · nW/cm²/sr",
          "sourceUrl": "https://doi.org/10.5067/VIIRS/VJ146A4.002",
          "image": "earth-night-lights-legend.png",
          "width": 620,
          "height": 16,
          "labels": [
            "0",
            "≥ 100 nW/cm²/sr"
          ]
        },
        "legendNote": "Logarithmic color scale, capped at 100 nW/cm²/sr. Native pixels are averaged for this globe. Aurora and transient lights can remain; this does not measure sky brightness.",
        "notes": "NASA Black Marble · 2025 annual snow-free radiance. Warm false color shows upward nighttime light on a logarithmic scale. Gray: missing data or outside 75°N–65°S coverage. This is an annual observation, not live lighting."
