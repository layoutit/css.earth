              "id": "matisse",
              "format": "controlled-shape-camera",
              "consumer": "sphere-photograph",
              "metadata": {
                "label": "MATISSE reconstruction",
                "falseColor": false,
                "coverage": "One image of the photosphere reconstructed with the public SQUEEZE code from 780 squared visibilities and 520 closure phases measured by VLT/MATISSE on 8 and 19 February 2020 in the 3.94-4.00 micrometre pseudo-continuum, cast onto a sphere of the published radius. The camera is computed: the rotation pole lies in the plane of the sky at the ALMA position angle, the display meridian is the sub-Earth point at the epoch, and the pixel scale is the reconstruction's. The interferometric beam is 4 milliarcseconds, five pixels, so finer structure is the regulariser's, not the star's. Negating every closure phase fits the data equally well, so which side of the star is brighter is weakly constrained. Grayscale is reconstructed relative intensity in one infrared band, not colour or temperature. The far hemisphere is unobserved."
              },
              "frames": [
                {
                  "id": "matisse-2020-02-continuum",
                  "path": "observations/betelgeuse-matisse-2020-02-continuum-squeeze.fits",
                  "encoding": "fits-oi-reconstruction",
                  "backgroundMaximum": 0.00001,
                  "observerLatitude": 0,
                  "observerWestLongitude": 0,
                  "sunLatitude": 0,
                  "sunWestLongitude": 0,
                  "rangeKm": 5183938336905497,
                  "northAzimuthDegrees": 312,
                  "pixelAngleMicroradians": 0.003781546712654381,
                  "center": [
                    63.996,
                    63
                  ],
                  "reconstruction": {
                    "startTime": "2020-02-08T00:12:31",
                    "filter": "L-band pseudo-continuum 3.942-3.974 and 3.992-3.998 um",
                    "visibilitiesPath": "observations/betelgeuse-matisse-2020-02-continuum.oifits"
                  }
                }
              ],
              "transfer": {
                "maximumSeparationFootprints": 2,
                "visibilityToleranceMeters": 1,
                "maximumEmissionDegrees": 70,
                "interpretation": "Trial acceptance bounds, not estimates of source accuracy. A footprint is the pixel's range times its angular size, 19.6 million kilometres at the disc centre from 168 parsecs, so a contributor lies within two of those of the closest sphere point; the one-metre visibility tolerance is numerically zero on a body this size, and the sphere is convex, so no point occludes another."
              },
              "photometry": {
                "model": "retained-observation",
                "referenceIncidenceDegrees": 0,
                "referenceEmissionDegrees": 0,
                "maximumIncidenceDegrees": 70,
                "maximumEmissionDegrees": 70,
                "maximumGain": 1
              },
              "display": {
