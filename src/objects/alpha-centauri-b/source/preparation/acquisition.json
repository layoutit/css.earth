{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "III/124/spectra",
        "-out": "lambda,m(HR5460)",
        "-out.max": "1000"
      },
      "requiredText": [
        "m(HR5460)"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ],
      "path": "photometry/kiehling-1987.tsv"
    },
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/crosscheck-table6.dat",
      "url": "https://cdsarc.cds.unistra.fr/ftp/III/201/table6.dat"
    }
  ]
}
