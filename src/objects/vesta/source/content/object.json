  "lenses": {
    "titleKey": "lenses",
    "defaultLens": "normal",
    "controls": [
      {
        "id": "normal",
        "label": "Natural color",
        "thumbnail": "/scenes/vesta/vesta-normal-thumbnail.webp",
        "surface": "vesta-normal-surface@2x.webp",
        "poles": "vesta-normal-surface@2x.webp",
        "source": {
          "id": "dlr-hamo-natural-color",
          "path": "../manifest.json"
        },
        "notes": "DLR natural-color composite from Dawn’s 650, 550, and 430 nm filters, calibrated and photometrically corrected. Very bright terrain is clipped to white in the published image. Where the color mosaic has no coverage, the HAMO clear-filter mosaic shows in gray. Local shadows and channel-registration artifacts may remain.",
        "noData": true
      },
      {
        "id": "surface",
        "label": "Clear-filter photography",
        "thumbnail": "/scenes/vesta/vesta-surface-thumbnail.webp",
        "surface": "vesta-surface-surface@2x.webp",
        "poles": "vesta-surface-surface@2x.webp",
        "source": {
          "id": "dlr-vesta-lamo-clear",
          "path": "../manifest.json"
        },
        "notes": "Dawn low-altitude clear-filter photographs in the published DLR mosaic. Sunlit crater walls, shadows and mosaic seams belong to the observations. The source is 20 m/pixel; this simplified display is coarser. The north, which the low orbit never saw lit, takes the 60 m/pixel HAMO mosaic; exact black pixels are withheld by the fill heuristic and drawn as the gray grid.",
        "noData": true
      },
      {
        "id": "hamo",
        "label": "HAMO photography",
        "thumbnail": "/scenes/vesta/vesta-hamo-thumbnail.webp",
        "surface": "vesta-hamo-surface@2x.webp",
        "poles": "vesta-hamo-surface@2x.webp",
        "source": {
          "id": "dlr-vesta-hamo-clear",
          "path": "../manifest.json"
        },
        "notes": "Dawn high-altitude clear-filter photographs in the published DLR mosaic of May 2013, HAMO-1 for the south (2011) and HAMO-2 for the north (June to July 2012). It is the only Dawn product that reaches the north pole, photographed under low northern-spring sun, so the northernmost band is dim. Original illumination and seams remain; exact black is withheld and drawn as the gray grid.",
        "noData": true
      },
      {
        "id": "ratios",
        "label": "Spectral ratios",
        "thumbnail": "/scenes/vesta/vesta-ratios-thumbnail.webp",
        "surface": "vesta-ratios-surface@2x.webp",
        "poles": "vesta-ratios-surface@2x.webp",
        "source": {
          "id": "vesta-ratios",
          "path": "../manifest.json"
        },
        "falseColor": true,
        "notes": "DLR’s published Clementine-style composite of photometrically corrected Dawn images: red is 749/438 nm, green is 749/917 nm, and blue is 438/749 nm. Colors emphasize spectral differences; they are not natural color or a mineral-abundance measurement. Original seams and color fringes remain. Exact black is treated as likely fill, so some dark observations may also be withheld; gaps use the gray grid.",
        "noData": true
      },
      {
        "id": "elevation",
        "label": "Elevation",
        "thumbnail": "/scenes/vesta/vesta-elevation-thumbnail.webp",
        "surface": "vesta-elevation-surface@2x.webp",
        "poles": "vesta-elevation-surface@2x.webp",
        "legend": {
          "kind": "scale",
          "title": "Elevation",
          "width": 256,
          "height": 16,
          "labels": [
            "−45",
            "−2.5",
            "40"
          ],
          "meta": "km · 255 km reference sphere",
          "sourceUrl": "https://dawngis.dlr.de/data/Vesta/dtm_vesta.php",
          "image": "/scenes/vesta/vesta-elevation-legend.webp"
        },
        "source": {
          "id": "dlr-hamo-radius-model",
          "path": "../manifest.json"
        },
        "notes": "Color shows radius minus the source map’s 255 km reference sphere. Brightness adds fixed northwest cartographic relief without height exaggeration. The model includes publisher-interpolated polar regions without a separate validity mask; those areas are not independent stereo observations. Shadows adds approximate fixed-epoch Sun lighting."
      }
    ]
  },
