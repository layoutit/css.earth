PDS_VERSION_ID                    = PDS3

/* FILE DATA ELEMENTS */

RECORD_TYPE                       = FIXED_LENGTH
RECORD_BYTES                      = 80112
FILE_RECORDS                      = 40059
LABEL_RECORDS                     = 2

/* POINTERS TO DATA OBJECTS */

^IMAGE_HEADER                     = 3
^IMAGE                            = 4

/* DATA OBJECT DEFINITIONS */

OBJECT                            = IMAGE
  INTERCHANGE_FORMAT              = BINARY
  LINES                           = 40056
  LINE_SAMPLES                    = 80112
  SAMPLE_TYPE                     = UNSIGNED_INTEGER
  SAMPLE_BITS                     = 8
  BANDS                           = 1
  BAND_STORAGE_TYPE               = BAND_SEQUENTIAL
END_OBJECT                        = IMAGE

/* MAP OBJECT DEFINITIONS */

OBJECT                            = IMAGE_MAP_PROJECTION
  A_AXIS_RADIUS                   = 255.0
  B_AXIS_RADIUS                   = 255.0
  C_AXIS_RADIUS                   = 255.0
  CENTER_LATITUDE                 = 0.0
  CENTER_LONGITUDE                = 180.0
  COORDINATE_SYSTEM_NAME          = PLANETOCENTRIC
  EASTERNMOST_LONGITUDE           = 360.0
  LINE_PROJECTION_OFFSET          = 20027.0
  MAP_PROJECTION_TYPE             = SIMPLE_CYLINDRICAL
  MAP_RESOLUTION                  = 222.529479629277
  MAP_SCALE                       = 0.02 <km/pixel>
  MAXIMUM_LATITUDE                = 90.0
  MINIMUM_LATITUDE                = -90.0
  POSITIVE_LONGITUDE_DIRECTION    = EAST
  SAMPLE_PROJECTION_OFFSET        = 40055.3
  WESTERNMOST_LONGITUDE           = 0.0
END_OBJECT                        = IMAGE_MAP_PROJECTION

/* MISCELLANEOUS */

TARGET_NAME                       = VESTA
PRODUCER_INSTITUTION_NAME         = "German Aerospace Center (DLR)"
PRODUCT_CREATION_TIME             = 2012-09-04T10:49:29.000

/* IMAGE HEADER DATA ELEMENTS */

OBJECT                         = IMAGE_HEADER
 HEADER_TYPE                   = VICAR2
 INTERCHANGE_FORMAT            = ASCII
 BYTES                         = 80112
 ^DESCRIPTION                  = "VICAR2.TXT"
END_OBJECT                     = IMAGE_HEADER
END
