{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "presentation/InterVariable.ttf",
      "url": "https://raw.githubusercontent.com/rsms/inter/9221beed3/docs/font-files/InterVariable.ttf"
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/gaia-dr3-xp-sampled.csv",
      "url": "https://gaia.ari.uni-heidelberg.de/tap/sync",
      "form": {
        "REQUEST": "doQuery",
        "LANG": "ADQL",
        "FORMAT": "csv",
        "QUERY": "SELECT source_id, ra, dec, flux, flux_error, solution_id FROM gaiadr3.xp_sampled_mean_spectrum WHERE source_id = 2300641567596591488"
      },
      "requiredPrefix": "source_id,ra,dec,flux,flux_error,solution_id"
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/claret-2011-v-quadratic.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/A+A/529/A75/table-af",
        "-out.max": "500",
        "Teff": "5000..5250",
        "logg": "4.5..5",
        "Z": "=0",
        "xi": "=2",
        "Filt": "V",
        "Met": "L",
        "Mod": "A",
        "-out": "logg,Teff,Z,xi,a,b,Filt,Met,Mod"
      },
      "requiredText": [
        "logg\tTeff"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ]
    },
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/gaia-dr3-source.csv",
      "url": "https://gea.esac.esa.int/tap-server/tap/sync",
      "form": {
        "REQUEST": "doQuery",
        "LANG": "ADQL",
        "FORMAT": "csv",
        "QUERY": "SELECT s.source_id, s.ref_epoch, s.ra, s.dec, s.parallax, s.parallax_error, s.pmra, s.pmdec, s.radial_velocity, s.radial_velocity_error, s.ruwe, s.phot_g_mean_mag, s.bp_rp, s.has_xp_sampled, a.mass_flame, a.mass_flame_lower, a.mass_flame_upper, a.radius_flame, a.radius_flame_lower, a.radius_flame_upper FROM gaiadr3.gaia_source AS s LEFT JOIN gaiadr3.astrophysical_parameters AS a ON a.source_id = s.source_id WHERE s.source_id = 2300641567596591488"
      },
      "requiredPrefix": "source_id,"
    }
  ]
}
