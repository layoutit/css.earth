                    "50"
                  ]
                },
                "meta": "JWST/NIRCam F182M, 11 October 2023 · logarithmic, Gáspár et al. (2026) Figure 26",
                "sourceUrl": "https://arxiv.org/abs/2608.27437"
              }
            }
          ]
        },
