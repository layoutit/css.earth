{
  "schema": "cssearth-acquisition-plan@1",
  "operations": [
    {
      "kind": "request-download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/claret-2011-v-quadratic.tsv",
      "url": "https://vizier.cds.unistra.fr/viz-bin/asu-tsv",
      "form": {
        "-source": "J/A+A/529/A75/table-af",
        "-out.max": "500",
        "Teff": "4750..5000",
        "logg": "0.5..1",
        "Z": "=0",
        "xi": "=2",
        "Filt": "V",
        "Met": "L",
        "Mod": "A",
        "-out": "logg,Teff,Z,xi,a,b,Filt,Met,Mod"
      },
      "requiredText": [
        "logg\tTeff"
      ],
      "replacements": [
        {
          "pattern": "^#.*\\n",
          "flags": "gm",
          "replacement": ""
        },
        {
          "pattern": "^\\s*\\n",
          "flags": "gm",
          "replacement": ""
        }
      ]
    },
    {
      "kind": "download",
      "groups": [
        "restore",
        "refresh"
      ],
      "path": "photometry/exposure-header.txt",
      "url": "https://mast.stsci.edu/api/v0.1/Download/file?uri=mast:HST/product/u6fv0101m_c0m.fits"
    }
  ]
}
