  "id": "belinda",
  "displayName": "Belinda",
  "panel": {
    "introduction": "Belinda is an elongated inner moon of Uranus, discovered in Voyager 2 images in 1986. Its changing brightness supports a shape about twice as long as it is wide. It travels around Uranus in roughly fifteen hours.",
    "facts": [
      {
        "id": "radius",
        "label": "Volume-equivalent model radius",
        "value": "40.3 km"
      },
      {
        "id": "dimensions",
        "label": "Approximate dimensions",
        "value": "128 × 64 × 64 km (prolate model)"
      },
      {
        "id": "orbital-period",
        "label": "Orbit around Uranus",
        "value": "About 15.0 hours"
      },
      {
        "id": "distance-from-parent",
        "label": "Distance from Uranus",
        "value": "About 75,255 km"
      },
      {
        "id": "discovery",
        "label": "Discovery",
        "value": "Voyager 2 · 1986"
      },
      {
        "id": "uncertainty",
        "label": "Projected equivalent radius",
        "value": "45 ± 8 km"
      }
    ],
    "moreFacts": []
  },
