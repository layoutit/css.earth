  "lenses": {
    "titleKey": "lenses",
    "defaultLens": "normal",
    "labels": {
      "normal": "Monochrome",
      "enhanced": "Enhanced color",
      "elevation": "Elevation",
      "relative-albedo": "Relative albedo",
      "shape": "Shape"
    },
    "controls": [
      {
        "id": "normal",
        "label": "Monochrome",
        "thumbnail": "/scenes/rhea/rhea-normal-thumbnail.webp",
        "surface": "rhea-normal-surface@2x.webp",
        "poles": "rhea-normal-poles@2x.webp",
        "source": {
          "id": "cassini-voyager-2012-rhea",
          "path": "../manifest.json"
        },
        "notes": "USGS 2012 Cassini/Voyager mosaic, about 417 m per source pixel, downsampled to 8192 × 4096. Photographed shadows and variable resolution remain; globe Shadows adds approximate lighting. Gray grid marks explicit source no-data. Mapped onto a simplified Cassini SPC shape; independent image control can leave local registration differences.",
        "noData": true
      },
      {
        "id": "enhanced",
        "label": "Enhanced color",
        "thumbnail": "/scenes/rhea/rhea-enhanced-thumbnail.webp",
        "surface": "rhea-enhanced-surface@2x.webp",
        "poles": "rhea-enhanced-poles@2x.webp",
        "source": {
          "id": "cassini-iss-2014-rhea-color",
          "path": "../manifest.json"
        },
        "notes": "Published 2014 enhanced-color composite, about 400 m per source pixel, photometrically corrected by Paul Schenk. Colors extend beyond human vision into ultraviolet and infrared. Real hemisphere differences, residual photographed shading and source seams remain. Mapped onto a simplified Cassini SPC shape; independent image control can leave local registration differences."
      },
      {
        "id": "elevation",
        "label": "Elevation",
        "thumbnail": "/scenes/rhea/rhea-elevation-thumbnail.webp",
        "surface": "rhea-elevation-surface@2x.webp",
        "poles": "rhea-elevation-poles@2x.webp",
        "source": {
          "id": "cassini-spc-2025-rhea",
          "path": "../manifest.json"
        },
        "legend": {
          "kind": "scale",
          "title": "Elevation",
          "width": 256,
          "height": 16,
          "labels": [
            "−10",
            "0",
            "+10"
          ],
          "meta": "km",
          "sourceUrl": "https://sbn.psi.edu/pds/resource/weirichrheashape.html",
          "image": "/scenes/rhea/rhea-elevation-legend.webp"
        },
        "notes": "Color shows height above the PDS 763.5 km reference sphere. Brightness shows fixed northwest relief at true height scale; Shadows adds shared approximate globe lighting. Cassini SPC model released in 2025, about 2.15 km grid spacing. The producer’s one-to-two-grid-spacing accuracy estimate is based on simulations; it is not an independent uncertainty measurement for Rhea. Gray grid marks uncovered raster edges. The globe follows a simplified Q128 source shape.",
        "noData": true
      },
      {
        "id": "relative-albedo",
        "label": "Relative albedo",
        "thumbnail": "/scenes/rhea/rhea-relative-albedo-thumbnail.webp",
        "surface": "rhea-relative-albedo-surface@2x.webp",
        "poles": "rhea-relative-albedo-poles@2x.webp",
        "source": {
          "id": "cassini-spc-2025-rhea-rhea_albedo_g",
          "path": "../manifest.json"
        },
        "legend": {
          "kind": "scale",
          "title": "Relative albedo",
          "width": 256,
          "height": 16,
          "labels": [
            "0.5",
            "1",
            "≥ 1.5"
          ],
          "meta": "relative to mean ≈ 1",
          "sourceUrl": "https://sbn.psi.edu/pds/resource/weirichrheashape.html",
          "image": "/scenes/rhea/rhea-relative-albedo-legend.webp"
        },
        "notes": "Relative brightness solved together with the Cassini SPC shape model, normalized around 1. This secondary model product is less validated than topography. It is neither visible color nor calibrated reflectance. Colors show 0.5–1.5; values above 1.5 saturate. Gray grid preserves source gaps.",
        "noData": true
      },
      {
        "id": "shape",
        "label": "Shape",
        "thumbnail": "/scenes/rhea/rhea-shape-thumbnail.webp",
        "surface": "rhea-shape-surface@2x.webp",
        "poles": "rhea-shape-poles@2x.webp",
        "source": {
          "id": "cassini-spc-2025-rhea-q128-shape",
          "path": "../manifest.json"
        },
        "notes": "Neutral gray over a simplified source shape, without photographic texture or height exaggeration. Source model detail and accuracy vary. Cassini SPC Q128 model released in 2025. The 2,000-face view retains broad shape; small terrain details are omitted. Neutral gray (#808080 sRGB) is a shared display convention, not measured surface color or albedo.",
        "noData": true
      },
      {
        "id": "infrared",
        "label": "Infrared",
        "thumbnail": "/scenes/rhea/rhea-infrared-thumbnail.webp",
        "surface": "rhea-infrared-surface@2x.webp",
        "poles": "rhea-infrared-poles@2x.webp",
        "source": {
          "id": "rhea-vims-infrared",
          "path": "../manifest.json",
          "url": "https://doi.org/10.17189/ctqe-ta30"
        },
        "falseColor": true,
        "notes": "Cassini VIMS false color: red 2.00 µm, green 1.57 µm, blue 1.06 µm. The archive corrects illumination to incidence 30° and emergence 0°; fixed display ranges are shared with Dione. One-degree source cells remain visible. Gray grid marks missing spectra. Archive registration is uncertain at about the source-pixel scale; no subdegree positional accuracy is implied.",
        "noData": true
      },
      {
        "id": "ice-absorption",
        "label": "Ice absorption",
        "thumbnail": "/scenes/rhea/rhea-ice-absorption-thumbnail.webp",
        "surface": "rhea-ice-absorption-surface@2x.webp",
        "poles": "rhea-ice-absorption-poles@2x.webp",
        "source": {
          "id": "rhea-vims-ice-absorption",
          "path": "../manifest.json",
          "url": "https://doi.org/10.17189/ctqe-ta30"
        },
        "falseColor": true,
        "legend": {
          "kind": "scale",
          "title": "Water-ice absorption",
          "width": 256,
          "height": 16,
          "labels": [
            "≤ 0.30",
            "0.525",
            "≥ 0.75"
          ],
          "meta": "2.02 µm band depth",
          "sourceUrl": "https://doi.org/10.17189/ctqe-ta30",
          "image": "/scenes/rhea/rhea-ice-absorption-legend.webp"
        },
        "notes": "Strength of the 2.02 µm water-ice absorption relative to a linear 1.82–2.20 µm continuum. Derived from Cassini VIMS; this is not ice percentage, grain size or crystallinity. Colors saturate below 0.30 and above 0.75. One-degree source cells and missing or invalid-continuum cells are retained. The archive has unresolved registration differences at source-pixel scale."
      }
    ]
  },
