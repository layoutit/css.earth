{"schema":"csssun-prepared-panel@1","sourceId":108082,"sourceUrl":"https://science.nasa.gov/sun/facts/","modified":"2025-04-22T17:20:49","retrievedAt":"2026-08-31","introduction":"At the center of our solar system, the Sun is a 4.5-billion-year-old yellow dwarf star. Its light and heat make life on Earth possible.","facts":[{"id":"radius","label":"Approximate radius","value":"700,000 km"},{"id":"distance-from-earth","label":"Mean distance from Earth","value":"150 million km"},{"id":"rotation-period","label":"Equatorial rotation","value":"About 25 days","source":{"url":"https://science.nasa.gov/sun/facts/","label":"NASA/JPL reference","checked":"2026-09-08","path":"source/editorial/factsheet-review.json"}},{"id":"galactic-orbit","label":"Galactic orbit","value":"230 million years"}],"moreFacts":[{"id":"age","label":"Age","value":"4.5 billion years"},{"id":"solar-system-mass","label":"Share of system mass","value":"About 99.8%"},{"id":"photosphere-temperature","label":"Photosphere temperature","value":"5,500 °C"},{"id":"core-temperature","label":"Core temperature","value":"15 million °C"},{"id":"activity-cycle","label":"Activity cycle","value":"About 11 years","source":{"url":"https://science.nasa.gov/heliophysics/focus-areas/solar-science/","label":"NASA/JPL reference","checked":"2026-09-08","path":"source/editorial/factsheet-review.json"}},{"id":"magnetic-cycle","label":"Magnetic cycle","value":"About 22 years","source":{"url":"https://science.nasa.gov/heliophysics/focus-areas/solar-science/","label":"NASA/JPL reference","checked":"2026-09-08","path":"source/editorial/factsheet-review.json"}}]}
