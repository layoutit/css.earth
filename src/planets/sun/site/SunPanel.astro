---
import { objectControls } from "./control-content.mjs";
const { lenses, settings } = objectControls;
import PlanetShell from "../../../../site/components/PlanetShell.astro";
import { PREPARED_SHELL_TITLES } from "../../../../site/prepared-shell-titles.mjs";
import { PREPARED_SUN_PANEL } from "./preparedPanel.mjs";
import { PREPARED_SUN_TITLE } from "./preparedTitle.mjs";

const resources = [
  { label: "NASA Science", description: "Facts & interior", href: "https://science.nasa.gov/sun/facts/" },
  { label: "NASA SDO", description: "Solar surface & corona", href: "https://sdo.gsfc.nasa.gov/data/synoptic/" },
  { label: "JSOC HMI", description: "Magnetic surface lens", href: "https://jsoc.stanford.edu/HMI/LOS_Synoptic_charts.html" },
  { label: "HYG", description: "Background star field", href: "https://github.com/astronexus/HYG-Database" },
];
---

<PlanetShell
  objectId="sun"
  title={PREPARED_SUN_TITLE}
  introduction={PREPARED_SUN_PANEL.introduction}
  facts={PREPARED_SUN_PANEL.facts}
  moreFacts={PREPARED_SUN_PANEL.moreFacts}
  resources={resources}
  lenses={lenses}
  settings={settings}
/>
