                "checked": "2026-09-08",
                "path": "source/editorial/factsheet-review.json"
              }
            },
            {
              "id": "distance-from-sun",
              "label": "System solar semimajor axis",
              "value": "9.537 AU",
              "source": {
                "url": "https://ssd.jpl.nasa.gov/planets/approx_pos.html",
                "label": "NASA/JPL reference",
                "checked": "2026-09-08",
                "path": "source/editorial/factsheet-review.json"
              }
            },
            {
              "id": "orbital-period",
              "label": "Orbit around Saturn",
              "value": "About 550 days (retrograde)"
            },
            {
              "id": "rotation-period",
              "label": "Rotation period",
              "value": "About 9 hours 16 minutes"
            },
            {
