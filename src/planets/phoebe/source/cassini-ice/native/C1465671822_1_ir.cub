/* Qube structure: Standard ISIS Cube of VIMS Data */
^QUBE                                    = 48

Object = HISTORY
End_Object

Object = QUBE
  AXES                           = 3
  AXIS_NAME                      = (SAMPLE, BAND, LINE)

  /* Core description. */
  CORE_ITEMS                     = (36, 352, 24)
