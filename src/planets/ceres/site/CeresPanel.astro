---
import { objectControls } from "./control-content.mjs";
const { lenses, settings } = objectControls;
import PlanetShell from "../../../../site/components/PlanetShell.astro";
import { PREPARED_SHELL_TITLES } from
  "../../../../site/prepared-shell-titles.mjs";
import { PREPARED_CERES_PANEL } from "./preparedPanel.mjs";
import { PREPARED_CERES_TITLE } from "./preparedTitle.mjs";


const resources = [
  { label: "NASA", role: "facts", description: "Ceres facts", href: "https://science.nasa.gov/dwarf-planets/ceres/facts/" },
  { label: "USGS", role: "surface", description: "Dawn global mosaic", href: "https://astrogeology.usgs.gov/search/map/ceres_dawn_fc_global_mosaic_140m" },
  { label: "Dawn", role: "color", description: "Enhanced-color map", href: "https://science.nasa.gov/resource/hints-at-ceres-composition-from-color/" },
  { label: "ESO", role: "stars", description: "Milky Way panorama", href: "https://www.eso.org/public/images/eso0932a/" },
];
---

<PlanetShell
  objectId="ceres"
  title={PREPARED_CERES_TITLE}
  introduction={PREPARED_CERES_PANEL.introduction}
  facts={PREPARED_CERES_PANEL.facts}
  moreFacts={PREPARED_CERES_PANEL.moreFacts}
  resources={resources}
  lenses={lenses}
  settings={settings}
/>
