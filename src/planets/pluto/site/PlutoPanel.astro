---
import { objectControls } from "./control-content.mjs";
const { lenses, settings } = objectControls;
import PlanetShell from "../../../../site/components/PlanetShell.astro";
import { PREPARED_SHELL_TITLES } from
  "../../../../site/prepared-shell-titles.mjs";
import { PREPARED_PLUTO_PANEL } from "./preparedPanel.mjs";
import { PREPARED_PLUTO_TITLE } from "./preparedTitle.mjs";


const resources = [
  { label: "NASA", role: "facts", description: "Pluto facts", href: "https://science.nasa.gov/dwarf-planets/pluto/facts/" },
  { label: "New Horizons", role: "surface", description: "MVIC color map", href: "https://science.nasa.gov/resource/pluto-global-color-map/" },
  { label: "USGS", role: "maps", description: "Mosaic and elevation", href: "https://astrogeology.usgs.gov/search/map/pluto_new_horizons_lorri_mvic_global_dem_300m" },
  { label: "JPL", role: "physical", description: "Physical parameters", href: "https://ssd.jpl.nasa.gov/planets/phys_par.html" },
  { label: "ESO", role: "stars", description: "Background star field", href: "https://www.eso.org/public/images/eso0932a/" },
];
---

<PlanetShell
  objectId="pluto"
  title={PREPARED_PLUTO_TITLE}
  introduction={PREPARED_PLUTO_PANEL.introduction}
  facts={PREPARED_PLUTO_PANEL.facts}
  moreFacts={PREPARED_PLUTO_PANEL.moreFacts}
  resources={resources}
  lenses={lenses}
  settings={settings}
/>
