---
import { objectControls } from "./control-content.mjs";
const { lenses, settings } = objectControls;
import PlanetShell from "../../../../site/components/PlanetShell.astro";
import { PREPARED_SHELL_TITLES } from
  "../../../../site/prepared-shell-titles.mjs";
import { PREPARED_MOON_PANEL } from "./preparedPanel.mjs";
import { PREPARED_MOON_TITLE } from "./preparedTitle.mjs";


const resources = [
  { label: "NASA Science", role: "facts", description: "Moon facts", href: "https://science.nasa.gov/moon/facts/" },
  { label: "NASA SVS", role: "surface", description: "LRO colour map", href: "https://svs.gsfc.nasa.gov/4720/" },
  { label: "JPL", role: "orbit", description: "Physical & orbital data", href: "https://ssd.jpl.nasa.gov/sats/" },
  { label: "OpenSpace", role: "scene", description: "Globe configuration", href: "https://github.com/OpenSpace/OpenSpace" },
  { label: "ESO", role: "stars", description: "Background star field", href: "https://www.eso.org/public/images/eso0932a/" },
];
---

<PlanetShell
  objectId="moon"
  title={PREPARED_MOON_TITLE}
  introduction={PREPARED_MOON_PANEL.introduction}
  facts={PREPARED_MOON_PANEL.facts}
  moreFacts={PREPARED_MOON_PANEL.moreFacts}
  resources={resources}
  lenses={lenses}
  settings={settings}
/>
