        "displayName": "Despina",
        "panel": {
          "introduction": "Despina is a small, irregular moon inside Neptune’s faint ring system. Voyager images constrain its overall shape, but do not provide reliable surface mapping at this scale.",
          "facts": [
            {
              "id": "radius",
              "label": "Reference radius",
              "value": "74 km"
            },
            {
              "id": "dimensions",
              "label": "Dimensions",
              "value": "About 180 × 148 × 128 km"
            },
            {
              "id": "orbital-period",
              "label": "Orbit around Neptune",
              "value": "About 8.03 hours"
            },
            {
              "id": "distance-from-parent",
              "label": "Mean distance from Neptune",
              "value": "About 52,526 km"
            },
            {
              "id": "rotation-period",
              "label": "Rotation period",
              "value": "Synchronous model"
            },
            {
              "id": "discovery",
              "label": "Discovery",
              "value": "Voyager 2 science team · July 1989"
            }
          ],
          "moreFacts": []
        },
