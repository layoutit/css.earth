            "model": "Shape model"
          },
          "controls": [
            {
              "id": "model",
              "label": "Shape model",
              "description": "A triaxial ellipsoid fitted to Voyager images by Karkoschka (2003), with semi-axes of 90 × 74 × 64 km. The images constrain the outline rather than a reliable map of craters or terrain. The standard gray grid marks unavailable surface coverage; shared lighting describes the model shape. The 74 km radius sets the scene scale and is not a replacement for the three measured axes.",
              "title": "Approximate shape model",
              "detail": "Measured axes",
              "thumbnail": "/scenes/despina/despina-model-thumbnail.webp",
              "surface": "despina-model-surface@2x.webp",
              "poles": "despina-model-poles@2x.webp",
              "source": {
