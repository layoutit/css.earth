/* File Structure */
RECORD_TYPE                              = FIXED_LENGTH
RECORD_BYTES                             = 512
FILE_RECORDS                             = 3421
LABEL_RECORDS                            = 21
FILE_STATE                               = CLEAN

/* Pointer to ISIS history label */
^HISTORY                                 = 22

/* Qube structure: Standard ISIS Cube of VIMS Data */
^QUBE                                    = 47

Object = HISTORY
End_Object

Object = QUBE
  AXES                           = 3
  AXIS_NAME                      = (SAMPLE, BAND, LINE)

  /* Core description. */
  CORE_ITEMS                     = (48, 352, 48)
  CORE_ITEM_BYTES                = 2
  CORE_ITEM_TYPE                 = SUN_INTEGER
  CORE_BASE                      = 0.0
  CORE_MULTIPLIER                = 1.0
