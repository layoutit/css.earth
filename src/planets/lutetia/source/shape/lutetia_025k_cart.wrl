appearance Appearance {                                                       
material Material {                                                           
  diffuseColor 1.0 1. 1.                                                      
  specularColor 0. 0. 0.                                                      
  emissiveColor 0.1 0.1 0.1                                                   
  ambientIntensity 1.                                                         
  shininess  0.                                                               
  transparency 0.0                                                            
} }                                                                           
}    ### Shape                                                                
                                                                              
####  Define "extra" viewpoints and lighting conditions                       
                                                                              
####  ----Sunlight illumination during Stardust NExT encounter -------------  
### Sun is at lat 6.4 deg, long 32.32 deg                                     
DEF sunLight DirectionalLight {                                               
   direction -0.839809  -0.531315  -0.111469   # sun's position wrt nucleus   
   intensity 0.0                                                              
}                                                                             
                                                                              
#### --------- Define the headlight for general lighting --------------       
DEF navLight NavigationInfo {                                                 
      headlight FALSE                                                         
      type "EXAMINE"	                                                         
}                                                                             
                                                                              
DEF lightCond Script {                                                        
  eventIn SFBool dl_isActive                                                  
  eventIn SFBool hl_isActive                                                  
  field SFNode sunLight USE sunLight                                          
  field SFNode navLight USE navLight                                          
  url "javascript:                                                            
                                                                              
    function dl_isActive(){                                                   
      sunLight.intensity = 1.;                                                
      navLight.headlight = FALSE;                                             
    }                                                                         
                                                                              
    function hl_isActive(){                                                   
      sunLight.intensity = 0.;                                                
      navLight.headlight = TRUE;                                              
    }                                                                         
  "                                                                           
}                                                                             
                                                                              
### ---------------------------------------------------------------           
### ---------------------------------------------------------------           
##### Group for Headlight illumination                                        
                                                                              
Group { children [                                                            
  DEF HL_PZ ProximitySensor {                                                 
     center 0 0 4e3                                                           
     size     1.e2 1.e2 1.e2                                                  
   },                                                                         
  Viewpoint {                                                                 
    description "View above North Pole (+Z)"                                  
    fieldOfView 0.0350                                                        
    position 0 0 4e3                                                          
    orientation 0. 0. 1. 0                                                    
  }                                                                           
  ROUTE HL_PZ.isActive TO lightCond.hl_isActive                               
]}                                                                            
                                                                              
Group { children [                                                            
  DEF HL_MZ ProximitySensor {                                                 
     center  0. 0. -4e3                                                       
     size     1.e2 1.e2 1.e2                                                  
  },                                                                          
  Viewpoint {                                                                 
    description "View above South Pole (-Z)"                                  
    fieldOfView 0.0350                                                        
    position 0. 0. -4e3                                                       
    orientation 0. 1. 0. -3.14159                                             
  }                                                                           
  ROUTE HL_MZ.isActive TO lightCond.hl_isActive                               
]}                                                                            
                                                                              
Group { children [                                                            
  DEF HL_PX ProximitySensor {                                                 
     center  4e3 0 0                                                          
     size     1e2 1e2 1e2                                                     
  },                                                                          
  Viewpoint {                                                                 
    description "View from +X Direction"                                      
    fieldOfView 0.0350                                                        
    position 4e3 0 0                                                          
    orientation 0 1 0 1.5708                                                  
  }                                                                           
  ROUTE HL_PX.isActive TO lightCond.hl_isActive                               
]}                                                                            
                                                                              
Group { children [                                                            
  DEF HL_MX ProximitySensor {                                                 
     center  -4e3 0 0                                                         
     size     1e2 1e2 1e2                                                     
  },                                                                          
  Viewpoint {                                                                 
    description "View from -X Direction"                                      
    fieldOfView 0.0350                                                        
    position -4e3 0 0                                                         
    orientation 0 1 0 -1.5708                                                 
  },                                                                          
  ROUTE HL_MX.isActive TO lightCond.hl_isActive                               
]}                                                                            
                                                                              
Group { children [                                                            
  DEF HL_PY ProximitySensor {                                                 
     center  0 4e3 0                                                          
     size     1e2 1e2 1e2                                                     
  },                                                                          
  Viewpoint {                                                                 
    description "View from +Y Direction"                                      
    fieldOfView 0.0350                                                        
    position 0 4e3 0                                                          
    orientation 1 0 0 -1.5708                                                 
  }                                                                           
  ROUTE HL_PY.isActive TO lightCond.hl_isActive                               
]}                                                                            
                                                                              
Group { children [                                                            
  DEF HL_MY ProximitySensor {                                                 
     center  0 -4e3 0                                                         
     size     1e2 1e2 1e2                                                     
  },                                                                          
  Viewpoint {                                                                 
    description "View from -Y Direction"                                      
    fieldOfView 0.0350                                                        
    position 0 -4e3 0                                                         
    orientation 1 0 0 1.5708                                                  
  }                                                                           
  ROUTE HL_MY.isActive TO lightCond.hl_isActive                               
]}   #### End Headlight illuminated group                                     
