  CORE_HIGH_INSTR_SATURATION     = -32765
  CORE_MINIMUM_DN                = -293
  CORE_NAME                      = RAW_DATA_NUMBER
  CORE_UNIT                      = DIMENSIONLESS

  /* Suffix description. */
  SUFFIX_ITEMS                   = (1, 4, 0)
  SUFFIX_BYTES                   = 4
  SAMPLE_SUFFIX_NAME             = BACKGROUND
  SAMPLE_SUFFIX_UNIT             = DIMENSIONLESS
