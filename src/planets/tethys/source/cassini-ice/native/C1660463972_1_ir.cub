  SAMPLE_SUFFIX_LOW_REPR_SAT     = -32767
  SAMPLE_SUFFIX_LOW_INSTR_SAT    = -32766
  SAMPLE_SUFFIX_HIGH_REPR_SAT    = -32764
  SAMPLE_SUFFIX_HIGH_INSTR_SAT   = -32765
  BAND_SUFFIX_NAME               = (IR_DETECTOR_TEMP_HIGH_RES_1,
