/* File Structure */
RECORD_TYPE                              = FIXED_LENGTH
RECORD_BYTES                             = 512
FILE_RECORDS                             = 486
LABEL_RECORDS                            = 21
FILE_STATE                               = CLEAN

/* Pointer to ISIS history label */
^HISTORY                                 = 22

/* Qube structure: Standard ISIS Cube of VIMS Data */
^QUBE                                    = 47

Object = HISTORY
End_Object

Object = QUBE
  AXES                           = 3
  AXIS_NAME                      = (SAMPLE, BAND, LINE)

  /* Core description. */
  CORE_ITEMS                     = (24, 352, 12)
