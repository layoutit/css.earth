PDS_VERSION_ID        = PDS3                                                  
                                                                              
PRODUCT_ID            = "SHAPE-951GASPRAM-200202"                             
PRODUCT_NAME          = "951 GASPRA IMAGE MOSAIC"                             
PRODUCT_CREATION_TIME = 2000-06-01  /*  Peer Review Date  */                  
                                                                              
RECORD_TYPE           = "FIXED_LENGTH"                                        
RECORD_BYTES          = 2880                                                  
FILE_RECORDS          = 361                                                   
                                                                              
^HEADER               = ("951GASPRAM.FIT",1)                                  
^IMAGE                = ("951GASPRAM.FIT",2)                                  
                                                                              
DATA_SET_ID           = "EAR-A-5-DDR-SHAPE-MODELS-V2.1"                       
INSTRUMENT_HOST_NAME  = "GALILEO ORBITER"                                     
INSTRUMENT_NAME       = "SOLID STATE IMAGING SYSTEM"                          
START_TIME            = 1991-10-29T14:33:45.592                               
STOP_TIME             = 1991-10-29T22:26:15.149                               
TARGET_NAME           = "951 GASPRA"                                          
DESCRIPTION           = "Image mosaic of 951 Gaspra.  This image              
  mosaic is a high-pass filtered version constructed from Galileo             
  SSI images in a simple cylindrical projection.  The images used             
  were the highest resolution pair, 107318313 and 107318326.  The             
  highest resolution on these images is approximately 55 m/pixel.             
  Areas with poor or no coverage are left black.  Resolution on               
  original images varied greatly, so some regions of low intrinsic            
  resolution are very oversampled in the resampled mosaic.  The               
  scale is 2 pixels/degree.  The mosaic is centered on 0 latitude,            
  0 longitude, with longitude increasing to the west."                        
                                                                              
OBJECT     = HEADER                                                           
  INTERCHANGE_FORMAT = "ASCII"                                                
  HEADER_TYPE        = "FITS"                                                 
  BYTES              = 2880                                                   
  RECORDS            = 1                                                      
  DESCRIPTION        = "FITS header for image mosaic of Gaspra"               
END_OBJECT                                                                    
                                                                              
OBJECT     = IMAGE                                                            
  LINES           = 360                                                       
  LINE_SAMPLES    = 720                                                       
  SAMPLE_BITS     = 8                                                         
  SAMPLE_TYPE     = "MSB_UNSIGNED_INTEGER"                                    
  AXIS_ORDER_TYPE = "FIRST_INDEX_FASTEST"                                     
END_OBJECT                                                                    
                                                                              
END                                                                           
