---
import PlanetShell from "../../../../site/components/PlanetShell.astro";
import { objectControls } from "./control-content.mjs";
import { PREPARED_EUROPA_PANEL as panel } from "./preparedPanel.mjs";
import { PREPARED_EUROPA_TITLE as title } from "./preparedTitle.mjs";
const resources=[
 {label:"NASA",role:"facts",description:"Europa facts",href:"https://science.nasa.gov/jupiter/jupiter-moons/europa/europa-facts/"},
 {label:"USGS",role:"surface",description:"Voyager/Galileo global mosaic",href:"https://astrogeology.usgs.gov/search/map/europa_voyager_galileo_ssi_global_mosaic_500m"},
 {label:"ESO",role:"stars",description:"Milky Way panorama",href:"https://www.eso.org/public/images/eso0932a/"},
];
---
<PlanetShell objectId="europa" title={title} introduction={panel.introduction} facts={panel.facts} moreFacts={panel.moreFacts} resources={resources} lenses={objectControls.lenses} settings={objectControls.settings} />
