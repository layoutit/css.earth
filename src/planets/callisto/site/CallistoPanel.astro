---
import PlanetShell from "../../../../site/components/PlanetShell.astro";
import { objectControls } from "./control-content.mjs";
import { PREPARED_CALLISTO_PANEL as panel } from "./preparedPanel.mjs";
import { PREPARED_CALLISTO_TITLE as title } from "./preparedTitle.mjs";
const resources=[
 {label:"NASA",role:"facts",description:"Callisto facts",href:"https://science.nasa.gov/jupiter/jupiter-moons/callisto/facts/"},
 {label:"USGS",role:"surface",description:"Voyager/Galileo global mosaic",href:"https://astrogeology.usgs.gov/search/map/callisto_galileo_voyager_global_mosaic_1km"},
 {label:"ESO",role:"stars",description:"Milky Way panorama",href:"https://www.eso.org/public/images/eso0932a/"},
];
---
<PlanetShell objectId="callisto" title={title} introduction={panel.introduction} facts={panel.facts} moreFacts={panel.moreFacts} resources={resources} lenses={objectControls.lenses} settings={objectControls.settings} />
