            {
              "id": "normal",
              "label": "Monochrome",
              "description": "Thomas’s registered Galileo mosaic combines detailed images with a coarser background. Its high-pass processing reduces broad brightness differences but retains photographed shading and seams; it is not calibrated albedo. Source sampling varies greatly. Gray grid marks source-defined unprojectable surfaces. Shadows adds approximate fixed-epoch Sun lighting.",
              "title": "SSI monochrome mosaic",
              "thumbnail": "/scenes/ida/ida-normal-thumbnail.webp",
              "surface": "ida-normal-surface@2x.webp",
              "poles": "ida-normal-surface@2x.webp",
