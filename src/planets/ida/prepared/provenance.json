                "path": "../manifest.json"
              },
              "falseColor": false,
              "detail": "Galileo SSI · I/F",
              "summary": "Calibrated reflectance retains the original lighting, not surface albedo. The grid marks bad pixels, uncertain edges and gaps."
            },
            {
              "id": "elevation",
              "label": "Elevation",
              "description": "Color shows source radius minus a 16 km reference sphere, including Ida’s broad irregular shape. This is radial height, not gravitational elevation. Brightness adds cartographic relief derived from the 2° shape grid; the displayed silhouette is simplified. Shadows adds approximate fixed-epoch Sun lighting.",
              "title": "Shape-derived radial height",
              "thumbnail": "/scenes/ida/ida-elevation-thumbnail.webp",
