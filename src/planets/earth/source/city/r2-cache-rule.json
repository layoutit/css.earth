{
  "description": "cssEarth immutable geometry packs",
  "expression": "(http.host eq \"earth-assets.lowpoly.cc\" and starts_with(http.request.uri.path, \"/scenes/earth/wmts-\") and ends_with(http.request.uri.path, \".pack\"))",
  "action": "set_cache_settings",
  "action_parameters": {
    "cache": true,
    "edge_ttl": {
      "mode": "bypass_by_default",
      "status_code_ttl": [
        { "status_code_range": { "from": 400 }, "value": -1 }
      ]
    }
  },
  "enabled": true
}
