---
import { objectControls } from "./control-content.mjs";
const { lenses, settings } = objectControls;
import PlanetShell from "../../../../site/components/PlanetShell.astro";
import { PREPARED_SHELL_TITLES } from "../../../../site/prepared-shell-titles.mjs";
import { SCIENTIFIC_CHART_TITLES } from "../../../../site/scientific-chart-titles.mjs";
import { PREPARED_EARTH_PANEL } from "./preparedPanel.mjs";
import { PREPARED_EARTH_TITLE } from "./preparedTitle.mjs";
import { PREPARED_EARTH_PLACES } from "../runtime/preparedPlaces.mjs";

const charts = [
  {
    id: "reflectance",
    title: PREPARED_SHELL_TITLES.reflectance,
    open: true,
    src: "/scenes/earth/earth-atmosphere-spectrum.svg",
    width: 306,
    height: 141,
    alt: "NASA PSG modeled disk reflectance of Earth from 350 to 1000 nanometers.",
  },
  {
    id: "photometric-phase",
    title: SCIENTIFIC_CHART_TITLES.photometricPhase,
    open: false,
    src: "/scenes/earth/earth-photometric-phase-curve.svg",
    width: 306,
    height: 141,
    alt: "Earth V-band brightness change across phase angles from zero to 180 degrees.",
  },
  {
    id: "temperature-pressure",
    title: PREPARED_SHELL_TITLES.temperaturePressure,
    open: false,
    src: "/scenes/earth/earth-temperature-pressure-profile.svg",
    width: 306,
    height: 141,
    alt: "NASA PSG standard Earth atmospheric temperature and pressure profile.",
  },
];
const resources = [
  { label: "GeoNames", role: "places", description: "City names and locations, CC-BY-4.0", href: "https://www.geonames.org/export/" },
  { label: "NASA", role: "imagery", description: "Surface & clouds", href: "https://science.nasa.gov/earth/" },
  { label: "ESA WorldCover", role: "imagery", description: "2021 WorldCover satellite composite via Terrascope, CC-BY-4.0", href: "https://esa-worldcover.org/en/data-access" },
  { label: "JPL", role: "facts", description: "Earth-Moon facts", href: "https://ssd.jpl.nasa.gov/sats/" },
  { label: "OpenSpace", role: "scene", description: "Globe & atmosphere", href: "https://github.com/OpenSpace/OpenSpace" },
  { label: "PSG", role: "spectra", description: "Spectrum & profile", href: "https://psg.gsfc.nasa.gov/" },
  { label: "HYG", role: "stars", description: "Background star field", href: "https://github.com/astronexus/HYG-Database" },
];
---

<PlanetShell
  objectId="earth"
  title={PREPARED_EARTH_TITLE}
  introduction={PREPARED_EARTH_PANEL.introduction}
  facts={PREPARED_EARTH_PANEL.facts}
  moreFacts={PREPARED_EARTH_PANEL.moreFacts}
  charts={charts}
  resources={resources}
  lenses={lenses}
  settings={settings}
  destinations={{ searchLabel: "Search planets and places", description: `${PREPARED_EARTH_PLACES.count.toLocaleString("en")} places worldwide.` }}
/>
