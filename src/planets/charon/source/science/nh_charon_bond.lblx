                                    <cart:pixel_resolution_y unit="m/pixel">2508.307177965</cart:pixel_resolution_y>
                                    <cart:pixel_scale_x unit="pixel/deg">4.2166666666667</cart:pixel_scale_x>
                                    <cart:pixel_scale_y unit="pixel/deg">4.2166666666667</cart:pixel_scale_y>
                                </cart:Coordinate_Representation>
                            </cart:Planar_Coordinate_Information>
                            <cart:Geo_Transformation>
                                <cart:upperleft_corner_x unit="m">-1903805.1</cart:upperleft_corner_x>
                                <cart:upperleft_corner_y unit="m">951902.6</cart:upperleft_corner_y>
                            </cart:Geo_Transformation>
                        </cart:Planar>
                        <cart:Geodetic_Model>
                            <cart:latitude_type>Planetocentric</cart:latitude_type>
                            <cart:a_axis_radius unit="m">606000</cart:a_axis_radius>
                            <cart:b_axis_radius unit="m">606000</cart:b_axis_radius>
