        <Internal_Reference>
            <lidvid_reference>urn:nasa:pds:nh_derived:plutosystem_geophysics:nh_charon_bond_browse::1.0</lidvid_reference>
            <reference_type>data_to_browse</reference_type>
            <comment>A JPEG version of the map</comment>
