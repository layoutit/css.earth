    <File_Area_Observational>
        <File>
            <file_name>nh_charon_bond.img</file_name>
        </File>
        
        <Array_2D_Map>
            <local_identifier>AlbedoMap</local_identifier>
            <offset unit="byte">0</offset>
            <axes>2</axes>
            <axis_index_order>Last Index Fastest</axis_index_order>
            <description>
                This product contains the bolometric bond albedo maps for Charon.          
                Images of the entire illuminated surface of Pluto and Charon were          
                obtained by the Long Range Reconnaissance Imager (LORRI) camera            
                and provide a global map of surface albedo. Charon exhibits                
                a much blander surface than Pluto with normal reflectances ranging         
                from 0.20-0.53.
                
                This map was scaled using the equation albedo = DN/255 where DN            
                is Data Number. It is non-dimensional.
                
                Note that the DERIVED_MAXIMUM and DERIVED_MINIMUM in the PDS3 label
                were non-sensical (they were integer values, where the scaling 
                factor was about 4e-3). They have been omitted in this label.
            </description>
            <Element_Array>
                <data_type>UnsignedByte</data_type>
                <scaling_factor>0.00392156862745</scaling_factor>
            </Element_Array>
            <Axis_Array>
                <axis_name>Line</axis_name>
                <elements>700</elements>
                <sequence_number>1</sequence_number>
            </Axis_Array>
            <Axis_Array>
                <axis_name>Sample</axis_name>
                <elements>1518</elements>
                <sequence_number>2</sequence_number>
            </Axis_Array>
            <Special_Constants>
                <missing_constant>0</missing_constant>
            </Special_Constants>
        </Array_2D_Map>
    </File_Area_Observational>
</Product_Observational>
