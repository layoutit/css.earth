{
  "extends": "../tsconfig.base.json",
  "include": [
    "**/*.test.ts",
    "**/*.test.mts",
    "**/*.spec.ts",
    "**/*.spec.mts",
    "**/test/**/*.ts",
    "**/test/**/*.mts",
    "**/*-test-fixture.mts",
    "**/*-browser.mts",
    "../site/env.d.ts",
    "../packages/bake/src/delivery/fixtures/external-modules.d.mts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ],
  "compilerOptions": {
    "paths": {
      "/site/*": [
        "../site/*"
      ],
      "/src/*": [
        "./*"
      ]
    },
    "tsBuildInfoFile": "../output/tsbuildinfo/src-tests.tsbuildinfo"
  }
}
