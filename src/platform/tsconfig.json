{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../packages/engine/node_modules/@types"
    ],
    "incremental": true,
    "tsBuildInfoFile": "../../output/tsbuildinfo/platform.tsbuildinfo"
  },
  "include": [
    "**/*.mts",
    "../navigation/**/*.mts",
    "../../tools/prepare/prepare-solar-geometry.mts"
  ],
  "exclude": [
    "test",
    "**/*.test.mts",
    "../navigation/**/*.test.mts"
  ]
}
