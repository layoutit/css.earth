{
  // Cloudflare's host for the site: the built pages (`dist`) as static assets, and worker.ts beside this file for the
  // addresses a static file cannot answer. Wrangler reads it with `--config deploy/cloudflare/wrangler.jsonc` and resolves
  // `main` and `assets.directory` from this folder. The top level is the preview (`pnpm deploy:cloudflare-preview`); the site
  // itself is the `production` environment below (`pnpm deploy:cloudflare`). Run `pnpm build:deploy` first.
  // docs/ci-cd.md has the steps.
  "name": "cssearth-preview",
  // Bundled by deploy/cloudflare/bundle-worker.mts, which swaps the modules that read a disk; wrangler uploads it as is.
  "main": "bundled/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-04-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs first on every address but these. A page is `/` or `/<id>/` and its query decides whether it is
    // rendered, which a path pattern cannot see; these directories are never a page and carry almost every request a
    // page makes, so they are served as static files without running the Worker.
    "run_worker_first": ["/*", "!/_astro/*", "!/objects/*", "!/world/*", "!/navigation/*", "!/social/*", "!/shell/*", "!/lighting/*"]
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "cssearth",
      // The site answers at its own address only, so no second copy of it can be indexed.
      "workers_dev": false,
      "routes": [
        { "pattern": "css.earth", "custom_domain": true },
        { "pattern": "www.css.earth", "custom_domain": true }
      ]
    }
  }
}
