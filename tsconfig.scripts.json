{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./output/tsbuildinfo/scripts.tsbuildinfo"
  },
  "include": [
    ".github/scripts/**/*.mts",
    "labs/experiments/**/*.mts",
    "labs/investigations/**/*.mts",
    "labs/performance/**/*.mts",
    "site/env.d.ts"
  ],
  "exclude": [
    ".github/scripts/**/*.test.mts",
    "labs/performance/**/*.test.mts",
    "**/dist/**",
    "**/node_modules/**",
    "**/oracles/**"
  ]
}
