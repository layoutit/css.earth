{
  "extends": "./tsconfig.base.json",
  "include": [
    "integration/eclipse-map/transit-fit.test.mts",
    "integration/renderer-bake/**/*.test.ts",
    "integration/renderer-bake/**/*.test.mts",
    "site/env.d.ts",
    "packages/bake/src/delivery/fixtures/external-modules.d.mts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ],
  "compilerOptions": {
    "paths": {
      "/site/*": [
        "./site/*"
      ],
      "/src/*": [
        "./src/*"
      ]
    },
    "tsBuildInfoFile": "output/tsbuildinfo/integration-tests.tsbuildinfo"
  }
}
