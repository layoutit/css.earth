---
import ObjectMarker from './ObjectMarker.astro';
import type { SystemEntry } from '../objects.mts';

interface Props { entry: SystemEntry; current: string }

const { entry, current } = Astro.props;
const holds = (entries: readonly SystemEntry[]): boolean => entries.some(item => item.object.id === current || holds(item.satellites));
const link = (id: string, label: string) =>
  ({ href: `/${id}/`, 'aria-current': id === current ? 'page' as const : undefined, label });
const own = link(entry.object.id, entry.object.title);
---
{entry.satellites.length
  ? <details open={entry.object.id === current || holds(entry.satellites)}>
      {/* A body with satellites opens like a Storybook component: its own page first, then what orbits it. */}
      <summary>
        <span class="wiki-tree-body"><ObjectMarker objectId={entry.object.id} />{entry.object.title}</span>
      </summary>
      <ul>
        <li><a class="wiki-row wiki-overview" href={own.href} aria-current={own['aria-current']}>Overview</a></li>
        {entry.satellites.map(satellite => <li><Astro.self entry={satellite} current={current} /></li>)}
      </ul>
    </details>
  : <a class="wiki-row" href={own.href} aria-current={own['aria-current']}>
      <ObjectMarker objectId={entry.object.id} />{entry.object.title}
    </a>}
