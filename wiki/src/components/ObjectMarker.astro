---
import '../../../site/planet-navigation-marker.css';
import { PREPARED_NAVIGATION_MARKERS } from '../../../site/prepared-navigation-markers.mjs';
import { markerStyle, type PreparedNavigationMarker } from '../../../src/navigation/marker-presentation.mts';
import { APP_ORIGIN, objectColors } from '../objects.mts';

interface Props { objectId: string }

const markers = PREPARED_NAVIGATION_MARKERS as Record<string, PreparedNavigationMarker | undefined>;
const colors = objectColors();
// The app's own sidebar scale: the largest prepared marker fills 14 px.
const SCALE = 14 / Math.max(...Object.values(markers).map(marker => marker!.presentation.size));

const { objectId } = Astro.props;
const marker = markers[objectId];
const color = colors.get(objectId);
// The marker tiles live with the app, which is also where the embedded scenes come from.
const prepared = marker && color ? markerStyle(marker, { color, scale: SCALE }) : null;
const inner = prepared?.innerStyle.replaceAll('url("/navigation/', `url("${APP_ORIGIN}/navigation/`);
---
{prepared
  ? <span class:list={['planet-navigation-marker', objectId, { ringed: prepared.ringed }]} style={prepared.style} aria-hidden="true">
      <i style={inner}></i>
      {prepared.ringed && <b class="planet-navigation-ring" style={prepared.ringStyle}></b>}
    </span>
  : <span class="planet-navigation-marker catalog-navigation-marker" aria-hidden="true"></span>}
