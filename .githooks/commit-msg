#!/bin/sh
# cssearth-commit-message-hook: one Conventional Commits line per authored commit, no attribution.
# Installed by `pnpm install` (.github/scripts/ci/commit-message.mts --install); CI checks the same rules on every PR.
# Skip once with git commit --no-verify.
command -v node >/dev/null 2>&1 || exit 0
root=$(git rev-parse --show-toplevel) || exit 0
# One installed hook serves every worktree of this clone, so a branch from before the checker moved to
# .github/scripts/ci still finds it at tools/ci. A branch from before the check existed has neither; CI still checks it.
for checker in "$root/.github/scripts/ci/commit-message.mts" "$root/tools/ci/commit-message.mts"; do
  [ -f "$checker" ] && exec node "$checker" "$1"
done
exit 0
