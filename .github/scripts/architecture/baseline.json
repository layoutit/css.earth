{
  "schema": "cssearth-architecture-baseline@1",
  "cycles": {
    "largestCycle": 5,
    "layerOrder": [
      "site/scene",
      "site/shell",
      "site/navigation",
      "site(root)",
      "site/search",
      "labs/nebula(app)",
      "labs/nebula-pkg/lab",
      "site/components",
      "site/layouts"
    ],
    "cycleClosingEdges": [
      {"from":"site/search","to":"site(root)","imports":8},
      {"from":"site(root)","to":"site/navigation","imports":7},
      {"from":"site(root)","to":"site/scene","imports":5},
      {"from":"site/shell","to":"site/scene","imports":2},
      {"from":"labs/nebula-pkg/lab","to":"labs/nebula(app)","imports":1},
      {"from":"site/layouts","to":"site/components","imports":1},
      {"from":"site/navigation","to":"site/scene","imports":1}
    ]
  },
  "rules": {
    "authoring-is-leaf": [],
    "bake-nebula-and-objects-independent": [],
    "nothing-imports-applications": [
      {"from":".github/scripts/checks/check-object-runtime-ownership.mts","to":"site/objects.mts"},
      {"from":"labs/performance/ipad-journey.mts","to":"site/objects.mts"},
      {"from":"labs/performance/ipad-run.mts","to":"site/objects.mts"}
    ],
    "nothing-imports-cli-entries": [],
    "packages-import-only-packages": [
      {"from":"packages/renderer/src/universe/prepared-world-context.test.ts","to":"site/objects.mts"},
      {"from":"packages/renderer/src/universe/prepared-world-context.test.ts","to":"site/system-framing.mts"},
      {"from":"packages/telescope-cli/src/archives/interferometry/fits-table.oracle.test.mts","to":"tests/oracles/fixture.mts"},
      {"from":"packages/telescope-cli/src/qualify.test.mts","to":"tests/fixtures/fits/helpers.mts"},
      {"from":"packages/telescope-cli/src/source-products.test.mts","to":"tests/fixtures/fits/helpers.mts"}
    ],
    "runtime-imports-no-preparation": [],
    "runtime-imports-no-site-build": [],
    "telescope-imports-no-bake": []
  }
}
