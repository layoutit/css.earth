{
  "schema": "cssearth-architecture-baseline@1",
  "cycles": {
    "largestCycle": 5,
    "layerOrder": [
      "site/scene",
      "site/shell",
      "site/navigation",
      "site/search",
      "site(root)",
      "site/components",
      "site/layouts"
    ],
    "cycleClosingEdges": [
      {"from":"site(root)","to":"site/search","imports":8},
      {"from":"site(root)","to":"site/navigation","imports":6},
      {"from":"site(root)","to":"site/scene","imports":5},
      {"from":"site/shell","to":"site/scene","imports":2},
      {"from":"site/layouts","to":"site/components","imports":1},
      {"from":"site/navigation","to":"site/scene","imports":1}
    ]
  },
  "packageCycles": [
    {"nodes":["@cssearth/bake","@cssearth/renderer","@cssearth/volume-viewer"],"scc":["@cssearth/bake","@cssearth/renderer","@cssearth/telescope-cli","@cssearth/volume-viewer"]},
    {"nodes":["@cssearth/bake","@cssearth/renderer"],"scc":["@cssearth/bake","@cssearth/renderer","@cssearth/telescope-cli","@cssearth/volume-viewer"]},
    {"nodes":["@cssearth/bake","@cssearth/telescope-cli","@cssearth/renderer","@cssearth/volume-viewer"],"scc":["@cssearth/bake","@cssearth/renderer","@cssearth/telescope-cli","@cssearth/volume-viewer"]},
    {"nodes":["@cssearth/bake","@cssearth/telescope-cli","@cssearth/renderer"],"scc":["@cssearth/bake","@cssearth/renderer","@cssearth/telescope-cli","@cssearth/volume-viewer"]},
    {"nodes":["@cssearth/bake","@cssearth/telescope-cli"],"scc":["@cssearth/bake","@cssearth/renderer","@cssearth/telescope-cli","@cssearth/volume-viewer"]}
  ],
  "rules": {
    "authoring-is-leaf": [],
    "bake-nebula-and-objects-independent": [],
    "nothing-imports-cli-entries": [],
    "runtime-imports-no-preparation": [],
    "runtime-imports-no-site-build": [],
    "telescope-imports-no-bake": []
  }
}
