{
  "//": [
    "Read by .github/scripts/ci/ci-affected.mts. Patterns use '**' for any depth,",
    "'*' for one path segment or a run of characters within a segment. `shared` is checked first against every",
    "changed path: one match there means the whole change is treated as shared, full run of every heavy job",
    "no matter what else changed. Otherwise each changed path is assigned to the first matching entry in `areas`,",
    "in that order; a path matching no area also falls back to shared (unsure means shared). The final job set is",
    "the union of every touched area's `jobs`. Job ids match the workflow's job ids in universe.yml: typecheck,",
    "universe, universePreparation (job id universe-preparation), nebula. Contract lint and the object-scope gate",
    "always run and are not listed here."
  ],
  "shared": [
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig*.json",
    "**/tsconfig*.json",
    "astro.config.mts",
    ".github/workflows/**",
    ".github/ci-areas.json",
    ".github/scripts/ci/ci-affected.mts",
    ".github/scripts/ci/check-ci.mts",
    ".github/scripts/ci/classify-changes.mts",
    ".github/scripts/ci/scope-runtime-ownership-check.mts",
    ".github/scripts/ci/object-scope-gate.mts",
    "src/platform/**",
    "site/objects.mts",
    "packages/objects/src/registry/**",
    "tools/prepare/prepare-catalog.mts",
    "tools/prepare/cli/prepare-catalog.mts",
    "tools/prepare/prepare-objects.mts",
    "tools/prepare/cli/prepare-objects.mts",
    "tools/prepare/prepare-object.mts",
    "tools/prepare/cli/prepare-object.mts",
    "tools/prepare/prepare-navigation.mts",
    "tools/prepare/cli/prepare-navigation.mts",
    "tools/prepare/prepare-solar-geometry.mts",
    "tools/prepare/cli/prepare-solar-geometry.mts",
    "tools/objects/**",
    "packages/bake/src/objects/**"
  ],
  "production": [
    ".github/workflows/nightly.yml", ".github/workflows/deploy.yml", ".github/ci-areas.json",
    ".github/scripts/ci/ci-affected.mts", "package.json", "pnpm-lock.yaml", "site/**", "astro.config.mts",
    "packages/renderer/src/rendering/**", "tools/prepare-*.mts", "tools/setup*.mts"
  ],
  "areas": [
    { "id": "docs", "patterns": ["**/*.md", "docs/**", "LICENSE*"], "jobs": [] },
    { "id": "object", "patterns": ["src/objects/*/**"], "jobs": ["universe"] },
    { "id": "bake", "patterns": ["packages/bake/src/photometry/**", "packages/bake/src/raster/**", "packages/bake/src/scene/**", "packages/bake/src/presentation/**", "packages/bake/src/nebula/**", "packages/bake/src/world-context/**", "packages/bake/src/cluster-catalog/**", "packages/bake/src/galaxy-catalog/**", "packages/bake/src/environment/**", "packages/bake/src/image-layers/**", "packages/bake/src/density/**", "packages/bake/src/sky/**", "packages/bake/src/shell/**", "packages/bake/src/stars/**", "packages/bake/src/volume-leaves/**", "packages/bake/src/runtime-source/**", "packages/bake/src/prepared-presentation/**", "packages/bake/src/delivery/**", "packages/bake/cli/**"], "jobs": ["typecheck", "universe", "universePreparation", "nebula"] },
    { "id": "preparation", "patterns": ["tools/galaxy-field/**", "tools/contract/test-preparation.mts"], "jobs": ["typecheck", "universePreparation"] },
    { "id": "renderer", "patterns": ["packages/renderer/**", "src/renderers/**"], "jobs": ["typecheck", "universe", "universePreparation"] },
    { "id": "site", "patterns": ["site/**"], "jobs": ["typecheck", "universe"] },
    { "id": "oracles", "patterns": ["tests/fits/**", "tools/oracles/**"], "jobs": ["typecheck", "universe"] },
    { "id": "architecture", "patterns": [".github/scripts/architecture/**"], "jobs": ["typecheck"] },
    { "id": "nebula", "patterns": ["tools/nebula/**", "labs/nebula/**"], "jobs": ["typecheck", "nebula"] }
  ]
}
