PDS_VERSION_ID                  = PDS3
RECORD_TYPE                     = FIXED_LENGTH
RECORD_BYTES                    = 50
FILE_RECORDS                    = 7500
^SERIES                         = "PN1P0104.TAB"

DATA_SET_ID                     = "VG2-SR/UR/NR-PPS-2/4-OCC-V1.0"
RING_OBSERVATION_ID             = "N/OCC/VG2/PPS/1989-08-24/SIGMA_SGR"
PRODUCT_ID                      = "KM001/PN1P0104.TAB"
PRODUCT_TYPE                    = RING_PROFILE
PRODUCT_CREATION_TIME           = 2003-09-29T16:00:00
SOURCE_PRODUCT_ID               = {"PN1D01.DAT",
                                   "PN1G02.TAB",
                                   "PN1C02.TAB"}

SPACECRAFT_NAME                 = "VOYAGER 2"
SPACECRAFT_ID                   = VG2
INSTRUMENT_NAME                 = "PHOTOPOLARIMETER SUBSYSTEM"
INSTRUMENT_ID                   = PPS
TARGET_NAME                     = "N RINGS"
START_TIME                      = 1989-08-24T23:58:15.106
STOP_TIME                       = 1989-08-25T00:34:24.487
SPACECRAFT_CLOCK_START_COUNT    = "11385:19:657"
SPACECRAFT_CLOCK_STOP_COUNT     = "11386:05:013"

OBSERVATION_TYPE                = OCCULTATION_PROFILE
OCCULTATION_TYPE                = STELLAR
STAR_NAME                       = "SIGMA SGR"
FEATURE_NAME                    = "RING SYSTEM"
RING_OCCULTATION_DIRECTION      = INGRESS
PLANETARY_OCCULTATION_FLAG      = N
WAVELENGTH                      = 0.264   /* microns */
INSTRUMENT_MODE_ID              = OC1

RING_EVENT_START_TIME           = 1989-08-24T23:58:14.164
RING_EVENT_STOP_TIME            = 1989-08-25T00:34:23.736
MINIMUM_RING_RADIUS             = 42500.
MAXIMUM_RING_RADIUS             = 49999.
RADIAL_RESOLUTION               = 1.
INCIDENCE_ANGLE                 = 70.719029

OBJECT                          = SERIES
  NAME                          = OCCULTATION_PROFILE
  INTERCHANGE_FORMAT            = ASCII
  ROWS                          = 7500
  COLUMNS                       = 6
  ROW_BYTES                     = 50
  SAMPLING_PARAMETER_NAME       = RING_INTERCEPT_RADIUS
  SAMPLING_PARAMETER_UNIT       = KILOMETER
  MINIMUM_SAMPLING_PARAMETER    = 42500.
  MAXIMUM_SAMPLING_PARAMETER    = 49999.
  SAMPLING_PARAMETER_INTERVAL   = 1.
  DESCRIPTION                   = "This is a radial profile of the
ring system of Neptune generated from the PPS sigma Sgr occultation
experiment. The data have been resampled to a uniform radial grid and
estimates of the normal opacity and its uncertainty are also provided.

This particular file was generated by running program
SOFTWARE/PROFILE/PPSRESAM.FOR with the following inputs:
    (1) Data file label: EDITDATA/PN1D01.LBL
    (2) Geometry file label: GEOMETRY/PN1G02.LBL
    (3) Calibration file label: CALIB/PN1C02.LBL
    (4) Radius min, max, interval = 42500., 49999., 1.
    (5) Filter type (boxcar,triangle,sinc): (B/T/S) = B
    (6) Output filename: EASYDATA/KM001/PN1P0104.TAB
"

  OBJECT                        = COLUMN
    NAME                        = RING_INTERCEPT_RADIUS
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 1
    BYTES                       = 9
    FORMAT                      = "F9.2"
    UNIT                        = KILOMETER
    DESCRIPTION                 = "Radial distance of the occultation
intercept point from the center of of the planet, in kilometers.
Distances are measured along the ring plane."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MEAN_SIGNAL
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 11
    BYTES                       = 7
    FORMAT                      = "F7.3"
    MISSING_CONSTANT            = 0.
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Mean photon counts received by the
PPS instrument at this radial location. The background signal has not
been subtracted. For unconstrained segments of the data, this value
is set to 0."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MEAN_SIGNAL_UNCERTAINTY
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 19
    BYTES                       = 6
    FORMAT                      = "F6.3"
    MAXIMUM                     = 99.
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Estimate of the 1-sigma uncertainty
in the mean photon counts. For unconstrained segments of the data,
this value is set to 99."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MEDIAN_NORMAL_OPACITY
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 26
    BYTES                       = 7
    FORMAT                      = "F7.4"
    MAXIMUM                     = 99.
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Estimate of the mean normal
opacity for a band of ring material centered at the given radius.
For opaque rings, this value is set to 99. For unconstrained
segments of the data, this value is set to 0."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = NORMAL_OPACITY_LOWER_LIMIT
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 34
    BYTES                       = 7
    FORMAT                      = "F7.4"
    MINIMUM                     = -9.
    MAXIMUM                     = 99.
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Estimate of the 1-sigma lower limit
on the ring opacity, corresponding to a 68% confidence interval. For
unconstrained segments of the data, this value is set to -9. For
opaque rings, this value is set to 99."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = NORMAL_OPACITY_UPPER_LIMIT
    DATA_TYPE                   = ASCII_REAL
    START_BYTE                  = 42
    BYTES                       = 7
    FORMAT                      = "F7.4"
    MAXIMUM                     = 99.
    UNIT                        = 'N/A'
    DESCRIPTION                 = "Estimate of the 1-sigma upper limit
on the ring opacity, corresponding to a 68% confidence interval. For
opaque rings, this value is set to 99."
  END_OBJECT                    = COLUMN

END_OBJECT                      = SERIES
END
