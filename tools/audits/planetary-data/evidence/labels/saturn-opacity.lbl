TARGET_NAME                          = "S RINGS"
EARTH_RECEIVED_START_TIME            = 2005-123T04:07:02.365
EARTH_RECEIVED_STOP_TIME             = 2005-123T05:44:28.341
RING_EVENT_START_TIME                = 2005-123T02:49:00.751
RING_EVENT_STOP_TIME                 = 2005-123T04:26:26.167
SPACECRAFT_EVENT_START_TIME          = 2005-123T02:49:00.202
