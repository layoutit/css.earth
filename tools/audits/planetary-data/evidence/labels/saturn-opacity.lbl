SPACECRAFT_CLOCK_START_COUNT         = "UNK"
SPACECRAFT_CLOCK_STOP_COUNT          = "UNK"
REVOLUTION_NUMBER                    = 7
DSN_STATION_NUMBER                   = 26

OBSERVATION_TYPE                     = "OCCULTATION PROFILE"
OCCULTATION_TYPE                     = RADIO
FEATURE_NAME                         = "RING SYSTEM"
PLANETARY_OCCULTATION_FLAG           = Y
RING_OCCULTATION_DIRECTION           = BOTH
RING_PROFILE_DIRECTION               = INGRESS
BAND_NAME                            = Ka
WAVELENGTH                           = 0.93617   <cm>

RADIAL_RESOLUTION                    = 1   <km>
RADIAL_SAMPLING_INTERVAL             = 0.2500   <km>
MINIMUM_RING_RADIUS                  = 72001.2500   <km>
MAXIMUM_RING_RADIUS                  = 144998.7500   <km>
MINIMUM_RING_LONGITUDE               = 257.1118   <deg>
MAXIMUM_RING_LONGITUDE               = 266.2816   <deg>
MINIMUM_OBSERVED_RING_AZIMUTH        = 91.4139   <deg>
MAXIMUM_OBSERVED_RING_AZIMUTH        = 100.5754   <deg>
MINIMUM_OBSERVED_RING_ELEVATION      = -23.5750   <deg>
MAXIMUM_OBSERVED_RING_ELEVATION      = -23.5736   <deg>
MINIMUM_LIGHT_SOURCE_INCIDENCE_ANGLE = 66.4250   <deg>
MAXIMUM_LIGHT_SOURCE_INCIDENCE_ANGLE = 66.4264   <deg>
