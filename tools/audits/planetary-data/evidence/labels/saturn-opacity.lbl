RING_OBSERVATION_ID                  = RSS_2005_123_K26_I
PRODUCT_ID                           = "RSS_2005_123_K26_I_TAU_01KM.TAB"
PRODUCT_TYPE                         = RING_PROFILE
PRODUCT_CREATION_TIME                = 2018-276T13:52:31
PRODUCER_ID                          = "CASSINI RST"
SOURCE_PRODUCT_ID                    = "S10EAOI2005_123_0230NNNK26D.3B1"

INSTRUMENT_HOST_NAME                 = "CASSINI ORBITER"
INSTRUMENT_HOST_ID                   = CO
INSTRUMENT_NAME                      = "RADIO SCIENCE SUBSYSTEM"
INSTRUMENT_ID                        = RSS
