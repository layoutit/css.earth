DESCRIPTION                     = "This file contains instrument parameters
and timing information from CIRS activity CIRS_000MI_PRESOI001_ISS as observed
through Focal Plane 1. Values were extracted from file
DATA/APODSPEC/ISPM04062200.VAR on volume COCIRS_0406.

The calibrated spectra associated this table can be found in this binary table
file:
  DATA/APODSPEC/SPEC0406220828_FP1.DAT.
Information about the viewing geometry can be found in these files:
  DATA/POIDATA/POI0406220828_FP1.TAB: pixel footprints on the target body;
  DATA/RINDATA/RIN0406220828_FP1.TAB: pixel footprints on the rings;
  DATA/TARDATA/TAR0406220828_FP1.TAB: list of the bodies within each pixel;
  DATA/GEODATA/GEO0406220828_*.TAB:   system geometry at observation time.
"

OBJECT                          = TABLE
  INTERCHANGE_FORMAT            = BINARY
  ROWS                          = 144
  ROW_BYTES                     = 580
  COLUMNS                       = 7
  PRIMARY_KEY                   = ("SCET", "DET")
  START_PRIMARY_KEY             = (1087892938, 0)
  STOP_PRIMARY_KEY              = (1087893651, 0)

  OBJECT                        = COLUMN
    NAME                        = SCET
    DATA_TYPE                   = LSB_INTEGER
    START_BYTE                  = 1
    BYTES                       = 4
    DESCRIPTION                 = "Spacecraft event time at the beginning of
the scan, encoded as an integer in Unix time (seconds elapsed since January 1,
1970, neglecting leap seconds)."
    UNIT                        = "SECONDS"
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = DET
    DATA_TYPE                   = LSB_INTEGER
    START_BYTE                  = 5
    BYTES                       = 4
    DESCRIPTION                 = "Detector ID. Values are found in Table 1 of
DOCUMENT/DATASIS.PDF:

                 0: FP1, pixel 0

                 1: FP3, PAIR mode, pixels 1+2
                 2: FP3, PAIR mode, pixels 3+4
                 3: FP3, PAIR mode, pixels 5+6
                 4: FP3, PAIR mode, pixels 7+8
                 5: FP3, PAIR mode, pixels 9+10

                 6: FP3, CENTER mode, pixel 4
                 7: FP3, CENTER mode, pixel 5
                 8: FP3, CENTER mode, pixel 6
                 9: FP3, CENTER mode, pixel 7
                10: FP3, CENTER mode, pixel 8

                11: FP3, ODD mode,  pixel 1
                12: FP3, EVEN mode, pixel 2
                13: FP3, ODD mode,  pixel 3
                14: FP3, EVEN mode, pixel 4
                15: FP3, ODD mode,  pixel 5
                16: FP3, EVEN mode, pixel 6
                17: FP3, ODD mode,  pixel 7
                18: FP3, EVEN mode, pixel 8
                19: FP3, ODD mode,  pixel 9
                20: FP3, EVEN mode, pixel 10

                21: FP4, ODD mode,  pixel 1
                22: FP4, EVEN mode, pixel 2
                23: FP4, ODD mode,  pixel 3
                24: FP4, EVEN mode, pixel 4
                25: FP4, ODD mode,  pixel 5
                26: FP4, EVEN mode, pixel 6
                27: FP4, ODD mode,  pixel 7
                28: FP4, EVEN mode, pixel 8
                29: FP4, ODD mode,  pixel 9
                30: FP4, EVEN mode, pixel 10

                31: FP4, CENTER mode, pixel 3
                32: FP4, CENTER mode, pixel 4
                33: FP4, CENTER mode, pixel 5
                34: FP4, CENTER mode, pixel 6
                35: FP4, CENTER mode, pixel 7

                36: FP4, PAIR mode, pixels 1+2
                37: FP4, PAIR mode, pixels 3+4
                38: FP4, PAIR mode, pixels 5+6
                39: FP4, PAIR mode, pixels 7+8
                40: FP4, PAIR mode, pixels 9+10
"
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = SHUTTER_CLOSED_FLAG
    DATA_TYPE                   = LSB_INTEGER
    START_BYTE                  = 9
    BYTES                       = 4
    DESCRIPTION                 = "0 if this interferogram was obtained with
the shutter open; 1 if the shutter was closed. This value is always zero for
Focal Plane 1, which does not have a shutter."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = SPECTRAL_SAMPLES
    DATA_TYPE                   = LSB_INTEGER
    START_BYTE                  = 13
    BYTES                       = 4
    DESCRIPTION                 = "Number of points in re-gridded spectrum."
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = MINIMUM_SPECTRAL_SAMPLE
    DATA_TYPE                   = PC_REAL
    START_BYTE                  = 17
    BYTES                       = 4
    DESCRIPTION                 = "Wavenumber of first re-gridded spectral
point (cm^-1)."
    UNIT                        = "CM**-1"
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = SPECTRAL_SAMPLING_INTERVAL
    DATA_TYPE                   = PC_REAL
    START_BYTE                  = 21
    BYTES                       = 4
    DESCRIPTION                 = "Wavenumber step size of regridded data
(cm^-1)."
    UNIT                        = "CM**-1"
  END_OBJECT                    = COLUMN

  OBJECT                        = COLUMN
    NAME                        = SPECTRUM
    DATA_TYPE                   = PC_REAL
    START_BYTE                  = 25
    BYTES                       = 556
    ITEMS                       = 139
    ITEM_BYTES                  = 4
    UNIT                        = "W/CM**2/SR/CM**-1"
    DESCRIPTION                 = "Interpolated, calibrated spectrum."

    SAMPLING_PARAMETER_NAME       = "WAVENUMBER"
    SAMPLING_PARAMETER_UNIT       = "CM**-1"
    MINIMUM_SAMPLING_PARAMETER    = 5.
    MAXIMUM_SAMPLING_PARAMETER    = 695.
    SAMPLING_PARAMETER_INTERVAL   = 5.
    SAMPLING_PARAMETER_RESOLUTION = 5.47

  END_OBJECT                    = COLUMN

END_OBJECT                      = TABLE

