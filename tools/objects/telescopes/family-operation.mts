const PREVIEW_OPERATIONS=new Set<FamilyOperationParameters['operationId']>(['spectrum-preview','sed-preview','time-series-preview','table-scatter-preview','table-histogram-preview','astrometry-track-preview','count-image-preview','energy-histogram-preview','light-curve-preview','radar-preview']);
