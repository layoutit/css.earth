/** Execute only a compile-time allowlisted owner. The descriptor and every member are re-pinned before dispatch. */
export async function executeFamilyOperation(descriptorPath:string,rawParameters:FamilyOperationParameters,outputDirectory:string):Promise<FamilyOperationResult>{
  const params=parameters(rawParameters),loaded=await loadDescriptor(descriptorPath),operation=executableOperation(loaded.descriptor,params.operationId,rawParameters.componentId);
  if(PREVIEW_OPERATIONS.has(params.operationId))return previewOutput(loaded,operation,params,outputDirectory);
  if(params.operationId==='export-bundle')return calibrationBundleOutput(loaded,operation,outputDirectory);
  if(params.operationId==='enumerate-members'||params.operationId==='export-selected'||params.operationId==='export-whole')return compoundOutput(loaded,operation,params,outputDirectory);
  if(params.operationId==='polarimetry-inspect'||params.operationId==='polarimetry-export')return polarimetryOutput(loaded,operation,params.operationId,outputDirectory);
  if(params.operationId==='spatial-export-points'||params.operationId==='spatial-export-volume'||params.operationId==='spatial-export-volume-lens-bank'){
    const selected=componentMember(loaded.descriptor,loaded.files,operation),kind=params.operationId==='spatial-export-points'?'points':params.operationId==='spatial-export-volume'?'volume':'volume-lens-bank';await absent(resolve(outputDirectory));const result=await exportSpatialObject(selected.file,kind,outputDirectory);await verifiedProduct(result.receipt);return{directory:result.directory,product:result.object,record:result.receipt,operation};
  }
  return customOutput(loaded,operation,params,outputDirectory);
}

/** Operation view used by the public execution seam; advertised metadata without an executor is explicit. */
export function executableFamilyOperations(value:unknown):readonly FamilyOperation[]{const descriptor=parseProductDescriptor(value);return operationsForDescriptor(descriptor).map(operation=>ALLOWED.has(operation.id as FamilyOperationParameters['operationId'])?operation:{...operation,available:false,reason:'No static descriptor-backed public executor is registered for this operation.'});}
export async function verifiedExecutableFamilyOperations(path:string):Promise<readonly FamilyOperation[]>{const loaded=await loadDescriptor(path);return executableFamilyOperations(loaded.descriptor);}
