import assert from'node:assert/strict';import{test}from'node:test';import{readFile}from'node:fs/promises';import{resolve}from'node:path';import{member}from'./common.mts';import{describePhotometry,exportPhotometryCsv,sedPlotData,sedTable}from'./f05-photometry.mts';
const root=resolve(import.meta.dirname,'../../../..'),path='src/objects/haumea/source/photometry/disc-color.json',bytes=await readFile(resolve(root,path)),source=JSON.parse(bytes.toString()) as any;
test('F05 preserves the real Haumea V-band albedo point and its uncertainty',()=>{const points=[{id:'geometric-albedo-v',band:source.geometricAlbedo.band,system:source.object.system,effectiveWavelength:source.effectiveWavelengths.nanometres.V,value:source.geometricAlbedo.value,uncertainty:source.geometricAlbedo.uncertainty,segment:'occultation-area'}];const product=describePhotometry({id:'haumea-photometry',target:'haumea',member:member('colours',path,'science',bytes,'application/json'),points,wavelengthUnit:'nm',quantity:'geometric albedo',unit:'1',producingRecord:path,calibrationBasis:[source.geometricAlbedo.locator]});assert.equal(product.components[0]!.representation.kind,'table');assert.equal(product.components[0]!.uncertainty?.form,'standard-deviation');assert.match(exportPhotometryCsv(points),/geometric-albedo-v,occultation-area,V,Johnson-Cousins BVRI,544.5,0.51,0.02,0/u);});
test('F05 keeps upper limits and does not invent missing wavelengths',()=>{const point={id:'u',band:'X',system:'native',value:2,upperLimit:true};const product=describePhotometry({id:'upper',member:member('m','p.csv','science',Buffer.from('x')),points:[point],quantity:'flux',unit:'Jy',producingRecord:'test',calibrationBasis:['fixture']});assert.equal(product.components[0]!.axes.length,0);assert.equal(product.issues[0]!.state,'missing');assert.match(exportPhotometryCsv([point]),/u,,X,native,,2,,1/u);});
test('F05 SED views retain qualified wavelengths and censored points',()=>{const points=[{id:'late',band:'R',system:'AB',effectiveWavelength:700,value:2},{id:'early',band:'B',system:'AB',effectiveWavelength:400,value:1,upperLimit:true}];assert.deepEqual(sedTable(points).map(point=>point.id),['early','late']);assert.equal(sedPlotData(points)[0]!.upperLimit,true);});
