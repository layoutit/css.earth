import assert from'node:assert/strict';import{sourceTest}from'../../../../tests/objects/source-test.mts';import{readFile}from'node:fs/promises';import{resolve}from'node:path';import{readTessLightCurve}from'../../eclipse-map/transit-limb-darkening.mts';import{member}from'./common.mts';import{binTimeSeries,describeTimeSeries,foldTimeSeries,selectTimeSeries,timeSeriesPlotData}from'./f06-time-series.mts';
const root=resolve(import.meta.dirname,'../../../..'),path='src/objects/hd-189733/source/photometry/tess/tess2021204101404-s0041-0000000256364928-0212-s_lc.fits';
const test=sourceTest();
let loading:Promise<{bytes:Buffer;samples:{id:string;segment:string;time:number;value:number;uncertainty:number}[]}>|undefined;
const load=()=>loading??=(async()=>{const bytes=await readFile(resolve(root,path)),curve=readTessLightCurve(bytes),samples=Array.from(curve.time,(time,index)=>({id:String(index),segment:'sector-41',time,value:curve.flux[index]!,uncertainty:curve.error[index]!}));return{bytes,samples};})();
test('F06 describes the pinned real TESS curve and selection is explicit',async()=>{const{bytes,samples}=await load();const product=describeTimeSeries({id:'hd-189733-sector-41',target:'hd-189733',member:member('tess-41',path,'science',bytes,'application/fits'),samples,timeUnit:'d',timeScale:'BJD_TDB-2457000',quantity:'PDCSAP flux',producingRecord:'src/objects/hd-189733/source/manifest.json',calibrationBasis:['TESS SPOC PDCSAP; QUALITY=0 samples selected by existing owner.']});assert.equal(product.components[0]!.representation.kind,'table');assert.equal(product.components[0]!.time?.scale,'BJD_TDB-2457000');const selected=selectTimeSeries(samples,{from:samples[5]!.time,to:samples[9]!.time});assert.equal(selected.length,5);});
test('F06 bins and folds only with explicit parameters while retaining IDs and segments',async()=>{const{bytes,samples}=await load();const small=samples.slice(0,12);const binned=binTimeSeries(small,{width:.01,origin:small[0]!.time});assert.ok(binned.length<small.length);assert.equal(binned[0]!.segment,'sector-41');assert.match(binned[0]!.id,/\+/u);const folded=foldTimeSeries(small,{epoch:small[0]!.time,period:2.21857567});assert.equal(folded.length,small.length);assert.ok(folded.every(p=>p.phase>=0&&p.phase<1));assert.throws(()=>binTimeSeries(small,{width:0,origin:0}),/positive/u);});
test('F06 plot data keeps source identity and segments visible',async()=>{const{bytes,samples}=await load();const point=timeSeriesPlotData(samples.slice(0,1))[0]!;assert.equal(point.id,'0');assert.equal(point.segment,'sector-41');});
