export function describeCompound(input:CompoundInput):ProductDescriptor {const members=new Set(input.members.map(member=>member.id));for(const group of input.groups){if(!group.memberIds.length)throw new TypeError(`Compound group ${group.id} is empty.`);for(const id of group.memberIds)if(!members.has(id))throw new TypeError(`Compound group ${group.id} references absent member ${id}.`);}const leaves=input.members.map(item=>({id:`member-${item.id}`,name:item.path,families:['F18'] as const,locations:[{memberId:item.id}],representation:{kind:'table' as const,rows:null},axes:[],columns:[],quantity:{name:'native member',semantics:'Native member retained without generic decoding.'},calibration:{state:'unknown' as const,basis:['Member role and pin only.']},flags:[],dependencyIds:[]}));const components=[...leaves,...input.groups.map(group=>({id:stable(group.id,'compound component id'),name:group.name,families:['F18'] as const,locations:group.memberIds.map(memberId=>({memberId})),representation:{kind:'collection' as const,componentIds:group.memberIds.map(memberId=>`member-${memberId}`)},axes:[],columns:[],quantity:{name:'compound archive members',semantics:'Members retain their own format and owner; this component only declares closure.'},calibration:{state:'unknown' as const,basis:['Collection membership does not establish common calibration.']},flags:[],dependencyIds:[`closure-${group.id}`]}))];return descriptor({schema:'cssearth-telescope-product-descriptor@1',dataset:{id:stable(input.id,'compound id'),...(input.target?{target:input.target}:{}),acquisition:{kind:'repository',identity:input.producingRecord},producingRecord:input.producingRecord,sourceClassifications:[{term:'compound collection',vocabulary:'archive/repository member manifest',version:'1',status:'mapped'}],families:['F18'],profiles:[{handlerId:'f18-compound',profileId:'pinned-compound-closure@1'}]},members:input.members,components,dependencies:input.groups.map(group=>({id:`closure-${group.id}`,role:'selected compound dependency closure',memberIds:group.memberIds,componentIds:[group.id],requiredFor:['enumerate-members','export-selected','export-whole'],evidence:'Selection carries every declared member; no generic decoding is asserted.'})),issues:[]});}
