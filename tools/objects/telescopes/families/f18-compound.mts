export const F18_COMPOUND_HANDLER:FamilyHandler={id:'f18-compound',families:['F18'],profiles:[{id:'pinned-compound-closure@1',format:'Pinned multi-member collection',version:'repository compatibility profile',families:['F18'],publicBaseline:true,evidence:[{path:'tools/objects/pds/archive-final.test.mts',establishes:'PDS complete product dependency closure.',status:'complete'},{path:'tools/objects/hst/hst.test.mts',establishes:'HST association/member closure.',status:'complete'}]}],recognizes:()=>[],operations:d=>d.components.filter(c=>c.families.includes('F18')).flatMap(c=>[op(c.id,'enumerate-members','Enumerate compound members'),op(c.id,'export-selected','Export selected closure'),op(c.id,'export-whole','Export whole closure')])};
