import assert from'node:assert/strict';import{test}from'node:test';import{readFile}from'node:fs/promises';import{resolve}from'node:path';import{member}from'./common.mts';import{describeBodyMapSphere,F14_BODY_MAP_SPHERE_HANDLER}from'./f14-body-map-sphere.mts';
