export function readFitsTableRows(bytes:Buffer,extension:string|number,selected?:readonly string[]):readonly TableRow[]{const table=tableAt(bytes,extension),columns=selected===undefined?table.columns:selected.map(name=>{const found=table.columns.find(column=>column.name===name);if(!found)throw new TypeError(`Unknown table column ${name}.`);return found;});return Array.from({length:table.rows},(_,row)=>Object.fromEntries(columns.map(column=>{if(column.scaled)throw new TypeError(`Column ${column.name} is scaled and cannot be exported without applying its declared transform.`);if(column.type==='A')return[column.name,text(bytes,table,row,column)];const values=numbers(bytes,table,row,column).map(value=>Number.isNaN(value)?null:value);return[column.name,values.length===1?values[0]:values];})));}
export interface TableFilter{readonly column:string;readonly operator:'eq'|'ne'|'lt'|'lte'|'gt'|'gte'|'is-null';readonly value?:string|number}
