import type{FamilyHandler,FamilyOperation}from'../family-handlers.mts';import type{DescriptorMember,ProductDescriptor}from'../product-descriptor.mts';import{plotNumericPreview,type FigureOptions}from'../../astronomy-packages/plots.mts';import{binaryTable,numbers,readFitsHdus,text,type BinaryTable,type TableColumn}from'../../interferometry/fits-table.mts';import{csv,descriptor,stable}from'./common.mts';
export type TableValue=string|number|readonly number[]|null;export type TableRow=Readonly<Record<string,TableValue>>;
export interface InspectedTable{readonly extname:string;readonly rows:number;readonly rowBytes:number;readonly columns:readonly {readonly name:string;readonly datatype:string;readonly repeat:number;readonly unit?:string;readonly nullable:boolean;readonly scaled:boolean}[]}
const tableAt=(bytes:Buffer,extension:string|number):BinaryTable=>{const hdus=readFitsHdus(bytes),hdu=typeof extension==='number'?hdus[extension]:hdus.find(h=>h.extname===extension);if(!hdu)throw new TypeError(`FITS table ${extension} is absent.`);return binaryTable(hdu);};
