export function tableScatterData(rows:readonly TableRow[],x:string,y:string){return rows.flatMap((row,index)=>{const xv=row[x],yv=row[y];if(xv===undefined||yv===undefined)throw new TypeError('Scatter column is absent.');if(typeof xv!=='number'||typeof yv!=='number'||!Number.isFinite(xv)||!Number.isFinite(yv))return[];return[{row:index,x:xv,y:yv}]});}
export function tableHistogram(rows:readonly TableRow[],column:string,edges:readonly number[]){if(edges.length<2||edges.some((edge,index)=>!Number.isFinite(edge)||(index>0&&edge<=edges[index-1]!)))throw new TypeError('Histogram edges must be finite and strictly increasing.');const counts=Array.from({length:edges.length-1},()=>0);for(const row of rows){const value=row[column];if(value===undefined)throw new TypeError(`Unknown table column ${column}.`);if(typeof value!=='number'||!Number.isFinite(value))continue;const bin=edges.findIndex((edge,index)=>index<edges.length-1&&value>=edge&&value<(edges[index+1]!)||(index===edges.length-2&&value===edges[index+1]!));if(bin>=0)counts[bin]!++;}return{column,edges:[...edges],counts};}
export async function previewTableScatter(out:string,title:string,rows:readonly TableRow[],x:string,y:string,options:FigureOptions={}){const points=tableScatterData(rows,x,y);return plotNumericPreview(out,{kind:'scatter',title,xLabel:x,yLabel:y,points},options);}
