const ops=(id:string):FamilyOperation[]=>[['table-inspect','Inspect typed table','inspectFitsTable',[]],['table-filter','Filter typed table','filterTableRows',[{id:'filter',option:'--filter',kind:'input-path' as const,required:true,description:'Typed filter specification.'}]],['table-export','Export table','exportTableCsv',[]],['table-scatter-data','Prepare numeric scatter view','tableScatterData',[{id:'columns',option:'--columns',kind:'input-path' as const,required:true,description:'Explicit X/Y numeric columns.'}]],['table-scatter-preview','Render numeric scatter preview','previewTableScatter',[{id:'columns',option:'--columns',kind:'input-path' as const,required:true,description:'Explicit X/Y numeric columns.'}]],['table-histogram','Prepare numeric histogram','tableHistogram',[{id:'histogram',option:'--histogram',kind:'input-path' as const,required:true,description:'Explicit numeric column and strictly increasing bin edges.'}]],['table-histogram-preview','Render numeric histogram preview','previewTableHistogram',[{id:'histogram',option:'--histogram',kind:'input-path' as const,required:true,description:'Explicit numeric column and strictly increasing bin edges.'}]]].map(([operation,label,owner,parameters])=>({id:operation as string,label:label as string,handlerId:'f08-table',componentId:id,owner:{module:'tools/objects/telescopes/families/f08-table.mts',export:owner as string},available:true,reason:'Typed rows and explicit columns are available.',fixedArguments:{},parameters:[...(parameters as any[]),{id:'out',option:'--out',kind:'output-directory',required:true,description:'New output directory.'}],limitations:['Scaled TSCAL/TZERO columns remain unavailable rather than being returned with wrong values.']}));
