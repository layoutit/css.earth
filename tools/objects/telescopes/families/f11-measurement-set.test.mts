import assert from 'node:assert/strict'; import { readFile } from 'node:fs/promises'; import { resolve } from 'node:path'; import { test } from 'node:test'; import { member } from './common.mts'; import { describeMeasurementSet, describeUvfitsVisibility, exportUvfitsVisibilitySelection, F11_MEASUREMENT_SET_HANDLER, inspectUvfitsVisibilities } from './f11-measurement-set.mts';
const table=(id:string)=>member(id,`tests/fixtures/alma/${id}`,'science',Buffer.from(id));
test('F11 requires the complete bounded Measurement Set table closure and keeps local imports partial',()=>{const members=['MAIN','FIELD','SPECTRAL_WINDOW','ANTENNA','POLARIZATION'].map(table),tables=Object.fromEntries(members.map(item=>[item.id,item.id])) as any;const described=describeMeasurementSet({id:'local-ms',target:'europa',producingRecord:'tests/fixtures/alma/uid___A002_X10dde56_X29a8.ms.calapply.txt',members,tables,archiveQualified:false});assert.equal(described.dependencies[0]!.memberIds.length,5);assert.match(described.issues[0]!.reason,/local-import/u);const operations=F11_MEASUREMENT_SET_HANDLER.operations(described);assert.equal(operations.find(op=>op.id==='inspect-ms')!.available,true);assert.equal(operations.find(op=>op.id==='export-ms-subset')!.available,false);});
test('F11 rejects an incomplete MS directory descriptor',()=>{const main=table('MAIN');assert.throws(()=>describeMeasurementSet({id:'bad-ms',producingRecord:'x',members:[main],tables:{MAIN:'MAIN'} as any,archiveQualified:false}),/requires pinned FIELD/u);});
const root=resolve(import.meta.dirname,'../../../..'),fixture=resolve(root,'tests/fixtures/telescope-families/f11-vla-uvfits/day2_TDEM0003_10s_norx_1src_1spw.uvfits');
test('F11 opens real BSD-licensed VLA UVFITS complex samples and exports one bounded native selection',async()=>{const bytes=await readFile(fixture),input=member('uvfits','day2_TDEM0003_10s_norx_1src_1spw.uvfits','science',bytes,'application/fits'),inspected=inspectUvfitsVisibilities(bytes);assert.deepEqual(inspected,{telescope:'EVLA',target:'J1008+0730',rows:1360,channels:64,polarizations:[-1,-2,-3,-4],samples:348160,frequencyHz:{first:36304541952.42,increment:125000}});const descriptor=describeUvfitsVisibility({id:'vla-day2-tdem0003',producingRecord:'RASG datasets v0.0.5 BSD-2-Clause',member:input,bytes});assert.equal(descriptor.components[0]!.calibration.state,'raw');assert.match(descriptor.issues[0]!.reason,/not a CASA Measurement Set/u);assert.deepEqual(F11_MEASUREMENT_SET_HANDLER.operations(descriptor).map(operation=>operation.id),['uvfits-visibility-inspect','uvfits-visibility-export']);const csv=exportUvfitsVisibilitySelection(bytes,{rowStart:0,rowCount:1,channelStart:0,channelCount:1,polarization:-1});assert.match(csv,/^row,time_jd,antenna1/mu);assert.match(csv,/0\.0012469778/u);});
test('F11 UVFITS export refuses bounds and refuses a changed source pin before operation admission',async()=>{const bytes=await readFile(fixture);assert.throws(()=>exportUvfitsVisibilitySelection(bytes,{rowStart:1360,rowCount:1,channelStart:0,channelCount:1,polarization:-1}),/outside/u);const changed=Buffer.from(bytes);changed[4000]^=1;const pinned=member('uvfits','day2_TDEM0003_10s_norx_1src_1spw.uvfits','science',bytes,'application/fits');assert.notEqual(pinned.sha256,member('uvfits','day2_TDEM0003_10s_norx_1src_1spw.uvfits','science',changed,'application/fits').sha256);});
