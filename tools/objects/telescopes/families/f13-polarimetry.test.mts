import test from 'node:test'; import assert from 'node:assert/strict';
import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'; import { tmpdir } from 'node:os'; import { resolve } from 'node:path';
import { headerBlock, padBlock } from '../../interferometry/fits-table.mts'; import { member } from './common.mts';
import { BETELGEUSE_ZIMPOL_V, describeDegreeLinearPolarization, exportIntensityDolp, inspectIntensityDolp } from './f13-polarimetry.mts';
const fits=(width=2,height=2)=>{const values=Buffer.alloc(width*height*4);for(let i=0;i<width*height;i++)values.writeFloatBE(i+1,i*4);return Buffer.concat([headerBlock([['SIMPLE',true],['BITPIX',-32],['NAXIS',2],['NAXIS1',width],['NAXIS2',height]]),padBlock(values)]);};
test('F13 exposes DOLP as DOLP and refuses a fabricated Stokes interpretation',()=>{const intensity=member('intensity','intensity.fits','science',fits()),dolp=member('dolp','dolp.fits','science',fits());const d=describeDegreeLinearPolarization({id:'betelgeuse-zimpol',target:'betelgeuse',intensity,dolp,shape:[2,2],producingRecord:'ESO Phase 3'});assert.deepEqual(d.components.map(c=>c.id),['intensity','degree-linear-polarization']);assert.match(d.issues[0]?.reason??'',/No Stokes Q\/U\/V/);assert.equal(BETELGEUSE_ZIMPOL_V.intensity.bytes,8458560);});
test('F13 inspection and export reopen both exact paired grids',async()=>{const root=await mkdtemp(resolve(tmpdir(),'f13-'));try{const first=fits(),second=fits(),a=resolve(root,'i.fits'),b=resolve(root,'d.fits');await writeFile(a,first);await writeFile(b,second);assert.equal(inspectIntensityDolp(first,second).intensity.finite,4);const result=await exportIntensityDolp(resolve(root,'out'),{intensity:{file:a,member:member('intensity','i.fits','science',first)},dolp:{file:b,member:member('dolp','d.fits','science',second)}});assert.deepEqual(JSON.parse(await readFile(result.receipt,'utf8')).inspection.shape,[2,2]);assert.equal((await readFile(result.preview)).subarray(0,2).toString(),'P5');await assert.rejects(exportIntensityDolp(resolve(root,'bad'),{intensity:{file:a,member:member('intensity','i.fits','science',first)},dolp:{file:b,member:member('dolp','d.fits','science',fits(3,2))}}),/changed/);assert.throws(()=>inspectIntensityDolp(first,fits(3,2)),/exact native pixel grid/);}finally{await rm(root,{recursive:true,force:true});}});
