import test from 'node:test'; import assert from 'node:assert/strict';
import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'; import { tmpdir } from 'node:os'; import { resolve } from 'node:path'; import {spawn} from 'node:child_process'; import {createHash} from 'node:crypto';
import { headerBlock, padBlock } from '../../interferometry/fits-table.mts'; import { member } from './common.mts';
import { BETELGEUSE_ZIMPOL_V, describeDegreeLinearPolarization, describeStokesFits, exportIntensityDolp, extractStokesFits, inspectIntensityDolp, inspectStokesFits } from './f13-polarimetry.mts'; import {astroqueryToolchain} from '../../astronomy-packages/toolchain.mts';import{executeFamilyOperation}from'../family-operation.mts';
const fits=(width=2,height=2)=>{const values=Buffer.alloc(width*height*4);for(let i=0;i<width*height;i++)values.writeFloatBE(i+1,i*4);return Buffer.concat([headerBlock([['SIMPLE',true],['BITPIX',-32],['NAXIS',2],['NAXIS1',width],['NAXIS2',height]]),padBlock(values)]);};
test('F13 exposes DOLP as DOLP and refuses a fabricated Stokes interpretation',()=>{const intensity=member('intensity','intensity.fits','science',fits()),dolp=member('dolp','dolp.fits','science',fits());const d=describeDegreeLinearPolarization({id:'betelgeuse-zimpol',target:'betelgeuse',intensity,dolp,shape:[2,2],producingRecord:'ESO Phase 3'});assert.deepEqual(d.components.map(c=>c.id),['intensity','degree-linear-polarization']);assert.match(d.issues[0]?.reason??'',/No Stokes Q\/U\/V/);assert.equal(BETELGEUSE_ZIMPOL_V.intensity.bytes,8458560);});
test('F13 inspection and export reopen both exact paired grids',async()=>{const root=await mkdtemp(resolve(tmpdir(),'f13-'));try{const first=fits(),second=fits(),a=resolve(root,'i.fits'),b=resolve(root,'d.fits');await writeFile(a,first);await writeFile(b,second);assert.equal(inspectIntensityDolp(first,second).intensity.finite,4);const result=await exportIntensityDolp(resolve(root,'out'),{intensity:{file:a,member:member('intensity','i.fits','science',first)},dolp:{file:b,member:member('dolp','d.fits','science',second)}});assert.deepEqual(JSON.parse(await readFile(result.receipt,'utf8')).inspection.shape,[2,2]);assert.equal((await readFile(result.preview)).subarray(0,2).toString(),'P5');await assert.rejects(exportIntensityDolp(resolve(root,'bad'),{intensity:{file:a,member:member('intensity','i.fits','science',first)},dolp:{file:b,member:member('dolp','d.fits','science',fits(3,2))}}),/changed/);assert.throws(()=>inspectIntensityDolp(first,fits(3,2)),/exact native pixel grid/);}finally{await rm(root,{recursive:true,force:true});}});
async function stokesFixture(root:string,missing=false){const path=resolve(root,missing?'rm-lite-i-only.fits':'rm-lite-documented-stokes.fits'),tc=await astroqueryToolchain(),code=`import numpy as np;from astropy.io import fits;d=np.zeros((2,${missing?1:4},3,2,2),dtype='f4');d[:,0]=10;${missing?'':`d[:,1,0,0,0]=-3;d[:,1,0,0,1]=4;d[:,2,0,0,0]=4;d[:,2,0,0,1]=-3;d[:,3]=2;`}h=fits.PrimaryHDU(d);q=h.header;q['CTYPE1']='RA---SIN';q['CTYPE2']='DEC--SIN';q['CTYPE3']='FREQ';q['CTYPE4']='STOKES';q['CTYPE5']='TIME';q['CRVAL4']=1;q['CDELT4']=1;q['CRPIX4']=1;q['RADESYS']='ICRS';h.writeto(${JSON.stringify(path)})`;await new Promise<void>((done,fail)=>{const p=spawn(tc.python,['-c',code],{env:{...process.env,...tc.env}});p.on('error',fail);p.on('close',c=>c===0?done():fail(new Error('fixture write failed')));});const bytes=await readFile(path);return{path,bytes,pin:{path,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')}};}
test('F13 Stokes FITS uses declared codes, preserves negative Q/U, requires all axes, and records a dispatcher export',async()=>{const root=await mkdtemp(resolve(tmpdir(),'f13-stokes-'));try{const f=await stokesFixture(root),inspection=await inspectStokesFits(f.pin);assert.deepEqual(inspection.axes.map((a:any)=>a.role),['time','stokes','spectral','y','x']);assert.deepEqual(inspection.components,{I:0,Q:1,U:2,V:3});const image=await extractStokesFits(f.pin,{operation:'stokes-image',component:'Q',slice:{'axis-0':1,'axis-2':0}});assert.equal(image.values[0][0],-3);const spectrum=await extractStokesFits(f.pin,{operation:'stokes-spectrum',component:'U',x:0,y:0,slice:{'axis-0':0,'axis-2':1}});assert.deepEqual(spectrum.shape,[3]);const series=await extractStokesFits(f.pin,{operation:'stokes-series',component:'I',slice:{'axis-2':0,'axis-3':0,'axis-4':0}});assert.deepEqual(series.shape,[2]);const angle=await extractStokesFits(f.pin,{operation:'stokes-derived',derived:'polarization-angle',policy:'iau-half-arctan2-qu',slice:{'axis-0':0,'axis-2':0}});assert.equal(angle.values[1][0],null);await assert.rejects(extractStokesFits(f.pin,{operation:'stokes-image',component:'V',slice:{'axis-2':0}}),/explicitly sliced/);const product=describeStokesFits({id:'rm-lite-doc-stokes',member:member('stokes','rm-lite-documented-stokes.fits','science',f.bytes),inspection,producingRecord:'RM-lite public 3D RM-synthesis documentation (ASKAP/EMU-style FITS/WCS example; BSD-3-Clause source)'}),descriptor=resolve(root,'descriptor.json');await writeFile(descriptor,JSON.stringify(product));const out=await executeFamilyOperation(descriptor,{operationId:'stokes-spectrum',component:'Q',x:0,y:0,slice:{'axis-0':0,'axis-2':0}},resolve(root,'out'));assert.equal(JSON.parse(await readFile(out.product,'utf8')).component,'Q');assert.match(await readFile(out.record,'utf8'),/stokes-spectrum/);const onlyI=await stokesFixture(root,true);await assert.rejects(extractStokesFits(onlyI.pin,{operation:'stokes-derived',derived:'linear-polarization-fraction',policy:'iau-half-arctan2-qu',slice:{'axis-0':0,'axis-2':0}}),/requires declared I, Q and U/);}finally{await rm(root,{recursive:true,force:true});}});
