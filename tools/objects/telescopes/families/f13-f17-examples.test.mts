import assert from 'node:assert/strict'; import { sourceTest } from '../../../../tests/objects/source-test.mts';
const test = sourceTest(); import { mkdtemp, readFile, rm } from 'node:fs/promises'; import { tmpdir } from 'node:os'; import { resolve } from 'node:path';
import { proveF13F17Examples } from './f13-f17-examples.mts';
test('F13/F17 pinned public examples restore, operate, and reopen',async context=>{const input=process.env.CSSEARTH_LIVE_FAMILY_PROOF_DIR;if(!input){context.skip('set CSSEARTH_LIVE_FAMILY_PROOF_DIR to an exact restored example directory');return;}const out=await mkdtemp(resolve(tmpdir(),'family-live-proof-'));try{const proof=await proveF13F17Examples(input,out),receipt=JSON.parse(await readFile(proof.receipt,'utf8'));assert.deepEqual(receipt.f13.inspection.shape,[1024,1024]);assert.deepEqual([receipt.f17.width,receipt.f17.height],[537,244]);assert.equal(receipt.f17.rawSaturatedPixels,0);assert.ok((await readFile(receipt.f13.preview)).byteLength>1024);}finally{await rm(out,{recursive:true,force:true});}});
