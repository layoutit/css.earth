import assert from'node:assert/strict';import{test}from'node:test';import{readFile}from'node:fs/promises';import{resolve}from'node:path';import{member}from'./common.mts';import{describeSlitScan,extractSlitRegionSpectrum,F04_SLIT_PROFILE_HANDLER,inspectSlitScan,slitProfileTable,slitScanSummary}from'./f04-slit-profile.mts';
const root=resolve(import.meta.dirname,'../../../..'),definitionPath='tools/objects/hst/programs/europa-salt-map.scan.json',receiptPath='tools/objects/hst/programs/europa-salt-map.scan.reproduction.json',definitionBytes=await readFile(resolve(root,definitionPath)),receiptBytes=await readFile(resolve(root,receiptPath)),definition=JSON.parse(definitionBytes.toString()),receipt=JSON.parse(receiptBytes.toString());
test('F04 binds the real Europa 60-frame slit scan and its reproduction evidence',()=>{const inspected=inspectSlitScan(definition,receipt),summary=slitScanSummary(definition,receipt);assert.deepEqual([inspected.pinned,inspected.used,inspected.visits,inspected.exposureSeconds],[60,60,4,600]);assert.deepEqual(summary.registration.map(row=>row.frames),[15,15,15,15]);assert.equal(summary.registration[0]!.bandStrengthMedian,118.69);assert.equal(slitProfileTable(definition,receipt).length,4);const product=describeSlitScan({id:'europa-salt-map',definitionMember:member('definition',definitionPath,'provenance',definitionBytes,'application/json'),receiptMember:member('receipt',receiptPath,'provenance',receiptBytes,'application/json'),definitionValue:definition,receiptValue:receipt,producingRecord:receiptPath});assert.equal(product.components[0]!.representation.kind,'table');assert.equal(product.components[0]!.axes[0]!.coordinates.kind,'lookup');assert.equal(F04_SLIT_PROFILE_HANDLER.operations(product).find(op=>op.id==='slit-region-spectrum')?.available,true);});
test('F04 refuses to turn a receipt into a spectrum when its pinned _x2d arrays are unavailable',async()=>await assert.rejects(extractSlitRegionSpectrum(definition,receipt,{directory:resolve(root,'work/no-europa-stis-arrays'),frame:definition.frames[0]!.name,row:125}),/ENOENT/u));
test('F04 extracts an actual pinned STIS row and joins it to the receipt registration',async()=>{const spectrum=await extractSlitRegionSpectrum(definition,receipt,{directory:resolve(root,'tests/fixtures/telescope-families/f04-europa-stis'),frame:definition.frames[0]!.name,row:125});assert.equal(spectrum.visit,'od9l12');assert.equal(spectrum.row,125);assert.equal(spectrum.wavelengthAngstrom.length,spectrum.flux.length);assert.equal(spectrum.flux.length,spectrum.error.length);assert.ok(spectrum.wavelengthAngstrom[0]!>=3000);});
test('F04 refuses a receipt whose pinned frame count differs',()=>assert.throws(()=>inspectSlitScan(definition,{...receipt,frames:{...receipt.frames,pinned:59}}),/does not match/u));
