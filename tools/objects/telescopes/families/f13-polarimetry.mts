const stokesOps=(d:ProductDescriptor):FamilyOperation[]=>{const components=d.components.filter(c=>/^stokes-[iquv]$/u.test(c.id));if(!components.length)return[];const componentChoices=components.map(c=>c.id.slice(-1).toUpperCase());const base=(id:string,label:string,parameters:any[]):FamilyOperation=>({id,label,handlerId:'f13-polarimetry',componentId:components[0]!.id,owner:{module:'tools/objects/telescopes/families/f13-polarimetry.mts',export:id==='stokes-inspect'?'inspectStokesFits':'extractStokesFits'},available:true,reason:'Astropy selects declared FITS/WCS Stokes codes and requires every remaining axis explicitly.',fixedArguments:{},parameters:[...parameters,{id:'out',option:'--out',kind:'output-directory',required:true,description:'New output directory.'}],limitations:['Archive basis, sign and frame are retained from FITS/WCS. Derived angle needs I/Q/U and explicit IAU half-arctan2 policy; zero polarized intensity is undefined.']});return[base('stokes-inspect','Inspect declared Stokes axes',[]),base('stokes-image','Extract Stokes image',[{id:'component',option:'--component',kind:'choice',required:true,choices:componentChoices,description:'Declared Stokes component.'},{id:'slice',option:'--slice',kind:'input-path',required:true,description:'JSON object with every non-image axis index.'}]),base('stokes-spectrum','Extract Stokes spectrum',[{id:'component',option:'--component',kind:'choice',required:true,choices:componentChoices,description:'Declared Stokes component.'},{id:'x',option:'--x',kind:'integer',required:true,minimum:0,description:'Native X index.'},{id:'y',option:'--y',kind:'integer',required:true,minimum:0,description:'Native Y index.'},{id:'slice',option:'--slice',kind:'input-path',required:true,description:'JSON object with every remaining axis index.'}]),base('stokes-series','Extract Stokes time series',[{id:'component',option:'--component',kind:'choice',required:true,choices:componentChoices,description:'Declared Stokes component.'},{id:'slice',opti