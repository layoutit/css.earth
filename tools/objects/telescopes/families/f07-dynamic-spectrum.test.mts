import assert from 'node:assert/strict';import test from 'node:test';import {copyFile,mkdtemp,readFile,rm,writeFile} from 'node:fs/promises';import {tmpdir} from 'node:os';import {resolve} from 'node:path';import {describeWindRad1,dynamicSpectrumSpectrum,dynamicSpectrumTimeSeries,exportDynamicSpectrumCsv,inspectWindRad1,selectDynamicSpectrum,WIND_RAD1_FIXTURE} from './f07-dynamic-spectrum.mts';import {member} from './common.mts';
const path=resolve(import.meta.dirname,'../../../../tests/fixtures/telescope-families/wind-rad1/wi_l2_wav_rad1_20200101_v01.cdf');
test('F07 pins and decodes authentic Wind RAD1 Epoch/FREQUENCY/PSD without grid assumptions',async()=>{const d=await inspectWindRad1({...WIND_RAD1_FIXTURE,path});assert.deepEqual([d.epochsTt2000.length,d.frequencyHz.length,d.psd.length,d.psd[0]!.length],[1856,256,1856,256]);assert.equal(d.cdflib,'1.3.12');const selected=selectDynamicSpectrum(d,{time:[0,2],frequency:[0,3]});assert.match(exportDynamicSpectrumCsv(selected),/^epoch_tt2000,frequency_hz,psd\n631108815985012754,20000,/u);assert.equal(dynamicSpectrumSpectrum(d,0).frequencyHz.length,256);assert.equal(dynamicSpectrumTimeSeries(d,0).epochsTt2000.length,1856);const bytes=await readFile(path),product=describeWindRad1({id:'wind-rad1-20200101',member:member('cdf','wind.cdf','science',bytes),producingRecord:path,timeLength:d.epochsTt2000.length,frequencyLength:d.frequencyHz.length});assert.equal(product.components[0]!.axes[0]!.coordinates.kind,'lookup');assert.throws(()=>selectDynamicSpectrum(d,{time:[0,1857],frequency:[0,1]}),/in-bounds/u);});
test('F07 rejects changed pins and malformed/missing CDF variables',async()=>{const dir=await mkdtemp(resolve(tmpdir(),'wind-cdf-'));try{const copy=resolve(dir,'copy.cdf');await copyFile(path,copy);const bad=resolve(dir,'bad.cdf');await writeFile(bad,'not a CDF');await assert.rejects(inspectWindRad1({path:bad}));const missing=resolve(dir,'missing.cdf'),changed=Buffer.from(await readFile(path));let at=0,replaced=0;while((at=changed.indexOf(Buffer.from('PSD_V2_S'),at))>=0){changed.write('PSD_X2_S',at,'ascii');at+=8;replaced++;}assert.ok(replaced>0);await writeFile(missing,changed);const crypto=await import('node:crypto');await assert.rejects(inspectWindRad1({path:missing}),/Missing required CDF variable PSD_V2_S/u);}finally{await rm(dir,{recursive:true,force:true});}});
