export function exportAstrometryCsv(rows:readonly AstrometryRow[]){inspectAstrometry(rows);return csv(['id','ra_deg','dec_deg','epoch_jyear','pm_ra_cosdec_mas_yr','pm_dec_mas_yr','parallax_mas','parallax_error_mas','radial_velocity_km_s','ra_error_mas','dec_error_mas','covariance'],rows.map(row=>[row.id,row.raDeg,row.decDeg,row.epochJulianYear,row.pmRaCosDecMasYr,row.pmDecMasYr,row.parallaxMas,row.parallaxErrorMas,row.radialVelocityKmS,row.raErrorMas,row.decErrorMas,row.covariance?JSON.stringify(row.covariance):undefined]));}
