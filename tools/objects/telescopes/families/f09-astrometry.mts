const ops=(component:any):FamilyOperation[]=>{const cols=new Set(component.columns.map((c:any)=>c.id)),canPropagate=component.frame?.name?.toUpperCase()==='ICRS'&&component.frame.epoch!==undefined&&cols.has('pmra')&&cols.has('pmdec');return[{id:'astrometry-inspect',label:'Inspect astrometry',owner:'inspectAstrometry',available:true,reason:'Positions, identities, frame and epoch are exposed.'},{id:'astrometry-export',label:'Export astrometry',owner:'exportAstrometryCsv',available:true,reason:'Exports retained astrometric columns.'},{id:'astrometry-select-rows',label:'Select astrometric rows',owner:'selectAstrometryRows',available:true,reason:'Explicit source IDs select retained rows.'},{id:'astrometry-track-data',label:'Prepare sky/track view',owner:'astrometryTrackData',available:true,reason:'ICRS positions and declared uncertainties are available; row order is not promoted to a trajectory.'},{id:'astrometry-track-preview',label:'Render sky-position preview',owner:'previewAstrometryTrack',available:true,reason:'ICRS positions retain row identity in a static scatter preview.'},{id:'astrometry-propagate',label:'Propagate astrometry',owner:'propagateAstrometry',available:canPropagate,reason:canPropagate?'ICRS epoch and both proper-motion components are present.':'Propagation requires ICRS, a source epoch and both proper-motion components.'}].map(op=>({id:op.id,label:op.label,handlerId:'f09-astrometry',componentId:component.id,owner:{module:'tools/objects/telescopes/families/f09-astrometry.mts',export:op.owner},available:op.available,reason:op.reason,fixedArguments:{},parameters:[...(op.id==='astrometry-propagate'?[{id:'epoch',option:'--epoch',kind:'number-list' as const,required:true,count:2,description:'Explicit source and destination Julian years.'}]:op.id==='astrometry-select-rows'?[{id:'rows',option:'--rows',kind:'input-path' as const,required:true,description:'Exact astrometric source IDs.'}]:[]),{id:'out',option:'--out',kind:'output-directory' as const,required:t