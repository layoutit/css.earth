import assert from 'node:assert/strict';import { sourceTest } from '../../../../tests/objects/source-test.mts';
const test = sourceTest();import {readFile} from 'node:fs/promises';import {resolve} from 'node:path';
import {member} from './common.mts';import {describeStandaloneSpectrum,exportSpectrumCsv,F03_SPECTRUM_HANDLER,selectSpectrumRange,spectrumChartData} from './f03-spectrum.mts';
const root=resolve(import.meta.dirname,'../../../..'),path='src/objects/mercury/source/spectrum/mascs-global-area-weighted-mean.json',bytes=await readFile(resolve(root,path));
const source=JSON.parse(bytes.toString()) as {wavelengthNanometers:number[];reflectanceIOverF:number[];validCellCounts:number[]};
test('F03 adapts and exports the pinned real MASCS spectrum without a pixel',()=>{const samples=source.wavelengthNanometers.map((wavelength,index)=>({id:String(index),wavelength,value:source.reflectanceIOverF[index]!,segment:'visible'}));const product=describeStandaloneSpectrum({id:'mercury-mascs',target:'mercury',member:member('mascs',path,'science',bytes,'application/json'),samples,wavelengthUnit:'nm',valueName:'reflectance I/F',producingRecord:path,calibrationBasis:['DLR photometrically corrected grid; repository cosine-latitude area-weighted mean.']});assert.equal(product.components[0]!.representation.kind,'table');assert.equal(product.components[0]!.axes[0]!.length,326);assert.match(exportSpectrumCsv(samples),/^id,segment,wavelength,value,uncertainty,upper_limit\n0,visible,350,/u);assert.equal(F03_SPECTRUM_HANDLER.operations(product)[0]!.available,true);});
test('F03 retains gaps, limits and uncertainty and refuses reordering within a segment',()=>{const samples=[{id:'a',segment:'blue',wavelength:1,value:2,uncertainty:.1},{id:'b',segment:'red',wavelength:4,value:3,upperLimit:true}];const product=describeStandaloneSpectrum({id:'segmented',member:member('s','s.json','science',Buffer.from('{}')),samples,wavelengthUnit:'um',valueName:'flux',producingRecord:'test',calibrationBasis:['fixture']});assert.equal(product.issues.some(issue=>issue.identity==='wavelength'),true);assert.match(exportSpectrumCsv(samples),/b,red,4,3,,1/u);assert.throws(()=>exportSpectrumCsv([{wavelength:2,value:1},{wavelength:1,value:1}]),/increase/u);});
test('F03 range and chart data preserve segment and upper-limit identity',()=>{const samples=[{id:'a',segment:'blue',wavelength:1,value:2},{id:'b',segment:'red',wavelength:4,value:3,upperLimit:true}];assert.deepEqual(selectSpectrumRange(samples,{from:1,to:1}),[samples[0]]);assert.deepEqual(spectrumChartData(samples)[1],{id:'b',segment:'red',wavelength:4,value:3,upperLimit:true});});
