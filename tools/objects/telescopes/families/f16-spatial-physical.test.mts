import assert from'node:assert/strict';import{test}from'node:test';import{resolve}from'node:path';import{describeSpatialPhysicalObject,F16_SPATIAL_PHYSICAL_HANDLER,selectSpatialComponents}from'./f16-spatial-physical.mts';
const root=resolve(import.meta.dirname,'../../../..');
test('F16 describes the real stellar-neighbourhood point field through the existing loader',async()=>{const product=await describeSpatialPhysicalObject(resolve(root,'src/objects/stellar-neighbourhood/object.json')),component=product.components[0]!;assert.equal(component.representation.kind,'physical-field');assert.equal(component.representation.kind==='physical-field'&&component.representation.topology,'points');assert.equal(component.frame?.name,'sun-icrf');assert.deepEqual(selectSpatialComponents(product,['points']).map(item=>item.id),['points']);assert.equal(F16_SPATIAL_PHYSICAL_HANDLER.operations(product).find(op=>op.id==='spatial-export-points')?.fixedArguments.kind,'points');});
test('F16 describes the real Milky Way density volume without inferring it from telescope pixels',async()=>{const product=await describeSpatialPhysicalObject(resolve(root,'src/objects/milky-way/object.json')),component=product.components[0]!;assert.equal(component.representation.kind==='physical-field'&&component.representation.topology,'grid');assert.match(component.quantity.semantics,/no depth is inferred/u);assert.equal(F16_SPATIAL_PHYSICAL_HANDLER.operations(product).find(op=>op.id==='spatial-export-volume')?.fixedArguments.kind,'volume');});
