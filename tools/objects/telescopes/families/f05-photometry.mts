import type {FamilyHandler,FamilyOperation} from '../family-handlers.mts';import type {DescriptorMember,ProductDescriptor} from '../product-descriptor.mts';import{plotNumericPreview,type FigureOptions}from'../../astronomy-packages/plots.mts';import {csv,descriptor,stable} from './common.mts';import {requireFiniteNumber as finite} from '@cssearth/core';
export interface PhotometryPoint{readonly id:string;readonly band:string;readonly effectiveWavelength?:number;readonly value:number;readonly uncertainty?:number;readonly upperLimit?:boolean;readonly segment?:string;readonly system:string}
export interface PhotometryDescription{readonly id:string;readonly target?:string;readonly member:DescriptorMember;readonly points:readonly PhotometryPoint[];readonly wavelengthUnit?:string;readonly quantity:string;readonly unit:string;readonly producingRecord:string;readonly calibrationBasis:readonly string[]}
export function validatePhotometry(points:readonly PhotometryPoint[]){if(!points.length)throw new TypeError('Photometry needs points.');const ids=new Set<string>();for(const p of points){stable(p.id,'photometry point id');if(ids.has(p.id))throw new TypeError(`Duplicate photometry point ${p.id}.`);ids.add(p.id);if(!p.band||!p.system)throw new TypeError('Photometry band and system are required.');finite(p.value,'photometry value');if(p.effectiveWavelength!==undefined&&!(finite(p.effectiveWavelength,'effective wavelength')>0))throw new TypeError('Effective wavelength must be positive.');if(p.uncertainty!==undefined&&!(finite(p.uncertainty,'photometry uncertainty')>0))throw new TypeError('Photometry uncertainty must be positive.');}return points;}
export function exportPhotometryCsv(points:readonly PhotometryPoint[]){validatePhotometry(points);return csv(['id','segment','band','system','effective_wavelength','value','uncertainty','upper_limit'],points.map(p=>[p.id,p.segment??'',p.band,p.system,p.effectiveWavelength,p.value,p.uncertainty,p.upperLimit?1:0]));}
/** The SED table is deliberately the native photometric table, ordered only where wavelengths are established. */
export function sedTable(points:readonly PhotometryPoint[]){validatePhotometry(points);return [...points].sort((a,b)=>(a.effectiveWavelength??Infinity)-(b.effectiveWavelength??Infinity)||a.id.localeCompare(b.id));}
export function sedPlotData(points:readonly PhotometryPoint[]){return sedTable(points).filter(point=>point.effectiveWavelength!==undefined).map(point=>({id:point.id,band:point.band,system:point.system,wavelength:point.effectiveWavelength!,value:point.value,...(point.uncertainty===undefined?{}:{uncertainty:point.uncertainty}),upperLimit:point.upperLimit===true}));}
export async function previewSed(out:string,title:string,points:readonly PhotometryPoint[],wavelengthLabel='Effective wavelength',valueLabel='Photometric value',options:FigureOptions={}){const data=sedPlotData(points);if(!data.length)throw new TypeError('SED preview requires effective wavelengths.');return plotNumericPreview(out,{kind:'series',title,xLabel:wavelengthLabel,yLabel:valueLabel,series:[{label:'native bands',x:data.map(point=>point.wavelength),y:data.map(point=>point.value),uncertainty:data.map(point=>point.uncertainty??null),upperLimit:data.map(point=>point.upperLimit)}]},options);}
export function describePhotometry(input:PhotometryDescription):ProductDescriptor{const points=validatePhotometry(input.points),hasWave=points.some(p=>p.effectiveWavelength!==undefined),hasError=points.some(p=>p.uncertainty!==undefined),hasLimits=points.some(p=>p.upperLimit);return descriptor({schema:'cssearth-telescope-product-descriptor@1',dataset:{id:stable(input.id,'photometry id'),...(input.target?{target:input.target}:{}),acquisition:{kind:'repository',identity:input.member.path},producingRecord:input.producingRecord,sourceClassifications:[{term:'photometry',vocabulary:'cssEarth observational families',version:'1',status:'mapped'}],families:['F05'],profiles:[{handlerId:'f05-photometry',profileId:'discrete-photometry-table@1'}]},members:[input.member],components:[{id:'photometry',name:input.quantity,families:['F05'],locations:[{memberId:input.member.id}],representation:{kind:'table',rows:points.length},axes:hasWave?[{id:'bandpass',index:0,length:points.length,role:'spectral-sampling',...(input.wavelengthUnit?{unit:input.wavelengthUnit}:{}),coordinates:{kind:'lookup',memberId:input.member.id,locator:'effective_wavelength',binBounds:false}}]:[],columns:[{id:'id',name:'id',role:'row-identity',datatype:'string',nullable:false,variableLength:false},{id:'segment',name:'segment',role:'segment',datatype:'string',nullable:true,variableLength:false},{id:'band',name:'band',role:'bandpass-identity',datatype:'string',nullable:false,variableLength:false},{id:'system',name:'system',role:'photometric-system',datatype:'string',nullable:false,variableLength:false},{id:'value',name:'value',role:'measurement',datatype:'float64',unit:input.unit,nullable:false,variableLength:false},...(hasError?[{id:'uncertainty',name:'uncertainty',role:'standard-deviation',datatype:'float64',unit:input.unit,nullable:true,variableLength:false} as const]:[]),...(hasLimits?[{id:'upper-limit',name:'upper_limit',role:'limit-flag',datatype:'boolean',nullable:false,variableLength:false} as const]:[])],quantity:{name:input.quantity,semantics:'Discrete photometric points; bands and systems remain explicit.',unit:input.unit},calibration:{state:'archive-calibrated',basis:input.calibrationBasis},...(hasError?{uncertainty:{form:'standard-deviation',columnId:'uncertainty',basis:'Supplied per-point uncertainty.'} as const}:{}),flags:hasLimits?[{id:'upper-limit',meaning:'Censored upper limit.',columnId:'upper-limit',usableWhen:'Do not treat as a detection.'}]:[],dependencyIds:[]}],dependencies:[],issues:hasWave?[]:[{scope:'component',identity:'photometry',state:'missing',reason:'No effective wavelengths are supplied; retain band identities and do not invent an SED axis.'}]});}
const op=(componentId:string,id:string,label:string,owner:string,available=true,reason='Discrete measurements retain their declared band systems and limits.'):FamilyOperation=>({id,label,handlerId:'f05-photometry',componentId,owner:{module:'tools/objects/telescopes/families/f05-photometry.mts',export:owner},available,reason,fixedArguments:{},parameters:[{id:'out',option:'--out',kind:'output-directory',required:true,description:'New output directory.'}],limitations:['No interpolation, zero-point conversion, magnitude-to-flux conversion, or extinction correction is implicit.']});
export const F05_PHOTOMETRY_HANDLER:FamilyHandler={id:'f05-photometry',families:['F05'],profiles:[{id:'discrete-photometry-table@1',format:'Discrete photometry or SED table',version:'1',families:['F05'],publicBaseline:true,evidence:[{path:'src/objects/haumea/source/photometry/disc-color.json',establishes:'Pinned real BVRI colour indices, uncertainties, photometric system and SVO effective wavelengths.',status:'complete'}]}],recognizes:members=>members.some(m=>/photometr|sed/iu.test(m.path))?['discrete-photometry-table@1']:[],operations:d=>d.components.filter(c=>c.families.includes('F05')).flatMap(c=>[op(c.id,'photometry-export','Export discrete photometry/SED','exportPhotometryCsv'),op(c.id,'sed-table','Prepare SED table','sedTable'),op(c.id,'sed-plot-data','Prepare SED plot data','sedPlotData'),op(c.id,'sed-preview','Render SED preview','previewSed'),op(c.id,'photometry-convert','Convert photometry','sedTable',false,'Unavailable: this profile has no explicit zero point, passband response, or magnitude-to-flux policy.')])};
