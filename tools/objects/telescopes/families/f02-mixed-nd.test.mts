import assert from 'node:assert/strict';
import {spawn} from 'node:child_process';
import {createHash} from 'node:crypto';
import {mkdtemp,readFile,rm,writeFile} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {resolve} from 'node:path';
import { sourceTest } from '../../../../tests/objects/source-test.mts';
const test = sourceTest();
import {astroqueryToolchain} from '../../astronomy-packages/toolchain.mts';
import {describeMixedNd,extractMixedNd,inspectMixedNd} from './f02-mixed-nd.mts';import{member}from'./common.mts';import{executeFamilyOperation}from'../family-operation.mts';
import { readProductRecord } from '@cssearth/telescope/node';
const root=resolve(import.meta.dirname,'../../../..');
const make=async()=>{const dir=await mkdtemp(resolve(tmpdir(),'f02-mixed-')),path=resolve(dir,'mixed.fits'),tc=await astroqueryToolchain(),code=`import numpy as np; from astropy.io import fits; h=fits.PrimaryHDU(np.arange(2*3*4*5*6,dtype='f4').reshape(2,3,4,5,6)); q=h.header; q['BUNIT']='K'; q['CTYPE1']='RA---TAN';q['CUNIT1']='deg';q['CRPIX1']=3.5;q['CRVAL1']=123.25;q['CDELT1']=-0.125; q['CTYPE2']='DEC--TAN';q['CUNIT2']='deg';q['CRPIX2']=2.5;q['CRVAL2']=-44.5;q['CDELT2']=0.25; q['CTYPE3']='FREQ';q['CUNIT3']='Hz';q['CRPIX3']=1.25;q['CRVAL3']=1400000000.;q['CDELT3']=250000.; q['CTYPE4']='TIME';q['CUNIT4']='d';q['CRPIX4']=2.;q['CRVAL4']=12.5;q['CDELT4']=0.125; q['CTYPE5']='STOKES';q['CRPIX5']=1.;q['CRVAL5']=1.;q['CDELT5']=1.; q['TIMESYS']='TDB';q['TIMEUNIT']='d';q['TREFPOS']='BARYCENTER';q['MJDREFI']=50000;q['MJDREFF']=0.125; q['PC1_2']=0.125; h.writeto(${JSON.stringify(path)})`;await new Promise<void>((done,fail)=>{const p=spawn(tc.python,['-c',code],{env:{...process.env,...tc.env}});p.on('error',fail);p.on('close',c=>c===0?done():fail(new Error('fixture write failed')));});const bytes=await readFile(path);return{dir,pin:{path,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')}};};
test('F02 inspects every native mixed axis and requires explicit slices before retaining requested axes',async()=>{const f=await make();try{const inspected=await inspectMixedNd(f.pin);assert.deepEqual(inspected.axes.map(a=>a.role),['polarization','time','spectral','y','x']);assert.deepEqual(inspected.axes.map(a=>a.numpyIndex),[0,1,2,3,4]);const spectrum=await extractMixedNd(f.pin,{operation:'nd-spectrum',x:2,y:1,slice:{'axis-0':1,'axis-1':2}});assert.deepEqual(spectrum.shape,[4]);assert.deepEqual(spectrum.axes.map((a:any)=>a.role),['spectral']);assert.deepEqual(spectrum.values,[608,638,668,698],'selection follows NumPy axis order, not FITS card order');assert.equal(spectrum.coordinateContext.dataUnit,'K');assert.deepEqual(spectrum.coordinateContext.timeReference,{TIMESYS:'TDB',TIMEUNIT:'d',TREFPOS:'BARYCENTER',MJDREFI:50000,MJDREFF:0.125});assert.equal(spectrum.coordinateContext.coordinateModel.coupled,true);assert.equal(spectrum.coordinateContext.coordinateModel.separable,false);assert.deepEqual(spectrum.coordinateContext.outputAxisMapping,[{outputNumpyAxis:0,sourceAxisId:'axis-2',sourceNumpyAxis:2,sourceFitsAxis:3,sourceIndices:{start:0,step:1,length:4}}]);assert.deepEqual(spectrum.coordinateContext.fixedAxisSelection.map((axis:any)=>[axis.sourceAxisId,axis.sourceIndex]),[['axis-0',1],['axis-1',2],['axis-3',1],['axis-4',2]]);assert.ok(spectrum.coordinateContext.sourceWcsCards.some((card:any)=>card.keyword==='CRVAL3'&&card.value===1400000000));const image=await extractMixedNd(f.pin,{operation:'nd-image',slice:{'axis-0':1,'axis-1':2,'axis-2':3}});assert.deepEqual(image.shape,[5,6]);assert.equal(image.values[1][2],698);const series=await extractMixedNd(f.pin,{operation:'nd-time-series',slice:{'axis-0':1,'axis-2':3,'axis-3':1,'axis-4':2}});assert.deepEqual(series.shape,[3]);assert.deepEqual(series.values,[458,578,698]);const bytes=await readFile(f.pin.path),d=describeMixedNd({id:'mixed',member:member('mixed','mixed.fits','science',bytes),inspection:inspected,producingRecord:'adverse axis fixture'}),descriptor=resolve(f.dir,'descriptor.json');assert.deepEqual(d.components[0]!.axes.map(a=>a.index),[0,1,2,3,4]);await writeFile(descriptor,JSON.stringify(d));const out=await executeFamilyOperation(descriptor,{operationId:'nd-spectrum',x:2,y:1,slice:{'axis-0':1,'axis-1':2}},resolve(f.dir,'out'));const reopened=JSON.parse(await readFile(out.product,'utf8'));assert.equal(reopened.coordinateContext.dataUnit,'K');assert.equal(reopened.coordinateContext.timeReference.TIMESYS,'TDB');assert.ok(reopened.coordinateContext.sourceWcsCards.some((card:any)=>card.keyword==='CRPIX3'&&card.value===1.25));assert.match(await readFile(out.record,'utf8'),/nd-spectrum/u);await assert.rejects(extractMixedNd(f.pin,{operation:'nd-spectrum',x:2,y:1,slice:{'axis-1':2}}),/explicitly sliced/u);}finally{await rm(f.dir,{recursive:true,force:true});}});
test('F02 adverse permutation remains axis-role based and does not squeeze time, spectral or polarization',async()=>{const f=await make();try{const inspected=await inspectMixedNd(f.pin);assert.equal(inspected.axes.find(a=>a.role==='polarization')?.fitsAxis,5);await assert.rejects(extractMixedNd(f.pin,{operation:'nd-image',slice:{'axis-0':1,'axis-1':2}}),/explicitly sliced/u);await assert.rejects(extractMixedNd(f.pin,{operation:'nd-time-series',slice:{'axis-0':1,'axis-2':3,'axis-3':1}}),/explicitly sliced/u);}finally{await rm(f.dir,{recursive:true,force:true});}});
test('F02 runs a pinned public mixed time, Stokes and spectral FITS through public slicing and readback',async()=>{const source=resolve(root,'tests/fixtures/telescope-families/f13-stokes/rm-lite-documented-full-stokes.fits'),dir=await mkdtemp(resolve(tmpdir(),'f02-public-'));try{const bytes=await readFile(source),file=resolve(dir,'full-stokes.fits');await writeFile(file,bytes);const pin={path:file,bytes:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')},inspection=await inspectMixedNd(pin);assert.deepEqual(inspection.axes.map(axis=>axis.role),['time','polarization','spectral','y','x']);const d=describeMixedNd({id:'rm-lite-mixed',member:member('mixed','full-stokes.fits','science',bytes),inspection,producingRecord:'RM-lite public documentation fixture'}),path=resolve(dir,'descriptor.json');await writeFile(path,JSON.stringify(d));const result=await executeFamilyOperation(path,{operationId:'nd-spectrum',x:0,y:0,slice:{'axis-0':0,'axis-1':1}},resolve(dir,'out')),reopened=JSON.parse(await readFile(result.product,'utf8')),record=await readProductRecord(result.record);assert.deepEqual(reopened.shape,[3]);assert.equal(reopened.axes[0].role,'spectral');assert.equal(record?.outputs[0]?.path,'mixed-nd.json');}finally{await rm(dir,{recursive:true,force:true});}});
