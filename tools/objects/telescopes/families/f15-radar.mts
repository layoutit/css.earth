export function delayDopplerProfile(image:RadarImage,window:RadarWindow){for(const value of [...window.delay,...window.doppler])finite(value,'window coordinate');const [x0,x1]=window.delay,[y0,y1]=window.doppler;if(!Number.isInteger(x0)||!Number.isInteger(x1)||!Number.isInteger(y0)||!Number.isInteger(y1)||x0<0||y0<0||x1>image.width||y1>image.height||x1<=x0||y1<=y0)throw new RangeError('Window must use increasing in-bounds native delay and Doppler pixel indices.');const delay=Array.from({length:x1-x0},(_,x)=>{let sum=0;for(let y=y0;y<y1;y++)sum+=at(image,x+x0,y);return sum;});const doppler=Array.from({length:y1-y0},(_,y)=>{let sum=0;for(let x=x0;x<x1;x++)sum+=at(image,x,y+y0);return sum;});return{window,delay,doppler};}
