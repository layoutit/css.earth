  const dataOffset=2880,needed=width*height*8;if(bytes.length<dataOffset+needed)throw new TypeError('Radar FITS data length disagrees with its declared shape.');
  return{width,height,bitpix,dataOffset,bytes};
}
export function validatePds3RadarLabel(label:Buffer,image:RadarImage){
