export function inspectDelayDopplerFits(bytes:Buffer):RadarImage{
  // 1998 RDF2FIT product: only parse the mandatory primary cards; full FITS ownership remains Astropy once available.
  if(bytes.length<2880)throw new TypeError('Radar FITS is shorter than one header block.');
  const cards=Array.from({length:36},(_,i)=>bytes.toString('latin1',i*80,(i+1)*80));
  const value=(key:string)=>{const card=cards.find(row=>row.startsWith(key.padEnd(8)));if(!card)throw new TypeError(`Missing FITS ${key}.`);return Number(card.slice(10).trim().split(/[ /]/u,1)[0]);};
  const width=value('NAXIS1'),height=value('NAXIS2'),bitpix=value('BITPIX'),naxis=value('NAXIS');
