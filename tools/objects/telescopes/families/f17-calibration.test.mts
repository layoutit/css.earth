import assert from 'node:assert/strict'; import test from 'node:test';
import { describeCalibrationBundle, F17_CALIBRATION_HANDLER, MATHILDE_NEAR_MSI_42826360 } from './f17-calibration.mts';
const source=MATHILDE_NEAR_MSI_42826360;
const member=(entry:{id:string;path:string},role:'science'|'calibration'|'label')=>({id:entry.id,path:entry.path,role});
test('F17 Mathilde example retains the authentic raw/calibrated/label closure and only offers its native decoder',()=>{const raw=member(source.raw,'science'),calibrated=member(source.calibrated,'science'),label=member(source.label,'label');const product=describeCalibrationBundle({id:'mathilde-near-msi-42826360',target:'253-mathilde',producingRecord:source.record,members:[raw,calibrated,label],rawMemberIds:['raw'],calibrationMemberIds:['label'],productMemberIds:['calibrated'],profileId:'near-msi-camera@1',calibrationState:'archive-calibrated',reducer:{module:'tools/objects/terrestrial-layers/near-msi.mts',export:'decodeNearMsi',label:'NEAR MSI native paired decoder'}});assert.deepEqual(product.dependencies[0]!.memberIds,['raw','label','calibrated']);assert.equal(product.components[1]!.calibration.state,'archive-calibrated');const operation=F17_CALIBRATION_HANDLER.operations(product).find(operation=>operation.id==='run-reducer')!;assert.equal(operation.available,true);assert.equal(operation.owner.export,'decodeNearMsi');const inspect=F17_CALIBRATION_HANDLER.operations(product).find(operation=>operation.id==='near-msi-inspect')!;assert.equal(inspect.owner.export,'inspectNearMsiBundle');assert.deepEqual(inspect.fixedArguments,{rawMember:'raw',calibratedMember:'calibrated',labelMember:'label'});});
