import type{FamilyHandler,FamilyOperation}from'../family-handlers.mts';import type{DescriptorMember,ProductDescriptor}from'../product-descriptor.mts';import{plotNumericPreview,type FigureOptions}from'../../astronomy-packages/plots.mts';import{csv,descriptor,stable}from'./common.mts';import{requireFiniteNumber as finite}from'@cssearth/core';
export interface TimeSample{readonly id:string;readonly time:number;readonly value:number;readonly uncertainty?:number;readonly quality?:number;readonly segment?:string}
export interface TimeSeriesDescription{readonly id:string;readonly target?:string;readonly member:DescriptorMember;readonly samples:readonly TimeSample[];readonly timeUnit:string;readonly timeScale:string;readonly referenceEpoch?:string;readonly quantity:string;readonly unit?:string;readonly producingRecord:string;readonly calibrationBasis:readonly string[]}
export function validateTimeSeries(samples:readonly TimeSample[]){if(!samples.length)throw new TypeError('A time series needs samples.');const ids=new Set<string>(),last=new Map<string,number>();for(const s of samples){stable(s.id,'time sample id');if(ids.has(s.id))throw new TypeError(`Duplicate time sample ${s.id}.`);ids.add(s.id);finite(s.time,'time');finite(s.value,'value');if(s.uncertainty!==undefined&&!(finite(s.uncertainty,'uncertainty')>0))throw new TypeError('Time-series uncertainty must be positive.');const segment=s.segment??'0',prior=last.get(segment);if(prior!==undefined&&s.time<=prior)throw new TypeError('Times must increase within each segment.');last.set(segment,s.time);}return samples;}
export function selectTimeSeries(samples:readonly TimeSample[],range:{readonly from:number;readonly to:number}){validateTimeSeries(samples);if(!Number.isFinite(range.from)||!Number.isFinite(range.to)||range.to<range.from)throw new TypeError('Time selection must be finite and ordered.');return samples.filter(s=>s.time>=range.from&&s.time<=range.to);}
export function binTimeSeries(samples:readonly TimeSample[],options:{readonly width:number;readonly origin:number}){validateTimeSeries(samples);if(!(finite(options.width,'bin width')>0))throw new TypeError('Bin width must be positive.');finite(options.origin,'bin origin');const groups=new Map<string,TimeSample[]>();for(const sample of samples){const index=Math.floor((sample.time-options.origin)/options.width),key=`${sample.segment??''}:${index}`;groups.set(key,[...(groups.get(key)??[]),sample]);}return [...groups.values()].map(group=>{const weighted=group.every(s=>s.uncertainty!==undefined),weights=group.map(s=>weighted?1/s.uncertainty!**2:1),sum=weights.reduce((a,b)=>a+b,0),mean=(field:'time'|'value')=>group.reduce((total,s,i)=>total+s[field]*weights[i]!,0)/sum;return{id:group.map(s=>s.id).join('+'),...(group[0]!.segment?{segment:group[0]!.segment}:{}),time:mean('time'),value:mean('value'),...(weighted?{uncertainty:Math.sqrt(1/sum)}:{}),quality:Math.max(...group.map(s=>s.quality??0))};});}
export function foldTimeSeries(samples:readonly TimeSample[],options:{readonly epoch:number;readonly period:number}){validateTimeSeries(samples);finite(options.epoch,'fold epoch');if(!(finite(options.period,'fold period')>0))throw new TypeError('Fold period must be positive.');return samples.map(sample=>({...sample,phase:((sample.time-options.epoch)/options.period%1+1)%1})).sort((a,b)=>a.phase-b.phase||a.time-b.time);}
export function exportTimeSeriesCsv(samples:readonly TimeSample[]){validateTimeSeries(samples);return csv(['id','segment','time','value','uncertainty','quality'],samples.map(s=>[s.id,s.segment??'',s.time,s.value,s.uncertainty,s.quality]));}
export function timeSeriesPlotData(samples:readonly TimeSample[]){validateTimeSeries(samples);return samples.map(sample=>({id:sample.id,segment:sample.segment??'0',time:sample.time,value:sample.value,...(sample.uncertainty===undefined?{}:{uncertainty:sample.uncertainty}),...(sample.quality===undefined?{}:{quality:sample.quality})}));}
export async function previewTimeSeries(out:string,title:string,samples:readonly TimeSample[],timeLabel='Time',valueLabel='Value',options:FigureOptions={}){const groups=new Map<string,TimeSample[]>();for(const sample of validateTimeSeries(samples)){const key=sample.segment??'0';groups.set(key,[...(groups.get(key)??[]),sample]);}return plotNumericPreview(out,{kind:'series',title,xLabel:timeLabel,yLabel:valueLabel,series:[...groups].map(([label,points])=>({label,x:points.map(point=>point.time),y:points.map(point=>point.value),uncertainty:points.map(point=>point.uncertainty??null)}))},options);}
export function describeTimeSeries(input:TimeSeriesDescription):ProductDescriptor{const samples=validateTimeSeries(input.samples),error=samples.some(s=>s.uncertainty!==undefined),quality=samples.some(s=>s.quality!==undefined),segments=new Set(samples.map(s=>s.segment??'0'));return descriptor({schema:'cssearth-telescope-product-descriptor@1',dataset:{id:stable(input.id,'time series id'),...(input.target?{target:input.target}:{}),acquisition:{kind:'repository',identity:input.member.path},producingRecord:input.producingRecord,sourceClassifications:[{term:'time-series',vocabulary:'cssEarth observational families',version:'1',status:'mapped'}],families:['F06'],profiles:[{handlerId:'f06-time-series',profileId:'sampled-time-series-table@1'}]},members:[input.member],components:[{id:'time-series',name:input.quantity,families:['F06'],locations:[{memberId:input.member.id}],representation:{kind:'table',rows:samples.length},axes:[{id:'time',index:0,length:samples.length,role:'time',unit:input.timeUnit,coordinates:{kind:'lookup',memberId:input.member.id,locator:'time',binBounds:false},frame:input.timeScale}],columns:[{id:'id',name:'id',role:'row-identity',datatype:'string',nullable:false,variableLength:false},{id:'segment',name:'segment',role:'time-segment',datatype:'string',nullable:segments.size===1,variableLength:false},{id:'value',name:'value',role:'measurement',datatype:'float64',...(input.unit?{unit:input.unit}:{}),nullable:false,variableLength:false},...(error?[{id:'uncertainty',name:'uncertainty',role:'standard-deviation',datatype:'float64',...(input.unit?{unit:input.unit}:{}),nullable:true,variableLength:false} as const]:[]),...(quality?[{id:'quality',name:'quality',role:'quality',datatype:'integer',nullable:true,variableLength:false} as const]:[])],quantity:{name:input.quantity,semantics:'Irregular sampled time series; gaps and segment identities are retained.',...(input.unit?{unit:input.unit}:{})},calibration:{state:'archive-calibrated',basis:input.calibrationBasis},...(error?{uncertainty:{form:'standard-deviation',columnId:'uncertainty',basis:'Supplied per-sample uncertainty.'} as const}:{}),flags:quality?[{id:'quality',meaning:'Source quality bit field.',columnId:'quality',usableWhen:'Source-specific; zero is not generalized beyond the declared profile.'}]:[],time:{scale:input.timeScale,format:`numeric ${input.timeUnit}`,...(input.referenceEpoch?{referenceEpoch:input.referenceEpoch}:{})},dependencyIds:[]}],dependencies:[],issues:segments.size>1?[{scope:'axis',identity:'time',state:'unknown',reason:'Explicit observing segments contain gaps; no continuity is inferred.'}]:[]});}
const operations=(id:string):FamilyOperation[]=>[['time-series-export','Export time series','exportTimeSeriesCsv',[]],['time-series-plot-data','Prepare time-series plot data','timeSeriesPlotData',[]],['time-series-preview','Render time-series preview','previewTimeSeries',[]],['time-series-select','Select time interval','selectTimeSeries',[{id:'range',option:'--range',kind:'number-list' as const,required:true,count:2,description:'Inclusive time bounds.'}]],['time-series-bin','Bin time series','binTimeSeries',[{id:'bin',option:'--bin',kind:'number-list' as const,required:true,count:2,description:'Explicit bin width and origin.'}]],['time-series-fold','Fold time series','foldTimeSeries',[{id:'fold',option:'--fold',kind:'number-list' as const,required:true,count:2,description:'Explicit epoch and positive period.'}]]].map(([op,label,owner,parameters])=>({id:op as string,label:label as string,handlerId:'f06-time-series',componentId:id,owner:{module:'tools/objects/telescopes/families/f06-time-series.mts',export:owner as string},available:true,reason:'The operation is available only with its explicit parameters.',fixedArguments:{},parameters:[...(parameters as any[]),{id:'out',option:'--out',kind:'output-directory',required:true,description:'New output directory.'}],limitations:['No cadence filling, detrending, binning or folding is implicit.']}));
export const F06_TIME_SERIES_HANDLER:FamilyHandler={id:'f06-time-series',families:['F06'],profiles:[{id:'sampled-time-series-table@1',format:'Sampled time-series table',version:'1',families:['F06'],publicBaseline:true,evidence:[{path:'src/objects/hd-189733/source/photometry/tess/',establishes:'Three pinned real TESS SPOC light-curve FITS files.',status:'complete'},{path:'tools/objects/jwst/compare-light-curves.mts',establishes:'Independent author/deposited light-curve comparisons for selected JWST programs.',status:'complete'}]}],recognizes:members=>members.some(m=>/(?:lc|light.?curve|time.?series).*\.(?:fits|csv)$/iu.test(m.path))?['sampled-time-series-table@1']:[],operations:d=>d.components.filter(c=>c.families.includes('F06')).flatMap(c=>operations(c.id))};
