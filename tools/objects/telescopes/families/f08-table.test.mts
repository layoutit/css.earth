import assert from'node:assert/strict';import{test}from'node:test';import{readFile}from'node:fs/promises';import{resolve}from'node:path';import{member}from'./common.mts';import{describeFitsTable,exportTableCsv,filterTableRows,inspectFitsTable,readFitsTableRows,tableHistogram,tableScatterData}from'./f08-table.mts';
const root=resolve(import.meta.dirname,'../../../..'),path='tests/fixtures/fits/binary-table-columns.fits',bytes=await readFile(resolve(root,path));
test('F08 inspection matches the independent Astropy fixture schema',()=>{const table=inspectFitsTable(bytes,'OI_TEST');assert.equal(table.rows,4);assert.deepEqual(table.columns.slice(0,4).map(c=>[c.name,c.datatype,c.repeat]),[['TIME','float64',1],['VIS2DATA','float32',3],['TARGET_ID','int16',1],['STA_INDEX','int32',2]]);const product=describeFitsTable({id:'oracle-table',member:member('fits',path,'science',bytes,'application/fits'),bytes,extension:'OI_TEST',producingRecord:'tests/oracles/fits/binary-table.json'});assert.equal(product.issues.some(issue=>issue.identity==='SCALED'),true);});
test('F08 reads, filters and exports typed cells without losing nulls or arrays',()=>{const rows=readFitsTableRows(bytes,'OI_TEST',['TARGET_ID','STA_INDEX']);assert.deepEqual(rows[1]!.STA_INDEX,[null,4]);assert.equal(filterTableRows(rows,{column:'TARGET_ID',operator:'gte',value:1}).length,2);assert.match(exportTableCsv(rows.slice(0,1),['TARGET_ID','STA_INDEX']),/^TARGET_ID,STA_INDEX\n1,"\[1,2\]"/u);});
test('F08 numeric views exclude null/vector cells explicitly',()=>{const rows=[{x:1,y:2},{x:2,y:null},{x:[3],y:4}];assert.deepEqual(tableScatterData(rows,'x','y'),[{row:0,x:1,y:2}]);assert.deepEqual(tableHistogram(rows,'x',[0,2,4]).counts,[1,1]);});
test('F08 refuses scaled columns rather than exporting raw stored values',()=>assert.throws(()=>readFitsTableRows(bytes,'OI_TEST'),/scaled/u));
test('F08 inspects and selects columns from a real pinned TESS table',async()=>{const tess=await readFile(resolve(root,'src/objects/hd-189733/source/photometry/tess/tess2021204101404-s0041-0000000256364928-0212-s_lc.fits')),table=inspectFitsTable(tess,'LIGHTCURVE');assert.ok(table.rows>10_000);assert.ok(table.columns.some(column=>column.name==='PDCSAP_FLUX'));const rows=readFitsTableRows(tess,'LIGHTCURVE',['TIME','PDCSAP_FLUX','QUALITY']);assert.equal(rows.length,table.rows);assert.deepEqual(Object.keys(rows[0]!),['TIME','PDCSAP_FLUX','QUALITY']);});
