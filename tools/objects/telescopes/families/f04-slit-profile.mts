export const F04_SLIT_PROFILE_HANDLER:FamilyHandler={id:'f04-slit-profile',families:['F04'],profiles:[{id:'hst-stis-rectified-slit-scan@1',format:'HST STIS rectified two-dimensional slit spectra',version:'Europa 14650 pinned workflow',families:['F04'],publicBaseline:true,evidence:[{path:'tools/objects/hst/programs/europa-salt-map.scan.reproduction.json',establishes:'All 60 pinned STIS frames used across four visits with overlap and published-location diagnostics.',status:'complete'}]}],recognizes:members=>members.some(member=>/\.scan\.json$/u.test(member.path))?['hst-stis-rectified-slit-scan@1']:[],operations:d=>d.components.filter(c=>c.families.includes('F04')).flatMap(c=>operations(c.id))};
