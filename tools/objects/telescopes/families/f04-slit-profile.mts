/** Existing STIS registration values as a typed profile table; this does not synthesize a detector spectrum. */
export function slitProfileTable(definitionValue:unknown,receiptValue:unknown){return slitScanSummary(definitionValue,receiptValue).registration.map(row=>({...row}));}
