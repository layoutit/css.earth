export interface SlitScanEvidence{readonly definition:SlitScanDefinition;readonly pinned:number;readonly used:number;readonly visits:number;readonly exposureSeconds:number;readonly rejected:readonly string[]}
export function inspectSlitScan(definitionValue:unknown,receiptValue:unknown):SlitScanEvidence{const definition=parseSlitScan(definitionValue),receipt=requireRecord(receiptValue,'slit-scan receipt'),frames=requireRecord(receipt.frames,'slit-scan frames'),rejected=requireArray(frames.rejected,'rejected frames').map(String),pinned=requireFiniteNumber(frames.pinned),used=requireFiniteNumber(frames.used),visits=requireFiniteNumber(frames.visits),exposureSeconds=requireFiniteNumber(frames.exposureSeconds);if(![pinned,used,visits,exposureSeconds].every(Number.isSafeInteger)||pinned!==definition.frames.length||used>pinned||visits<1||exposureSeconds<=0)throw new TypeError('Slit-scan receipt does not match its definition.');return{definition,pinned,used,visits,exposureSeconds,rejected};}
