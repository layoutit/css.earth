import assert from 'node:assert/strict';
import { sourceTest } from '../../../tests/objects/source-test.mts';
import { astroqueryToolchain } from '@cssearth/telescope/node';
import type { CapabilityRequest } from './recipe-request.mts';
import { assessFamilyRequest, normalizeFamilyRequest } from './family-request.mts';
import { describeDegreeLinearPolarization, describeStokesFits } from './families/f13-polarimetry.mts';
const test = sourceTest();test.before(async () => { await astroqueryToolchain(); });const legacy:CapabilityRequest={target:'betelgeuse',wavelengthMicrometres:[0.5,0.6]};
const pin=(id:string)=>({id,path:`${id}.fits`,role:'science' as const});
const polar=()=>describeDegreeLinearPolarization({id:'polar',target:'betelgeuse',intensity:pin('intensity'),dolp:pin('dolp'),shape:[2,3],producingRecord:'ESO Phase 3'});
test('legacy capability request is normalized only into criteria applicable to the selected family',()=>{const normalized=normalizeFamilyRequest(legacy);assert.deepEqual(normalized.criteria.spectral?.intervalMicrometres,[0.5,0.6]);assert.equal(normalized.criteria.polarization,undefined);assert.equal(normalizeFamilyRequest(legacy,{family:'F06'}).criteria.spectral,undefined);});
test('family assessment answers only source-backed requested facts',async()=>{const answer=await assessFamilyRequest({legacy,family:'F13',criteria:{quantity:'degree linear polarization',polarization:{components:['degree-linear-polarization']},spatial:true}},polar());assert.equal(answer.scope,'descriptor-compatibility');assert.equal(answer.verdicts.target?.answer,'yes');assert.equal(answer.verdicts.family?.answer,'yes');assert.equal(answer.verdicts.quantity?.answer,'yes');assert.equal(answer.verdicts.polarization?.answer,'yes');assert.equal(answer.verdicts.spectral?.answer,'unknown');assert.equal(answer.verdicts.spatial?.answer,'yes');});
test('explicitly absent Stokes claims and a wrong target are no while omitted time stays absent',async()=>{const answer=await assessFamilyRequest({legacy:{...legacy,target:'mars'},family:'F13',criteria:{polarization:{components:['Q']}}},polar());assert.equal(answer.verdicts.target?.answer,'no');assert.equal(answer.verdicts.polarization?.answer,'no');assert.equal(answer.verdicts.time,undefined);});
test('linked Stokes components satisfy Q and U together without inventing an absent V component',async()=>{const product=describeStokesFits({id:'synthetic-stokes',target:'betelgeuse',member:pin('stokes'),inspection:{shape:[3,2,2],axes:[{id:'axis-0',fitsAxis:3,length:3,role:'stokes',ctype:'STOKES',unit:null},{id:'axis-1',fitsAxis:2,length:2,role:'y',ctype:'DEC--TAN',unit:null},{id:'axis-2',fitsAxis:1,length:2,role:'x',ctype:'RA---TAN',unit:null}],components:{I:0,Q:1,U:2},astropy:'synthetic',conventions:{basis:'synthetic FITS STOKES WCS codes',sign:'synthetic',angle:'undefined'}},producingRecord:'Synthetic descriptor-only inspection'}),retained=await assessFamilyRequest({legacy,family:'F13',criteria:{polarization:{components:['Q','U']}}},product),absent=await assessFamilyRequest({legacy,family:'F13',criteria:{polarization:{components:['V']}}},product),base=polar(),singleton={...base,components:[{...base.components[1]!,dependencyIds:[]}],dependencies:[]},standalone=await assessFamilyRequest({legacy,family:'F13',criteria:{polarization:{components:['degree-linear-polarization']}}},singleton);assert.equal(retained.verdicts.polarization?.answer,'yes');assert.equal(absent.verdicts.polarization?.answer,'unknown');assert.equal(absent.verdicts.component?.answer,'unknown');assert.equal(standalone.verdicts.polarization?.answer,'yes');});
test('typed table criteria reject a known missing column without turning missing tables into negatives',async()=>{const p={...polar(),dataset:{...polar().dataset,families:['F08' as const],profiles:[{handlerId:'f08-table',profileId:'fits-binary-table@1'}]},dependencies:[],components:[{...polar().components[0]!,dependencyIds:[],families:['F08' as const],representation:{kind:'table' as const,rows:1},axes:[],columns:[{id:'flux',name:'flux',role:'measurement',datatype:'float64',nullable:false,variableLength:false}]}],issues:[]};const answer=await assessFamilyRequest({legacy,family:'F08',criteria:{table:{columns:['flux','error']}}},p);assert.equal(answer.verdicts.table?.answer,'no');});
test('time, spectral, table and visibility criteria are assessed from explicit descriptor facts',async()=>{const base=polar(),component={...base.components[0]!,id:'visibility',families:['F12' as const],dependencyIds:[],representation:{kind:'complex-samples' as const,rows:2},axes:[{id:'spectral',index:0,length:2,role:'spectral',unit:'um',coordinates:{kind:'linear' as const,referenceValue:1,referenceIndex:0,increment:0.5}}],columns:[{id:'amp',name:'amplitude',role:'amplitude',datatype:'float64',nullable:false,variableLength:false}],quantity:{name:'complex visibility',semantics:'Calibrated visibility samples.'},time:{scale:'UTC',format:'ISO-8601'}};const product={...base,dataset:{...base.dataset,families:['F12' as const],profiles:[{handlerId:'f12-oifits',profileId:'oifits-observables@1'}]},components:[component],dependencies:[],issues:[]};const answer=await assessFamilyRequest({legacy,family:'F12',criteria:{quantity:'complex visibility',time:true,spectral:{intervalMicrometres:[1,1.5]},table:{columns:['amplitude']},visibility:true}},product);for(const key of ['target','family','quantity','time','spectral','table','visibility'] as const)assert.equal(answer.verdicts[key]?.answer,'yes');});
test('Astropy normalizes spectral units and assessment selects the satisfying component',async()=>{const base=polar(),axis=(unit:string,start:number,increment:number)=>({id:`spectral-${unit}`,index:0,length:2,role:'spectral',unit,coordinates:{kind:'linear' as const,referenceValue:start,referenceIndex:0,increment}}),component=(id:string,a:ReturnType<typeof axis>)=>({...base.components[0]!,id,families:['F02' as const],dependencyIds:[],representation:{kind:'array' as const,shape:[2],storageOrder:'native' as const},axes:[a]});const product={...base,dataset:{...base.dataset,families:['F02' as const],profiles:[{handlerId:'fixture',profileId:'fixture'}]},components:[component('nanometres',axis('nm',500,100)),component('wrong',axis('nm',1,.5))],dependencies:[],issues:[]};const answer=await assessFamilyRequest({legacy,family:'F02',criteria:{spectral:{intervalMicrometres:[.5,.6]}}},product);assert.equal(answer.verdicts.spectral?.answer,'yes');assert.match(answer.verdicts.spectral!.reason,/nanometres/u);});
test('planetary depth criteria distinguish sampling, resolution, inference, and measurement operator',async()=>{const base=polar(),component={...base.components[0]!,families:['F16' as const],dependencyIds:[],representation:{kind:'physical-field' as const,topology:'grid' as const,samples:8},axes:[{id:'delay',index:0,length:8,role:'delay',unit:'us',coordinates:{kind:'linear' as const,referenceValue:0,referenceIndex:0,increment:.0375}}],support:{class:'published-reconstruction' as const,domain:{kind:'full-grid' as const,description:'Published archive grid.',memberIds:['intensity']},unsupportedRegions:[]},depth:{coordinate:'delay' as const,positiveDirection:'down' as const,datum:'reference radius',conversion:{state:'unavailable' as const,parameters:[],uncertainty:'No dielectric model selected.'}},observability:{measurementOperator:'radar-propagation' as const,coverage:{kind:'tracks' as const,description:'Source radar tracks.',memberIds:['intensity']},localization:'inversion-dependent' as const},sampling:{axes:[{axisId:'delay',kind:'regular' as const,interval:.0375,unit:'us',basis:'native coordinate spacing'}]},resolution:{state:'estimated' as const,elements:[{axisId:'delay',range:[.05,.1] as const,unit:'us',description:'published response width'}],basis:'source response analysis',memberIds:['intensity']},inference:{kind:'archive-published' as const,method:'published reconstruction',assumptions:[],validation:'source publication',memberIds:['intensity']}};const product={...base,dataset:{...base.dataset,families:['F16' as const],profiles:[{handlerId:'fixture',profileId:'fixture'}]},components:[component],dependencies:[],issues:[]};const accepted=await assessFamilyRequest({legacy:{...legacy,target:'betelgeuse'},family:'F16',criteria:{support:{classes:['published-reconstruction']},depth:{coordinate:'delay',conversionState:'unavailable'},observability:{measurementOperator:'radar-propagation',localization:'inversion-dependent'},resolution:{states:['estimated'],axisIds:['delay'],maxima:[{axisId:'delay',value:.1,unit:'us'}]},inference:{kinds:['archive-published']}}},product);for(const key of ['support','depth','observability','resolution','inference'] as const)assert.equal(accepted.verdicts[key]?.answer,'yes');const refused=await assessFamilyRequest({legacy:{...legacy,target:'betelgeuse'},family:'F16',criteria:{depth:{coordinate:'geometric-depth'},resolution:{states:['estimated'],maxima:[{axisId:'delay',value:.07,unit:'us'}]}}},product);assert.equal(refused.verdicts.depth?.answer,'no');assert.equal(refused.verdicts.resolution?.answer,'no');const unknown=await assessFamilyRequest({legacy:{...legacy,target:'betelgeuse'},family:'F16',criteria:{resolution:{states:['estimated'],maxima:[{axisId:'delay',value:100,unit:'m'}]}}},product);assert.equal(unknown.verdicts.resolution?.answer,'unknown');});
test('component verdict refuses resolution maxima assembled from opposing component axes',async()=>{const base=polar(),axes=[{id:'projected-x',index:0,length:4,role:'projected-x',unit:'m',coordinates:{kind:'linear' as const,referenceValue:0,referenceIndex:0,increment:1}},{id:'projected-y',index:1,length:4,role:'projected-y',unit:'m',coordinates:{kind:'linear' as const,referenceValue:0,referenceIndex:0,increment:1}}],component=(id:string,x:number,y:number)=>({...base.components[0]!,id,families:['F16' as const],dependencyIds:[],representation:{kind:'physical-field' as const,topology:'grid' as const,samples:16},axes,resolution:{state:'estimated' as const,elements:[{axisId:'projected-x',value:x,unit:'m',description:'x response width'},{axisId:'projected-y',value:y,unit:'m',description:'y response width'}],basis:'fixture response analysis',memberIds:['intensity']}}),product={...base,dataset:{...base.dataset,families:['F16' as const],profiles:[{handlerId:'fixture',profileId:'fixture'}]},components:[component('sharp-x',1,100),component('sharp-y',100,1)],dependencies:[],issues:[]},answer=await assessFamilyRequest({legacy,family:'F16',criteria:{resolution:{states:['estimated'],maxima:[{axisId:'projected-x',value:10,unit:'m'},{axisId:'projected-y',value:10,unit:'m'}]}}},product);assert.equal(answer.verdicts.resolution?.answer,'no');assert.equal(answer.verdicts.component?.answer,'no');assert.equal(answer.selectedComponentId,'sharp-x');});
test('component verdict refuses observed support and geometric depth assembled from different components',async()=>{const base=polar(),observed={...base.components[0]!,id:'observed-delay',families:['F16' as const],dependencyIds:[],representation:{kind:'physical-field' as const,topology:'grid' as const,samples:4},axes:[{id:'delay',index:0,length:4,role:'delay',unit:'us',coordinates:{kind:'linear' as const,referenceValue:0,referenceIndex:0,increment:1}}],support:{class:'observed-samples' as const,domain:{kind:'tracks' as const,description:'Observed source tracks.',memberIds:['intensity']},unsupportedRegions:[]},depth:{coordinate:'delay' as const,positiveDirection:'down' as const,datum:'surface echo',conversion:{state:'unavailable' as const,parameters:[],uncertainty:'No conversion.'}}},geometric={...base.components[0]!,id:'geometric-model',families:['F16' as const],dependencyIds:[],representation:{kind:'physical-field' as const,topology:'grid' as const,samples:4},axes:[{id:'geometric-depth',index:0,length:4,role:'geometric-depth',unit:'m',coordinates:{kind:'linear' as const,referenceValue:0,referenceIndex:0,increment:1}}],support:{class:'published-reconstruction' as const,domain:{kind:'full-grid' as const,description:'Reconstructed field.',memberIds:['intensity']},unsupportedRegions:[]},depth:{coordinate:'geometric-depth' as const,positiveDirection:'down' as const,datum:'fixture surface',conversion:{state:'native' as const,parameters:[],uncertainty:'fixture native coordinate'}},inference:{kind:'archive-published' as const,method:'fixture inversion',assumptions:[],validation:'fixture',memberIds:['intensity']}},product={...base,dataset:{...base.dataset,families:['F16' as const],profiles:[{handlerId:'fixture',profileId:'fixture'}]},components:[observed,geometric],dependencies:[],issues:[]},answer=await assessFamilyRequest({legacy,family:'F16',criteria:{support:{classes:['observed-samples']},depth:{coordinate:'geometric-depth'}}},product);assert.equal(answer.verdicts.support?.answer,'yes');assert.equal(answer.verdicts.depth?.answer,'no');assert.equal(answer.verdicts.component?.answer,'no');assert.equal(answer.selectedComponentId,'observed-delay');});
