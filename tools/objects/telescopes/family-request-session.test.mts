import assert from 'node:assert/strict';import test from 'node:test';import {mkdtemp,readFile,rm} from 'node:fs/promises';import {tmpdir} from 'node:os';import {resolve} from 'node:path';import {saveFamilyRequestSession} from './session.mts';import {describeDegreeLinearPolarization} from './families/f13-polarimetry.mts';import {parseCli} from './cli.mts';
const pin=(id:string)=>({id,path:`${id}.fits`,role:'science' as const});
const descriptor=()=>describeDegreeLinearPolarization({id:'polar',intensity:pin('intensity'),dolp:pin('dolp'),shape:[2,3],producingRecord:'ESO'});
test('family session persists original request and a source-backed unresolved assessment',async()=>{const directory=await mkdtemp(resolve(tmpdir(),'family-request-'));try{const saved=await saveFamilyRequestSession(directory,{legacy:{target:'betelgeuse',wavelengthMicrometres:[.5,.6]},family:'F13',criteria:{polarization:{components:['degree-linear-polarization']}}},descriptor());assert.equal(saved.status,'unresolved');assert.equal(saved.original.legacy.target,'betelgeuse');assert.equal(saved.assessment.verdicts.polarization?.answer,'yes');assert.equal(JSON.parse(await readFile(resolve(directory,'family-request.json'),'utf8')).schema,'cssearth-telescope-family-request@1');}finally{await rm(directory,{recursive:true,force:true});}});
test('family session refuses a descriptor for the wrong target and never calls structural compatibility fulfilled',async()=>{const directory=await mkdtemp(resolve(tmpdir(),'family-target-'));try{const saved=await saveFamilyRequestSession(directory,{legacy:{target:'mars',wavelengthMicrometres:[.5,.6]},family:'F13',criteria:{polarization:{components:['degree-linear-polarization']}}},{...descriptor(),dataset:{...descriptor().dataset,target:'betelgeuse'}});assert.equal(saved.status,'refused');assert.equal(saved.assessment.scope,'descriptor-compatibility');assert.equal((saved as{status:string}).status==='fulfilled',false);}finally{await rm(directory,{recursive:true,force:true});}});
test('family-assess CLI is deterministic and has its own saved-request entry',()=>{const parsed=parseCli(['family-assess','request.json','descriptor.json','--out','run','--json']);assert.equal(parsed.command,'family-assess');if(parsed.command==='family-assess'){assert.equal(parsed.request,resolve('request.json'));assert.equal(parsed.descriptor,resolve('descriptor.json'));assert.equal(parsed.directory,resolve('run'));assert.equal(parsed.json,true);}});
