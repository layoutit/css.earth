async function assessComponent(product:ProductDescriptor,request:NormalizedFamilyRequest):Promise<{readonly verdict?:ConstraintVerdict;readonly selectedComponentId?:string;readonly verdicts?:Partial<Record<FamilyCriterionName,ConstraintVerdict>>}> {
  const names=(Object.keys(request.criteria) as FamilyCriterionName[]).filter(name=>request.criteria[name as keyof FamilyCriteria]!==undefined);
  if(!names.length)return{};
  const candidates=await Promise.all(requestedComponents(product,request.family).map(async component=>({id:component.id,verdicts:await assessScientificCriteria({...product,components:[component]},request,linkedPolarizationGroups(product,component))})));
  const selected=candidates.find(candidate=>names.every(name=>candidate.verdicts[name]?.answer==='yes'));
  if(selected)return{selectedComponentId:selected.id,verdicts:selected.verdicts,verdict:verdict('yes',`Component ${selected.id} satisfies every requested component-scoped scientific criterion.`)};
  const score=(candidate:typeof candidates[number])=>[names.filter(name=>candidate.verdicts[name]?.answer==='no').length,names.filter(name=>candidate.verdicts[name]?.answer==='unknown').length] as const,best=candidates.reduce<typeof candidates[number]|undefined>((chosen,candidate)=>{if(!chosen)return candidate;const[a,b]=score(chosen),[c,d]=score(candidate);return c<a||c===a&&d<b?candidate:chosen;},undefined),answer=candidates.length&&candidates.every(candidate=>score(candidate)[0]>0)?'no':'unknown';
  return{verdicts:best?.verdicts,selectedComponentId:best?.id,verdict:verdict(answer,answer==='no'?'No single applicable component satisfies every requested scientific criterion.':'No single applicable component establishes every requested scientific criterion.')};
}
/** Assess only requested criteria. Descriptor absence is unknown unless the descriptor explicitly rules the fact out. */
export async function assessFamilyRequest(input:FamilyScientificRequest,descriptorValue:unknown):Promise<FamilyRequestAssessment>{
  const request=normalizeFamilyRequest(input.legacy,{family:input.family,criteria:input.criteria}),product=parseProductDescriptor(descriptorValue),out:Partial<Record<FamilyAssessmentVerdictName,ConstraintVerdict>>={};
  out.target=product.dataset.target===undefined?verdict('unknown','The descriptor does not declare a target.'):norm(product.dataset.target)===norm(request.legacy.target)?verdict('yes','Descriptor target matches the requested target.'):verdict('no',`Descriptor target ${product.dataset.target} does not match requested target ${request.legacy.target}.`);
  if(request.family)out.family=product.dataset.families.includes(request.family)?verdict('yes',`Descriptor declares ${request.family}.`):verdict('no',`Descriptor families are ${product.dataset.families.join(', ')}.`);
  const component=await assessComponent(product,request);
  Object.assign(out,component.verdicts);
  if(component.verdict)out.component=component.verdict;
  return{scope:'descriptor-compatibility',request,...(component.selectedComponentId?{selectedComponentId:component.selectedComponentId}:{}),verdicts:out};
}
