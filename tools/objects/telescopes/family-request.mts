  if(c.polarization!==undefined)out.polarization=evaluatePolarizationGroups(product,polarizationGroups,c.polarization.components);
  if(c.visibility!==undefined)out.visibility=product.components.some(component=>component.representation.kind==='complex-samples'||/visibility/i.test(component.quantity.name))?verdict('yes','A retained component declares visibility samples.'):verdict('unknown','No retained component establishes complex visibility samples.');
  if(c.support!==undefined)out.support=evaluateSupport(product,request.family,c.support.classes);
  if(c.depth!==undefined)out.depth=evaluateDepth(product,request.family,c.depth);
  if(c.observability!==undefined)out.observability=evaluateObservability(product,request.family,c.observability);
  if(c.resolution!==undefined)out.resolution=evaluateResolution(product,request.family,c.resolution);
  if(c.inference!==undefined)out.inference=evaluateInference(product,request.family,c.inference);
