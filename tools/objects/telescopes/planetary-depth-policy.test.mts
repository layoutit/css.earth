import assert from'node:assert/strict';import test from'node:test';import type{ProductComponent}from'./product-descriptor.mts';import{planetaryOutputPolicy,requirePlanetaryOutput}from'./planetary-depth-policy.mts';
const axis=(id:string,index:number)=>({id,index,length:4,role:id,unit:id==='delay'?'us':'m',coordinates:{kind:'linear' as const,referenceValue:0,referenceIndex:0,increment:1},reference:`${id} datum`,derivation:{state:'archive-derived' as const,assumptions:[]}});
const component=(coordinate:'delay'|'geometric-depth'|'pressure'='delay'):ProductComponent=>({id:'field',name:'field',families:['F16'],locations:[{memberId:'science'}],representation:{kind:'physical-field',topology:'grid',samples:64},axes:[axis('projected-x',0),axis('projected-y',1),axis(coordinate,2)],columns:[],quantity:{name:'return strength',unit:'1',semantics:'fixture'},calibration:{state:'reconstructed',basis:['fixture']},uncertainty:{form:'unknown',basis:'fixture'},flags:[],frame:{kind:'body-fixed',name:'fixture'},support:{class:'published-reconstruction',domain:{kind:'full-grid',description:'fixture',memberIds:['science']},unsupportedRegions:[]},depth:{coordinate,positiveDirection:'down',datum:'fixture',conversion:{state:coordinate==='delay'?'unavailable':'native',parameters:[],uncertainty:'fixture'}},observability:{measurementOperator:coordinate==='pressure'?'microwave-radiative-transfer':'radar-propagation',coverage:{kind:'tracks',description:'fixture',memberIds:['coverage']},localization:'inversion-dependent'},sampling:{axes:[{axisId:'projected-x',kind:'regular',interval:1,unit:'m',basis:'fixture'},{axisId:'projected-y',kind:'regular',interval:1,unit:'m',basis:'fixture'},{axisId:coordinate,kind:'regular',interval:1,unit:coordinate==='delay'?'us':'m',basis:'fixture'}]},resolution:{state:'unknown',elements:[],basis:'Grid spacing is not resolution evidence.',memberIds:[]},inference:{kind:'archive-published',method:'fixture reconstruction',assumptions:[],validation:'fixture',memberIds:['provenance']},dependencyIds:[]});
test('delay grid exposes native scientific views but refuses body attachment',()=>{const decisions=planetaryOutputPolicy(component()),available=(id:string)=>decisions.find(value=>value.output===id)?.available;assert.equal(available('native'),true);assert.equal(available('slice'),true);assert.equal(available('profile'),true);assert.equal(available('isosurface'),true);assert.equal(available('interactive-html'),true);assert.equal(available('body-attachment'),false);assert.throws(()=>requirePlanetaryOutput(component(),'body-attachment'),/delay is not a body-placement coordinate/u);});
test('qualified geometric depth permits attachment while pressure remains a profile coordinate',()=>{assert.equal(planetaryOutputPolicy(component('geometric-depth')).find(value=>value.output==='body-attachment')?.available,true);assert.equal(planetaryOutputPolicy(component('pressure')).find(value=>value.output==='body-attachment')?.available,false);});
test('sparse rays expose coverage without inventing slices or an observed volume',()=>{const sparse={...component(),representation:{kind:'table' as const,rows:12},axes:[axis('path-distance',0),axis('delay',1)],columns:[],support:{class:'observed-samples' as const,domain:{kind:'rays' as const,description:'sampled chords',memberIds:['coverage']},unsupportedRegions:[{kind:'unobserved' as const,description:'all unsampled interior'}]},observability:{measurementOperator:'radar-propagation' as const,coverage:{kind:'rays' as const,description:'sampled chords',memberIds:['coverage']},localization:'non-unique' as const},sampling:{axes:[{axisId:'path-distance',kind:'regular' as const,interval:1,unit:'m',basis:'fixture'},{axisId:'delay',kind:'regular' as const,interval:1,unit:'us',basis:'fixture'}]},inference:undefined};const decisions=planetaryOutputPolicy(sparse);assert.equal(decisions.find(value=>value.output==='coverage')?.available,true);assert.equal(decisions.find(value=>value.output==='interactive-html')?.available,true);assert.equal(decisions.find(value=>value.output==='slice')?.available,false);assert.equal(decisions.find(value=>value.output==='body-attachment')?.available,false);});
test('sampling cannot stand in for omitted resolution evidence',()=>{const {resolution:_,...withoutResolution}=component();const decisions=planetaryOutputPolicy(withoutResolution);assert.equal(decisions.every(value=>!value.available),true);assert.match(decisions[0]!.reason,/sampling cannot substitute/u);});
test('microwave channels cannot become an observed pressure profile',()=>{const pressure={...component('pressure'),support:{class:'observed-samples' as const,domain:{kind:'profiles' as const,description:'channels',memberIds:['science']},unsupportedRegions:[]},inference:undefined};const decisions=planetaryOutputPolicy(pressure);assert.equal(decisions.every(value=>!value.available),true);assert.match(decisions[0]!.reason,/requires an explicit retrieval/u);});
test('non-unique gravity models may attach only with an inference label',()=>{const base=component('geometric-depth'),model={...base,support:{...base.support!,class:'model-ensemble' as const},observability:{measurementOperator:'gravity-integral' as const,coverage:{kind:'angles' as const,description:'integral observations',memberIds:['coverage']},localization:'non-unique' as const},inference:{kind:'published-result' as const,method:'published posterior ensemble',assumptions:[],validation:'published comparison',memberIds:['provenance']}};const attached=planetaryOutputPolicy(model).find(value=>value.output==='body-attachment')!;assert.equal(attached.available,true);assert.match(attached.labelRequirement!,/inferred model or ensemble/u);const falseLocalization={...model,observability:{...model.observability,localization:'direct' as const}};assert.match(planetaryOutputPolicy(falseLocalization)[0]!.reason,/must retain non-unique/u);});
