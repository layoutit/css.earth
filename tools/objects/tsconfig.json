{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": [
      "../../node_modules/.pnpm/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "tsBuildInfoFile": "../../output/tsbuildinfo/preparation.tsbuildinfo"
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "../../src/preparation/**/*.ts",
    "../external-modules.d.mts",
    "../../site/env.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "dist",
    "tsup.config.ts",
    "../../src/**/*.test.ts"
  ]
}
