{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": [
      "../../node_modules/.pnpm/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "../../src/preparation/**/*.ts",
    "../../src/renderers/css/preparation/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "dist",
    "tsup.config.ts",
    "../../src/**/*.test.ts"
  ]
}
