{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "typeRoots": ["../node_modules/.pnpm/node_modules/@types"],
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "../output/tsbuildinfo/ownership.tsbuildinfo"
  },
  "include": ["typescript-ownership.mts", "typescript-ownership.test.mts"]
}
