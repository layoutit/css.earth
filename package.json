{
  "name": "cssearth",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "acquire:planets": "node tools/run-implemented-planets.mts acquire",
    "analyze:trace:saturn": "node tests/objects/browser/saturn/audit/analyze-user-trace.mts",
    "assemble:planets": "node tools/run-implemented-planets.mts assemble",
    "author:sources": "node tools/author-source-records.mts",
    "benchmark:payloads": "node tools/measure-object-payloads.mts",
    "build": "astro build && node tools/build-catalogue-fragment.mts && pnpm assemble:planets",
    "build:deploy": "pnpm prepare:deploy && astro build && node tools/build-catalogue-fragment.mts && pnpm assemble:planets",
    "build:astronomy": "pnpm --filter @cssearth/astronomy build",
    "build:catalog": "pnpm --filter @cssearth/catalog build",
    "build:engine": "pnpm --filter @cssearth/engine build",
    "build:objects": "pnpm --filter @cssearth/objects build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "build:performance": "CSSEARTH_PERFORMANCE_SOURCEMAPS=1 pnpm prebuild && astro build --mode performance && node tools/build-catalogue-fragment.mts && pnpm assemble:planets",
    "build:preparation": "pnpm prepare:titles && pnpm --filter @cssearth/engine exec tsup --config ../../tools/objects/tsup.config.ts && pnpm prepare:world-context && pnpm prepare:shell",
    "build:renderer": "pnpm --filter @cssearth/engine exec tsup --config ../../src/renderers/css/tsup.config.ts",
    "build:tools": "pnpm build:packages && pnpm build:renderer && pnpm prepare:catalog && node tools/prepare-solar-geometry.mts && node tools/prepare-navigation.mts --catalog-only && pnpm build:preparation",
    "check:assets-published": "node tools/check-assets-published.mts",
    "check:deploy-assets": "node tools/check-deploy-assets.mts",
    "check:ci": "node tools/check-ci.mts",
    "check:pr": "node tools/check-ci.mts --job=lint",
    "check:environment": "node tools/check-environment.mts",
    "check:nebula-boundaries": "node tools/nebula/package-boundaries.mts",
    "check:typescript-ownership": "node tools/typescript-ownership.mts",
    "cite:facts": "node tools/cite-pinned-facts.mts",
    "dev": "astro dev --host 127.0.0.1 --port 4210",
    "hooks:install": "git config core.hooksPath .githooks",
    "investigations": "node tools/report-investigations.mts",
    "investigations:index": "node tools/report-investigations.mts --index --write",
    "lab:nebula": "pnpm lab:nebula:bake --stage=assets && vite --config labs/nebula/vite.config.ts --host 127.0.0.1 --port 4331 --strictPort",
    "lab:nebula:bake": "node --experimental-strip-types labs/nebula/run.mts bake-nebula",
    "lab:nebula:catalogue": "node --experimental-strip-types labs/nebula/run.mts inventory-messier",
    "lab:nebula:catalogue:enrich": "node --experimental-strip-types labs/nebula/run.mts enrich-messier-catalogue",
    "lab:nebula:coherent": "node --experimental-strip-types labs/nebula/run.mts prepare-coherent",
    "lab:nebula:density": "node --experimental-strip-types labs/nebula/run.mts prepare-full-density labs/nebula/models/full-density.json",
    "lab:nebula:extract": "node --experimental-strip-types labs/nebula/run.mts extract",
    "lab:nebula:full-density": "node --experimental-strip-types labs/nebula/run.mts prepare-full-density labs/nebula/models/full-density.json",
    "lab:nebula:getsf": "node --experimental-strip-types labs/nebula/run.mts getsf-run labs/nebula/models/structure-benchmark.json",
    "lab:nebula:images": "node --experimental-strip-types labs/nebula/run.mts acquire-images labs/nebula/sources/reference-images.json",
    "lab:nebula:master": "node --experimental-strip-types labs/nebula/run.mts prepare-master",
    "lab:nebula:overlays": "node --experimental-strip-types labs/nebula/run.mts prepare-overlays labs/nebula/models/image-candidates.json",
    "lab:nebula:particles": "node --experimental-strip-types labs/nebula/run.mts prepare-particles",
    "lab:nebula:structures": "node --experimental-strip-types labs/nebula/run.mts prepare-structures labs/nebula/models/structure-benchmark.json",
    "lab:nebula:verify": "node --experimental-strip-types labs/nebula/run.mts verify-nebula",
    "lint:packages": "eslint packages --max-warnings 0",
    "oracle:venus": "node tools/oracles/venus/run.mts",
    "oracles:run": "node tools/oracles/run.mts",
    "oracles:setup": "node tools/oracles/setup.mts",
    "perf:trace": "node tools/performance/trace-brief.mts",
    "pin:documents": "node tools/pin-object-documents.mts",
    "postinstall": "pnpm build:tools",
    "prebuild": "pnpm build:tools && pnpm setup:assets && pnpm prepare:object-json && pnpm prepare:environment-images && pnpm prepare:nebulae && pnpm prepare:minimap && pnpm prepare:galaxy-field",
    "predev": "pnpm build:tools && pnpm prepare:object-json && pnpm prepare:environment-images && pnpm prepare:minimap && pnpm prepare:galaxy-field",
    "prepare:catalog": "node tools/prepare-catalog.mts",
    "prepare:checkout": "node tools/restore-source-inputs.mts && pnpm prepare:planets",
    "prepare:deploy": "pnpm build:tools && pnpm setup:assets && pnpm prepare:object-json && pnpm prepare:environment-images && node tools/nebula/prepare.mts --if-missing && pnpm prepare:minimap && pnpm prepare:deploy-catalogues",
    "prepare:deploy-catalogues": "node tools/prepare-facilities.mts --catalog-only",
    "prepare:earth-global": "node tools/objects/geographic-pages/operations/prepare-global-wmts.mts --object=earth && node tools/objects/geographic-pages/operations/integrate-global-wmts.mts --object=earth --latest",
    "prepare:environment-images": "node tools/objects/dist/restore-environment-images.js",
    "prepare:factsheets": "node tools/prepare-factsheets.mts",
    "prepare:galaxy-catalog": "node tools/objects/dist/prepare-galaxy-catalog.js src/objects/local-group",
    "prepare:galaxy-field": "pnpm prepare:galaxy-field:data && node tools/prepare-provenance.mts",
    "prepare:galaxy-field:data": "node tools/galaxy-field/acquire.mts && node tools/galaxy-field/prepare-points.mts",
    "prepare:icons": "node tools/prepare-shell-icons.mts",
    "prepare:image-layers": "node tools/objects/dist/prepare-image-layers.js",
    "prepare:facility-photographs": "node tools/prepare-facility-photographs.mts",
    "prepare:facility-renders": "node tools/prepare-facility-renders.mts",
    "prepare:facilities": "node tools/prepare-provenance.mts",
    "prepare:minimap": "node site/minimap/prepare.mts",
    "prepare:moon-labels": "node tools/prepare-moon-labels.mts",
    "prepare:navigation": "node tools/prepare-navigation.mts",
    "prepare:nebulae": "node tools/nebula/prepare.mts --if-missing && node tools/prepare-facilities.mts",
    "prepare:object-json": "node tools/restore-object-json.mts && pnpm prepare:world-context && node tools/prepare-feature-index.mts",
    "prepare:overview-titles": "node tools/prepare-overview-titles.mts",
    "prepare:planet-info": "node tools/prepare-planet-information.mts",
    "prepare:planet-title-sources": "node tools/prepare-planet-title-sources.mts",
    "prepare:planets": "pnpm prepare:catalog && pnpm build:astronomy && node tools/prepare-solar-geometry.mts && pnpm build:catalog && node tools/prepare-planets.mts && node tools/prepare-feature-index.mts",
    "prepare:planets:full": "pnpm prepare:planets --force",
    "prepare:provenance": "node tools/prepare-provenance.mts",
    "prepare:scientific-charts": "node tools/prepare-scientific-charts.mts",
    "prepare:shell": "node tools/restore-title-font.mts && pnpm prepare:catalog && pnpm prepare:titles && pnpm prepare:icons && pnpm prepare:wordmark && pnpm prepare:overview-titles",
    "prepare:sidebar-thumbnails": "node tools/prepare-sidebar-thumbnails.mts",
    "prepare:social": "node tools/prepare-social-images.mts",
    "prepare:solar-geometry": "pnpm build:astronomy && node tools/prepare-solar-geometry.mts",
    "prepare:sources": "node tools/prepare-provenance.mts",
    "prepare:stars": "node tools/objects/dist/prepare-stars.js",
    "prepare:surface-minimaps": "node tools/prepare-surface-minimaps.mts",
    "prepare:surface-shell": "node tools/objects/dist/prepare-shell.js",
    "prepare:text": "node tools/prepare-text.mts",
    "prepare:titles": "node tools/prepare-shell-titles.mts",
    "prepare:universe": "pnpm build:preparation && pnpm prepare:volume src/objects/milky-way && pnpm prepare:stars src/objects/stellar-neighbourhood && pnpm prepare:surface-shell src/objects/heliosphere && pnpm prepare:world-context",
    "prepare:volume": "node tools/objects/dist/prepare-volume.js",
    "prepare:wordmark": "node tools/prepare-wordmark-rail.mts",
    "prepare:world-context": "node tools/objects/dist/prepare-spatial-context.js src/objects/sun/source/navigation/universe.json src/objects/sun/prepared/world-context.json && pnpm prepare:moon-labels",
    "prepare:world-context:author": "node tools/objects/dist/prepare-spatial-context.js src/objects/sun/source/navigation/universe.json src/objects/sun/prepared/world-context.json --pin-references && pnpm prepare:moon-labels",
    "pretest": "pnpm prepare:shell",
    "preview": "node tools/preview.mts",
    "preview:native-scroll": "node tools/experiments/native-scroll/run.mts",
    "publish:earth-city": "node tools/objects/geographic-pages/operations/publish-city-pages.mts --object=earth",
    "publish:earth-city-face": "node tools/objects/geographic-pages/operations/publish-global-city-face.mts --object=earth",
    "publish:earth-global": "node tools/objects/geographic-pages/operations/publish-global-wmts.mts --object=earth",
    "publish:runtime-assets": "node tools/publish-runtime-assets.mts",
    "refresh:earth-enso": "node tools/objects/paged-ellipsoid/refresh-earth-enso.mts && node tools/objects/dist/prepare-authored.js earth --write && node tools/prepare-text.mts earth",
    "setup:assets": "pnpm prepare:shell && node tools/setup.mts && node tools/setup-prepared.mts && node tools/setup-volume-metadata.mts",
    "setup:prepared": "node tools/setup-prepared.mts",
    "setup:volume-metadata": "node tools/setup-volume-metadata.mts",
    "status:earth-city-global": "node tools/objects/geographic-pages/operations/status-global-city.mts --object=earth",
    "telescope:publish-map": "node tools/run-typed-module.mjs tools/objects/body-map-publication.mts",
    "telescope:query": "node tools/run-typed-module.mjs tools/objects/telescopes/query.mts",
    "telescope:qualify": "node tools/run-typed-module.mjs tools/objects/telescopes/qualify.mts",
    "telescope:setup-archives": "node tools/run-typed-module.mjs tools/objects/astronomy-packages/toolchain.mts install",
    "telescope:setup-pds": "node tools/run-typed-module.mjs tools/objects/astronomy-packages/pds-toolchain.mts install",
    "telescope:verify-associations": "node tools/run-typed-module.mjs tools/objects/hst/target-associations.mts",
    "telescope:discover": "node tools/run-typed-module.mjs tools/objects/pds/discover.mts",
    "test": "pnpm test:packages && pnpm test:renderer && pnpm test:platform && pnpm test:shell && pnpm test:preparation --universe && pnpm test:lab:nebula",
    "test:browser": "node site/test/dom-cleanliness-browser.mts",
    "test:browser:all": "node tools/run-browser-suites.mts",
    "test:browser:conformance": "node site/test/planet-browser-conformance.mts",
    "test:browser:datasets": "node site/test/dataset-navigation-browser.mts",
    "test:browser:flight": "node site/test/flight-registry-browser.mts",
    "test:browser:galaxy-handoff": "node site/test/galaxy-handoff-browser.mts",
    "test:browser:interaction-chain": "node site/test/interaction-chain-browser.mts",
    "test:browser:mercury-rotation": "node tests/objects/browser/mercury/rotation-limits-browser.mts",
    "test:browser:native-scroll": "node site/test/native-scroll-browser.mts && node site/test/native-scroll-touch-browser.mts",
    "test:browser:navigation-stress": "node site/test/navigation-stress-browser.mts",
    "test:browser:navigation-stress:matrix": "node site/test/navigation-stress-matrix.mts",
    "test:browser:navigation-residency-ab": "node site/test/navigation-residency-ab-browser.mts",
    "test:browser:nebula": "node --experimental-strip-types labs/nebula/run.mts browser-coherent",
    "test:browser:nebula-density": "node --experimental-strip-types labs/nebula/run.mts browser-density",
    "test:browser:nebula-overlays": "node --experimental-strip-types labs/nebula/run.mts browser-overlays",
    "test:browser:ontology": "node site/test/navigation-ontology-browser.mts",
    "test:browser:typescript-owners": "node site/test/typescript-owners-browser.mts",
    "test:browser:universe": "node site/test/universe-environments-browser.mts",
    "test:browser:universe-performance-ab": "node site/test/universe-performance-ab-browser.mts",
    "test:browser:universe-labels": "node site/test/universe-labels-browser.mts",
    "test:browser:view-url": "node site/test/view-url-browser.mts",
    "test:earth-delivery": "node tests/objects/browser/earth/global-delivery-browser.mts",
    "test:earth-global": "node tests/objects/browser/earth/wmts-tree-browser.mts --global",
    "test:fits": "node tools/oracles/test-fits.mts",
    "test:galaxy-field": "pnpm prepare:galaxy-field && node --test tools/galaxy-field/*.test.mts tools/context-provenance.test.mts",
    "test:lab:nebula": "pnpm lab:nebula:bake --stage=assets && node --experimental-strip-types labs/nebula/run.mts test",
    "test:objects": "node --test \"tests/objects/unit/**/*.test.mts\"",
    "test:packages": "pnpm -r --filter \"./packages/**\" test",
    "test:performance-tools": "node --test tools/performance/*.test.mts",
    "test:planets": "node tools/run-implemented-planets.mts test",
    "test:platform": "node --test src/platform/*.test.mts src/navigation/*.test.mts tools/*.test.mts tools/photometry/*.test.mts",
    "test:preparation": "node tools/test-preparation.mts",
    "test:renderer": "pnpm --filter @cssearth/engine exec vitest run --root ../../src/renderers/css --exclude \"**/preparation/**\"",
    "test:sbmt": "node tools/oracles/test-sbmt.mts",
    "test:seo": "node site/test/seo-browser.mts",
    "test:shell": "pnpm prepare:environment-images && pnpm prepare:nebulae && node --test site/test/*.test.mts",
    "test:shell:router": "node --experimental-test-module-mocks --import ./site/test/navigation-router-context.mts --test site/test/navigation-lifecycle.test.mts site/test/scene-session.test.mts site/test/navigation-router.test.mts site/test/router-runtime.test.mts",
    "test:sources": "pnpm prepare:catalog && pnpm prepare:sources && node --test src/platform/source-manifest.test.mts src/platform/source-catalog.test.mts src/platform/exploration-catalog.test.mts tools/source-catalogue.test.mts tools/object-provenance.test.mts tools/factsheet-sources.test.mts tools/prepare-factsheets.test.mts site/test/dataset-facilities.test.mts site/test/scene-sources.test.mts tools/objects/surface-observations/recipes.test.mts tools/nebula-provenance-contract.test.mts",
    "test:typescript-ownership": "node --test tools/typescript-ownership.test.mts",
    "trace:saturn": "node tests/objects/browser/saturn/audit/trace.mts",
    "typecheck": "pnpm typecheck:pr && pnpm typecheck:tests && pnpm typecheck:nebula",
    "typecheck:astro": "astro check --tsconfig site/astro.tsconfig.json",
    "typecheck:browser-owners": "pnpm --filter @cssearth/engine exec tsc -p ../../site/test/typescript-owners.tsconfig.json",
    "typecheck:configs": "tsc -p tsconfig.configs.json",
    "typecheck:nebula": "pnpm exec tsc -p labs/nebula/tsconfig.json && pnpm -r --filter \"./labs/nebula/packages/**\" typecheck && node tools/nebula/typecheck.mts",
    "typecheck:oracles": "tsc -p tools/oracles/tsconfig.json",
    "typecheck:ownership": "pnpm --filter @cssearth/engine exec tsc -p ../../tools/typescript-ownership.tsconfig.json",
    "typecheck:packages": "pnpm -r --filter \"./packages/**\" typecheck",
    "typecheck:platform": "tsc -p src/platform/tsconfig.json",
    "typecheck:pr": "pnpm typecheck:configs && pnpm typecheck:packages && pnpm typecheck:renderer && pnpm typecheck:platform && pnpm typecheck:preparation && pnpm typecheck:tools && pnpm typecheck:astro && pnpm typecheck:ownership",
    "typecheck:preparation": "pnpm --filter @cssearth/engine exec tsc -p ../../tools/objects/tsconfig.json",
    "typecheck:renderer": "pnpm --filter @cssearth/engine exec tsc -p ../../src/renderers/css/tsconfig.json",
    "typecheck:shell": "pnpm --filter @cssearth/engine exec tsc -p ../../site/tsconfig.json",
    "typecheck:tests": "node tools/typecheck-tests.mts",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "verify:earth-delivery": "node tools/objects/geographic-pages/operations/verify-global-wmts-delivery.mts --object=earth",
    "telescope": "node tools/run-typed-module.mjs tools/objects/telescopes/cli.mts"
  },
  "dependencies": {
    "@cesium/engine": "26.3.0",
    "@layoutit/polycss": "0.2.11",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cssearth/astronomy": "workspace:*",
    "@cssearth/catalog": "workspace:*",
    "@cssearth/engine": "workspace:*",
    "@cssearth/objects": "workspace:*",
    "@types/fontkit": "2.0.9",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@typescript-eslint/parser": "^8.69.0",
    "astro": "^7.2.4",
    "classic-level": "3.0.0",
    "cwebp-bin": "8.0.0",
    "esbuild": "0.27.7",
    "eslint": "^10.10.0",
    "fontkit": "2.0.4",
    "geotiff": "3.0.5",
    "h5wasm": "0.10.3",
    "meshoptimizer": "1.2.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.60.0",
    "pngjs": "7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robust-predicates": "3.0.3",
    "sharp": "0.35.3",
    "source-map-js": "1.2.1",
    "stream-json": "^3.6.0",
    "three": "0.180.0",
    "typescript": "5.9.3",
    "undici": "7.29.1",
    "vite": "7.3.1",
    "yaml": "^2.9.0",
    "@cssearth/volume-core": "workspace:*",
    "@cssearth/volume-bake": "workspace:*",
    "@cssearth/nebula-lab": "workspace:*",
    "@cssearth/nebula-reconstruction": "workspace:*",
    "@cssearth/volume-viewer": "workspace:*"
  }
}
