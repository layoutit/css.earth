{
  "name": "cssearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "setup:assets": "node tools/setup.mts",
    "publish:runtime-assets": "node tools/publish-runtime-assets.mts",
    "dev": "astro dev --host 127.0.0.1 --port 4210",
    "postinstall": "pnpm build:packages && pnpm build:renderer && pnpm build:preparation && pnpm prepare:object-json && pnpm prepare:minimap",
    "build:astronomy": "pnpm --filter @cssearth/astronomy build",
    "build:catalog": "pnpm --filter @cssearth/catalog build",
    "build": "astro build && pnpm assemble:planets",
    "acquire:planets": "node tools/run-implemented-planets.mts acquire",
    "assemble:planets": "node tools/run-implemented-planets.mts assemble",
    "prepare:checkout": "node tools/restore-source-inputs.mts && pnpm prepare:planets",
    "preview": "node tools/preview.mts",
    "prepare:planet-info": "node tools/prepare-planet-information.mts",
    "prepare:factsheets": "node tools/prepare-factsheets.mts",
    "prepare:navigation": "node tools/prepare-navigation.mts",
    "prepare:planet-title-sources": "node tools/prepare-planet-title-sources.mts",
    "prepare:overview-titles": "node tools/prepare-overview-titles.mts",
    "prepare:titles": "node tools/prepare-shell-titles.mts",
    "prepare:icons": "node tools/prepare-shell-icons.mts",
    "prepare:wordmark": "node tools/prepare-wordmark-rail.mts",
    "prepare:scientific-charts": "node tools/prepare-scientific-charts.mts",
    "prepare:shell": "pnpm prepare:titles && pnpm prepare:icons && pnpm prepare:wordmark",
    "prepare:solar-geometry": "pnpm build:astronomy && node tools/prepare-solar-geometry.mts",
    "prepare:planets": "pnpm prepare:catalog && pnpm build:astronomy && node tools/prepare-solar-geometry.mts && pnpm build:catalog && node tools/prepare-planets.mts",
    "prepare:planets:full": "pnpm prepare:planets --force",
    "publish:earth-city": "node tools/objects/geographic-pages/operations/publish-city-pages.mts --object=earth",
    "publish:earth-global": "node tools/objects/geographic-pages/operations/publish-global-wmts.mts --object=earth",
    "verify:earth-delivery": "node tools/objects/geographic-pages/operations/verify-global-wmts-delivery.mts --object=earth",
    "test:earth-delivery": "node tests/objects/browser/earth/global-delivery-browser.mts",
    "publish:earth-city-face": "node tools/objects/geographic-pages/operations/publish-global-city-face.mts --object=earth",
    "status:earth-city-global": "node tools/objects/geographic-pages/operations/status-global-city.mts --object=earth",
    "test": "pnpm test:packages && pnpm test:renderer && pnpm test:platform && pnpm test:shell",
    "test:platform": "node --test src/platform/*.test.mts src/navigation/*.test.mts tools/*.test.mts",
    "test:planets": "node tools/run-implemented-planets.mts test",
    "test:shell": "node --test site/test/*.test.mts",
    "test:browser": "node site/test/dom-cleanliness-browser.mts",
    "test:browser:conformance": "node site/test/planet-browser-conformance.mts",
    "test:browser:view-url": "node site/test/view-url-browser.mts",
    "test:browser:datasets": "node site/test/dataset-navigation-browser.mts",
    "test:browser:universe": "node site/test/universe-environments-browser.mts",
    "test:browser:universe-labels": "node site/test/universe-labels-browser.mts",
    "test:browser:galaxy-handoff": "node site/test/galaxy-handoff-browser.mts",
    "test:browser:mercury-rotation": "node tests/objects/browser/mercury/rotation-limits-browser.mts",
    "benchmark:payloads": "node tools/measure-object-payloads.mts",
    "oracle:venus": "node tests/objects/oracle/venus/run.mjs",
    "analyze:trace:saturn": "node tests/objects/browser/saturn/audit/analyze-user-trace.mts",
    "trace:saturn": "node tests/objects/browser/saturn/audit/trace.mts",
    "refresh:earth-enso": "node tools/objects/paged-ellipsoid/refresh-earth-enso.mts && node tools/objects/dist/prepare-authored.js earth --write",
    "prepare:earth-global": "node tools/objects/geographic-pages/operations/prepare-global-wmts.mts --object=earth && node tools/objects/geographic-pages/operations/integrate-global-wmts.mts --object=earth --latest",
    "test:earth-global": "node tests/objects/browser/earth/wmts-tree-browser.mts --global",
    "oracle:interactions": "node tests/objects/oracle/mars/google-earth-pro/run-interaction-suite.mjs",
    "lint:packages": "eslint packages --max-warnings 0",
    "build:engine": "pnpm --filter @cssearth/engine build",
    "build:objects": "pnpm --filter @cssearth/objects build",
    "build:packages": "pnpm prepare:catalog && pnpm -r --filter \"./packages/**\" build && node tools/prepare-solar-geometry.mts && node tools/prepare-navigation.mts --catalog-only",
    "test:packages": "pnpm -r --filter \"./packages/**\" test",
    "typecheck:packages": "pnpm -r --filter \"./packages/**\" typecheck",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:renderer && pnpm typecheck:platform && pnpm typecheck:preparation && pnpm typecheck:tools && pnpm typecheck:shell && pnpm typecheck:astro && pnpm typecheck:ownership && pnpm typecheck:browser-owners && pnpm typecheck:tests",
    "typecheck:shell": "pnpm --filter @cssearth/engine exec tsc -p ../../site/tsconfig.json",
    "typecheck:ownership": "pnpm --filter @cssearth/engine exec tsc -p ../../tools/typescript-ownership.tsconfig.json",
    "check:typescript-ownership": "node tools/typescript-ownership.mts",
    "test:typescript-ownership": "node --test tools/typescript-ownership.test.mts",
    "typecheck:browser-owners": "pnpm --filter @cssearth/engine exec tsc -p ../../site/test/typescript-owners.tsconfig.json",
    "test:browser:typescript-owners": "node site/test/typescript-owners-browser.mts",
    "typecheck:renderer": "pnpm --filter @cssearth/engine exec tsc -p ../../src/renderers/css/tsconfig.json",
    "test:renderer": "pnpm --filter @cssearth/engine exec vitest run --root ../../src/renderers/css --exclude \"**/preparation/**\"",
    "prepare:object-json": "node tools/restore-object-json.mts && pnpm prepare:world-context",
    "prepare:surface-minimaps": "node tools/prepare-surface-minimaps.mts",
    "prepare:provenance": "node tools/prepare-provenance.mts",
    "prepare:spacecraft": "node tools/prepare-provenance.mts",
    "prepare:sources": "node tools/prepare-provenance.mts",
    "predev": "pnpm build:packages && pnpm build:renderer && pnpm build:preparation && pnpm prepare:object-json && pnpm prepare:minimap && pnpm prepare:provenance",
    "prebuild": "pnpm build:packages && pnpm build:renderer && pnpm build:preparation && pnpm prepare:object-json && pnpm prepare:minimap && pnpm prepare:provenance",
    "build:renderer": "pnpm --filter @cssearth/engine exec tsup --config ../../src/renderers/css/tsup.config.ts",
    "build:preparation": "pnpm --filter @cssearth/engine exec tsup --config ../../tools/objects/tsup.config.ts",
    "prepare:volume": "node tools/objects/dist/prepare-volume.js",
    "prepare:stars": "node tools/objects/dist/prepare-stars.js",
    "prepare:surface-shell": "node tools/objects/dist/prepare-shell.js",
    "prepare:world-context": "node tools/objects/dist/prepare-spatial-context.js src/planets/sun/source/navigation/universe.json src/planets/sun/prepared/world-context.json",
    "prepare:universe": "pnpm build:preparation && pnpm prepare:volume src/objects/milky-way && pnpm prepare:stars src/objects/stellar-neighbourhood && pnpm prepare:surface-shell src/objects/heliosphere && pnpm prepare:world-context",
    "test:preparation": "node tools/test-preparation.mts",
    "typecheck:preparation": "pnpm --filter @cssearth/engine exec tsc -p ../../tools/objects/tsconfig.json",
    "test:seo": "node site/test/seo-browser.mts",
    "prepare:social": "node tools/prepare-social-images.mts",
    "test:browser:flight": "node site/test/flight-registry-browser.mts",
    "test:browser:interaction-chain": "node site/test/interaction-chain-browser.mts",
    "test:browser:navigation-stress": "node site/test/navigation-stress-browser.mts",
    "test:browser:navigation-stress:matrix": "node site/test/navigation-stress-matrix.mts",
    "build:performance": "pnpm prebuild && astro build --mode performance && pnpm assemble:planets",
    "prepare:minimap": "node site/minimap/prepare.mts",
    "typecheck:platform": "tsc -p src/platform/tsconfig.json",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "typecheck:astro": "astro check --tsconfig site/astro.tsconfig.json",
    "prepare:catalog": "node tools/prepare-catalog.mts",
    "typecheck:tests": "node tools/typecheck-tests.mts"
  },
  "dependencies": {
    "@cesium/engine": "26.3.0",
    "@layoutit/polycss": "0.2.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cssearth/astronomy": "workspace:*",
    "@cssearth/catalog": "workspace:*",
    "@cssearth/engine": "workspace:*",
    "@cssearth/objects": "workspace:*",
    "@types/fontkit": "2.0.9",
    "@types/pngjs": "6.0.5",
    "@typescript-eslint/parser": "^8.69.0",
    "astro": "^7.2.4",
    "classic-level": "3.0.0",
    "cwebp-bin": "8.0.0",
    "esbuild": "0.27.7",
    "eslint": "^10.10.0",
    "fontkit": "2.0.4",
    "geotiff": "3.0.5",
    "h5wasm": "0.10.3",
    "meshoptimizer": "1.2.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.60.0",
    "pngjs": "7.0.0",
    "robust-predicates": "3.0.3",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
