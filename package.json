{
  "name": "cssearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4210",
    "postinstall": "pnpm build:astronomy && pnpm build:catalog",
    "build:astronomy": "pnpm --filter @cssearth/astronomy build",
    "build:catalog": "pnpm --filter @cssearth/catalog build",
    "build": "astro build && pnpm assemble:planets",
    "acquire:planets": "node tools/run-implemented-planets.mjs acquire",
    "assemble:planets": "node tools/run-implemented-planets.mjs assemble",
    "prepare:checkout": "node tools/restore-source-inputs.mjs && pnpm prepare:planets",
    "preview": "node tools/preview.mjs",
    "prepare:planet-info": "node tools/prepare-planet-information.mjs",
    "prepare:navigation": "node tools/prepare-navigation.mjs",
    "prepare:planet-title-sources": "node tools/prepare-planet-title-sources.mjs",
    "prepare:titles": "node tools/prepare-shell-titles.mjs",
    "prepare:icons": "node tools/prepare-shell-icons.mjs",
    "prepare:wordmark": "node tools/prepare-wordmark-rail.mjs",
    "prepare:scientific-charts": "node tools/prepare-scientific-charts.mjs",
    "prepare:shell": "pnpm prepare:titles && pnpm prepare:icons && pnpm prepare:wordmark",
    "prepare:solar-geometry": "pnpm build:astronomy && node tools/prepare-solar-geometry.mjs",
    "prepare:catalog-sky": "pnpm build:catalog && node src/planets/mercury/tools/prepare-catalog-sky.mjs",
    "prepare:planets": "pnpm build:astronomy && pnpm build:catalog && pnpm prepare:titles && pnpm prepare:wordmark && pnpm prepare:planet-title-sources && pnpm prepare:scientific-charts && node tools/run-implemented-planets.mjs prepare && pnpm prepare:navigation",
    "publish:earth-city": "node src/planets/earth/tools/publish-city-pages.mjs",
    "publish:earth-global": "node src/planets/earth/tools/publish-global-wmts.mjs",
    "verify:earth-delivery": "node src/planets/earth/tools/verify-global-wmts-delivery.mjs",
    "test:earth-delivery": "node src/planets/earth/test/global-delivery-browser.mjs",
    "publish:earth-city-face": "node src/planets/earth/tools/publish-global-city-face.mjs",
    "status:earth-city-global": "node src/planets/earth/tools/status-global-city.mjs",
    "test:platform": "node --test src/platform/*.test.mjs src/navigation/*.test.mjs tools/*.test.mjs",
    "test:planets": "node tools/run-implemented-planets.mjs test",
    "test:shell": "node --test site/test/*.test.mjs",
    "test": "pnpm test:platform && pnpm test:shell && pnpm test:planets",
    "test:browser:introductions": "node site/test/planet-introduction-browser.mjs",
    "test:browser:shell": "node site/test/smoke-browser.mjs && pnpm test:browser:introductions",
    "test:browser:conformance": "node site/test/planet-browser-conformance.mjs",
    "test:browser:planets": "node tools/run-implemented-planets.mjs browser",
    "test:browser:mercury-geometry": "node src/planets/mercury/test/lighting-geometry-browser.mjs",
    "test:browser:mercury-system": "node src/planets/mercury/test/planetary-system-browser.mjs",
    "test:browser:mercury-labels": "node src/planets/mercury/test/label-field-browser.mjs",
    "test:browser:mercury-stars": "node src/planets/mercury/test/catalogue-stars-browser.mjs",
    "test:browser:mercury-rotation": "node src/planets/mercury/test/rotation-limits-browser.mjs",
    "test:browser:mercury-geometry-mutations": "node src/planets/mercury/test/lighting-geometry-mutation-gate.mjs",
    "test:browser": "node tools/test-browser.mjs",
    "benchmark:compare": "node tools/compare-planet-benchmarks.mjs",
    "benchmark:payloads": "node tools/measure-object-payloads.mjs",
    "oracle:venus": "node src/planets/venus/tools/oracle/run.mjs",
    "analyze:trace:saturn": "node src/planets/saturn/tools/audit/analyze-user-trace.mjs",
    "trace:saturn": "node src/planets/saturn/tools/audit/trace.mjs",
    "prepare:earth-global": "node src/planets/earth/tools/prepare-global-wmts.mjs && node src/planets/earth/tools/integrate-global-wmts.mjs --latest",
    "test:earth-global": "node src/planets/earth/test/wmts-tree-browser.mjs --global",
    "oracle:interactions": "node src/planets/mars/tools/oracle/google-earth-pro/run-interaction-suite.mjs"
  },
  "dependencies": {
    "@layoutit/polycss": "0.2.11"
  },
  "devDependencies": {
    "@cssearth/astronomy": "workspace:*",
    "@cssearth/catalog": "workspace:*",
    "astro": "^7.2.4",
    "classic-level": "3.0.0",
    "cwebp-bin": "8.0.0",
    "fontkit": "2.0.4",
    "geotiff": "3.0.5",
    "pixelmatch": "7.2.0",
    "playwright": "1.60.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.3",
    "vite": "7.3.1"
  }
}
