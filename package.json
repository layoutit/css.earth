{
  "name": "cssearth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:assets": "node tools/setup.mjs",
    "publish:runtime-assets": "node tools/publish-runtime-assets.mjs",
    "dev": "astro dev --host 127.0.0.1 --port 4210",
    "postinstall": "pnpm build:packages && pnpm build:renderer && pnpm build:preparation && pnpm prepare:object-json",
    "build:astronomy": "pnpm --filter @cssearth/astronomy build",
    "build:catalog": "pnpm --filter @cssearth/catalog build",
    "build": "astro build && pnpm assemble:planets",
    "acquire:planets": "node tools/run-implemented-planets.mjs acquire",
    "assemble:planets": "node tools/run-implemented-planets.mjs assemble",
    "prepare:checkout": "node tools/restore-source-inputs.mjs && pnpm prepare:planets",
    "preview": "node tools/preview.mjs",
    "prepare:planet-info": "node tools/prepare-planet-information.mjs",
    "prepare:navigation": "node tools/prepare-navigation.mjs",
    "prepare:planet-title-sources": "node tools/prepare-planet-title-sources.mjs",
    "prepare:titles": "node tools/prepare-shell-titles.mjs",
    "prepare:icons": "node tools/prepare-shell-icons.mjs",
    "prepare:wordmark": "node tools/prepare-wordmark-rail.mjs",
    "prepare:scientific-charts": "node tools/prepare-scientific-charts.mjs",
    "prepare:shell": "pnpm prepare:titles && pnpm prepare:icons && pnpm prepare:wordmark",
    "prepare:solar-geometry": "pnpm build:astronomy && node tools/prepare-solar-geometry.mjs",
    "prepare:planets": "pnpm build:astronomy && pnpm build:catalog && node tools/prepare-planets.mjs",
    "prepare:planets:full": "pnpm build:astronomy && pnpm build:catalog && node tools/prepare-planets.mjs --force",
    "publish:earth-city": "node tools/objects/geographic-pages/operations/publish-city-pages.mjs --object=earth",
    "publish:earth-global": "node tools/objects/geographic-pages/operations/publish-global-wmts.mjs --object=earth",
    "verify:earth-delivery": "node tools/objects/geographic-pages/operations/verify-global-wmts-delivery.mjs --object=earth",
    "test:earth-delivery": "node tests/objects/browser/earth/global-delivery-browser.mjs",
    "publish:earth-city-face": "node tools/objects/geographic-pages/operations/publish-global-city-face.mjs --object=earth",
    "status:earth-city-global": "node tools/objects/geographic-pages/operations/status-global-city.mjs --object=earth",
    "test": "pnpm test:packages && pnpm test:renderer && pnpm test:preparation && pnpm test:platform && pnpm test:planets && pnpm test:shell",
    "test:platform": "node --test src/platform/*.test.mjs src/navigation/*.test.mjs tools/*.test.mjs tools/objects/*.test.mjs",
    "test:planets": "node tools/run-implemented-planets.mjs test",
    "test:shell": "node --test site/test/*.test.mjs",
    "test:browser": "pnpm test:browser:conformance \"${CSSEARTH_BROWSER_BASE_URL:-http://127.0.0.1:4210}\" && pnpm test:browser:planets \"${CSSEARTH_BROWSER_BASE_URL:-http://127.0.0.1:4210}\" && pnpm test:browser:earth-noise",
    "test:browser:earth-noise": "node tests/objects/browser/earth/noise-visibility-browser.mjs",
    "test:browser:dom": "node site/test/dom-cleanliness-browser.mjs",
    "test:browser:conformance": "node site/test/planet-browser-conformance.mjs",
    "test:browser:planets": "node tools/run-implemented-planets.mjs browser",
    "test:browser:mercury-geometry": "node tests/objects/browser/mercury/lighting-geometry-browser.mjs",
    "test:browser:mercury-system": "node tests/objects/browser/mercury/planetary-system-browser.mjs",
    "test:browser:mercury-labels": "node tests/objects/browser/mercury/label-field-browser.mjs",
    "test:browser:mercury-stars": "node tests/objects/browser/mercury/catalogue-stars-browser.mjs",
    "test:browser:mercury-star-labels": "node tests/objects/browser/mercury/star-labels-browser.mjs",
    "test:browser:mercury-planet-sizes": "node tests/objects/browser/mercury/planet-sizes-browser.mjs",
    "test:browser:mercury-vault": "node tests/objects/browser/mercury/celestial-vault-browser.mjs",
    "test:browser:view-url": "node site/test/view-url-browser.mjs",
    "test:browser:mercury-rotation": "node tests/objects/browser/mercury/rotation-limits-browser.mjs",
    "test:browser:mercury-geometry-mutations": "node tests/objects/browser/mercury/lighting-geometry-mutation-gate.mjs",
    "benchmark:payloads": "node tools/measure-object-payloads.mjs",
    "oracle:venus": "node tests/objects/oracle/venus/run.mjs",
    "analyze:trace:saturn": "node tests/objects/browser/saturn/audit/analyze-user-trace.mjs",
    "trace:saturn": "node tests/objects/browser/saturn/audit/trace.mjs",
    "prepare:earth-global": "node tools/objects/geographic-pages/operations/prepare-global-wmts.mjs --object=earth && node tools/objects/geographic-pages/operations/integrate-global-wmts.mjs --object=earth --latest",
    "test:earth-global": "node tests/objects/browser/earth/wmts-tree-browser.mjs --global",
    "oracle:interactions": "node tests/objects/oracle/mars/google-earth-pro/run-interaction-suite.mjs",
    "lint:packages": "eslint packages --max-warnings 0",
    "build:engine": "pnpm --filter @cssearth/engine build",
    "build:objects": "pnpm --filter @cssearth/objects build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "test:packages": "pnpm -r --filter \"./packages/**\" test",
    "typecheck:packages": "pnpm -r --filter \"./packages/**\" typecheck",
    "typecheck:renderer": "pnpm --filter @cssearth/engine exec tsc -p ../../src/renderers/css/tsconfig.json",
    "test:renderer": "pnpm --filter @cssearth/engine exec vitest run --root ../../src/renderers/css --exclude \"**/preparation/**\"",
    "prepare:object-json": "node tools/prepare-object-json.mjs",
    "prepare:surface-minimaps": "node tools/prepare-surface-minimaps.mjs",
    "predev": "pnpm build:packages && pnpm build:renderer && pnpm build:preparation && pnpm prepare:object-json",
    "prebuild": "pnpm build:packages && pnpm build:renderer && pnpm build:preparation && pnpm prepare:object-json",
    "build:renderer": "pnpm --filter @cssearth/engine exec tsup --config ../../src/renderers/css/tsup.config.ts",
    "build:preparation": "pnpm --filter @cssearth/engine exec tsup --config ../../tools/objects/tsup.config.ts",
    "prepare:volume": "node tools/objects/dist/prepare-volume.js",
    "prepare:stars": "node tools/objects/dist/prepare-stars.js",
    "prepare:world-context": "node tools/objects/dist/prepare-spatial-context.js src/planets/sun/source/navigation/universe.json src/planets/sun/prepared/world-context.json",
    "prepare:universe": "pnpm build:preparation && pnpm prepare:volume src/objects/milky-way && pnpm prepare:stars src/objects/stellar-neighbourhood && pnpm prepare:world-context",
    "test:preparation": "node tools/test-preparation.mjs",
    "typecheck:preparation": "pnpm --filter @cssearth/engine exec tsc -p ../../tools/objects/tsconfig.json",
    "test:seo": "node site/test/seo-browser.mjs",
    "prepare:social": "node tools/prepare-social-images.mjs",
    "test:browser:orbit-alignment": "node tests/objects/browser/orbit-alignment.mjs",
    "datasets": "node tools/datasets.mjs",
    "oracle:cesium": "node tools/cesium-oracle/explore.mjs",
    "oracle:cesium:stress": "node tools/cesium-oracle/run.mjs",
    "oracle:cesium:serve": "node tools/cesium-oracle/serve.mjs",
    "prepare:earth-coarse": "node tools/objects/geographic-pages/operations/prepare-global-coarse.mjs --object=earth",
    "publish:earth-coarse": "node tools/objects/geographic-pages/operations/publish-global-coarse.mjs --object=earth",
    "integrate:earth-coarse": "node tools/objects/geographic-pages/operations/integrate-global-coarse.mjs --object=earth",
    "test:browser:earth-entities": "node tests/objects/browser/earth/selection-cards-browser.mjs"
  },
  "dependencies": {
    "@cesium/engine": "26.3.0",
    "@layoutit/polycss": "0.2.11"
  },
  "devDependencies": {
    "@cssearth/astronomy": "workspace:*",
    "@cssearth/catalog": "workspace:*",
    "@typescript-eslint/parser": "^8.69.0",
    "astro": "^7.2.4",
    "classic-level": "3.0.0",
    "cwebp-bin": "8.0.0",
    "eslint": "^10.10.0",
    "fontkit": "2.0.4",
    "geotiff": "3.0.5",
    "pixelmatch": "7.2.0",
    "playwright": "1.60.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.3",
    "vite": "7.3.1",
    "@cssearth/engine": "workspace:*",
    "@cssearth/objects": "workspace:*"
  }
}
