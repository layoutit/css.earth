---
import AdminLayout from './AdminLayout.astro';
import { INVESTIGATION_STATUSES, formatBytes, readInventory, statusTags } from './object-inventory.mts';

const { summaries } = readInventory();
const catalogued = summaries.filter(object => object.discovery);
const tally = (values: string[]) => [...values.reduce((map, value) => map.set(value, (map.get(value) ?? 0) + 1), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1]);
const totals = [
  ['Packages', summaries.length],
  ['With imagery', catalogued.filter(object => object.discovery?.imagery).length],
  ['Anchors', catalogued.filter(object => object.discovery?.anchor).length],
  ['Shape only', catalogued.filter(object => object.discovery && !object.discovery.anchor && !object.discovery.imagery && !object.discovery.illustration).length],
  ['Illustrations', catalogued.filter(object => object.discovery?.illustration).length],
  ['Off the map', catalogued.filter(object => object.discovery && !object.discovery.onMap).length],
  ['Lenses', summaries.reduce((sum, object) => sum + object.lensCount, 0)],
  ['Sources', summaries.reduce((sum, object) => sum + object.sourceCount, 0)],
  ['Runtime assets', formatBytes(summaries.reduce((sum, object) => sum + object.runtimeBytes, 0))],
] as const;
const investigations = INVESTIGATION_STATUSES.map(status => [status, summaries.reduce((sum, object) => sum + object.investigations[status], 0)] as const);
---
<AdminLayout title="Objects">
  <header class="admin-page-header">
    <h1 class="admin-title">Everything in src/objects</h1>
    <p class="admin-subtitle">Read from the packages on disk on every change. Map visibility uses the default settings.</p>
  </header>
  <section class="admin-stats">
    {totals.map(([label, value]) => <div class="admin-stat"><span class="admin-stat-value">{value}</span><span class="admin-stat-label">{label}</span></div>)}
  </section>
  <section class="admin-breakdown">
    <div>
      <h2 class="admin-heading">Kinds</h2>
      <ul class="admin-tally">{tally(summaries.map(object => object.classificationLabel)).map(([label, value]) => <li><span>{label}</span><span>{value}</span></li>)}</ul>
    </div>
    <div>
      <h2 class="admin-heading">Package types</h2>
      <ul class="admin-tally">{tally(summaries.map(object => object.type)).map(([label, value]) => <li><span>{label}</span><span>{value}</span></li>)}</ul>
    </div>
    <div>
      <h2 class="admin-heading">Investigations</h2>
      <ul class="admin-tally">{investigations.map(([label, value]) => <li><span class:list={['admin-status', `is-${label}`]}>{label}</span><span>{value}</span></li>)}</ul>
    </div>
    <div>
      <h2 class="admin-heading">Provenance</h2>
      <ul class="admin-tally">{tally(summaries.map(object => object.provenance ?? 'none')).map(([label, value]) => <li><span>{label}</span><span>{value}</span></li>)}</ul>
    </div>
  </section>
  <table class="admin-table" data-admin-sortable>
    <thead>
      <tr>
        {['Name', 'Kind', 'System', 'Status', 'Lenses', 'Included', 'Unresolved', 'Deferred', 'Excluded', 'Sources', 'Local', 'Runtime', 'Problems']
          .map(label => <th><button type="button">{label}</button></th>)}
      </tr>
    </thead>
    <tbody>
      {summaries.map(object => (
        <tr data-admin-object data-search={`${object.name} ${object.id} ${object.systemName}`.toLocaleLowerCase('en')}
          data-classification={object.classification} data-status={statusTags(object)}>
          <td data-value={object.name}><a href={`/admin/${object.id}/`}><span class="admin-dot" style={`--dot:${object.color}`}></span>{object.name}</a></td>
          <td>{object.classificationLabel}</td>
          <td>{object.systemName}</td>
          <td>{object.discovery ? <>{object.discovery.label}{!object.discovery.onMap && <span class="admin-flag">off map</span>}</> : object.type}</td>
          <td class="is-number">{object.lensCount}</td>
          {INVESTIGATION_STATUSES.map(status => <td class="is-number">{object.investigations[status] || ''}</td>)}
          <td class="is-number">{object.sourceCount}</td>
          <td class="is-number" data-value={object.sourceCount - object.localSourceCount}>{object.localSourceCount < object.sourceCount ? `${object.localSourceCount}/${object.sourceCount}` : '✓'}</td>
          <td class="is-number" data-value={object.runtimeBytes}>{formatBytes(object.runtimeBytes)}</td>
          <td class="is-number">{object.problems.length || ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
</AdminLayout>
