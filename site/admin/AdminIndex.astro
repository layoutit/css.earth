---
import AdminLayout from './AdminLayout.astro';
import { STATUS_LABELS, plural, readInventory } from './object-inventory.mts';

const { groups, folders } = readInventory();
const objects = groups.flatMap(group => group.objects);
const total = (status: keyof typeof STATUS_LABELS) => objects.filter(object => object.status === status).length;
const filters = [
  { value: '', label: 'All', count: objects.length },
  { value: 'imaged', label: 'Imaged', count: total('imaged') },
  { value: 'shape', label: 'Shape only', count: total('shape') },
  { value: 'illustration', label: 'Illustrations', count: total('illustration') },
  { value: 'questions', label: 'With open questions', count: objects.filter(object => object.openQuestions > 0).length },
  { value: 'problems', label: 'Needing attention', count: objects.filter(object => object.problems.length > 0).length },
].filter(filter => filter.value === '' || filter.count > 0);
// Long categories read like an index: one heading per initial.
const byInitial = (list: typeof objects) => [...list.reduce((map, object) => {
  const initial = /^[a-z]/iu.test(object.name) ? object.name[0].toLocaleUpperCase('en') : '#';
  return map.set(initial, [...map.get(initial) ?? [], object]);
}, new Map<string, typeof objects>())];
---
<AdminLayout title="Main page">
  <div class="wiki-main">
    <h1 class="wiki-title">Every object in cssEarth</h1>
    <p class="wiki-lead">
      cssEarth has {plural(objects.length, 'object')}. {total('imaged')} are shown from real imagery, {total('shape')} are known only by
      their shape, {total('illustration')} are illustrations, and {plural(total('view'), 'is a view', 'are views')} of the wider universe.
      Each article below is built from that object's package in <code>src/objects</code>.
    </p>

    <nav class="wiki-contents-inline" aria-label="Categories">
      {groups.map(group => <a href={`#${group.key}`}>{group.label} <span>{group.objects.length}</span></a>)}
    </nav>

    <div class="wiki-filters" role="group" aria-label="Show">
      {filters.map((filter, index) => (
        <button type="button" data-admin-status={filter.value} aria-pressed={index === 0 ? 'true' : 'false'}>{filter.label} <span>{filter.count}</span></button>
      ))}
    </div>

    {groups.map(group => (
      <section class="wiki-category" id={group.key} data-admin-group>
        <h2>{group.label} <span data-admin-group-count>{group.objects.length}</span></h2>
        {(group.objects.length > 30 ? byInitial(group.objects) : [['', group.objects] as const]).map(([initial, members]) => (
          <div class="wiki-category-block" data-admin-block>
            {initial && <h3>{initial}</h3>}
            <ul>
              {members.map(object => (
                <li data-admin-card data-name={`${object.name} ${object.id}`.toLocaleLowerCase('en')}
                  data-tags={[object.status, object.openQuestions > 0 && 'questions', object.problems.length > 0 && 'problems'].filter(Boolean).join(' ')}>
                  <a href={`/admin/${object.id}/`}>{object.name}</a>
                  {object.status !== 'imaged' && object.status !== 'view' && <span class="wiki-mark">{STATUS_LABELS[object.status].toLocaleLowerCase('en')}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}

    <p class="wiki-empty" data-admin-empty hidden>No object matches.</p>
    {folders.length > 0 && <p class="wiki-footnote">Folders with notes but no object yet: {folders.join(', ')}.</p>}
  </div>
</AdminLayout>
