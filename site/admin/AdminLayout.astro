---
import '../site.css';
import './admin.css';
import { readInventory } from './object-inventory.mts';

interface Props { title: string; }
const { title } = Astro.props;
const objects = readInventory().groups.flatMap(group => group.objects);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{title} · cssEarth objects</title>
  </head>
  <body class="admin">
    <header class="wiki-header">
      <a class="wiki-brand" href="/admin/">cssEarth <span>objects</span></a>
      <form class="wiki-search" role="search" data-wiki-search>
        <input type="search" name="q" list="wiki-objects" placeholder={`Search ${objects.length} objects`} aria-label="Search objects" autocomplete="off" />
        <datalist id="wiki-objects">{objects.map(object => <option value={object.name} data-id={object.id} />)}</datalist>
      </form>
    </header>
    <slot />
    <script>
      import { mountAdmin } from './admin-client.mts';
      mountAdmin(document);
    </script>
  </body>
</html>
