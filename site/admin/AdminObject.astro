---
import type { MarkdownHeading } from 'astro';
import AdminLayout from './AdminLayout.astro';
import { LEDGER_GROUPS, REPOSITORY_BLOB, STATUS_LABELS, formatBytes, plural, readInventory, readInventoryDetail } from './object-inventory.mts';

export function getStaticPaths() {
  return readInventory().groups.flatMap(group => group.objects).map(object => ({ params: { id: object.id } }));
}

const id = Astro.params.id;
if (typeof id !== 'string') throw new TypeError('Missing object id.');
const object = readInventoryDetail(id);
const { groups } = readInventory();
const group = groups.find(candidate => candidate.key === object.group);
const siblings = group?.objects ?? [];
const position = siblings.findIndex(candidate => candidate.id === object.id);
const previous = position > 0 ? siblings[position - 1] : undefined, next = siblings[position + 1];
const packagePath = `src/objects/${object.id}`;

// Each README is the body's source-and-evidence document; Astro renders it as the article body.
const readmes = import.meta.glob('../../src/objects/*/README.md');
const loadReadme = readmes[`../../src/objects/${object.id}/README.md`];
const readme: unknown = loadReadme ? await loadReadme() : null;
const ReadmeContent = readme && typeof readme === 'object' && 'Content' in readme && typeof readme.Content === 'function' ? readme.Content : null;
const headingList: unknown = readme && typeof readme === 'object' && 'getHeadings' in readme && typeof readme.getHeadings === 'function' ? readme.getHeadings() : [];
const readmeHeadings = (Array.isArray(headingList) ? headingList : []).filter((heading): heading is MarkdownHeading =>
  typeof heading === 'object' && heading !== null && typeof heading.depth === 'number' && typeof heading.slug === 'string' && typeof heading.text === 'string');

const statusSentence = {
  imaged: `${object.name} is shown from real imagery${object.maps.length ? `, with ${plural(object.maps.length, 'surface map')}` : ''}.`,
  shape: `${object.name} is known only by its shape; cssEarth has no image of its surface.`,
  illustration: `${object.name} is shown as an illustration, not from data of this body.`,
  view: `${object.name} is a view of the wider universe rather than a single body.`,
}[object.status];
const ledgerGroups = LEDGER_GROUPS.map(entry => ({ ...entry, id: `notes-${entry.status}`, entries: object.ledger.filter(note => note.status === entry.status) }))
  .filter(entry => entry.entries.length > 0);
const sourceBytes = object.credits.reduce((sum, credit) => sum + credit.bytes, 0);
const sourceFiles = object.credits.reduce((sum, credit) => sum + credit.files, 0);
const references = [...new Set(object.ledger.flatMap(note => note.evidence))];
const referenceNumber = (link: string) => references.indexOf(link) + 1;
// Ledger findings write links as Markdown; show them as links rather than bracket text.
const linkParts = (value: string) => value.split(/(\[[^\]]+\]\(https?:\/\/[^)\s]+\))/u).map(part => {
  const link = /^\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)$/u.exec(part);
  return link ? { text: link[1], href: link[2] } : { text: part, href: null };
});
const shortLink = (link: string) => link.replace(/^https:\/\/github\.com\/layoutit\/css\.earth\/blob\/[0-9a-f]+\//u, '').replace(/^https?:\/\/(www\.)?/u, '');

interface ContentsEntry { id: string; text: string; children: { id: string; text: string }[]; }
const readmeContents: ContentsEntry[] = [];
for (const heading of readmeHeadings) {
  if (heading.depth === 2) readmeContents.push({ id: heading.slug, text: heading.text, children: [] });
  else if (heading.depth === 3) readmeContents.at(-1)?.children.push({ id: heading.slug, text: heading.text });
}
const contents: ContentsEntry[] = [
  ...object.maps.length ? [{ id: 'maps', text: 'Maps', children: [] }] : [],
  ...readmeContents,
  ...ledgerGroups.length ? [{ id: 'research-notes', text: 'Research notes', children: ledgerGroups.map(entry => ({ id: entry.id, text: entry.label })) }] : [],
  ...object.credits.length ? [{ id: 'data-sources', text: 'Data sources', children: [] }] : [],
  ...references.length ? [{ id: 'references', text: 'References', children: [] }] : [],
];
---
<AdminLayout title={object.name}>
  <div class="wiki-page">
    <nav class="wiki-toc" aria-label="Contents" data-wiki-toc>
      <p class="wiki-toc-title">Contents</p>
      <ul>
        <li><a href="#top">(Top)</a></li>
        {contents.map(entry => (
          <li><a href={`#${entry.id}`}>{entry.text}</a>
            {entry.children.length > 0 && <ul>{entry.children.map(child => <li><a href={`#${child.id}`}>{child.text}</a></li>)}</ul>}
          </li>
        ))}
      </ul>
    </nav>

    <article class="wiki-article" id="top">
      <header class="wiki-article-header">
        <h1 class="wiki-title">{object.name}</h1>
        <div class="wiki-tabs">
          <span class="wiki-tab is-current">Article</span>
          {object.route && <a class="wiki-tab" href={object.route}>View in cssEarth</a>}
          <a class="wiki-tab" href={`${REPOSITORY_BLOB}/${packagePath}/README.md`}>Edit README</a>
          <a class="wiki-tab" href={`${REPOSITORY_BLOB}/${packagePath}/investigations.json`}>Ledger</a>
        </div>
      </header>
      <p class="wiki-tagline">From cssEarth objects · <a href={`/admin/#${object.group}`}>{object.kind}</a></p>

      <aside class="wiki-infobox">
        <p class="wiki-infobox-title">{object.name}</p>
        <div class="wiki-infobox-image">
          {object.image ? <img src={object.image} alt={object.name} /> : <span class="wiki-dot" style={`--dot:${object.color}`}></span>}
        </div>
        <p class="wiki-infobox-caption">{STATUS_LABELS[object.status]}{object.hiddenFromMap && ', hidden from the map'}</p>
        <table>
          <tbody>
            <tr><th scope="row">Category</th><td><a href={`/admin/#${object.group}`}>{object.kind}</a></td></tr>
            {object.systemName && <tr><th scope="row">System</th><td>{object.systemName}</td></tr>}
            {object.facts.map(fact => <tr><th scope="row">{fact.label}</th><td>{fact.value}</td></tr>)}
            <tr class="wiki-infobox-section"><th colspan="2">In cssEarth</th></tr>
            <tr><th scope="row">Maps</th><td>{object.maps.length}</td></tr>
            <tr><th scope="row">Open questions</th><td>{object.openQuestions}</td></tr>
            <tr><th scope="row">Source files</th><td>{sourceFiles} ({formatBytes(sourceBytes)})</td></tr>
            <tr><th scope="row">Runtime files</th><td>{object.runtimeAssets} ({formatBytes(object.runtimeBytes)})</td></tr>
            <tr><th scope="row">Package</th><td><code>{object.type}</code></td></tr>
          </tbody>
        </table>
      </aside>

      {object.problems.length > 0 && <div class="wiki-notice">
        <strong>This package needs attention.</strong>
        <ul>{object.problems.map(problem => <li>{problem}</li>)}</ul>
      </div>}

      <div class="wiki-lead-block">
        {object.introduction && <p>{object.introduction}</p>}
        {object.card && object.card !== object.introduction && <p>{object.card}</p>}
        <p>{statusSentence}{object.hiddenFromMap && ' It stays off the map until it has an image, but search still finds it.'}</p>
      </div>

      {object.maps.length > 0 && <section>
        <h2 id="maps">Maps</h2>
        <div class="wiki-gallery">
          {object.maps.map(map => (
            <figure>
              <img src={map.url} alt={`${map.label} map of ${object.name}`} loading="lazy" decoding="async" />
              <figcaption>{map.label}{map.falseColor && ' (false colour)'}</figcaption>
            </figure>
          ))}
        </div>
      </section>}

      {ReadmeContent && <div class="wiki-readme" data-wiki-readme data-base={`${REPOSITORY_BLOB}/${packagePath}/`}><ReadmeContent /></div>}

      {ledgerGroups.length > 0 && <section>
        <h2 id="research-notes">Research notes</h2>
        {ledgerGroups.map(entry => (
          <>
            <h3 id={entry.id}>{entry.label}</h3>
            {entry.entries.map(note => (
              <div class="wiki-note">
                <p><strong>{note.subject}.</strong> {linkParts(note.finding).map(part => part.href ? <a href={part.href}>{part.text}</a> : part.text)}
                  {note.evidence.map(link => <sup class="wiki-ref"><a href={`#ref-${referenceNumber(link)}`}>[{referenceNumber(link)}]</a></sup>)}</p>
                {note.revisitWhen && <p class="wiki-note-revisit">Look again when: {linkParts(note.revisitWhen).map(part => part.href ? <a href={part.href}>{part.text}</a> : part.text)}</p>}
              </div>
            ))}
          </>
        ))}
      </section>}

      {object.credits.length > 0 && <section>
        <h2 id="data-sources">Data sources</h2>
        <p>{plural(sourceFiles, 'source file')}, {formatBytes(sourceBytes)} in total.</p>
        <ul>
          {object.credits.map(credit => (
            <li><strong>{credit.credit}</strong>: {[credit.machines.length ? credit.machines.join(', ') : null, plural(credit.files, 'file'), formatBytes(credit.bytes)].filter(Boolean).join(', ')}</li>
          ))}
        </ul>
      </section>}

      {references.length > 0 && <section>
        <h2 id="references">References</h2>
        <ol class="wiki-references">{references.map((link, index) => <li id={`ref-${index + 1}`}><a href={link}>{shortLink(link)}</a></li>)}</ol>
      </section>}

      <footer class="wiki-footer">
        <div class="wiki-categories">
          <span>Categories:</span>
          <a href={`/admin/#${object.group}`}>{object.kind}</a>
          <span>{STATUS_LABELS[object.status]}</span>
          {object.hiddenFromMap && <span>Hidden from the map</span>}
          {object.openQuestions > 0 && <span>With open questions</span>}
        </div>
        <nav class="wiki-pager" aria-label={`More ${object.kind.toLocaleLowerCase('en')}`}>
          {previous ? <a href={`/admin/${previous.id}/`}>← {previous.name}</a> : <span></span>}
          {next && <a href={`/admin/${next.id}/`}>{next.name} →</a>}
        </nav>
        <p>Built from <code>{packagePath}</code> · provenance {object.provenance ?? 'none'}</p>
      </footer>
    </article>
  </div>
</AdminLayout>
