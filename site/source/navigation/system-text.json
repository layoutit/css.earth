          "label": "NASA Science · Pluto moons",
          "checked": "2026-09-13",
          "locator": "Page text"
        }
      ]
    },
    "eris": {
      "text": "Eris and its only known moon, Dysnomia, form a distant pair beyond Neptune. Dysnomia's orbit made it possible to measure Eris's mass.",
      "sources": [
        {
          "catalogueId": "nasa-eris",
          "url": "https://science.nasa.gov/dwarf-planets/eris/",
          "label": "NASA Science · Eris",
