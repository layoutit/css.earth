  "satellites": {
    "earth": {
      "text": "Earth has one natural satellite, the Moon. The Moon always turns the same face toward Earth.",
      "sources": [
        {
          "catalogueId": "nasa-moon-facts",
          "url": "https://science.nasa.gov/moon/facts/",
          "label": "NASA Science · Moon facts",
          "checked": "2026-09-13",
          "locator": "Page text"
        }
      ]
    },
    "jupiter": {
      "text": "Jupiter and its moons form a miniature solar system. Its four largest moons are Io, Europa, Ganymede and Callisto.",
      "sources": [
        {
          "catalogueId": "nasa-jupiter-facts",
          "url": "https://science.nasa.gov/jupiter/jupiter-facts/",
          "label": "NASA Science · Jupiter facts",
          "checked": "2026-09-13",
          "locator": "Page text"
        }
      ]
    },
    "mars": {
      "text": "Mars has two small moons, Phobos and Deimos. Phobos is the larger, inner moon; Deimos is the smaller, outer moon.",
      "sources": [
        {
          "catalogueId": "nasa-mars-moons",
          "url": "https://science.nasa.gov/mars/moons/phobos/",
          "label": "NASA Science · Mars moons",
          "checked": "2026-09-13",
          "locator": "Page text"
        },
        {
          "catalogueId": "nasa-mars-moons",
          "url": "https://science.nasa.gov/mars/moons/deimos/",
          "label": "NASA Science · Mars moons",
          "checked": "2026-09-13",
          "locator": "Page text"
        }
      ]
    },
    "saturn": {
      "text": "Saturn's rings and moons form a broad family. Icy spray from Enceladus feeds the E ring, while Titan has a thick atmosphere.",
      "sources": [
        {
          "catalogueId": "nasa-saturn-facts",
          "url": "https://science.nasa.gov/saturn/facts/",
          "label": "NASA Science · Saturn facts",
          "checked": "2026-09-13",
          "locator": "Page text"
        },
        {
          "catalogueId": "nasa-saturn-moons",
          "url": "https://science.nasa.gov/saturn/moons/enceladus/",
          "label": "NASA Science · Saturn’s moons",
          "checked": "2026-09-13",
          "locator": "Page text"
        },
        {
          "catalogueId": "nasa-saturn-moons",
          "url": "https://science.nasa.gov/saturn/moons/titan/facts/",
          "label": "NASA Science · Saturn’s moons",
          "checked": "2026-09-13",
          "locator": "Page text"
        }
      ]
    },
    "uranus": {
      "text": "Miranda, Ariel, Umbriel, Titania and Oberon are Uranus's five large moons. Smaller moons orbit the planet alongside its rings.",
      "sources": [
        {
          "catalogueId": "nasa-uranus-facts",
          "url": "https://science.nasa.gov/uranus/facts/",
          "label": "NASA Science · Uranus facts",
