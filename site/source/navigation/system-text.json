          "label": "NASA Science · Nereid",
          "checked": "2026-09-13",
          "locator": "Nereid overview"
        }
      ]
    },
    "pluto": {
      "text": "Pluto has five moons: Charon, Styx, Nix, Kerberos and Hydra. Pluto and Charon always keep the same faces turned toward each other.",
      "sources": [
        {
          "catalogueId": "source-pluto-editorial-nasa-pluto-json",
