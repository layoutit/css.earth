        },
        {
          "catalogueId": "nasa-uranus-moons",
          "url": "https://science.nasa.gov/uranus/moons/ariel/",
          "label": "NASA Science · Uranus’s moons",
          "checked": "2026-09-13",
          "locator": "Page text"
        }
      ]
    },
    "neptune": {
      "text": "Neptune's largest moon, Triton, travels backward around the planet. Its smaller moons include Proteus and Nereid.",
      "sources": [
        {
          "catalogueId": "nasa-neptune-moons",
          "url": "https://science.nasa.gov/neptune/moons/triton/",
