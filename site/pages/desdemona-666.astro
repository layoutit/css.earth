---
import PlanetLayout from "../layouts/PlanetLayout.astro";
import PreparedObjectHead from "../components/PreparedObjectHead.astro";
import PreparedObjectPanel from "../components/PreparedObjectPanel.astro";
import preparedContent from "../../src/planets/desdemona-666/prepared/content.json";
import { loadObjectPageData } from "../object-page-data.mjs";
import type { PreparedObjectContentDocument } from "../../tools/objects/content/types";
import "../../src/renderers/css/styles/desdemona-666-surfaces.css";
import "../planet-shell.css";
const preparedPage = await loadObjectPageData("desdemona-666");
---

<PlanetLayout objectId="desdemona-666">
  <PreparedObjectHead slot="planet-head" preparedAssets={preparedPage.assets} />
  <PreparedObjectPanel slot="planet-ui" preparedContent={preparedContent as PreparedObjectContentDocument} preparedControls={preparedPage.controls} />
</PlanetLayout>
