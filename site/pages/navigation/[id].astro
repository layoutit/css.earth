---
import ObjectPage from '../../components/ObjectPage.astro';
import { OBJECTS, SCENE_OBJECTS, PAGES } from '../../objects.mts';
import { ROOT_OBJECT_ID } from '../../model/root-object.mts';
import { builtScenePaths } from '../../server/built-pages.mts';
export function getStaticPaths() {
  return builtScenePaths(SCENE_OBJECTS.map(({ id }) => ({ params: { id } })), PAGES, ROOT_OBJECT_ID);
}
---
<ObjectPage objectId={Astro.params.id!} navigation />
