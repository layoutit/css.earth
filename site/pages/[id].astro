---
import ObjectPage from '../components/ObjectPage.astro';
import { OBJECTS } from '../objects.mts';
import { builtObjectPages } from '../built-pages.mts';
export function getStaticPaths() {
  // Every object has its page, `/<id>/`, which mounts its scene. A level of the zoom ladder has a page too: the world
  // host's scene at that zoom, with the level selected.
  const pages = OBJECTS.map(object => ({ id: object.id }));
  return builtObjectPages(pages.map(page => ({ params: { id: page.id }, props: { sceneId: page.id } })), pages);
}
---
<ObjectPage objectId={Astro.props.sceneId} pageId={Astro.params.id!} />
