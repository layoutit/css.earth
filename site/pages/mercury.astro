---
import PlanetLayout from "../layouts/PlanetLayout.astro";
import PreparedObjectHead from "../components/PreparedObjectHead.astro";
import PreparedObjectPanel from "../components/PreparedObjectPanel.astro";
import preparedContent from "../../objects/preparation/mercury/content.json";
import preparedObject from "../../objects/prepared/mercury.json";
import type { PreparedObjectContentDocument } from "../../tools/objects/content/types";
import "../../src/renderers/css/styles/planet-surfaces.css";
import "../planet-shell.css";
---

<PlanetLayout objectId="mercury">
  <PreparedObjectHead slot="planet-head" preparedAssets={preparedObject.data.assets} />
  <PreparedObjectPanel slot="planet-ui" preparedContent={preparedContent as PreparedObjectContentDocument} preparedControls={preparedObject.data.controls} />
</PlanetLayout>
