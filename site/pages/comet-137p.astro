---
import PlanetLayout from "../layouts/PlanetLayout.astro";
import PreparedObjectHead from "../components/PreparedObjectHead.astro";
import PreparedObjectPanel from "../components/PreparedObjectPanel.astro";
import preparedContent from "../../src/planets/comet-137p/prepared/content.json";
import { loadObjectPageData } from '../object-page-data.mts';
import "../../src/renderers/css/styles/comet-137p-surfaces.css";
import "../planet-shell.css";
const preparedPage = await loadObjectPageData("comet-137p");
---

<PlanetLayout objectId="comet-137p">
  <PreparedObjectHead slot="planet-head" preparedAssets={preparedPage.assets} />
  <PreparedObjectPanel slot="planet-ui" preparedContent={preparedContent} preparedControls={preparedPage.controls} />
</PlanetLayout>
