---
import { worldPlaceOf, worldStartupFiles } from '../world-places.mts';
import { informationTabStyles } from '../server/information-tab-styles.mts';
import ObjectSwatchStyles from "../components/ObjectSwatchStyles.astro";
import { webAnalyticsBootstrap } from "../web-analytics.mts";
import { errorReportBootstrap } from "../error-report.mts";
import { initialShellContextBootstrap } from '../initial-shell-context.mts';
import { startupRequestsBootstrap } from '../startup-requests.mts';
import { defaultDatasetBank } from '../object-page-data.mts';
import contextBankAssets from '../prepared-context-bank-assets.json';
import { SYSTEM_VIEW_HOSTS } from '../system-framing.mts';
import { inlineSceneImage, resolveBuildSceneAddress } from '../asset-origin.mts';
import { SCENE_OBJECTS, requireObject } from "../objects.mts";
import { breadcrumbJsonLd, homeSeo, objectSeo, websiteJsonLd } from "../seo.mts";
import { pageTrail } from "../seo-trail.mts";
import { availableSocialImages, DEFAULT_SOCIAL_IMAGE_ID } from "../social-images.mts";
import "./cubic-sky.css";
import "@cssearth/renderer/styles/volume.css";
import "@cssearth/renderer/styles/world-context.css";
import "@cssearth/renderer/styles/triangle-faces.css";
import "../site.css";
import "../shell/maps-shell.css";
import "../shell/settings-panel.css";
import "../shell/shell-layout.css";
import type { PreparedSceneMarkup } from '@cssearth/renderer';
import type { loadPreparedSceneMarkup } from '../server/load-prepared-scene.mts';
import type { ObjectDescriptor } from '@cssearth/objects';
// The world camera a body mounts with (`site/world-camera.mts`): the summary's frame, focus and camera, so the first
// body mounts before the world summary itself downloads.
import worldSummary from '../../src/objects/observable-universe/prepared/world.json';
// The same hashed file the client's `world-context-plan.mts` fetches, requested by the head (startup-requests.mts).
import worldSummaryUrl from '../../src/objects/observable-universe/prepared/world.json?url';
import { worldCameraOf } from '@cssearth/objects';
import { MOBILE_VIEWPORT_QUERY } from '../runtime-policy.mts';
import { defaultWidthShare } from '../default-width-share.mts';
import { nativeInputMarkup } from '../native-input.mts';
import { billboardBodyRadiusPixels } from '@cssearth/renderer/navigation/prepared-body-billboards.ts';
const worldCamera = worldCameraOf(worldSummary);

interface Props {
  objectId: string;
  /** What the page is: `objectId`, or an object seen from inside that its scene shows. */
  pageId?: string;
  navigation?: boolean;
  scene?: PreparedSceneMarkup & Pick<Awaited<ReturnType<typeof loadPreparedSceneMarkup>>, 'descriptor' | 'coverPlan'>;
  descriptor?: ObjectDescriptor;
  /** The site's root page: it shows `objectId` but is named and addressed as the site. */
  home?: boolean;
}

const { objectId, pageId = objectId, navigation = false, scene, descriptor, home = false } = Astro.props;
const objectUi = await Astro.slots.render('object-ui');
const tabStyles = informationTabStyles(Astro.locals, objectUi);
const objectRecord = requireObject(objectId);
// The world files the page reads at startup, root first, and its body's own row when no file has it (site/world-places.mts).
const worldFiles = worldStartupFiles(pageId);
const ownRow = worldPlaceOf(objectRecord.id)?.row !== undefined;
// Rules for a page without script. The phone sheet waits, hidden, for its controller to publish a snap state
// (shell-layout.css); without script it rests at its peek, and the checkbox of its handle opens it.
const sheetWithoutScript = 'body[data-object-shell]:not([data-sheet]) :is(.object-sidebar, .object-search-toolbar, .object-search-categories) { visibility: visible !important; }';

const startup = !navigation && scene && objectRecord.discovery?.arrival?.billboard ? objectRecord.discovery : undefined;
const startupImage = startup?.arrival?.billboard ? await resolveBuildSceneAddress(startup.arrival.billboard.url) : undefined;
// Only the empty stage of the default view shows the photograph: a native dataset, settings or saved-view response draws
// its scene into the stage and marks it (dataset-response.mts). The photograph shows the body at the share of the viewport
// width that response frames it at, so choosing a dataset does not resize the body. It is centred in `vw`: without script
// the world stage it sits in is as wide as the drag sensor, not the viewport (native-input.mts).
// The server frames a body by the viewport's width alone; the live camera also keeps it within a share of the height
// (camera-layout.ts). Without script a window that is wide for its height drew the body past that share: Saturn 475 px
// across in a 1320×559 viewport, against 338 px with script (2026-10-03). The photograph and the drawn body take the smaller
// of the two here. The world stage keeps the viewport's height, so its `cqh` is that height for both. The ratio of the
// two lengths goes through registered properties (native-input.mts): Firefox and WebKit do not take container and
// viewport units in `atan2()` directly.
const sceneShare = scene?.coverPlan ? defaultWidthShare(scene.coverPlan) : null;
const heightOverWidthShare = sceneShare?.maximumDiameterOverHeight ? sceneShare.maximumDiameterOverHeight / sceneShare.diameterOverWidth : null;
const billboardWidthWithoutScript = (() => {
  const billboard = startup?.arrival?.billboard;
  if (!billboard || !sceneShare) return '70vmin';
  const width = sceneShare.diameterOverWidth * 100 * billboard.size / 2 / billboardBodyRadiusPixels(billboard, objectRecord.worldFrame.bodyRadiusM);
  return heightOverWidthShare ? `min(${width}vw, ${width * heightOverWidthShare}cqh)` : `${width}vw`;
})();
// A saved view names its own camera distance and keeps it; the wheel's rule multiplies this fit (native-input.mts). The
// scaled stage stops clipping, or it would cut the drawing to its own smaller box; the viewport still clips.
const fitWithoutScript = heightOverWidthShare
  ? `.object-stage[data-prepared-object]:not([data-prepared-view]) { --native-stage-height: 100cqh; --native-stage-width: 100vw; --native-fit: min(1, calc(${heightOverWidthShare} * tan(atan2(var(--native-stage-height), var(--native-stage-width))))); scale: var(--native-fit); overflow: visible; }` : '';
const billboardWithoutScript = `.object-stage:not([data-prepared-object]) ~ img[data-startup-billboard] { opacity: 1 !important; width: ${billboardWidthWithoutScript}; height: auto; left: 50vw; top: 50%; transform: translate(-50%, -50%); }`;
// A page that is its own scene places its arrival photograph from the HTML (startup-cover.mts); the page of an object seen
// from inside, drawn by the world host's scene, leaves it to that scene's startup.
const startupCover = startup?.arrival?.billboard && scene?.coverPlan && pageId === objectId ? {
  plan: scene.coverPlan, mobileQuery: MOBILE_VIEWPORT_QUERY,
  billboard: { size: startup.arrival.billboard.size, focalPixels: startup.arrival.billboard.focalPixels, distanceM: startup.arrival.billboard.distanceM },
  bodyRadiusM: objectRecord.worldFrame.bodyRadiusM,
} : undefined;
// A page that places its own photograph carries the image itself: on a 1.6 Mbps, 150 ms link Earth's photograph showed at
// 2.02 s inline against 2.42 s from the asset origin, for the same bytes (2026-10-02). Other pages name its address.
const startupImageSource = startupCover && startup?.arrival?.billboard
  ? await inlineSceneImage(objectRecord.id, startup.arrival.billboard.url) ?? startupImage : startupImage;
// The scene's textures, and a photograph the page does not carry, come from the asset origin: dial that origin with the
// head, or the first request pays the DNS and TLS setup (430 ms of a cold iPad load against 33 ms on a warm connection,
// 2026-09-30). An image preload is not used: Safari downloaded the photograph twice with one.
const assetPreconnect = startupImage && /^https?:\/\//.test(startupImage) ? new URL(startupImage).origin : undefined;
// The bank the page's default dataset shows names its files in a list of its own; the head asks for it with the page.
const defaultBank = !navigation && scene ? await defaultDatasetBank(objectRecord.id) : null;
const bankFiles = defaultBank && defaultBank in contextBankAssets ? `/world/context-assets/${defaultBank}.json` : undefined;
const seoOptions = { socialImages: availableSocialImages(SCENE_OBJECTS), defaultSocialImageId: DEFAULT_SOCIAL_IMAGE_ID };
const pageRecord = requireObject(pageId);
const pageSeo = objectSeo(pageRecord, seoOptions);
const seo = home ? homeSeo(pageSeo) : pageSeo;
const structuredData = JSON.stringify(home ? websiteJsonLd() : breadcrumbJsonLd(pageTrail(pageRecord))).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-scene-presented={scene ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    {!navigation && <script is:inline set:html={initialShellContextBootstrap(objectId)}></script>}
    {/* The first view's documents download while the HTML parses, beside the modules that read them (startup-requests.mts). */}
    {!navigation && <script is:inline set:html={startupRequestsBootstrap({ objectId: objectRecord.id, serverMarkup: Boolean(scene && !startup), systemView: SYSTEM_VIEW_HOSTS.has(objectRecord.id), summaryUrl: worldSummaryUrl, worldFiles, ...(bankFiles ? { bankFiles } : {}) })}></script>}
    {!navigation && <meta name="cssearth-world-files" content={worldFiles.join(' ')} data-row={ownRow ? objectRecord.id : undefined} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {!navigation && <script is:inline set:html={errorReportBootstrap}></script>}
    {/* One connection for the photograph (no CORS) and one for the scene's fetched files (CORS): browsers keep them apart. */}
    {assetPreconnect && <link rel="preconnect" href={assetPreconnect} />}
    {assetPreconnect && <link rel="preconnect" href={assetPreconnect} crossorigin />}
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cssEarth" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
    <meta name="theme-color" content="#000000" />
    <script is:inline type="application/ld+json" set:html={structuredData}></script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {!navigation && <script is:inline type="application/json" data-world-camera set:html={JSON.stringify(worldCamera).replace(/</g, '\\u003c')}></script>}
    {/* Until the first body is ready, the phone sheet's lazy images wait (object-shell.css), so the globe's textures have
        the connection. The router clears this; without JavaScript it is never set. */}
    {!navigation && <script is:inline>document.documentElement.dataset.bodyPending = '';</script>}
    {/* The arrival photograph takes its place from the HTML before the application's code and data (startup-cover.mts).
        It comes first: module scripts run in document order, and its few modules are a small part of the graph. */}
    {startupCover && <script>
      import '../startup-cover.mts';
    </script>}
    {/* In the head the application script downloads with the HTML; as a module it still runs after parsing. */}
    {!navigation && <script>
      import { bindNativeViewForms } from '../native-view-forms.mts';
      import { startBodyCode, startViewCode } from '../startup-boot.mts';
      import { importSceneRouter } from '../shared-imports.mts';
      import { loadStartupWorld } from '../startup-world.mts';
      bindNativeViewForms(document, window);
      startBodyCode(document);
      // The page reads its world first, so no module waits for it (startup-world.mts), and its modules load one at a time
      // (shared-imports.mts).
      loadStartupWorld(window).then(importSceneRouter).then(() => startViewCode(document), error => {
        document.documentElement.dataset.ready = 'error';
        document.querySelector('.startup-loading')?.remove();
        delete document.documentElement.dataset.shellContext;
        delete document.documentElement.dataset.bodyPending;
        console.error('The interactive scene could not load.', error);
      });
    </script>}
    {!navigation && <script is:inline set:html={webAnalyticsBootstrap}></script>}
    <slot name="object-head" />
    {tabStyles.map(({ key, css }) => <style is:inline data-object-style={key} set:html={css} />)}
    {!navigation && <noscript><style is:inline>.startup-loading { display: none; }</style></noscript>}
    <noscript><style is:inline set:html={sheetWithoutScript} /></noscript>
    {/* Drag and wheel without script: one stylesheet for every page, never requested by a page with script (native-input.mts). */}
    <noscript><link rel="stylesheet" href="/native-input.css" /></noscript>
    {startup && <noscript><style is:inline set:html={billboardWithoutScript} /></noscript>}
    {fitWithoutScript && <noscript><style is:inline set:html={fitWithoutScript} /></noscript>}
    <title>{seo.title}</title>
    {!navigation && <ObjectSwatchStyles />}
  </head>
  <body data-object-shell={objectRecord.id}>
    <!--search-shell:start-->
    {!navigation && <div class="startup-loading" role="status" aria-label="Loading scene"></div>}
    <div class="object-ui-layer">
      <Fragment set:html={objectUi} />
    </div>
    <!--search-shell:end-->
    <!--prepared-descriptor:start-->
    {descriptor && <script is:inline type="application/json" data-prepared-descriptor set:html={JSON.stringify(descriptor).replace(/</g, '\\u003c')}></script>}
    <!--prepared-descriptor:end-->
    <div class="object-viewport">
      <div class="object-viewport-search-band" aria-hidden="true"></div>
      <noscript set:html={nativeInputMarkup} />
      <div class="object-world-stage">
        <!--prepared-scene:start-->
        <main
          class:list={['object-stage', ...scene?.classes ?? []]}
          {...scene?.attributes}
          style={scene?.style}
          data-object-id={objectRecord.id}
          data-prepared-object={scene && !startup ? objectRecord.id : undefined}
          aria-label={`3D CSS view of ${objectRecord.name}`}
          set:html={startup ? '' : scene?.html ?? ''}
        />
        <!--prepared-scene:end-->
        {startup && <>
          <script is:inline type="application/json" data-startup-discovery set:html={JSON.stringify(startup).replace(/</g, '\u003c')} />
          <img data-startup-billboard fetchpriority="high" src={startupImageSource} alt="" aria-hidden="true" draggable="false" style="position:absolute;opacity:0;pointer-events:none" />
          {startupCover && <script is:inline type="application/json" data-startup-cover set:html={JSON.stringify(startupCover).replace(/</g, '\u003c')} />}
        </>}
      </div>
      <div class="object-input-surface" tabindex="0" role="group" aria-label={`Explore ${objectRecord.name}`} />
      <div class="object-scene-overlays"></div>
    </div>
  </body>
</html>
