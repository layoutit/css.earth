---
import ObjectSwatchStyles from "../components/ObjectSwatchStyles.astro";
import TitleTypography from "../components/TitleTypography.astro";
import { googleAnalyticsBootstrap } from "../google-analytics.mts";
import { initialShellContextBootstrap } from '../initial-shell-context.mts';
import { requireSceneObject } from "../objects.mts";
import { objectSeo } from "../seo.mts";
import { availableSocialImages, DEFAULT_SOCIAL_IMAGE_ID } from "../social-images.mts";
import "../../src/platform/cubic-sky.css";
import "../../src/renderers/css/styles/volume.css";
import "../../src/renderers/css/styles/world-context.css";
import "../site.css";
import "../maps-shell.css";
import "../explorer-rail.css";
import "../shell-layout.css";
import type { PreparedSceneMarkup } from '../../tools/prepared/serialize-prepared-scene.mts';
import type { loadPreparedSceneMarkup } from '../../tools/prepared/load-prepared-scene.mts';
import type { ObjectDescriptor } from '@cssearth/objects';
// The world camera a body mounts with (`site/world-camera.mts`): the summary's frame, focus and camera, so the first
// body mounts before the world summary itself downloads.
import worldSummary from '../../src/objects/sun/prepared/world-context-summary.json';
const worldCamera = { schema: 'cssearth-world-camera@1', frame: worldSummary.frame, focusId: worldSummary.focus.id, camera: worldSummary.camera };

interface Props {
  objectId: string;
  navigation?: boolean;
  scene?: PreparedSceneMarkup & Pick<Awaited<ReturnType<typeof loadPreparedSceneMarkup>>, 'descriptor'>;
  descriptor?: ObjectDescriptor;
}

const { objectId, navigation = false, scene, descriptor } = Astro.props;
const objectRecord = requireSceneObject(objectId);
const seo = objectSeo(objectRecord, { socialImages: availableSocialImages(), defaultSocialImageId: DEFAULT_SOCIAL_IMAGE_ID });
---

<!doctype html>
<html lang="en" data-scene-presented={scene ? 'true' : undefined}>
  <head>
    <meta charset="UTF-8" />
    {!navigation && <script is:inline set:html={initialShellContextBootstrap}></script>}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cssEarth" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {!navigation && <script is:inline type="application/json" data-world-camera set:html={JSON.stringify(worldCamera).replace(/</g, '\\u003c')}></script>}
    {!navigation && descriptor?.prepared?.url === 'prepared/object.json' &&
      <link rel="preload" href={`/objects/${objectRecord.id}/first-view.json`} as="fetch" crossorigin="anonymous" />}
    {/* Until the first body is ready, the phone sheet's lazy images wait (object-shell.css), so the globe's textures have
        the connection. The router clears this; without JavaScript it is never set. */}
    {!navigation && <script is:inline>document.documentElement.dataset.bodyPending = '';</script>}
    {/* In the head the application script downloads with the HTML; as a module it still runs after parsing. */}
    {!navigation && <script>
      import { bindNativeViewForms } from '../native-view-forms.mts';
      bindNativeViewForms(document, window);
      import("../scene/scene-router.mts").catch(error => {
        document.documentElement.dataset.ready = 'error';
        delete document.documentElement.dataset.shellContext;
        delete document.documentElement.dataset.bodyPending;
        console.error('The interactive scene could not load.', error);
      });
    </script>}
    {/* Static imports make the browser fetch the application's modules while it parses the HTML; the dynamic import
        above only starts after parsing. A browser finds a module's imports only after downloading it, and the bundler
        does not hoist transitive imports, so the body runtime the router imports while it mounts is named here too.
        The registry and world summary load after the first body (`scene-router.mts`). All resolve to the same module
        instances, and the script above owns failure. */}
    {!navigation && <script>
      import '../packaged-object-runtime.mts';
      import '../scene/scene-router.mts';
    </script>}
    {!navigation && <script is:inline set:html={googleAnalyticsBootstrap}></script>}
    <slot name="object-head" />
    <title>{seo.title}</title>
    <ObjectSwatchStyles />
    <TitleTypography />
  </head>
  <body data-object-shell={objectRecord.id}>
    <!--search-shell:start-->
    <div class="object-ui-layer">
      <slot name="object-ui" />
    </div>
    <!--search-shell:end-->
    <!--prepared-descriptor:start-->
    {descriptor && <script is:inline type="application/json" data-prepared-descriptor set:html={JSON.stringify(descriptor).replace(/</g, '\\u003c')}></script>}
    <!--prepared-descriptor:end-->
    <div class="object-viewport">
      <div class="object-world-stage">
        <!--prepared-scene:start-->
        <main
          class:list={['object-stage', ...scene?.classes ?? []]}
          {...scene?.attributes}
          style={scene?.style}
          data-object-id={objectRecord.id}
          data-prepared-object={scene ? objectRecord.id : undefined}
          aria-label={`3D CSS view of ${objectRecord.name}`}
          set:html={scene?.html ?? ''}
        />
        <!--prepared-scene:end-->
      </div>
      <div class="object-input-surface" tabindex="0" role="group" aria-label={`Explore ${objectRecord.name}`} />
      <div class="object-scene-overlays"></div>
    </div>
  </body>
</html>
