---
import ObjectSwatchStyles from "../components/ObjectSwatchStyles.astro";
import { googleAnalyticsBootstrap } from "../google-analytics.mts";
import { requireSceneObject } from "../objects.mts";
import { objectSeo } from "../seo.mts";
import { availableSocialImages, DEFAULT_SOCIAL_IMAGE_ID } from "../social-images.mts";
import "../../src/platform/cubic-sky.css";
import "../../src/renderers/css/styles/volume.css";
import "../../src/renderers/css/styles/world-context.css";
import "../site.css";
import "../maps-shell.css";
import "../explorer-rail.css";
import "../shell-layout.css";
import "../minimap/minimap.css";

interface Props {
  objectId: string;
  navigation?: boolean;
}

const { objectId, navigation = false } = Astro.props;
const objectRecord = requireSceneObject(objectId);
const seo = objectSeo(objectRecord, { socialImages: availableSocialImages(), defaultSocialImageId: DEFAULT_SOCIAL_IMAGE_ID });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cssEarth" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {!navigation && <script is:inline set:html={googleAnalyticsBootstrap}></script>}
    <slot name="planet-head" />
    <title>{seo.title}</title>
    <ObjectSwatchStyles />
  </head>
  <body class="loading" data-object-shell={objectRecord.id}>
    <div class="planet-ui-layer">
      <slot name="planet-ui" />
    </div>
    <div class="planet-viewport">
      <div class="planet-world-stage">
        <main
          class="planet-stage example-stage"
          data-object-id={objectRecord.id}
          aria-label={`Interactive 3D CSS visualization of ${objectRecord.name}`}
          aria-busy="true"
        ></main>
      </div>
      <div class="planet-input-surface" tabindex="0" role="group" aria-label={`Explore ${objectRecord.name}`} />
      <div class="planet-scene-overlays"></div>
    </div>
    {!navigation && <script>
      import "../scene-router.mts";
    </script>}
  </body>
</html>
