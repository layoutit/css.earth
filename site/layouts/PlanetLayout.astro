---
import { DIAGNOSTICS_ENABLED } from "../diagnostics-policy.mjs";
import GitHubIcon from "../components/GitHubIcon.astro";
import CodePenIcon from "../components/CodePenIcon.astro";
import ExplorerRail from "../components/ExplorerRail.astro";
import PreparedSidebarCards from "../components/PreparedSidebarCards.astro";
import PlanetaryScale from "../components/PlanetaryScale.astro";
import ObjectSwatchStyles from "../components/ObjectSwatchStyles.astro";
import { googleAnalyticsBootstrap } from "../google-analytics.mjs";
import { requireObject } from "../objects.mjs";
import { objectSeo } from "../seo.mjs";
import "../../src/platform/cubic-sky.css";
import "../../src/platform/heliocentric-view.css";
import "../../src/renderers/css/styles/volume.css";
import "../../src/renderers/css/styles/world-context.css";
import "../site.css";
import "../maps-shell.css";
import "../explorer-rail.css";
import "../shell-layout.css";
import "../minimap/minimap.css";

declare const __CSSEARTH_VERSION__: string;

interface Props {
  objectId: string;
}

const { objectId } = Astro.props;
const objectRecord = requireObject(objectId);
const seo = objectSeo(objectRecord);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cssEarth" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script is:inline set:html={googleAnalyticsBootstrap}></script>
    <slot name="planet-head" />
    <title>{seo.title}</title>
    <ObjectSwatchStyles />
  </head>
  <body class="loading" data-object-shell={objectRecord.id}>
    <div class="planet-view-readout" aria-label="View information">
      {DIAGNOSTICS_ENABLED && <button type="button" class="planet-diagnostic-record" data-diagnostic-record aria-label="Record diagnostic data" aria-pressed="false">Record</button>}
      <span class="planet-view-date" title="Date of the scene's prepared orbital positions (Terrestrial Time)" hidden>
        <span>Scene epoch: <span data-view-date></span></span>
        <span class="planet-view-separator" aria-hidden="true">·</span>
      </span>
      <span class="planet-view-coordinates" title="Coordinates at the center of the view" hidden>
        <span data-view-latitude></span>
        <span class="planet-view-separator" aria-hidden="true">·</span>
        <span data-view-longitude></span>
        <span class="planet-view-separator" aria-hidden="true">·</span>
      </span>
      <span class="planet-view-altitude" title="Camera altitude above the selected object's reference surface">
        <span data-view-distance-label>Altitude:</span> <span data-view-altitude>—</span>
      </span>
      <span class="planet-view-scale" hidden>
        <span class="planet-view-separator" aria-hidden="true">·</span>
        <span class="planet-view-ruler-slot" aria-hidden="true">
          <span class="planet-view-ruler"><span class="planet-view-measure"></span></span>
        </span>
        <span data-view-scale-label></span>
      </span>
    </div>
    <div class="planet-ui-layer">
      <slot name="planet-ui" />
    </div>
    <PlanetaryScale activeObjectId={objectRecord.id} />
    <div class="planet-viewport">
      <main
        class="planet-stage example-stage"
        data-object-id={objectRecord.id}
        aria-label={`Interactive 3D CSS visualization of ${objectRecord.name}`}
        aria-busy="true"
      ></main>
      <div class="planet-input-surface" tabindex="0" role="group" aria-label={`Explore ${objectRecord.name}`} />
      <div class="planet-scene-overlays">
        <div class="planet-project-links" role="group" aria-label="App and project actions">
          <a class="planet-report-issue-link" href="https://github.com/layoutit/cssEarth/issues" target="_blank" rel="noopener noreferrer">
            <span>Report issue</span>
          </a>
          <a class="planet-github-link" title="GitHub" aria-label={`GitHub v${__CSSEARTH_VERSION__}`} href="https://github.com/layoutit/cssEarth" target="_blank" rel="noopener noreferrer">
            <GitHubIcon />
            <span>v{__CSSEARTH_VERSION__}</span>
          </a>
          <button class="planet-codepen-link" type="button" disabled title="Export scene to CodePen (coming soon)" aria-label="Export scene to CodePen (coming soon)">
            <CodePenIcon />
          </button>
          <ExplorerRail objectId={objectRecord.id} />
        </div>
      </div>
    </div>
    <script>
      import "../scene-router.mjs";
    </script>
    <PreparedSidebarCards />
  </body>
</html>
