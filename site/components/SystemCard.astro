---
import ObjectCardHeader from './ObjectCardHeader.astro';
import ObjectBreadcrumbs from './ObjectBreadcrumbs.astro';
import ChildList from './ChildList.astro';
import ObjectFactsheet from './ObjectFactsheet.astro';
import InformationTabs from './InformationTabs.astro';
import Detached from './Detached.astro';
import { namesSystem } from '../world/navigation-scope.mts';
import { systemCard } from '../content/system-card.mts';

interface Props { hostId: string }
/** A system, as parts of its host's own card: its header, its tabs and the list of what is inside it. They are mounted
 * only while the system is the card's subject (`updateBodyCard` in object-shell-client.mts). A star's planetary system
 * and a planet's moons are one card: what differs is read from the system's object (system-card.mts). */
const { hostId } = Astro.props;
const card = systemCard(hostId);
const detached = !namesSystem(Astro.url);
const prefix = card?.system.id ?? '';
---

{card && <>
  <Detached {detached}><ObjectCardHeader title={{ label: card.system.name }} heading={false} introduction={card.system.description} data-view-part="system"
    data-source-subject={`object:${card.system.id}`} data-source-document={card.source.href} data-source-label={card.source.label}>
    <ObjectBreadcrumbs objectId={hostId} system />
  </ObjectCardHeader></Detached>
  <Detached {detached}><InformationTabs idPrefix={prefix} group="system" viewPart="system" label={`${card.system.name} information`}
    tabs={[{ id: 'bodies', label: 'Celestial bodies', count: card.count }, ...(card.facts ? [{ id: 'factsheet', label: 'Factsheet' }] : [])]} /></Detached>
  <Detached {detached}><div id={`${prefix}-bodies-content`} class="object-results-scroll object-card-tabpanel" data-view-part="system"
    role="region" aria-label={`Bodies in the ${card.system.name}`}>
    <ChildList objectId={card.system.id} />
  </div></Detached>
  {card.facts && <Detached detached><div id={`${prefix}-factsheet-content`} class="object-results-scroll object-card-tabpanel" data-view-part="system"
    data-information-panel="factsheet" data-information-group="system" role="region" aria-label="Factsheet">
    <ObjectFactsheet id={prefix} facts={card.facts} embedded />
  </div></Detached>}
</>}
