---
import type { PlanetTitle, Fact } from '../planet-shell-types';
interface Props { objectId: string; title: PlanetTitle; introduction?: string; facts?: Fact[]; moreFacts?: Fact[]; }
import '../body-overview.css';
import PlanetCardHeader from './PlanetCardHeader.astro';
import PlanetBreadcrumbs from './PlanetBreadcrumbs.astro';
import PlanetMoonList from './PlanetMoonList.astro';
import PlanetFactsheet from './PlanetFactsheet.astro';
import { prepareBodyMoons } from '../prepare-body-moons.mts';
import { prepareBodyOverview } from '../prepare-body-overview.mts';

const { objectId, title, introduction, facts = [], moreFacts = [] } = Astro.props;
const overview = await prepareBodyOverview(objectId);
const moons = prepareBodyMoons(objectId);
const tabs = [
  { id: 'moons', label: 'Moons' },
  { id: 'factsheet', label: 'Factsheet' },
  { id: 'spectrum', label: 'Spectrum' },
];
---

<PlanetCardHeader {title} data-body-overview data-has-portrait={overview.image ? true : undefined}>
  <PlanetBreadcrumbs {objectId} />
  <Fragment slot="image">
    {overview.image && <div class="planet-overview-portrait">
      <img class="planet-body-overview-image" src={overview.image}
        width="1200" height="630" alt={title.label} loading="lazy" decoding="async" />
    </div>}
    {introduction && <p class="planet-introduction">{introduction}</p>}
  </Fragment>
</PlanetCardHeader>
<div class="planet-object-tabs" data-body-overview role="tablist" aria-label="Body overview">
  {tabs.map((tab, index) => <button type="button" role="tab"
    id={`${objectId}-overview-${tab.id}-tab`} data-information-group="overview" data-information-tab={tab.id}
    aria-controls={`${objectId}-overview-${tab.id}-content`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
    <span>{tab.label}</span>
    {tab.id === 'moons' && <span class="planet-object-tab-count">({moons.length})</span>}
  </button>)}
</div>
<div class="planet-object-results-scroll planet-card-tabpanel" data-body-overview
  data-information-group="overview" data-information-panel="moons" id={`${objectId}-overview-moons-content`}
  role="tabpanel" aria-labelledby={`${objectId}-overview-moons-tab`} tabindex="0">
  <PlanetMoonList {moons} />
</div>
<div class="planet-object-results-scroll planet-card-tabpanel" data-body-overview
  data-information-group="overview" data-information-panel="factsheet" id={`${objectId}-overview-factsheet-content`}
  role="tabpanel" aria-labelledby={`${objectId}-overview-factsheet-tab`} tabindex="0" hidden>
  <PlanetFactsheet id={`${objectId}-overview`} {facts} {moreFacts} embedded />
</div>
<div class="planet-object-results-scroll planet-card-tabpanel" data-body-overview
  data-information-group="overview" data-information-panel="spectrum" id={`${objectId}-overview-spectrum-content`}
  role="tabpanel" aria-labelledby={`${objectId}-overview-spectrum-tab`} tabindex="0" hidden>
  {overview.spectrum ? <figure class="planet-overview-spectrum" aria-label={overview.spectrum.title}>
    <img src={overview.spectrum.src} width="300" height="90" alt={overview.spectrum.alt} loading="lazy" decoding="async" />
  </figure> : <p class="planet-object-empty">No reflectance spectrum available</p>}
</div>
