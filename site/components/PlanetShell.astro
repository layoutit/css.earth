---
import { OBJECTS } from "../objects.mjs";
import { PLANET_SEARCH_OBJECTS } from "../planet-search-objects.mjs";
import { PREPARED_SHELL_ICONS } from "../prepared-shell-icons.mjs";
import { PREPARED_SHELL_TITLES } from "../prepared-shell-titles.mjs";
import { orderScientificCharts } from "../scientific-chart-order.mjs";
import { requireObjectControls } from "../scene-contract.mjs";
import PlanetObjectResults from "./PlanetObjectResults.astro";
import SearchIcon from "./SearchIcon.astro";

interface PreparedIcon {
  label: string;
  src: string;
  width: number;
  height: number;
}

interface PreparedTitle {
  label: string;
  src: string;
  width: number;
  height: number;
}

interface PlanetTitle {
  label: string;
  viewBox: string;
  renderViewBox: string;
  renderWidth: number;
  renderHeight: number;
  renderPathOffsetY: number;
  path: string;
}

interface Fact {
  label: string;
  value: string;
  title?: string;
}

interface Chart {
  id: string;
  title: Pick<PreparedTitle, "label">;
  open?: boolean;
  src: string;
  width: number;
  height: number;
  alt: string;
}

interface GalleryItem {
  id: string;
  label: string;
  src: string;
  width: number;
  height: number;
  alt: string;
  caption: string;
  sourceUrl: string;
}

interface Gallery {
  id: string;
  title: PreparedTitle;
  open?: boolean;
  qualification?: string;
  items: GalleryItem[];
}

interface Lens {
  id: string;
  label: string;
  thumbnailUrl: string;
  description: string;
  title: string;
}

interface Setting {
  kind: "cycle" | "toggle";
  name: string;
  label: string;
  state?: string;
  checked?: boolean;
}

interface Resource {
  label: string;
  role: string;
  description: string;
  href: string;
}

interface Props {
  objectId: string;
  title: PlanetTitle;
  introduction?: string;
  facts?: Fact[];
  moreFacts?: Fact[];
  galleries?: Gallery[];
  charts?: Chart[];
  resources?: Resource[];
  lenses?: {
    title: PreparedTitle;
    controls: Lens[];
    defaultLens: string;
  };
  settings?: {
    title: PreparedTitle;
    controls: Setting[];
  };
}

declare const __CSSEARTH_VERSION__: string;

const {
  objectId,
  title,
  introduction = "",
  facts = [],
  moreFacts = [],
  galleries = [],
  charts = [],
  resources = [],
  lenses,
  settings,
} = Astro.props;
requireObjectControls({ lenses, settings }, objectId);
const allFacts = [...facts, ...moreFacts];
const hasFacts = allFacts.length > 0;
const hasLenses = Boolean(lenses && lenses.controls.length > 0);
const speedSetting = settings?.controls.find((setting) =>
  setting.kind === "cycle" && setting.name === "speed");
const shadowSetting = settings?.controls.find((setting) =>
  setting.kind === "toggle" && setting.name === "shadows");
const remainingSettings = settings?.controls.filter((setting) =>
  setting !== speedSetting && setting !== shadowSetting) ?? [];
const speedValues: Readonly<Record<string, number>> = Object.freeze({
  off: 0,
  normal: 1,
  fast: 2,
  fastest: 3,
  superfast: 4,
});
const initialSpeedState = speedSetting?.state ?? "normal";
const initialSpeedValue = speedValues[initialSpeedState] ?? 1;
const planetCount = PLANET_SEARCH_OBJECTS.length;
const activeObject = OBJECTS.find((object) => object.id === objectId);
const hasResources = resources.length > 0;
const orderedCharts = orderScientificCharts(charts);
const defaultChart = orderedCharts.find((chart) => chart.id === "reflectance") ??
  orderedCharts[0];
const chartIcons: Readonly<Record<string, PreparedIcon>> = Object.freeze({
  reflectance: PREPARED_SHELL_ICONS.reflectance,
  "temperature-pressure": PREPARED_SHELL_ICONS.temperaturePressure,
  "photometric-phase": PREPARED_SHELL_ICONS.photometricPhase,
});
---

<aside id={`${objectId}-sidebar`} class="planet-sidebar" aria-label="Planet information">
  <div class="planet-sidebar-search-card">
    <span class="planet-sidebar-search-icon">
      <SearchIcon />
    </span>
    <input
      class="planet-sidebar-search"
      type="search"
      placeholder={`Search objects (${planetCount})`}
      aria-label={`Search ${planetCount} objects`}
      autocomplete="off"
      value={activeObject?.name ?? ""}
    />
  </div>
  <section class="explorer-about-panel" id={`${objectId}-about`} aria-labelledby={`${objectId}-about-title`} hidden>
    <h2 id={`${objectId}-about-title`}>About</h2>
    <div class="explorer-about-content">
      <div class="explorer-about-introduction">
        <p>A 3D CSS planetary explorer. cssEarth renders planets as real HTML and CSS 3D geometry through <a href="https://github.com/LayoutitStudio/polycss">PolyCSS</a>, without a WebGL or canvas scene renderer.</p>
        <p>It preprocesses planetary data into browser-ready textures, charts, and retained scene plans, then lets you orbit and inspect one planet at a time.</p>
      </div>
      <div class="explorer-about-links" aria-label="About details">
        <div class="explorer-about-row">
          <span>Version</span>
          <span class="explorer-about-link-destination">v{__CSSEARTH_VERSION__}</span>
        </div>
        <a class="explorer-about-row explorer-about-link" href="https://github.com/layoutit/cssEarth">
          <span>Source code</span>
          <span class="explorer-about-link-destination">github.com/layoutit/cssEarth</span>
        </a>
        <a class="explorer-about-row explorer-about-link" href="mailto:agustin@lowpoly.gg">
          <span>Contact</span>
          <span class="explorer-about-link-destination">agustin@lowpoly.gg</span>
        </a>
      </div>
    </div>
  </section>
  <div class="planet-drawer-content" id={`${objectId}-information`}>
    <button class="planet-sheet-handle" type="button" aria-label="Resize information sheet" aria-expanded="false"></button>
    <nav
      id={`${objectId}-object-browser`}
      class="planet-object-browser maps-object-results"
      aria-label="Planets"
      hidden
    >
      <PlanetObjectResults activeObjectId={objectId} />
      <p class="planet-object-empty" aria-live="polite" hidden>No matching objects</p>
    </nav>
    <div class="planet-information-panel">
      <section class="planet-selected-panel">
        <div class="planet-title-row">
          <h1 class="planet-title" aria-label={title.label}>
            <svg
              class="planet-title-svg"
              viewBox={title.renderViewBox}
              width={title.renderWidth}
              height={title.renderHeight}
              aria-hidden="true"
              focusable="false"
            >
              <path
                d={title.path}
                transform={title.renderPathOffsetY === 0
                  ? undefined
                  : `translate(0 ${title.renderPathOffsetY})`}
              />
            </svg>
          </h1>
        </div>
        {introduction && <p class="planet-introduction">{introduction}</p>}
      </section>
      <details
        id={`${objectId}-factsheet-panel`}
        class="planet-factsheet-section"
        aria-labelledby={`${objectId}-factsheet-title`}
      >
        <summary class="planet-factsheet-header planet-panel-summary">
          <h2 id={`${objectId}-factsheet-title`} class="planet-panel-heading">Factsheet</h2>
          <img
            class="planet-panel-icon"
            data-panel-icon="facts"
            src={PREPARED_SHELL_ICONS.facts.src}
            width={PREPARED_SHELL_ICONS.facts.width}
            height={PREPARED_SHELL_ICONS.facts.height}
            alt=""
          />
        </summary>
        {hasFacts && <div class="planet-factsheet-body">
          <div class="planet-facts">
            <ul class="planet-primary-facts">
              {allFacts.map((fact) => (
                <li title={fact.title}>
                  <span class="planet-fact-label">{fact.label}</span>
                  <span class="planet-fact-value">{fact.value}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>}
      </details>
      {defaultChart && <section
        id={`${objectId}-charts`}
        class="planet-chart-switcher"
        data-active-chart={defaultChart.id}
        aria-labelledby={`${objectId}-charts-title`}
      >
        <header class="planet-chart-switcher-header">
          <h2
            id={`${objectId}-charts-title`}
            class="planet-panel-heading planet-chart-switcher-title"
            aria-live="polite"
          >
            {orderedCharts.map((chart) => (
              <span
                class="planet-chart-label"
                data-chart-label={chart.id}
                hidden={chart.id !== defaultChart.id}
              >{chart.title.label}</span>
            ))}
          </h2>
          <div class="planet-chart-switcher-controls" aria-label="Choose chart">
            <button
              class="planet-chart-step planet-chart-previous"
              type="button"
              data-chart-step="-1"
              aria-controls={`${objectId}-chart-slides`}
              aria-label="Previous chart"
              disabled={orderedCharts.length < 2}
            ><span aria-hidden="true">‹</span></button>
            <button
              class="planet-chart-step planet-chart-next"
              type="button"
              data-chart-step="1"
              aria-controls={`${objectId}-chart-slides`}
              aria-label="Next chart"
              disabled={orderedCharts.length < 2}
            ><span aria-hidden="true">›</span></button>
            <span class="planet-chart-current-icon" aria-hidden="true">
              {orderedCharts.map((chart) => chartIcons[chart.id] && (
                <img
                  class="planet-panel-icon planet-chart-icon"
                  data-panel-icon={chart.id}
                  data-chart-icon={chart.id}
                  src={chartIcons[chart.id].src}
                  width={chartIcons[chart.id].width}
                  height={chartIcons[chart.id].height}
                  alt=""
                  hidden={chart.id !== defaultChart.id}
                />
              ))}
            </span>
          </div>
        </header>
        <div id={`${objectId}-chart-slides`} class="planet-chart-slides">
          {orderedCharts.map((chart) => (
            <figure
              id={`${objectId}-${chart.id}`}
              class="planet-chart-slide"
              data-chart-id={chart.id}
              data-chart-title={chart.title.label}
              aria-label={chart.title.label}
              hidden={chart.id !== defaultChart.id}
            >
              <img
                class="planet-chart"
                src={chart.src}
                width={chart.width}
                height={chart.height}
                alt={chart.alt}
              />
            </figure>
          ))}
        </div>
      </section>}
      {hasLenses && lenses && <details id={`${objectId}-lenses`} class="planet-lenses" open>
        <summary class="planet-panel-summary">
          <h2 class="planet-panel-heading">{lenses.title.label}</h2>
          <img
            class="planet-panel-icon"
            data-panel-icon="lenses"
            src={PREPARED_SHELL_ICONS.lenses.src}
            width={PREPARED_SHELL_ICONS.lenses.width}
            height={PREPARED_SHELL_ICONS.lenses.height}
            alt=""
          />
        </summary>
        <div id={`${objectId}-layers-menu`} class="planet-layers-menu">
          <nav class="planet-observation-controls" aria-label="Surface lenses">
            {lenses.controls.map((lens) => (
              <div class="planet-observation-option">
                <button
                  class="planet-observation-control"
                  type="button"
                  name="lens"
                  value={lens.id}
                  aria-pressed={lens.id === lenses.defaultLens ? "true" : "false"}
                  title={lens.title}
                >
                  <img class="planet-lens-icon" src={lens.thumbnailUrl} width="14" height="14" alt="" />
                  <span class="planet-lens-copy">
                    <span class="planet-lens-label">{lens.label}</span>
                    <span class="planet-lens-description">{lens.description}</span>
                  </span>
                </button>
              </div>
            ))}
          </nav>
        </div>
      </details>}
      {galleries.map((gallery) => (
      <details id={`${objectId}-${gallery.id}`} class="planet-gallery-panel">
        <summary class="planet-panel-summary">
          <h2 class="planet-panel-heading">{gallery.title.label}</h2>
          <span class="planet-panel-toggle" aria-hidden="true"></span>
        </summary>
        <div class="planet-gallery" aria-label={gallery.title.label}>
          {gallery.items.map((item) => (
            <figure class="planet-gallery-item" data-gallery-item={item.id}>
              <img
                class="planet-gallery-image"
                src={item.src}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="planet-gallery-caption">
                <strong>{item.label}</strong>
                <span>{item.caption}</span>
                <a class="planet-gallery-source" href={item.sourceUrl} target="_blank" rel="noreferrer">Archive file</a>
              </figcaption>
            </figure>
          ))}
          {gallery.qualification && <p class="planet-gallery-qualification">{gallery.qualification}</p>}
        </div>
      </details>
      ))}
      {hasResources && <details id={`${objectId}-resources`} class="planet-resources-panel">
        <summary class="planet-panel-summary">
          <h2 class="planet-panel-heading">{PREPARED_SHELL_TITLES.resources.label}</h2>
          <img
            class="planet-panel-icon"
            data-panel-icon="resources"
            src={PREPARED_SHELL_ICONS.resources.src}
            width={PREPARED_SHELL_ICONS.resources.width}
            height={PREPARED_SHELL_ICONS.resources.height}
            alt=""
          />
        </summary>
        <div class="planet-resources-links">
          {resources.map((resource) => (
            <a
              class="planet-resource-row"
              href={resource.href}
              title={resource.description}
              target="_blank"
              rel="noreferrer"
            >
              <span class="planet-resource-description">{resource.description}</span>
              <span class="planet-resource-label">{resource.label}</span>
            </a>
          ))}
        </div>
      </details>}

    </div>
    <button
      class="planet-sidebar-view-all"
      type="button"
      aria-controls={`${objectId}-object-browser`}
      aria-label="View all objects"
      aria-pressed="false"
    >×</button>
  </div>
<section
  id={`${objectId}-settings`}
  class="planet-settings-panel explorer-settings-panel"
  aria-labelledby={`${objectId}-settings-title`}
  hidden
>
  <h2 id={`${objectId}-settings-title`}>{PREPARED_SHELL_TITLES.settings.label}</h2>
  <div class="planet-settings">
    <label class="planet-setting-control planet-motion-setting-control">
      <input class="planet-motion-setting" type="checkbox" name="motion" />
      <span class="planet-setting-text">Motion</span>
      <span class="planet-setting-switch" aria-hidden="true"></span>
      <span id={`${objectId}-motion-blocked`} class="planet-motion-blocked" hidden>
        Paused by reduced motion
      </span>
    </label>
    {speedSetting && <label class="planet-setting-control planet-speed-setting-control">
      <span class="planet-setting-text">{speedSetting.label}</span>
      <input
        id={`${objectId}-speed-setting`}
        class="planet-speed-setting"
        type="range"
        name={speedSetting.name}
        min="0"
        max="4"
        step="1"
        value={initialSpeedValue}
        data-state={initialSpeedState}
        aria-label={`${speedSetting.label}: ${initialSpeedState}`}
        disabled
      />
    </label>}
    {shadowSetting && <label class="planet-setting-control">
      <input type="checkbox" name={shadowSetting.name} checked={shadowSetting.checked} />
      <span class="planet-setting-text">{shadowSetting.label}</span>
      <span class="planet-setting-switch" aria-hidden="true"></span>
    </label>}
    <label class="planet-setting-control planet-sky-contrast-setting-control">
      <input
        class="planet-sky-contrast-setting"
        type="checkbox"
        name="skyContrast"
      />
      <span class="planet-setting-text">High contrast</span>
      <span class="planet-setting-switch" aria-hidden="true"></span>
    </label>
    {remainingSettings.map((setting) => setting.kind === "cycle" ? (
      <button class="planet-setting-control" type="button" name={setting.name} data-state={setting.state} aria-label={`${setting.label}: ${setting.state}`}>
        <span class="planet-setting-text">{setting.label}</span>
      </button>
      ) : (
      <label class="planet-setting-control">
        <input type="checkbox" name={setting.name} checked={setting.checked} />
        <span class="planet-setting-text">{setting.label}</span>
        <span class="planet-setting-switch" aria-hidden="true"></span>
      </label>
      ))}
      </div>
    </section>
</aside>
{hasResources && <footer
  class="planet-attribution-footer"
  aria-label={`${title.label} scene sources`}
>
  {resources.map((resource, index) => (
    <>
      {index > 0 && <span class="planet-attribution-separator" aria-hidden="true">·</span>}
      <a
        class="planet-attribution-link"
        href={resource.href}
        title={resource.description}
        target="_blank"
        rel="noreferrer"
      >
        <span class="planet-attribution-role">{resource.role}</span>
        <span class="planet-attribution-source">{resource.label}</span>
      </a>
    </>
  ))}
</footer>}
