---
import { DIAGNOSTICS_ENABLED } from "../diagnostics-policy.mts";
import ObjectInformationPanel from "./ObjectInformationPanel.astro";
import PreparedClusterFacts from './PreparedClusterFacts.astro';
import { CONTEXT_AVAILABILITY } from '../context-availability.mts';
import type { Props } from "../object-shell-types";
import { OVERVIEWS, SCENE_OBJECTS } from "../objects.mts";
import { PREPARED_SHELL_TITLES } from "../prepared-shell-titles.mjs";
import { requireObjectControls } from "@cssearth/renderer/runtime/shell-contract.ts";
import SourcesLink from './SourcesLink.astro';
import ObjectResults from "./ObjectResults.astro";
import MaterialSymbol from "./MaterialSymbol.astro";
import GitHubIcon from "./GitHubIcon.astro";
import CssEarthWordmark from "./CssEarthWordmark.astro";
import OverviewCard from './OverviewCard.astro';
import ObjectCard from './ObjectCard.astro';
import SystemHeaders from './SystemHeaders.astro';
import SystemBodies from './SystemBodies.astro';
import ObjectBreadcrumbs from './ObjectBreadcrumbs.astro';
import InformationTabs from './InformationTabs.astro';
import Accordion from './Accordion.astro';
import { SOLAR_SYSTEM_ID, systemOfObject } from '../object-systems.mts';
import { SEARCH_QUERY_LIMIT } from '../search/object-search.mts';

declare const __CSSEARTH_VERSION__: string;

const {
  objectId,
  datasets,
  settings,
  destinations,
  features,
  navigation = false,
} = Astro.props;
requireObjectControls({ datasets, settings }, objectId);
// The page: its scene's, or a catalogue subject or overview the scene draws. Its forms and links return to that page.
const pageId = Astro.params.id ?? objectId;
const pageRoute = pageId !== objectId ? `/${pageId}/` : undefined;
const speedSetting = settings?.controls.find((setting) =>
  setting.kind === "cycle" && setting.name === "speed");
const shadowSetting = settings?.controls.find((setting) =>
  setting.kind === "toggle" && setting.name === "shadows");
const remainingSettings = settings?.controls.filter((setting) =>
  setting !== speedSetting && setting !== shadowSetting) ?? [];
const speedValues: Readonly<Record<string, number>> = Object.freeze({
  off: 0,
  normal: 1,
  fast: 2,
  fastest: 3,
  superfast: 4,
});
const initialSpeedState = speedSetting?.state ?? "normal";
const initialSpeedValue = speedValues[initialSpeedState] ?? 1;
const activeObject = SCENE_OBJECTS.find((object) => object.id === objectId);
const ownSystem = systemOfObject(SCENE_OBJECTS, objectId);
const searchPlaceholder = `Search ${new Intl.NumberFormat('en-US').format(SCENE_OBJECTS.length)} celestial bodies...`;
const searchFormId = `${objectId}-search`;
// Each pill types the plural classification query the search already understands.
const searchCategories = [
  { classification: 'planet', icon: 'public', label: 'Planets' },
  { classification: 'satellite', icon: 'moon_stars', label: 'Moons' },
  { classification: 'comet', icon: 'motion_blur', label: 'Comets' },
  { classification: 'asteroid', icon: 'grain', label: 'Asteroids' },
  { classification: 'star', icon: 'asterisk', label: 'Stars' },
  { classification: 'nebula', icon: 'grain', label: 'Nebulae' },
  { classification: 'galaxy', icon: 'public', label: 'Galaxies' },
] as const;
---

<header class="explorer-shell-header">
  <span class="explorer-navigation-progress" role="progressbar" aria-label="Loading destination" aria-hidden="true"><span></span></span>
  <div class="explorer-brand-row">
    <div class="explorer-shell-wordmark">
      <CssEarthWordmark />
    </div>
    <a class="explorer-brand-version" title="GitHub" aria-label={`GitHub v${__CSSEARTH_VERSION__}`} href="https://github.com/layoutit/cssEarth" target="_blank" rel="noopener noreferrer">v{__CSSEARTH_VERSION__}</a>
  </div>
  <div class="object-search-toolbar">
    <div class="object-search-browser-shell">
      <form id={searchFormId} class="object-sidebar-search-card" role="search" aria-label="Object search"
        action={pageRoute ?? activeObject?.route} method="get" data-search-object={objectId} data-search-prompt={searchPlaceholder}>
        {['v', 'view', 'overview', 'dataset', 'feature'].map(name => <input type="hidden" name={name} data-search-context disabled />)}
        <span class="object-sidebar-search-icon" aria-hidden="true">
          <MaterialSymbol name="search" />
        </span>
        <input
          class="object-sidebar-search"
          type="search"
          name="q"
          maxlength={SEARCH_QUERY_LIMIT}
          placeholder={searchPlaceholder}
          aria-label={searchPlaceholder}
          aria-controls={`${objectId}-object-browser`}
          autocomplete="off"
        />
        <a class="object-sidebar-search-clear" href={pageRoute ?? activeObject?.route} aria-label="Clear search" title="Clear search">
          <MaterialSymbol name="close" />
        </a>
      </form>
    </div>
  </div>
  <div class="object-search-categories" role="group" aria-label="Browse by type">
    {searchCategories.map(category => <button
      class="object-search-category"
      type="submit" form={searchFormId} name="browse" value={category.label}
      data-search-query={category.label}
      data-search-classification={category.classification}
      aria-pressed="false"
    ><MaterialSymbol name={category.icon} /><span>{category.label}</span></button>)}
  </div>
  <div class="object-header-actions" role="group" aria-label="App actions">
    <a class="object-header-link" href="https://github.com/layoutit/cssEarth" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
      <GitHubIcon />
    </a>
    <button class="object-header-action object-settings-action" type="button" popovertarget="object-settings"
      aria-label="Settings" title="Settings" aria-controls="object-settings">
      <MaterialSymbol name="settings" />
    </button>
    <label class="object-header-action object-facility-action" title="Machines">
      <input class="object-facility-toggle" type="checkbox" aria-label="Machines" checked />
      <MaterialSymbol name="satellite_alt" />
    </label>
  </div>
</header>
<div class="object-dataset-context-dock">
<form id="object-settings-form" action={pageRoute ?? `/${objectId}/`} method="get" data-settings-form hidden>
  <input type="hidden" name="settings" value="1" />
  {['v', 'view', 'overview', 'dataset', 'feature'].map(name => <input type="hidden" name={name} data-view-context disabled />)}
</form>
<section
  id="object-settings"
  class="object-settings-panel explorer-settings-panel"
  aria-labelledby="object-settings-title"
  popover="auto"
>
  <h2 id="object-settings-title">{PREPARED_SHELL_TITLES.settings.label}</h2>
  <div class="object-settings">
    <label class="object-setting-control object-motion-setting-control">
      <input class="object-motion-setting" type="checkbox" name="motion" aria-describedby="object-motion-description" disabled />
      <span class="object-setting-text">Illustrative rotation</span>
      <span class="object-setting-switch" aria-hidden="true"></span>
      <span id="object-motion-blocked" class="object-motion-blocked" hidden>
        Paused by reduced motion
      </span>
    </label>
    <p id="object-motion-description" class="object-motion-description">Accelerated display rotation. The scene epoch stays fixed.</p>
    <label class="object-setting-control object-light-curves-setting-control">
      <input class="object-light-curves-setting" type="checkbox" name="lightCurves" aria-describedby="object-light-curves-description" checked disabled />
      <span class="object-setting-text">Light curves</span>
      <span class="object-setting-switch" aria-hidden="true"></span>
    </label>
    <p id="object-light-curves-description" class="object-motion-description">Pulsating stars brighten and fade as measured, three days per second.</p>
    {speedSetting && <label class="object-setting-control object-speed-setting-control">
      <span class="object-setting-text">{speedSetting.label}</span>
      <input
        id="object-speed-setting"
        class="object-speed-setting"
        type="range"
        name={speedSetting.name}
        form="object-settings-form"
        min="0"
        max="4"
        step="1"
        value={initialSpeedValue}
        data-state={initialSpeedState}
        aria-label={`${speedSetting.label}: ${initialSpeedState}`}
        disabled
      />
    </label>}
    {shadowSetting && <label class="object-setting-control">
      <input type="checkbox" name={shadowSetting.name} checked={shadowSetting.checked} form="object-settings-form" />
      <span class="object-setting-text">{shadowSetting.label}</span>
      <span class="object-setting-switch" aria-hidden="true"></span>
    </label>}
    <label class="object-setting-control object-surface-labels-setting-control">
      <input class="object-surface-labels-setting" type="checkbox" name="surfaceLabels" disabled />
      <span class="object-setting-text">Surface labels</span>
      <span class="object-setting-switch" aria-hidden="true"></span>
    </label>
    <label class="object-setting-control object-three-d-stars-setting-control">
      <input class="object-three-d-stars-setting" type="checkbox" name="threeDStars" disabled />
      <span class="object-setting-text">3D stars</span>
      <span class="object-setting-switch" aria-hidden="true"></span>
    </label>
    <label class="object-setting-control">
      <input class="object-heliosphere-setting" type="checkbox" name="heliosphere" disabled />
      <span class="object-setting-text">Heliosphere</span>
      <span class="object-setting-switch" aria-hidden="true"></span>
    </label>
    <label class="object-setting-control">
      <input class="object-illustration-models-setting" type="checkbox" name="illustrationModels" aria-describedby="object-illustration-models-description" disabled />
      <span class="object-setting-text">Illustration models</span>
      <span class="object-setting-switch" aria-hidden="true"></span>
    </label>
    <p id="object-illustration-models-description" class="object-motion-description">Approximate stand-ins only. Body-specific meshes remain available without imagery.</p>
    {remainingSettings.map((setting) => setting.kind === "cycle" ? (
      <button class="object-setting-control" type="button" name={setting.name} data-state={setting.state} aria-label={`${setting.label}: ${setting.state}`}>
        <span class="object-setting-text">{setting.label}</span>
      </button>
      ) : (
      <label class="object-setting-control">
        <input type="checkbox" name={setting.name} checked={setting.checked} form="object-settings-form" />
        <span class="object-setting-text">{setting.label}</span>
        <span class="object-setting-switch" aria-hidden="true"></span>
      </label>
      ))}
    <button class="object-setting-control object-settings-submit" type="submit" form="object-settings-form">Apply settings</button>
  </div>
</section>
</div>
<div class="object-sidebar-frame">
<aside id={`${objectId}-sidebar`} class="object-sidebar" data-has-destinations={destinations ? "true" : undefined} aria-label="Object information">
  <div class="object-drawer-content" id={`${objectId}-information`}>
    <input class="object-sheet-handle" type="checkbox" aria-label="Expand information sheet" aria-controls={`${objectId}-information`} />
    {!navigation && <nav
      id={`${objectId}-object-browser`}
      class="object-browser maps-object-results"
      aria-label="Celestial bodies"
      hidden
    >
      <ObjectResults>
        <Accordion title="Named features" count={0} class="object-feature-results"
          aria-label={features?.searchLabel ?? 'Named features'} hidden>
          <p class="object-feature-hint object-destination-hint" role="status"></p>
          <ul class="object-destination-list">
            {Array.from({ length: 8 }, () => <li hidden>
              <a class="object-destination-result">
                <span class="object-destination-result-name"></span>
                <span class="object-destination-result-context"></span>
              </a>
            </li>)}
          </ul>
        </Accordion>
      </ObjectResults>
    </nav>}
    <div class="object-selected-content">
    {!navigation && <div class="object-context" hidden><ObjectCard class="object-prepared-information-panel" data-prepared-focus-card hidden>
        <section class="object-selected-panel">
          {OVERVIEWS.map(({ id }) =>
            <ObjectBreadcrumbs scope={id} currentPage={false} data-focus-breadcrumb-scope={id} hidden />)}
          <div class="object-title-row">
            <p class="object-title object-title-text" data-focus-name></p>
            <div class="object-title-tags"><span class="object-classification-tag object-title-tag" data-focus-status></span></div>
          </div>
          <p class="object-introduction" data-focus-introduction hidden></p>
          <a class="object-learn-more-link" data-focus-learn-more target="_blank" rel="noopener noreferrer" hidden>Learn more ↗</a>
          <p class="object-introduction" data-focus-unavailable role="status" hidden
            data-unavailable-objects={Object.entries(CONTEXT_AVAILABILITY).filter(([, state]) => !state.available).map(([id]) => id).join(' ')}></p>
        </section>
        <InformationTabs idPrefix="prepared-focus" group="prepared-focus" tabs={[{id: 'dataset', label: 'Datasets'}, {id: 'factsheet', label: 'Factsheet'}]} />
        <div class="object-card-tabpanel" id="prepared-focus-dataset-content" data-information-panel="dataset"
          data-information-group="prepared-focus" role="region" aria-label="Datasets">
          {/* The dataset banks are the same on every page; the first focus selection fetches them (`site/focus-fragment.mts`). */}
          <div data-focus-banks-slot="datasets" hidden></div>
          {/* The one shell-level 3D-stars setting owns every 3D point layer, including catalogue points inside prepared volumes. */}
          <style is:inline>
            .object-ui-layer:has(.object-three-d-stars-setting:not(:checked)) ~ .object-viewport .prepared-catalogue-points { display: none !important; }
          </style>
        </div>
        <div class="object-card-tabpanel" id="prepared-focus-factsheet-content" data-information-panel="factsheet"
          data-information-group="prepared-focus" role="region" aria-label="Factsheet">
          <div class="object-factsheet-body"><div class="object-facts"><ul class="object-primary-facts">
            <li data-focus-aliases-row hidden><span class="object-fact-label">Also known as</span><span class="object-fact-value" data-focus-aliases></span></li>
            {[['distance', 'Observer distance'], ['uncertainty', 'Distance uncertainty'], ['membership', 'Membership'], ['association', 'Association']].map(([id, label]) =>
              <li><span class="object-fact-label" data-focus-fact-label={id}>{label}</span><span class="object-fact-value" {...{ [`data-focus-${id}`]: '' }}></span></li>)}
          </ul></div></div>
          <div data-focus-banks-slot="facts" hidden></div>
          <PreparedClusterFacts />
        </div>
      </ObjectCard>
      {OVERVIEWS.map(overview => <OverviewCard {overview} />)}
      <ObjectCard class="object-overview-card" data-system-results>
        {/* The Solar System's header and this page's own; the others arrive with the first overview of another system. */}
        <SystemHeaders only={[SOLAR_SYSTEM_ID, ...(ownSystem ? [ownSystem.id] : [])]} />
        <span data-system-headers-slot hidden></span>
        {/* A dataset authored for the whole system, like a debris disc, belongs to the system, not to its star:
            the shell moves those options here while the system is the selection, and back to the body card when it is not. */}
        <div class="object-datasets object-system-datasets" data-system-datasets hidden>
          <nav class="object-observation-controls" aria-label="Datasets" data-system-dataset-options></nav>
          <div class="object-dataset-details" data-system-dataset-details></div>
        </div>
        {/* A telescope's picture of the whole system, kept in its star's gallery, is shown here while the system is the selection. */}
        <div class="object-system-galleries" data-system-galleries hidden></div>
        <div data-system-bodies-slot>
          {Astro.url.searchParams.get('overview') === 'system' && <SystemBodies systemId={ownSystem?.id ?? SOLAR_SYSTEM_ID} />}
        </div>
      </ObjectCard></div>}
    {/* Every page carries the selected-city panel: a visit that starts on another body can open a city on Earth. */}
    <section class="object-destination-panel" aria-label="Selected city" hidden>
      <button class="object-destination-back" type="button">← Back to {activeObject?.name}</button>
      <h2 class="object-destination-name"></h2>
      <p class="object-destination-context"></p>
      <p class="object-destination-status" role="status"></p>
    </section>
    <ObjectInformationPanel {...Astro.props} />
    <div class="object-sheet-sources"><SourcesLink objectId={objectId} name={Astro.props.title.label} /></div>
    </div>
  </div>
</aside>
</div>

<footer class="object-footer" aria-label="View information">
    <div class="object-view-readout" aria-label="View information">
      <SourcesLink objectId={objectId} name={Astro.props.title.label} />
      <a class="explorer-brand-version" title="GitHub" aria-label={`GitHub v${__CSSEARTH_VERSION__}`} href="https://github.com/layoutit/cssEarth" target="_blank" rel="noopener noreferrer">v{__CSSEARTH_VERSION__}</a>
      <span class="object-view-context">
        {DIAGNOSTICS_ENABLED && <button type="button" class="object-diagnostic-record" data-diagnostic-record aria-label="Record diagnostic data" aria-pressed="false" hidden>Record</button>}
        <span class="object-view-date" title="Date of the scene's prepared orbital positions (Terrestrial Time)" hidden>
          <span>Epoch: <span data-view-date></span></span>
          <span class="object-view-separator" aria-hidden="true">·</span>
        </span>
        <span class="object-view-coordinates" title="Coordinates at the center of the view" hidden>
          <span data-view-latitude></span>
          <span class="object-view-separator" aria-hidden="true">·</span>
          <span data-view-longitude></span>
          <span class="object-view-separator" aria-hidden="true">·</span>
        </span>
      </span>
      <span class="object-view-altitude" title="Camera altitude above the selected object's reference surface">
        <span data-view-distance-label>Altitude:</span> <span data-view-altitude>—</span>
      </span>
      <span class="object-view-scale" hidden>
        <span class="object-view-separator" aria-hidden="true">·</span>
        <span class="object-view-ruler-slot" aria-hidden="true">
          <span class="object-view-ruler"><span class="object-view-measure"></span></span>
        </span>
        <span data-view-scale-label></span>
      </span>
    </div>
</footer>
