---
import type { Props as ShellProps } from '../contracts/object-shell-types';
interface Props { objectId: string; dataset: NonNullable<ShellProps['datasets']>['controls'][number];
  /** The dataset this legend is shown under, when it is borrowed from another one; it keeps the element ids unique. */
  owner?: string; }
const { objectId, dataset, owner } = Astro.props;
const slot = owner === undefined || owner === dataset.id ? dataset.id : `${owner}-${dataset.id}`;
// Only render the dataset's declared meaning and scale.
const legend = dataset.legend;
const categories = legend?.kind === 'categories' ? legend.items : undefined;
const colors = categories?.map(item => item.color) ?? legend?.colors;
const scaleLabel = `${legend?.title ?? ''}${legend?.meta ? ` (${legend.meta})` : ''}`;
const labels = categories?.map(item => ({ text: item.label, detail: item.description }))
  ?? legend?.labels?.map(text => ({ text })) ?? [];
// The scale's unit and stretch run the card's full width under the ticks; appended to the last tick they wrapped
// inside its narrow column.
const meta = categories ? undefined : legend?.meta;
// The shell explains the shared no-data grid once, so dataset text never repeats it.
const noData = dataset.noData === true;
---
{(legend || noData) && <section id={`${objectId}-${slot}-legend`} class="object-dataset-legend-panel"
  data-dataset-legend={slot} aria-label={`${dataset.label} legend`}>
  {legend && <div class="object-dataset-legend-scale-row">
    {legend?.src
      ? <img class="object-dataset-legend-scale" src={legend.src}
          width={legend.width} height={legend.height} alt={scaleLabel} loading="lazy" decoding="async" />
      : colors && <span class="object-dataset-legend-scale object-dataset-legend-segments" role="img" aria-label={scaleLabel}>
          {colors?.map(color => <span class="object-dataset-legend-segment"
            style={`--object-dataset-legend-color: ${color}`} aria-hidden="true"></span>)}
        </span>}
  </div>}
  {legend && (categories ? <ul class="object-dataset-legend-categories">
    {categories.map(item => <li>
      <span class="object-dataset-legend-swatch" style={`--object-dataset-legend-color: ${item.color}`} aria-hidden="true"></span>
      <span class="object-dataset-legend-category-label">{item.label}</span>
      <span class="object-dataset-legend-category-description">{item.description}</span>
    </li>)}
  </ul> : <div class="object-dataset-legend-labels" style={`--legend-label-count: ${labels.length}`}>
    {labels.map(label => <span>{label.text}</span>)}
  </div>)}
  {meta && <p class="object-dataset-legend-meta">{meta}</p>}
  {noData && <p class="object-dataset-legend-no-data">
    <svg class="object-dataset-legend-no-data-swatch" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
      <rect width="12" height="12" fill="#525452" />
      <path d="M0 4.5H12M0 9.5H12M4.5 0V12M9.5 0V12" stroke="#70736f" stroke-width="1" />
    </svg>
    No data
  </p>}
</section>}
