---
const { objectId, lens } = Astro.props;
// Only render the dataset's declared meaning and scale.
const legend = Array.isArray(lens.legend)
  ? { kind: 'categories', title: lens.label, items: lens.legend }
  : lens.legend;
const categories = legend?.kind === 'categories' ? legend.items : undefined;
const colors = categories?.map(item => item.color) ?? legend?.colors;
const scaleLabel = `${legend?.title ?? ''}${legend?.meta ? ` (${legend.meta})` : ''}`;
const labels = categories?.map(item => ({ text: item.label, detail: item.description }))
  ?? legend?.labels?.map((text, index) => ({
    text: `${text}${index === legend.labels.length - 1 && legend.meta ? ` ${legend.meta}` : ''}`,
  })) ?? [{ text: 'No legend supplied' }];
---
<section id={`${objectId}-${lens.id}-legend`} class="planet-lens-legend-panel"
  data-lens-legend={lens.id} aria-label={`${lens.label} legend`}>
  <div class="planet-lens-legend-scale-row">
    {legend?.src
      ? <img class="planet-lens-legend-scale" src={legend.src}
          width={legend.width} height={legend.height} alt={scaleLabel} />
      : colors && <span class="planet-lens-legend-scale planet-lens-legend-segments" role="img" aria-label={scaleLabel}>
          {colors?.map(color => <span class="planet-lens-legend-segment"
            style={`--planet-lens-legend-color: ${color}`} aria-hidden="true"></span>)}
        </span>}
  </div>
  {categories ? <ul class="planet-lens-legend-categories">
    {categories.map(item => <li>
      <span class="planet-lens-legend-swatch" style={`--planet-lens-legend-color: ${item.color}`} aria-hidden="true"></span>
      <span class="planet-lens-legend-category-label">{item.label}</span>
      <span class="planet-lens-legend-category-description">{item.description}</span>
    </li>)}
  </ul> : <div class="planet-lens-legend-labels" style={`--legend-label-count: ${labels.length}`}>
    {labels.map(label => <span>{label.text}</span>)}
  </div>}
</section>
