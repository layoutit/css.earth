---
import type { HTMLAttributes } from 'astro/types';
import type { SourceGroup } from '../dataset-context.mts';
interface Props extends HTMLAttributes<'li'>, Partial<SourceGroup> {}
const { links = [], credit, supporting = [], ...attributes } = Astro.props;
---
<li {...attributes} class="planet-resource-row">
  <slot />
  {links.map(link => <a class="planet-resource-label" data-source={link.id} href={link.href} target="_blank" rel="noreferrer">{link.title}</a>)}
  {credit && <span class="planet-resource-description">{credit}</span>}
  {supporting.length > 0 && <details class="planet-resource-supporting">
    <summary>{supporting.length} supporting {supporting.length === 1 ? 'file' : 'files'}</summary>
    {supporting.map(link => <a class="planet-resource-label" data-source={link.id} href={link.href} target="_blank" rel="noreferrer">{link.title}</a>)}
  </details>}
</li>
