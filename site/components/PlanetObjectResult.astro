---
import { objectClassificationLabel } from "../planet-search-objects.mjs";
import PlanetNavigationMarker from "./PlanetNavigationMarker.astro";
import { PREPARED_NAVIGATION_MARKERS } from "../prepared-navigation-markers.mjs";

const { object, activeObjectId, hidden = false } = Astro.props;
// Fit the disks together so relative sizes survive without rings shrinking them.
const thumbnailScale = 14 / Math.max(...Object.values(PREPARED_NAVIGATION_MARKERS).map(
  ({ presentation }) => presentation.size,
));
---

<li class="planet-object-item" hidden={hidden} data-object-name={object.name.toLocaleLowerCase("en")}
  data-object-distance-au={object.distanceAu}
  data-object-system-name={object.systemName.toLocaleLowerCase("en")}
  data-object-classification={object.classification}
  data-object-classification-name={objectClassificationLabel(object.classification).toLocaleLowerCase("en")}>
    <a class:list={["planet-object-link planet-observation-control planet-thumbnail-leading", { "is-active": object.id === activeObjectId }]}
      href={object.route} data-object-id={object.id}
      aria-current={object.id === activeObjectId ? "page" : undefined}>
      <span class="planet-lens-icon">
        <PlanetNavigationMarker planetId={object.id} color={object.color} scale={thumbnailScale} />
      </span>
      <span class="planet-object-name planet-lens-label">{object.name}</span>
      <span class="planet-object-distance planet-lens-detail">
        <span class="planet-object-distance-value">{Number(object.distanceAu.toFixed(3))}</span>{" "}
        <span class="planet-object-distance-unit">AU</span>
      </span>
    </a>
</li>
