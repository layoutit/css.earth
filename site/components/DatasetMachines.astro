---
import { uniqueCitations } from '../sources-catalog.mts';
import SourceCitations from './SourceCitations.astro';
import type { MissionRecord } from '../../src/platform/exploration-catalog.mts';
import { EXPLORATION, referenceUrl, missionDatasets } from '../exploration-catalog.mts';
import SelectedContent from './SelectedContent.astro';
import MachineDetails from './MachineDetails.astro';
interface Props { objectId: string; missions: readonly MissionRecord[]; visibleMissionIds?: readonly string[]; }
const { objectId, missions, visibleMissionIds } = Astro.props;
const dateRange = (mission: MissionRecord) => mission.started ? `${mission.started.value}${mission.ended ? `–${mission.ended.value}` : ''}` : null;
const contributors = (missionId: string) => new Set((EXPLORATION.graph.byMission[missionId] ?? []).map(index => EXPLORATION.graph.edges[index])
  .filter(edge => edge.objectId === objectId && edge.lensIds.length).flatMap(edge => edge.attribution.kind === 'machine' ? [edge.attribution.machineId] : []));
---
{missions.length > 0 && <div class="planet-dataset-machines" aria-label="Contributing missions">
  {missions.map(mission => {
    const image = mission.imageId ? EXPLORATION.images[mission.imageId] : null;
    const emblem = mission.emblemId ? EXPLORATION.emblems[mission.emblemId] : null;
    const vehicles = contributors(mission.id);
    const references = uniqueCitations([mission.name, ...(mission.shortName ? [mission.shortName] : []), mission.description, mission.agencyIds, ...(mission.started ? [mission.started] : []), ...(mission.ended ? [mission.ended] : []), ...(mission.status ? [mission.status] : [])].flatMap(field => field.citations).concat(mission.participants.flatMap(member => member.citations)));
    return <article class="planet-machine" data-mission={mission.id} hidden={visibleMissionIds && !visibleMissionIds.includes(mission.id)}>
      <SelectedContent title={mission.shortName?.value ?? mission.name.value} lead={mission.shortName && mission.name.value} metadata={dateRange(mission)} description={mission.description.value} href={referenceUrl(mission.description)}>
        {(image || emblem) && <div class="planet-machine-preview">
          {image && <a class="planet-machine-image-link" href={image.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${mission.name.value} mission artwork — ${image.credit}`}>
            <img class="planet-machine-image" src={image.src} width={image.width} height={image.height} alt={`${mission.name.value} mission illustration`} loading="lazy" decoding="async" />
          </a>}
          {emblem && <a class="planet-machine-emblem" href={emblem.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${mission.name.value} mission emblem — ${emblem.credit}`}>
            <img src={emblem.src} width={emblem.width} height={emblem.height} alt={`${mission.name.value} mission emblem`} loading="lazy" decoding="async" />
          </a>}
        </div>}
      </SelectedContent>
      {mission.status && <p class="planet-mission-status"><a href={referenceUrl(mission.status)} target="_blank" rel="noreferrer">{mission.status.value.value}</a> as of {mission.status.value.asOf}</p>}
      <h4>Dataset views on this body</h4>
      <ul class="planet-mission-datasets">{missionDatasets(mission.id, objectId).map(view => <li><a href={view.href} data-dataset-link data-dataset-object={view.objectId} data-dataset-id={view.lensId}>{view.label}</a></li>)}</ul>
      <h4>Machines</h4>
      {mission.participants.map(member => <MachineDetails machineId={member.machineId} {objectId} contributed={vehicles.has(member.machineId)} missionDescription={mission.description.value} />)}
      <details class="planet-mission-references"><summary>Mission references</summary><SourceCitations citations={references} /></details>
    </article>;
  })}
</div>}
