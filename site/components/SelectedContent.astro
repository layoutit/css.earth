---
interface Props { title: string; metadata?: string | null; lead?: string; description?: string; }
const { title, metadata, lead, description } = Astro.props;
---
<slot name="header">
  <h3 class="object-lens-details-title">{title}{metadata && <span class="object-selected-content-meta"> ({metadata})</span>}</h3>
</slot>
<slot />
<p class="object-lens-details-copy">{lead && <><strong class="object-lens-details-lead">{lead}.</strong> </>}{description}</p>
