---
import type { NebulaSearchEntry } from '../prepare-nebula-search.mts';
import MaterialSymbol from './MaterialSymbol.astro';
interface Props { object: NebulaSearchEntry; hidden?: boolean; }
const { object, hidden = false } = Astro.props;
---
<li class="planet-object-item" role="listitem" hidden={hidden}
  data-object-name={object.name.toLocaleLowerCase('en')}
  data-object-search-names={JSON.stringify(object.searchNames)}
  data-object-distance-au={object.distanceAu}
  data-object-system-name={object.systemName.toLocaleLowerCase('en')}
  data-object-classification={object.classification} data-object-classification-name="nebula">
  <a class="planet-object-link planet-observation-control planet-thumbnail-leading"
    href={object.route} data-prepared-focus-id={object.focusId}>
    <span class="planet-lens-icon"><MaterialSymbol name="grain" /></span>
    <span class="planet-object-name planet-lens-label">{object.name}</span>
    <span class="planet-object-distance planet-lens-detail">{object.distancePc} pc</span>
  </a>
</li>
