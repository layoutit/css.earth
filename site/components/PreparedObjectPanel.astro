---
import PlanetShell from "./PlanetShell.astro";
import PlanetInformationPanel from "./PlanetInformationPanel.astro";
import { validateObjectProvenance } from "../../src/platform/object-provenance.mjs";
import type {
  PreparedObjectContent,
  PreparedObjectContentDocument,
} from "../../tools/objects/content/types";

interface Props {
  informationOnly?: boolean;
  navigation?: boolean;
  preparedContent: PreparedObjectContentDocument;
  preparedControls: {
    lenses: PreparedObjectContent["lenses"] | null;
    settings: PreparedObjectContent["settings"];
  };
}

const { preparedContent: content, preparedControls: controls, informationOnly = false } = Astro.props;
const Panel = informationOnly ? PlanetInformationPanel : PlanetShell;
const previewFiles = import.meta.glob<{ images: Array<{ id: string; path: string; width: number; height: number; attribution?: { label: string; url?: string } }> }>(
  "../../src/planets/*/prepared/minimaps.json",
  { import: "default" },
);
const imageFiles = import.meta.glob<string>(
  "../../src/planets/*/prepared/minimaps/*.webp",
  { query: "?url", import: "default" },
);
const minimapFiles = import.meta.glob("../../src/planets/*/source/presentation/surface-map.json", { import: "default" });
const provenanceFiles = import.meta.glob("../../src/planets/*/prepared/provenance.json", { import: "default" });
const objectRoot = `../../src/planets/${content.objectId}`;
const provenanceData = await provenanceFiles[`${objectRoot}/prepared/provenance.json`]?.();
const provenance = provenanceData && validateObjectProvenance(provenanceData, content.objectId);
const minimap = await minimapFiles[`${objectRoot}/source/presentation/surface-map.json`]?.();
const previews = await previewFiles[`${objectRoot}/prepared/minimaps.json`]?.();
const lenses = controls.lenses && {
  ...controls.lenses,
  controls: await Promise.all(controls.lenses.controls.map(async (lens) => {
    const preview = previews?.images.find(image => image.id === lens.id);
    if (!preview) return lens;
    const url = await imageFiles[`${objectRoot}/prepared/${preview.path}`]();
    return { ...lens, texture: { url, width: preview.width, height: preview.height, minimap, attribution: preview.attribution } };
  })),
};
---

<Panel
  navigation={Astro.props.navigation}
  objectId={content.objectId}
  title={content.title}
  introduction={content.introduction}
  facts={content.facts}
  moreFacts={content.moreFacts}
  charts={content.charts}
  galleries={content.galleries}
  resources={content.resources}
  provenance={provenance}
  lenses={lenses}
  settings={controls.settings}
  destinations={content.destinations}
/>
