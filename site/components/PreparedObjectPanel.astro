---
import ObjectShell from "./ObjectShell.astro";
import { parsePreparedText } from '../object-text.mts';
import { authoredDatasetMetadata, parsePreparedPanelContent, parsePanelControls, withDatasetText } from '../prepared-panel-content.mts';
import { parsePanoramaList } from '../panorama-list.mts';
import { resolveSceneAddressesDeep } from '../asset-origin.mts';
interface Props { navigation?: boolean; preparedContent: unknown; preparedControls: unknown; }
const { preparedContent, preparedControls } = Astro.props;
const content = parsePreparedPanelContent(preparedContent);
const controls = parsePanelControls(preparedControls);
const previewFiles = import.meta.glob<{ images: Array<{ id: string; path: string; width: number; height: number; attribution?: { label: string; url?: string } }> }>(
  "../../src/objects/*/prepared/minimaps.json",
  { import: "default" },
);
const imageFiles = import.meta.glob<string>(
  "../../src/objects/*/prepared/minimaps/*.webp",
  { query: "?url", import: "default" },
);
const minimapFiles = import.meta.glob("../../src/objects/*/source/presentation/surface-map.json", { import: "default" });
const textFiles = import.meta.glob("../../src/objects/*/prepared/text.json", { import: "default" });
const sourceFiles = import.meta.glob("../../src/objects/*/source/content/object.json", { import: "default" });
const panoramaFiles = import.meta.glob("../../src/objects/*/prepared/panoramas.json", { import: "default" });
const objectRoot = `../../src/objects/${content.objectId}`;
const text = parsePreparedText(await textFiles[`${objectRoot}/prepared/text.json`]?.(), content.objectId);
const authoredSource = await sourceFiles[`${objectRoot}/source/content/object.json`]?.();
const authoredDatasets = authoredSource === undefined
  ? { sourceUrls: new Map<string, string>(), systemDatasetIds: new Set<string>() }
  : authoredDatasetMetadata(authoredSource, content.objectId);
const minimap = await minimapFiles[`${objectRoot}/source/presentation/surface-map.json`]?.();
const panoramaFile = await panoramaFiles[`${objectRoot}/prepared/panoramas.json`]?.();
const panoramas = panoramaFile === undefined ? undefined : await resolveSceneAddressesDeep(parsePanoramaList(panoramaFile, content.objectId));
const previews = await previewFiles[`${objectRoot}/prepared/minimaps.json`]?.();
const datasets = withDatasetText(controls.datasets && {
  ...controls.datasets,
  controls: await Promise.all(controls.datasets.controls.map(async (dataset) => {
    const sourceUrl = authoredDatasets.sourceUrls.get(dataset.id);
    const systemDataset = authoredDatasets.systemDatasetIds.has(dataset.id);
    const metadata = { ...(sourceUrl ? { sourceUrl } : {}), ...(systemDataset ? { systemDataset } : {}) };
    const preview = previews?.images.find(image => image.id === dataset.id);
    if (!preview) return { ...dataset, ...metadata };
    const url = await imageFiles[`${objectRoot}/prepared/${preview.path}`]();
    return { ...dataset, ...metadata, texture: { url, width: preview.width, height: preview.height, minimap, attribution: preview.attribution } };
  })),
}, text.datasets);
---

<ObjectShell
  navigation={Astro.props.navigation}
  objectId={content.objectId}
  title={content.title}
  introduction={text.introduction.text}
  facts={content.facts}
  moreFacts={content.moreFacts}
  charts={content.charts}
  galleries={content.galleries}
  panoramas={panoramas}
  datasets={datasets}
  settings={controls.settings}
  destinations={content.destinations}
  features={content.features}
/>
