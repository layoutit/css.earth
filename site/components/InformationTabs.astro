---
interface Props {
  idPrefix: string;
  group?: string;
  label?: string;
  panelSuffix?: 'content' | 'panel';
  tabs?: readonly { id: string; label: string; count?: number }[];
}
const { idPrefix, group, label = group === 'overview' ? 'Body overview' : 'Object information', panelSuffix = 'content',
  tabs = [{ id: 'dataset', label: 'Datasets' }, { id: 'factsheet', label: 'Factsheet' }, { id: 'moons', label: 'Moons' }] } = Astro.props;
// The browser owns selection and arrow-key movement. Both the HTML page and
// the running scene use these same controls and these same panels.
// Only selection is generated here. All appearance stays in the shared tab rules.
const selection = tabs.map(({id}) => `#${idPrefix}-${id}-${panelSuffix} { --information-panel-display: none; }
.planet-native-tabs:has(> #${idPrefix}-${id}-tab:checked) ~ #${idPrefix}-${id}-${panelSuffix} { --information-panel-display: block; }`).join('\n');
---
<div class:list={[group === 'overview' ? 'planet-object-tabs' : 'planet-card-tabs', 'planet-native-tabs']}
  data-body-overview={group === 'overview' ? true : undefined} role="radiogroup" aria-label={label}>
  {tabs.map((tab, index) => <>
    <input class="planet-native-tab" type="radio" name={`${idPrefix}-information`} id={`${idPrefix}-${tab.id}-tab`}
      data-information-tab={tab.id} data-information-group={group} value={tab.id} aria-controls={`${idPrefix}-${tab.id}-${panelSuffix}`} checked={index === 0} />
    <label class="planet-native-tab-label" for={`${idPrefix}-${tab.id}-tab`}>
      {group === 'overview' ? <span>{tab.label}</span> : tab.label}
      {tab.count !== undefined && <span class="planet-object-tab-count">({tab.count})</span>}
    </label>
  </>)}
</div>
<style is:inline set:html={selection} />
