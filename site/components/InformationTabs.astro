---
import { collectInformationTabStyle, informationTabStyle } from '../server/information-tab-styles.mts';
interface Props {
  idPrefix: string;
  group?: string;
  label?: string;
  panelSuffix?: 'content' | 'panel';
  tabs?: readonly { id: string; label: string; count?: number }[];
  initialTab?: string;
  hidden?: boolean;
  /** The card view these tabs are a part of, when they are not the body's own (selection-presentation.mts). */
  viewPart?: 'moons' | 'system';
}
const { idPrefix, group, label = group === 'overview' ? 'Body overview' : 'Object information', panelSuffix = 'content',
  tabs = [{ id: 'dataset', label: 'Datasets' }, { id: 'factsheet', label: 'Factsheet' }, { id: 'moons', label: 'Moons' }], initialTab, hidden = false, viewPart } = Astro.props;
// These controls' selection rules; ObjectLayout places them in the scene head, where navigation retains them.
collectInformationTabStyle(Astro.locals, informationTabStyle(`${idPrefix}-information`,
  tabs.map(tab => ({ id: `${idPrefix}-${tab.id}-tab`, panelId: `${idPrefix}-${tab.id}-${panelSuffix}` }))));
---
<div class:list={[group === 'overview' ? 'object-tabs' : 'object-card-tabs', 'object-native-tabs']}
  role="radiogroup" aria-label={label} data-view-part={viewPart} {hidden}>
  {tabs.map((tab) => <>
    <input class="object-native-tab" type="radio" name={`${idPrefix}-information`} id={`${idPrefix}-${tab.id}-tab`}
      data-information-tab={tab.id} data-information-group={group} value={tab.id} aria-controls={`${idPrefix}-${tab.id}-${panelSuffix}`} checked={tab.id === (initialTab ?? tabs[0]?.id)} />
    <label class="object-native-tab-label" for={`${idPrefix}-${tab.id}-tab`}>
      {group === 'overview' ? <span>{tab.label}</span> : tab.label}
      {tab.count !== undefined && <span class="object-tab-count">({tab.count})</span>}
    </label>
  </>)}
</div>
