---
import MaterialSymbol from "./MaterialSymbol.astro";

interface Props {
  objectId: string;
}

const { objectId } = Astro.props;
---

<nav class="explorer-rail" aria-label="Explorer" hidden>
  <button
    class="explorer-rail-explore"
    hidden
    type="button"
    aria-label="Solar System"
    aria-controls={`${objectId}-object-browser`}
    aria-pressed="true"
  >
    <span class="explorer-rail-icon">
      <MaterialSymbol name="planet" />
    </span>
  </button>
</nav>
