---
import MaterialSymbol from "./MaterialSymbol.astro";

interface Props {
  objectId: string;
}

const { objectId } = Astro.props;
---

<nav class="explorer-rail" aria-label="Explorer">
  <button
    class="explorer-rail-explore"
    hidden
    type="button"
    aria-label="Solar System"
    aria-controls={`${objectId}-object-browser`}
    aria-pressed="true"
  >
    <span class="explorer-rail-icon">
      <MaterialSymbol name="planet" />
    </span>
  </button>
  <button
    class="planet-toolbar-action explorer-rail-about"
    type="button"
    aria-label="About"
    title="About"
    aria-controls={`${objectId}-about`}
    aria-pressed="false"
  >
    <MaterialSymbol name="help" />
  </button>
  <button
    class="planet-toolbar-action planet-settings-action"
    type="button"
    aria-label="Settings"
    title="Settings"
    aria-controls={`${objectId}-settings`}
    aria-pressed="false"
  >
    <MaterialSymbol name="settings" />
  </button>
</nav>
