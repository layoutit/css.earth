---
import type { Props } from "../object-shell-types";
import ObjectBreadcrumbs from "./ObjectBreadcrumbs.astro";
import SatelliteSystemCard from './SatelliteSystemCard.astro';
import { orderScientificCharts } from "../scientific-chart-order.mts";
import ObjectCard from "./ObjectCard.astro";
import ObjectCardHeader from "./ObjectCardHeader.astro";
import ObjectFactsheet from "./ObjectFactsheet.astro";
import InformationTabs from './InformationTabs.astro';
import { satelliteSystemFromUrl } from '../navigation/navigation-scope.mts';
import DatasetContextPanels from "./DatasetContextPanels.astro";
import DatasetList from "./DatasetList.astro";
import DatasetThumbnail from "./DatasetThumbnail.astro";
import Detached from "./Detached.astro";
import SelectedContent from "./SelectedContent.astro";
import TreeDisclosure from './TreeDisclosure.astro';
import { readObjectArticleUrl } from '../server/object-article.mts';
const { objectId, title, introduction = "", facts = [], moreFacts = [], galleries = [], charts = [], datasets, panoramas } = Astro.props;
const panoramaEntries = panoramas?.panoramas ?? [];
const solRange = ([first, last]: readonly [number, number]) => first === last ? `Sol ${first}` : `Sols ${first}–${last}`;
const hasDatasets = Boolean(datasets && datasets.controls.length > 0);
const hasFacts = facts.length + moreFacts.length > 0;
const orderedCharts = orderScientificCharts(charts);
const articleUrl = await readObjectArticleUrl(objectId);
---

<ObjectCard class="object-information-panel" data-card-subject={satelliteSystemFromUrl(Astro.url) ? 'satellite-system' : 'body'}
  data-card-view={satelliteSystemFromUrl(Astro.url) ? 'overview' : undefined}>
  <SatelliteSystemCard hostId={objectId} detached={!satelliteSystemFromUrl(Astro.url)} />
      <ObjectCardHeader {objectId} {title} {introduction} {articleUrl}>
          <ObjectBreadcrumbs {objectId} />
      </ObjectCardHeader>
      {hasFacts && <InformationTabs idPrefix={objectId} initialTab="dataset" tabs={[
        { id: 'dataset', label: 'Datasets' },
        ...(panoramaEntries.length ? [{ id: 'imagery', label: 'Imagery' }] : []),
        { id: 'factsheet', label: 'Factsheet' },
        ...(orderedCharts.length ? [{ id: 'charts', label: 'Charts' }] : []),
      ]} />}
      <p data-dataset-notice role="status" aria-live="polite" hidden></p>
      <TreeDisclosure title="Datasets" class="object-card-tabpanel object-dataset-content" id={`${objectId}-dataset-content`} data-information-panel="dataset" open>
      <h2 class="object-mobile-information-heading">Datasets</h2>
      {hasDatasets && datasets && <DatasetList {objectId} {datasets} />}
      {galleries.map((gallery) => (
      <details id={`${objectId}-${gallery.id}`} class="object-gallery-panel" hidden={gallery.hidden}>
        <summary class="object-panel-summary">
          <h2 class="object-panel-heading">{gallery.title.label}</h2>
          <span class="object-panel-toggle" aria-hidden="true"></span>
        </summary>
        <div class="object-gallery" aria-label={gallery.title.label}>
          {gallery.items.map((item) => (
            <figure class="object-gallery-item" data-gallery-item={item.id}>
              <img
                class="object-gallery-image"
                src={item.src}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="object-gallery-caption">
                <strong>{item.label}</strong>
                <span>{item.caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </details>
      ))}
      </TreeDisclosure>
      {panoramaEntries.length > 0 && <section class="object-card-tabpanel object-imagery-content" id={`${objectId}-imagery-content`} data-information-panel="imagery" aria-label="Imagery">
        <h2 class="object-mobile-information-heading">Imagery</h2>
        <form id={`${objectId}-panoramas`} method="get" hidden></form>
        <nav class="object-observation-controls" aria-label="Imagery">
          {panoramaEntries.map((panorama) => <div class="object-observation-option">
            <button class="object-observation-control object-thumbnail-leading object-result-row" type="submit" form={`${objectId}-panoramas`}
              name="panorama" value={panorama.id} data-panorama-open={panorama.id} aria-pressed="false">
              <DatasetThumbnail class="object-dataset-icon" src={panorama.thumbnail} />
              <span class="object-dataset-label">{panorama.title}</span>
              <span class="object-dataset-detail">{panorama.camera} · {solRange(panorama.sols)}</span>
            </button>
          </div>)}
        </nav>
        <section class="object-dataset-details">
          <div class="object-dataset-details-body" aria-live="polite" aria-atomic="true">
            {panoramaEntries.map((panorama) => <Detached detached><div data-panorama-details={panorama.id} hidden>
              <SelectedContent title={panorama.title} description={`${panorama.camera} 360° panorama, ${solRange(panorama.sols).toLowerCase()}, seen from where the rover stood. ${panorama.credit}.`} />
              <a class="object-dataset-source-link" href={panorama.pageUrl} target="_blank" rel="noopener noreferrer">View source ↗</a>
            </div></Detached>)}
          </div>
        </section>
      </section>}
      {hasFacts && <section class="object-card-tabpanel object-factsheet-content" id={`${objectId}-factsheet-content`} data-information-panel="factsheet" aria-label="Factsheet">
        <h2 class="object-mobile-information-heading">Factsheet</h2>
        <ObjectFactsheet id={objectId} {facts} {moreFacts} embedded />
      </section>}
      {orderedCharts.length > 0 && <section class="object-card-tabpanel object-charts-content" id={`${objectId}-charts-content`} data-information-panel="charts" aria-label="Charts">
        <h2 class="object-mobile-information-heading">Charts</h2>
        <div class="object-chart-list">
          {orderedCharts.map((chart) => <section class="object-chart-entry" aria-labelledby={`${objectId}-${chart.id}-title`}>
            <h3 class="object-chart-row" id={`${objectId}-${chart.id}-title`}>{chart.title.label}</h3>
            <figure class="object-chart-figure">
              <img class="object-chart" src={chart.src} width={chart.width} height={chart.height} alt={chart.alt} loading="lazy" decoding="async" />
            </figure>
          </section>)}
        </div>
      </section>}
      <DatasetContextPanels {...Astro.props} />
    </ObjectCard>
