---
import type { Props } from "../object-shell-types";
import ObjectBreadcrumbs from "./ObjectBreadcrumbs.astro";
import SystemCard from './SystemCard.astro';
import ObjectCard from "./ObjectCard.astro";
import ObjectCardHeader from "./ObjectCardHeader.astro";
import ObjectFactsheet from "./ObjectFactsheet.astro";
import InformationTabs from './InformationTabs.astro';
import MaterialSymbol from './MaterialSymbol.astro';
import { objectSourceRows, sourceDocumentation } from '../source-documentation.mts';
import { namesSystem } from '../navigation/navigation-scope.mts';
import DatasetContextPanels from "./DatasetContextPanels.astro";
import DatasetList from "./DatasetList.astro";
import TreeDisclosure from './TreeDisclosure.astro';
import { readObjectArticleUrl } from '../server/object-article.mts';
import { OBJECTS } from '../objects.mts';
import { systemObjectId } from '../navigation/system-address.mts';
import ChildList from './ChildList.astro';
import { childrenOf } from '../object-children.mts';
const { objectId, title, introduction = "", facts = [], moreFacts = [], galleries = [], datasets } = Astro.props;
const hasDatasets = Boolean(datasets && datasets.controls.length > 0);
const hasFacts = facts.length + moreFacts.length > 0;
// A body whose only dataset is one color has nothing to choose between: its factsheet and that dataset show together,
// factsheet first, without tabs.
const stacked = hasFacts && datasets?.controls.length === 1 && datasets.controls[0]!.color !== undefined && galleries.length === 0;
const articleUrl = await readObjectArticleUrl(objectId);
// Any object lists what is inside it (object-children.mts, ChildList.astro). An object seen from inside has no body of its
// own to look at, so its list leads; any other opens on its datasets.
const zoom = OBJECTS.find(object => object.id === objectId)?.zoom;
const objectById = new Map(OBJECTS.map(object => [object.id, object] as const));
const inside = childrenOf(objectId), children = inside.rows;
const opening = zoom && children.length ? 'bodies' : 'dataset';
const together = stacked && !children.length;
// The card's subject: the body, or the system it hosts.
const system = objectById.get(systemObjectId(objectId));
const cardSubject = namesSystem(Astro.url) && system ? 'system' : 'body';
// The published sources this object's products, methods and facts name, each linked at its own site; the footer links the README.
const sourceRows = objectSourceRows(objectId);
// The card names its body's source document: a body reached by a map marker has no row in the lists to name it, and the
// footer link kept the first page's (M49 from the Virgo cluster linked the cluster's README, 2026-10-02).
const source = sourceDocumentation(objectId, title.label);
// A dataset authored for the whole system (a debris disc) shows on the system's card too, and so do a star's gallery
// pictures: a planet's are of the planet, not of its moons.
const systemDatasets = Boolean(datasets?.controls.some(dataset => dataset.systemDataset)) || galleries.length > 0 && system?.classification !== 'satellite-system';
---

<ObjectCard class="object-information-panel" data-card-subject={cardSubject} data-card-stacked={together || undefined}
  data-card-view={cardSubject === 'body' ? undefined : 'overview'}>
  <SystemCard hostId={objectId} />
      <ObjectCardHeader {objectId} {title} {introduction} {articleUrl}
        data-source-subject={`object:${objectId}`} data-source-document={source.href} data-source-label={source.label}>
          {zoom ? <ObjectBreadcrumbs scope={objectId} /> : <ObjectBreadcrumbs {objectId} />}
      </ObjectCardHeader>
      {hasFacts && !together && <InformationTabs idPrefix={objectId} initialTab={opening} tabs={[
        ...(children.length ? [{ id: 'bodies', label: 'Celestial bodies', count: children.length }] : []),
        { id: 'dataset', label: 'Datasets' },
        { id: 'factsheet', label: 'Factsheet' },
        ...(sourceRows.length ? [{ id: 'sources', label: 'Sources' }] : []),
      ]} />}
      <p data-dataset-notice role="status" aria-live="polite" hidden></p>
      {children.length > 0 && <section class="object-results-scroll object-card-tabpanel" id={`${objectId}-bodies-content`} data-information-panel="bodies" aria-label="Celestial bodies">
        <ChildList {objectId} />
      </section>}
      {together && <section class="object-card-tabpanel object-factsheet-content" id={`${objectId}-factsheet-content`} data-information-panel="factsheet" aria-label="Factsheet">
        <h2 class="object-mobile-information-heading">Factsheet</h2>
        <ObjectFactsheet id={objectId} {facts} {moreFacts} embedded />
      </section>}
      {together && datasets && <section class="object-card-tabpanel object-dataset-content" id={`${objectId}-dataset-content`} data-information-panel="dataset" aria-label="Datasets">
        <h2 class="object-card-section-title">Datasets</h2>
        <DatasetList {objectId} {datasets} />
      </section>}
      {!together && <TreeDisclosure title="Datasets" class="object-card-tabpanel object-dataset-content" id={`${objectId}-dataset-content`} data-information-panel="dataset" data-system-view-datasets={systemDatasets || undefined} open>
      <h2 class="object-mobile-information-heading">Datasets</h2>
      {hasDatasets && datasets && <DatasetList {objectId} {datasets} />}
      {galleries.map((gallery) => (
      <details id={`${objectId}-${gallery.id}`} class="object-gallery-panel" hidden={gallery.hidden}>
        <summary class="object-panel-summary">
          <h2 class="object-panel-heading">{gallery.title.label}</h2>
          <span class="object-panel-toggle" aria-hidden="true"></span>
        </summary>
        <div class="object-gallery" aria-label={gallery.title.label}>
          {gallery.items.map((item) => (
            <figure class="object-gallery-item" data-gallery-item={item.id}>
              <img
                class="object-gallery-image"
                src={item.src}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="object-gallery-caption">
                <strong>{item.label}</strong>
                <span>{item.caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </details>
      ))}
      </TreeDisclosure>}
      {hasFacts && !together && <section class="object-card-tabpanel object-factsheet-content" id={`${objectId}-factsheet-content`} data-information-panel="factsheet" aria-label="Factsheet">
        <h2 class="object-mobile-information-heading">Factsheet</h2>
        <ObjectFactsheet id={objectId} {facts} {moreFacts} embedded />
      </section>}
      {hasFacts && sourceRows.length > 0 && <section class="object-results-scroll object-card-tabpanel object-sources-content" id={`${objectId}-sources-content`} data-information-panel="sources" aria-label="Sources">
        <h2 class="object-mobile-information-heading">Sources</h2>
        <ul class="object-list">
          {sourceRows.map(source => <li class="object-item">
            <a class="object-observation-control object-thumbnail-leading object-result-row" href={source.url} target="_blank" rel="noopener noreferrer">
              <span class="object-dataset-icon object-source-icon">{source.iconSrc
                ? <img src={source.iconSrc} width="40" height="40" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                : <MaterialSymbol name="open_in_new" />}</span>
              <span class="object-name object-dataset-label">{source.title}</span>
              <span class="object-distance object-dataset-detail">{source.detail}</span>
            </a>
          </li>)}
        </ul>
      </section>}
      <DatasetContextPanels {...Astro.props} />
    </ObjectCard>
