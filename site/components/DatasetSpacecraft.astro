---
import type { Mission } from '../spacecraft-types.mts';
import type { ProvenanceDocument } from '../../src/platform/object-provenance.mts';
interface Props { provenance?: ProvenanceDocument; lensId?: string; missions?: readonly Mission[]; visibleMissionIds?: readonly string[]; }
import catalog from '../prepared-spacecraft.json';
import { datasetSpacecraft } from '../dataset-spacecraft.mts';
import SelectedContent from './SelectedContent.astro';
const { provenance, lensId, missions, visibleMissionIds } = Astro.props;
const spacecraft: readonly Mission[] = missions ?? datasetSpacecraft(provenance, lensId ?? "", catalog);
const dateRange = (mission: Mission) => {
  const launched = mission.facts.find(fact => fact.label === 'Launched')?.value;
  const ended = mission.facts.find(fact => fact.label === 'Ended')?.value;
  const status = mission.facts.find(fact => fact.label === 'Status')?.value;
  const end = ended ?? (status?.startsWith('Active') ? 'present' : null);
  return launched && (end ? `${launched}–${end}` : launched);
};
---
{spacecraft.length > 0 && <div class="planet-dataset-spacecraft" aria-label="Source spacecraft">
  {spacecraft.map(mission => <article class="planet-spacecraft" data-spacecraft={mission.id}
    hidden={visibleMissionIds && !visibleMissionIds.includes(mission.id)}>
    <SelectedContent title={mission.name} metadata={dateRange(mission)} description={mission.description} href={mission.descriptionSourceUrl ?? mission.sourceUrl}>
    <div class="planet-spacecraft-preview">
      <a class="planet-spacecraft-image-link" href={mission.image.sourceUrl} target="_blank" rel="noreferrer"
      aria-label={`${mission.name} ${mission.image.kind === 'model-render' ? '3D model render' : 'spacecraft illustration'} — ${mission.image.credit}`}>
      <img class="planet-spacecraft-image" src={mission.image.src}
        width={mission.image.width} height={mission.image.height}
        alt={`${mission.name} ${mission.image.kind === 'model-render' ? '3D model render' : 'spacecraft illustration'}`} loading="lazy" decoding="async" />
      </a>
      {mission.emblem && <a class="planet-spacecraft-emblem" href={mission.emblem.sourceUrl} target="_blank" rel="noreferrer"
        aria-label={`${mission.name} mission emblem — ${mission.emblem.credit}`}>
        <img src={mission.emblem.src} width={mission.emblem.width} height={mission.emblem.height}
          alt={`${mission.name} mission emblem`} loading="lazy" decoding="async" />
      </a>}
    </div>
    </SelectedContent>
  </article>)}
</div>}
