---
import { SCENE_OBJECTS } from '../objects.mts';
import { discoveryDescription, isDiscoveryAnchor } from '../object-discovery.mts';
import type { HTMLAttributes } from 'astro/types';
import type { ObjectTitle } from '../object-shell-types';
/** `heading` is the page heading by default; overview cards pass false so a
 * document keeps exactly one h1, the object's own title. */
interface Props extends Omit<HTMLAttributes<'section'>, 'title'> { title: ObjectTitle; introduction?: string; heading?: boolean; objectId?: string }
const { title, introduction = '', heading = true, objectId, ...attributes } = Astro.props;
const object = SCENE_OBJECTS.find(candidate => candidate.id === objectId);
const contentDescription = object && !isDiscoveryAnchor(object) ? discoveryDescription(object.discovery) : null;
const TitleTag = heading ? 'h1' : 'p';
---
<section class="object-selected-panel" {...attributes}>
  <slot />
  <div class="object-title-row">
    <TitleTag class="object-title object-title-text">{title.label}</TitleTag>
    {contentDescription && <span class="object-classification-tag object-title-tag" data-discovery-note>{contentDescription}</span>}
  </div>
  <slot name="image" />
  {introduction && <p class="object-introduction">{introduction}</p>}
</section>
