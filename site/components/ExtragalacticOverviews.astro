---
import ObjectCard from './ObjectCard.astro';
import ObjectCardHeader from './ObjectCardHeader.astro';
import ObjectBreadcrumbs from './ObjectBreadcrumbs.astro';
import InformationTabs from './InformationTabs.astro';
import ContextNavigationMarker from './ContextNavigationMarker.astro';
import { requireObject } from '../objects.mts';
import DatasetLenses from './DatasetLenses.astro';
import { pageDatasetLenses } from '../page-datasets-content.mts';
import { appNavigationDestination } from '../navigation/navigation-destination.mts';
import type { OverviewScope } from '../overview-context.mts';
import { parsePreparedGalaxyCatalog, parsePreparedClusterCatalog } from '@cssearth/catalog';
import galaxies from '../../src/objects/local-group/prepared/catalogue.json';
import milkyWay from '../../src/objects/milky-way/object.json';
import clusters from '../../src/objects/galaxy-clusters/prepared/catalogue.json';
const localGalaxies = parsePreparedGalaxyCatalog(galaxies).objects;
const principal = [
  { id: 'milky-way', focusId: undefined, name: 'Milky Way', href: appNavigationDestination('milky-way')!.href, distancePc: null, positionM: milkyWay.properties.volume.originM },
  ...[['lmc', 'LMC'], ['smc', 'SMC'], ['m31', 'M31 (Andromeda)'], ['m33', 'M33 (Triangulum)']].map(([id, name]) => {
    const object = localGalaxies.find(object => object.detailedObjectId === id);
    if (!object) throw new Error('Missing principal Local Group galaxy: ' + id);
    return { id: object.id, focusId: object.id, positionM: object.positionM, name, distancePc: object.distance.valuePc, href: `/${object.id}/` };
  }),
];
const distance = (pc: number) => {
  const ly = pc * 3.261563777;
  const divisor = ly >= 1e6 ? 1e6 : ly >= 1e3 ? 1e3 : 1;
  return { value: new Intl.NumberFormat('en', { maximumSignificantDigits: 3 }).format(ly / divisor), unit: divisor === 1e6 ? 'Mly' : divisor === 1e3 ? 'kly' : 'ly' };
};
// Each card is an overview entry of the registry: its name and description are the entry's.
const groups = [
  { id: 'local-group', section: 'Galaxies', objects: principal },
  { id: 'nearby-universe', section: 'Galaxy clusters',
    objects: parsePreparedClusterCatalog(clusters).objects.map(object => ({ id: object.id, focusId: object.id, positionM: object.positionM, name: object.name, distancePc: object.distance.valuePc, href: `/${object.id}/` })) },
  { id: 'observable-universe', section: 'Galaxy clusters', objects: [] },
].map(group => {
  const overview = requireObject(group.id);
  if (overview.kind !== 'overview') throw new TypeError(`${group.id} is not an overview.`);
  return { ...group, id: overview.id as OverviewScope, name: overview.name, introduction: overview.description, datasets: pageDatasetLenses(overview.id) };
});
---
{groups.map(group => <ObjectCard class="object-overview-card" data-large-scale-overview={group.id} data-large-scale-name={group.name} hidden>
  <ObjectCardHeader heading={false} title={{ label: group.name }} introduction={group.introduction}>
    <ObjectBreadcrumbs scope={group.id} />
  </ObjectCardHeader>
  {group.datasets && <div class="object-dataset-content" data-page-datasets={group.id} data-default-lens={group.datasets.defaultLens}
    data-lens-views={JSON.stringify(group.datasets.views)}>
    <DatasetLenses objectId={`page-${group.id}`} thumbnailObjectId={group.id} page={group.id} route={`/${group.id}/`}
      lenses={{ controls: group.datasets.controls, defaultLens: group.datasets.defaultLens }} focus />
  </div>}
  {group.objects.length > 0 && <InformationTabs idPrefix={group.id} group={group.id} label={`${group.name} information`} hidden
    tabs={[{ id: 'objects', label: group.section, count: group.objects.length }]} />}
  <div class="object-results-scroll object-card-tabpanel" id={`${group.id}-objects-content`} hidden
    role="region" aria-label={group.section}>
    <ul class="object-list">
      {group.objects.map(object => <li data-neighbor-id={object.id}
        data-neighbor-distances={JSON.stringify(Object.fromEntries(group.objects.map(origin => [origin.id,
          Math.hypot(...object.positionM.map((value, axis) => value - origin.positionM[axis])) / 3.085677581491367e16])))}>

        <a class="object-link object-observation-control object-thumbnail-leading" href={object.href} data-prepared-focus-id={object.focusId}>
          <span class="object-lens-icon"><ContextNavigationMarker objectId={object.id} /></span>
          <span class="object-name object-lens-label">{object.name}</span>
          <span class="object-distance object-lens-detail" title="Published catalogue distance from the Solar System">
            <span class="object-distance-value">≈{distance(object.distancePc ?? 0).value}</span>{" "}
            <span class="object-distance-unit">{distance(object.distancePc ?? 0).unit}</span>
          </span>
        </a>
      </li>)}
    </ul>
  </div>
</ObjectCard>)}
