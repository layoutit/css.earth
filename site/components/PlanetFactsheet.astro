---
import type { Props as PlanetProps } from "../planet-shell-types";
import { PREPARED_SHELL_ICONS } from "../prepared-shell-icons.mjs";
import { orderFacts } from "../fact-order.mjs";

interface Props {
  id: string;
  facts?: PlanetProps["facts"];
  moreFacts?: PlanetProps["moreFacts"];
}
const { id, facts = [], moreFacts = [] } = Astro.props;
const allFacts = orderFacts(facts, moreFacts);
const hasFacts = allFacts.length > 0;
const factsheetPreviewCount = 4;
const initialFacts = allFacts.slice(0, factsheetPreviewCount);
const remainingFacts = allFacts.slice(factsheetPreviewCount);
const hasRemainingFacts = remainingFacts.length > 0;
---

<details
  id={`${id}-factsheet-panel`}
  class="planet-factsheet-section"
  aria-labelledby={`${id}-factsheet-title`}
>
  <summary class="planet-factsheet-header planet-panel-summary">
    <h2 id={`${id}-factsheet-title`} class="planet-panel-heading">Factsheet</h2>
    <img
      class="planet-panel-icon"
      data-panel-icon="facts"
      src={PREPARED_SHELL_ICONS.facts.src}
      width={PREPARED_SHELL_ICONS.facts.width}
      height={PREPARED_SHELL_ICONS.facts.height}
      alt=""
    />
  </summary>
  {hasFacts && <div class="planet-factsheet-body">
    <div class="planet-facts">
      <ul class="planet-primary-facts">
        {initialFacts.map((fact) => (
          <li data-fact-id={fact.id}>
            <span class="planet-fact-label">{fact.label}</span>
            <span class="planet-fact-value">{fact.value}</span>
          </li>
        ))}
      </ul>
      {hasRemainingFacts && <details class="planet-facts-overflow">
        <summary class="planet-facts-toggle">
          <span class="planet-facts-more">View more</span>
          <span class="planet-facts-less">View less</span>
        </summary>
        <ul class="planet-additional-facts">
          {remainingFacts.map((fact) => (
            <li data-fact-id={fact.id}>
              <span class="planet-fact-label">{fact.label}</span>
              <span class="planet-fact-value">{fact.value}</span>
            </li>
          ))}
        </ul>
      </details>}
    </div>
  </div>}
</details>
