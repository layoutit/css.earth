---
import type { Props as PlanetProps } from "../planet-shell-types";
import { PREPARED_SHELL_ICONS } from "../prepared-shell-icons.mjs";
import { orderFacts } from "../fact-order.mts";

interface Props {
  id: string;
  embedded?: boolean;
  facts?: PlanetProps["facts"];
  moreFacts?: PlanetProps["moreFacts"];
}
const { id, facts = [], moreFacts = [], embedded = false } = Astro.props;
const Container = embedded ? "section" : "details";
const allFacts = orderFacts(facts, moreFacts);
const hasFacts = allFacts.length > 0;
---

{/* A body with no cited facts shows no factsheet, not an empty one. */}
{hasFacts && <Container
  id={`${id}-factsheet-panel`}
  class="planet-factsheet-section"
  aria-label={embedded ? "Factsheet" : undefined}
  aria-labelledby={embedded ? undefined : `${id}-factsheet-title`}
>
  {!embedded && <summary class="planet-factsheet-header planet-panel-summary">
    <h2 id={`${id}-factsheet-title`} class="planet-panel-heading">Factsheet</h2>
    <img
      class="planet-panel-icon"
      data-panel-icon="facts"
      src={PREPARED_SHELL_ICONS.facts.src}
      width={PREPARED_SHELL_ICONS.facts.width}
      height={PREPARED_SHELL_ICONS.facts.height}
      alt=""
    />
  </summary>}
  <div class="planet-factsheet-body">
    <div class="planet-facts">
      <ul class="planet-primary-facts">
        {allFacts.map((fact) => (
          <li data-fact-id={fact.id}>
            <span class="planet-fact-label">{fact.label}</span>
            <span class="planet-fact-value">{fact.value}</span>
          </li>
        ))}
      </ul>

    </div>
  </div>
</Container>}
