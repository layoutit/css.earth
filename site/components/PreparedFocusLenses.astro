---
import SelectedContent from './SelectedContent.astro';
import type { PreparedVolumeLensBank } from '../../src/renderers/css/volume/prepared-volume-lenses';

type Descriptor = { id: string; type: string; prepared?: { url: string } };
const descriptors = import.meta.glob<Descriptor>('../../src/objects/*/object.json', { eager: true, import: 'default' });
const prepared = import.meta.glob<{ data: PreparedVolumeLensBank }>('../../src/objects/*/prepared/*.json', { eager: true, import: 'default' });
const banks = Object.entries(descriptors).filter(([, descriptor]) => descriptor.type === 'volume-lens-bank').map(([path, descriptor]) => {
  const bank = prepared[path.replace(/object\.json$/u, descriptor.prepared?.url ?? '')]?.data;
  if (!bank || bank.id !== descriptor.id) throw new TypeError(`Prepared focus lenses unavailable: ${descriptor.id}.`);
  return bank;
});
---
{banks.map(bank => <div class="planet-card-tabpanel" data-focus-lens-bank={bank.id} hidden>
  <section class="planet-lenses" aria-label="Datasets">
    <div class="planet-layers-menu">
      <nav class="planet-observation-controls" aria-label="Datasets">
        {bank.lenses.map(lens => <div class="planet-observation-option">
          <button class="planet-observation-control" type="button" name="focusLens"
            value={lens.id} data-focus-lens aria-pressed={lens.id === bank.defaultLens ? 'true' : 'false'}
            aria-controls={`focus-${bank.id}-${lens.id}-details`} title={lens.title}>
            <span class="planet-lens-label">{lens.label}</span>
          </button>
        </div>)}
      </nav>
    </div>
  </section>
  <section class="planet-lens-details">
    <div class="planet-lens-details-body" aria-live="polite" aria-atomic="true">
      {bank.lenses.map(lens => <div id={`focus-${bank.id}-${lens.id}-details`}
        data-focus-lens-details={lens.id} hidden={lens.id !== bank.defaultLens}>
        <SelectedContent title={lens.title} description={lens.description} href={lens.sourceUrl} />
      </div>)}
    </div>
    {bank.lenses.some(lens => lens.stars.points.length > 0) && <label class="planet-setting-control">
      <input type="checkbox" data-focus-stars checked />
      <span class="planet-setting-text">Catalogue stars</span>
      <span class="planet-setting-switch" aria-hidden="true"></span>
    </label>}
  </section>
</div>)}
