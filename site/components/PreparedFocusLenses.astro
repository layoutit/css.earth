---
import DatasetLenses from './DatasetLenses.astro';
import DatasetContextPanels from './DatasetContextPanels.astro';
import PlanetFactsheet from './PlanetFactsheet.astro';
import { parsePreparedVolumePresentation } from '../volume-presentation.mts';
import { validateObjectProvenance } from '../../src/platform/object-provenance.mts';
import type { PreparedVolumeLensBank } from '../../src/renderers/css/volume/prepared-volume-lenses';
import { CONTEXT_OBJECT_DESCRIPTORS, CONTEXT_OBJECT_PREPARED_JSON, CONTEXT_OBJECT_ASSET_URLS } from '../prepared-context-objects.mts';
import { CONTEXT_AVAILABILITY } from '../context-availability.mts';
import { resolveSceneAddressesDeep } from '../asset-origin.mts';
import { datasetSourceDetail } from '../dataset-context.mts';
import { EXPLORATION } from '../exploration-catalog.mts';
interface Props { objectId: string; factsOnly?: boolean }
const { objectId, factsOnly = false } = Astro.props;

type Descriptor = { id: string; type: string; prepared?: { url: string } };
// Bodies share src/objects; only the generated context objects' prepared JSON is read here.
const descriptors = CONTEXT_OBJECT_DESCRIPTORS as Record<string, Descriptor>;
const prepared = CONTEXT_OBJECT_PREPARED_JSON as Record<string, { data: PreparedVolumeLensBank } | undefined>;
const presentations = CONTEXT_OBJECT_PREPARED_JSON, provenanceDocuments = CONTEXT_OBJECT_PREPARED_JSON;
const banks = await Promise.all(Object.entries(descriptors).filter(([, descriptor]) => (descriptor.type === 'volume-lens-bank' && CONTEXT_AVAILABILITY[descriptor.id]?.available) || descriptor.type === 'image-layer-bank').map(async ([path, descriptor]) => {
  const bank = descriptor.type === 'image-layer-bank'
    ? { id: descriptor.id, defaultLens: 'optical', lenses: [{id:'optical', stars:{points:[]}}] }
    : prepared[path.replace(/object\.json$/u, descriptor.prepared?.url ?? '')]?.data;
  if (!bank || bank.id !== descriptor.id) throw new TypeError(`Prepared focus lenses unavailable: ${descriptor.id}.`);
  const provenance = validateObjectProvenance(provenanceDocuments[path.replace(/object\.json$/u, 'prepared/provenance.json')], bank.id);
  // presentation.json (a context object's own prepared JSON, not a Vite asset import) can carry
  // bare `/scenes/<id>/datasets/<sha>.webp` dataset-preview addresses that Vite never rewrites.
  const parsedPresentation = await resolveSceneAddressesDeep(parsePreparedVolumePresentation(presentations[path.replace(/object\.json$/u, 'prepared/presentation.json')], bank, provenance));
  const presentation = { ...parsedPresentation, controls: parsedPresentation.controls.map(lens => {
    const { detail: _preparedDetail, ...control } = lens;
    const detail = datasetSourceDetail(lens.id, provenance, EXPLORATION.catalog);
    return { ...control, ...(detail ? { detail } : {}) };
  }) };
  const directSourceIdsByLens = Object.fromEntries(presentation.controls.map(lens => [lens.id,
    provenance.sources.filter(source => source.lensId === lens.id).map(source => source.id)]));
  const prefix = path.replace(/object\.json$/u, '');
  const resources = Object.fromEntries(Object.entries(CONTEXT_OBJECT_ASSET_URLS).filter(([path]) => path.startsWith(prefix)).map(([path, url]) => [path.slice(prefix.length), url]));
  return { bank, presentation, directSourceIdsByLens, descriptor, resources };
}));
---
{banks.map(({ bank, presentation, directSourceIdsByLens, descriptor, resources }) => factsOnly ? <div data-focus-facts-bank={bank.id} hidden>
  {presentation.controls.map(lens => <div data-focus-lens-details={lens.id} hidden={lens.id !== presentation.defaultLens}>
    <h3 class="planet-lens-details-title">{lens.label}</h3>
    <PlanetFactsheet id={`focus-${bank.id}-${lens.id}`} facts={lens.facts} embedded />
  </div>)}
</div> : <div class="planet-dataset-content" data-focus-lens-bank={bank.id} hidden>
  <script is:inline type="application/json" data-focus-resources set:html={JSON.stringify({ descriptor, resources }).replace(/</g, '\\u003c')}></script>
  <DatasetLenses objectId={`focus-${bank.id}`} thumbnailObjectId={bank.id} route={`/${objectId}/`} lenses={presentation} controlName="focusLens" />
  <DatasetContextPanels objectId={bank.id} lenses={presentation} {directSourceIdsByLens} />
</div>)}
{/* The one shell-level 3D-stars setting owns every 3D point layer, including catalogue points inside prepared volumes. */}
<style is:inline>
  .planet-ui-layer:has(.planet-three-d-stars-setting:not(:checked)) ~ .planet-viewport .prepared-catalogue-points { display: none !important; }
</style>
