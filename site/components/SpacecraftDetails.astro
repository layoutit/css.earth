---
import { SPACECRAFT, EXPLORATION, REFERENCES, referenceUrl, missionParticipation, spacecraftDatasets } from '../exploration-catalog.mts';
interface Props { spacecraftId: string; objectId: string; contributed: boolean; }
const { spacecraftId, contributed } = Astro.props;
const vehicle = SPACECRAFT[spacecraftId];
const image = vehicle.imageId ? EXPLORATION.images[vehicle.imageId] : null;
const participation = missionParticipation(spacecraftId);
const uses = spacecraftDatasets(spacecraftId);
const referenceIds = [...new Set([vehicle.name, vehicle.description, vehicle.kind, ...vehicle.aliases, ...(vehicle.launch ? [vehicle.launch] : [])].flatMap(field => field.referenceIds))];
---
<details class="planet-spacecraft-details" data-spacecraft={vehicle.id}>
  <summary><span>{vehicle.name.value}</span> <small>{contributed ? 'Dataset contributor' : 'Mission participant'}</small></summary>
  <p>{vehicle.description.value}</p>
  <p class="planet-spacecraft-facts">{vehicle.kind.value}{vehicle.launch && <> · Launched <a href={referenceUrl(vehicle.launch)} target="_blank" rel="noreferrer">{vehicle.launch.value}</a></>}</p>
  {vehicle.aliases.length > 0 && <p>Also named {vehicle.aliases.map(alias => alias.value).join(', ')}.</p>}
  {image && <a href={image.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${vehicle.name.value} artwork source — ${image.credit}`}>
    <img class="planet-spacecraft-image" src={image.src} width={image.width} height={image.height} alt={`${vehicle.name.value} spacecraft illustration`} loading="lazy" decoding="async" />
  </a>}
  <h4>Mission participation</h4>
  <ul>{participation.map(mission => <li><a href={referenceUrl(mission.name)} target="_blank" rel="noreferrer">{mission.name.value}</a>{mission.started && <> · {mission.started.value}</>}{mission.ended && <>–{mission.ended.value}</>}</li>)}</ul>
  <h4>Used in cssEarth</h4>
  {uses.length ? <ul class="planet-mission-datasets">{uses.map(view => <li><a href={view.href} data-dataset-link data-dataset-object={view.objectId} data-dataset-id={view.lensId}>{view.objectName} · {view.label}</a></li>)}</ul>
    : <p>No prepared dataset attributes observations to this vehicle.</p>}
  <details class="planet-mission-references"><summary>Spacecraft references</summary><ul>{referenceIds.map(id => <li><a href={REFERENCES[id].url} target="_blank" rel="noreferrer">{REFERENCES[id].title}</a>{REFERENCES[id].locator && <> · {REFERENCES[id].locator}</>}</li>)}</ul></details>
</details>
