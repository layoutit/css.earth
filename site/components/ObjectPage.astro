---
import { requireObject } from '../directory/objects.mts';
import ObjectLayout from '../layouts/ObjectLayout.astro';
import PreparedObjectHead from './PreparedObjectHead.astro';
import PreparedObjectPanel from './PreparedObjectPanel.astro';
import { loadObjectPageData } from '../server/object-page-data.mts';
import { objectPageStyles, SHELL_STYLE_FILE, SHELL_STYLE_ID } from '../contracts/object-page-contract.mts';
import { objectPageCss } from '@cssearth/objects';
import shellCss from '../layouts/object-shell.css?inline';
import { loadPreparedSceneMarkup } from '../server/load-prepared-scene.mts';
import { rewriteSceneCss, resolveSceneAddressesDeep, withPreparedAssetOrigin } from '../server-assets/asset-origin.mts';

/** `objectId` owns the scene; `pageId` is what the page is: the object, or an object seen from inside that scene shows when it differs. */
interface Props { objectId: string; pageId?: string; navigation?: boolean; home?: boolean; }
const { objectId, pageId = objectId, navigation = false, home = false } = Astro.props;
const preparedPage = await loadObjectPageData(objectId);
const scene = navigation ? undefined : await loadPreparedSceneMarkup(objectId);
const contentFiles = import.meta.glob('../../src/objects/*/prepared/content.json', { import: 'default' });
// ?inline processes CSS assets without importing every object's rules into the
// shared cascade. Only the selected package's authored CSS is emitted.
const cssFiles = import.meta.glob<string>('../../src/**/*.css', { query: '?inline', import: 'default' });
const descriptor = scene?.descriptor ?? await withPreparedAssetOrigin(preparedPage.descriptor);
const preparedContent = await resolveSceneAddressesDeep(await contentFiles[`../../src/objects/${objectId}/prepared/content.json`]());
const styles = await Promise.all(objectPageStyles(descriptor, { navigation })
  .map(async path => ({ path, css: await rewriteSceneCss(path === SHELL_STYLE_FILE ? shellCss : objectPageCss(await cssFiles[`../../${path}`](), objectId)) })));
---

<ObjectLayout objectId={objectId} pageId={pageId} navigation={navigation} scene={scene} descriptor={descriptor} home={home}>
  <Fragment slot="object-head">
    {styles.map(({ path, css }) => <style is:inline data-object-style={path === SHELL_STYLE_FILE ? SHELL_STYLE_ID : path} set:html={css} />)}
    {!navigation && !requireObject(objectId).discovery?.arrival?.billboard && <PreparedObjectHead preparedAssets={preparedPage.assets} />}
  </Fragment>
  <PreparedObjectPanel slot="object-ui" preparedContent={preparedContent} preparedControls={preparedPage.controls} preparedMotion={preparedPage.motion} navigation={navigation} />
</ObjectLayout>
