---
import type { prepareBodyRelations } from '../prepare-body-moons.mts';
import PlanetObjectResult from './PlanetObjectResult.astro';
import PlanetMoonList from './PlanetMoonList.astro';
interface Props { relations: NonNullable<ReturnType<typeof prepareBodyRelations>>; }
const { relations } = Astro.props;
---
{relations.parent && <ul class="planet-object-list" aria-label="Parent body">
  <PlanetObjectResult object={relations.parent} />
</ul>}
{relations.moons.length > 0 && <div aria-label={relations.parent ? 'Other moons' : 'Moons'}>
  <PlanetMoonList moons={relations.moons} />
</div>}
