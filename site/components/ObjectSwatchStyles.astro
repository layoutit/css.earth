---
import { DEFAULT_CONTEXT_COLOUR } from '../context-colour.mts';

// The world's default marker, orbit and caption colour, for a body with no colour of its own. Each body's own colour and
// caption case are prepared into the world summary and set inline on its elements
// (src/renderers/css/universe/prepared-world-context.ts), so no page carries a stylesheet rule per body.
---

<style is:inline set:html={`.prepared-world-context { color: ${DEFAULT_CONTEXT_COLOUR}; }`}></style>
