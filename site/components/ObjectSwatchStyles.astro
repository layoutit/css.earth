---
import { OBJECTS } from '../objects.mjs';

// Resolve provenance-bearing swatches during the page build. Only CSS colors
// reach the browser; existing retained groups own geometry and interaction.
const swatches = import.meta.glob<{ hex: string; display?: { hex: string } }>('../../src/planets/*/swatch.json', {
  eager: true,
  import: 'default',
});
const styles = OBJECTS.flatMap(({ id }) => {
  const swatch = swatches[`../../src/planets/${id}/swatch.json`];
  if (!swatch) return [];
  const hex = swatch.display?.hex ?? swatch.hex;
  if (!/^#[0-9a-f]{6}$/i.test(hex)) throw new Error(`Invalid ${id} swatch.`);
  const group = `.prepared-world-context [data-context-group="${id}"]`;
  return [`${group} { --shell-text: ${hex}; }`];
}).join('\n');
const majorBodyLabelStyles = OBJECTS
  .filter(({ classification }) => classification === 'star' || classification === 'planet')
  .map(({ id }) => `.prepared-world-context [data-context-label="${id}"] { text-transform: uppercase; }`)
  .join('\n');
const minorBodyOrbitStyles = OBJECTS
  .filter(({ classification }) => ['satellite', 'dwarf-planet', 'asteroid', 'comet'].includes(classification))
  .map(({ id }) => `:where(.prepared-world-context) [data-context-group="${id}"] { --context-base-line-opacity: .3; }`)
  .join('\n');
const minorBodyLabelStyles = OBJECTS
  .filter(({ classification }) => classification === 'dwarf-planet' || classification === 'comet')
  .map(({ id }) => `:where(.prepared-world-context) [data-context-group="${id}"] { --context-base-label-opacity: .5; }`)
  .join('\n');
// Keep labels and retained geometry stable. Hidden orbit chords must not
// capture the pointer; circles stay faint and use the existing hover highlight.
const asteroidOrbitStyles = OBJECTS
  .filter(({ classification }) => classification === 'asteroid')
  .map(({ id }) => {
    const disabled = `:where(body:not([data-asteroid-orbits="on"]) .prepared-world-context) [data-context-group="${id}"]`;
    return `${disabled} > .context-orbit s { --context-orbit-pointer-events: none; }`;
  }).join('\n');
---

<style is:inline set:html={[styles, majorBodyLabelStyles, minorBodyOrbitStyles, minorBodyLabelStyles, asteroidOrbitStyles].join('\n')}></style>
