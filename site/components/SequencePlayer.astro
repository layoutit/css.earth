---
import type { Props as ShellProps } from '../object-shell-types';
import MaterialSymbol from './MaterialSymbol.astro';
type Control = NonNullable<ShellProps['datasets']>['controls'][number];
interface Props {
  objectId: string;
  dataset: Control;
  members: Control[];
  /** The scene's own sequence can play; a drawn page's steps are links to its page. */
  playable: boolean;
}
const { objectId, dataset, members, playable } = Astro.props;
const index = members.findIndex(member => member.id === dataset.id);
---
<!-- A sequence plays like a short video over its own map: one segment per step, filled up to the step on screen. -->
<div class="object-sequence-player" data-sequence-player role="group" aria-label={`${dataset.label} steps`}>
  <div class="object-sequence-track">
    {members.map((member, position) => <button
      class:list={['object-sequence-segment', { 'is-past': position < index }]}
      type="submit"
      form={`${objectId}-datasets`}
      name="dataset"
      value={member.id}
      data-dataset-step={member.id}
      aria-current={position === index ? 'step' : undefined}
      aria-label={member.step!.label}
      title={member.step!.label}
    ><span class="object-sequence-segment-bar" aria-hidden="true"><span class="object-sequence-segment-fill"></span></span></button>)}
  </div>
  <div class="object-sequence-row">
    {playable && <button class="object-dataset-play" type="button" data-dataset-play={dataset.step!.group} disabled
      aria-label="Play sequence" aria-pressed="false" title="Loop through this sequence">
      <span class="object-dataset-play-icon is-play"><MaterialSymbol name="play_arrow" /></span>
      <span class="object-dataset-play-icon is-pause"><MaterialSymbol name="pause" /></span>
    </button>}
    <span class="object-sequence-label">{dataset.step!.label}</span>
    <span class="object-sequence-count">{index + 1}/{members.length}</span>
  </div>
</div>
