---
import fontUrl from '../../src/objects/earth/source/presentation/InterVariable.ttf?url';
import { OBJECT_TITLE_RECIPE as recipe } from '../../src/platform/object-title-recipe.mts';

// Text titles use the same pinned font, optical size and scale as the prepared
// title artwork. Existing SVG headings retain their exact desktop appearance.
const scale = recipe.referenceRenderedWidth / recipe.referenceViewBoxWidth;
const styles = `
@font-face {
  font-family: "cssEarth title";
  src: url(${JSON.stringify(fontUrl)}) format("truetype");
  font-style: normal;
  font-weight: ${recipe.weight};
  font-display: swap;
}
.object-title-text {
  font-family: "cssEarth title", var(--shell-ui-font);
  font-size: ${recipe.fontSize * scale}px;
  font-weight: ${recipe.weight};
  font-optical-sizing: none;
  font-variation-settings: "wght" ${recipe.weight}, "opsz" ${recipe.opticalSize};
  letter-spacing: ${recipe.letterSpacing * scale}px;
  line-height: ${recipe.viewBoxHeight * scale}px;
}`;
---
<style is:inline data-title-typography set:html={styles} />
