---
import type { MoonListEntry } from '../prepare-body-moons.mts';
import ObjectResult from './ObjectResult.astro';
import type { ObjectEntry } from '../objects.mts';
interface Props { moons: readonly MoonListEntry[]; host?: ObjectEntry; }
const { moons, host } = Astro.props;
---
{host || moons.length > 0 ? <ul class="object-list">
  {host && <ObjectResult object={host} />}
  {moons.map(moon => moon.object ? <ObjectResult object={moon.object} /> :
    <li class="object-item" data-moon-id={moon.id}>
      <span class="object-link object-observation-control object-thumbnail-leading object-result-row" role="link" aria-disabled="true" title="Not available yet">
        <span class="object-dataset-icon" aria-hidden="true"><span class="object-moon-placeholder"></span></span>
        <span class="object-name object-dataset-label">{moon.name}</span>
        <span class="object-dataset-detail">Not available</span>
      </span>
    </li>)}
</ul> : <p class="object-empty">No moons in the catalogue</p>}
