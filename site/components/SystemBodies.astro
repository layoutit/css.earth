---
import { SCENE_OBJECTS } from '../objects.mts';
import { SOLAR_SYSTEM_ID, systemById } from '../object-systems.mts';
import ObjectResult from './ObjectResult.astro';
import ObjectFactsheet from './ObjectFactsheet.astro';
import InformationTabs from './InformationTabs.astro';
import { informationTabStyle } from '../server/information-tab-styles.mts';
import overviewFacts from '../source/overview-facts.json';
interface Props { systemId: string }
const { systemId } = Astro.props;
const system = systemById(SCENE_OBJECTS, systemId);
if (!system) throw new TypeError(`Unknown planetary system ${systemId}.`);
const objects = new Map(SCENE_OBJECTS.map(object => [object.id, object]));
const solar = systemId === SOLAR_SYSTEM_ID;
const bodies = [system.id, ...system.memberIds].flatMap(id => {
  const object = objects.get(id);
  return object ? [object] : [];
}).sort((a, b) => {
  // The Solar System starts with planets; retain search's distance order within each group.
  const planetOrder = solar ? Number(b.classification === 'planet') - Number(a.classification === 'planet') : 0;
  return planetOrder || a.distance.meters - b.distance.meters;
});
const prefix = `${systemId}-system-bodies`;
const tabs = [{ id: 'bodies', label: 'Celestial bodies' }, ...(solar ? [{ id: 'factsheet', label: 'Factsheet' }] : [])];
// Fragments transport the same native radio rules as full-page cards.
const rules = informationTabStyle(`${prefix}-information`, tabs.map(tab => ({
  id: `${prefix}-${tab.id}-tab`, panelId: `${prefix}-${tab.id}-content`,
}))).css;
import Detached from './Detached.astro';
---
<div data-system-bodies={systemId}>
  <style is:inline set:html={rules} />
  <InformationTabs idPrefix={prefix} group="solar-system" label={`${system.name} information`} {tabs} />
  <div class="object-results-scroll object-card-tabpanel" id={`${prefix}-bodies-content`} role="region" aria-label={`${system.name} celestial bodies`}>
    <ul class="object-list">{bodies.map(object => <ObjectResult {object} />)}</ul>
  </div>
  {solar && <Detached detached><div class="object-results-scroll object-card-tabpanel" id={`${prefix}-factsheet-content`} data-solar-system-facts
    data-information-panel="factsheet" data-information-group="solar-system" role="region" aria-label="Factsheet">
    <ObjectFactsheet id={prefix} facts={overviewFacts['solar-system'].facts} embedded />
  </div></Detached>}
</div>
