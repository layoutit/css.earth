---
import { distanceDescription } from '@cssearth/objects';
import type { ObjectEntry } from '../objects.mts';
import { objectTypeLabel } from '../object-classification-label.mts';
import { sourceDocumentation } from '../source-documentation.mts';
import { objectResultMarkup } from '../server/object-result-markup.mts';
import { objectResultMarker } from '../search/prepared-catalogue-index.mts';
import { listDistance } from '../search/list-distance.mts';
interface Props { object: ObjectEntry; }
const { object } = Astro.props;
const source = sourceDocumentation(object.id, object.name);
const { value, unit } = listDistance(object.distance);
const description = distanceDescription(object.distance);
const markup = objectResultMarkup({
  id: object.id, name: object.name, route: object.route,
  classificationName: objectTypeLabel(object),
  detail: { text: `${value} ${unit}`, value, unit,
    title: description, ariaLabel: `${value} ${unit}. ${description}` },
  source: { subject: `object:${object.id}`, document: source.href, label: source.label },
  marker: objectResultMarker(object),
});
---

<li class="object-item" role="listitem" data-navigation-object-id={object.id} data-object-name={object.name.toLocaleLowerCase("en")}
  data-object-featured={object.discovery.featured} data-object-illustration={object.discovery.illustration}
  data-object-distance-m={object.distance.meters}
  data-object-system-name={object.systemName.toLocaleLowerCase("en")}
  data-object-classification={object.classification}
  data-object-classification-name={objectTypeLabel(object).toLocaleLowerCase("en")}>
    <Fragment set:html={markup} />
</li>
