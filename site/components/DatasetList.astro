---
import type { Props as ShellProps } from '../object-shell-types';
import DatasetLegend from './DatasetLegend.astro';
import DatasetThumbnail from './DatasetThumbnail.astro';
import DatasetDescription from './DatasetDescription.astro';
import SequencePlayer from './SequencePlayer.astro';
import { sidebarThumbnail } from '../sidebar-thumbnails.mts';
interface Props {
  objectId: string;
  datasets: Pick<NonNullable<ShellProps['datasets']>, 'controls' | 'defaultDataset'>;
  /** The drawn page these datasets belong to (an overview's id): their buttons select its dataset on its page (page-datasets.mts). */
  page?: string;
  /** Null leaves the form without an action, so it submits to the page it is spliced into. */
  route?: string | null;
  thumbnailObjectId?: string;
}
const { objectId, datasets, page, route = `/${objectId}/`, thumbnailObjectId = objectId } = Astro.props;
const previewUrl = (dataset: NonNullable<ShellProps['datasets']>['controls'][number]) =>
  sidebarThumbnail(thumbnailObjectId, dataset.id)?.url2x ?? dataset.thumbnailUrl;
// A dataset that names a companion cloud keeps the plates of another dataset, so the body on screen is drawn in that
// one's scale. Its legend is published beside the cloud's own, or the reader is left with a body nothing explains.
const borrowedLegend = (dataset: NonNullable<ShellProps['datasets']>['controls'][number]) => {
  const surface = dataset.volume?.surface;
  if (surface === undefined) return undefined;
  const lender = datasets.controls.find(candidate => candidate.id === surface);
  if (!lender?.legend) return undefined;
  // A dataset that carries the very scale it borrows publishes it once, not twice.
  return JSON.stringify(lender.legend) === JSON.stringify(dataset.legend) ? undefined : lender;
};
// A dataset shown as a sequence lists its group once, as the step it opens on (its first, or its last for a record whose
// newest date leads); every step's details step to its neighbours.
type Control = NonNullable<ShellProps['datasets']>['controls'][number];
const stepMembers = (dataset: Control) => dataset.step ? datasets.controls.filter(candidate => candidate.step?.group === dataset.step!.group) : [];
const opening = (members: Control[]) => members[0]?.step?.opens === 'last' ? members.at(-1) : members[0];
const listed = (dataset: Control) => !dataset.step || opening(stepMembers(dataset))?.id === dataset.id;
const defaultControl = datasets.controls.find(dataset => dataset.id === datasets.defaultDataset);
const defaultListedId = defaultControl?.step ? opening(stepMembers(defaultControl))?.id : defaultControl?.id;
import Detached from './Detached.astro';
---
<section id={`${objectId}-dataset-list`} class="object-datasets">
  <form id={`${objectId}-datasets`} action={route ?? undefined} method="get" data-dataset-form data-drawn-page={page} hidden>
    {['v', 'overview', 'feature'].map(name => <input type="hidden" name={name} data-view-context disabled />)}
  </form>
  <div id={`${objectId}-layers-menu`} class="object-layers-menu">
    <div class="object-dataset-picker" data-dataset-picker>
      <div class="object-dataset-picker-display">
        <span class="object-dataset-picker-current">
          {datasets.controls.filter(listed).map(dataset => <span class="object-dataset-picker-selection"
            data-dataset-selected={dataset.id} hidden={dataset.id !== defaultListedId}>
            <DatasetThumbnail class="object-dataset-picker-preview" src={previewUrl(dataset)} />
            <span class="object-dataset-picker-text"><span class="object-dataset-picker-label">{dataset.label}</span>
              {dataset.detail && <span class="object-dataset-picker-detail">{dataset.detail}</span>}</span>
          </span>)}
        </span>
        <span class="object-dataset-picker-chevron" aria-hidden="true"></span>
        <select class="object-dataset-native-select" data-dataset-native-select aria-label="Dataset">
          {datasets.controls.filter(listed).map(dataset => <option value={dataset.id} selected={dataset.id === defaultListedId}>
            {dataset.label}{dataset.detail ? ` — ${dataset.detail}` : ''}
          </option>)}
        </select>
      </div>
    <nav class="object-observation-controls" aria-label="Datasets">
      {datasets.controls.map((dataset) => (
        <div id={`${objectId}-${dataset.id}-option`} class="object-observation-option" data-dataset-option data-system-dataset={dataset.systemDataset ? dataset.id : undefined}
          data-step-group={dataset.step?.group} data-step-autoplay={dataset.step?.autoplay === false ? 'false' : undefined}
          data-step-listed={dataset.step ? String(listed(dataset)) : undefined} hidden={!listed(dataset) || undefined}>
          <button
            class="object-observation-control object-thumbnail-leading object-result-row"
            type="submit"
            form={`${objectId}-datasets`}
            name="dataset"
            value={dataset.id}
            aria-pressed={dataset.id === datasets.defaultDataset ? "true" : "false"}
            aria-controls={`${objectId}-${dataset.id}-details`}
            title={dataset.title}
          >
            <DatasetThumbnail class="object-dataset-icon" src={previewUrl(dataset)} />
            <span class="object-dataset-label">{dataset.label}</span>
            {dataset.detail && <span class="object-dataset-detail">{dataset.detail}</span>}
          </button>
        </div>
      ))}
    </nav>
    </div>
  </div>
</section>
<section
  id={`${objectId}-surface-dataset`}
  class="object-dataset-details"
>
  <div class="object-dataset-details-body" aria-live="polite" aria-atomic="true">
    {datasets.controls.map((dataset) => (
      <Detached detached={dataset.id !== datasets.defaultDataset}><div
        id={`${objectId}-${dataset.id}-details`}
        data-dataset-details={page ? undefined : dataset.id}
        data-system-dataset-details={!page && dataset.systemDataset ? dataset.id : undefined}
        data-page-dataset-details={page ? dataset.id : undefined}
        hidden={dataset.id !== datasets.defaultDataset}
      >
        <DatasetDescription {dataset}>
          {dataset.texture && <div
              class="object-surface-minimap"
              data-surface-minimap={dataset.texture.minimap ? JSON.stringify(dataset.texture.minimap) : undefined}
            >
              <img
                class="object-dataset-texture"
                src={dataset.texture.url}
                width={dataset.texture.width}
                height={dataset.texture.height}
                alt={dataset.title}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
              {dataset.step && <SequencePlayer {objectId} {dataset} members={stepMembers(dataset)} playable={!page} />}
            </div>}
          {dataset.step && !dataset.texture && <SequencePlayer {objectId} {dataset} members={stepMembers(dataset)} playable={!page} />}
          {borrowedLegend(dataset) && <DatasetLegend {objectId} dataset={borrowedLegend(dataset)!} owner={dataset.id} />}
          <DatasetLegend {objectId} {dataset} />
        </DatasetDescription>
      </div></Detached>
    ))}
  </div>
</section>
