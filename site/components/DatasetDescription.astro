---
import type { Props as ShellProps } from '../object-shell-types';
interface Props { dataset: NonNullable<ShellProps['datasets']>['controls'][number]; }
import { validateDatasetText } from "../dataset-content.mts";
import SelectedContent from "./SelectedContent.astro";
const { dataset } = Astro.props;
const { title } = validateDatasetText(dataset);
---
<SelectedContent title={dataset.color ? undefined : title} description={dataset.summary}>
  <slot />
</SelectedContent>
{dataset.sourceUrl && <a class="object-dataset-source-link" href={dataset.sourceUrl} target="_blank" rel="noopener noreferrer">View source ↗</a>}
