---
import { datasetCaption } from "../dataset-caption.mjs";
import SelectedContent from "./SelectedContent.astro";
const { provenance, lens } = Astro.props;
const caption = datasetCaption(provenance, lens);
const description = lens.summary ?? lens.description;
---
<SelectedContent title={caption.title} {description} descriptionDetail={lens.description} href={caption.href}>
  <slot />
</SelectedContent>
