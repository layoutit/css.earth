---
import type { Props as ShellProps } from '../planet-shell-types';
interface Props { lens: NonNullable<ShellProps['lenses']>['controls'][number]; }
import { validateDatasetText } from "../dataset-content.mts";
import SelectedContent from "./SelectedContent.astro";
const { lens } = Astro.props;
const { title } = validateDatasetText(lens);
---
<SelectedContent {title} description={lens.summary}>
  <slot />
</SelectedContent>
