---
import type { PreparedAssets } from '@cssearth/renderer/rendering/prepared-residency.ts';

interface Props {
  preparedAssets: PreparedAssets;
}

// `preparedAssets` (from `loadObjectPageData`) is already resolved to the published origin
// when ASSET_ORIGIN is set.
const { preparedAssets } = Astro.props;
const startupKeys = new Set(preparedAssets.startup);
const urls = [...new Set(preparedAssets.entries.filter((asset) => startupKeys.has(asset.key)).map((asset) => asset.url).filter(
  (url): url is string => typeof url === "string" && url.length > 0,
))];
---

{urls.map((url) => (
  <link rel="preload" href={url} as="image" type={url.endsWith(".webp") ? "image/webp" : undefined} />
))}
