---
import "../planet-navigation-marker.css";

interface Props {
  planetId: string;
  color: string;
  index: number;
  count: number;
  scale?: number;
}

const { planetId, color, index, count, scale = 1 } = Astro.props;
const markerPresentation = Object.freeze({
  mercury: Object.freeze({ size: 5 }),
  venus: Object.freeze({ size: 7 }),
  earth: Object.freeze({ size: 7 }),
  moon: Object.freeze({ size: 6 }),
  mars: Object.freeze({ size: 6 }),
  jupiter: Object.freeze({ size: 16, ringAngle: -2, ringExtra: 12, ringHeight: 5 }),
  saturn: Object.freeze({ size: 15, ringAngle: -18, ringExtra: 14, ringHeight: 6 }),
  uranus: Object.freeze({ size: 10, ringAngle: 78, ringExtra: 11, ringHeight: 4 }),
  neptune: Object.freeze({ size: 10, ringAngle: -28, ringExtra: 11, ringHeight: 4 }),
});
const presentation = markerPresentation[planetId];
if (!presentation) throw new Error(`Missing top-navigation marker presentation for ${planetId}`);
const ringed = presentation.ringAngle !== undefined;
const style = [
  `--planet-color:${color}`,
  `--planet-size:${presentation.size * scale}px`,
  `--planet-marker-count:${count}`,
  `--planet-marker-position:${((index / Math.max(1, count - 1)) * 100).toFixed(4)}%`,
  ringed ? `--planet-ring-angle:${presentation.ringAngle}deg` : "",
  ringed ? `--planet-ring-extra:${presentation.ringExtra * scale}px` : "",
  ringed ? `--planet-ring-height:${presentation.ringHeight * scale}px` : "",
].filter(Boolean).join(";");
---

<span class:list={["planet-navigation-marker", planetId, { ringed }]} style={style} aria-hidden="true">
  <i></i>
</span>
