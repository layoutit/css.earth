---
import "../planet-navigation-marker.css";
import { PREPARED_NAVIGATION_MARKERS } from "../prepared-navigation-markers.mjs";
import { markerStyle } from "../../src/navigation/marker-presentation.mts";

interface Props {
  planetId: string;
  color: string;
  scale?: number;
  minSize?: number;
}

const { planetId, color, scale = 1, minSize = 0 } = Astro.props;
const marker = PREPARED_NAVIGATION_MARKERS[planetId];
const effectiveScale = Math.max(scale, minSize / marker.presentation.size);
const { ringed, style, innerStyle, ringStyle } = markerStyle(marker, { color, scale: effectiveScale });
---

<span class:list={["planet-navigation-marker", planetId, { ringed }]} style={style} aria-hidden="true">
  <i style={innerStyle}></i>
  {ringed && <b class="planet-navigation-ring" style={ringStyle}></b>}
</span>
