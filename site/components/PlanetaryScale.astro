---
import {
  PLANET_NAVIGATION_OBJECTS,
} from "../planet-search-objects.mjs";
import {
  PLANETARY_SCALE_LABEL,
  positionPlanetsByDistance,
} from "../planetary-scale.mjs";
import PlanetNavigationMarker from "./PlanetNavigationMarker.astro";
import "../planetary-scale.css";

interface Props {
  activeObjectId: string;
}

const { activeObjectId } = Astro.props;
const positionedPlanets = positionPlanetsByDistance(PLANET_NAVIGATION_OBJECTS);
---

<nav class="planetary-navigation" aria-label={PLANETARY_SCALE_LABEL}>
  <ol
    class="scale-stops"
    style={`--planet-track-start:${positionedPlanets[0].scalePositionPercent}%`}
  >
    {positionedPlanets.map((planet) => (
      <li
        class:list={["scale-planet", planet.id, { active: planet.id === activeObjectId }]}
        data-planet-id={planet.id}
        style={`--planet-offset:${planet.scalePositionPercent}%`}
      >
        <a
          class="scale-stop"
          href={planet.route}
          aria-current={planet.id === activeObjectId ? "page" : undefined}
          aria-label={`${planet.name}, ${planet.distanceAu} astronomical units from the Sun`}
        >
          <PlanetNavigationMarker
            planetId={planet.id}
            color={planet.color}
          />
          <span class="scale-label">{planet.name}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
