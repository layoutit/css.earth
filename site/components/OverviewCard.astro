---
import type { OverviewObject } from '@cssearth/objects';
import { isRecord } from '@cssearth/core';
import type { Props as ObjectProps } from '../object-shell-types';
import { temperatureColor } from '@cssearth/engine';
import ObjectCard from './ObjectCard.astro';
import ObjectCardHeader from './ObjectCardHeader.astro';
import ObjectBreadcrumbs from './ObjectBreadcrumbs.astro';
import InformationTabs from './InformationTabs.astro';
import ContextNavigationMarker from './ContextNavigationMarker.astro';
import ObjectNavigationMarker from './ObjectNavigationMarker.astro';
import ObjectFactsheet from './ObjectFactsheet.astro';
import DatasetList from './DatasetList.astro';
import { OBJECTS, SCENE_OBJECTS } from '../objects.mts';
import { FOCUS_CATALOG_DATA } from '../focus-catalog-data.mts';
import { pageDatasetList } from '../page-datasets-content.mts';
import { SOLAR_SYSTEM_ID, allPlanetarySystems } from '../object-systems.mts';
import overviewFacts from '../source/overview-facts.json';
import planetarySystems from '../source/planetary-systems.json';

/** One overview's card, entirely from its registry entry (overview-object.ts): its name, description and breadcrumbs, its
 * page's datasets, a tab for each group of subjects it holds with a list label, and its factsheet when
 * site/source/overview-facts.json has one. A held `star` group lists the planetary systems; any other lists the registry's
 * subjects of those classifications (catalogue focuses, member overviews), each with its distance from the others. */
interface Props { overview: OverviewObject }
const { overview } = Astro.props;
const PARSEC_M = 3.085677581491367e16, LIGHT_YEAR_M = 9460730472580800;
const catalogue = new Map(FOCUS_CATALOG_DATA.flatMap(({ data }) => data.objects.map(object => [object.id, object] as const)));
const distance = (pc: number) => {
  const ly = pc * 3.261563777, divisor = ly >= 1e6 ? 1e6 : ly >= 1e3 ? 1e3 : 1;
  return { value: new Intl.NumberFormat('en', { maximumSignificantDigits: 3 }).format(ly / divisor), unit: divisor === 1e6 ? 'Mly' : divisor === 1e3 ? 'kly' : 'ly' };
};
const slug = (label: string) => label.toLocaleLowerCase('en').replace(/[^a-z0-9]+/gu, '-').replace(/^-|-$/gu, '');
type Member = { id: string; name: string; href: string; focusId?: string; positionM: readonly number[]; distancePc: number; holdsStars: boolean };
const members = (classifications: readonly string[]): Member[] => OBJECTS.filter(object => object.id !== overview.id).flatMap((object): Member[] => {
  if (object.kind === 'prepared-focus') {
    if (!classifications.includes(object.classification)) return [];
    const record = catalogue.get(object.id);
    if (!record) throw new Error(`${overview.id} lists ${object.id}, which no prepared catalogue places.`);
    return [{ id: object.id, name: object.name, href: object.route, focusId: object.id, positionM: record.positionM, distancePc: record.distance.valuePc, holdsStars: false }];
  }
  if (object.kind === 'overview') {
    if (!object.classification || !classifications.includes(object.classification)) return [];
    if (!object.originM) throw new Error(`${overview.id} lists ${object.id}, whose package has no volume origin to place it.`);
    return [{ id: object.id, name: object.name, href: object.route, positionM: object.originM, distancePc: Math.hypot(...object.originM) / PARSEC_M,
      holdsStars: object.holds.some(group => group.classifications.includes('star')) }];
  }
  if (!classifications.includes(object.classification) || !object.worldFrame) return [];
  return [{ id: object.id, name: object.name, href: object.route, positionM: object.worldFrame.originM, distancePc: object.distance.meters / PARSEC_M, holdsStars: false }];
}).sort((a, b) => a.distancePc - b.distancePc);
const lists = overview.holds.flatMap(group => {
  if (!group.list) return [];
  if (group.classifications.includes('star') && group.classifications.length > 1) throw new Error(`${overview.id} lists stars with other subjects; stars list as planetary systems on their own.`);
  return [{ id: slug(group.list), label: group.list, stars: group.classifications.includes('star'), members: members(group.classifications) }];
});
// The planetary systems a held star group lists: the Solar System first, then every prepared system by distance, then the
// systems not available yet.
const systemStar = SCENE_OBJECTS.find(object => object.id === SOLAR_SYSTEM_ID)!;
const hostedSystems = allPlanetarySystems(SCENE_OBJECTS).filter(system => system.id !== SOLAR_SYSTEM_ID)
  .map(system => { const star = SCENE_OBJECTS.find(object => object.id === system.id)!; return { system, star, distanceLy: Math.round(star.distance.meters / LIGHT_YEAR_M) }; })
  .sort((a, b) => a.distanceLy - b.distanceLy);
const unavailableSystems = planetarySystems.unavailable.map(system => ({ ...system, markerColor: `rgb(${temperatureColor(system.temperatureK).join(' ')})` }));
const factsEntry: unknown = Object.hasOwn(overviewFacts, overview.id) ? (overviewFacts as Record<string, unknown>)[overview.id] : undefined;
if (factsEntry !== undefined && !(isRecord(factsEntry) && Array.isArray(factsEntry.facts))) throw new Error(`site/source/overview-facts.json: ${overview.id} needs a facts list.`);
const facts = isRecord(factsEntry) ? { facts: factsEntry.facts as ObjectProps['facts'] } : undefined;
const tabs = [...lists.map(list => ({ id: list.id, label: list.label, count: list.stars ? 1 + hostedSystems.length + unavailableSystems.length : list.members.length })),
  ...(facts ? [{ id: 'factsheet', label: 'Factsheet' }] : [])];
const datasets = pageDatasetList(overview.id);
// A card's distances are measured from the member that holds the stars, where it lists one (the Milky Way in the Local
// Group: the view from home); otherwise from the observer, as the catalogues publish them.
const home = lists.flatMap(list => list.members).find(member => member.holdsStars)?.id ?? 'observer';
---
<ObjectCard class="object-overview-card" data-large-scale-overview={overview.id} data-large-scale-name={overview.name} data-neighbor-home={home} hidden>
  <ObjectCardHeader heading={false} title={{ label: overview.name }} introduction={overview.description}>
    <ObjectBreadcrumbs scope={overview.id} />
  </ObjectCardHeader>
  {datasets && <div class="object-dataset-content" data-page-datasets={overview.id} data-default-dataset={datasets.defaultDataset}
    data-dataset-views={JSON.stringify(datasets.views)}>
    <DatasetList objectId={`page-${overview.id}`} thumbnailObjectId={overview.id} page={overview.id} route={overview.route}
      datasets={{ controls: datasets.controls, defaultDataset: datasets.defaultDataset }} focus />
  </div>}
  {tabs.length > 0 && <InformationTabs idPrefix={overview.id} group={overview.id} label={`${overview.name} information`} hidden {tabs} />}
  {lists.map(list => <div class="object-results-scroll object-card-tabpanel" id={`${overview.id}-${list.id}-content`} hidden role="region" aria-label={list.label}>
    <ul class="object-list">
      {list.stars ? <>
        <li>
          <a class="object-link object-observation-control object-thumbnail-leading" href={`${systemStar.route}?overview=system`} aria-label="Browse Solar System">
            <span class="object-dataset-icon"><ObjectNavigationMarker objectId={systemStar.id} color={systemStar.color} /></span>
            <span class="object-name object-dataset-label">Solar System</span>
          </a>
        </li>
        {hostedSystems.map(({ system, star, distanceLy }) => <li>
          <a class="object-link object-observation-control object-thumbnail-leading" href={`${system.route}?overview=system`} aria-label={`Browse ${system.name}`}>
            <span class="object-dataset-icon"><ObjectNavigationMarker objectId={star.id} color={star.color} /></span>
            <span class="object-name object-dataset-label">{star.name}</span>
            <span class="object-distance object-dataset-detail"><span class="object-distance-value">≈{distanceLy}</span>{" "}<span class="object-distance-unit">ly</span></span>
          </a>
        </li>)}
        {unavailableSystems.map(system => <li>
          <span class="object-link object-observation-control object-thumbnail-leading" role="link" aria-disabled="true" title="Not available yet">
            <span class="object-dataset-icon"><ObjectNavigationMarker objectId={systemStar.id} color={system.markerColor} scale={system.radiusSolar} /></span>
            <span class="object-name object-dataset-label">{system.name}</span>
            <span class="object-distance object-dataset-detail"><span class="object-distance-value">≈{system.distanceLy}</span>{" "}<span class="object-distance-unit">ly</span></span>
          </span>
        </li>)}
      </> : list.members.map(member => <li data-neighbor-id={member.id}
        data-neighbor-distances={JSON.stringify({ observer: member.distancePc, ...Object.fromEntries(list.members.map(origin => [origin.id,
          Math.hypot(...member.positionM.map((value, axis) => value - origin.positionM[axis]!)) / PARSEC_M])) })}>
        <a class="object-link object-observation-control object-thumbnail-leading" href={member.href} data-prepared-focus-id={member.focusId}>
          <span class="object-dataset-icon"><ContextNavigationMarker objectId={member.id} /></span>
          <span class="object-name object-dataset-label">{member.name}</span>
          <span class="object-distance object-dataset-detail" title="Published catalogue distance from the Solar System">
            <span class="object-distance-value">≈{distance(member.distancePc).value}</span>{" "}
            <span class="object-distance-unit">{distance(member.distancePc).unit}</span>
          </span>
        </a>
      </li>)}
    </ul>
  </div>)}
  {facts && <div class="object-results-scroll object-card-tabpanel" id={`${overview.id}-factsheet-content`} hidden role="region" aria-label="Factsheet">
    <ObjectFactsheet id={overview.id} facts={facts.facts} embedded />
  </div>}
</ObjectCard>
