---
import type { OverviewObject } from '@cssearth/objects';
import { isRecord } from '@cssearth/core';
import type { Props as ObjectProps } from '../object-shell-types';
import ObjectCard from './ObjectCard.astro';
import ObjectCardHeader from './ObjectCardHeader.astro';
import ObjectBreadcrumbs from './ObjectBreadcrumbs.astro';
import InformationTabs from './InformationTabs.astro';
import ObjectResult from './ObjectResult.astro';
import { overviewDistanceM } from '../overview-context.mts';
import { objectResultMarkup } from '../server/object-result-markup.mts';
import { overviewResult } from '../server/overview-result.mts';
import { PREPARED_CATALOGUE_INDEX } from '../search/prepared-catalogue-index.mts';
import ObjectFactsheet from './ObjectFactsheet.astro';
import DatasetList from './DatasetList.astro';
import { OBJECTS, SCENE_OBJECTS } from '../objects.mts';
import { FOCUS_CATALOG_DATA } from '../focus-catalog-data.mts';
import { pageDatasetList } from '../page-datasets-content.mts';
import overviewFacts from '../source/overview-facts.json';

/** One overview's card, entirely from its registry entry (overview-object.ts): its name, description and breadcrumbs, its
 * page's datasets, a tab for each group of subjects it holds with a list label, and its factsheet when
 * site/source/overview-facts.json has one. Each held group with a list label lists the registry's
 * subjects of those classifications (catalogue focuses, member overviews), each with its distance from the others. */
interface Props { overview: OverviewObject }
const { overview } = Astro.props;
const PARSEC_M = 3.085677581491367e16;
const catalogue = new Map(FOCUS_CATALOG_DATA.flatMap(({ data }) => data.objects.map(object => [object.id, object] as const)));
const distance = (pc: number) => {
  const ly = pc * 3.261563777, divisor = ly >= 1e6 ? 1e6 : ly >= 1e3 ? 1e3 : 1;
  return { value: new Intl.NumberFormat('en', { maximumSignificantDigits: 3 }).format(ly / divisor), unit: divisor === 1e6 ? 'Mly' : divisor === 1e3 ? 'kly' : 'ly' };
};
const slug = (label: string) => label.toLocaleLowerCase('en').replace(/[^a-z0-9]+/gu, '-').replace(/^-|-$/gu, '');
type Member = { id: string; name: string; positionM: readonly number[]; distancePc: number; holdsStars: boolean };
const members = (classifications: readonly string[]): Member[] => OBJECTS.filter(object => object.id !== overview.id).flatMap((object): Member[] => {
  if (object.kind === 'prepared-focus') {
    if (!classifications.includes(object.classification)) return [];
    const record = catalogue.get(object.id);
    if (!record) throw new Error(`${overview.id} lists ${object.id}, which no prepared catalogue places.`);
    return [{ id: object.id, name: object.name, positionM: record.positionM, distancePc: record.distance.valuePc, holdsStars: false }];
  }
  if (object.kind === 'overview') {
    if (!object.classification || !classifications.includes(object.classification)) return [];
    if (!object.originM) throw new Error(`${overview.id} lists ${object.id}, whose package has no volume origin to place it.`);
    return [{ id: object.id, name: object.name, positionM: object.originM, distancePc: Math.hypot(...object.originM) / PARSEC_M,
      holdsStars: object.holds.some(group => group.classifications.includes('star')) }];
  }
  if (!classifications.includes(object.classification) || !object.worldFrame) return [];
  return [{ id: object.id, name: object.name, positionM: object.worldFrame.originM, distancePc: object.distance.meters / PARSEC_M, holdsStars: false }];
}).sort((a, b) => a.distancePc - b.distancePc);
const lists = overview.holds.flatMap(group => {
  if (!group.list) return [];
  return [{ id: slug(group.list), label: group.list, members: members(group.classifications) }];
});
const factsEntry: unknown = Object.hasOwn(overviewFacts, overview.id) ? (overviewFacts as Record<string, unknown>)[overview.id] : undefined;
if (factsEntry !== undefined && !(isRecord(factsEntry) && Array.isArray(factsEntry.facts))) throw new Error(`site/source/overview-facts.json: ${overview.id} needs a facts list.`);
const facts = isRecord(factsEntry) ? { facts: factsEntry.facts as ObjectProps['facts'] } : undefined;
// Unlabelled held scene groups expose a small featured navigation list, using the search's exact rows.
const classifications = overview.holds.filter(group => !group.list && group.classifications.includes('star')).flatMap(group => group.classifications);
const sceneMembers = SCENE_OBJECTS.filter(object => classifications.includes(object.classification)
  && (object.id === overview.sceneHostId || object.discovery.featured)
  && (!overview.zoom.centreWithin || object.distance.meters < overviewDistanceM(overview.zoom.centreWithin)))
  .sort((a, b) => Number(b.id === overview.sceneHostId) - Number(a.id === overview.sceneHostId) || a.distance.meters - b.distance.meters);
const resultRows = new Map(PREPARED_CATALOGUE_INDEX.entries.filter(row => row.kind !== 'system').map(row => [row.id, row]));
const memberMarkup = (member: Member) => {
  const object = OBJECTS.find(object => object.id === member.id);
  const row = object?.kind === 'overview' ? overviewResult(object) : resultRows.get(member.id);
  if (!row) throw new Error(`Missing search row for ${overview.id} member ${member.id}.`);
  const { value, unit } = distance(member.distancePc);
  const text = `≈${value} ${unit}`, title = 'Published catalogue distance from the Solar System';
  return objectResultMarkup({ ...row, detail: { text, value: `≈${value}`, unit, title, ariaLabel: `${text}. ${title}` } });
};
const datasets = pageDatasetList(overview.id);
const tabs = [...(sceneMembers.length ? [{ id: 'bodies', label: 'Celestial bodies' }] : []),
  ...lists.map((list, index) => ({ id: list.id, label: index === 0 ? 'Celestial bodies' : list.label, count: list.members.length })),
  ...(datasets ? [{ id: 'datasets', label: 'Datasets' }] : []),
  ...(facts ? [{ id: 'factsheet', label: 'Factsheet' }] : [])];
// A card's distances are measured from the member that holds the stars, where it lists one (the Milky Way in the Local
// Group: the view from home); otherwise from the observer, as the catalogues publish them.
// The first tab opens the card; the other tabs' panels wait in templates until chosen (tab-panels.mts).
const opening = tabs[0]?.id;
const home = lists.flatMap(list => list.members).find(member => member.holdsStars)?.id ?? 'observer';
import Detached from './Detached.astro';
---
<Detached detached><ObjectCard class="object-overview-card" data-large-scale-overview={overview.id} data-large-scale-name={overview.name} data-neighbor-home={home} hidden>
  <ObjectCardHeader heading={false} title={{ label: overview.name }} introduction={overview.description}>
    <ObjectBreadcrumbs scope={overview.id} />
  </ObjectCardHeader>
  {tabs.length > 0 && <InformationTabs idPrefix={overview.id} group={overview.id} label={`${overview.name} information`} {tabs} />}
  {datasets && <Detached detached={opening !== 'datasets'}><div class="object-results-scroll object-card-tabpanel object-dataset-content" id={`${overview.id}-datasets-content`}
    role="region" aria-label="Datasets" data-page-datasets={overview.id} data-default-dataset={datasets.defaultDataset}
    data-dataset-views={JSON.stringify(datasets.views)}>
    <DatasetList objectId={`page-${overview.id}`} thumbnailObjectId={overview.id} page={overview.id} route={overview.route}
      datasets={{ controls: datasets.controls, defaultDataset: datasets.defaultDataset }} focus />
  </div></Detached>}
  {sceneMembers.length > 0 && <Detached detached={opening !== 'bodies'}><div class="object-results-scroll object-card-tabpanel" id={`${overview.id}-bodies-content`} role="region" aria-label="Celestial bodies">
    <ul class="object-list">{sceneMembers.map(object => <ObjectResult {object} />)}</ul>
  </div></Detached>}
  {lists.map(list => <Detached detached={opening !== list.id}><div class="object-results-scroll object-card-tabpanel" id={`${overview.id}-${list.id}-content`} role="region" aria-label={list.label}>
    <ul class="object-list">
      {list.members.map(member => <li class="object-item" data-neighbor-id={member.id}
        data-neighbor-distances={JSON.stringify({ observer: member.distancePc, ...Object.fromEntries(list.members.map(origin => [origin.id,
          Math.hypot(...member.positionM.map((value, axis) => value - origin.positionM[axis]!)) / PARSEC_M])) })}>
        <Fragment set:html={memberMarkup(member)} />
      </li>)}
    </ul>
  </div></Detached>)}
  {facts && <Detached detached={opening !== 'factsheet'}><div class="object-results-scroll object-card-tabpanel" id={`${overview.id}-factsheet-content`} role="region" aria-label="Factsheet">
    <ObjectFactsheet id={overview.id} facts={facts.facts} embedded />
  </div></Detached>}
</ObjectCard></Detached>
