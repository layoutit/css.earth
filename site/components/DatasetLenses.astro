---
import type { Props as ShellProps } from '../object-shell-types';
import DatasetLegend from './DatasetLegend.astro';
import DatasetDescription from './DatasetDescription.astro';
import SequencePlayer from './SequencePlayer.astro';
import { sidebarThumbnail } from '../sidebar-thumbnails.mts';
interface Props {
  objectId: string;
  lenses: Pick<NonNullable<ShellProps['lenses']>, 'controls' | 'defaultLens'>;
  /** The lenses of something the scene draws (a catalogue focus, an overview), rather than of the scene's own object. */
  focus?: boolean;
  /** The drawn page these lenses belong to (an overview's id): their buttons select its dataset on its page (page-datasets.mts). */
  page?: string;
  /** Null leaves the form without an action, so it submits to the page it is spliced into. */
  route?: string | null;
  thumbnailObjectId?: string;
}
const { objectId, lenses, focus = false, page, route = `/${objectId}/`, thumbnailObjectId = objectId } = Astro.props;
const previewUrl = (lens: NonNullable<ShellProps['lenses']>['controls'][number]) =>
  sidebarThumbnail(thumbnailObjectId, lens.id)?.url2x ?? lens.thumbnailUrl;
const sprite = !focus && lenses.controls.length > 1;
const spriteColumns = Math.ceil(Math.sqrt(lenses.controls.length));
// A dataset that names a companion cloud keeps the plates of another dataset, so the body on screen is drawn in that
// one's scale. Its legend is published beside the cloud's own, or the reader is left with a body nothing explains.
const borrowedLegend = (lens: NonNullable<ShellProps['lenses']>['controls'][number]) => {
  const surface = lens.volume?.surface;
  if (surface === undefined) return undefined;
  const lender = lenses.controls.find(candidate => candidate.id === surface);
  if (!lender?.legend) return undefined;
  // A dataset that carries the very scale it borrows publishes it once, not twice.
  return JSON.stringify(lender.legend) === JSON.stringify(lens.legend) ? undefined : lender;
};
// A dataset shown as a sequence lists its group once, as its first step; every step's details step to its neighbours.
type Control = NonNullable<ShellProps['lenses']>['controls'][number];
const stepMembers = (lens: Control) => lens.step ? lenses.controls.filter(candidate => candidate.step?.group === lens.step!.group) : [];
const listed = (lens: Control) => !lens.step || stepMembers(lens)[0]?.id === lens.id;
const defaultControl = lenses.controls.find(lens => lens.id === lenses.defaultLens);
const defaultListedId = defaultControl?.step ? stepMembers(defaultControl)[0]?.id : defaultControl?.id;
---
<section id={`${objectId}-lenses`} class="object-lenses">
  <form id={`${objectId}-datasets`} action={route ?? undefined} method="get" data-dataset-form data-focus-form={focus || undefined} data-drawn-page={page} hidden>
    {['v', 'overview', 'feature'].map(name => <input type="hidden" name={name} data-view-context disabled />)}
  </form>
  <div id={`${objectId}-layers-menu`} class="object-layers-menu">
    <div class="object-lens-picker" data-lens-picker>
      <div class="object-lens-picker-display">
        <span class="object-lens-picker-current">
          {lenses.controls.filter(listed).map(lens => <span class="object-lens-picker-selection"
            data-lens-selected={lens.id} hidden={lens.id !== defaultListedId}>
            <span class="object-lens-picker-preview"><img src={previewUrl(lens)} width="40" height="40" alt="" loading="lazy" decoding="async" /></span>
            <span class="object-lens-picker-text"><span class="object-lens-picker-label">{lens.label}</span>
              {lens.detail && <span class="object-lens-picker-detail">{lens.detail}</span>}</span>
          </span>)}
        </span>
        <span class="object-lens-picker-chevron" aria-hidden="true"></span>
        <select class="object-lens-native-select" data-lens-native-select aria-label={focus ? 'Focus dataset' : 'Dataset'}>
          {lenses.controls.filter(listed).map(lens => <option value={lens.id} selected={lens.id === defaultListedId}>
            {lens.label}{lens.detail ? ` — ${lens.detail}` : ''}
          </option>)}
        </select>
      </div>
    <nav class="object-observation-controls" aria-label="Datasets">
      {lenses.controls.map((lens, index) => (
        <div id={`${objectId}-${lens.id}-option`} class="object-observation-option" data-lens-option data-system-dataset={lens.systemDataset ? lens.id : undefined}
          data-step-group={lens.step?.group} data-step-autoplay={lens.step?.autoplay === false ? 'false' : undefined}
          data-step-listed={lens.step ? String(listed(lens)) : undefined} hidden={!listed(lens) || undefined}>
          <button
            class="object-observation-control object-thumbnail-leading"
            type="submit"
            form={`${objectId}-datasets`}
            name="dataset"
            data-focus-lens={focus ? true : undefined}
            value={lens.id}
            aria-pressed={lens.id === lenses.defaultLens ? "true" : "false"}
            aria-controls={`${objectId}-${lens.id}-details`}
            title={lens.title}
          >
            {sprite
              ? <span class="object-lens-icon" aria-hidden="true" style={`background-image:url(/navigation/dataset-sprites/${objectId}.webp);background-position:-${index % spriteColumns * 14}px -${Math.floor(index / spriteColumns) * 14}px;background-size:${spriteColumns * 14}px ${spriteColumns * 14}px`}></span>
              : <img class="object-lens-icon" src={sidebarThumbnail(thumbnailObjectId, lens.id)?.url2x ?? lens.thumbnailUrl} width="14" height="14" alt="" loading="lazy" decoding="async" />}
            <span class="object-lens-label">{lens.label}</span>
            {lens.detail && <span class="object-lens-detail">{lens.detail}</span>}
          </button>
        </div>
      ))}
    </nav>
    </div>
  </div>
</section>
<section
  id={`${objectId}-surface-lens`}
  class="object-lens-details"
>
  <div class="object-lens-details-body" aria-live="polite" aria-atomic="true">
    {lenses.controls.map((lens) => (
      <div
        id={`${objectId}-${lens.id}-details`}
        data-lens-details={focus ? undefined : lens.id}
        data-system-dataset-details={!focus && lens.systemDataset ? lens.id : undefined}
        data-focus-lens-details={focus ? lens.id : undefined}
        hidden={lens.id !== lenses.defaultLens}
      >
        <DatasetDescription {lens}>
          {lens.texture && <div
              class="object-surface-minimap"
              data-surface-minimap={lens.texture.minimap ? JSON.stringify(lens.texture.minimap) : undefined}
            >
              <img
                class="object-lens-texture"
                src={lens.texture.url}
                width={lens.texture.width}
                height={lens.texture.height}
                alt={lens.title}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
              {lens.step && <SequencePlayer {objectId} {lens} members={stepMembers(lens)} {focus} />}
            </div>}
          {lens.step && !lens.texture && <SequencePlayer {objectId} {lens} members={stepMembers(lens)} {focus} />}
          {borrowedLegend(lens) && <DatasetLegend {objectId} lens={borrowedLegend(lens)!} owner={lens.id} />}
          <DatasetLegend {objectId} {lens} />
        </DatasetDescription>
      </div>
    ))}
  </div>
</section>
