---
import type { Props } from "../planet-shell-types";
import PlanetBreadcrumbs from "./PlanetBreadcrumbs.astro";
import PlanetBodyOverview from "./PlanetBodyOverview.astro";
import { orderScientificCharts } from "../scientific-chart-order.mts";
import PlanetCard from "./PlanetCard.astro";
import PlanetCardHeader from "./PlanetCardHeader.astro";
import PlanetFactsheet from "./PlanetFactsheet.astro";
import PlanetMoonList from "./PlanetMoonList.astro";
import { prepareBodyMoons } from "../prepare-body-moons.mts";
import DatasetContextPanels from "./DatasetContextPanels.astro";
import DatasetLegend from "./DatasetLegend.astro";
import DatasetDescription from "./DatasetDescription.astro";
const { objectId, title, introduction = "", facts = [], moreFacts = [], galleries = [], charts = [], provenance, lenses, destinations } = Astro.props;
const hasLenses = Boolean(lenses && lenses.controls.length > 0);
const moons = prepareBodyMoons(objectId);
const orderedCharts = orderScientificCharts(charts);
const defaultChart = orderedCharts.find((chart) => chart.id === "reflectance") ?? orderedCharts[0];
---

<PlanetCard class="planet-information-panel">
  <PlanetBodyOverview {objectId} {title} {introduction} {facts} {moreFacts} />
      {destinations && <section class="planet-destination-intro">
        <button class="planet-find-destination" type="button">Find a city</button>
        <p>{destinations.description}</p>
      </section>}
      <PlanetCardHeader {title} {introduction}>
          <PlanetBreadcrumbs {objectId} />
      </PlanetCardHeader>
      <div class="planet-card-tabs" role="tablist" aria-label="Object information">
        <button type="button" role="tab" id={`${objectId}-dataset-tab`} data-information-tab="dataset"
          aria-controls={`${objectId}-dataset-content`} aria-selected="true" tabindex="0">
          Datasets
        </button>
        <button type="button" role="tab" id={`${objectId}-factsheet-tab`} data-information-tab="factsheet"
          aria-controls={`${objectId}-factsheet-content`} aria-selected="false" tabindex="-1">Factsheet</button>
        <button type="button" role="tab" id={`${objectId}-moons-tab`} data-information-tab="moons"
          aria-controls={`${objectId}-moons-content`} aria-selected="false" tabindex="-1">Moons</button>
      </div>
      <p data-dataset-notice role="status" aria-live="polite" hidden></p>
      <div class="planet-card-tabpanel" id={`${objectId}-dataset-content`} data-information-panel="dataset"
        role="tabpanel" aria-labelledby={`${objectId}-dataset-tab`} tabindex="0">
      {defaultChart && <details
        id={`${objectId}-charts`}
        class="planet-chart-switcher"
        style="display: none;"
        data-active-chart={defaultChart.id}
        aria-labelledby={`${objectId}-charts-title`}
      >
        <summary class="planet-panel-summary planet-chart-switcher-header">
          <h2
            id={`${objectId}-charts-title`}
            class="planet-panel-heading planet-chart-switcher-title"
            aria-live="polite"
          >
            {orderedCharts.map((chart) => (
              <span
                class="planet-chart-label"
                data-chart-label={chart.id}
                hidden={chart.id !== defaultChart.id}
              >{chart.title.label}</span>
            ))}
          </h2>
          <div class="planet-chart-switcher-controls" aria-label="Choose chart">
            <button
              class="planet-chart-step planet-chart-previous"
              type="button"
              data-chart-step="-1"
              aria-controls={`${objectId}-chart-slides`}
              aria-label="Previous chart"
              disabled={orderedCharts.length < 2}
            ><span aria-hidden="true">‹</span></button>
            <button
              class="planet-chart-step planet-chart-next"
              type="button"
              data-chart-step="1"
              aria-controls={`${objectId}-chart-slides`}
              aria-label="Next chart"
              disabled={orderedCharts.length < 2}
            ><span aria-hidden="true">›</span></button>
          </div>
        </summary>
        <div id={`${objectId}-chart-slides`} class="planet-chart-slides">
          {orderedCharts.map((chart) => (
            <figure
              id={`${objectId}-${chart.id}`}
              class="planet-chart-slide"
              data-chart-id={chart.id}
              data-chart-title={chart.title.label}
              aria-label={chart.title.label}
              hidden={chart.id !== defaultChart.id}
            >
              <img
                class="planet-chart"
                src={chart.src}
                width={chart.width}
                height={chart.height}
                alt={chart.alt}
              />
            </figure>
          ))}
        </div>
      </details>}
      {hasLenses && lenses && <section id={`${objectId}-lenses`} class="planet-lenses">
        <div id={`${objectId}-layers-menu`} class="planet-layers-menu">
          <nav class="planet-observation-controls" aria-label="Datasets">
            {lenses.controls.map((lens) => (
              <div class="planet-observation-option" data-lens-option>
                <button
                  class="planet-observation-control planet-thumbnail-leading"
                  type="button"
                  name="lens"
                  value={lens.id}
                  aria-pressed={lens.id === lenses.defaultLens ? "true" : "false"}
                  aria-controls={`${objectId}-${lens.id}-details`}
                  title={lens.title}
                >
                  <img class="planet-lens-icon" src={lens.thumbnailUrl} width="14" height="14" alt="" />
                  <span class="planet-lens-label">{lens.label}</span>
                  {lens.detail && <span class="planet-lens-detail">{lens.detail}</span>}
                </button>
              </div>
            ))}
          </nav>
        </div>
      </section>}
      {hasLenses && lenses && <section
        id={`${objectId}-surface-lens`}
        class="planet-lens-details"
      >
        <div class="planet-lens-details-body" aria-live="polite" aria-atomic="true">
          {lenses.controls.map((lens) => (
            <div
              id={`${objectId}-${lens.id}-details`}
              data-lens-details={lens.id}
              hidden={lens.id !== lenses.defaultLens}
            >
              <DatasetDescription {provenance} {lens}>
                {lens.texture && <div
                  class="planet-surface-minimap"
                  data-surface-minimap={lens.texture.minimap ? JSON.stringify(lens.texture.minimap) : undefined}
                  role={lens.texture.minimap ? "group" : undefined}
                  tabindex={lens.texture.minimap ? 0 : undefined}
                  aria-label={lens.texture.minimap ? `${lens.label} surface map. Drag or use arrow keys to look around; scroll or use plus and minus to zoom.` : undefined}
                >
                  <img
                    class="planet-lens-texture"
                    data-surface-preview-src={lens.texture.url}
                    width={lens.texture.width}
                    height={lens.texture.height}
                    alt={lens.description}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                  {lens.texture.minimap && <>
                    {[-1, 0, 1].map(() => <span
                      class="planet-minimap-viewport"
                      aria-hidden="true"
                      hidden
                    ></span>)}
                  </>}
                </div>}
                <DatasetLegend {objectId} {lens} />
              </DatasetDescription>
              {lens.facts && lens.facts.length > 0 && <ul class="planet-facts" aria-label={`${lens.label} facts`}>
                {lens.facts.map((fact) => <li>
                  <span class="planet-fact-label">{fact.label}</span>{" "}
                  <span class="planet-fact-value">{fact.value}</span>
                </li>)}
              </ul>}
              {lens.texture?.attribution && <p class="planet-lens-source">
                Source: {lens.texture.attribution.url
                  ? <a href={lens.texture.attribution.url} target="_blank" rel="noreferrer">{lens.texture.attribution.label}</a>
                  : lens.texture.attribution.label}
              </p>}
            </div>
          ))}
        </div>
      </section>}
      {galleries.map((gallery) => (
      <details id={`${objectId}-${gallery.id}`} class="planet-gallery-panel" hidden={gallery.hidden}>
        <summary class="planet-panel-summary">
          <h2 class="planet-panel-heading">{gallery.title.label}</h2>
          <span class="planet-panel-toggle" aria-hidden="true"></span>
        </summary>
        <div class="planet-gallery" aria-label={gallery.title.label}>
          {gallery.items.map((item) => (
            <figure class="planet-gallery-item" data-gallery-item={item.id}>
              <img
                class="planet-gallery-image"
                src={item.src}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="planet-gallery-caption">
                <strong>{item.label}</strong>
                <span>{item.caption}</span>
                <a class="planet-gallery-source" href={item.sourceUrl} target="_blank" rel="noreferrer">Archive file</a>
              </figcaption>
            </figure>
          ))}
          {gallery.qualification && <p class="planet-gallery-qualification">{gallery.qualification}</p>}
        </div>
      </details>
      ))}
      </div>
      <div class="planet-card-tabpanel" id={`${objectId}-factsheet-content`} data-information-panel="factsheet"
        role="tabpanel" aria-labelledby={`${objectId}-factsheet-tab`} tabindex="0" hidden>
        <PlanetFactsheet id={objectId} {facts} {moreFacts} embedded />
      </div>
      <DatasetContextPanels {...Astro.props} />
      <div class="planet-card-tabpanel" id={`${objectId}-moons-content`} data-information-panel="moons"
        role="tabpanel" aria-labelledby={`${objectId}-moons-tab`} tabindex="0" hidden>
        <PlanetMoonList {moons} />
      </div>
    </PlanetCard>
