---
import type { Props } from "../planet-shell-types";
import PlanetBreadcrumbs from "./PlanetBreadcrumbs.astro";
import PlanetBodyOverview from "./PlanetBodyOverview.astro";
import { orderScientificCharts } from "../scientific-chart-order.mts";
import PlanetCard from "./PlanetCard.astro";
import PlanetCardHeader from "./PlanetCardHeader.astro";
import PlanetFactsheet from "./PlanetFactsheet.astro";
import PlanetMoonList from "./PlanetMoonList.astro";
import { prepareBodyMoons } from "../prepare-body-moons.mts";
import DatasetContextPanels from "./DatasetContextPanels.astro";
import DatasetLenses from "./DatasetLenses.astro";
import InformationTabs from './InformationTabs.astro';
const { objectId, title, introduction = "", facts = [], moreFacts = [], galleries = [], charts = [], provenance, lenses, destinations } = Astro.props;
const hasLenses = Boolean(lenses && lenses.controls.length > 0);
const moons = prepareBodyMoons(objectId);
const orderedCharts = orderScientificCharts(charts);
const defaultChart = orderedCharts.find((chart) => chart.id === "reflectance") ?? orderedCharts[0];
---

<PlanetCard class="planet-information-panel">
  <PlanetBodyOverview {objectId} {title} {introduction} {facts} {moreFacts} />
      {destinations && <section class="planet-destination-intro">
        <button class="planet-find-destination" type="button">Find a city</button>
        <p>{destinations.description}</p>
      </section>}
      {/* The overview card above carries the page heading; this tabbed card repeats the title. */}
      <PlanetCardHeader heading={false} {title} {introduction}>
          <PlanetBreadcrumbs {objectId} />
      </PlanetCardHeader>
      <InformationTabs idPrefix={objectId} />
      <p data-dataset-notice role="status" aria-live="polite" hidden></p>
      <div class="planet-card-tabpanel planet-dataset-content" id={`${objectId}-dataset-content`} data-information-panel="dataset"
        role="region" aria-label="Datasets">
      {defaultChart && <details
        id={`${objectId}-charts`}
        class="planet-chart-switcher"
        style="display: none;"
        data-active-chart={defaultChart.id}
        aria-labelledby={`${objectId}-charts-title`}
      >
        <summary class="planet-panel-summary planet-chart-switcher-header">
          <h2
            id={`${objectId}-charts-title`}
            class="planet-panel-heading planet-chart-switcher-title"
            aria-live="polite"
          >
            {orderedCharts.map((chart) => (
              <span
                class="planet-chart-label"
                data-chart-label={chart.id}
                hidden={chart.id !== defaultChart.id}
              >{chart.title.label}</span>
            ))}
          </h2>
          <div class="planet-chart-switcher-controls" aria-label="Choose chart">
            <button
              class="planet-chart-step planet-chart-previous"
              type="button"
              data-chart-step="-1"
              aria-controls={`${objectId}-chart-slides`}
              aria-label="Previous chart"
              disabled={orderedCharts.length < 2}
            ><span aria-hidden="true">‹</span></button>
            <button
              class="planet-chart-step planet-chart-next"
              type="button"
              data-chart-step="1"
              aria-controls={`${objectId}-chart-slides`}
              aria-label="Next chart"
              disabled={orderedCharts.length < 2}
            ><span aria-hidden="true">›</span></button>
          </div>
        </summary>
        <div id={`${objectId}-chart-slides`} class="planet-chart-slides">
          {orderedCharts.map((chart) => (
            <figure
              id={`${objectId}-${chart.id}`}
              class="planet-chart-slide"
              data-chart-id={chart.id}
              data-chart-title={chart.title.label}
              aria-label={chart.title.label}
              hidden={chart.id !== defaultChart.id}
            >
              <img
                class="planet-chart"
                src={chart.src}
                width={chart.width}
                height={chart.height}
                alt={chart.alt}
              />
            </figure>
          ))}
        </div>
      </details>}
      {hasLenses && lenses && <DatasetLenses {objectId} {lenses} {provenance} />}
      {galleries.map((gallery) => (
      <details id={`${objectId}-${gallery.id}`} class="planet-gallery-panel" hidden={gallery.hidden}>
        <summary class="planet-panel-summary">
          <h2 class="planet-panel-heading">{gallery.title.label}</h2>
          <span class="planet-panel-toggle" aria-hidden="true"></span>
        </summary>
        <div class="planet-gallery" aria-label={gallery.title.label}>
          {gallery.items.map((item) => (
            <figure class="planet-gallery-item" data-gallery-item={item.id}>
              <img
                class="planet-gallery-image"
                src={item.src}
                width={item.width}
                height={item.height}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
              <figcaption class="planet-gallery-caption">
                <strong>{item.label}</strong>
                <span>{item.caption}</span>
                <a class="planet-gallery-source" href={item.sourceUrl} target="_blank" rel="noreferrer">Archive file</a>
              </figcaption>
            </figure>
          ))}
          {gallery.qualification && <p class="planet-gallery-qualification">{gallery.qualification}</p>}
        </div>
      </details>
      ))}
      </div>
      <div class="planet-card-tabpanel" id={`${objectId}-factsheet-content`} data-information-panel="factsheet"
        role="region" aria-label="Factsheet">
        <PlanetFactsheet id={objectId} {facts} {moreFacts} embedded />
      </div>
      <DatasetContextPanels {...Astro.props} />
      <div class="planet-card-tabpanel planet-object-results-scroll" id={`${objectId}-moons-content`} data-information-panel="moons"
        role="region" aria-label="Moons">
        <PlanetMoonList {moons} />
      </div>
    </PlanetCard>
