---
import type { Props as ShellProps } from '../contracts/object-shell-types';
interface Props {
  objectId: string;
  datasets?: Pick<NonNullable<ShellProps['datasets']>, 'controls' | 'defaultDataset'>;
  directSourceIdsByDataset?: Readonly<Record<string, readonly string[]>>;
}
import { datasetContributors } from '../content/dataset-context.mts';
import { EXPLORATION } from '../exploration-catalog.mts';
import ObjectCard from './ObjectCard.astro';
import InformationTabs from './InformationTabs.astro';
import SelectedContent from './SelectedContent.astro';
const { objectId, datasets, directSourceIdsByDataset } = Astro.props;
// A dataset drawn from a bank (a nebula's volume, a galaxy's layers) is recorded under the bank, not the body that shows
// it: the Crab's six observation datasets had no telescope card (2026-10-02). A bank records every input against every
// dataset it bakes, so the dataset's own input, which carries its id, is the one its card credits.
const contexts = (datasets?.controls ?? []).map(dataset => {
  const owner = dataset.volume?.objectId ?? objectId, datasetId = dataset.volume?.datasetId ?? dataset.id;
  const own = dataset.volume && (EXPLORATION.graph.byObject[owner] ?? []).some(index => EXPLORATION.graph.edges[index].sourceId === datasetId) ? [datasetId] : undefined;
  return { dataset, ...datasetContributors(owner, datasetId, EXPLORATION.graph, EXPLORATION.catalog, directSourceIdsByDataset?.[dataset.id] ?? own) };
});
const span = (from?: { value: string }, to?: { value: string }) =>
  from ? `${from.value}${to ? `–${to.value}` : ''}` : null;
// Missions and facilities share one contributor shape, so a body that credits
// several of them collapses into a single tabbed card instead of a stack.
const contributors = (context: (typeof contexts)[number]) => [
  ...context.missions.map(mission => ({
    id: mission.id, title: mission.shortName?.value ?? mission.name.value,
    lead: mission.shortName && mission.name.value, description: mission.description.value,
    dates: span(mission.started, mission.ended),
    image: mission.imageId ? EXPLORATION.images[mission.imageId] : undefined,
    emblem: mission.emblemId ? EXPLORATION.emblems[mission.emblemId] : undefined,
    attribute: { 'data-mission': mission.id },
    band: mission.participants.length === 1
      ? EXPLORATION.catalog.facilities.find(facility => facility.id === mission.participants[0].facilityId)?.band?.value
      : undefined,
  })),
  ...context.notes.map(note => ({
    id: note.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    title: note.label, lead: undefined, description: note.reason,
    dates: null, image: undefined, emblem: undefined,
    attribute: { 'data-unresolved': note.label }, band: undefined,
  })),
  ...context.facilities.map(facility => ({
    id: facility.id, title: facility.name.value, lead: undefined, description: facility.description.value,
    dates: span(facility.commissioned, facility.retired) ?? facility.launch?.value ?? null,
    image: facility.imageId ? EXPLORATION.images[facility.imageId] : undefined,
    emblem: undefined, attribute: { 'data-facility': facility.id }, band: facility.band?.value,
  })),
];
// A dataset shows one card: several contributors become its tabs. A tab names
// the part of the spectrum when every contributor has its own band; otherwise
// (Arecibo and Goldstone are both radar, a mission may have no band) it names
// the contributor, so the strip never repeats a label.
const distinctBands = (credited: readonly { band?: string }[]) => {
  const bands = credited.map(entry => entry.band);
  return bands.every(Boolean) && new Set(bands).size === bands.length;
};
import Detached from './Detached.astro';
---
<aside class="object-dataset-context-rail" data-dataset-context-owner={objectId} aria-label="Selected dataset context">
  {contexts.map(context => {
    const credited = contributors(context);
    const tabbed = credited.length > 1, byBand = distinctBands(credited);
    const groups = credited.length ? [credited] : [];
    return <Detached detached={context.dataset.id !== datasets?.defaultDataset}><div data-dataset-context={context.dataset.id} hidden={context.dataset.id !== datasets?.defaultDataset}>
      {groups.map(group => <ObjectCard class="object-dataset-context-card" role="region"
        aria-label={tabbed ? 'Credited machines' : group[0].title}>
        {tabbed && <InformationTabs idPrefix={`${objectId}-${context.dataset.id}`}
          group={`context-${objectId}-${context.dataset.id}`} label="Credited machines" panelSuffix="panel"
          tabs={group.map(entry => ({ id: entry.id, label: byBand ? entry.band! : entry.title }))} />}
        {group.map((entry, index) => {
          const publishedBackdrop = entry.image?.kind.startsWith('published-') ?? false;
          return <Detached detached={tabbed && index > 0}><div class="object-card-tabpanel"
          id={tabbed ? `${objectId}-${context.dataset.id}-${entry.id}-panel` : undefined}
          data-information-group={tabbed ? `context-${objectId}-${context.dataset.id}` : undefined}
          data-information-panel={tabbed ? entry.id : undefined}
          role={tabbed ? 'region' : undefined}
          aria-label={tabbed ? (byBand ? entry.band : entry.title) : undefined}
          tabindex={tabbed ? 0 : undefined}>
          <article class="object-facility" {...entry.attribute}>
            <SelectedContent title={entry.title} lead={entry.lead} description={entry.description}>
              <div slot="header" class:list={{ 'object-facility-preview': Boolean(entry.image || entry.emblem),
                'object-facility-preview-overlay': Boolean(entry.image || entry.emblem) }}>
                <div class:list={['object-facility-heading', publishedBackdrop && 'object-facility-heading-backdrop']}>
                  <h3 class="object-dataset-details-title">{entry.title}</h3>
                  {entry.dates && <span class="object-selected-content-meta">{entry.dates}</span>}
                </div>
                {entry.image && <a class:list={['object-facility-image-link', entry.image.subject && 'object-facility-image-crop']}
                  style={entry.image.subject && `--frame-w:${entry.image.width};--frame-h:${entry.image.height};--subject-x:${entry.image.subject.left};--subject-y:${entry.image.subject.top};--subject-w:${entry.image.subject.width};--subject-h:${entry.image.subject.height}`}
                  href={entry.image.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${entry.title} artwork — ${entry.image.credit}`}>
                  <img class="object-facility-image" src={entry.image.src} width={entry.image.width} height={entry.image.height} alt={`${entry.title} illustration`} loading="lazy" decoding="async" fetchpriority="low" />
                </a>}
                {entry.emblem && <a class="object-facility-emblem" href={entry.emblem.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${entry.title} emblem — ${entry.emblem.credit}`}>
                  <img class="object-facility-image" src={entry.emblem.src} width={entry.emblem.width} height={entry.emblem.height} alt={`${entry.title} emblem`} loading="lazy" decoding="async" fetchpriority="low" />
                </a>}
              </div>
            </SelectedContent>
          </article>
        </div></Detached>; })}
      </ObjectCard>)}
    </div></Detached>;
  })}
</aside>
