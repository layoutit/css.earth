---
import type { Props as ShellProps } from '../planet-shell-types';
interface Props {
  objectId: string;
  lenses?: Pick<NonNullable<ShellProps['lenses']>, 'controls' | 'defaultLens'>;
  provenance?: ShellProps['provenance'];
}
import { datasetContext } from '../dataset-context.mts';
import { EXPLORATION, referenceUrl } from '../exploration-catalog.mts';
import { SOURCE_CATALOGUE, SOURCES } from '../sources-catalog.mts';
import PlanetCard from './PlanetCard.astro';
import InformationTabs from './InformationTabs.astro';
import SelectedContent from './SelectedContent.astro';
const { objectId, lenses, provenance } = Astro.props;
const contexts = (lenses?.controls ?? []).map(lens => ({ lens,
  ...datasetContext(objectId, lens.id, provenance, EXPLORATION.graph, EXPLORATION.catalog, SOURCE_CATALOGUE.usage, SOURCES),
}));
const span = (from?: { value: string }, to?: { value: string }) =>
  from ? `${from.value}${to ? `–${to.value}` : ''}` : null;
// Missions and machines share one contributor shape, so a body that credits
// several of them collapses into a single tabbed card instead of a stack.
const contributors = (context: (typeof contexts)[number]) => [
  ...context.missions.map(mission => ({
    id: mission.id, title: mission.shortName?.value ?? mission.name.value,
    lead: mission.shortName && mission.name.value, description: mission.description.value,
    href: referenceUrl(mission.description), dates: span(mission.started, mission.ended),
    image: mission.imageId ? EXPLORATION.images[mission.imageId] : undefined,
    emblem: mission.emblemId ? EXPLORATION.emblems[mission.emblemId] : undefined,
    attribute: { 'data-mission': mission.id },
    band: mission.participants.length === 1
      ? EXPLORATION.catalog.machines.find(machine => machine.id === mission.participants[0].machineId)?.band?.value
      : undefined,
  })),
  ...context.notes.map(note => ({
    id: note.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    title: note.label, lead: undefined, description: note.reason, href: undefined,
    dates: null, image: undefined, emblem: undefined,
    attribute: { 'data-unresolved': note.label }, band: undefined,
  })),
  ...context.machines.map(machine => ({
    id: machine.id, title: machine.name.value, lead: undefined, description: machine.description.value,
    href: referenceUrl(machine.description),
    dates: span(machine.commissioned, machine.retired) ?? machine.launch?.value ?? null,
    image: machine.imageId ? EXPLORATION.images[machine.imageId] : undefined,
    emblem: undefined, attribute: { 'data-machine': machine.id }, band: machine.band?.value,
  })),
];
// Tabs name the part of the spectrum rather than repeating the heading below
// them, so they only earn their place when every label is different. Two
// machines can share a band — Arecibo and Goldstone are both radar — and a
// strip of identical tabs tells the reader nothing, so those stay separate
// cards as they were.
const distinctBands = (credited: readonly { band?: string }[]) => {
  const bands = credited.map(entry => entry.band);
  return bands.every(Boolean) && new Set(bands).size === bands.length;
};
---
<template data-prepared-detail="dataset-context" data-context-object={objectId}>
  {contexts.map(context => {
    const credited = contributors(context);
    const tabbed = credited.length > 1 && distinctBands(credited);
    // Without tabs each contributor keeps its own card, so one card per group.
    const groups = tabbed ? [credited] : credited.map(entry => [entry]);
    return <div data-dataset-context={context.lens.id} hidden={context.lens.id !== lenses?.defaultLens}>
      {groups.map(group => <PlanetCard class="planet-dataset-context-card" role="region"
        aria-label={tabbed ? 'Credited machines' : group[0].title}>
        {tabbed && <InformationTabs idPrefix={`${objectId}-${context.lens.id}`}
          group={`context-${objectId}-${context.lens.id}`} label="Credited machines" panelSuffix="panel"
          tabs={group.map(entry => ({ id: entry.id, label: entry.band ?? entry.title }))} />}
        {group.map(entry => <div class="planet-card-tabpanel"
          id={tabbed ? `${objectId}-${context.lens.id}-${entry.id}-panel` : undefined}
          data-information-group={tabbed ? `context-${objectId}-${context.lens.id}` : undefined}
          data-information-panel={tabbed ? entry.id : undefined}
          role={tabbed ? 'region' : undefined}
          aria-label={tabbed ? entry.band : undefined}
          tabindex={tabbed ? 0 : undefined}>
          <article class="planet-machine" {...entry.attribute}>
            <SelectedContent title={entry.title} lead={entry.lead} description={entry.description} href={entry.href}>
              <div slot="header" class:list={{ 'planet-machine-preview': Boolean(entry.image || entry.emblem),
                'planet-machine-preview-overlay': entry.image?.kind === 'published-photograph' }}>
                <div class:list={['planet-machine-heading', entry.image?.kind === 'published-photograph' && 'planet-machine-heading-backdrop']}>
                  <h3 class="planet-lens-details-title">{entry.title}</h3>
                  {entry.dates && <span class="planet-selected-content-meta">{entry.dates}</span>}
                </div>
                {entry.image && <a class:list={['planet-machine-image-link', entry.image.subject && 'planet-machine-image-crop']}
                  style={entry.image.subject && `--frame-w:${entry.image.width};--frame-h:${entry.image.height};--subject-x:${entry.image.subject.left};--subject-y:${entry.image.subject.top};--subject-w:${entry.image.subject.width};--subject-h:${entry.image.subject.height}`}
                  href={entry.image.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${entry.title} artwork — ${entry.image.credit}`}>
                  <img class="planet-machine-image" src={entry.image.src} width={entry.image.width} height={entry.image.height} alt={`${entry.title} illustration`} loading="lazy" decoding="async" />
                </a>}
                {entry.emblem && <a class={entry.image ? 'planet-machine-emblem' : 'planet-machine-image-link'} href={entry.emblem.sourceUrl} target="_blank" rel="noreferrer" aria-label={`${entry.title} emblem — ${entry.emblem.credit}`}>
                  <img class="planet-machine-image" src={entry.emblem.src} width={entry.emblem.width} height={entry.emblem.height} alt={`${entry.title} emblem`} loading="lazy" decoding="async" />
                </a>}
              </div>
            </SelectedContent>
          </article>
        </div>)}
      </PlanetCard>)}
      {context.sources.length > 0 && <PlanetCard class="planet-dataset-context-card" role="region" aria-label="Sources">
        <div class="planet-card-tabpanel">
          <h2 class="planet-lens-details-title">Sources</h2>
          <ul class="planet-resources-links">
            {context.sources.map(group => <li class="planet-resource-row">
              {group.links.map(link => <a class="planet-resource-label" data-source={link.id} href={link.href} target="_blank" rel="noreferrer">{link.title}</a>)}
              {group.credit && <span class="planet-resource-description">{group.credit}</span>}
              {group.supporting.length > 0 && <details class="planet-resource-supporting">
                <summary>{group.supporting.length} supporting {group.supporting.length === 1 ? 'file' : 'files'}</summary>
                {group.supporting.map(link => <a class="planet-resource-label" data-source={link.id} href={link.href} target="_blank" rel="noreferrer">{link.title}</a>)}
              </details>}
            </li>)}
          </ul>
        </div>
      </PlanetCard>}
    </div>;
  })}
</template>
