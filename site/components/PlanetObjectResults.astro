---
import { PLANET_SEARCH_OBJECTS } from "../planet-search-objects.mts";
import { OBJECT_CATEGORIES, objectCategory, objectCategoryCount } from "../object-categories.mts";
import PlanetCatalogueRows from "./PlanetCatalogueRows.astro";

interface Props { formId?: string; }
const { formId } = Astro.props;
const searchObjects = PLANET_SEARCH_OBJECTS;
const defaultCategory = 'planet';
const types = new Map(OBJECT_CATEGORIES);
for (const object of searchObjects) if (!types.has(objectCategory(object.classification))) {
  types.set(object.classification, object.classification.replaceAll('-', ' ') + 's');
}
const classifications = searchObjects.map(object => object.classification);
const groups = [...types].map(([type, label]) => ({ type, label,
  count: objectCategoryCount(classifications, type),
}));
// The rows below (systems, overview scopes and every object) are identical on
// every object page. `tools/build-catalogue-fragment.mts` renders them once,
// from `PlanetCatalogueRows.astro`, into one content-addressed file and
// substitutes its hash for these tokens after `astro build`. The client
// fetches that file and inserts it into the placeholder list below; the
// no-JS search function does the same (see `search-response.mts`).
// `astro dev` never runs that build step, so it renders the rows inline
// instead: full fidelity for local development, with no fetch and no stale
// placeholder tokens. The unused pin below is harmless there, since the
// client and the no-JS function only read it when the list starts empty.
const catalogueSrc = '/catalogue/__CATALOGUE_FRAGMENT_SHA__.html';
const catalogueSha256 = '__CATALOGUE_FRAGMENT_SHA__';
const catalogueBytes = '__CATALOGUE_FRAGMENT_BYTES__';
---

<div class="planet-object-tabs" role="tablist" aria-label="Object categories">
  {groups.map((group) => <button type="submit" form={formId} name="category" value={group.type} role="tab"
    id={`object-tab-${group.type}`} data-object-tab={group.type}
    aria-controls="object-category-results" aria-selected={group.type === defaultCategory ? 'true' : 'false'}
    tabindex="0">
    <span>{group.label}</span>{" "}<span class="planet-object-tab-count">({group.count})</span>
  </button>)}
</div>
<div id="object-category-results" class="planet-object-results-scroll" role="tabpanel"
  aria-labelledby={`object-tab-${defaultCategory}`} tabindex="0"
  data-catalogue-src={catalogueSrc} data-catalogue-sha256={catalogueSha256} data-catalogue-bytes={catalogueBytes}
  style={`--object-category-visible-rows: ${Math.min(8, Number(objectCategoryCount(classifications, 'planet')))}`}>
  {import.meta.env.DEV
    ? <PlanetCatalogueRows />
    : <ul class="planet-object-list" data-catalogue-list></ul>}
  <p class="planet-object-loading" role="status" data-catalogue-loading hidden={import.meta.env.DEV}>Loading celestial objects…</p>
  <p class="planet-object-error" role="alert" data-catalogue-error hidden>
    Couldn't load the object list. <button type="button" class="planet-object-retry" data-catalogue-retry>Retry</button>
  </p>
  <p class="planet-object-empty" aria-live="polite" hidden>No matching results</p>
  <slot />
</div>
