---
import { PLANET_SEARCH_OBJECTS, objectClassificationLabel } from "../planet-search-objects.mjs";
import PlanetNavigationMarker from "./PlanetNavigationMarker.astro";

interface Props {
  activeObjectId?: string;
}

const { activeObjectId } = Astro.props;
---

<ul class="planet-object-list">
  {PLANET_SEARCH_OBJECTS.map((object) => (
    <li class="planet-object-item" data-object-name={object.name.toLocaleLowerCase("en")}
      data-object-system-name={object.systemName.toLocaleLowerCase("en")}
      data-object-classification={object.classification}
      data-object-classification-name={objectClassificationLabel(object.classification).toLocaleLowerCase("en")}>
      <a
        class:list={["planet-object-link", { "is-active": object.id === activeObjectId }]}
        href={object.route}
        data-object-id={object.id}
        aria-current={object.id === activeObjectId ? "page" : undefined}
      >
        <PlanetNavigationMarker
          planetId={object.id}
          color={object.color}
        />
        <span class="planet-object-name">{object.name}</span>
        <span class="planet-object-distance">
          {object.classification === "star" && object.distanceAu === 0 ? "Our star" : <>
            <span class="planet-object-distance-value">{object.distanceAu}</span>{" "}
            <span class="planet-object-distance-unit">AU</span>
          </>}
        </span>
      </a>
    </li>
  ))}
</ul>
