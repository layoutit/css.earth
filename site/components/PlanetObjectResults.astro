---
import { PLANET_SEARCH_OBJECTS } from "../planet-search-objects.mts";
import PlanetObjectResult from "./PlanetObjectResult.astro";
import PreparedObjectResult from './PreparedObjectResult.astro';
import { prepareNebulaSearch } from '../prepare-nebula-search.mts';
import { OBJECT_CATEGORIES, objectCategory, objectCategoryCount, matchesObjectCategory } from "../object-categories.mts";

interface Props { activeObjectId?: string; }
const { activeObjectId } = Astro.props;
const host = PLANET_SEARCH_OBJECTS.find(object => object.classification === 'star' && object.distanceAu === 0);
if (!host) throw new Error('Prepared object search needs the shared world host.');
const nebulae = prepareNebulaSearch(Object.values(import.meta.glob('../../src/objects/*/source/nebula.json', { eager: true, import: 'default' })), host.route);
const searchObjects = [...PLANET_SEARCH_OBJECTS, ...nebulae];
const defaultCategory = 'planet';
const types = new Map(OBJECT_CATEGORIES);
for (const object of searchObjects) if (!types.has(objectCategory(object.classification))) {
  types.set(object.classification, object.classification.replaceAll('-', ' ') + 's');
}
const classifications = searchObjects.map(object => object.classification);
// Retain every source row. Small layout groups let the browser skip offscreen
// descendants without removing them from search, accessibility or navigation.
const defaultObjects = [
  ...searchObjects.filter(object => object.classification === 'planet'),
  ...searchObjects.filter(object => object.classification !== 'planet'),
];
const rows = Array.from({ length: Math.ceil(searchObjects.length / 16) },
  (_, index) => defaultObjects.slice(index * 16, (index + 1) * 16));
const groups = [...types].map(([type, label]) => ({ type, label,
  count: objectCategoryCount(classifications, type),
}));
---

<div class="planet-object-tabs" role="tablist" aria-label="Object categories">
  {groups.map((group) => <button type="button" role="tab"
    id={`object-tab-${group.type}`} data-object-tab={group.type}
    aria-controls="object-category-results" aria-selected={group.type === defaultCategory ? 'true' : 'false'}
    tabindex={group.type === defaultCategory ? 0 : -1}>
    <span>{group.label}</span>{" "}<span class="planet-object-tab-count">({group.count})</span>
  </button>)}
</div>
<div id="object-category-results" class="planet-object-results-scroll" role="tabpanel"
  aria-labelledby={`object-tab-${defaultCategory}`} tabindex="0"
  style={`--object-category-visible-rows: ${Math.min(8, Number(objectCategoryCount(classifications, 'planet')))}`}>
  <ul class="planet-object-list">
    {rows.map(group => <li class="planet-object-chunk" role="presentation"
      hidden={!group.some(object => matchesObjectCategory(object.classification, defaultCategory))}
      style={`contain-intrinsic-block-size:${Math.max(0, group.filter(object => matchesObjectCategory(object.classification, defaultCategory)).length * 28 - 8)}px`}>
      <ul class="planet-object-chunk-list" role="presentation">
        {group.map(object => 'focusId' in object
          ? <PreparedObjectResult object={object} hidden={!matchesObjectCategory(object.classification, defaultCategory)} />
          : <PlanetObjectResult object={object} activeObjectId={activeObjectId}
            hidden={!matchesObjectCategory(object.classification, defaultCategory)} />)}
      </ul>
    </li>)}
  </ul>
  <p class="planet-object-empty" aria-live="polite" hidden>No matching objects</p>
</div>
