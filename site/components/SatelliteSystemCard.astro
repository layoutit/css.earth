---
import ObjectCardHeader from './ObjectCardHeader.astro';
import ObjectBreadcrumbs from './ObjectBreadcrumbs.astro';
import MoonList from './MoonList.astro';
import { PREPARED_WORLD_PRESENTATION } from '../prepared-world-presentation.mts';
import { SCENE_OBJECTS } from '../objects.mts';
import { prepareBodyMoons } from '../prepare-body-moons.mts';
import { satelliteSystemByHost } from '../satellite-systems.mts';
import { systemSourceDocumentation } from '../source-documentation.mts';

interface Props { hostId: string; }
const { hostId } = Astro.props;
const system = satelliteSystemByHost(hostId);
const host = system ? SCENE_OBJECTS.find(object => object.id === hostId) : null;
if (system && !host) throw new TypeError(`Satellite-system host ${hostId} has no scene object.`);
const source = system ? systemSourceDocumentation({ id: hostId, name: system.name, memberIds: system.memberIds }) : null;
const moons = system ? prepareBodyMoons(hostId) : [];
---

{system && host && source && <>
  <ObjectCardHeader title={{ label: system.name }} heading={false} introduction={PREPARED_WORLD_PRESENTATION.satelliteSystemIntroductions[hostId]} data-satellite-system
    data-source-subject={`satellite-system:${hostId}`} data-source-document={source.href} data-source-label={source.label}>
    <ObjectBreadcrumbs objectId={hostId} satelliteSystem />
  </ObjectCardHeader>
  <div class="object-results-scroll object-card-tabpanel" data-satellite-system
    role="region" aria-label={`Bodies in the ${system.name}`}>
    <MoonList {moons} {host} />
  </div>
</>}
