---
import { OBJECTS } from '../objects.mjs';
import preparedWorld from '../../src/planets/sun/prepared/world-context.json';

const { objectId, scope } = Astro.props;
const object = OBJECTS.find(object => object.id === objectId);
const crumbs: { label: string; href?: string; query?: string }[] = [
  { label: 'Milky Way', query: 'Milky Way' },
];
if (scope !== 'milky-way') crumbs.push({ label: object?.systemName ?? 'Solar System', query: object?.systemName ?? 'Solar System' });
if (object && !scope) {
  // Use the same prepared orbit parents as the moon result rows.
  const parentId = preparedWorld.bodies.find(body => body.id === object.id)?.orbit?.centerBodyId;
  const parent = object.classification === 'satellite' ? OBJECTS.find(body => body.id === parentId) : null;
  if (parent) crumbs.push({ label: parent.name, href: parent.route });
}
---

<nav class="planet-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((crumb, index) => <li>
      {scope && index === crumbs.length - 1 ? <span aria-current="page">{crumb.label}</span>
        : crumb.href ? <a href={crumb.href}>{crumb.label}</a>
        : <button type="button" data-object-query={crumb.query}>{crumb.label}</button>}
    </li>)}
  </ol>
</nav>
