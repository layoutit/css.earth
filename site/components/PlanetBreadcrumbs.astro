---
import { OBJECTS } from '../objects.mjs';
import preparedWorld from '../../src/planets/sun/prepared/world-context.json';
import { solarSystemFocus } from '../overview-selection.mjs';

const { objectId, scope } = Astro.props;
const object = OBJECTS.find(object => object.id === objectId);
const systemRoute = solarSystemFocus(OBJECTS).route;
const crumbs: { label: string; href: string }[] = [
  { label: 'Milky Way', href: `${systemRoute}?overview=milky-way` },
];
if (scope !== 'milky-way') crumbs.push({ label: object?.systemName ?? 'Solar System', href: `${systemRoute}?overview=solar-system` });
if (object && !scope) {
  // Use the same prepared orbit parents as the moon result rows.
  const parentId = preparedWorld.bodies.find(body => body.id === object.id)?.orbit?.centerBodyId;
  const parent = object.classification === 'satellite' ? OBJECTS.find(body => body.id === parentId) : null;
  if (parent) crumbs.push({ label: parent.name, href: parent.route });
}
const visibleCrumbs = crumbs.slice(-2);
---

<nav class="planet-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {visibleCrumbs.map((crumb, index) => <li>
      {index > 0 && <span class="planet-breadcrumb-separator" aria-hidden="true">&raquo;</span>}
      {scope && index === visibleCrumbs.length - 1 ? <span aria-current="page">{crumb.label}</span>
        : <a href={crumb.href}>{crumb.label}</a>}
    </li>)}
  </ol>
</nav>
