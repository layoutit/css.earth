---
import type { OverviewScope } from '../overview-context.mts';
interface Props { objectId?: string; scope?: OverviewScope; includeObject?: boolean; }
import { SCENE_OBJECTS } from '../objects.mts';
import preparedWorld from '../../src/objects/sun/prepared/world-context.json';
import { solarSystemFocus } from '../overview-selection.mts';

const { objectId, scope, includeObject = false } = Astro.props;
const object = SCENE_OBJECTS.find(object => object.id === objectId);
const systemRoute = solarSystemFocus(SCENE_OBJECTS)!.route;
const crumbs: { label: string; href?: string }[] = [
  { label: 'Local Group', href: `${systemRoute}?overview=local-group` },
  { label: 'Milky Way', href: `${systemRoute}?overview=milky-way` },
];
if (scope !== 'milky-way') crumbs.push({ label: object?.systemName ?? 'Solar System', href: `${systemRoute}?overview=solar-system` });
if (object && !scope) {
  // Use the same prepared orbit parents as the moon result rows.
  const parentId = preparedWorld.bodies.find(body => body.id === object.id)?.orbit?.centerBodyId;
  const parent = object.classification === 'satellite' ? SCENE_OBJECTS.find(body => body.id === parentId) : null;
  if (parent) crumbs.push({ label: parent.name, href: parent.route });
}
// Mission cards end their trail at the body they describe, which is the current page.
if (object && includeObject) crumbs.push({ label: object.name, href: object.route });
const visibleCrumbs = crumbs.slice(-3);
const lastIsCurrent = Boolean(scope) || includeObject;
---

<nav class="planet-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {visibleCrumbs.map((crumb, index) => <li>
      {index > 0 && <span class="planet-breadcrumb-separator" aria-hidden="true">&raquo;</span>}
      {lastIsCurrent && index === visibleCrumbs.length - 1 ? <span aria-current="page">{crumb.label}</span>
        : crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
    </li>)}
  </ol>
</nav>
