---
import ContextNavigationMarker from './ContextNavigationMarker.astro';
import { OVERVIEW_TITLES } from '../overview-titles.mts';
import { overviewSourceDocumentation } from '../source-documentation.mts';
---

{Object.entries(OVERVIEW_TITLES).map(([scope, title]) => <li data-search-overview={title.label.toLocaleLowerCase('en')} hidden>
  <a class="object-link object-observation-control object-thumbnail-leading" href={`/${scope}/`}
    data-source-subject={`overview:${scope}`} data-source-document={overviewSourceDocumentation(scope, title.label).href}
    data-source-label={overviewSourceDocumentation(scope, title.label).label}>
    <span class="object-lens-icon"><ContextNavigationMarker objectId={scope} /></span>
    <span class="object-name object-lens-label">{title.label}</span>
  </a>
</li>)}
