---
import ContextNavigationMarker from './ContextNavigationMarker.astro';
import { OVERVIEWS } from '../objects.mts';
import { sourceDocumentation } from '../source-documentation.mts';
---

{OVERVIEWS.map(overview => <li data-search-overview={overview.name.toLocaleLowerCase('en')} hidden>
  <a class="object-link object-observation-control object-thumbnail-leading" href={overview.route}
    data-source-subject={`overview:${overview.id}`} data-source-document={sourceDocumentation(overview.id, overview.name).href}
    data-source-label={sourceDocumentation(overview.id, overview.name).label}>
    <span class="object-lens-icon"><ContextNavigationMarker objectId={overview.id} /></span>
    <span class="object-name object-lens-label">{overview.name}</span>
  </a>
</li>)}
