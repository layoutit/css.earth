---
import { SCENE_OBJECTS } from '../objects.mts';
import { discoveryDescription, isDiscoveryAnchor } from '../object-discovery.mts';
import type { HTMLAttributes } from 'astro/types';
import type { PlanetTitle } from '../planet-shell-types';
/** `heading` is the page heading by default; overview cards pass false so a
 * document keeps exactly one h1, the object's own title. */
interface Props extends Omit<HTMLAttributes<'section'>, 'title'> { title: PlanetTitle; introduction?: string; heading?: boolean; objectId?: string }
const { title, introduction = '', heading = true, objectId, ...attributes } = Astro.props;
const object = SCENE_OBJECTS.find(candidate => candidate.id === objectId);
const contentDescription = object && !isDiscoveryAnchor(object) ? discoveryDescription(object.discovery) : null;
const TitleTag = heading ? 'h1' : 'p';
const titleScale = title.renderHeight / Number(title.renderViewBox.split(' ')[3]);
const titleDescent = title.renderHeight - (title.baseline + title.renderPathOffsetY) * titleScale;
---
<section class="planet-selected-panel" {...attributes}>
  <slot />
  <div class="planet-title-row">
    <TitleTag class="planet-title" aria-label={title.label} style={`--planet-title-descent: ${titleDescent}px`}>
      <span class="visually-hidden">{title.label}</span>
      <svg class="planet-title-svg" viewBox={title.renderViewBox} width={title.renderWidth} height={title.renderHeight} aria-hidden="true" focusable="false">
        <path d={title.path} transform={title.renderPathOffsetY === 0 ? undefined : `translate(0 ${title.renderPathOffsetY})`} />
      </svg>
    </TitleTag>
    {contentDescription && <span class="planet-classification-tag planet-title-tag" data-discovery-note>{contentDescription}</span>}
  </div>
  <slot name="image" />
  {introduction && <p class="planet-introduction">{introduction}</p>}
</section>
