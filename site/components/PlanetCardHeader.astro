---
const { title, introduction = '', ...attributes } = Astro.props;
const titleScale = title.renderHeight / Number(title.renderViewBox.split(' ')[3]);
const titleDescent = title.renderHeight - (title.baseline + title.renderPathOffsetY) * titleScale;
---
<section class="planet-selected-panel" {...attributes}>
  <slot />
  <div class="planet-title-row">
    <h1 class="planet-title" aria-label={title.label} style={`--planet-title-descent: ${titleDescent}px`}>
      <span class="visually-hidden">{title.label}</span>
      <svg class="planet-title-svg" viewBox={title.renderViewBox} width={title.renderWidth} height={title.renderHeight} aria-hidden="true" focusable="false">
        <path d={title.path} transform={title.renderPathOffsetY === 0 ? undefined : `translate(0 ${title.renderPathOffsetY})`} />
      </svg>
    </h1>
  </div>
  {introduction && <p class="planet-introduction">{introduction}</p>}
</section>
