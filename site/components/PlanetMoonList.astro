---
import type { MoonListEntry } from '../prepare-body-moons.mts';
import PlanetObjectResult from './PlanetObjectResult.astro';
interface Props { moons: readonly MoonListEntry[]; }
const { moons } = Astro.props;
---
{moons.length > 0 ? <ul class="planet-object-list">
  {moons.map(moon => moon.object ? <PlanetObjectResult object={moon.object} /> :
    <li class="planet-object-item" data-moon-id={moon.id}>
      <span class="planet-object-link planet-observation-control planet-thumbnail-leading" role="link" aria-disabled="true" title="Not available yet">
        <span class="planet-lens-icon" aria-hidden="true"><span class="planet-moon-placeholder"></span></span>
        <span class="planet-object-name planet-lens-label">{moon.name}</span>
        <span class="planet-lens-detail">Not available</span>
      </span>
    </li>)}
</ul> : <p class="planet-object-empty">No moons in the catalogue</p>}
