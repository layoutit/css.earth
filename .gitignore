# Local work records.
/notes/burnlists/

# Deterministic browser output generated by the planet preparation commands.
/public/scenes/

# Reacquirable binary source inputs. Source manifests, hashes, provenance,
# licenses, configuration, and authored source modules remain tracked.
src/objects/*/source/**/*.csv
src/objects/*/source/**/*.fits
src/objects/*/source/**/*.fit
src/objects/*/source/**/*.gif
src/objects/*/source/**/*.glb
src/objects/*/source/**/*.IMG.gz
src/objects/*/source/**/*.cub.gz
src/objects/*/source/**/*.jpeg
src/objects/*/source/**/*.jpg
src/objects/*/source/**/*.png
src/objects/*/source/**/*.tif
src/objects/*/source/**/*.tiff
src/objects/europa/source/photometry/*.lbl
src/objects/*/source/**/*.ttf
src/objects/*/source/**/*.webp
src/objects/*/source/**/*.zip
# Binary SPICE kernels are restored through each body's acquisition plan; text kernels stay beside the body.
src/objects/*/source/**/*.bsp
src/objects/*/source/**/*.bc
src/objects/*/source/**/*.bds
# Akatsuki UVI Level 3b map exposures: a versioned DARTS volume behind a DOI, restored by the body's
# acquisition plan from a stable URL. Earth's NOAA CoralTemp grid stays committed, so this is not a
# rule about NetCDF; it is about which archive can hand the same bytes back.
src/objects/venus/source/akatsuki/*.nc

# Accepted Saturn source-of-truth inputs without a direct acquisition URL.
!src/objects/saturn/source/cassini-pia21611.jpg
!src/objects/saturn/source/approved/saturn-fixed-material.webp
!src/objects/saturn/source/saturn-weather-static.webp

# IAU/USGS Gazetteer of Planetary Nomenclature centre-point archives: the
# upstream feed regenerates weekly, so the committed snapshot identifies the
# exact pinned bytes; re-downloading later would not reproduce them.
!src/objects/*/source/features/*_nomenclature_center_pts.zip
# Mercury's global tectonic map: a Mendeley Data deposit (DOI 10.17632/p43b9wttpj.2), not the USGS gazetteer above.
!src/objects/mercury/source/features/tectonic/global-tectonic-map.zip

# Offline-authored galaxy overview crops with no acquisition plan to restore them.
