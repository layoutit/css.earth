# Pinned PDS raster and vertex-facet source products.
src/planets/*/source/**/*.IMG
src/planets/*/source/**/*.tab
src/planets/*/source/**/*.obj
src/planets/*/source/**/*.bds

# Reacquirable released STL shape models.
src/planets/*/source/**/*.stl.gz

# Pinned mission attitude kernels restored by body acquisition recipes.
src/planets/*/source/**/*.bc
src/planets/*/source/**/*.bpc

# Published SHAP5 reference mesh, restored from its pinned archive.
/src/planets/comet-67p/source/science/*.wrl

# Pinned thermophysical paper originals are restored through the body acquisition plans.
/src/planets/klytia/source/reference/hanus-2018.pdf
/src/planets/alkmene/source/reference/hanus-2018.pdf

# New reference-paper originals are reacquired from their manifest-pinned URLs.
/src/planets/*/source/reference/*.pdf
# Pinned Borrelly orthophoto and coordinate cubes, restored from PDS.
/src/planets/comet-19p/source/micas/*.cub

# Nebula density textures are rebuilt from the checked-in scalar grids.
/labs/nebula/models/*/full-density/prepared/slices/
