src/objects/*/.prepared/

# Prepared JSON transport rebuilt from checked-in object preparation output.
/src/objects/*/prepared/object.json

# Baked runtime.json/scene.json move to R2, inventoried by each object's prepared-assets.json
# (tools/runtime-assets.mts, tools/setup-prepared.mts). File globs, not a directory glob —
# a directory glob would make prepared/ negations further down (e.g. comet-67p's terrain.json) un-re-includable.
# Placed before every existing negation so a later `!/src/objects/<id>/prepared/...` still applies.
/src/objects/*/prepared/runtime.json
/src/objects/*/prepared/scene.json

/src/objects/charon/source/observations/*.tif
/src/objects/charon/source/science/*.tif

# Pinned PDS raster and vertex-facet source products.
src/objects/*/source/**/*.IMG
src/objects/*/source/**/*.IMG.gz
