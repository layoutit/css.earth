import {requireRecord} from '../../../../tools/sources/source-values.mts';
import {requireClosedTerrain} from '../../fixtures/source-fixture.mts';
import {required} from '../../../../tools/contract/test-values.mts';
import assert from 'node:assert/strict';
import { sourceTest } from '../../source-test.mts';
const test = sourceTest('kleopatra');
import {readFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import {createSourceManifest} from '../../../../src/platform/source-manifest.mts';
import {loadObjShape} from '../../../../tools/objects/terrestrial-layers/obj-shape.mts';
import {loadRadialTerrain,validateClosedMesh} from '../../../../tools/objects/terrestrial-layers/radial-terrain.mts';
const root=resolve(import.meta.dirname,'../../../../src/objects/kleopatra/source'),read=async (path: string)=>JSON.parse(await readFile(resolve(root,path),'utf8'));
test('Kleopatra published MPCD frame and volume retain the two-lobe source',async()=>{const config=await read('preparation/terrestrial.json'),p=config.geometry.radialTerrain,mesh=await loadObjShape(resolve(root,p.path),p.grid),topology=validateClosedMesh(mesh.indices.flat(),mesh.positions);assert.deepEqual(mesh.positions[0],[-7272.1491,8867.4326,25719.32]);assert.deepEqual(mesh.indices[0],[0,398,399]);assert.deepEqual([topology.vertices,topology.faces,topology.components,topology.eulerCharacteristic],[1586,3168,1,2]);assert.ok(Math.abs(topology.signedVolumeCubicMeters/1e9-865179.5491668895)<1e-6);assert.ok(Math.abs(required(mesh.sample(0,0))-139468.45347540884)<1e-7);assert.ok(Math.abs(required(mesh.sample(90,0))-29963.209672204728)<1e-7);assert.ok(Math.abs(required(mesh.sample(0,90))-23968.13072293755)<1e-7);const far=mesh.indices[1011].map(i=>mesh.positions[i]),center=[0,1,2].map(i=>far.reduce((sum,v)=>sum+v[i],0)/3),radius=Math.hypot(...center),longitude=Math.atan2(center[1],center[0])*180/Math.PI,latitude=Math.asin(center[2]/radius)*180/Math.PI;assert.ok(radius-required(mesh.sample(longitude,latitude))>27000,'The published neck includes nonradial concavity.');});
test('Kleopatra uses source connectivity at 800 native raster triangles and withholds the invalid radial lens',async()=>{const config=await read('preparation/terrestrial.json'),source=await createSourceManifest({planetId:'kleopatra',planetName:'Kleopatra',sourceRoot:root}),radial=requireClosedTerrain(await loadRadialTerrain({config,sourceDirectory:root,source}));assert.equal(radial.faces.length,800);assert.equal(required(radial.simplification).sourceFaces,3168);assert.equal(required(radial.simplification).removedOppositeFaces,0);assert.equal(required(radial.simplification).topology.eulerCharacteristic,2);assert.ok(required(radial.simplification).estimatedErrorMeters<=1500);assert.ok(radial.leaves.every(l=>l.tag==='u'&&l.attributes['data-polycss-texture-leaf-sizing']==='raster'));assert.ok(radial.plans.reduce((sum,p)=>sum+p.rect.width*p.rect.height,0)<=16384*radial.faces.length);assert.deepEqual(config.raster.scientific,[]);const content=await read('content/object.json');assert.deepEqual(content.lenses.controls.map((l:unknown)=>requireRecord(l).id),['shape','zimpol']);assert.equal(content.settings.controls.find((c: { name: string; })=>c.name==='shadows').checked,false);const rotation=await read('preparation/rotation.json');assert.equal(rotation.phase,'arbitrary-display-phase');});
