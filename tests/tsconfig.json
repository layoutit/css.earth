{
  "extends": "../tsconfig.base.json",
  "include": [
    "./**/*.ts",
    "./**/*.mts",
    "../site/test/**/*.ts",
    "../site/test/**/*.mts",
    "../src/**/*.test.ts",
    "../src/**/*.test.mts",
    "../src/**/*.spec.ts",
    "../src/**/*.spec.mts",
    "../src/**/test/**/*.ts",
    "../src/**/test/**/*.mts",
    "../src/**/*-test-fixture.mts",
    "../src/**/*-browser.mts",
    "../.github/scripts/**/*.test.mts",
    "../labs/performance/**/*.test.mts",
    "../.github/scripts/audits/**/*.mts",
    "../packages/**/*.test.ts",
    "../packages/**/*.test.mts",
    "../packages/**/*.spec.ts",
    "../packages/**/*.spec.mts",
    "../site/env.d.ts",
    "../site/cesium-module-types.d.ts",
    "./external-modules.d.mts"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ],
  "compilerOptions": {
    "paths": {
      "vitest": [
        "../packages/engine/node_modules/vitest"
      ],
      "/site/*": [
        "../site/*"
      ],
      "/src/*": [
        "../src/*"
      ]
    },
    "incremental": true,
    "tsBuildInfoFile": "../output/tsbuildinfo/tests.tsbuildinfo"
  }
}
