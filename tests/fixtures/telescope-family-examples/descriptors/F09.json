      "calibration": {
        "state": "archive-calibrated",
        "basis": [
          "Gaia DR3 astrometry/photometry + Bailer-Jones et al.2021 EDR3 geometric distances",
          "SELECT TOP 8000 source_id,ra,dec,pmra,pmdec,parallax,parallax_error,phot_g_mean_mag,phot_bp_mean_mag,phot_rp_mean_mag,ruwe,r_med_geo,r_lo_geo,r_hi_geo FROM gedr3dist.litewithdist WHERE 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',83.6334511837,22.0151236394,1.4325437375665075)) AND r_med_geo BETWEEN 1950 AND 2050 AND phot_g_mean_mag<16 AND ruwe<1.4 AND parallax>5*parallax_error ORDER BY phot_g_mean_mag,source_id"
        ]
      },
