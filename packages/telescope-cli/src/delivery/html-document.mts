/** Static export-time composition; no chart or scene is derived in the browser. */
export const escapeHtml = (value: string): string => value.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
export const OFFLINE_POLICY = "default-src 'none'; script-src 'none'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'";
export function viewerDocument(title: string, content: string, receipt: unknown, metadata: Readonly<Record<string, string>>, css = ''): string {
  return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta http-equiv="Content-Security-Policy" content="${OFFLINE_POLICY}"><title>${escapeHtml(title)}</title><style>
:root{color-scheme:dark;font:15px system-ui;background:#111;color:#ddd}body{margin:0 auto;padding:24px;max-width:1100px}h1{font-size:22px;font-weight:500}dl{display:grid;grid-template-columns:auto 1fr;gap:6px 18px}dt{color:#aaa}dd{margin:0}img,svg{display:block;max-width:100%;height:auto}details{margin-top:24px}summary{cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px}.viewer{position:relative;container-type:inline-size;aspect-ratio:10/7;overflow:hidden}.scene-board{position:absolute;width:1000px;height:700px;transform-origin:0 0;transform:scale(calc(100cqw / 1000px))}
${css}</style></head><body><header><h1>${escapeHtml(title)}</h1><dl>${Object.entries(metadata).map(([name,value])=>`<dt>${escapeHtml(name)}</dt><dd>${escapeHtml(value)}</dd>`).join('')}</dl></header><main>${content}</main><details><summary>Measurement, credits and provenance</summary><pre>${escapeHtml(JSON.stringify(receipt,null,2))}</pre></details></body></html>`;
}
