      "unit": "MJy/sr",
      "window": { "x": 1, "y": 1, "width": 85, "height": 93 },
      "orientation": { "mode": "sky", "note": "North up and east left, from the cube's own WCS." },
      "stretch": { "kind": "asinh", "black": 0, "white": 19200, "softening": 100 },
      "colour": { "kind": "greys", "missing": "#4a4a4a" },
      "enlarge": 9,
      "product": {
        "command": "node tools/objects/jwst/cubes/spec3.mts sn-1987a-1232 NIRSPEC-G140M-F100LP .local/sn-1987a-1232/spec3-0.05",
        "definition": "tools/objects/jwst/imaging/programs/sn-1987a-1232.NIRSPEC-G140M-F100LP.reproduction.json"
      },
      "note": "One plane of the cube, at 1.0842 microns: the helium line that is the brightest thing in this cube. Grey is outside the cube's footprint."
    },
    {
      "id": "jwst-miri-ngc6720",
      "telescope": "JWST",
      "instrument": "MIRI imager, F770W",
      "title": "The Ring Nebula at 7.7 microns",
