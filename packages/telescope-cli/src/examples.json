    {
      "id": "hubble-stis-europa-salt",
      "telescope": "Hubble",
      "instrument": "STIS CCD, G430L, 52x0.1 arcsec slit",
      "title": "The 450 nm sodium chloride band on Europa",
      "target": "Europa",
      "date": "2017-05-23, 2017-06-29, 2017-08-01 and 2017-08-06",
      "source": { "kind": "fits-image", "path": "output/europa-salt-map/nacl-450nm.fits", "extension": 1, "plane": 1 },
      "unit": "Angstrom",
      "window": { "x": 1, "y": 1, "width": 360, "height": 180 },
      "orientation": { "mode": "first-row-top", "note": "A longitude-latitude map of the whole body. The first stored row is the north pole, the first column starts at 0 degrees east longitude and east runs to the right." },
      "stretch": { "kind": "linear", "black": -150, "white": 200 },
      "colour": { "kind": "ramp", "stops": [[0, "#08203a"], [0.4, "#1f5f74"], [0.75, "#c8b26a"], [1, "#fff4d2"]], "missing": "#4a4a4a" },
      "enlarge": 2,
      "product": {
        "command": "node tools/objects/hst/slit-scan-map.mts europa-salt-map .local/hst/europa-14650 output/europa-salt-map --mirror --receipt",
        "definition": "tools/objects/hst/programs/europa-salt-map.scan.json"
      },
      "note": "The four scans leave gaps; grey is where no scan reached or the surface was seen more than 60 degrees from face on."
    },
    {
      "id": "alma-europa-brightness-temperature",
      "telescope": "ALMA",
      "instrument": "Band 6 continuum, 232 GHz",
      "title": "Europa's thermal disc",
      "target": "Europa",
      "date": "2015-11-26",
      "producedIn": "css.earth-jwst",
      "source": { "kind": "fits-image", "path": "output/alma-europa/selfcal/Europa.final.brightness-temperature.fits", "extension": 0, "plane": 1 },
      "unit": "K",
      "window": { "x": 956, "y": 944, "width": 160, "height": 160 },
      "orientation": { "mode": "sky", "note": "North up and east left, from the image's own WCS." },
      "stretch": { "kind": "linear", "black": 55, "white": 102 },
      "colour": { "kind": "ramp", "stops": [[0, "#000000"], [0.35, "#7a1500"], [0.7, "#e06b1e"], [1, "#fff6c8"]] },
      "enlarge": 5,
      "product": {
        "command": "node tools/objects/interferometry/alma-disc-selfcal.mts <calibrated continuum .ms> --body Europa --radius-km 1560.8 --out output/alma-europa/selfcal --scratch output/alma-europa/scratch",
        "definition": "output/alma-europa/selfcal/Europa.selfcal.receipt.json (this stage has no pinned program file; the run states its parameters on the command line and records them in the receipt)"
      },
      "note": "The disc is 768 milliarcseconds across and the restoring beam 48 by 21 milliarcseconds, so the soft edge is the beam, not the limb. The fine east-west streaks across the disc are about 2 K, the image noise at the beam scale, not surface features."
    },
    {
      "id": "vlti-matisse-betelgeuse",
      "telescope": "VLTI",
      "instrument": "MATISSE, L band continuum",
      "title": "The surface of Betelgeuse",
      "target": "Betelgeuse",
      "date": "February 2020, during the Great Dimming",
      "source": { "kind": "fits-image", "path": "src/objects/betelgeuse/source/observations/betelgeuse-matisse-2020-02-continuum-4mas.fits", "extension": 0, "plane": 1 },
      "unit": "normalised intensity",
      "window": { "x": 1, "y": 1, "width": 128, "height": 128 },
      "orientation": { "mode": "sky", "note": "North up and east left, 0.78 milliarcseconds a pixel, from the reconstruction's own axes." },
      "stretch": { "kind": "linear", "black": 0, "white": 0.000493 },
      "colour": { "kind": "greys" },
      "enlarge": 6,
      "product": {
        "command": "node tools/objects/interferometry/image-star.mts tools/objects/interferometry/seasons/betelgeuse-matisse-2020-02 output/stars/betelgeuse-matisse-2020-02 --raw output/calibration/raw-matisse",
        "definition": "tools/objects/interferometry/seasons/betelgeuse-matisse-2020-02/season.json"
      },
      "note": "This is a reconstruction, not a photograph: the interferometer measures a handful of spatial frequencies and the image is the one that fits them. The toolkit convolved it with a 4 milliarcsecond beam, as interferometric images are shown; nothing further is smoothed here."
    },
    {
      "id": "vlt-naco-ceres",
      "telescope": "VLT",
      "instrument": "NACO, adaptive optics imaging",
      "title": "Ceres from the ground",
      "target": "Ceres",
      "date": "2007-11-11",
      "producedIn": "css.earth-naco",
      "source": { "kind": "fits-image", "path": ".local/naco/ceres-080C0881/jitter-2007-11-11T023847/naco_img_jitter.fits", "extension": 0, "plane": 1 },
      "unit": "ADU",
      "window": { "x": 700, "y": 734, "width": 140, "height": 140 },
      "orientation": { "mode": "first-row-bottom", "note": "The detector rows of the combined image, the first at the bottom. The reduced frame carries no world coordinates, so no sky direction is claimed." },
      "stretch": { "kind": "linear", "black": 0, "white": 6300 },
      "colour": { "kind": "greys" },
      "enlarge": 5,
      "product": {
        "command": "node tools/objects/naco/reduce.mts ceres-080C0881 .local/naco/ceres-080C0881 --template 2007-11-11T02:38:47",
        "definition": "tools/objects/naco/programs/ceres-080C0881.COADDED_IMG.reproduction.json"
      },
      "note": "Ceres is resolved but small: about 52 pixels across at half its peak brightness, in the Ks filter through the S13 camera. The glow around it is the adaptive optics halo, which is blur in the data, not a rendering artefact, and the disc shows no surface detail at this scale."
    },
    {
      "id": "chandra-acis-cassiopeia-a",
      "telescope": "Chandra",
      "instrument": "ACIS-I, event list",
      "title": "Cassiopeia A in X-rays",
      "target": "Cassiopeia A",
      "date": "1999-08-27, 3.6 ks",
      "producedIn": "css.earth-chandra",
