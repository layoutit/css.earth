{
  "schema": "cssearth-telescope-examples@1",
  "examples": [
    {
      "id": "jwst-nircam-ngc3132",
      "telescope": "JWST",
      "instrument": "NIRCam, F405N, F187N and F090W",
      "title": "The Southern Ring Nebula",
      "target": "NGC 3132",
      "date": "2022-06-03",
      "producedIn": "css.earth-ngc3132",
      "channels": [
        {
          "label": "F405N, 4.05 microns, red",
          "source": { "kind": "fits-image", "path": "output/jwst-imaging/f405n-grid/image3/jw02733-o001_t001_nircam_f405n-f444w_grid_i2d.fits", "extension": 1, "plane": 1 },
          "unit": "MJy/sr",
          "stretch": { "kind": "asinh", "black": 0, "white": 45, "softening": 2 }
        },
        {
          "label": "F187N, 1.87 microns, green",
          "source": { "kind": "fits-image", "path": "output/jwst-imaging/f187n-grid/image3/jw02733-o001_t001_nircam_clear-f187n_grid_i2d.fits", "extension": 1, "plane": 1 },
          "unit": "MJy/sr",
          "stretch": { "kind": "asinh", "black": 0, "white": 180, "softening": 4 }
        },
        {
          "label": "F090W, 0.90 microns, blue",
          "source": { "kind": "fits-image", "path": "output/jwst-imaging/f090w-grid/image3/jw02733-o001_t001_nircam_clear-f090w_grid_i2d.fits", "extension": 1, "plane": 1 },
          "unit": "MJy/sr",
          "stretch": { "kind": "asinh", "black": 0.2, "white": 25, "softening": 1 }
        }
      ],
      "window": { "x": 267, "y": 267, "width": 490, "height": 490 },
      "orientation": { "mode": "sky", "note": "North up and east left, from the mosaics' own WCS." },
      "colour": { "kind": "channels", "missing": "#4a4a4a" },
      "enlarge": 1,
      "product": {
        "command": "node tools/objects/jwst/imaging/image3.mts ngc-3132-2733 NIRCAM-<band> output/jwst-imaging/<band>-grid --grid src/objects/ngc-3132/source/sky-bands/jwst-nircam.json",
        "definition": "tools/objects/jwst/imaging/programs/ngc-3132-2733.json"
      },
      "note": "Representative colour, not what an eye would see: three infrared filters put into red, green and blue. All three mosaics were re-run onto one grid, so no channel is resampled. F187N and F405N are narrow filters on hydrogen lines, which is why the shells stand out. The product command records the historical run; its NGC 3132 shared-grid recipe is absent from this checkout, so it cannot currently be rerun here."
    },
    {
      "id": "jwst-nirspec-sn1987a",
      "telescope": "JWST",
      "instrument": "NIRSpec IFU, G140M/F100LP",
      "title": "The ring around SN 1987A",
      "target": "SN 1987A",
      "date": "2022-07-16",
      "producedIn": "css.earth-jwst",
