          "unit": "counts per bin",
          "stretch": { "kind": "asinh", "black": 0, "white": 25, "softening": 1 }
        },
        {
          "label": "1.5 to 3.0 keV, green",
          "source": { "kind": "fits-events", "path": ".local/chandra/casa-acisi/repro/acisf00210_repro_evt2.fits", "columns": ["x", "y"], "binPixels": 2, "origin": [3468, 3369], "size": [350, 350], "band": { "column": "energy", "limits": [1500, 3000] } },
          "unit": "counts per bin",
          "stretch": { "kind": "asinh", "black": 0, "white": 30, "softening": 1 }
        },
        {
          "label": "3.0 to 7.0 keV, blue",
          "source": { "kind": "fits-events", "path": ".local/chandra/casa-acisi/repro/acisf00210_repro_evt2.fits", "columns": ["x", "y"], "binPixels": 2, "origin": [3468, 3369], "size": [350, 350], "band": { "column": "energy", "limits": [3000, 7000] } },
          "unit": "counts per bin",
          "stretch": { "kind": "asinh", "black": 0, "white": 6, "softening": 1 }
        }
      ],
      "window": { "x": 1, "y": 1, "width": 350, "height": 350 },
      "orientation": { "mode": "first-row-bottom", "note": "Sky coordinates binned 2 by 2 pixels, 0.98 arcseconds a bin, the lowest row at the bottom. Sky x runs with falling right ascension and sky y with rising declination, so north is up and east is left." },
      "colour": { "kind": "channels", "missing": "#4a4a4a" },
      "enlarge": 2,
      "product": {
        "command": "node tools/objects/chandra/reprocess.mts casa-acisi 210 .local/chandra/casa-acisi",
        "definition": "tools/objects/chandra/programs/casa-acisi.json"
      },
      "note": "Representative colour, not what an eye would see: the same event list split into a soft, a medium and a hard energy band, on one set of bins. One dot is one detected X-ray photon, so this is counts, not brightness, and the graininess is the photon statistics of a short exposure."
    },
