      "unit": "MJy/sr",
      "window": { "x": 700, "y": 210, "width": 640, "height": 600 },
      "orientation": { "mode": "first-row-bottom", "note": "The stored rows of the resampled mosaic, the first at the bottom." },
      "stretch": { "kind": "asinh", "black": 4.3, "white": 28, "softening": 1.5 },
      "colour": { "kind": "greys", "missing": "#4a4a4a" },
      "enlarge": 1,
      "product": {
        "command": "node tools/objects/jwst/imaging/image3.mts ngc-6720-1558 MIRI-F770W output/jwst-ngc6720",
