    {
      "id": "keck-kcwi-m42",
      "telescope": "Keck II",
      "instrument": "KCWI blue, small slicer",
      "title": "A patch of the Orion Nebula",
      "target": "M42",
      "date": "2023-12-09, 5 second exposure",
      "producedIn": "css.earth-keck",
      "source": { "kind": "fits-image", "path": "output/keck/m42-kcwi-2023b-u124/KB.20231209.37031.94/redux/kb231209_00085_icube.fits", "extension": 0, "plane": 1726, "planes": 11 },
      "unit": "electron",
      "window": { "x": 1, "y": 1, "width": 24, "height": 69 },
      "orientation": { "mode": "first-row-bottom", "note": "The cube's spatial axes, the first stored row at the bottom. A column is one 0.68 arcsecond slice and a row 0.29 arcseconds along the slit, so each sample is drawn as a rectangle 14 pixels across and 6 down, which keeps the sky nearly square." },
      "stretch": { "kind": "linear", "black": -4000, "white": 10000 },
      "colour": { "kind": "greys" },
      "enlarge": [14, 6],
      "product": {
        "command": "node tools/objects/keck/reduce.mts m42-kcwi-2023b-u124 KB.20231209.37031.94.fits",
        "definition": "tools/objects/keck/programs/m42-kcwi-2023b-u124.json"
      },
      "note": "The eleven wavelength planes from 5004 to 5014 Angstroms added together, which is the bright doubly ionised oxygen line at 5007 Angstroms. Adding planes moves no sample and smooths nothing. This is a 5 second exposure on a 24 by 69 spaxel field, so it is coarse and noisy."
    },
    {
