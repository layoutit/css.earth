      "date": "2022-09-29",
      "producedIn": "css.earth-stars",
      "source": {
        "kind": "junocam-image",
        "path": "src/objects/europa/source/observations/junocam/JNCR_2022272_45C00001_V01.IMG",
        "labelPath": "src/objects/europa/source/observations/junocam/JNCR_2022272_45C00001_V01.LBL"
      },
      "unit": "reflectance",
      "window": { "x": 300, "y": 1921, "width": 640, "height": 384 },
