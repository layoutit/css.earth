{
  "name": "@cssearth/telescope",
  "version": "0.2.1",
  "description": "The telescope command: explore, retrieve and qualify telescope products, and turn them into outputs.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./sphere/lane": {
      "types": "./dist/sphere-lane.d.ts",
      "import": "./dist/sphere-lane.js",
      "require": "./dist/sphere-lane.cjs"
    },
    "./viewer/lane": {
      "types": "./dist/viewer-lane.d.ts",
      "import": "./dist/viewer-lane.js",
      "require": "./dist/viewer-lane.cjs"
    }
  },
  "bin": {
    "telescope": "run-typed-module.mjs"
  },
  "files": [
    "dist",
    "data",
    "run-typed-module.mjs",
    "README.md",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    ".factory-plugin"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/layoutit/css.earth.git",
    "directory": "packages/telescope-cli"
  },
  "scripts": {
    "build": "node build.mts",
    "prepack": "npm run build && node prepack.mts",
    "verify:pack": "node verify-pack.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.authoring.json"
  },
  "dependencies": {
    "@layoutit/polycss": "0.2.11",
    "geotiff": "3.0.5",
    "linkedom": "^0.18.13",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@cssearth/astronomy": "workspace:*",
    "@cssearth/bake": "workspace:*",
    "@cssearth/core": "workspace:*",
    "@cssearth/engine": "workspace:*",
    "@cssearth/fits": "workspace:*",
    "@cssearth/objects": "workspace:*",
    "@cssearth/renderer": "workspace:*",
    "@cssearth/spice": "workspace:*",
    "@cssearth/telescope-core": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.27.7",
    "pngjs": "7.0.0",
    "tsup": "^8.0.1",
    "typescript": "5.9.3"
  },
  "oracleManifest": "oracle-manifest.json",
  "pi": {
    "skills": [
      "./skills/telescope"
    ]
  },
  "imports": {
    "#telescope/archives/hst/archive": "./src/archives/hst/archive.mts",
    "#telescope/archives/hst/line-stack-reduction": "./src/archives/hst/line-stack-reduction.mts",
    "#telescope/archives/hst/slit-scan-frames": "./src/archives/hst/slit-scan-frames.mts",
    "#telescope/archives/hst/slit-scan-reduction": "./src/archives/hst/slit-scan-reduction.mts",
    "#telescope/archives/interferometry/alma-disc-selfcal": "./src/archives/interferometry/alma-disc-selfcal.mts",
    "#telescope/archives/interferometry/disc-fit": "./src/archives/interferometry/disc-fit.mts",
    "#telescope/archives/jwst/imaging/bands": "./src/archives/jwst/imaging/bands.mts",
    "#telescope/archives/jwst/imaging/image3": "./src/archives/jwst/imaging/image3.mts",
    "#telescope/archives/juno/archive": "./src/archives/juno/archive.mts",
    "#telescope/archives/juno/archive-ledger": "./src/archives/juno/archive-ledger.mts",
    "#telescope/archives/juno/measure": "./src/archives/juno/measure.mts",
    "#telescope/archives/ledger": "./src/archives/ledger.mts",
    "#telescope/archives/naco/archive": "./src/archives/naco/archive.mts",
    "#telescope/archives/sky-position": "./src/archives/sky-position.mts",
    "#telescope/archives/targets": "./src/archives/targets.mts",
    "#telescope/archives/toolchain-descriptor": "./src/archives/toolchain-descriptor.mts",
    "#telescope/body-map-publication": "./src/delivery/body-map-publication.mts",
    "#telescope/query": "./src/observation-query/query.mts",
    "#telescope/query-contract": "./src/observation-query/query-contract.mts",
    "#telescope/request-satisfaction": "./src/requests/request-satisfaction.mts",
    "#telescope/selected-product": "./src/observation-query/selected-product.mts",
    "#telescope/sky/author-sky-bands": "./src/sky/author-sky-bands.mts",
    "#telescope/sky/sky-band-composite": "./src/sky/sky-band-composite.mts",
    "#telescope/sphere/native-scroll/carry-values": "./src/sphere/native-scroll/carry-values.mts",
    "#telescope/sphere/native-scroll/native-camera": "./src/sphere/native-scroll/native-camera.mts",
    "#telescope/sphere/native-scroll/resize-input": "./src/sphere/native-scroll/resize-input.mts"
  },
  "peerDependencies": {
    "@types/node": "^26.4.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    }
  }
}
