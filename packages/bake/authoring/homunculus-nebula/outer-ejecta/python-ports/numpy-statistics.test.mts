test('float32 and float64 sums, means, variances and standard deviations match NumPy bit for bit', () => {
  for (const [key, expected] of Object.entries(MOMENTS)) {
    const a = data(Number(key)).map(v => v - 300), a32 = Float32Array.from(a);
    assert.deepEqual([pairwiseSum(a32), mean(a32), variance(a32), std(a32), pairwiseSum(a), mean(a), variance(a), std(a)], expected, `n = ${key}`);
    assert.deepEqual([pairwiseSum(a, { float32: true }), std(a, { float32: true })], [expected[0], expected[3]]);
  }
});
