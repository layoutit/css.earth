const POWERS = [0.01, 0.1, 1, 10, 100];
const data = (n: number) => Float64Array.from({ length: n }, (_, i) => (i * 7919) % 1000 / 7 * POWERS[i % 5]!);

test('sum, mean, std, median and percentile match NumPy bit for bit, in double and single precision', () => {
  for (const [key, expected] of Object.entries(EXPECTED)) {
    const a = data(Number(key)), a32 = Float32Array.from(a);
    const got = [sum(a), mean(a), std(a), sum(a32), mean(a32), median(a), median(a32), ...QS.map(q => percentile(a, q)), ...QS.map(q => percentile(a32, q))];
    assert.deepEqual(got, expected, `n = ${key}`);
    assert.equal(percentile(a, 99.5, { float32: true }), expected[7 + 8 + 5], 'the float32 option on double data');
    assert.equal(median(a, { float32: true }), expected[6]);
    assert.equal(sum(a, { float32: true }), expected[3]);
  }
});

test('NaN: median and percentile give NaN, their nan forms leave it out', () => {
  const b = data(1000); for (let i = 0; i < b.length; i += 7) b[i] = NaN;
  const b32 = Float32Array.from(b);
  assert.ok(Number.isNaN(median(b)) && Number.isNaN(percentile(b, 50)));
  assert.equal(nanmedian(b), 66.85714285714286);
  assert.equal(nanmedian(b32), 66.85713958740234);
  assert.deepEqual([nanpercentile(b, 30), nanpercentile(b, 99.8)], [6.245714285714288, 14034.857142857143]);
  assert.deepEqual([nanpercentile(b32, 30), nanpercentile(b32, 99.8)], [6.24571418762207, 14034.857421875]);
  assert.equal(nanpercentile(b, 99.8, { float32: true }), 14034.857421875);
  assert.ok(Number.isNaN(nanmedian([NaN, NaN])));
});

test('digitize and stable argsort follow NumPy', () => {
  const bins = Array.from({ length: 11 }, (_, k) => k / 10);
  assert.deepEqual([-0.1, 0, 0.05, 0.1, 0.95, 1, 1.2, NaN].map(x => digitize(x, bins)), [0, 1, 1, 2, 10, 11, 11, 11]);
  assert.deepEqual(argsortStable([3, 1, NaN, 1, 2, 3, 0]), [6, 1, 3, 4, 0, 5, 2]);
  assert.throws(() => digitize(0, [1, 0]), RangeError);
  assert.throws(() => percentile([1, 2], 101), RangeError);
});

