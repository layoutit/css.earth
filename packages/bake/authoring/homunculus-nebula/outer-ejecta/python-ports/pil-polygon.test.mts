const covered = (runs: string) => { const out: number[] = []; for (const run of runs.split(',').filter(Boolean)) { const [a, b = a] = run.split('-').map(Number); for (let p = a!; p <= b!; p++) out.push(p); } return out; };

test('fillPolygon covers exactly the pixels Pillow 12.3.0 fills', () => {
  for (const [index, [points, runs]] of CASES.entries()) {
    const mask = fillPolygon(new Uint8Array(WIDTH * HEIGHT), WIDTH, HEIGHT, points.map(([x, y]) => [x!, y!] as const));
    const got: number[] = []; mask.forEach((value, p) => { if (value) got.push(p); });
    assert.deepEqual(got, covered(runs), `case ${index}: ${JSON.stringify(points)}`);
  }
});

test('fillPolygon adds to the mask and refuses bad input', () => {
  const mask = new Uint8Array(WIDTH * HEIGHT); mask[0] = 1;
  fillPolygon(mask, WIDTH, HEIGHT, [[10, 10], [12, 10], [11, 12]]);
  assert.equal(mask[0], 1);
  assert.throws(() => fillPolygon(mask, WIDTH, HEIGHT, [[1, 1]]), TypeError);
  assert.throws(() => fillPolygon(mask, WIDTH, HEIGHT, [[1, 1], [Number.NaN, 2], [3, 3]]), TypeError);
  assert.throws(() => fillPolygon(new Uint8Array(5), WIDTH, HEIGHT, [[1, 1], [2, 2], [3, 1]]), RangeError);
});
