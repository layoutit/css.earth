test('eigenvalues and eigenvectors, signs included, are NumPy\'s', () => {
  for (const [k, { a, w, v }] of FIXTURES.entries()) {
    const { values, vectors } = symmetricEigen(a), size = Math.max(...w.map(Math.abs));
    for (let i = 0; i < 3; i++) {
      assert.ok(Math.abs(values[i]! - w[i]!) <= 1e-13 * size, `fixture ${k}: eigenvalue ${i} ${values[i]} against ${w[i]}`);
      for (let j = 0; j < 3; j++) assert.ok(Math.abs(vectors[i]![j]! - v[i]![j]!) < 1e-9, `fixture ${k}: vector entry ${i},${j} ${vectors[i]![j]} against ${v[i]![j]}`);
    }
  }
});

test('the lobe covariances give NumPy\'s axes to rounding', () => {
  for (const { a, v } of FIXTURES.slice(-2)) { const { vectors } = symmetricEigen(a); for (let i = 0; i < 3; i++) for (let j = 0; j < 3; j++) assert.ok(Math.abs(vectors[i]![j]! - v[i]![j]!) < 1e-14); }
});

test('the vectors are orthonormal and diagonalise the matrix; the input is left as it was', () => {
  const a = [[4, 1, -2], [1, 2, 0.5], [-2, 0.5, 3]], copy = a.map(row => [...row]), { values, vectors } = symmetricEigen(a);
  assert.deepEqual(a, copy);
  for (let p = 0; p < 3; p++) for (let q = 0; q < 3; q++) {
    let dot = 0, av = 0; for (let i = 0; i < 3; i++) { dot += vectors[i]![p]! * vectors[i]![q]!; for (let j = 0; j < 3; j++) av += vectors[i]![p]! * a[i]![j]! * vectors[j]![q]!; }
    assert.ok(Math.abs(dot - (p === q ? 1 : 0)) < 1e-14); assert.ok(Math.abs(av - (p === q ? values[p]! : 0)) < 1e-13);
  }
  assert.ok(values[0]! <= values[1]! && values[1]! <= values[2]!);
});

test('a 1x1 or 2x2 matrix, and refusals', () => {
  assert.deepEqual(symmetricEigen([[5]]), { values: [5], vectors: [[1]] });
  const { values } = symmetricEigen([[2, 1], [1, 2]]); assert.ok(Math.abs(values[0]! - 1) < 1e-15 && Math.abs(values[1]! - 3) < 1e-15);
  assert.throws(() => symmetricEigen([[1, 2]]), TypeError); assert.throws(() => symmetricEigen([[NaN]]), TypeError); assert.throws(() => symmetricEigen([]), TypeError);
});
