/**
 * NumPy's `np.random.default_rng(seed)` for an integer seed, draw for draw (NumPy 2.5.4): the outer-ejecta cloud
 * scatters its dots with it, so a seed gives NumPy's numbers in NumPy's order.
 *
 * - The seed is mixed into four 32-bit words by NumPy's SeedSequence (its hash and mix functions), and four 64-bit
 *   words drawn from them seed PCG64: the 128-bit state and increment, as `pcg64_set_seed` takes them.
 * - PCG64 steps its 128-bit linear congruential state, then outputs the XSL-RR permutation of the new state. A 32-bit
 *   draw takes the low half of a 64-bit output and keeps the high half for the next 32-bit draw.
 * - `random` is the top 53 bits of a 64-bit draw; `uniform` and `normal` scale it as NumPy's C functions do; the normal
 *   is NumPy's 256-layer ziggurat, with its tables (`ziggurat_constants.h`); `integers` uses Lemire's bounded method
 *   (on a 32-bit draw when the range fits in 32 bits); `choice` takes `integers` without probabilities and the
 *   cumulative sum searched by `random` with them.
 *
 * Integers are carried as BigInt in the generator and returned as numbers when they are safe integers.
 *
 * NumPy's C functions `lower + range * u` (uniform), `loc + scale * z` (normal) and the ziggurat's wedge test are
 * compiled with fused multiply-adds on Apple silicon (arm64), the platform the outer-ejecta results were made on: one
 * rounding, not two. `fusedMultiplyAdd` (on by default) does the same, exactly; off, it rounds twice, as an x86-64
 * build without FMA does.
 */

const MASK32 = 0xffffffffn, MASK64 = (1n << 64n) - 1n, MASK128 = (1n << 128n) - 1n;
/** PCG64's multiplier: PCG_DEFAULT_MULTIPLIER_HIGH and _LOW. */
const MULTIPLIER = (2549297995355413924n << 64n) | 4865540595714422341n;
/** SeedSequence's hash constants (numpy/random/bit_generator.pyx). */
const INIT_A = 0x43b0d7e5, MULT_A = 0x931e8875, INIT_B = 0x8b51f9dd, MULT_B = 0x58f38ded, MIX_MULT_L = 0xca01f9dd, MIX_MULT_R = 0x4973f715, POOL_SIZE = 4;
const TWO_TO_MINUS_53 = 1 / 9007199254740992;

/** The four pool words of `SeedSequence(seed)`: the seed as 32-bit words (lowest first), hashed and mixed. */
export function seedSequencePool(seed: number | bigint): Uint32Array {
  let n = BigInt(seed);
  if (n < 0n) throw new RangeError(`A seed must be a non-negative integer; got ${seed}.`);
  const entropy: number[] = [];
  if (n === 0n) entropy.push(0);
  while (n > 0n) { entropy.push(Number(n & MASK32)); n >>= 32n; }
  const pool = new Uint32Array(POOL_SIZE);
  let hashConst = INIT_A;
  const hashmix = (value: number) => { value = (value ^ hashConst) >>> 0; hashConst = Math.imul(hashConst, MULT_A) >>> 0; value = Math.imul(value, hashConst) >>> 0; return (value ^ (value >>> 16)) >>> 0; };
  const mix = (x: number, y: number) => { const r = (Math.imul(MIX_MULT_L, x) - Math.imul(MIX_MULT_R, y)) >>> 0; return (r ^ (r >>> 16)) >>> 0; };
  for (let i = 0; i < POOL_SIZE; i++) pool[i] = hashmix(i < entropy.length ? entropy[i]! : 0);
  for (let src = 0; src < POOL_SIZE; src++) for (let dst = 0; dst < POOL_SIZE; dst++) if (src !== dst) pool[dst] = mix(pool[dst]!, hashmix(pool[src]!));
  for (let src = POOL_SIZE; src < entropy.length; src++) for (let dst = 0; dst < POOL_SIZE; dst++) pool[dst] = mix(pool[dst]!, hashmix(entropy[src]!));
  return pool;
}

/** `SeedSequence(seed).generate_state(words, np.uint64)`: twice as many 32-bit words, paired low word first. */
export function seedSequenceState64(seed: number | bigint, words: number): bigint[] {
  const pool = seedSequencePool(seed), out32: number[] = [];
  let hashConst = INIT_B;
  for (let i = 0; i < 2 * words; i++) {
    let value = (pool[i % POOL_SIZE]! ^ hashConst) >>> 0; hashConst = Math.imul(hashConst, MULT_B) >>> 0;
    value = Math.imul(value, hashConst) >>> 0; out32.push((value ^ (value >>> 16)) >>> 0);
  }
  return Array.from({ length: words }, (_, k) => (BigInt(out32[2 * k + 1]!) << 32n) | BigInt(out32[2 * k]!));
}

/** PCG64's state, as NumPy's `bit_generator.state` reports it. */
export interface Pcg64State { state: bigint; inc: bigint; hasUint32: boolean; uinteger: number }

/** A NumPy `Generator` on PCG64. */
export class NumpyGenerator {
  #state: bigint;
  #inc: bigint;
  #hasUint32 = false;
  #uinteger = 0;
  readonly #muladd: (a: number, b: number, c: number) => number;

  constructor(seed: number | bigint, options: { fusedMultiplyAdd?: boolean } = {}) {
    this.#muladd = options.fusedMultiplyAdd ?? true ? fma : (a, b, c) => a * b + c;
    const [s0, s1, i0, i1] = seedSequenceState64(seed, 4) as [bigint, bigint, bigint, bigint];
    const initState = (s0 << 64n) | s1, initSeq = (i0 << 64n) | i1;
    this.#state = 0n; this.#inc = ((initSeq << 1n) | 1n) & MASK128;
    this.#step(); this.#state = (this.#state + initState) & MASK128; this.#step();
  }

  get state(): Pcg64State { return { state: this.#state, inc: this.#inc, hasUint32: this.#hasUint32, uinteger: this.#uinteger }; }

  #step(): void { this.#state = (this.#state * MULTIPLIER + this.#inc) & MASK128; }

  /** One 64-bit output: step, then XSL-RR of the new state. */
  nextUint64(): bigint {
    this.#step();
    const x = ((this.#state >> 64n) ^ this.#state) & MASK64, rot = this.#state >> 122n;
    return ((x >> rot) | (x << ((64n - rot) & 63n))) & MASK64;
  }

  /** One 32-bit output: the low half of a 64-bit output, its high half kept for the next call. */
  nextUint32(): number {
    if (this.#hasUint32) { this.#hasUint32 = false; return this.#uinteger; }
    const next = this.nextUint64();
    this.#hasUint32 = true; this.#uinteger = Number(next >> 32n);
    return Number(next & MASK32);
  }

  /** A double in [0, 1): the top 53 bits of a 64-bit output. */
  nextDouble(): number { return Number(this.nextUint64() >> 11n) * TWO_TO_MINUS_53; }

  /** `rng.random()`, or `rng.random(count)`. */
  random(): number;
  random(count: number): Float64Array;
  random(count?: number): number | Float64Array {
    if (count === undefined) return this.nextDouble();
    return Float64Array.from({ length: checkedCount(count) }, () => this.nextDouble());
  }

  /** `rng.uniform(low, high)`: low + (high - low) * random. */
  uniform(low: number, high: number): number {
    const range = high - low;
    if (!Number.isFinite(range)) throw new RangeError(`uniform(${low}, ${high}): the range is not finite.`);
    return this.#muladd(range, this.nextDouble(), low);
  }

  /** `rng.standard_normal()`: NumPy's ziggurat (`random_standard_normal`). */
  standardNormal(): number {
    for (;;) {
      let r = this.nextUint64();
      const idx = Number(r & 0xffn); r >>= 8n;
      const sign = r & 1n, rabs = Number((r >> 1n) & 0xfffffffffffffn);
      let x = rabs * WI[idx]!;
      if (sign) x = -x;
      if (rabs < KI[idx]!) return x;
      if (idx === 0) {
        for (;;) {
          const xx = -ZIGGURAT_NOR_INV_R * Math.log1p(-this.nextDouble()), yy = -Math.log1p(-this.nextDouble());
          if (yy + yy > xx * xx) return Math.floor(rabs / 256) % 2 ? -(ZIGGURAT_NOR_R + xx) : ZIGGURAT_NOR_R + xx;
        }
      }
      if (this.#muladd(FI[idx - 1]! - FI[idx]!, this.nextDouble(), FI[idx]!) < Math.exp(-0.5 * x * x)) return x;
    }
  }

  /** `rng.normal(loc, scale)`: loc + scale * standard normal. */
  normal(loc = 0, scale = 1): number {
    if (!(scale >= 0)) throw new RangeError(`normal: scale ${scale} is negative.`);
    return this.#muladd(scale, this.standardNormal(), loc);
  }

  /** `rng.integers(low, high)` (high excluded, int64): Lemire's bounded method, on a 32-bit draw when the range fits. */
  integers(low: number, high: number): number {
    if (!Number.isSafeInteger(low) || !Number.isSafeInteger(high) || high <= low) throw new RangeError(`integers(${low}, ${high}) needs safe integers with low < high.`);
    const range = BigInt(high - low - 1);
    if (range === 0n) return low;
    if (range <= MASK32) {
      if (range === MASK32) return low + this.nextUint32();
      const excl = range + 1n;
      let m = BigInt(this.nextUint32()) * excl, leftover = m & MASK32;
      if (leftover < excl) { const threshold = (MASK32 - range) % excl; while (leftover < threshold) { m = BigInt(this.nextUint32()) * excl; leftover = m & MASK32; } }
      return low + Number(m >> 32n);
    }
    const excl = range + 1n;
    let m = this.nextUint64() * excl, leftover = m & MASK64;
    if (leftover < excl) { const threshold = (MASK64 - range) % excl; while (leftover < threshold) { m = this.nextUint64() * excl; leftover = m & MASK64; } }
    return low + Number(m >> 64n);
  }

  /** `rng.choice(values)`: one element, drawn as `integers(0, length)`. */
  choice<T>(values: readonly T[]): T {
    if (!values.length) throw new RangeError('choice: the population is empty.');
    return values[this.integers(0, values.length)]!;
  }

  /**
   * `rng.choice(population, count)` or `rng.choice(population, count, p=probabilities)` with replacement, as indices
   * 0 to population - 1. Without probabilities each is `integers(0, population)`; with them, `count` draws of `random`
   * are searched (side right) in the cumulative sum of the probabilities divided by its last value.
   */
  choiceIndices(population: number, count: number, probabilities?: ArrayLike<number>): number[] {
    if (!Number.isSafeInteger(population) || population <= 0) throw new RangeError(`choice: population ${population} is not a positive integer.`);
    checkedCount(count);
    if (!probabilities) return Array.from({ length: count }, () => this.integers(0, population));
    if (probabilities.length !== population) throw new RangeError('choice: the population and the probabilities differ in size.');
    let sum = 0, c = 0;
    for (let i = 0; i < population; i++) { const p = probabilities[i]!; if (Number.isNaN(p)) throw new RangeError('choice: probabilities contain NaN.'); if (p < 0) throw new RangeError('choice: probabilities are negative.'); const y = p - c, t = sum + y; c = (t - sum) - y; sum = t; }
    if (Math.abs(sum - 1) > Math.sqrt(Number.EPSILON)) throw new RangeError('choice: probabilities do not sum to 1.');
    const cdf = new Float64Array(population);
    let running = 0;
    for (let i = 0; i < population; i++) { running += probabilities[i]!; cdf[i] = running; }
    const last = cdf[population - 1]!;
    for (let i = 0; i < population; i++) cdf[i] = cdf[i]! / last;
    const uniforms = this.random(count);
    return Array.from(uniforms, u => { let lo = 0, hi = population; while (lo < hi) { const mid = (lo + hi) >> 1; if (cdf[mid]! <= u) lo = mid + 1; else hi = mid; } return lo; });
  }
}

/** `np.random.default_rng(seed)`. */
export function defaultRng(seed: number | bigint, options: { fusedMultiplyAdd?: boolean } = {}): NumpyGenerator { return new NumpyGenerator(seed, options); }

/** A finite double as an integer times a power of two. */
function dyadic(x: number): { m: bigint; e: number } {
  const view = new DataView(new ArrayBuffer(8)); view.setFloat64(0, x);
  const hi = view.getUint32(0), lo = view.getUint32(4), exponent = (hi >>> 20) & 0x7ff, sign = hi >>> 31 ? -1n : 1n;
  const fraction = (BigInt(hi & 0xfffff) << 32n) | BigInt(lo);
  return exponent ? { m: sign * (fraction | (1n << 52n)), e: exponent - 1075 } : { m: sign * fraction, e: -1074 };
}

/** a * b + c with one rounding (to nearest, ties to even), as a fused multiply-add computes it. Exact BigInt sums;
 * results below 2^-1000 in size are refused rather than rounded twice. */
export function fma(a: number, b: number, c: number): number {
  if (!Number.isFinite(a) || !Number.isFinite(b) || !Number.isFinite(c)) return a * b + c;
  const p = dyadic(a), q = dyadic(b), r = dyadic(c), pe = p.e + q.e, e = Math.min(pe, r.e);
  const sum = p.m * q.m * (1n << BigInt(pe - e)) + r.m * (1n << BigInt(r.e - e));
  if (sum === 0n) return a * b + c;
  // Round the exact sum to 53 significant bits first (Number() rounds to nearest, ties to even), then scale exactly.
  const bits = (sum < 0n ? -sum : sum).toString(2).length, drop = Math.max(0, bits - 53);
  if (e + drop + 53 < -1000) throw new RangeError('fma: the result is too small to scale exactly.');
  let rounded: bigint;
  if (drop) {
    const unit = 1n << BigInt(drop), half = unit >> 1n, mag = sum < 0n ? -sum : sum, low = mag & (unit - 1n);
    let kept = mag >> BigInt(drop);
    if (low > half || (low === half && (kept & 1n))) kept += 1n;
    rounded = (sum < 0n ? -kept : kept);
  } else rounded = sum;
  const scale = e + drop;
  return Number(rounded) * 2 ** scale;
}

function checkedCount(count: number): number {
  if (!Number.isSafeInteger(count) || count < 0) throw new RangeError(`A draw count must be a non-negative integer; got ${count}.`);
  return count;
}

