function fixture(name: string): number[] {
  const record = FIXTURES as Record<string, unknown>, list = record[name];
  if (!Array.isArray(list)) throw new TypeError(`No fixture ${name}.`);
  return list.map(v => v === 'NaN' ? NaN : v === 'Inf' ? Infinity : v === '-Inf' ? -Infinity : typeof v === 'number' ? v : NaN);
}
const f64 = (name: string) => Float64Array.from(fixture(name)), f32 = (name: string) => Float32Array.from(fixture(name)), u8 = (name: string) => Uint8Array.from(fixture(name));
/** Bit-equal, element by element (NaN equals NaN, 0 and -0 differ). */
function same(actual: ArrayLike<number>, expected: ArrayLike<number>, what: string): void {
  assert.equal(actual.length, expected.length, `${what}: length`);
  for (let i = 0; i < expected.length; i++) if (!Object.is(actual[i], expected[i]) && !(actual[i] === 0 && expected[i] === 0)) assert.fail(`${what}[${i}]: ${actual[i]} is not scipy's ${expected[i]}`);
}
const S = [7, 9];

test('gaussianFilter gives scipy\'s bits: float64 with a NaN, float32 per axis, every mode, 3-D and a 33-wide kernel', () => {
  same(gaussianFilter(f64('a64'), S, 1.5), fixture('g64'), 'nan, sigma 1.5');
  const a = f64('a64').map(v => Number.isNaN(v) ? 0 : v);
  same(gaussianFilter(a, S, 1.5), fixture('g64f'), 'sigma 1.5');
  const g32 = gaussianFilter(f32('a32'), S, [1, 2.5]); assert.ok(g32 instanceof Float32Array); same(g32, fixture('g32'), 'float32 [1, 2.5]');
  for (const mode of ['nearest', 'mirror', 'wrap'] as const) same(gaussianFilter(a, S, 0.8, { mode }), fixture(`g_${mode}`), mode);
  same(gaussianFilter(a, S, 0.8, { mode: 'constant', cval: 0.5 }), fixture('g_constant'), 'constant 0.5');
  same(gaussianFilter(f32('c3'), [3, 4, 5], 1), fixture('g3'), '3-D');
  same(gaussianFilter(f64('big1d'), [40], 8), fixture('gbig'), 'sigma 8, 1-D');
  const k = gaussianKernel(8, 32); assert.equal(k.length, 65); assert.ok(Math.abs(k.reduce((s, v) => s + v, 0) - 1) < 1e-15);
  // Kernels whose normalising sum depends on numpy's pairwise order (a plain running sum differs in the last bit).
  same(gaussianKernel(4, 16).subarray(16, 19), [0.09973909953098634, 0.0966704500421759, 0.08801944640267212], 'kernel sigma 4');
  same(gaussianKernel(10, 40).subarray(40, 43), [0.039896256754163625, 0.03969727334346815, 0.03910625794033686], 'kernel sigma 10');
});

test('uniformFilter carries scipy\'s running sum', () => {
  const a = f64('a64').map(v => Number.isNaN(v) ? 0 : v);
  same(uniformFilter(a, S, 3), fixture('u64'), 'float64 3');
  same(uniformFilter(f32('a32'), S, 3), fixture('u32'), 'float32 3');
  same(uniformFilter(f64('big1d'), [40], 5, { mode: 'nearest' }), fixture('u1'), '1-D 5 nearest');
});

test('maximumFilter and medianFilter give scipy\'s values in every mode used', () => {
  const a = f64('a64').map(v => Number.isNaN(v) ? 0 : v);
  same(maximumFilter(a, S, 3), fixture('m3'), 'max 3');
  same(maximumFilter(f32('a32'), S, 5, { mode: 'nearest' }), fixture('m5n'), 'max 5 nearest');
  same(medianFilter(f64('w'), [50], 41, { mode: 'wrap' }), fixture('medw'), '1-D 41 wrap');
  same(medianFilter(f32('cube'), [20, 3, 4], [5, 1, 1], { mode: 'nearest' }), fixture('medcube'), 'cube (5,1,1) nearest');
  same(medianFilter(f32('im'), [12, 13], 9, { mode: 'nearest' }), fixture('medim'), '2-D 9 nearest (ranked)');
  same(medianFilter(f32('im'), [12, 13], [7, 8], { mode: 'reflect' }), fixture('medim7'), '2-D (7,8) reflect (ranked, even width)');
  same(medianFilter(a, S, 3), fixture('med3'), '2-D 3 reflect');
  assert.throws(() => medianFilter(f64('a64'), S, 3), TypeError);
});

test('binary morphology and label follow scipy\'s cross and numbering', () => {
  const M = [9, 11];
  same(binaryDilation(u8('mask'), M, 2), fixture('dil2'), 'dilation 2');
  same(binaryErosion(u8('mask2'), M), fixture('ero1'), 'erosion 1');
  same(binaryErosion(u8('mask2'), M, 2), fixture('ero2'), 'erosion 2');
  same(binaryOpening(u8('mask2'), M), fixture('open1'), 'opening 1');
  const { labels, count } = label(u8('mask'), M); same(labels, fixture('lab'), 'labels'); assert.equal(count, (FIXTURES as { nlab: number }).nlab);
});

test('mapCoordinates and affineTransform read the image as scipy does at its edges and NaNs', () => {
  const img = f64('img'), I = [4, 5], rows = f64('rows'), cols = f64('cols');
  same(mapCoordinates(img, I, rows, cols, { order: 1, cval: NaN }), fixture('mc1nan'), 'order 1, cval NaN');
  same(mapCoordinates(img.map(v => Number.isNaN(v) ? 0 : v), I, rows, cols, { order: 1, cval: 0 }), fixture('mc1zero'), 'order 1, cval 0');
  same(mapCoordinates(img, I, rows, cols, { order: 0, cval: 1 }), fixture('mc0'), 'order 0, cval 1');
  // At the last pixel the kernel's second place mirrors to n-2: a NaN there spoils the value (scipy: NaN at 3, 2.5, 1.999).
  same(mapCoordinates(Float64Array.of(1, 2, NaN, 4), [1, 4], [0, 0, 0, 0], [3, 2.5, 1.999, 0.5], { cval: -7 }), [NaN, NaN, NaN, 1.5], 'mirror at the edge');
  same(mapCoordinates(img.map(v => Number.isNaN(v) ? 0 : v), I, f64('rn'), f64('cn'), { order: 1, mode: 'nearest' }), fixture('mcn'), 'order 1, nearest');
  same(affineTransform(f64('af'), [6, 7], [[0.98, 0.03], [-0.02, 1.01]], [0.3, -0.4], { cval: NaN }), fixture('aff'), 'affine');
  const af32 = Float32Array.from(fixture('af'), v => Number.isNaN(v) ? 0 : v), out = affineTransform(af32, [6, 7], [[1, 0], [0, 1]], [0.5, -0.25], { cval: NaN });
  assert.ok(out instanceof Float32Array); same(out, fixture('aff32'), 'affine float32');
});

test('distanceTransformEdt and gradient', () => {
  same(distanceTransformEdt(u8('mask2'), [9, 11]), fixture('edt'), 'edt');
  const a = f64('a64').map(v => Number.isNaN(v) ? 0 : v), [gy, gx] = gradient(a, S); same(gy, fixture('gy'), 'd/drow'); same(gx, fixture('gx'), 'd/dcol');
  const [gy32, gx32] = gradient(f32('a32'), S); same(gy32, fixture('gy32'), 'd/drow f32'); same(gx32, fixture('gx32'), 'd/dcol f32');
});

test('arguments that do not fit their shape are refused', () => {
  assert.throws(() => gaussianFilter(new Float64Array(5), [2, 3], 1), TypeError);
  assert.throws(() => mapCoordinates(new Float64Array(6), [2, 3], [0], [0, 1]), TypeError);
  assert.throws(() => binaryDilation(new Uint8Array(6), [2, 3], 0), TypeError);
});
