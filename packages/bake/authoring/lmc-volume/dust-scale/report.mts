const cfg=rec(await json(L27+'configuration.json')),fit=rec(await json(L27+'calibration.json')),result=rec(await json(L27+'result.json')),lane=rec(await json(L27+'lane-checks.json')),q=await json(L27+'qualification.json'),rungs=array(await json(L27+'rungs.json')),before=rec(lane.baseline),measurement=rec(lane.measurement),photo=rec(lane.photo),location=rec(lane.location),priorLocation=rec(before.location),bar=rec(measurement.bar),photoBar=rec(photo.bar),checks=rec(lane.checks),factor=num(result.factor),residuals=rec(result.residuals),source=ROOT+'src/objects/lmc-volume/source/preparation/l27/';
