const control:Record<string,unknown>={...rec(await json(versionDir(26)+'unattenuated-reference.json')),reuseReason:'The l26 zero-internal-dust reference uses the same frozen l25 stellar light, grade, registration and native lane masks. l27 changes only numeric admission bounds and physical dust strength. No rendering arithmetic or zero-dust photon path changed, so this specific reference still applies. It is not a candidate l27 model.'};
const acceptance={passed:lane.passed,promoted:false,acceptedBase:25,checks,tolerances:TOLERANCE,minimumLaneOverlap:priorLocation.intersectionOverUnion,errors,rmsIsGate:false,sideViewsInspected:true,sideViewsCoherent:true,visualAssessment:'Black specks are suppressed, but the bar is nearly dust-free in appearance. The connected brown-orange lanes are lost. Side views remain coherent.',status:lane.passed?'All stated numerical checks pass; owner visual review is pending.':'The scalar diagnostic is complete, but does not meet all criteria. l25 remains the owner-accepted base.',physicalScope:'Only one global optical-depth multiplier is applied. Raw native dust columns, finite shapes, relative field contrast, foreground ordering, stellar light and Gordon law are unchanged.',interpretation:'Uniformly lowering opacity also lowers selective reddening under the same law. Source-coordinate preservation does not imply preserved visible lane contrast; the independent overlap check measures this separately.'};
