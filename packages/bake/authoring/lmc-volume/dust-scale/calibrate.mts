/** Tiny pilot, then a bounded one-dimensional native-resolution calibration. */
import {mkdir,readFile,writeFile} from 'node:fs/promises';
import {loadParent,parentRung,versionDir} from '../sequence-state.mts';
import {photoRgb,displayRgb} from '../bar-ratios.mts';
import {readGrade,gradedPrediction} from '../grade.mts';
import {earthCamera} from '../render.mts';import {projectCatalogue,catalogueBasis} from '../catalogue-render.mts';
import {json,rec,need} from '../inputs.mts';import {laneContext} from '../dust-lanes/measure.mts';
import {L27,BOUNDS,TOLERANCE,scaleDust,evaluate,checks,calibrationSupport} from './model.mts';
const tiny=process.argv.includes('--tiny'),factors=(process.argv.find(a=>a.startsWith('--factors='))?.split('=')[1]??(tiny?'1,0.2,0.01':'1,0.5,0.2,0.01')).split(',').map(Number);
await mkdir(L27+'calibration/',{recursive:true});
if(!tiny){const pilot=rec(await json(L27+'pilot.json'));need(pilot.pilotPassed===true,'Complete the exact-code tiny calibration before native sampling');}
const {scene}=await loadParent(25),parent=await parentRung(25,false,scene),base=scene.dustLayer?.strength;need(base!==undefined,'Missing l25 strength');
const c=await laneContext(tiny),pixels=calibrationSupport(c.valid,c.bar),photo=photoRgb(c.o),grade=readGrade(parent.result.grade),baselineBytes=await readFile(versionDir(25)+(tiny?'tiny/':'')+'bar-prediction.f64le'),reference=new Float64Array(Uint8Array.from(baselineBytes).buffer),baseline=evaluate(displayRgb(reference,c.o.metadata.sky.rgbLinearDisplay),c,photo),trials=[],predictions:Float64Array[]=[];
for(const factor of factors){const started=performance.now(),strength=scaleDust(scene,base,factor),basis=catalogueBasis(projectCatalogue(scene,earthCamera(c.o.width,c.o.height,c.o.rayAt,c.o.pixelOf),.03,pixels),scene,parent.amplitudes),prediction=gradedPrediction(basis,grade);let parentReplay:number|undefined;if(factor===1){parentReplay=0;for(let i=0;i<prediction.length;i++)if(pixels[Math.floor(i/3)])parentReplay=Math.max(parentReplay,Math.abs(prediction[i]-reference[i]));need(parentReplay<1e-12,'Multiplier one does not replay accepted l25');}const result=evaluate(displayRgb(prediction,c.o.metadata.sky.rgbLinearDisplay),c,photo),pass=checks(result.measurement,result.photo,result.location.intersectionOverUnion,baseline.location.intersectionOverUnion),trial={factor,strength,...result,checks:pass,parentReplay,seconds:(performance.now()-started)/1000};trials.push(trial);predictions.push(prediction);await writeFile(L27+'calibration/'+(tiny?'tiny':'native')+'-'+factor+'.f64le',Buffer.from(prediction.buffer));await writeFile(L27+'calibration/'+(tiny?'tiny':'native')+'-trials.json',JSON.stringify({baseline,tolerances:TOLERANCE,bounds:BOUNDS,trials},null,2)+'\n');console.log(JSON.stringify({sentinel:'L27_SCALE_TRIAL',tiny,...trial}));}
const improvement=trials.some(v=>Math.abs(v.measurement.depth-v.photo.depth)<Math.abs(baseline.measurement.depth-baseline.photo.depth)),pilotPassed=improvement&&trials.every(v=>Number.isFinite(v.measurement.depth));
const selected=[...trials].sort((a,b)=>Math.abs(a.measurement.depth-a.photo.depth)-Math.abs(b.measurement.depth-b.photo.depth))[0];
const record={parent:25,freeParameters:1,bounds:BOUNDS,tolerances:TOLERANCE,baseline,trials,selected,pilotPassed,selection:'Minimize paired lane-dimming error with one global factor. Color contrast, lane overlap and bar color are independent acceptance checks, not permission to replace the objective with an unchanged parent. No field or mask edits.'};await writeFile(L27+(tiny?'pilot.json':'calibration.json'),JSON.stringify(record,null,2)+'\n');if(!tiny)await writeFile(L27+'calibration/selected-prediction.f64le',Buffer.from(predictions[trials.indexOf(selected)].buffer));console.log(JSON.stringify({sentinel:'L27_SCALE_CALIBRATION_COMPLETE',tiny,pilotPassed,selectedFactor:selected.factor,selectedChecks:selected.checks}));
