/** Report saved l14 outputs without starting fits or reference renders. */
import {readFile,writeFile} from 'node:fs/promises';
import sharp from 'sharp';
import {LOCAL,json,rec,array,num,need} from './inputs.mts';
import {L14,CONTINUOUS_SETTINGS} from './continuous-model.mts';
const result=rec(await json(L14+'result.json')),current=rec(result.residuals),diag=rec(result.diagnostics),outskirts=rec(diag.outskirts),tiny=rec(await json(L14+'tiny/result.json')),l13=rec(rec(await json(LOCAL+'versions/l13/result.json')).residuals),l10=rec(rec(await json(LOCAL+'versions/l10/result.json')).residuals),preservation=rec(await json(L14+'preservation.json'));
need(num(result.size)===512&&preservation.catalogueGeometryMatchesL13===true&&preservation.dustGeometryMatchesL13===true,'Missing complete l14 evidence');
const rungs=array(await json(L14+'rungs.json'));need(rungs.length===2&&rec(rungs[0]).rung==='tiny'&&rec(rungs[1]).rung==='small'&&JSON.stringify(rungs[1])===JSON.stringify(result),'Report does not match a completed tiny and small run');
const format=(v:unknown)=>num(v).toFixed(6),percent=(v:unknown)=>num(v).toFixed(2)+'%',outer=(v:Record<string,unknown>)=>array(v.annularDifferencePercent)[3],row=(label:string,key:string,f:(v:unknown)=>string)=>`| ${label} | ${f(l10[key])} | ${f(l13[key])} | ${f(current[key])} |`;
await writeFile(L14+'notes.md',`# l14: continuous Gaia population and independent outskirts\n\nGaia counts use an adopted Gaussian smoothing sigma of 200 pc, increased from 150 pc. The layer remains 150 pc thick on the same warp. The count selection and 262,992 members are unchanged; [Luri et al. 2021](https://arxiv.org/html/2012.01771) supplies the selection method. No photographic structure enters this population.\n\nThe diffuse population has its own global RGB grade, separate from catalogue clusters. Its RGB factors relative to l13 are ${array(diag.youngRgbFactors).map(v=>num(v).toFixed(3)).join(', ')}; their arithmetic mean is ${num(diag.youngGainFactor).toFixed(3)}. Each factor is bounded to 0.25–4. Existing inner-disc and bar gains become ${num(diag.innerDiscGain).toFixed(3)} and ${num(diag.barGain).toFixed(3)}, within 0.5–1.5. Catalogue luminosities, other color tints, display curve, dust and geometry stay at l13.\n\nThe outskirts gain is **${num(outskirts.gain).toFixed(3)}**, within **0.5–4**, measured from the >=4 kpc annulus. A fixed smooth partition from 3 to 5 kpc separates the existing faint old light; at unit gain the total profile is unchanged. This is an adopted luminosity partition, not a measured boundary or a new halo. The existing halo shares that gain.\n\n| Earth residual | l10 | l13 | l14 |\n| --- | --- | --- | --- |\n${row('RGB RMS, first checkerboard','trainRelativeRms',format)}\n${row('RGB RMS, second checkerboard','heldoutRelativeRms',format)}\n${row('Total light','totalLightDifferencePercent',percent)}\n| Outer-annulus light | ${percent(outer(l10))} | ${percent(outer(l13))} | ${percent(outer(current))} |\n\nAnnular light errors from the centre outward are ${array(current.annularDifferencePercent).map(percent).join(', ')}. Both checkerboards supplied calibration pixels; they are not independent validation. The outer red channel share is ${num(array(array(current.channelShareDifferencePercentagePoints)[2])[0]).toFixed(2)} percentage points above the photo. Brightness is corrected, but that color mismatch remains.\n\nTiny took ${num(tiny.seconds).toFixed(1)} seconds; 512 px took ${num(result.seconds).toFixed(1)} seconds. The first two tiny trials let the outer control fill the inner disc and weakened Gaia; moving its fixed transition outward corrected that allocation. No full-resolution fit or slab bake ran. [Visual review](visual-review.md) records continuity and side-view limits.\n`);
await sharp({create:{width:4608,height:1668,channels:3,background:'#101216'}}).composite(await Promise.all([10,13,14].map(async(v,i)=>({input:await readFile(LOCAL+`versions/l${v}/sheet.png`),left:i*1536,top:0})))).png().toFile(L14+'l10-l13-l14-side-by-side.png');
await writeFile(L14+'calibration-bounds.json',JSON.stringify({settings:CONTINUOUS_SETTINGS,controls:diag},null,2)+'\n');
console.log(JSON.stringify({sentinel:'L14_SAVED_EVIDENCE_COMPLETE',size:result.size,outerError:outer(current),outskirtsGain:outskirts.gain}));
