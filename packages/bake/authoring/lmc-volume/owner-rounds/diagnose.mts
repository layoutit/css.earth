/** Matched sky apertures distinguish measured stellar color from dust reddening. */
import {mkdir,writeFile} from 'node:fs/promises';import {LOCAL,json,rec,array,num,need,at} from '../inputs.mts';import {loadObservation} from '../observation.mts';import {skyOf} from '../geometry.mts';import {loadParent,versionDir} from '../sequence-state.mts';import {gaiaWarpLocator} from '../gaia-plane.mts';import {loadHeritage} from '../heritage-input.mts';import {loadOgle,internalAv} from '../dust-geometry/ogle.mts';import {PINS} from './pins.mts';
const version=Number(process.argv[2]);need(version===30||version===31,'Choose diagnostic theme');const dir=versionDir(version);await mkdir(dir,{recursive:true});const o=await loadObservation(8),{scene}=await loadParent(29),locate=gaiaWarpLocator(scene.sources),heritage=await loadHeritage(),ogle=await loadOgle(),regions=array(await json(LOCAL+'versions/l23/regional-flux.json')).map(v=>{const r=rec(v);return{x:num(r.xKpc),y:num(r.yKpc),rgb:array(r.resolvedRgb).map((v,c)=>num(v)+num(array(r.unresolvedRgb)[c])),stars:num(r.stars),members:num(r.members)};});
const sample=(x:number,y:number)=>{const [ra,dec]=skyOf(o.rayAt(x+.5,y+.5)),p=locate(ra,dec),h=heritage.wcs.pixelOf(ra,dec),cell=ogle.sample(ra,dec),near=regions.filter(r=>Math.hypot(r.x-p[0],r.y-p[1])<.15),rgb=[0,0,0];let stars=0,members=0;for(const r of near){for(let c=0;c<3;c++)rgb[c]+=r.rgb[c];stars+=r.stars;members+=r.members;}let sigma:null|number=null;if(h){const xx=Math.round(h[0]),yy=Math.round(h[1]);if(xx>=0&&yy>=0&&xx<heritage.image.width&&yy<heritage.image.height){const v=heritage.image.values[yy*heritage.image.width+xx];if(Number.isFinite(v))sigma=10**v;}}const av=cell?internalAv(cell.evi):null,tau=(av??0)/1.0857362047581296;return{x,y,ra,dec,planeKpc:p,mcps:{supportCells:near.length,stars,members,rgb,rg:rgb[0]/rgb[1],bg:rgb[2]/rgb[1],intrinsicRg:rgb[0]/rgb[1]*Math.exp(-.25*tau),intrinsicBg:rgb[2]/rgb[1]*Math.exp(tau/3.41)},ogle:cell?{evi:cell.evi,internalAv:av,widthArcmin:cell.box}:null,heritageDustMsunPc2:sigma,heritageNominalAv:sigma===null?null:7.394*sigma,bellTau:at(scene.sources.dust,p[0],p[1])};};
const pins=PINS.filter(p=>p.theme===version).map(p=>({pin:p,center:sample(p.x,p.y),neighbors:[[-15,0],[15,0],[0,-15],[0,15]].map(([dx,dy])=>sample(p.x+dx,p.y+dy))}));await writeFile(dir+'diagnosis.json',JSON.stringify({version,aperture:'150 pc radius for cached MCPS membership-weighted resolved plus HST-estimated unresolved BVI flux; HERITAGE nearest 56-arcsecond cell; OGLE finest containing published cell.',warning:'Broad-band ratios are F_nu proxies, not Horálek camera RGB. Intrinsic correction uses red-clump mean reddening under the same population-depth prior; it does not measure individual stellar depths.',pins},null,2)+'\n');console.log(JSON.stringify({sentinel:'OWNER_DATA_DIAGNOSED',version,pins}));
