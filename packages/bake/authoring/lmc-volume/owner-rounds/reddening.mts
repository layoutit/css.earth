/** Test the positive OGLE foreground-column residual without rescaling HERITAGE lanes. */
import {pathToFileURL} from 'node:url';import {mkdir,writeFile,copyFile} from 'node:fs/promises';import {ROOT,json,rec,array,num,need,makeRaster,smooth,at} from '../inputs.mts';import {loadParent,parentRung,saveConfiguration,versionDir,type Configuration} from '../sequence-state.mts';import {loadOgle} from '../dust-geometry/ogle.mts';import {gaiaWarpLocator} from '../gaia-plane.mts';import {skyOf,bodyToIcrs,rayInBody,unit} from '../geometry.mts';import {volumeObject,planarBasis} from '../catalogue-volume.mts';import {DEPTH_NODES,DUST_SIGMA,inferHeight} from '../dust-geometry/depth.mts';
export function residualAv(front:number,total:number,fraction:number){need(front>=0&&total>=0&&fraction>=0&&fraction<=1,'Invalid column residual');return Math.max(0,front-total*fraction);}
export async function prepareReddening(gain=1){const dir=versionDir(30),{scene,cfg:base}=await loadParent(29);await parentRung(29,false,scene);need(scene.dustLayer?.clouds,'Native dust required');await mkdir(dir,{recursive:true});const ogle=await loadOgle(),regions=new Map(array(await json(versionDir(25)+'regions.json')).map(v=>{const r=rec(v);return[num(r.id),r];})),map=makeRaster(256,10),locate=gaiaWarpLocator(scene.sources);let clipped=0;
for(let y=0;y<map.n;y++)for(let x=0;x<map.n;x++){const px=((x+.5)/map.n*2-1)*map.half,py=((y+.5)/map.n*2-1)*map.half,[ra,dec]=skyOf(bodyToIcrs([px,py,at(scene.sources.warp,px,py)])),cell=ogle.sample(ra,dec),r=cell&&regions.get(cell.id);if(r){const residual=residualAv(num(r.frontAv),num(r.totalAv),num(r.frontFraction));map.values[y*map.n+x]=residual;map.mask[y*map.n+x]=1;if(residual>0)clipped++;}}
const field=smooth(map,.05/(20/map.n)),baseClouds=scene.dustLayer.clouds.slice(),adoptedGain=gain;need(adoptedGain>=0&&gain<=1,'Residual strength must be between zero and one');const clouds=baseClouds.slice(),cell=20/map.n,mean=inferHeight(.98,1).height;let additionalWeight=0;
for(let y=0;y<map.n;y++)for(let x=0;x<map.n;x++){const av=field.values[y*map.n+x]*gain;if(av<.0001)continue;const px=((x+.5)/map.n*2-1)*map.half,py=((y+.5)/map.n*2-1)*map.half,[ra,dec]=skyOf(bodyToIcrs([px,py,at(scene.sources.warp,px,py)]));for(const [i,node]of DEPTH_NODES.entries()){const center=locate(ra,dec,mean+node.z*DUST_SIGMA,DUST_SIGMA),weight=av/1.0857362047581296*cell*cell*node.weight*Math.abs(rayInBody(unit(ra,dec)).direction[2]);additionalWeight+=weight;clouds.push(volumeObject({id:`OGLE-residual-${y*map.n+x}-${i}`,owner:'OGLE-residual',kind:'dust-tent',component:0,center,basis:planarBasis(0),axes:[cell,cell,cell],inner:0,color:[1,1,1],weight,source:'Positive OGLE red-clump foreground A_V residual above l25 region-averaged HERITAGE foreground column. Added conditional diffuse dust, not a measured cloud distance.'}));}}
const metadata=rec(await json(versionDir(25)+'dust-column.json')),cfg:Configuration={...base,version:30,parent:29,dustVersion:30,change:'Test diffuse foreground reddening missing from the clipped OGLE/HERITAGE regions.',details:{diagnosis:'F3 has enhanced OGLE reddening and HERITAGE dust; corrected MCPS light is not redder than adjacent regions. G4 is less certain because cached bar-photometry support is absent.',residualGain:gain,freeParameters:0,gridCellPc:cell*1000,smoothingPc:50,layerSigmaKpc:250/1000,nearSideMeanKpc:mean,nativeCloudsUnchanged:baseClouds.length,addedClouds:clouds.length-baseClouds.length,additionalColumnWeightFraction:additionalWeight/baseClouds.reduce((a,b)=>a+b.weight,0),affectedGridCells:clipped,method:'max(0, OGLE foreground A_V - original regional HERITAGE A_V × original front fraction). This adds the missing optical column, without flattening or renormalizing HERITAGE pixels. The Gordon/l28 RGB material and all stars are fixed.',geometry:'Additional diffuse dust uses the adopted 250 pc depth dispersion and near-side 0.98 foreground probability. This is an assumed placement conditional on the measured reddening excess, not new tomography. Positive quadrature depths and compact isotropic 78 pc patches avoid columns along the Earth direction.',caveat:'OGLE/HERITAGE disagreement may be calibration or tracer bias rather than extra dust. This is a falsifiable candidate; total dust increases above the Bell-normalized base and the amount is reported.'}};await saveConfiguration(cfg,base.densityVersion);await copyFile(versionDir(25)+'dust-column.f32le',dir+'dust-column.f32le');await writeFile(dir+'dust-column.json',JSON.stringify({...metadata,version:30,parent:29,clouds:clouds.length,residual:cfg.details},null,2)+'\n');await writeFile(dir+'dust-clouds.json',JSON.stringify(clouds)+'\n');const source=ROOT+'src/objects/lmc-volume/source/preparation/l30/';await mkdir(source,{recursive:true});await copyFile(ROOT+'src/objects/lmc-volume/source/preparation/l29/frame.json',source+'frame.json');await writeFile(source+'field.json',JSON.stringify({version:30,parent:29,configuration:cfg},null,2)+'\n');console.log(JSON.stringify({sentinel:'L30_REDDENING_FIELD_PREPARED',...cfg.details}));
}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await prepareReddening(Number(process.argv[2]??1));
