/** Finer stellar structure comes only from catalogue positions and finite associations. */
import {mkdir,writeFile,copyFile} from 'node:fs/promises';import {pathToFileURL} from 'node:url';
import {ROOT,json,rec,array,num,need} from '../inputs.mts';import {loadParent,parentRung,saveConfiguration,versionDir,type Configuration} from '../sequence-state.mts';import {loadGaiaSample} from '../gaia-young.mts';import {densityFromMembers} from '../gaia-density.mts';
export const YOUNG_SIGMA_KPC=.045,MCPS_SHARE=.2;
export function uniqueHot(hot:readonly {ra:number;dec:number}[],gaia:readonly {ra:number;dec:number}[]){const index=new Map<string,{ra:number;dec:number}[]>(),key=(ra:number,de:number)=>`${Math.floor(ra*360)},${Math.floor(de*360)}`;for(const s of gaia){const k=key(s.ra,s.dec),bucket=index.get(k)??[];bucket.push(s);index.set(k,bucket);}return hot.filter(s=>{for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++)for(const g of index.get(`${Math.floor(s.ra*360)+dx},${Math.floor(s.dec*360)+dy}`)??[])if(Math.hypot((s.ra-g.ra)*Math.cos(s.dec*Math.PI/180),s.dec-g.dec)*3600<1)return false;return true;});}
export async function prepareYoung(){const dir=versionDir(29);await mkdir(dir,{recursive:true});const {scene,cfg:base}=await loadParent(28);await parentRung(28,false,scene);const sample=await loadGaiaSample(false,dir),raw=rec(await json(dir+'hot-stars.json'));need(raw.pilot===false&&num(raw.rows)===24107002,'Complete MCPS pass required');const selected=array(raw.stars).map(v=>{const r=rec(v);return{ra:num(r.ra),dec:num(r.dec)};}),stars=uniqueHot(selected,sample.stars),gaia=densityFromMembers(sample.stars,scene.sources,1024,10,undefined,YOUNG_SIGMA_KPC),mcps=densityFromMembers(stars,scene.sources,1024,10,undefined,YOUNG_SIGMA_KPC);for(let i=0;i<gaia.values.length;i++)gaia.values[i]=(1-MCPS_SHARE)*gaia.values[i]+MCPS_SHARE*mcps.values[i];
 const details={source:'Gaia DR3 Young 1+2 plus MCPS U-selected faint hot stars',n:1024,halfKpc:10,smoothingSigmaKpc:YOUNG_SIGMA_KPC,layerSigmaKpc:.15,gaiaMembers:sample.stars.length,mcpsCandidates:selected.length,mcpsAfterOneArcsecDedup:stars.length,mcpsShare:MCPS_SHARE,photoUsed:false,normalization:'Each count field has unit integral. Adopted 80/20 Gaia/MCPS mixture, not fitted to regions. A single young RGB grade sets integrated light.',scale:'Adopted 45 pc Gaussian sigma resolves stellar associations while suppressing individual-count speckle. Native grid cells are 19.53 pc. This is spatial regularization, not a measured disc thickness.',associations:'All existing Bica finite 3D association groups and their amplitudes are retained, with no duplicate groups.',limits:'Photometric CMD/Q selection is an age proxy. MCPS U systematics and crowding remain; the U band supplies selection only. One-arcsecond matching removes duplicates of the selected Gaia population.',papers:['https://arxiv.org/html/2012.01771','https://doi.org/10.1086/423910','https://cdsarc.cds.unistra.fr/viz-bin/ReadMe/II/236']};
 const cfg:Configuration={...base,version:29,parent:28,densityVersion:29,change:'Finer catalogue-only young stellar structure and one global young RGB grade.',details};await saveConfiguration(cfg,28);await writeFile(dir+'young-density.f32le',Buffer.from(gaia.values.buffer));await writeFile(dir+'young-density.json',JSON.stringify(details,null,2)+'\n');const source=ROOT+'src/objects/lmc-volume/source/preparation/l29/';await mkdir(source,{recursive:true});await copyFile(ROOT+'src/objects/lmc-volume/source/preparation/l28/frame.json',source+'frame.json');await writeFile(source+'field.json',JSON.stringify({version:29,parent:28,configuration:cfg},null,2)+'\n');console.log(JSON.stringify({sentinel:'L29_DATA_FIELD_PREPARED',...details}));}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await prepareYoung();
