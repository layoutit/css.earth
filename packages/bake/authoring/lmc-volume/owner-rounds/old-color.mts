const dir=versionDir(30),{cfg:base}=await loadParent(29);await mkdir(dir,{recursive:true});const cfg:Configuration={...base,version:30,parent:29,change:'Correct the old-population color at the warm northern bar edge.',details:{referenceProjectionVersion:29,freeParameters:2,searchCoordinateBounds:[.001,1],normalization:'After each color proposal, one scalar preserves l29 total light in the measured outer annulus at radii at least 4 kpc. The actual nonlinear display curve is included. No outskirts gain or density changes.',population:'The existing Gaia red-giant/red-clump field and individual stellar colors stay fixed. Only its one global RGB display grade changes.',diagnosis:'F3 has real reddening, but reddening-corrected MCPS light is no redder than nearby light. The old component in the reference model has post-grade R/G about 5 at F3, versus intrinsic MCPS integrated R/G about 1.17. The inherited old-light grade suppresses green and blue. This motivates a global old-material test, but does not prove a unique physical cause: the MCPS aperture mixes populations and its passbands differ from the graded image.',dustTrial:{rejected:true,reason:'An OGLE positive-residual dust trial barely changes either pin and adds 38.0% to the native dust-column budget. It is not retained.',relativeAddedColumnWeight:.38008827474208384},uncertainty:'MCPS integrated flux includes unresolved-light estimates and mixed stellar populations; passbands differ from the processed photo. G4 lacks cached bar-table support. The correction is a global appearance grade, not a new measured population age or dust distance.',frozen:'All density maps, catalogue objects, grain, geometry, dust, bar component grade, young grade, gas grade, stretch and saturation.'}};await saveConfiguration(cfg,base.densityVersion);await cp(versionDir(29)+'cache/',dir+'cache/',{recursive:true});const source=ROOT+'src/objects/lmc-volume/source/preparation/l30/';await copyFile(ROOT+'src/objects/lmc-volume/source/preparation/l29/frame.json',source+'frame.json');await writeFile(source+'field.json',JSON.stringify({version:30,parent:29,configuration:cfg},null,2)+'\n');console.log(JSON.stringify({sentinel:'L30_OLD_MATERIAL_PREPARED',configuration:cfg}));
