 scene.diffuseGas=map;scene.diffuseGasGain=1;const baseline=await readContrastBasis('pins',versionDir(29)),projection=projectCatalogue(scene,earthCamera(512,384,o.rayAt,o.pixelOf),.06,maskPins()),unitBasis=catalogueBasis(projection,scene,parent.amplitudes),grade=readGrade(parent.result.grade),photo=await pngRgb(versionDir(29)+'horalek.png'),previous=await pngRgb(versionDir(29)+'earth.png'),targets=PINS.filter(p=>p.theme===31),guards=PINS.filter(p=>p.theme!==31),ownerIndex=scene.owners.findIndex(v=>v.id==='DEM268'),ownerTemplate=projection.objects.find(v=>v.owner===ownerIndex);need(ownerIndex>=0&&ownerTemplate,'The measured H3 emitter DEM268 is missing');const ownerResponse=new Float64Array(512*384*3);for(let j=0;j<ownerTemplate.indices.length;j++)for(let c=0;c<3;c++)ownerResponse[ownerTemplate.indices[j]*3+c]+=ownerTemplate.rgb[j*3+c]*parent.amplitudes[ownerIndex];const combined=(gain:number,multiplier=1)=>{const b=scaledGas(baseline,unitBasis,gain),planes=b.planes.slice();planes[4]=Float64Array.from(b.planes[4],(v,i)=>v+(multiplier-1)*ownerResponse[i]);return{...b,planes};},rgbOf=(gain:number,multiplier=1)=>displayRgb(gradedPrediction(combined(gain,multiplier),grade),o.metadata.sky.rgbLinearDisplay);
