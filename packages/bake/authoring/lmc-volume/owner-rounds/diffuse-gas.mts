async function main(){const dir=versionDir(31);await mkdir(dir+'preview/',{recursive:true});const {scene,cfg:parentCfg}=await loadParent(29),parent=await parentRung(29,false,scene),o=await loadObservation(8),ogle=await loadOgle(),inputs=[];
