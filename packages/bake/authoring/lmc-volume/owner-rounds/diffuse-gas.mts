 const selected=combined(best,ownerMultiplier),output=rgbOf(best,ownerMultiplier),calibration={version:31,parent:29,grade,freeParameters:2,ownerChanges:ownerMultiplier===1?undefined:[{id:'DEM268',multiplier:ownerMultiplier}],ownerBounds:[.5,2],diffuseGain:best,ownerAtUpperBound:ownerMultiplier>=2-1e-10,bounds:[0,.05],objective:bestScore,targetScore:bestScore,zeroScore:objective(0,1),rawOptimum:optimum,maximumDisplayChange,materialityRule:'If even the largest channel change on all native calibration/guard windows is below one 8-bit display level, retain zero added emission. This avoids claiming a sub-quantization fit as a visible improvement.',responseAtPins,method:'One global diffuse H-alpha luminosity plus one brightness multiplier for the independently identified H3 region DEM268. RGB materials and all other catalogue amplitudes are fixed. Each scalar uses a coarse bracket and 28 golden-section steps.',measurements:PINS.map(p=>({pin:p,photo:measure(photo,p),previous:measure(previous,p),new:measure(output,p)}))};await writeContrastBasis('pins',selected,dir);await writeFile(dir+'calibration.json',JSON.stringify(calibration,null,2)+'\n');await writeFile(dir+'preview/earth-rgb.f64le',Buffer.from(output.buffer));
