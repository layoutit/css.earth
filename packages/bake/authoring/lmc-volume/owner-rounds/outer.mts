/** Conserve measured outer light while fitting the old population's two color degrees of freedom. */
import {gradedPrediction,readGrade,type Grade} from '../grade.mts';import {rayPlane} from '../geometry.mts';import {need} from '../inputs.mts';import type {Basis} from '../render.mts';import type {Observation} from '../report.mts';
export function outerBasis(b:Basis,o:Observation):Basis{const pixels:number[]=[];for(let y=0;y<o.height;y++)for(let x=0;x<o.width;x++){if(!o.mask[y][x])continue;const p=rayPlane(o.rayAt(x+.5,y+.5));if(Math.hypot(p[0],p[1])>=4)pixels.push(y*o.width+x);}need(pixels.length>0,'No measured outer annulus');return{width:pixels.length,height:1,dustGain:1,planes:b.planes.map(v=>Float64Array.from(pixels.flatMap(p=>[v[p*3],v[p*3+1],v[p*3+2]])))};}
export function conserveOuter(b:Basis,initial:Grade,trial:Grade):Grade{const target=gradedPrediction(b,initial).reduce((a,v)=>a+v,0),out=readGrade(trial),color=[...trial.coefficients[0]];let lo=.01,hi=10;for(let i=0;i<24;i++){const gain=(lo+hi)/2;for(let c=0;c<3;c++)out.coefficients[0][c]=color[c]*gain;const sum=gradedPrediction(b,out).reduce((a,v)=>a+v,0);if(sum<target)lo=gain;else hi=gain;}for(let c=0;c<3;c++)out.coefficients[0][c]=color[c]*(lo+hi)/2;need(out.coefficients[0].every(v=>v<=100),'Outer normalization exceeds material bounds');return out;}
