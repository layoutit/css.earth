/** A native MCPS streaming pass; the Q selection follows Massey (2002), section 4.1. */
import {createReadStream} from 'node:fs';import {createGunzip} from 'node:zlib';import {createInterface} from 'node:readline';import {mkdir,writeFile} from 'node:fs/promises';import {pathToFileURL} from 'node:url';
import {LOCAL,need} from '../inputs.mts';import {parseMcpsLine,type McpsStar} from '../mcps/input.mts';
export const HOT_SELECTION={qMaximum:-.4,bvMaximum:.2,vMinimum:18,vMaximum:20,maximumError:.12};
export function hot(s:McpsStar){const [u,b,v]=s.magnitudes;if(u===null||b===null||v===null||s.flag>=20||s.errors.slice(0,3).some(e=>e===null||e>HOT_SELECTION.maximumError))return false;return v>=HOT_SELECTION.vMinimum&&v<HOT_SELECTION.vMaximum&&b-v<HOT_SELECTION.bvMaximum&&u-b-.72*(b-v)<HOT_SELECTION.qMaximum;}
export async function scan(pilot:boolean){const dir=LOCAL+'versions/l29/';await mkdir(dir,{recursive:true});const input=createReadStream(LOCAL+'versions/l23/inputs/table1.dat.gz'),gunzip=input.pipe(createGunzip()),lines=createInterface({input:gunzip,crlfDelay:Infinity}),stars:{ra:number;dec:number;v:number;bv:number;q:number}[]=[],started=performance.now();let rows=0;
 for await(const line of lines){rows++;const u=Number(line.slice(19,25)),b=Number(line.slice(32,38)),v=Number(line.slice(45,51));if(u>0&&b>0&&v>=18&&v<20&&b-v<.2&&u-b-.72*(b-v)<-.4){const s=parseMcpsLine(line);if(hot(s))stars.push({ra:s.ra,dec:s.dec,v,bv:b-v,q:u-b-.72*(b-v)});}if(pilot&&rows===200000)break;}
 lines.close();gunzip.destroy();input.destroy();need(rows===(pilot?200000:24107002)&&stars.length>0,'MCPS scan did not complete the requested rung');const result={pilot,rows,stars,selection:HOT_SELECTION,seconds:(performance.now()-started)/1000,paper:'https://arxiv.org/abs/astro-ph/0110531',photometry:'https://doi.org/10.1086/423910',role:'Faint hot-star density only. U is not used for a pixel color map. V>=18 complements the Gaia G<18 selection; these are different passbands, so this is not a proof of disjoint stars.'};await writeFile(dir+(pilot?'hot-pilot':'hot-stars')+'.json',JSON.stringify(result)+'\n');console.log(JSON.stringify({sentinel:'MCPS_HOT_SCAN_COMPLETE',pilot,rows,selected:stars.length,seconds:result.seconds}));return result;}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await scan(process.argv.includes('--pilot'));
