const tests=fileURLToPath(new URL('./rounds.test.mts',import.meta.url)),mutations=[{file:'young.mts',before:'YOUNG_SIGMA_KPC=.045',after:'YOUNG_SIGMA_KPC=.1',property:'Removing finer catalogue smoothing fails.'},{file:'hot-stars.mts',before:'maximumError:.12',after:'maximumError:1',property:'Removing hot-photometry quality rejects fails.'},{file:'young.mts',before:'*3600<1)return false',after:'*3600<0)return false',property:'Removing Gaia duplicate rejection fails.'},{file:'reuse.mts',before:'&&samePhysicalField(a,b)',after:'&&true',property:'Removing physical-field reuse validation fails.'},{file:'outer.mts',before:'return out;',after:'return readGrade(trial);',property:'Removing nonlinear outer-light conservation fails.'},{file:'gates.mts',before:'<=HARD_COLOR_REGRESSION',after:'<Infinity',property:'Removing the final color retention limit fails.'}],results=[];
for(const m of mutations){const path=fileURLToPath(new URL('./'+m.file,import.meta.url)),source=await readFile(path,'utf8');need(source.includes(m.before),'Removal target missing');try{await writeFile(path,source.replace(m.before,m.after));const r=spawnSync(process.execPath,['--test',tests],{encoding:'utf8',timeout:15000});need(r.status!==0&&r.stdout.includes('not ok'),'Removed property did not fail its behavior test');results.push({property:m.property,failedAsExpected:true});}finally{await writeFile(path,source);}}
