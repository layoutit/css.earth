/** Header-only coverage audit of every cached catalogue H-alpha cutout. */
import {open,readFile,readdir,writeFile} from 'node:fs/promises';import {readFitsHeader,skyProjection} from '@cssearth/fits';import {LOCAL,need} from '../inputs.mts';import {normalizeEquinox} from '../qualify-gas.mts';import {loadObservation} from '../observation.mts';import {PINS} from './pins.mts';import {skyOf} from '../geometry.mts';import {versionDir} from '../sequence-state.mts';
const dir=LOCAL+'versions/l11/inputs/ha/',names=await readdir(dir),o=await loadObservation(8),pins=PINS.filter(p=>p.theme===31).map(p=>({...p,sky:skyOf(o.rayAt(p.x+.5,p.y+.5))})),hits:{pin:string;path:string;pixel:number[];width:number;height:number}[]=[],tiles=new Map<string,{url:string;ra:number;dec:number;width:number;height:number}>();let inspected=0;
for(const name of names){if(name.endsWith('.fits')){const f=await open(dir+name,'r'),buffer=Buffer.alloc(65536);let bytesRead=0;try{bytesRead=(await f.read(buffer,0,buffer.length,0)).bytesRead;}finally{await f.close();}const {header}=readFitsHeader(normalizeEquinox(buffer.subarray(0,bytesRead)).bytes),h={...header};if(['CD1_1','CD1_2','CD2_1','CD2_2'].every(k=>typeof h[k]==='number'))for(const k of ['CDELT1','CDELT2','CROTA1','CROTA2'])delete h[k];const w=Number(h.NAXIS1),height=Number(h.NAXIS2),wcs=skyProjection(h);need(w>0&&height>0,'Invalid cached image dimensions');for(const p of pins){const q=wcs.pixelOf(...p.sky);if(q&&q[0]>=1&&q[1]>=1&&q[0]+1<w&&q[1]+1<height)hits.push({pin:p.id,path:dir+name,pixel:q,width:w,height});}inspected++;}
 if(name.endsWith('.xml')){const xml=await readFile(dir+name,'utf8'),columns=[...xml.matchAll(/<FIELD\b[^>]*\bname="([^"]+)"/gu)].map(m=>m[1]);for(const row of xml.matchAll(/<TR>([\s\S]*?)<\/TR>/gu)){const v=[...row[1].matchAll(/<TD>([\s\S]*?)<\/TD>/gu)].map(c=>c[1].replaceAll('&amp;','&')),r=Object.fromEntries(columns.map((key,i)=>[key,v[i]]));if(!r.access_url?.includes('.ha_sub_r.'))continue;const url=new URL(r.access_url),ref=url.searchParams.get('siaRef');if(!ref)continue;const size=r.im_naxis.trim().split(/\s+/u).map(Number);tiles.set(ref,{url:r.access_url,ra:Number(r.s_ra),dec:Number(r.s_dec),width:size[0],height:size[1]});}}}
const nearest=pins.map(p=>({pin:p.id,ra:p.sky[0],dec:p.sky[1],tiles:Array.from(tiles.values()).sort((a,b)=>Math.hypot((a.ra-p.sky[0])*Math.cos(p.sky[1]*Math.PI/180),a.dec-p.sky[1])-Math.hypot((b.ra-p.sky[0])*Math.cos(p.sky[1]*Math.PI/180),b.dec-p.sky[1])).slice(0,3)}));await writeFile(versionDir(31)+'cached-footprints.json',JSON.stringify({inspected,hits,uniqueTileMetadata:tiles.size,nearest},null,2)+'\n');console.log(JSON.stringify({sentinel:'L31_CACHED_HEADERS_AUDITED',inspected,hits,uniqueTileMetadata:tiles.size,nearest}));
