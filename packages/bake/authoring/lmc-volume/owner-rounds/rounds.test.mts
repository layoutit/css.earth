import {test} from 'node:test';import assert from 'node:assert/strict';import {makeRaster,type Sources} from '../inputs.mts';import {densityFromMembers} from '../gaia-density.mts';import {hot} from './hot-stars.mts';import {uniqueHot,YOUNG_SIGMA_KPC,MCPS_SHARE} from './young.mts';import {PINS,maskPins,measure,score} from './pins.mts';import {mcpsStar} from '../mcps/input.mts';
import {guardPass} from './gates.mts';
import {residualAv} from './reddening.mts';
import {samePhysicalField,requireMaterialOnly} from './reuse.mts';import type {Configuration} from '../sequence-state.mts';
import {conserveOuter} from './outer.mts';import {gradedPrediction,type Grade} from '../grade.mts';
test('MCPS hot selection requires measured U, bounded errors and a unique blue Q branch',()=>{const s=mcpsStar(80,-69,[18.4,19.1,19,19],[.03,.03,.03,.03],0);assert.equal(hot(s),true);assert.equal(hot({...s,magnitudes:[null,19.1,19,19]}),false);assert.equal(hot({...s,magnitudes:[19,19.1,19,19]}),false);assert.equal(hot({...s,errors:[.2,.03,.03,.03]}),false);assert.equal(hot({...s,flag:20}),false);});
test('one arcsecond matching removes Gaia duplicates but keeps distinct MCPS groups',()=>{assert.deepEqual(uniqueHot([{ra:80,dec:-69},{ra:80.01,dec:-69}],[{ra:80,dec:-69}]),[{ra:80.01,dec:-69}]);});
test('finer adopted smoothing preserves extra spatial structure and unit light',()=>{assert.equal(YOUNG_SIGMA_KPC,.045);assert.equal(MCPS_SHARE,.2);const r=makeRaster(32,10),sources:Sources={warp:r,dust:r,young:[r,r,r],youngCoverage:r,youngFraction:1,oldColor:[1,1,1],gas:r,metadata:{}},stars=[{ra:80.5,dec:-69.5},{ra:80.55,dec:-69.52}],fine=densityFromMembers(stars,sources,256,10,undefined,YOUNG_SIGMA_KPC),broad=densityFromMembers(stars,sources,256,10,undefined,.1);assert.ok(Math.max(...fine.values)>Math.max(...broad.values)*1.5);assert.ok(Math.abs(fine.values.reduce((a,b)=>a+b,0)*(20/256)**2-1)<1e-6);});
test('native owner windows include every high-pass neighbor and retain guard pins',()=>{assert.equal(PINS.filter(p=>p.theme===29).length,7);assert.equal(PINS.filter(p=>p.theme===30).length,2);assert.equal(PINS.filter(p=>p.theme===31).length,3);const mask=maskPins();for(const p of PINS)assert.equal(mask[(p.y+15)*512+p.x+15],1);const constant=new Float64Array(512*384*3).fill(.4),m=measure(constant,PINS[0]);assert.ok(m.texture<1e-12);assert.equal(score(m,m,true),0);constant[(PINS[0].y*512+PINS[0].x)*3+2]=.8;assert.ok(measure(constant,PINS[0]).texture>m.texture);});
test('a fitting penalty cannot override the completed-image retention guard',()=>{const p=measure(new Float64Array(512*384*3).fill(.4),PINS[0]);assert.equal(guardPass(p,p,{...p,rg:Math.exp(.03)}),true);assert.equal(guardPass(p,p,{...p,rg:Math.exp(.04)}),false);});
test('OGLE disagreement adds only a positive missing foreground column, without rescaling native lanes',()=>{assert.ok(Math.abs(residualAv(.3,.2,.98)-.104)<1e-12);assert.equal(residualAv(.1,.3,.5),0);assert.throws(()=>residualAv(-.1,.3,.5));});
test('linear projections may be reused for a global grade but never for changed physical fields',()=>{const parent:Configuration={version:29,parent:28,densityVersion:29,barGeometry:null,colors:[[1,1,1]],change:'base',details:{}},next:Configuration={...parent,version:30,parent:29,change:'grade only',details:{referenceProjectionVersion:29}};assert.equal(samePhysicalField(parent,next),true);assert.doesNotThrow(()=>requireMaterialOnly(next,parent));assert.throws(()=>requireMaterialOnly({...next,dustStrength:1.2},parent));assert.throws(()=>requireMaterialOnly({...next,densityVersion:30},parent));assert.throws(()=>requireMaterialOnly({...next,details:{}},parent));});
test('old-population color changes conserve outer light after the actual nonlinear tone curve',()=>{const planes=Array.from({length:5},()=>new Float64Array(6));planes[0].set([.01,.007,.004,.006,.002,.001]);const basis={width:2,height:1,dustGain:1,planes},g:Grade={coefficients:Array.from({length:4},()=>[1,1,1]),dustStrength:1,dustTint:[1,1,1],stretch:20,saturation:.5,score:0},trial={...g,coefficients:g.coefficients.map(v=>[...v] as [number,number,number])};trial.coefficients[0]=[.5,2,.4];const next=conserveOuter(basis,g,trial),total=(v:Grade)=>gradedPrediction(basis,v).reduce((a,b)=>a+b,0);assert.ok(Math.abs(total(next)/total(g)-1)<1e-6);assert.ok(Math.abs(next.coefficients[0][0]/next.coefficients[0][1]-.25)<1e-10);});
