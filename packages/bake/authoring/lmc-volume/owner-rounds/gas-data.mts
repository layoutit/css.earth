/** Qualified cached continuum-subtracted H-alpha; unknown footprints stay unknown. */
import {writeFile} from 'node:fs/promises';import {LOCAL,json,array,rec,need} from '../inputs.mts';import {readGas} from '../qualify-gas.mts';import {loadObservation} from '../observation.mts';import {skyOf} from '../geometry.mts';import {versionDir} from '../sequence-state.mts';import {PINS} from './pins.mts';
export async function gasInputs(){const rows=array(await json(LOCAL+'versions/inputs/gas/index.json')),out=[];for(const value of rows){const r=rec(value);if(typeof r.file!=='string')continue;need(typeof r.name==='string','Gas field lacks name');const source=await readGas(r.file);out.push({name:r.name,...source});}return out;}
export function gasAt(source:Awaited<ReturnType<typeof readGas>>,ra:number,dec:number){const p=source.projection.pixelOf(ra,dec);if(!p)return null;const x=Math.floor(p[0]),y=Math.floor(p[1]);if(x<0||y<0||x+1>=source.image.width||y+1>=source.image.height)return null;const u=p[0]-x,v=p[1]-y,ids=[y*source.image.width+x,y*source.image.width+x+1,(y+1)*source.image.width+x,(y+1)*source.image.width+x+1],values=ids.map(i=>source.image.values[i]);if(!values.every(Number.isFinite))return null;return(values[0]*(1-u)+values[1]*u)*(1-v)+(values[2]*(1-u)+values[3]*u)*v;}
const o=await loadObservation(8),inputs=await gasInputs(),pins=PINS.filter(p=>p.theme===31).map(pin=>{const [ra,dec]=skyOf(o.rayAt(pin.x+.5,pin.y+.5));return{pin,ra,dec,samples:inputs.map(s=>({name:s.name,value:gasAt(s,ra,dec),p05:s.summary.p05,p50:s.summary.p50,p99:s.summary.p99,center:s.summary.center,dimensions:[s.image.width,s.image.height]}))};});await writeFile(versionDir(31)+'gas-diagnosis.json',JSON.stringify({sources:inputs.map(s=>({name:s.name,...s.summary})),pins},null,2)+'\n');console.log(JSON.stringify({sentinel:'L31_GAS_DIAGNOSED',pins}));
