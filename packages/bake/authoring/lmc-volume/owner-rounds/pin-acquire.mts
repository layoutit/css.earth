/** Bounded DeMCELS SIA cutouts at the missing diagnostic positions. No shared FITS edits. */
import {spawn} from 'node:child_process';import {mkdir,readFile,writeFile,stat,unlink} from 'node:fs/promises';import {versionDir} from '../sequence-state.mts';import {loadObservation} from '../observation.mts';import {skyOf} from '../geometry.mts';import {need,json,rec,array} from '../inputs.mts';import {readGas} from '../qualify-gas.mts';import {PINS} from './pins.mts';
const pilot=process.argv.includes('--pilot'),dir=versionDir(31)+'inputs/';await mkdir(dir,{recursive:true});
async function download(url:string,path:string,cap:number){const bytes=await new Promise<Buffer>((resolve,reject)=>{const child=spawn('curl',['--fail','--location','--max-time','60','--silent','--show-error',url],{stdio:['ignore','pipe','pipe']}),chunks:Buffer[]=[],errors:Buffer[]=[];let count=0,overflow=false;child.stdout.on('data',(v:Buffer)=>{count+=v.length;if(count>cap){overflow=true;child.kill('SIGTERM');}else chunks.push(v);});child.stderr.on('data',(v:Buffer)=>{if(errors.reduce((a,b)=>a+b.length,0)<8192)errors.push(v);});child.on('error',reject);child.on('close',code=>{if(code!==0||overflow)reject(new Error(overflow?'DeMCELS byte budget exceeded':'DeMCELS transfer failed: '+Buffer.concat(errors).toString('utf8')));else resolve(Buffer.concat(chunks));});});await writeFile(path,bytes);return bytes;}
const o=await loadObservation(8),results=[];for(const pin of PINS.filter(p=>p.theme===31&&(!process.argv.includes('--i4-only')||p.id==='I4')).slice(0,pilot?1:3)){const [ra,dec]=skyOf(o.rayAt(pin.x+.5,pin.y+.5)),name=pin.id+(pilot?'-pilot':''),path=dir+name+'.fits',query=`https://datalab.noirlab.edu/sia/demcels_dr1?POS=${ra},${dec}&SIZE=0.1&FORMAT=image/fits`,xml=await readFile(dir+pin.id+'-sia.xml','utf8').catch(async()=>{const b=await download(query,dir+pin.id+'-sia.xml',1024**2);return b.toString('utf8');}),decode=(s:string)=>s.replaceAll('&amp;','&').replaceAll('&lt;','<').replaceAll('&gt;','>'),columns=[...xml.matchAll(/<FIELD\b[^>]*\bname="([^"]+)"/gu)].map(m=>m[1]),rows=[...xml.matchAll(/<TR>([\s\S]*?)<\/TR>/gu)].map(m=>[...m[1].matchAll(/<TD>([\s\S]*?)<\/TD>/gu)].map(c=>decode(c[1])));let candidates=rows.map(v=>Object.fromEntries(columns.map((key,i)=>[key,v[i]]))).filter(v=>v.access_url?.includes('.ha_sub_r.'));if(candidates.length===0&&process.argv.includes('--cached-metadata'))candidates=array(rec(array(rec(await json(versionDir(31)+'cached-footprints.json')).nearest).map(rec).find(v=>v.pin===pin.id)).tiles).map(v=>{const r=rec(v);need(typeof r.url==='string','Missing cached tile URL');return{access_url:r.url};});need(candidates.length>0,'No H-alpha tile at '+pin.id);let done=false;
 for(const c of candidates.slice(0,3)){try{const url=new URL(c.access_url);url.searchParams.set('POS',`${ra},${dec}`);url.searchParams.set('SIZE',pilot?'0.06,0.06':'0.3,0.3');const request=url.href.replaceAll('%2C',',');if(!await stat(path).catch(()=>null))await download(request,path,64*1024**2);const source=await readGas(path),p=source.projection.pixelOf(ra,dec);need(p&&p[0]>=0&&p[1]>=0&&p[0]<source.image.width&&p[1]<source.image.height,'Cutout misses requested pin');need(Number.isFinite(source.image.values[Math.round(p[1])*source.image.width+Math.round(p[0])]),'No finite H-alpha data at requested pin');const result={pin,ra,dec,request,query,pilot,sourceUrl:'https://datalab.noirlab.edu/data/demcels',...source.summary};await writeFile(path+'.qualification.json',JSON.stringify(result,null,2)+'\n');results.push(result);console.log(JSON.stringify({sentinel:'L31_PIN_HALPHA_QUALIFIED',pin:pin.id,pilot,width:source.image.width,height:source.image.height,p05:source.summary.p05,p50:source.summary.p50,p99:source.summary.p99}));done=true;break;}catch(error){console.log(JSON.stringify({pin:pin.id,rejected:String(error)}));await unlink(path).catch(()=>undefined);}}
 need(done,'No qualified H-alpha cutout at '+pin.id);}
const complete=pilot?results:await Promise.all(PINS.filter(p=>p.theme===31).map(p=>json(dir+p.id+'.fits.qualification.json')));await writeFile(dir+(pilot?'pilot':'pin-inputs')+'.json',JSON.stringify(complete,null,2)+'\n');console.log(JSON.stringify({sentinel:'L31_PIN_ACQUISITION_COMPLETE',pilot,count:complete.length}));
