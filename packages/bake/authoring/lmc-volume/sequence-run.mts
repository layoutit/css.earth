  const legend=version===17?['Only blue population structure changes.','Gaia DR3 young proper-motion members.','Gaussian smoothing sigma: 100 pc.','Young layer sigma stays 150 pc.','One global Gaia population gain.','One global Bica-association gain.','Individual age spectra stay fixed.','Missing association ages are adopted.','No new object geometry or shapes.','Bar geometry and color stay at l15.','Outskirts and dust stay fixed.','No photographic spatial transfer.']:version===16?['Only bar population color changes.','VMC regional star-formation histories.','Age and metallicity mix: BC03 BVR.','One bar RGB grade for every view.','No spatial photo color is copied.','l15 bar geometry is retained.','The same 367 pc bar height.','All other population colors fixed.','All catalogue luminosities fixed.','Gaia smoothing remains 200 pc.','Outskirts and dust remain fixed.','Metallicity conversion is conditional.']:['Only bar geometry changes.','Rathore sky PA: 121.26 degrees.','Full ellipsoid projection is checked.','Kacharov intrinsic b/a: 0.38.','Bar height stays 367 pc.','The recorded offset is retained.','Exact ellipse centre is unavailable.','Disc plane and warp are unchanged.','All parent colors stay fixed.','All catalogue objects stay fixed.','Gaia smoothing remains 200 pc.','No image-fitted geometry.'];
  if(!tiny)await finishSheet(out,version,legend);
  const result={rung:tiny?'tiny':'small',size,seconds:(performance.now()-started)/1000,grade,residuals,sceneControls:sceneControls(scene),parent,change:cfg.change,changeDiagnostics};await write(out+'result.json',result);await write(out+'object-brightness.json',scene.owners.map((v,i)=>({...v,amplitude:amplitudes[i]})));runs.push(result);await write(dir+'rungs.json',runs);console.log(JSON.stringify({sentinel:`L${version}_RUNG_COMPLETE`,rung:result.rung,seconds:result.seconds}));if(process.argv.includes('--tiny-only'))break;
 }
 if(runs.length===2){const source=ROOT+`src/objects/lmc-volume/source/preparation/l${version}/`;await mkdir(source,{recursive:true});const old=ROOT+`src/objects/lmc-volume/source/preparation/l${parent}/`;await copyFile(old+'frame.json',source+'frame.json');await write(source+'lineage.json',{...rec(await json(old+'lineage.json')),parentModel:`src/objects/lmc-volume/source/preparation/l${parent}/`,change:cfg.change,details:cfg.details});await write(source+'recipe.json',{generator:'packages/bake/authoring/lmc-volume/sequence-run.mts',generatorArguments:[`--version=${version}`,`--parent=${parent}`],configuration:cfg,retained:'Pending measured residual and visual comparison'});await write(source+'fit.json',{...runs[1],geometryParametersFitted:0,pixelParameters:0,calibration:version===15?'Frozen parent; geometry derived from publications only':version===16?'Only three global bar RGB coefficients fitted; other parent calibration frozen':'Only two global blue population gains fitted; parent component colors, display curve and other luminosities frozen'});await write(source+'field.json',{...scene.metadata,configuration:cfg,workingGeometry:`src/objects/lmc-volume/.local/versions/l${version}/structure.json`});await write(source+'provenance.json',{rungs:runs,slabs:false,fullFit:false});}
