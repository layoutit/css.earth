 const dir=versionDir(version);await mkdir(dir,{recursive:true});const {scene,cfg:before}=await loadParent(parent),shape=measuredBar(BAR_SIGMA_Z),cfg:Configuration={...before,version,parent,densityVersion:version,barGeometry:shape,change:'Bar geometry only: full projected covariance matches measured position angle and Gaussian scale.',details:{rathore:'https://arxiv.org/html/2410.18182',kacharov:'https://arxiv.org/html/2410.05374',before:projectedBar(legacyBar(BAR_SIGMA_Z)),after:projectedBar(shape),offsetStatus:'Magnitude and recorded Figure 8 direction preserved. Exact bar-ellipse centre is not tabulated; the existing Fourier-centre proxy is retained, with approximately 0.1 kpc positional uncertainty.',warpStatus:'Bar remains a flat ellipsoid in the disc plane. The Oden warp starts beyond 4.5 kpc and does not deform its core.'}};
 const previousDensity=scene.youngDensity;
 if(version===15)scene.barGeometry=shape;else if(version===16){scene.barGeometry=before.barGeometry??legacyBar(BAR_SIGMA_Z);const population=await makeBarPopulation(scene);scene.colors[1]=population.color;cfg.barGeometry=scene.barGeometry;cfg.colors=scene.colors.map(v=>[...v]);cfg.change='Bar color only: VMC age/metallicity population mixture and one global RGB grade.';cfg.details=population.metadata;await write(dir+'bar-population.json',population);}else{cfg.barGeometry=before.barGeometry;cfg.change='Blue structure only: Gaia smoothing from 200 to 100 pc, with global Gaia and young Bica-association gains.';cfg.details={gaiaPaper:'https://arxiv.org/html/2012.01771',bicaPaper:'https://doi.org/10.1111/j.1365-2966.2008.13612.x',smoothingSigmaKpc:BLUE_SMOOTHING_KPC,layerSigmaKpc:.15,associationSelection:'Bica associations in young component, measured age below 400 Myr or the existing adopted 30 Myr spectrum when age is unknown.',associations:scene.owners.filter(youngAssociation).length,associationsWithoutMeasuredAge:scene.owners.filter(o=>youngAssociation(o)&&o.logAge===null).length,gainBounds:[.5,2],photoStructureUsed:false};}
 await saveConfiguration(cfg,before.densityVersion);if(version===17){const density=await makeGaiaDensity(scene.sources,{directory:dir,sigmaKpc:BLUE_SMOOTHING_KPC});scene.youngDensity=density.map;cfg.details.gaiaMetadata=density.metadata;await write(dir+'configuration.json',cfg);}await write(dir+'structure.json',{objects:scene.objects,dust:scene.dust,owners:scene.owners,metadata:scene.metadata,barGeometry:cfg.barGeometry,colors:scene.colors});const geometry=JSON.stringify([scene.objects,scene.dust]),runs=[];
