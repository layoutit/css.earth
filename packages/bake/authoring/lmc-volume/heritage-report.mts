/** Report l19 even when its frozen diagnostic images fail the scientific acceptance test. */
import {readFile,writeFile} from 'node:fs/promises';
import sharp from 'sharp';
import {ROOT,json,rec,num,array,need} from './inputs.mts';
import {versionDir} from './sequence-state.mts';
import {finishSheet} from './catalogue-run.mts';
const dir=versionDir(19),rungs=array(await json(dir+'rungs.json')).map(rec),result=rec(await json(dir+'result.json')),old=rec(await json(versionDir(18)+'result.json')),texture=rec(await json(dir+'bar-contrast.json')),visual=rec(await json(dir+'visual-review.json')),cfg=rec(await json(dir+'configuration.json')),dust=rec(await json(dir+'dust-column.json'));
need(rungs.length===2&&num(result.size)===512,'Both requested image rungs must finish');need(typeof visual.coherent==='boolean'&&typeof visual.fineTextureImproved==='boolean','A completed visual inspection is required');
const failures=[];if(rungs.some(r=>r.rmsPassed!==true))failures.push('The tiny RMS guard failed');if(texture.powerCloser!==true)failures.push('bar contrast power is not closer to the photo');if(!visual.fineTextureImproved)failures.push('the fine dark texture does not visibly improve');if(!visual.coherent)failures.push('the side views are incoherent');
const retained=failures.length===0&&rec(cfg.details).diagnosticRejected!==true,decision={version:19,parent:18,retained,nextParent:retained?19:18,reason:retained?'The fixed RMS, contrast and visual criteria pass.':failures.join('; ')+'. The 512 px views and crop are frozen diagnostic evidence; retain l18.',nativeRmsPassed:result.rmsPassed,contrastPowerCloser:texture.powerCloser,visual,thresholdRelativeRms:.01};
const prior=rec(old.residuals),current=rec(result.residuals),f=(v:unknown)=>num(v).toFixed(6),rel=(a:unknown,b:unknown)=>(100*(num(a)/num(b)-1)).toFixed(2)+'%',row=(key:string,label:string)=>`| ${label} | ${f(prior[key])} | ${f(current[key])} | ${rel(current[key],prior[key])} |`,p=rec(texture.photo),a=rec(texture.l18),b=rec(texture.l19),norm=rec(dust.normalization);
const oldStructure=rec(await json(versionDir(18)+'structure.json')),structure=rec(await json(dir+'structure.json')),oldGrade=rec(old.grade),grade=rec(result.grade),same=(a:unknown,b:unknown)=>JSON.stringify(a)===JSON.stringify(b);for(const key of ['objects','dust','owners','colors','barGeometry','innerDiscColor'])need(same(oldStructure[key],structure[key]),'l19 changed frozen '+key);for(const key of ['coefficients','stretch','saturation','dustTint'])need(same(oldGrade[key],grade[key]),'l19 changed a light-source grade');for(const file of ['young-density.f32le','object-brightness.json','object-shapes.json'])need((await readFile(versionDir(18)+file)).equals(await readFile(dir+file)),'l19 changed '+file);await writeFile(dir+'preservation.json',JSON.stringify({emissionGeometryAndLuminositiesUnchanged:true,colorsAndToneCurveUnchanged:true,gaiaMapUnchanged:true,dustOnly:true},null,2)+'\n');
