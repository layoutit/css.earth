/** Cantat-Gaudin et al. 2023 empirical parent-catalogue selection function. */
import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {pathToFileURL} from 'node:url';
import {readFitsHdus,assertUnscaledFitsTable} from '@cssearth/fits';
import {LOCAL,need,num} from './inputs.mts';
export const L21=LOCAL+'versions/l21/';
export const COMPLETENESS_PAPER='https://doi.org/10.1051/0004-6361/202244784';
export function tcgCompleteness(g:number,m10:number){need(Number.isFinite(g)&&Number.isFinite(m10)&&m10>10&&m10<25,'Invalid completeness coordinate');const lim=20.519369625540833,delta=Math.max(0,m10-lim),g0=.9848761394197864*m10+.6473155510230146+(.6929084598209412-.9848761394197864)*delta,slope=-.003935382139847386*m10+.2230529402297744+(-.09331877468160235+.003935382139847386)*delta,shape=.006144107896473064*m10+.03681705933744438+(.35140564525722895-.006144107896473064)*delta;need(slope>0&&shape>0,'Completeness model outside calibration');return 1-(.5*(Math.tanh((g-g0)/slope)+1))**shape;}
export function gaiaPixel12(sourceId:string){need(/^\d{10,20}$/u.test(sourceId),'Invalid source identity');const p=Number(BigInt(sourceId)/34359738368n);need(Number.isSafeInteger(p)&&p>=0&&p<12*4**12,'Invalid Gaia HEALPix identity');return p;}
export async function loadCompleteness(){const path=L21+'inputs/allsky_uniq_10-current.fits',bytes=await readFile(path),hdus=readFitsHdus(bytes);await mkdir(L21,{recursive:true});await writeFile(L21+'inputs/completeness-hdus.json',JSON.stringify(hdus.map(h=>({header:h.header,dimensions:h.dimensions,dataOffset:h.dataOffset,dataBytes:h.dataBytes})),null,2)+'\n');const table=hdus.find(h=>h.header.XTENSION==='BINTABLE');need(table,'Missing completeness table');assertUnscaledFitsTable(table.header);need(table.header.TFIELDS===2&&table.header.TTYPE1==='UNIQ'&&table.header.TFORM1==='K'&&table.header.TTYPE2==='M10'&&table.header.TFORM2==='E'&&table.header.NAXIS1===12&&table.header.PCOUNT===0,'Unexpected published completeness table schema');const count=num(table.header.NAXIS2),m10=new Float32Array(12*4**10),levels=new Uint8Array(m10.length),invalid=new Uint8Array(m10.length);let minimum=Infinity,maximum=-Infinity,conflicts=0;for(let r=0;r<count;r++){const offset=table.dataOffset+r*12,uniq=Number(bytes.readBigInt64BE(offset)),value=bytes.readFloatBE(offset+8),level=Math.floor(Math.log2(uniq/4)/2),pixel=uniq-4*4**level,span=4**(10-level),start=pixel*span;need(Number.isSafeInteger(uniq)&&level>=0&&level<=10&&Number.isInteger(start)&&start>=0&&start+span<=m10.length&&value>10&&value<25,'Invalid NUNIQ completeness row');for(let i=start;i<start+span;i++){if(levels[i]!==0&&levels[i]===level+1&&m10[i]!==value){if(!invalid[i])conflicts++;invalid[i]=1;}if(levels[i]<=level+1){m10[i]=value;levels[i]=level+1;}}minimum=Math.min(minimum,value);maximum=Math.max(maximum,value);}const summary={product:'GaiaUnlimited allsky_uniq_10.fits',url:'https://zenodo.org/records/21444145/files/allsky_uniq_10.fits',bytes:bytes.length,rows:count,ordering:'NESTED, ICRS, NUNIQ mixed orders, expanded exactly to order 10',minimum,maximum,conflictingOrder10Cells:conflicts,uncoveredOrder10Cells:levels.reduce((s,v)=>s+Number(v===0),0),paper:COMPLETENESS_PAPER,scope:'Parent Gaia catalogue with position and G, not the extra BP/RP or astrometry cuts.'};await writeFile(L21+'inputs/completeness-source.json',JSON.stringify(summary,null,2)+'\n');return{m10,levels,summary,atStar:(id:string)=>{const i=Math.floor(gaiaPixel12(id)/16);need(levels[i]>0&&!invalid[i],`Invalid local M10 cell ${i}`);return m10[i];}};}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await loadCompleteness();
