/** Same Gaia tracers and inclusion probabilities as l21, with a finer central KDE. */
import {readFile,writeFile} from 'node:fs/promises';
import {LOCAL,json,rec,num,at,makeRaster,need,type Raster} from './inputs.mts';
import {loadOld,insidePolygon,RC_POLYGON} from './gaia-old.mts';import {loadCompleteness,tcgCompleteness} from './completeness.mts';
import {gaiaWarpLocator} from './gaia-plane.mts';import {densityFromMembers} from './gaia-density.mts';
import {splitOldDensity,saveGaiaPoints,densityMoments} from './gaia-old-model.mts';import {smoothstep} from './model.mts';import type {CatalogueScene} from './catalogue-scene.mts';
export const L22=LOCAL+'versions/l22/';
export function lowGrain(population:NonNullable<CatalogueScene['oldPopulation']>,parentFractions:readonly number[]){population.oldFraction=parentFractions[0]/3;population.youngFraction=parentFractions[1]/3;}
export function centralBlend(fine:Raster,parent:Raster,center:readonly number[]):Raster{const map=makeRaster(fine.n,fine.half);map.mask.fill(1);let sum=0;for(let y=0;y<map.n;y++)for(let x=0;x<map.n;x++){const px=((x+.5)/map.n*2-1)*map.half,py=((y+.5)/map.n*2-1)*map.half,w=1-smoothstep((Math.hypot(px-center[0],py-center[1])-1.5)/1.5),i=y*map.n+x;map.values[i]=w*fine.values[i]+(1-w)*at(parent,px,py);sum+=map.values[i];}const scale=sum*(2*map.half/map.n)**2;for(let i=0;i<map.values.length;i++)map.values[i]/=scale;return map;}
export async function sharpenOld(scene:CatalogueScene){need(scene.oldPopulation&&scene.barGeometry,'Missing accepted l21 stellar density');const {density,points}=await loadOld(),stars=[...points,...density.filter(s=>s.g>=18)],survey=await loadCompleteness(),raw=await readFile(L22+'../l21/crowding-1.f32le'),mask=await readFile(L22+'../l21/crowding-1.mask.u8'),crowd:Raster={n:512,half:10,values:new Float32Array(Uint8Array.from(raw).buffer),mask:Uint8Array.from(mask)},locate=gaiaWarpLocator(scene.sources),weights=Float64Array.from(stars,s=>{const p=locate(s.ra,s.dec),r=Math.hypot(p[0],p[1]);let probability=r<9?tcgCompleteness(s.g,survey.atStar(s.id)):1;if(r<9&&s.g>=18&&s.bp!==null&&s.rp!==null&&insidePolygon(s.bp-s.rp,s.g,RC_POLYGON)){const q=at(crowd,p[0],p[1]);if(q>0)probability=Math.min(probability,q);}need(probability>.005&&probability<=1,'Invalid retained l21 probability');return 10**(-.4*(s.g-20))*(s.g<18?1:18.11709771)/probability;});
 const old=scene.oldPopulation,parent=makeRaster(old.disc.n,old.disc.half);parent.mask.fill(1);for(let i=0;i<parent.values.length;i++)parent.values[i]=old.disc.values[i]+old.bar.values[i];const replay=densityFromMembers(stars,scene.sources,512,10,undefined,.1,weights),error=replay.values.reduce((a,v,i)=>Math.max(a,Math.abs(v-parent.values[i])),0);need(error<1e-7,'l21 completeness weights do not replay');
 const fine=densityFromMembers(stars,scene.sources,1024,10,undefined,.05,weights),total=centralBlend(fine,parent,scene.barGeometry.center),split=splitOldDensity(total),pointField={...old.points,rgb:old.points.rgb.slice()},sums=[0,0,0,0],budget=[split.discMass*1.2842040336717868,split.barMass*1.2842040336717868,0,.15];for(let i=0;i<pointField.count;i++)sums[pointField.components[i]]+=pointField.rgb[i*3+1];for(let i=0;i<pointField.count;i++)if(pointField.components[i]!==3)for(let c=0;c<3;c++)pointField.rgb[i*3+c]*=budget[pointField.components[i]]/sums[pointField.components[i]];scene.oldPopulation={...old,disc:split.disc,bar:split.bar,points:pointField};
 const metadata={...rec(await json(L22+'../l21/old-population.json')),version:22,parent:21,n:total.n,halfKpc:total.half,barMass:split.barMass,discMass:split.discMass,barMeasured:densityMoments(split.bar),smoothingSigmaKpc:.05,contrast:{centralSigmaPc:50,outerSigmaPc:100,fullFineRadiusKpc:1.5,transitionEndKpc:3,centre:'Retained published bar centre',maximumL21ReplayError:error,source:'Identical l21 Gaia stars, G weights and inclusion probabilities; no image in density.'}};await writeFile(L22+'old-population.json',JSON.stringify(metadata,null,2)+'\n');for(const [name,map] of [['old-disc',split.disc],['old-bar',split.bar]] as const)await writeFile(L22+name+'.f32le',Buffer.from(map.values.buffer));await saveGaiaPoints(L22,pointField);return metadata;
}
