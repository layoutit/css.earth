/** Validate and retain l12 geometry exactly; l13 replaces only its population map. */
import {readFile,copyFile,writeFile} from 'node:fs/promises';
import assert from 'node:assert/strict';
import {LOCAL,json,rec,array,num,numbers,need,loadSources,type Raster} from './inputs.mts';
import {buildCatalogueScene,type CatalogueScene,type Owner} from './catalogue-scene.mts';
import {volumeObject,type VolumeObject,type Component} from './catalogue-volume.mts';
import {makeGaiaDensity} from './gaia-density.mts';
import {L13} from './gaia-young.mts';
import type {V3} from './geometry.mts';
const str=(v:unknown)=>{need(typeof v==='string','Expected saved identity');return v;},vector=(v:unknown):V3=>{const a=numbers(v,3);return[a[0],a[1],a[2]];};
function component(v:unknown):Component{const n=num(v);switch(n){case 0:case 1:case 2:case 3:case 4:return n;default:throw Error('Invalid saved component');}}
export function readVolumeObject(value:unknown):VolumeObject {const r=rec(value),kind=r.kind;need(kind==='ball'||kind==='shell'||kind==='filament'||kind==='dust'||kind==='dust-tent','Invalid saved primitive');const b=array(r.basis);need(b.length===3,'Invalid saved basis');return volumeObject({id:str(r.id),owner:str(r.owner),kind,component:component(r.component),center:vector(r.center),basis:[vector(b[0]),vector(b[1]),vector(b[2])],axes:vector(r.axes),inner:num(r.inner),color:vector(r.color),weight:num(r.weight),source:str(r.source),...(r.halfSpace?{halfSpace:vector(r.halfSpace)}:{})});}
function readOwner(value:unknown):Owner {const r=rec(value);need(typeof r.measuredAge==='boolean','Invalid saved age status');return{id:str(r.id),kind:str(r.kind),component:component(r.component),prior:num(r.prior),maximum:num(r.maximum),measuredAge:r.measuredAge,logAge:r.logAge===null?null:num(r.logAge),aliases:array(r.aliases).map(str)};}
export async function loadFrozenL12():Promise<CatalogueScene>{const saved=rec(await json(LOCAL+'versions/l12/structure.json')),sources=await loadSources(512,20,false),base=await buildCatalogueScene(sources),objects=array(saved.objects).map(readVolumeObject),dust=array(saved.dust).map(readVolumeObject),owners=array(saved.owners).map(readOwner),metadata=rec(saved.metadata),normalization=rec(metadata.dustNormalization);assert.deepEqual(objects,saved.objects);assert.deepEqual(dust,saved.dust);assert.deepEqual(owners,saved.owners);
 return{...base,objects,dust,owners,metadata,dustArea:num(normalization.area),molecularFraction:num(normalization.molecularFraction),youngOwner:'SMASH-diffuse-young'};
}
export async function oldPopulationMap():Promise<Raster>{const meta=rec(await json(LOCAL+'versions/l12/young-density.json')),bytes=await readFile(LOCAL+'versions/l12/young-density.f32le'),n=num(meta.n),half=num(meta.halfKpc);need(Number.isInteger(n)&&bytes.length===n*n*4,'Invalid frozen population map');return{n,half,values:new Float32Array(Uint8Array.from(bytes).buffer),mask:new Uint8Array(n*n).fill(1)};}
export async function buildGaiaScene():Promise<CatalogueScene>{const scene=await loadFrozenL12(),population=await makeGaiaDensity(scene.sources);scene.youngDensity=population.map;const owner=scene.owners.find(o=>o.kind==='population');need(owner,'l12 population owner missing');owner.id='Gaia-diffuse-young';owner.aliases=['Gaia DR3 Young 1 + Young 2'];scene.youngOwner=owner.id;scene.metadata={...scene.metadata,geometrySource:'Frozen l12 objects, disc, bar, warp and dust; only diffuse young density replaced by Gaia DR3.',hybrid:{...rec(scene.metadata.hybrid),youngPopulation:population.metadata},preservation:'Every catalogue primitive, dust cloud and catalogue owner is structurally identical to the saved l12 model; the population owner alone is renamed.'};await copyFile(LOCAL+'versions/l12/object-shapes.json',L13+'object-shapes.json');await writeFile(L13+'preservation.json',JSON.stringify({catalogueGeometryMatchesL12:true,dustGeometryMatchesL12:true,objects:scene.objects.length,dustClouds:scene.dust.length,catalogueOwners:scene.owners.length-1,onlyPhysicalChange:'Diffuse young density from Gaia DR3'},null,2)+'\n');return scene;}
