/** Assemble local image evidence and synchronize the version-owned records. */
import {writeFile,readFile,cp,stat} from 'node:fs/promises';
import sharp from 'sharp';
import {LOCAL,json,rec,array,num,numbers,need} from './inputs.mts';
import {readGrade,componentSettings} from './grade.mts';
import {record} from './grade-run.mts';
const out=`${LOCAL}versions/`,metadata=rec(await json(`${out}inputs/graded-source-summary.json`)),native=rec(await json(`${out}inputs/native-summary.json`));
metadata.nativeStars=native;
metadata.limitations=array(metadata.limitations).filter(v=>typeof v==='string'&&!v.startsWith('Young-population values')&&!v.startsWith('SMASH selection')&&!v.startsWith('DeMCELS still'));
metadata.nativePopulation='The VMC age-derived young fraction is global. Native SMASH astrometry supplies its spatial distribution, without clipping to VMC region polygons. This extrapolates the age budget outside VMC coverage.';
metadata.gasDepth='DeMCELS samples are lifted along their measured Earth rays through the conditional thin layer. This preserves their known angular structure; individual depths are not measured.';
await writeFile(`${out}inputs/graded-source-summary.json`,JSON.stringify(metadata,null,2)+'\n');
const rows=[],panels=[];
for(const stage of [5,6,7]){
  const dir=`${out}l${stage}`,v=rec(await json(`${dir}/grade.json`)),grade=readGrade(v.grade),residuals=rec(v.residuals),rungs=array(v.rungs),tiny=rec(rungs[0]),small=rec(rungs[1]);
  need((await sharp(`${dir}/sheet.png`).metadata()).width===1536,'Final 512-pixel sheet missing');
  await record(stage,grade,rungs,{metadata,nativeStars:{metadata:native}},residuals);
  const components=rec(componentSettings(grade));
  const details=Object.entries(components).map(([name,value])=>{const c=rec(value),t=numbers(c.rgbTint,3);return `| ${name} | ${num(c.gain).toFixed(5)} | ${t.map(v=>v.toFixed(4)).join(', ')} |`;}).join('\n');
  let note=(await readFile(`${dir}/notes.md`,'utf8')).split('\n## Global calibration')[0];note+=`\n## Global calibration\n\n| Component | Gain | RGB tint |\n| --- | --- | --- |\n${details}\n\nThe tint is mean-normalized for emission and green-normalized for attenuation. Stretch is ${grade.stretch.toFixed(3)} and saturation is ${grade.saturation.toFixed(3)}. Dust is inactive in l5.\n\nThe final polish minimizes squared relative sRGB error plus 0.15 times squared linear RGB error and a 0.25-weighted global log-flux penalty, all on training pixels. Held-out pixels are excluded. Geometry and data templates are fixed.\n\nThe tiny fit took ${num(tiny.seconds).toFixed(2)} seconds and the small fit took ${num(small.seconds).toFixed(2)} seconds, including exact-render verification. These fit times exclude preview rendering and the final 512-pixel views. The 512-pixel views are renders, not higher-resolution fits.\n\nSurvey-shaped boundaries remain visible. Catalogue membership, completeness and dust-support artifacts remain unqualified. The northern extension is present, but a convincing northern spiral arm is not established. Conditional depth spreads structures in outside views. This is not an accepted physical or visual model.\n`;
  await writeFile(`${dir}/notes.md`,note);
  rows.push({stage,rms:num(residuals.heldoutRelativeRms),light:num(residuals.totalLightDifferencePercent),tiny:num(tiny.seconds),small:num(small.seconds),dust:stage>=6?grade.dustStrength:null,annuli:numbers(residuals.annularDifferencePercent),colors:array(residuals.channelShareDifferencePercentagePoints)});
  panels.push(await sharp(`${dir}/sheet.png`).png().toBuffer());
}
const h=(await sharp(panels[0]).metadata()).height;need(typeof h==='number'&&h>0,'Invalid sheet height');await sharp({create:{width:4608,height:h,channels:3,background:'#101216'}}).composite(panels.map((input,i)=>({input,left:i*1536,top:0}))).png().toFile(`${out}l5-l7-side-by-side.png`);
const outside=await Promise.all([5,6,7].map(stage=>sharp(`${out}l${stage}/outside-comparison.png`).png().toBuffer()));
await sharp({create:{width:3072,height:604,channels:3,background:'#101216'}}).composite(outside.map((input,i)=>({input,left:i*1024,top:0}))).png().toFile(`${out}outside-comparisons.png`);
if(!await stat(`${out}round1/REPORT.md`).catch(()=>null))await cp(`${out}REPORT.md`,`${out}round1/REPORT.md`);
const gas=rec(metadata.gas),catalogue=num(native.retained);
const report=`# LMC component grading round\n\nThe requested l5–l7 sheets are rendered at 512 pixels. All versions have Earth, face-on, 45-degree and edge-on views. The model is still not ready for full fitting or slabs: native catalogue coverage and conditional depth remain conspicuous in outside views, and the old disc is weakly constrained by this processed photograph.\n\n![All three sheets side by side](l5-l7-side-by-side.png)\n\n| Version | Held-out linear RGB relative RMS | Total diffuse light difference | Internal dust strength | Tiny fit | Small fit |\n| --- | --- | --- | --- | --- | --- |\n${rows.map(r=>`| l${r.stage} | ${r.rms.toFixed(6)} | ${r.light.toFixed(2)}% | ${r.dust??'Inactive'} | ${r.tiny.toFixed(2)} s | ${r.small.toFixed(2)} s |`).join('\n')}\n\nThe calibration used 64 and 128 pixel images. The 512 pixel images reuse those fitted settings. These RGB residuals describe a processed photograph, not calibrated luminosity or slab fidelity.\n\n## What changed\n\n- Old disc, bar, young stars and gas have independent global RGB coefficients, recorded as tint and gain. The outskirts share the old-disc grade. Dust has one positive global strength and attenuation tint. One stretch and saturation curve applies to every view. No local appearance values or geometry were fitted.\n- The young layer contains ${catalogue.toLocaleString('en-US')} individual SMASH sources, retaining measured positions and gri photometry. VMC supplies the global young-light budget. Its survey polygons no longer clip real stellar positions. Extrapolating that budget outside VMC is an explicit assumption. Individual heights are conditional draws, not measured depths.\n- Bell's internal dust columns remain the measured five-arcminute medians. The previous extra Gaussian smoothing is removed. Only the global attenuation controls change, and strength remains bounded to 0.25–2. The fitted lower bound does not mean zero measured dust.\n- The LMC loader handles repeated EQUINOX and identical metadata cards, plus the appended cutout CRPIX/CD WCS. It changes a byte-offset-preserving copy, rejects unrelated conflicts, and checks the requested sky coordinate. Shared FITS code is unchanged.\n- Ten DeMCELS continuum-subtracted H-alpha cutouts qualified. Two requested positions had no usable candidate. The line field uses measured relative linear counts and preserves angular features while allocating conditional thin-layer depth. It is partial coverage, not a full-galaxy gas reconstruction. Missing BUNIT prevents an absolute-flux claim.\n\n## Warp and outskirts\n\n[Fixed-grade ablations](ablations/notes.md) show that the fields reach the rendered pixels. Before grading, the warp changes the wide edge-on image by about 2.1% in relative L1. The outskirts change the wide face-on image by about 0.78%. Removing the warp leaves its face-on column unchanged, as expected. Bright Earth-view RMS values can round to the same four decimals because the effects are faint and mostly outside the central frame. The old-disc grade further suppresses them. These tests isolate the old components; they are not full-population fits.\n\n## Outside comparison\n\n![Face-on models beside NGC 4027](outside-comparisons.png)\n\nThe reference is [NGC 4027, ESO / NTT](https://www.eso.org/public/images/potw1030a/). Credit: ESO. Its scale, filters and processing differ, so it is a qualitative morphology check. Our model has a coherent bar and flattened body, but does not yet reproduce comparable arm and cloud structure outside Earth's view. No geometry is fitted to this comparison.\n\n## Remaining limits\n\n- The northern extension appears, but the northern spiral arm is not convincingly recovered. It was not fitted into existence.\n- Native survey completeness, unresolved light and foreground contamination remain unqualified. Angular boundaries remain visible in the model, and their causes need a separate source-support audit. Raising image resolution exposes them; it does not supply missing stars.\n- The fitted old disc is faint relative to the bar and young tracer. This is calibration degeneracy and model mismatch, not evidence that the old disc or outskirts are absent.\n- Annular and regional color errors remain material; the per-version notes report them without hiding the faint surroundings. More global optimization cannot supply missing structure or measured depth.\n- DeMCELS cutouts cover ${num(gas.coveredGridCells).toLocaleString('en-US')} of ${num(gas.totalGridCells).toLocaleString('en-US')} cells in the 16-kpc gas support grid. Unsupported regions are unknown.\n\n## Verification and boundaries\n\nEighteen behavior tests and strict TypeScript checking passed. Seven deletion checks went red for removed native emission, gas angular preservation, positive dust bounds, component color grading, warp, outskirts and duplicate-card handling. The dust-family interpolation was checked against direct rendering at each fitted rung. Every final sheet and the outside comparison was inspected.\n\nThree bounded correction rounds are recorded: initial grading, removal of VMC polygon clipping, then direct display-curve polish and the gas angular-preservation fix. Previous images are retained in grade-round1 and grade-round2. No further fit rounds were started. No GPU training, full-resolution fitting, slab bake, separate HTML viewer, shared-package edit, commit or publication occurred.\n`;
await writeFile(`${out}REPORT.md`,report);
console.log(JSON.stringify({sentinel:'FINAL_LMC_REPORT_WRITTEN',rows}));
