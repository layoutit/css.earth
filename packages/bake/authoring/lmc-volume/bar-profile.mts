/** Fixed-aperture, catalogue-masked profiles; no measured width changes the model. */
import {bodyToIcrs,add,mul,type V3} from './geometry.mts';import {projectedBar,type BarGeometry} from './bar-geometry.mts';import {barAperture} from './bar-ratios.mts';import type {CatalogueRow} from './catalogue-data.mts';import type {Observation} from './report.mts';import {need} from './inputs.mts';import {LUMA} from './grade.mts';
export function barProfiles(rgb:Float64Array,o:Observation,b:BarGeometry,rows:CatalogueRow[]){const center=o.pixelOf(bodyToIcrs(b.center));need(center,'Unregistered bar centre');const axes:V3[]=[[b.sigma*Math.cos(b.angle),b.sigma*Math.sin(b.angle),0],[-b.sigma*b.ratio*Math.sin(b.angle),b.sigma*b.ratio*Math.cos(b.angle),0],[0,0,b.sigmaZ]];let xx=0,yy=0,xy=0;for(const axis of axes){const p=o.pixelOf(bodyToIcrs(add(b.center,axis))),q=o.pixelOf(bodyToIcrs(add(b.center,mul(axis,-1))));need(p&&q,'Missing bar projection');const x=(p[0]-q[0])/2,y=(p[1]-q[1])/2;xx+=x*x;yy+=y*y;xy+=x*y;}const d=Math.hypot(xx-yy,2*xy),angle=.5*Math.atan2(2*xy,xx-yy),a=Math.sqrt((xx+yy+d)/2),c=Math.sqrt((xx+yy-d)/2),mask=barAperture(o,b,rows),reference=projectedBar(b),profiles=[Array.from({length:64},()=>({sum:0,n:0})),Array.from({length:64},()=>({sum:0,n:0}))];for(let y=0;y<o.height;y++)for(let x=0;x<o.width;x++){const p=y*o.width+x;if(!o.mask[y][x]||mask.excluded[p])continue;const dx=x+.5-center[0],dy=y+.5-center[1],u=(dx*Math.cos(angle)+dy*Math.sin(angle))/a,v=(-dx*Math.sin(angle)+dy*Math.cos(angle))/c,l=rgb[p*3]*LUMA[0]+rgb[p*3+1]*LUMA[1]+rgb[p*3+2]*LUMA[2];for(let k=0;k<2;k++){const along=k?v:u,across=k?u:v;if(Math.abs(along)>=3||Math.abs(across)>(k?1.8:1.2))continue;const bin=Math.floor((along+3)/6*64);profiles[k][bin].sum+=l;profiles[k][bin].n++;}}return profiles.map((profile,k)=>{const values=profile.map(v=>v.n?v.sum/v.n:0),ends=[...values.slice(0,4),...values.slice(-4)],background=ends.reduce((a,b)=>a+b,0)/ends.length,signal=values.map(v=>Math.max(0,v-background)),peak=Math.max(...signal),at=signal.indexOf(peak),half=peak/2;let left=at,right=at;while(left>0&&signal[left]>=half)left--;while(right<63&&signal[right]>=half)right++;const x0=left+(half-signal[left])/Math.max(1e-12,signal[left+1]-signal[left]),x1=right-1+(signal[right-1]-half)/Math.max(1e-12,signal[right-1]-signal[right]),sum=signal.reduce((a,b)=>a+b,0);return{axis:k?'minor':'major',fwhmKpc:(x1-x0)*6/64*reference.sigmaMajorKpc*(k?reference.axisRatio:1),background,normalized:signal.map(v=>v/sum),samples:profile.map(v=>v.n)};});}
export function profileError(candidate:ReturnType<typeof barProfiles>,photo:ReturnType<typeof barProfiles>){return candidate.map((p,k)=>Math.sqrt(p.normalized.reduce((s,v,i)=>s+(v-photo[k].normalized[i])**2,0)/photo[k].normalized.reduce((s,v)=>s+v*v,0)));}
