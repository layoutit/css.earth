/** Assemble the completed reference renders with accurate l20 captions. No rendering or fitting. */
import {readFile,writeFile} from 'node:fs/promises';import sharp from 'sharp';
import {L20} from './gaia-old.mts';import {json,rec,num,need} from './inputs.mts';import {finishSheet} from './catalogue-run.mts';
const names=['earth','horalek','difference-4x','face','tilt45','edge'],inputs=await Promise.all(names.map(n=>readFile(L20+n+'.png')));for(let i=0;i<inputs.length;i++){const m=await sharp(inputs[i]).metadata();need(m.width===512&&m.height===(i<3?384:512),'Unexpected l20 panel dimensions');}
const text=(x:number,y:number,s:string,size=18)=>`<text x="${x}" y="${y}" font-size="${size}">${s}</text>`,svg=Buffer.from('<svg xmlns="http://www.w3.org/2000/svg" width="1536" height="1064"><rect width="100%" height="100%" fill="#101216"/><g fill="#e7e9ed" font-family="Arial">'+text(14,27,'l20 · Gaia old populations and stellar grain · rejected diagnostic',22)+text(14,51,'Same physical model, exposure and display curve in every view. No slabs.',15)+text(10,75,'Earth · 512 px')+text(522,75,'Horálek · registered diffuse image')+text(1034,75,'Absolute difference · 4×')+['Face-on','45°','Edge-on'].map((s,i)=>text(i*512+10,494,s+' · 16 kpc across')).join('')+text(12,1047,'Dust strength 1.025. Measured Gaia G luminosity density; 100 pc smoothing; no analytic old light.',15)+'</g></svg>');
await sharp(svg).composite(inputs.map((input,i)=>({input,left:i%3*512,top:i<3?82:504}))).png().toFile(L20+'sheet.png');
await finishSheet(L20,20,['Old light follows Gaia RGB and RC.','Measured G flux weights the density.','Gaussian smoothing sigma: 100 pc.','Bar + disc sum to the Gaia light map.','Old-disc sigma: 410 pc.','Bar sigma: 367 pc.','Individual Gaia colors and point fluxes.','Two global resolved-light fractions.','Point light replaces unresolved light.','HERITAGE / Bell dust strength: 1.025.','No molecular oval screens.','The count-field completeness is unresolved.']);
await sharp({create:{width:3072,height:1668,channels:3,background:'#101216'}}).composite([{input:await readFile(L20+'../l18/sheet.png'),left:0,top:0},{input:await readFile(L20+'sheet.png'),left:1536,top:0}]).png().toFile(L20+'l18-l20-side-by-side.png');
// The legacy grade field was display-only for catalogue projections. Name the
// actual physical strength consistently; changing this metadata cannot alter RGB.
for(const path of ['tiny/result.json','result.json']){const result=rec(await json(L20+path)),grade=rec(result.grade);grade.dustStrength=1.025;result.grade=grade;result.physicalDustStrength=1.025;await writeFile(L20+path,JSON.stringify(result,null,2)+'\n');}
console.log(JSON.stringify({sentinel:'L20_EVIDENCE_ASSEMBLED',panels:inputs.length}));
