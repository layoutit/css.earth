/** Integrate the accepted vertical prior to compare density geometry in the observer's plane. */
import {at,type Raster,need} from './inputs.mts';import {bodyToIcrs,dot,normalize,WEST,NORTH,type V3} from './geometry.mts';
export function projectedDensityMoments(map:Raster,warp:Raster,sigmaZ:number,center:V3){const ref=bodyToIcrs(center),ray=normalize(ref),distance=Math.hypot(...ref);let w=0,x=0,y=0,xx=0,yy=0,xy=0;for(let j=0;j<map.n;j++)for(let i=0;i<map.n;i++){const weight=map.values[j*map.n+i];if(weight<=0)continue;const a=((i+.5)/map.n*2-1)*map.half,b=((j+.5)/map.n*2-1)*map.half,z0=at(warp,a,b);for(let k=0;k<24;k++){const z=(k+.5)/24*8-4,sky=bodyToIcrs([a,b,z0+z*sigmaZ]),d=dot(sky,ray),u=distance*dot(sky,WEST)/d,v=distance*dot(sky,NORTH)/d,m=weight*Math.exp(-z*z/2)/dot(sky,sky);w+=m;x+=m*u;y+=m*v;xx+=m*u*u;yy+=m*v*v;xy+=m*u*v;}}need(w>0,'Empty projected density');x/=w;y/=w;xx=xx/w-x*x;yy=yy/w-y*y;xy=xy/w-x*y;const delta=Math.hypot(xx-yy,2*xy),angle=.5*Math.atan2(2*xy,xx-yy);return{paDegrees:(Math.atan2(-Math.cos(angle),Math.sin(angle))*180/Math.PI+360)%180,sigmaMajorKpc:Math.sqrt((xx+yy+delta)/2),sigmaMinorKpc:Math.sqrt((xx+yy-delta)/2),axisRatio:Math.sqrt((xx+yy-delta)/(xx+yy+delta)),tangentCenterWestNorthKpc:[x,y]};}
