/** Continuum-supported stellar-residual removal and a luminosity-conserving H-alpha split. */
import {need} from '../inputs.mts';
const median=(v:number[])=>{v.sort((a,b)=>a-b);return v[Math.floor(v.length/2)]??0;};
export function cleanLine(line:ArrayLike<number>,continuum:ArrayLike<number>,width:number,height:number){need(line.length===width*height&&continuum.length===line.length,'Unregistered line/continuum arrays');const finite=Array.from(continuum).filter(Number.isFinite).sort((a,b)=>a-b),threshold=finite[Math.floor(.995*finite.length)],out=Float32Array.from(line),mask=new Uint8Array(line.length);let replaced=0;for(let y=3;y<height-3;y++)for(let x=3;x<width-3;x++){const i=y*width+x;if(!Number.isFinite(line[i])||!(continuum[i]>threshold))continue;const neighborhood:number[]=[];for(let dy=-3;dy<=3;dy++)for(let dx=-3;dx<=3;dx++)if(Math.hypot(dx,dy)>=2&&Math.hypot(dx,dy)<=3.3){const j=i+dy*width+dx;if(Number.isFinite(line[j])&&continuum[j]<=threshold)neighborhood.push(line[j]);}if(neighborhood.length<12)continue;const local=median(neighborhood),mad=1.4826*median(neighborhood.map(v=>Math.abs(v-local)));let paired=false;for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++){const v=line[i+dy*width+dx];if(line[i]>local&&v<Math.min(0,local-Math.max(20,4*mad))||line[i]<local&&v>local+Math.max(20,4*mad))paired=true;}if(paired&&Math.abs(line[i]-local)>Math.max(20,4*mad)){out[i]=local;mask[i]=1;replaced++;}}return{values:out,mask,replaced,continuumThreshold:threshold};}
export function boxSmooth(values:Float32Array,n:number,radius:number){need(values.length===n*n&&Number.isInteger(radius)&&radius>0,'Invalid H-alpha smoothing');const tmp=new Float32Array(values.length),out=new Float32Array(values.length);for(let y=0;y<n;y++){let sum=0;for(let x=-radius;x<=radius;x++)sum+=values[y*n+Math.max(0,Math.min(n-1,x))];for(let x=0;x<n;x++){tmp[y*n+x]=sum/(radius*2+1);sum+=values[y*n+Math.min(n-1,x+radius+1)]-values[y*n+Math.max(0,x-radius)];}}for(let x=0;x<n;x++){let sum=0;for(let y=-radius;y<=radius;y++)sum+=tmp[Math.max(0,Math.min(n-1,y))*n+x];for(let y=0;y<n;y++){out[y*n+x]=sum/(radius*2+1);sum+=tmp[Math.min(n-1,y+radius+1)*n+x]-tmp[Math.max(0,y-radius)*n+x];}}return out;}
export function splitDiffuse(values:Float32Array,n:number,cellKpc:number,fraction=.35){need(values.length===n*n&&values.every(v=>Number.isFinite(v)&&v>=0)&&fraction>=.3&&fraction<=.4,'Invalid full H-alpha morphology');const radius=Math.max(1,Math.round(.2/cellKpc)),smooth=boxSmooth(values,n,radius),total=values.reduce((s,v)=>s+v,0),amount=(gain:number)=>values.reduce((s,v,i)=>s+Math.min(v,smooth[i]*gain),0);need(total>0,'No positive full-field emission');let lo=0,hi=100;for(let step=0;step<50;step++){const mid=(lo+hi)/2;if(amount(mid)<total*fraction)lo=mid;else hi=mid;}const gain=(lo+hi)/2,diffuse=Float32Array.from(values,(v,i)=>Math.min(v,smooth[i]*gain)),compact=Float32Array.from(values,(v,i)=>Math.max(0,v-diffuse[i]));return{diffuse,compact,gain,measuredFraction:diffuse.reduce((s,v)=>s+v,0)/total,halfWidthPc:radius*cellKpc*1000};}
