/** Full-field survey fallback, retaining the published continuum-subtracted FITS bytes. */
import {readFile,writeFile,mkdir} from 'node:fs/promises';import {spawnSync} from 'node:child_process';import {gunzipSync} from 'node:zlib';import {pathToFileURL} from 'node:url';import {readFitsImage,skyProjection,type FitsHeader} from '@cssearth/fits';import {need,num} from '../inputs.mts';import {versionDir} from '../sequence-state.mts';
export const SHASSA_URL='https://amundsen.swarthmore.edu/SHASSA/Images/013.fl.fits.gz',SHASSA_PATH=versionDir(34)+'inputs/013.fl.fits.gz';
export function shassaProjectionHeader(original:FitsHeader):FitsHeader{const header={...original};need(header.CTYPE1==='RA---TAN'&&header.CTYPE2==='DEC--TAN'&&header.EQUINOX===2000&&['CD1_1','CD1_2','CD2_1','CD2_2'].every(k=>Number.isFinite(num(header[k]))),'Unexpected SHASSA celestial WCS');for(const key of ['CDELT1','CDELT2','CROTA1','CROTA2'])delete header[key];return header;}
export async function loadShassa(path=SHASSA_PATH,emission=true){const raw=await readFile(path);need(raw.length<8e6&&raw[0]===31&&raw[1]===139,'Expected bounded gzipped SHASSA FITS');const bytes=gunzipSync(raw,{maxOutputLength:16e6});need(bytes.subarray(0,8).toString('ascii')==='SIMPLE  ','Source is not a FITS image');const image=readFitsImage(bytes,{maxDecodedBytes:16e6});need(image.width===1014&&image.height===998,'Unexpected SHASSA native field dimensions');need(image.bitpix===32&&(!emission||image.header.BUNIT==='dR'),'Unexpected SHASSA units or integer encoding');const wcs=skyProjection(shassaProjectionHeader(image.header));need(wcs.pixelOf(80.89,-69.76),'LMC center outside projection');return{image,wcs,rawBytes:raw.length};}
async function main(){await mkdir(versionDir(34)+'inputs/',{recursive:true});if(process.argv.includes('--acquire'))for(const name of ['013.fl.fits.gz','013du.mn.fits.gz','013.sm.fits.gz']){const path=versionDir(34)+'inputs/'+name,exists=await readFile(path).catch(()=>null);if(!exists){const r=spawnSync('curl',['--fail','--silent','--show-error','--connect-timeout','8','--max-time','45','--max-filesize','8000000',new URL(name,SHASSA_URL).href,'-o',path],{encoding:'utf8',timeout:50000});need(r.status===0,'SHASSA download failed: '+r.stderr);}}const s=await loadShassa(),h=s.image.header,finite=Array.from(s.image.values).filter(Number.isFinite).sort((a,b)=>a-b),q=(f:number)=>finite[Math.floor(f*(finite.length-1))],record={source:SHASSA_URL,provider:'Southern H-Alpha Sky Survey Atlas, Gaustad et al. 2001',release:'Field013 continuum-subtracted, unsmoothed 013.fl.fits.gz',rawBytes:s.rawBytes,width:s.image.width,height:s.image.height,bitpix:s.image.bitpix,header:h,wcsAdapter:'The temporary LMC projection header uses the full CD1_1, CD1_2, CD2_1, CD2_2 matrix and omits redundant CDELT1, CDELT2, CROTA1, CROTA2 cards. Published bytes remain untouched; packages/fits is unchanged.',units:'dR: decirayleigh, 0.1 R per stored intensity unit.',finitePixels:finite.length,p01:q(.01),median:q(.5),p99:q(.99),minimum:q(0),maximum:q(1),center:s.wcs.skyOf((s.image.width-1)/2,(s.image.height-1)/2),pixelDegrees:[Math.abs(num(h.CDELT1)),Math.abs(num(h.CDELT2))],primaryMCELS:'The original CTIO MCELS release endpoint returned HTTP404 on 26 October 2026. No qualified full continuum-subtracted MCELS file was found in bounded release discovery. This is the owner-authorized SHASSA fallback, not a 3-arcsecond MCELS product.',references:['https://amundsen.swarthmore.edu/SHASSA/','https://amundsen.swarthmore.edu/SHASSA/ImagePages/013.html','https://doi.org/10.1086/323969'],acknowledgment:'Southern H-Alpha Sky Survey Atlas, produced with support from the National Science Foundation.'};await writeFile(versionDir(34)+'inputs/qualification.json',JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({sentinel:'FULL_H_ALPHA_QUALIFIED',...record}));}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await main();
