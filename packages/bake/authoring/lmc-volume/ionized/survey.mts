async function main(){const {scene}=await loadParent(32),field=await surveyField(scene.sources,process.argv.includes('--tiny')?128:1024),dir=versionDir(34)+(process.argv.includes('--tiny')?'survey-tiny-':'');for(const [name,map]of [['ha',field.map],['diffuse',field.diffuse],['compact',field.compact]] as const)await writeFile(dir+name+'.f32le',Buffer.from(map.values.buffer));await writeFile(dir+'survey.json',JSON.stringify(field.metadata,null,2)+'\n');console.log(JSON.stringify({sentinel:'FULL_FIELD_SPLIT_READY',...field.metadata}));}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await main();
