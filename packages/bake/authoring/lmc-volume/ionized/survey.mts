const median=(v:number[])=>{v.sort((a,b)=>a-b);return v[Math.floor(v.length/2)];};
export async function surveyField(sources:Sources,n=1024){const ha=await loadShassa(),continuum=await loadShassa(SHASSA_PATH.replace('013.fl','013du.mn'),false);const continuumPixels=reprojectSurvey(continuum.image,continuum.wcs,ha.image,ha.wcs),sm=await loadShassa(SHASSA_PATH.replace('013.fl','013.sm')),smoothPixels=reprojectSurvey(sm.image,sm.wcs,ha.image,ha.wcs);const clean=cleanLine(ha.image.values,continuumPixels,ha.image.width,ha.image.height),background:number[]=[];for(let y=30;y<ha.image.height-30;y+=3)for(let x=30;x<ha.image.width-30;x+=3){const [ra,dec]=ha.wcs.skyOf(x,y),r=Math.hypot((ra-80.89)*Math.cos(dec*Math.PI/180),dec+69.76),v=clean.values[y*ha.image.width+x];if(r>5&&r<6&&Number.isFinite(v))background.push(v);}need(background.length>500,'Missing exterior sky reference');const sky=median(background),noise=1.4826*median(background.map(v=>Math.abs(v-sky))),smoothBackground=Array.from(smoothPixels).filter((v,i)=>Number.isFinite(v)&&i%7===0&&i<ha.image.width*100),smoothSky=median(smoothBackground),smoothNoise=Math.max(1,1.4826*median(smoothBackground.map(v=>Math.abs(v-smoothSky)))),map=makeRaster(n,10),cell=20/n,ogle=await loadOgle();let covered=0,nonzero=0;const sample=(ra:number,dec:number)=>{const p=ha.wcs.pixelOf(ra,dec);if(!p)return NaN;const x=Math.floor(p[0]),y=Math.floor(p[1]);if(x<28||y<30||x>=948||y>=988)return NaN;const u=p[0]-x,v=p[1]-y,indices=[y*ha.image.width+x,y*ha.image.width+x+1,(y+1)*ha.image.width+x,(y+1)*ha.image.width+x+1],a=indices.map(i=>clean.values[i]);if(!a.every(Number.isFinite))return NaN;return(a[0]*(1-u)+a[1]*u)*(1-v)+(a[2]*(1-u)+a[3]*u)*v;};
 for(let y=0;y<n;y++)for(let x=0;x<n;x++){const i=y*n+x,px=((x+.5)/n*2-1)*10,py=((y+.5)/n*2-1)*10,[ra,dec]=skyOf(bodyToIcrs([px,py,at(sources.warp,px,py)])),v=sample(ra,dec);if(!Number.isFinite(v))continue;covered++;const pixel=ha.wcs.pixelOf(ra,dec),signal=pixel?bilinear({width:ha.image.width,height:ha.image.height,values:smoothPixels},...pixel)-smoothSky:0,confidence=Number.isFinite(signal)?Math.max(0,Math.min(1,(signal-smoothNoise)/(2*smoothNoise))):0,r=Math.hypot(px,py),support=1-smoothstep((r-5.5)/1),rc=ogle.sample(ra,dec),av=rc?Math.min(3,internalAv(rc.evi)):0;map.values[i]=Math.max(0,(v-sky)*.1)*confidence*support*Math.exp(.75*av/1.0857362047581296);map.mask[i]=1;if(map.values[i]>0)nonzero++;}const split=splitDiffuse(map.values,n,cell),metadata={source:'SHASSA Field013, continuum-subtracted unsmoothed, 0.8 arcminute native pixels',n,halfKpc:10,cellPc:cell*1000,coveredCells:covered,nonzeroCells:nonzero,backgroundDeciRayleigh:sky,exteriorFluctuationDeciRayleigh:noise,smoothBackgroundDeciRayleigh:smoothSky,smoothNoiseDeciRayleigh:smoothNoise,faintConfidence:'The published 4 arcminute median-filtered continuum-subtracted map supplies a continuous detection weight, rising from zero at 1 noise level to unity at 3 noise levels above its exterior reference. Unsmooth morphology is retained in detected areas.',starResidualsReplaced:clean.replaced,starResidualMethod:'Only bright continuum pixels above the 99.5th percentile with paired positive/negative stellar subtraction residuals beyond 4 local MAD (minimum 20 dR) are replaced by their 2–3 pixel annular line median. Filaments elsewhere are unchanged.',diffuseFraction:split.measuredFraction,diffuseMorphologyHalfWidthPc:split.halfWidthPc,diffuseMethod:'A 200 pc half-width box mean supplies a broad morphology. DIG=min(total,globalFactor*mean), with the single factor fixed to 35% integrated H-alpha. Compact=total-DIG, preserving every source cell. The 30–40% prior is Kennicutt et al.1995.',paper:'https://doi.org/10.1086/1