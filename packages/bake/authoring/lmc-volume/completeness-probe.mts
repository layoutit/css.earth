/** Qualify selection probabilities on the exact l20 old-star tracer list before fitting. */
import {writeFile} from 'node:fs/promises';import {loadCompleteness,tcgCompleteness,L21} from './completeness.mts';import {loadOld} from './gaia-old.mts';import {loadParent} from './sequence-state.mts';import {gaiaWarpLocator} from './gaia-plane.mts';
const map=await loadCompleteness(),old=await loadOld(),{scene}=await loadParent(20),locate=gaiaWarpLocator(scene.sources),tracers=[...old.points,...old.density.filter(s=>s.g>=18)],regions=Array.from({length:3},()=>({n:0,g:0,corrected:0,mean:0,min:1,max:0,m10:0}));for(const s of tracers){const p=locate(s.ra,s.dec),r=Math.hypot(p[0],p[1]);if(r>9)continue;const region=regions[r<1.5?0:r<4?1:2],m10=map.atStar(s.id),q=tcgCompleteness(s.g,m10),flux=10**(-.4*(s.g-20))*(s.g<18?1:18.11709771);region.n++;region.g+=flux;region.corrected+=flux/q;region.mean+=q;region.min=Math.min(region.min,q);region.max=Math.max(region.max,q);region.m10+=m10;}const summary=regions.map((v,i)=>({region:['Inner 1.5 kpc','1.5–4 kpc','4–9 kpc'][i],stars:v.n,meanCompleteness:v.mean/v.n,minimum:v.min,maximum:v.max,fluxCorrection:v.corrected/v.g,meanM10:v.m10/v.n}));await writeFile(L21+'completeness-probe.json',JSON.stringify(summary,null,2)+'\n');console.log(JSON.stringify({sentinel:'L21_COMPLETENESS_PROBED',summary}));
