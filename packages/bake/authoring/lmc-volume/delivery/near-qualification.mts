export function qualifyNearRows(value:unknown,baseline:unknown){
 const rows=array(value).map(rec),base=array(baseline).map(rec),names=galaxyNearStations(128,10).map(v=>v.camera.name);for(const list of[rows,base])need(list.length===20&&names.every(name=>list.filter(v=>v.name===name).length===1),'Near qualification needs all 20 matched cameras');
 return rows.map(row=>{const b=base.find(v=>v.name===row.name)!;const limits={relativeL1:num(b.encodedRelativeL1),minimumLightPercent:Math.min(-5,num(b.lightDifferencePercent)),maximumLightPercent:2,annuli:array(b.annulusDifferencePercent).map(v=>Math.max(10,Math.abs(num(v)))),color:array(b.channelShareDifferencePercentagePoints).map(v=>array(v).map(x=>Math.max(3,Math.abs(num(x)))))},radial=array(row.annulusDifferencePercent).map(num),color=array(row.channelShareDifferencePercentagePoints).map(v=>array(v).map(num));need(radial.length===4&&limits.annuli.length===4&&color.length===3&&limits.color.length===3&&color.every(v=>v.length===3)&&limits.color.every(v=>v.length===3)&&limits.relativeL1>=0,'Incomplete near radial or color evidence');
