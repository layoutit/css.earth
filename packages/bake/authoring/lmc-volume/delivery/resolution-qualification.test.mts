import test from 'node:test';import assert from 'node:assert/strict';
import {qualifyResolution} from './resolution-qualification.mts';
import {requireResolutionTile} from './resolution-provenance.mts';
const evidence=()=>({provenance:{complete:true,tiles:300,physicalConfigurationAndGradeMatchApproved:true,joinedPngsMatchWholeFloatEncoding:true,optimizedAndUnoptimizedReplayMaximumAbsoluteDifference:0},freshFieldsByteIdentical:true,convergence:['bar','gas'].flatMap(region=>['earth','face','tilt45','edge'].map(camera=>({region,camera,mediumToFineRelativeL1:.001}))),smallPins:{maxColorRatioChange:.001,maxBrightnessChange:.001},nativePins:{maxColorRatioChange:.001,maxBrightnessChange:.001},nativeViews:['earth','face','tilt45','edge'].map(camera=>({camera,complete:true,size:1024,width:1024,height:camera==='earth'?768:1024,parametersFitted:0,fields:{n:2048,oldSigmaPc:100,youngSigmaPc:45},stepPc:15,objectSubpixels:4,pcPerPixel:9.250826559679918}))});
test('resolution admission requires every native camera, numerical convergence and unchanged Earth calibration',()=>{
 assert.equal(qualifyResolution(evidence()).passed,true);
 for(const change of[(v:ReturnType<typeof evidence>)=>{v.provenance.joinedPngsMatchWholeFloatEncoding=false;},(v:ReturnType<typeof evidence>)=>{v.freshFieldsByteIdentical=false;},(v:ReturnType<typeof evidence>)=>{v.convergence.pop();},(v:ReturnType<typeof evidence>)=>{v.convergence[6].mediumToFineRelativeL1=.011;},(v:ReturnType<typeof evidence>)=>{v.nativeViews[2].fields.n=512;},(v:ReturnType<typeof evidence>)=>{v.nativeViews[1].pcPerPixel=15.625;},(v:ReturnType<typeof evidence>)=>{v.nativePins.maxColorRatioChange=.021;},(v:ReturnType<typeof evidence>)=>{v.smallPins.maxBrightnessChange=.021;},(v:ReturnType<typeof evidence>)=>{v.nativeViews[0].parametersFitted=1;}]){const v=evidence();change(v);assert.throws(()=>qualifyResolution(v));}
});
test('a completed tile cannot inherit another tile\'s physical configuration or numerical provenance',()=>{
 const grade={coefficients:Array.from({length:4},()=>[1,1,1]),dustStrength:1,dustTint:[1,1,1],stretch:20,saturation:1,score:0},configuration={version:36,parent:32},expected={size:1024,camera:'face',left:128,top:256,configuration,grade},tile={complete:true,approvedCommit:'e4ebd6c94263f73dc020ad0d1443901182310329',size:1024,camera:'face',width:128,height:128,tile:{left:128,top:256,edge:128},stepPc:15,objectSubpixels:4,parametersFitted:0,fields:{n:2048,halfKpc:10,oldSigmaPc:100,youngSigmaPc:45},configuration,grade,gaussianTailSigma:10};
 assert.equal(requireResolutionTile(tile,expected),'ten-sigma');
 for(const changed of[{...tile,fields:{...tile.fields,n:512}},{...tile,configuration:{...configuration,version:35}},{...tile,grade:{...grade,stretch:10}},{...tile,tile:{...tile.tile,left:0}},{...tile,approvedCommit:'other'},{...tile,gaussianTailSigma:8}])assert.throws(()=>requireResolutionTile(changed,expected));
});
