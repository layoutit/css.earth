/** Bounded native near-pilot jobs, with positive completion and recoverable per-job outputs. */
import {spawn} from 'node:child_process';import {writeFile} from 'node:fs/promises';import {fileURLToPath} from 'node:url';import {json,rec,need} from '../inputs.mts';import {NEAR_DIR,NEAR_SPEC} from './near-pilot.mts';import {galaxyNearStations} from '../../milky-way-dust/galaxy-near-cameras.mts';
const jobs=[...([0,1,2]as const).flatMap(axis=>Array.from({length:NEAR_SPEC.counts[axis]},(_,index)=>({kind:'plane',index:([0,1,2]as const).filter(a=>a<axis).reduce<number>((s,a)=>s+NEAR_SPEC.counts[a],0)+index,path:NEAR_DIR+`local-${axis}-${index}.json` }))),...galaxyNearStations(128,10).map((v,index)=>({kind:'reference',index,path:NEAR_DIR+v.camera.name+'-reference.json'}))];
for(const index of[22,26]){const r=rec(await json(jobs[index]!.path));need(r.complete===true,'The single plane and camera pilots must finish before the batch');}
let next=0,failed=false;const active=new Set<ReturnType<typeof spawn>>(),started=performance.now();
for(const signal of['SIGINT','SIGTERM']as const)process.once(signal,()=>{failed=true;for(const child of active)child.kill('SIGTERM');});
const worker=async()=>{while(next<jobs.length&&!failed){const job=jobs[next++]!,cached=await json(job.path).then(rec).catch(error=>{if(error&&typeof error==='object'&&'code'in error&&error.code==='ENOENT')return null;throw error;});if(cached?.complete===true){need(cached.stepPc===15&&(cached.subpixels===4),'Cached near job settings differ');continue;}try{await new Promise<void>((resolve,reject)=>{const child=spawn(process.execPath,['--max-old-space-size=8192',fileURLToPath(new URL('./near-pilot.mts',import.meta.url)),job.kind,String(job.index)],{stdio:['ignore','pipe','pipe']});active.add(child);let out='',err='';child.stdout.on('data',b=>out+=String(b));child.stderr.on('data',b=>err+=String(b));const timer=setTimeout(()=>child.kill('SIGTERM'),300000);child.once('error',e=>{clearTimeout(timer);active.delete(child);reject(e);});child.once('close',code=>{clearTimeout(timer);active.delete(child);if(code!==0||!out.includes('NEAR_JOB_COMPLETE'))reject(new Error(job.kind+' '+job.index+' exited '+code+' without completion: '+err+out));else resolve();});});const r=rec(await json(job.path));need(r.complete===true,'A launched near job is not a completed one');console.log(JSON.stringify({sentinel:'NEAR_BATCH_JOB_COMPLETE',kind:job.kind,index:job.index,seconds:r.seconds}));}catch(error){failed=true;for(const child of active)child.kill('SIGTERM');throw error;}}};
const results=await Promise.allSettled(Array.from({length:6},worker));for(const r of results)if(r.status==='rejected')throw r.reason;need(!failed,'The near batch was interrupted');await writeFile(NEAR_DIR+'batch.json',JSON.stringify({complete:true,jobs:46,seconds:(performance.now()-started)/1000,workers:6},null,2)+'\n');console.log('NEAR_BATCH_COMPLETE');
