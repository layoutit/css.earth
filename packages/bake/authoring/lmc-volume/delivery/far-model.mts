/** Model pictures use the same approved 3D source. No photograph pixels or completed slabs enter rendering. */
import{normalize,cross,dot,add,mul,skyToBody,icrsToSky,DISTANCE,type V3}from'../geometry.mts';import type{Camera}from'../render.mts';import{need}from'../inputs.mts';
export const FAR_DIR='src/objects/lmc-volume/.local/versions/l36/delivery/far-model/';export const FAR_RADIUS=Math.hypot(10,10,2.1);export const FAR_SIZE=3072;
export interface ModelFarView {id:string;back:V3;right:V3;down:V3;texturePath:string;}
export function modelFarViews():ModelFarView[]{const s=Math.SQRT1_2,earth=normalize(skyToBody(icrsToSky([0,0,0]))),earthRight=normalize(add([1,0,0],mul(earth,-earth[0])));return[...([{id:'px',back:[1,0,0],right:[0,-1,0]},{id:'nx',back:[-1,0,0],right:[0,1,0]},{id:'py',back:[0,1,0],right:[1,0,0]},{id:'ny',back:[0,-1,0],right:[-1,0,0]},{id:'pz',back:[0,0,1],right:[1,0,0]},{id:'nz',back:[0,0,-1],right:[-1,0,0]},{id:'tilt45',back:[0,s,s],right:[1,0,0]},{id:'earth',back:earth,right:earthRight}]satisfies {id:string;back:V3;right:V3}[]).map(v=>({...v,down:cross(v.right,v.back),texturePath:'l36-far/'+v.id+'.png'}))];}
export function modelFarCamera(view:ModelFarView,size:number):Camera{const eye=mul(view.back,DISTANCE),focal=size*DISTANCE/(2*FAR_RADIUS);return{name:'far-'+view.id,width:size,height:size,foreground:view.id==='earth',ray(x,y){return{origin:eye,direction:normalize(add(mul(view.back,-focal),add(mul(view.right,x-size/2),mul(view.down,y-size/2))))};},pixelOf(p){const q=add(p,mul(eye,-1)),depth=-dot(q,view.back);return depth>0?[size/2+dot(q,view.right)*focal/depth,size/2+dot(q,view.down)*focal/depth]:null;},areaAt(p){return(-dot(add(p,mul(eye,-1)),view.back)/focal)**2;}};}
function code(x:number){const v=Math.max(0,Math.min(1,x));return Math.round(255*(v<=.0031308?12.92*v:1.055*v**(1/2.4)-.055));}
/** For every A and channel C<=A, round(round(C*255/A)*A/255) equals C. */
export function modelFarRgba(rgb:Float64Array){need(rgb.length%3===0&&rgb.every(Number.isFinite),'Invalid model picture RGB');const out=new Uint8Array(rgb.length/3*4);for(let p=0;p<rgb.length/3;p++){const channels=[code(rgb[p*3]!),code(rgb[p*3+1]!),code(rgb[p*3+2]!)],alpha=Math.max(...channels);out[p*4+3]=alpha;if(alpha)for(let c=0;c<3;c++)out[p*4+c]=Math.round(channels[c]!*255/alpha);}return out;}
