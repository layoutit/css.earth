/** Measure the installed merged MW bank against its physical field at declared near cameras. Opt-in only. */
import {readFile,mkdir,writeFile} from 'node:fs/promises';import {pathToFileURL} from 'node:url';import sharp from 'sharp';
import {galaxyNearStations} from '../../milky-way-dust/galaxy-near-cameras.mts';
import {compositeGalaxyStack,type GalaxyDecodedPlane,type GalaxyBankBox,type GalaxyRayCamera} from '../../milky-way-dust/galaxy-fitted-bank.mts';
import {galaxyResiduals,type GalaxyFitTarget} from '../../milky-way-dust/galaxy-bank-fit.mts';
import {rec,num,array,need,json} from '../inputs.mts';
export const MW_NEAR_DIRECTORY='output/lmc-approved-delivery/mw-near-128/';
export const linear=(v:number)=>v<=.04045?v/12.92:((v+.055)/1.055)**2.4;
export const encoded=(v:number)=>v<=.0031308?12.92*v:1.055*v**(1/2.4)-.055;
export function nearAnnuli(camera:GalaxyRayCamera,center:[number,number,number],halfExtent:number){const out=new Uint8Array(camera.width*camera.height);for(let y=0;y<camera.height;y++)for(let x=0;x<camera.width;x++){const{origin:o,direction:d}=camera.ray(x+.5,y+.5),v=o.map((q,i)=>q-center[i]!),t=-v.reduce((s,q,i)=>s+q*d[i]!,0),r=Math.hypot(...v.map((q,i)=>q+t*d[i]!))/halfExtent;out[y*camera.width+x]=r<.1?0:r<.2?1:r<.4?2:3;}return out;}
export function nearResiduals(rgb:Float64Array,target:GalaxyFitTarget){const row=galaxyResiduals(rgb,target);let absolute=0,norm=0;for(let i=0;i<rgb.length;i++){const t=encoded(Math.max(0,Math.min(1,target.linear[i]!)));absolute+=Math.abs(rgb[i]!-t);norm+=Math.abs(t);}return{...row,encodedRelativeL1:absolute/Math.max(norm,1e-20)};}
export async function loadMilkyWayField(){
 const base='src/objects/milky-way-volume/.local/b30-inputs/extension/',m=rec(await json(base+'meta.json')),dims=array(m.dims).map(num),origin=array(m.originKpc).map(num),spacing=array(m.spacingKpc).map(num),box=array(m.box).map(num),extinction=array(m.extinctionPerChannel).map(num),camera=rec(m.camera);need(dims.length===3&&origin.length===3&&spacing.length===3&&box.length===6&&extinction.length===3,'Incomplete physical MW field');
 const load=async(name:string,channels:number)=>{const b=await readFile(base+name+'.f32');need(b.length===dims.reduce((a,b)=>a*b,1)*channels*4&&b.byteOffset%4===0,'Incomplete spectral field');return new Float32Array(b.buffer,b.byteOffset,b.length/4);},emission=await load('emission',3),dust=await load('dust',1),scatter=await load('scatter',3);
 const sample=(x:number,y:number,z:number,out:Float64Array)=>{out.fill(0);const q=[x,y,z].map((v,a)=>(v-origin[a]!)/spacing[a]!);if(q.some((v,a)=>v<0||v>dims[a]!-1))return;const i=q.map((v,a)=>Math.min(dims[a]!-2,Math.floor(v))),f=q.map((v,a)=>v-i[a]!);for(let c=0;c<2;c++)for(let b=0;b<2;b++)for(let a=0;a<2;a++){const n=((i[2]!+c)*dims[1]!+i[1]!+b)*dims[0]!+i[0]!+a,w=(a?f[0]!:1-f[0]!)*(b?f[1]!:1-f[1]!)*(c?f[2]!:1-f[2]!);for(let k=0;k<3;k++)out[k]+=w*(emission[n*3+k]!+scatter[n*3+k]!);out[3]+=w*dust[n]!;}};
 const display=(v:Float64Array):number[]=>{const q=[Math.max(0,v[0]!+num(camera.camRG)*v[1]!+num(camera.camRB)*v[2]!)*num(camera.wbSkyR),Math.max(0,num(camera.camGR)*v[0]!+v[1]!+num(camera.camGB)*v[2]!),Math.max(0,num(camera.camBR)*v[0]!+num(camera.camBG)*v[1]!+v[2]!)*num(camera.wbSkyB)],grey=q.reduce((s,v)=>s+v,0)/3;return q.map(v=>Math.min(1,Math.asinh(Math.max(0,grey+num(camera.camSaturation)*(v-grey))*.044094241663168915*6)/Math.asinh(6))**.9);};
 return{render(c:GalaxyRayCamera,step=.04){const result=new Float64Array(c.width*c.height*3),s=new Float64Array(4),light=new Float64Array(3),trans=new Float64Array(3);for(let y=0;y<c.height;y++)for(let x=0;x<c.width;x++){const{origin:o,direction:d}=c.ray(x+.5,y+.5);let lo=0,hi=Infinity;for(let a=0;a<3;a++){if(Math.abs(d[a]!)<1e-12){if(o[a]!<box[a*2]!||o[a]!>box[a*2+1]!)hi=-1;}else{const aa=(box[a*2]!-o[a]!)/d[a]!,bb=(box[a*2+1]!-o[a]!)/d[a]!;lo=Math.max(lo,Math.min(aa,bb));hi=Math.min(hi,Math.max(aa,bb));}}if(lo>=hi)continue;const count=Math.ceil((hi-lo)/step),ds=(hi-lo)/count;light.fill(0);trans.fill(1);for(let k=0;k<count;k++){const t=lo+(k+.5)*ds;sample(o[0]+d[0]*t,o[1]+d[1]*t,o[2]+d[2]*t,s);for(let a=0;a<3;a++){const tau=s[3]!*extinction[a]!*ds;light[a]+=trans[a]!*s[a]!*ds*(tau>1e-12?-Math.expm1(-tau)/tau:1);trans[a]*=Math.exp(-tau);}}const q=display(light);for(let a=0;a<3;a++)result[(y*c.width+x)*3+a]=q[a]!;}return result;}};
}
export async function installedMilkyWay(){const base='src/objects/milky-way-volume/prepared/b30-slices/',p=rec(await json(base+'prototype.json')),planes:GalaxyDecodedPlane[]=[];for(const value of array(p.leaves)){const r=rec(value),a='xyz'.indexOf(String(r.axis));need(a===0||a===1||a===2,'Invalid installed MW axis');const b=array(r.imageBounds).map(num);need(b.length===4,'Missing installed MW image bounds');const{data,info}=await sharp(base+String(r.texturePath)).ensureAlpha().raw().toBuffer({resolveWithObject:true});planes.push({axis:a,index:num(r.index),center:num(r.center),width:info.width,height:info.height,rgba:data,imageBounds:[b[0]!,b[1]!,b[2]!,b[3]!]});}return planes;}
export async function benchmarkMilkyWay(only?:string){await mkdir(MW_NEAR_DIRECTORY,{recursive:true});const started=performance.now(),field=await loadMilkyWayField(),planes=await installedMilkyWay(),box:GalaxyBankBox={min:[-7.723,-16,-3.2],max:[24.277,16,3.2]},rows=[];for(const v of galaxyNearStations(128,16,[8.277,0,0])){const c=v.camera;if(only&&c.name!==only)continue;const t=performance.now(),code=field.render(c),target={name:c.name,axis:v.axis,camera:c,linear:Float64Array.from(code,linear),annuli:nearAnnuli(c,[8.277,0,0],16)},rgb=compositeGalaxyStack(planes,box,c,v.axis),row=nearResiduals(rgb,target);rows.push(row);await writeFile(MW_NEAR_DIRECTORY+c.name+'-reference.f64le',Buffer.from(code.buffer));for(const[k,values]of[['reference',code],['slabs',rgb]] as const)await sharp(Uint8Array.from(values,v=>Math.round(Math.min(1,Math.max(0,v))*255)),{raw:{width:128,height:128,channels:3}}).png().toFile(MW_NEAR_DIRECTORY+c.name+'-'+k+'.png');await writeFile(MW_NEAR_DIRECTORY+c.name+'.json',JSON.stringify({...row,seconds:(performance.now()-t)/1000},null,2)+'\n');console.log(JSON.stringify({sentinel:'MW_NEAR_VIEW_COMPLETE',...row,seconds:(performance.now()-t)/1000}));}
 const result={complete:true,grid:128,nearDistanceKpc:24,frameWidthKpc:16,stepPc:40,bank:'Installed 13/13/7 merged-copy PNGs, decoded with their actual cropped image bounds',reference:'Restored extended spectral field, trilinear nodes, per-channel escape, fixed accepted camera and outside display; no fitting',seconds:(performance.now()-started)/1000,rssBytes:process.memoryUsage().rss,rows};await writeFile(MW_NEAR_DIRECTORY+(only?'pilot.json':'result.json'),JSON.stringify(result,null,2)+'\n');console.log('MW_NEAR_BENCHMARK_COMPLETE');return result;}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await benchmarkMilkyWay(process.argv[2]);
