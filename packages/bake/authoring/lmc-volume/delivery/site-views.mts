/** Saved views use the shared world-camera conversion; every view has the same physical image scale. */
import{writeFile,mkdir}from'node:fs/promises';import{pathToFileURL}from'node:url';import{parsePreparedWorldCameraFrame}from'@cssearth/objects';import{worldQuaternionFromRotation,worldRotationCss,type WorldCameraPose}from'@cssearth/engine';import{presentWorldCamera,formatSharedView}from'@cssearth/renderer/navigation';import{modelFarViews,FAR_DIR}from'./far-model.mts';import{deliveryPhysicalFrame,bodyDirectionToIcrs,KPC_M}from'./delivery-frame.mts';import{DISTANCE,ORIGIN_ICRS,add,mul,type V3}from'../geometry.mts';import{json,rec,need}from'../inputs.mts';
export const SITE_DIR=FAR_DIR+'site/',VIEW_WIDTH_KPC=9.472846397112237;
export function siteWorld(viewId:string):WorldCameraPose{const view=modelFarViews().find(v=>v.id===viewId);need(view,'Unknown site view');const distance=viewId==='earth'?DISTANCE:15,positionM:V3=viewId==='earth'?[0,0,0]:mul(add(ORIGIN_ICRS,bodyDirectionToIcrs(mul(view.back,distance))),KPC_M),right=bodyDirectionToIcrs(view.right),up=bodyDirectionToIcrs(mul(view.down,-1)),back=bodyDirectionToIcrs(view.back);return{referenceFrame:'sun-icrf',epochJdTt:deliveryPhysicalFrame().epochJdTt,pose:{positionM,orientationXyzw:worldQuaternionFromRotation([right[0],up[0],back[0],right[1],up[1],back[1],right[2],up[2],back[2]])},projectionScale:distance/(VIEW_WIDTH_KPC*Math.sqrt(3)/2)};}
export async function siteViewLinks(origin:string){need(/^http:\/\/(127\.0\.0\.1|localhost):\d+$/u.test(origin),'Only a local development origin is allowed');const frame=parsePreparedWorldCameraFrame(rec(rec(await json('src/objects/lmc/object.json')).properties).worldFrame);need(frame,'Missing LMC world frame');const rows=['earth','pz','tilt45','py'].map(id=>{const world=siteWorld(id),p=presentWorldCamera(world,frame,{focalPixels:1024*Math.sqrt(3)/2,principalOffsetPixels:[0,0],widthPixels:1024,heightPixels:768}),bodyCenterKilometers:[number,number,number]=[p.bodyCenterUnits[0]*frame.metersPerUnit/1000,p.bodyCenterUnits[1]*frame.metersPerUnit/1000,p.bodyCenterUnits[2]*frame.metersPerUnit/1000],query=formatSharedView({camera:{distanceKilometers:Math.hypot(...bodyCenterKilometers),bodyCenterKilometers,projectionScale:world.projectionScale,pose:{schema:'cssearth-camera-pose@2',scene:worldRotationCss(p.rotation)}},preparedEpochJdTt:frame.epochJdTt,playback:{times:[],speed:1,motionRequested:false}});return{id,name:id==='pz'?'face-on':id==='py'?'edge-on':id==='tilt45'?'45 degrees':'Earth',url:origin+'/lmc/?'+query,physicalWidthKpc:VIEW_WIDTH_KPC,pcPerPixelAt1024:VIEW_WIDTH_KPC/1024*1000,world};});await mkdir(SITE_DIR,{recursive:true});await writeFile(SITE_DIR+'views.json',JSON.stringify(rows,null,2)+'\n');return rows;}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)console.log(JSON.stringify(await siteViewLinks(process.argv[2]??'http://127.0.0.1:4312'),null,2));
