/** The 128 px near pilot. Physical references and source textures retain the native numerical sampling. */
import {mkdir,writeFile,readFile} from 'node:fs/promises';import {pathToFileURL} from 'node:url';import sharp from 'sharp';
import {approvedScene,APPROVED_COMMIT} from './reference.mts';import {refineFields} from './refined-fields.mts';
import {projectLmcSlab,readLocalPlanes} from './slab-source.mts';
import {projectCatalogue,catalogueBasis} from '../catalogue-render.mts';import {gradedPrediction} from '../grade.mts';
import {galaxyNearStations} from '../../milky-way-dust/galaxy-near-cameras.mts';
import {planeLayout,planeCamera,bankSpec,writeGalaxyModelBank,type GalaxyPlane,compositeGalaxyStack,hybridGalaxyPlanes,encodeGalaxyPlane,selectDenseSlabs} from '../../milky-way-dust/galaxy-fitted-bank.mts';
import {fitGalaxyBank,evaluateGalaxyBank,type GalaxyFitTarget} from '../../milky-way-dust/galaxy-bank-fit.mts';
import {json,rec,num,need} from '../inputs.mts';import {nearAnnuli,nearResiduals,encoded} from './milky-way-near.mts';
import {prepareGalaxyCompositor} from '../../milky-way-dust/galaxy-compositor-cache.mts';
import {qualifyNearRows} from './near-qualification.mts';
import {hybridOpticalOpacity} from '@cssearth/core';
export const NEAR_DIR='src/objects/lmc-volume/.local/versions/l36/delivery/near-128/';
export const NEAR_SPEC=bankSpec({box:{min:[-10,-10,-2.1],max:[10,10,2.1]},counts:[10,9,7],size:512,record:'source/preparation/l36/fit.json',texturePrefix:'l36-near',hybrid:{densePerAxis:[2,2,3]}});
export async function nearJob(kind:'plane'|'reference',index:number){
 await mkdir(NEAR_DIR,{recursive:true});const started=performance.now(),source=await approvedScene();await refineFields(source.scene);
 if(kind==='plane'){const descriptors=([0,1,2]as const).flatMap(axis=>Array.from({length:NEAR_SPEC.counts[axis]},(_,i)=>planeLayout(NEAR_SPEC,axis,i))),layout=descriptors[index];need(layout,'Unknown local slab');const result=projectLmcSlab(source,layout.domain,planeCamera(NEAR_SPEC,layout),true),stem=NEAR_DIR+`local-${layout.axis}-${layout.index}`;await writeFile(stem+'-rgb.f64le',Buffer.from(result.rgb.buffer));await writeFile(stem+'-tau.f64le',Buffer.from(result.tau.buffer));await writeFile(stem+'.json',JSON.stringify({complete:true,approvedCommit:APPROVED_COMMIT,spec:NEAR_SPEC,...layout,stepPc:15,subpixels:4,seconds:(performance.now()-started)/1000,rssBytes:process.memoryUsage().rss},null,2)+'\n');}
 else{const view=galaxyNearStations(128,10)[index];need(view,'Unknown near camera');const rgb=gradedPrediction(catalogueBasis(projectCatalogue(source.scene,view.camera,.015,undefined,undefined,{objectSubpixels:4,cacheFinishedDust:true,gaussianTailSigma:10}),source.scene,source.amplitudes),source.grade);await writeFile(NEAR_DIR+view.camera.name+'-reference.f64le',Buffer.from(rgb.buffer));await sharp(Uint8Array.from(rgb,v=>Math.round(255*Math.min(1,Math.max(0,encoded(v))))),{raw:{width:128,height:128,channels:3}}).png().toFile(NEAR_DIR+view.camera.name+'-reference.png');await writeFile(NEAR_DIR+view.camera.name+'-reference.json',JSON.stringify({complete:true,approvedCommit:APPROVED_COMMIT,stepPc:15,subpixels:4,fields:2048,seconds:(performance.now()-started)/1000},null,2)+'\n');}
 console.log(JSON.stringify({sentinel:'NEAR_JOB_COMPLETE',kind,index,seconds:(performance.now()-started)/1000,rssBytes:process.memoryUsage().rss}));
}
export async function fitNearPilot(measureOnly=false){
 const descriptors:Omit<GalaxyPlane,'rgb'|'tau'>[]=[];for(const axis of[0,1,2]as const)for(let index=0;index<NEAR_SPEC.counts[axis];index++){const p=planeLayout(NEAR_SPEC,axis,index),r=rec(await json(NEAR_DIR+`local-${axis}-${index}.json`));need(r.complete===true&&r.approvedCommit===APPROVED_COMMIT&&r.stepPc===15&&r.subpixels===4&&JSON.stringify(r.spec)===JSON.stringify(NEAR_SPEC),'Incomplete native local plane');descriptors.push(p);}await writeFile(NEAR_DIR+'local-planes.json',JSON.stringify({spec:NEAR_SPEC,planes:descriptors},null,2)+'\n');
 const planes=await readLocalPlanes(NEAR_DIR),targets:GalaxyFitTarget[]=[];for(const{camera,axis}of galaxyNearStations(128,10)){const r=rec(await json(NEAR_DIR+camera.name+'-reference.json'));need(r.complete===true&&r.approvedCommit===APPROVED_COMMIT&&r.stepPc===15&&r.subpixels===4&&r.fields===2048,'Incomplete native near reference');const b=await readFile(NEAR_DIR+camera.name+'-reference.f64le');need(b.length===128*128*3*8,'Incomplete near pixels');targets.push({name:camera.name,axis,camera,linear:new Float64Array(Uint8Array.from(b).buffer),annuli:nearAnnuli(camera,[0,0,0],10)});}
 const baseline=rec(await json('output/lmc-approved-delivery/mw-near-128/result.json'));need(baseline.complete===true&&baseline.grid===128,'The matched 128 px Milky Way baseline must complete first');const started=performance.now();if(measureOnly){const measured=evaluateGalaxyBank(planes,NEAR_SPEC,targets,Array.from({length:3},()=>({rgb:[1,1,1] as [number,number,number],gamma:1,dust:1}))),seconds=(performance.now()-started)/1000,identity=Array.from({length:3},()=>({rgb:[1,1,1] as [number,number,number],gamma:1,dust:1})),dense=selectDenseSlabs(planes,NEAR_SPEC),decoded=hybridGalaxyPlanes(planes,identity,dense),compositors=new Map(targets.map(t=>[t.name,prepareGalaxyCompositor(decoded,NEAR_SPEC.box,t.camera,t.axis)])),t=performance.now(),cached=evaluateGalaxyBank(planes,NEAR_SPEC,targets,identity,dense,compositors),cachedSeconds=(performance.now()-t)/1000;need(cached.images.every((image,i)=>image.every((v,j)=>v===measured.images[i]![j])),'Cached compression evaluation changed pixels');await writeFile(NEAR_DIR+'fit-timing.json',JSON.stringify({complete:true,secondsPerFullEvaluation:seconds,cachedSecondsPerFullEvaluation:cachedSeconds,exactPixels:true,estimatedFitSeconds:cachedSeconds*1200,baselineRows:measured.rows},null,2)+'\n');console.log('NEAR_FIT_TIMING_COMPLETE '+seconds);return;}const timing=rec(await json(NEAR_DIR+'fit-timing.json'));need(timing.complete===true,'Measure an exact fit evaluation before running the bounded search');const fit=fitGalaxyBank(planes,NEAR_SPEC,targets);await writeFile(NEAR_DIR+'compression-fit.json',JSON.stringify({fits:fit.fits,dense:fit.dense,trajectory:fit.trajectory},null,2)+'\n');await writeGalaxyModelBank(NEAR_DIR+'bank/',NEAR_SPEC,planes,fit.fits,new Set(fit.dense));const decoded=hybridGalaxyPlanes(planes,fit.fits,new Set(fit.dense)),rows=targets.map(t=>nearResiduals(compositeGalaxyStack(decoded,NEAR_SPEC.box,t.camera,t.axis),t));
 let alpha=0,delivered=0;for(const p of planes.filter(p=>p.axis===2)){const original=encodeGalaxyPlane(p,fit.fits[2]!,false),parts=decoded.filter(q=>q.axis===2&&q.index===p.index);for(let i=3;i<original.rgba.length;i+=4){alpha+=original.rgba[i]!/255;let tr=1;for(const q of parts)tr*=1-q.rgba[i]!/255*hybridOpticalOpacity(q.opticalRole!,1);delivered+=1-tr;}}
 const mw=rec(await json('output/lmc-approved-delivery/mw-near-128/result.json')),judged=qualifyNearRows(rows,mw.rows);
 const result={complete:true,passed:judged.every(r=>r.nearPassed),model:36,approvedCommit:APPROVED_COMMIT,physicalParametersFitted:0,freeCompressionParameters:15,referenceGrid:128,textureSize:512,textureCellPc:39.0625,fullTexturePlan:{size:2048,cellPc:9.765625},physicalSlabs:26,opticalLayers:33,fitSeconds:(performance.now()-started)/1000,mergedAlphaFaceOnLossFraction:1-delivered/alpha,comparison:'Matched dimensionless MW near cameras. Per-camera encoded L1 must be no worse than MW; negative light, annulus and channel-share limits are the larger of the original tolerance and achieved MW error. Positive total-light error remains capped at +2%. Optical no-added-light bound is checked separately. Browser mixed-stack results remain a separate gate.',rows:judged};await writeFile(NEAR_DIR+'result.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({sentinel:'NEAR_PILOT_COMPLETE',...result}));return result;
}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url){if(process.argv[2]==='fit'||process.argv[2]==='timing')await fitNearPilot(process.argv[2]==='timing');else{need(process.argv[2]==='plane'||process.argv[2]==='reference','Choose a near job');await nearJob(process.argv[2],num(Number(process.argv[3])));}}
