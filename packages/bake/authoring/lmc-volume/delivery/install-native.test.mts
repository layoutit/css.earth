import test from'node:test';import assert from'node:assert/strict';import{readVolumeAttachment}from'@cssearth/objects';import{applicationDeliveryKind}from'@cssearth/bake/nebula';import{nativeDeliveryRecord}from'./install-native.mts';
test('the installed source uses the existing hosted-bank contract and cannot trigger the retired nebula bake',()=>{const record=nativeDeliveryRecord();assert.equal(readVolumeAttachment(record).attachedTo,'lmc');assert.equal(applicationDeliveryKind('delivery.json',record),null);assert.equal(record.source.datasetId,'horalek-widefield');assert.equal(record.model,'l36');});
