import test from 'node:test';import assert from 'node:assert/strict';import {qualifyNearRows}from'./near-qualification.mts';import {galaxyNearStations}from'../../milky-way-dust/galaxy-near-cameras.mts';
const rows=()=>galaxyNearStations(128,10).map(({camera})=>({name:camera.name,encodedRelativeL1:.1,lightDifferencePercent:-2,annulusDifferencePercent:[0,0,0,0],channelShareDifferencePercentagePoints:[[0,0,0],[0,0,0],[0,0,0]]}));
test('near admission covers every matched camera and never relaxes the positive-light cap',()=>{const b=rows();b[0]!.lightDifferencePercent=50;assert.ok(qualifyNearRows(rows(),b).every(r=>r.nearPassed));for(const mutate of[(v:ReturnType<typeof rows>)=>{v[0]!.encodedRelativeL1=.101;},(v:ReturnType<typeof rows>)=>{v[0]!.lightDifferencePercent=2.01;},(v:ReturnType<typeof rows>)=>{v[0]!.annulusDifferencePercent[0]=10.01;},(v:ReturnType<typeof rows>)=>{v[0]!.channelShareDifferencePercentagePoints[0]![0]=3.01;}]){const r=rows();mutate(r);assert.equal(qualifyNearRows(r,b)[0]!.nearPassed,false);}assert.throws(()=>qualifyNearRows(rows().slice(1),b));});
import {nearResiduals}from'./milky-way-near.mts';
test('near code-space errors compare displayed clipped reference pixels',()=>{const result=nearResiduals(Float64Array.from([1,1,1]),{name:'fixture',axis:2,camera:{width:1,height:1,ray:()=>({origin:[0,0,1],direction:[0,0,-1]})},linear:Float64Array.from([2,2,2]),annuli:Uint8Array.from([0])});assert.ok(result.encodedRelativeL1<1e-14);assert.equal(result.lightDifferencePercent,0);});
