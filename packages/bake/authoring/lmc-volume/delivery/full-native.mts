/** Full native bank, using the accepted projector and frozen pilot encoder. Strips retain the complete camera. */
import {mkdir,readFile,writeFile}from'node:fs/promises';import {spawn}from'node:child_process';import {fileURLToPath,pathToFileURL}from'node:url';import {isDeepStrictEqual}from'node:util';
import {NEAR_DIR,FULL_DIR,nativeBankSpec}from'./near-pilot.mts';import {requireAcceptedPilot}from'./accepted-delivery.mts';import {APPROVED_COMMIT}from'./reference.mts';
import {planeLayout,writeGalaxyModelBank,encodeGalaxyPlane,hybridGalaxyPlanes,type GalaxyBankFit}from'../../milky-way-dust/galaxy-fitted-bank.mts';
import {readLocalPlanes}from'./slab-source.mts';import {array,json,rec,num,numbers,need}from'../inputs.mts';import {hybridOpticalOpacity}from'@cssearth/core';
export const FULL_STRIP_WIDTH=128;
export function fullDescriptors(){const spec=nativeBankSpec(2048);return([0,1,2]as const).flatMap(axis=>Array.from({length:spec.counts[axis]},(_,index)=>planeLayout(spec,axis,index)));}
async function bytes(path:string,length:number){const b=await readFile(path);need(b.length===length*8,'Incomplete native projection bytes');return b;}
export async function verifyPilotStrips(){
 const r=await Promise.all(['rgb','tau'].map(async channel=>{const n=channel==='rgb'?3:1,a=await bytes(NEAR_DIR+`local-2-3-strip-0-256-${channel}.f64le`,256*512*n),b=await bytes(NEAR_DIR+`local-2-3-strip-256-256-${channel}.f64le`,256*512*n),whole=await bytes(NEAR_DIR+`local-2-3-${channel}.f64le`,512*512*n),joined=Buffer.alloc(whole.length);for(let y=0;y<512;y++){a.copy(joined,y*512*n*8,y*256*n*8,(y+1)*256*n*8);b.copy(joined,(y*512+256)*n*8,y*256*n*8,(y+1)*256*n*8);}need(joined.equals(whole),'Full-camera strips changed the accepted whole-plane pixels');return channel;}));await mkdir(FULL_DIR,{recursive:true});await writeFile(FULL_DIR+'strip-replay.json',JSON.stringify({complete:true,channels:r,decodedFloatBytesIdentical:true,plane:'z-3',pilotTextureSize:512},null,2)+'\n');console.log('PILOT_STRIPS_BYTE_IDENTICAL');
}
export async function verifyNativeStrips(){
 for(const[channel,n]of[['rgb',3],['tau',1]]as const){const a=await bytes(FULL_DIR+`local-2-3-strip-768-128-${channel}.f64le`,128*2048*n),b=await bytes(FULL_DIR+`local-2-3-strip-896-128-${channel}.f64le`,128*2048*n),whole=await bytes(FULL_DIR+`local-2-3-strip-768-256-${channel}.f64le`,256*2048*n),joined=Buffer.alloc(whole.length);for(let y=0;y<2048;y++){a.copy(joined,y*256*n*8,y*128*n*8,(y+1)*128*n*8);b.copy(joined,(y*256+128)*n*8,y*128*n*8,(y+1)*128*n*8);}need(joined.equals(whole),'Native strip width changed decoded source pixels');}await writeFile(FULL_DIR+'native-strip-replay.json',JSON.stringify({complete:true,decodedFloatBytesIdentical:true,textureSize:2048,plane:'z-3',largerStripWidth:256,smallerStripWidth:128},null,2)+'\n');console.log('NATIVE_STRIPS_BYTE_IDENTICAL');
}
function requireStrip(value:unknown,axis:number,index:number,left:number,width:number){const r=rec(value),s=rec(r.strip);need(r.complete===true&&r.approvedCommit===APPROVED_COMMIT&&r.axis===axis&&r.index===index&&r.stepPc===15&&r.subpixels===4&&s.left===left&&s.width===width&&isDeepStrictEqual(r.spec,nativeBankSpec(2048)),'Native strip provenance differs from the accepted pilot');return r;}
export async function fullNativeBatch(limit?:2){
 await requireAcceptedPilot();if(!limit)need(rec(await json(FULL_DIR+'pilot-batch.json')).complete===true&&rec(await json(FULL_DIR+'native-strip-replay.json')).decodedFloatBytesIdentical===true,'The bounded native batch and strip replay must precede the full batch');need(rec(await json(FULL_DIR+'strip-replay.json')).decodedFloatBytesIdentical===true,'Whole/strip replay must pass before scaling');const trial=rec(await json(FULL_DIR+'local-2-3-strip-768-128.json'));requireStrip(trial,2,3,768,128);
 const descriptors=fullDescriptors(),allJobs=descriptors.flatMap((p,plane)=>Array.from({length:2048/FULL_STRIP_WIDTH},(_,i)=>({p,plane,left:i*FULL_STRIP_WIDTH}))),jobs=limit?allJobs.filter(j=>j.plane===22&&j.left>=768&&j.left<1024):allJobs,active=new Set<ReturnType<typeof spawn>>(),started=performance.now();let next=0,failed=false;
 for(const signal of['SIGINT','SIGTERM']as const)process.once(signal,()=>{failed=true;for(const child of active)child.kill('SIGTERM');});
 const worker=async()=>{while(next<jobs.length&&!failed){const j=jobs[next++]!,stem=FULL_DIR+`local-${j.p.axis}-${j.p.index}-strip-${j.left}-${FULL_STRIP_WIDTH}`;try{const r=await json(stem+'.json').then(rec).catch(error=>{if(error&&typeof error==='object'&&'code'in error&&error.code==='ENOENT')return null;throw error;});if(r?.complete===true){requireStrip(r,j.p.axis,j.p.index,j.left,FULL_STRIP_WIDTH);await bytes(stem+'-rgb.f64le',FULL_STRIP_WIDTH*j.p.height*3);await bytes(stem+'-tau.f64le',FULL_STRIP_WIDTH*j.p.height);continue;}
  await new Promise<void>((resolve,reject)=>{const child=spawn(process.execPath,['--max-old-space-size=8192',fileURLToPath(new URL('./near-pilot.mts',import.meta.url)),'plane',String(j.plane),'2048',`--strip=${j.left},${FULL_STRIP_WIDTH}`],{stdio:['ignore','pipe','pipe']});active.add(child);let out='',err='';child.stdout.on('data',b=>out+=String(b));child.stderr.on('data',b=>err+=String(b));const timer=setTimeout(()=>child.kill('SIGTERM'),1200000);child.once('error',e=>{active.delete(child);clearTimeout(timer);reject(e);});child.once('close',code=>{active.delete(child);clearTimeout(timer);code===0&&out.includes('NEAR_JOB_COMPLETE')?resolve():reject(new Error(`Native strip ${j.plane}/${j.left} failed: ${err} ${out}`));});});const done=requireStrip(await json(stem+'.json'),j.p.axis,j.p.index,j.left,FULL_STRIP_WIDTH);console.log(JSON.stringify({sentinel:'FULL_NATIVE_STRIP_COMPLETE',plane:j.plane,left:j.left,seconds:done.seconds,rssBytes:done.rssBytes}));}catch(error){failed=true;for(const child of active)child.kill('SIGTERM');throw error;}
 }};const settled=await Promise.allSettled(Array.from({length:4},worker));for(const r of settled)if(r.status==='rejected')throw r.reason;need(!failed,'Native batch interrupted');await writeFile(FULL_DIR+(limit?'pilot-batch.json':'batch.json'),JSON.stringify({complete:true,jobs:jobs.length,workers:4,stripWidth:FULL_STRIP_WIDTH,seconds:(performance.now()-started)/1000},null,2)+'\n');console.log('FULL_NATIVE_BATCH_COMPLETE');
}
export async function encodeFullNative(){
 await requireAcceptedPilot();need(rec(await json(FULL_DIR+'batch.json')).complete===true,'The complete native batch must precede encoding');const spec=nativeBankSpec(2048),descriptors=fullDescriptors();
 for(const p of descriptors){const rgb=Buffer.alloc(p.width*p.height*3*8),tau=Buffer.alloc(p.width*p.height*8);for(let left=0;left<2048;left+=FULL_STRIP_WIDTH){const stem=FULL_DIR+`local-${p.axis}-${p.index}-strip-${left}-${FULL_STRIP_WIDTH}`;requireStrip(await json(stem+'.json'),p.axis,p.index,left,FULL_STRIP_WIDTH);for(const[channel,n,out]of[['rgb',3,rgb],['tau',1,tau]]as const){const b=await bytes(stem+`-${channel}.f64le`,FULL_STRIP_WIDTH*p.height*n);for(let y=0;y<p.height;y++)b.copy(out,(y*p.width+left)*n*8,y*FULL_STRIP_WIDTH*n*8,(y+1)*FULL_STRIP_WIDTH*n*8);}}const stem=FULL_DIR+`local-${p.axis}-${p.index}`;await writeFile(stem+'-rgb.f64le',rgb);await writeFile(stem+'-tau.f64le',tau);}
 await writeFile(FULL_DIR+'local-planes.json',JSON.stringify({spec,planes:descriptors},null,2)+'\n');const planes=await readLocalPlanes(FULL_DIR),frozen=rec(await json(NEAR_DIR+'compression-fit.json')),fits:GalaxyBankFit[]=array(frozen.fits).map(value=>{const r=rec(value),rgb=numbers(r.rgb,3);need(Object.keys(r).sort().join(',')==='dust,emissionOpacity,gamma,rgb','Frozen encoding contains an unrecognized parameter');return{rgb:[rgb[0]!,rgb[1]!,rgb[2]!],gamma:num(r.gamma),dust:num(r.dust),emissionOpacity:num(r.emissionOpacity)};}),dense=new Set(array(frozen.dense).map(v=>{need(typeof v==='string'&&/^[012]:\d+$/u.test(v),'Invalid frozen dense slab');return v;}));need(fits.length===3&&dense.size===7,'The frozen pilot has three fits and seven dense slabs');await writeGalaxyModelBank(FULL_DIR+'bank/',spec,planes,fits,dense);
 let alpha=0,delivered=0;for(const p of planes.filter(p=>p.axis===2)){const original=encodeGalaxyPlane(p,fits[2]!,false),parts=hybridGalaxyPlanes([p],fits,dense);for(let i=3;i<original.rgba.length;i+=4){alpha+=original.rgba[i]!/255;let t=1;for(const q of parts)t*=1-q.rgba[i]!/255*hybridOpticalOpacity(q.opticalRole!,1);delivered+=1-t;}}
 const result={complete:true,model:36,approvedCommit:APPROVED_COMMIT,spec,physicalSlabs:26,opticalLayers:33,physicalParametersChanged:0,encodingParametersChanged:0,fits,dense:[...dense],sourceSampling:{populationCellPc:9.765625,rayStepPc:15,objectSubpixels:4},texturePitchPc:9.765625,mergedAlphaFaceOnLossFraction:1-delivered/alpha,execution:'Complete-camera strips produce the same pixels as the accepted whole-plane projector. Frozen pilot encoding, dense-slab choices and optical coefficients. No refit.'};await writeFile(FULL_DIR+'result.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({sentinel:'FULL_NATIVE_BANK_COMPLETE',...result}));return result;
}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url){if(process.argv[2]==='replay')await verifyPilotStrips();else if(process.argv[2]==='replay-native')await verifyNativeStrips();else if(process.argv[2]==='batch')await fullNativeBatch(process.argv.includes('--pilot')?2:undefined);else{need(process.argv[2]==='encode','Choose replay, batch or encode');await encodeFullNative();}}
