/** Checkpointed model-picture renderer. Windows retain the full camera and object normalization. */
import{mkdir,readFile,writeFile,rename}from'node:fs/promises';import{spawn}from'node:child_process';import{fileURLToPath,pathToFileURL}from'node:url';import sharp from'sharp';
import{FAR_DIR,FAR_RADIUS,FAR_SIZE,modelFarViews,modelFarCamera,modelFarRgba}from'./far-model.mts';import{approvedScene,APPROVED_COMMIT}from'./reference.mts';import{refineFields}from'./refined-fields.mts';import{projectCatalogue,catalogueBasis}from'../catalogue-render.mts';import{gradedPrediction}from'../grade.mts';import{need,json,rec,num}from'../inputs.mts';import{requireAcceptedPilot}from'./accepted-delivery.mts';
const TILE=256,WORKERS=6,SAMPLING={objectSubpixels:4 as const,cacheFinishedDust:true,gaussianTailSigma:10 as const,skipEmptyGaussianRuns:true};
const CONFIG={approvedCommit:APPROVED_COMMIT,size:FAR_SIZE,radiusUnits:FAR_RADIUS,tile:TILE,stepPc:15,objectSubpixels:4,populationCells:2048,gaussianCutoffSigma:10,views:modelFarViews()};
export function sameFarConfiguration(value:unknown,expected:unknown){return JSON.stringify(value)===JSON.stringify(expected);}
function descriptors(){return modelFarViews().flatMap(view=>Array.from({length:(FAR_SIZE/TILE)**2},(_,i)=>({view,left:i%(FAR_SIZE/TILE)*TILE,top:Math.floor(i/(FAR_SIZE/TILE))*TILE,width:TILE,height:TILE})));}
function pilotDescriptors(){return descriptors().filter(j=>(['earth','pz','py'].includes(j.view.id)&&j.left===FAR_SIZE/2&&j.top===FAR_SIZE/2)||(j.view.id==='px'&&j.left===0&&j.top===0)||(j.view.id==='pz'&&j.left===2304&&j.top===1536)||(j.view.id==='earth'&&j.left===0&&j.top===0));}
function stem(j:ReturnType<typeof descriptors>[number]){return FAR_DIR+`native/${j.view.id}-${j.left}-${j.top}`;}
async function completed(j:ReturnType<typeof descriptors>[number]){const path=stem(j);let row;try{row=rec(await json(path+'.json'));}catch(e){if(e&&typeof e==='object'&&'code'in e&&e.code==='ENOENT')return false;throw e;}need(row.complete===true&&sameFarConfiguration(row.configuration,CONFIG)&&sameFarConfiguration(row.window,{left:j.left,top:j.top,width:TILE,height:TILE}),'Far checkpoint configuration changed');need((await readFile(path+'.f64le')).length===TILE*TILE*3*8,'Incomplete far checkpoint pixels');return true;}
function project(source:Awaited<ReturnType<typeof approvedScene>>,view:ReturnType<typeof modelFarViews>[number],size:number,window?:{left:number;top:number;width:number;height:number},accelerated=true){const p=projectCatalogue(source.scene,modelFarCamera(view,size),.015,undefined,undefined,{...SAMPLING,skipEmptyGaussianRuns:accelerated,...(window?{window}:{})});return gradedPrediction(catalogueBasis(p,source.scene,source.amplitudes),source.grade);}
export async function farReplay(){await requireAcceptedPilot();await mkdir(FAR_DIR+'pilot-bounds/',{recursive:true});const source=await approvedScene();await refineFields(source.scene);const rows=[];for(const view of modelFarViews()){const started=performance.now(),whole=project(source,view,128,undefined,false),joined=new Float64Array(whole.length);for(let top=0;top<128;top+=64)for(let left=0;left<128;left+=64){const part=project(source,view,128,{left,top,width:64,height:64});for(let y=0;y<64;y++)joined.set(part.subarray(y*64*3,(y+1)*64*3),((top+y)*128+left)*3);}need(Buffer.from(whole.buffer).equals(Buffer.from(joined.buffer)),'Window/empty-run replay changed '+view.id);await sharp(modelFarRgba(whole),{raw:{width:128,height:128,channels:4}}).png().toFile(FAR_DIR+'pilot-bounds/'+view.id+'.png');const row={view:view.id,seconds:(performance.now()-started)/1000,decodedFloatBytesIdentical:true};rows.push(row);console.log(JSON.stringify({sentinel:'FAR_REPLAY_VIEW_COMPLETE',...row}));}await writeFile(FAR_DIR+'replay.json',JSON.stringify({complete:true,configuration:CONFIG,rows},null,2)+'\n');console.log('FAR_REPLAY_COMPLETE');}
export async function farWorker(worker:number,pilot=false,small=false){await requireAcceptedPilot();await mkdir(FAR_DIR+'native/',{recursive:true});const replay=rec(await json(FAR_DIR+'replay.json'));need(replay.complete===true&&sameFarConfiguration(replay.configuration,CONFIG),'Model replay must precede native rendering');const source=await approvedScene();await refineFields(source.scene);const all=descriptors(),jobs=pilot?pilotDescriptors():all.filter((_,i)=>i%WORKERS===worker);for(const j of(small?jobs.slice(0,2):jobs)){if(await completed(j))continue;const started=performance.now(),rgb=project(source,j.view,FAR_SIZE,{left:j.left,top:j.top,width:TILE,height:TILE});need(rgb.every(v=>Number.isFinite(v)&&v>=0),'Invalid model picture light');await writeFile(stem(j)+'.f64le.tmp',Buffer.from(rgb.buffer));await rename(stem(j)+'.f64le.tmp',stem(j)+'.f64le');const row={complete:true,configuration:CONFIG,window:{left:j.left,top:j.top,width:TILE,height:TILE},seconds:(performance.now()-started)/1000,maxRssBytes:process.resourceUsage().maxRSS*1024};await writeFile(stem(j)+'.json',JSON.stringify(row,null,2)+'\n');console.log(JSON.stringify({sentinel:'FAR_TILE_COMPLETE',view:j.view.id,left:j.left,top:j.top,seconds:row.seconds,maxRssBytes:row.maxRssBytes}));const gc=Reflect.get(globalThis,'gc');if(typeof gc==='function')gc();}console.log('FAR_WORKER_COMPLETE');}
export async function farBatch(small=false){await requireAcceptedPilot();if(!small){const pilot=rec(await json(FAR_DIR+'pilot-batch.json'));need(pilot.complete===true&&pilot.workers===WORKERS&&sameFarConfiguration(pilot.configuration,CONFIG),'The six-worker bounded batch must precede scale');}const nativePilot=pilotDescriptors();for(const j of nativePilot)need(await completed(j),'Native timing pilot must precede full pictures');const started=performance.now(),children=new Set<ReturnType<typeof spawn>>();for(const signal of['SIGINT','SIGTERM']as const)process.once(signal,()=>{for(const child of children)child.kill('SIGTERM');});const results=await Promise.allSettled(Array.from({length:WORKERS},(_,i)=>new Promise<void>((resolve,reject)=>{const child=spawn(process.execPath,['--expose-gc','--max-old-space-size=8192',fileURLToPath(import.meta.url),'worker',String(i),...(small?['--small']:[])],{stdio:['ignore','pipe','pipe']});children.add(child);let sentinel=false,error='';let timer=setTimeout(()=>child.kill('SIGTERM'),1200000);child.stdout.on('data',b=>{clearTimeout(timer);timer=setTimeout(()=>child.kill('SIGTERM'),1200000);const s=String(b);process.stdout.write(s);sentinel||=s.includes('FAR_WORKER_COMPLETE');});child.stderr.on('data',b=>error+=String(b));child.once('error',reject);child.once('close',code=>{clearTimeout(timer);children.delete(child);if(code===0&&sentinel)resolve();else{for(const c of children)c.kill('SIGTERM');reject(new Error('Far worker failed: '+code+' '+error));}});})));for(const result of results)if(result.status==='rejected')throw result.reason;const checked=small?descriptors().slice(0,WORKERS*2):descriptors();for(const j of checked)need(await completed(j),'Missing far checkpoint');await writeFile(FAR_DIR+(small?'pilot-batch.json':'batch.json'),JSON.stringify({complete:true,configuration:CONFIG,workers:WORKERS,tiles:checked.length,seconds:(performance.now()-started)/1000},null,2)+'\n');console.log('FAR_BATCH_COMPLETE');}
export async function assembleFar(){need(rec(await json(FAR_DIR+'batch.json')).complete===true,'Full far batch must complete');await mkdir(FAR_DIR+'pictures/',{recursive:true});for(const view of modelFarViews()){const rgb=new Float64Array(FAR_SIZE*FAR_SIZE*3);for(const j of descriptors().filter(j=>j.view.id===view.id)){need(await completed(j),'Missing far pixels');const b=await readFile(stem(j)+'.f64le'),v=new Float64Array(Uint8Array.from(b).buffer);for(let y=0;y<TILE;y++)rgb.set(v.subarray(y*TILE*3,(y+1)*TILE*3),((j.top+y)*FAR_SIZE+j.left)*3);}await sharp(modelFarRgba(rgb),{raw:{width:FAR_SIZE,height:FAR_SIZE,channels:4}}).png().toFile(FAR_DIR+'pictures/'+view.id+'.png');console.log('FAR_PICTURE_COMPLETE '+view.id);}await writeFile(FAR_DIR+'result.json',JSON.stringify({complete:true,configuration:CONFIG,texturePitchPc:2*FAR_RADIUS/FAR_SIZE*1000,parametersFitted:0,nearFadeKpc:20,farFadeKpc:35,representation:'Direct approved physical model at eight perspective directions, with exact 8-bit RGB on black at each prepared direction. Between directions, the shared renderer interpolates pictures. No slab or photograph is an input.'},null,2)+'\n');console.log('FAR_MODEL_COMPLETE');}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url){const action=process.argv[2];if(action==='replay')await farReplay();else if(action==='pilot')await farWorker(0,true);else if(action==='worker')await farWorker(num(Number(process.argv[3])),false,process.argv.includes('--small'));else if(action==='batch')await farBatch(process.argv.includes('--small'));else{need(action==='assemble','Choose replay, pilot, batch or assemble');await assembleFar();}}
