/** Reproject the preserved photograph by its measured registration into the physical site's Earth camera. */
import{writeFile,mkdir}from'node:fs/promises';import sharp from'sharp';import{pathToFileURL}from'node:url';import{loadObservation}from'../observation.mts';import{modelFarViews}from'./far-model.mts';import{SITE_DIR,VIEW_WIDTH_KPC}from'./site-views.mts';import{bodyDirectionToIcrs}from'./delivery-frame.mts';import{dot,rayInBody,add,mul,normalize,DISTANCE,type V3}from'../geometry.mts';import{pinsFor}from'../owner-rounds/pins.mts';import{need}from'../inputs.mts';
export async function sitePhoto(optics?:{focal:number;principalOffsetPixels:[number,number]}){const o=await loadObservation(16),view=modelFarViews().find(v=>v.id==='earth')!;const width=1024,height=768,focal=optics?.focal??width*DISTANCE/VIEW_WIDTH_KPC,cx=width/2+(optics?.principalOffsetPixels[0]??0),cy=height/2+(optics?.principalOffsetPixels[1]??0),out=Buffer.alloc(width*height*3);for(let y=0;y<height;y++)for(let x=0;x<width;x++){const direction=normalize(add(mul(view.back,-focal),add(mul(view.right,x+.5-cx),mul(view.down,y+.5-cy)))),q=o.pixelOf(bodyDirectionToIcrs(direction));if(!q)continue;const fx=q[0]-.5,fy=q[1]-.5,ix=Math.floor(fx),iy=Math.floor(fy),u=fx-ix,v=fy-iy;if(ix<0||iy<0||ix+1>=o.width||iy+1>=o.height)continue;for(let c=0;c<3;c++)out[(y*width+x)*3+c]=Math.round(255*((o.rawRgb[c]![iy]![ix]!*(1-u)+o.rawRgb[c]![iy]![ix+1]!*u)*(1-v)+(o.rawRgb[c]![iy+1]![ix]!*(1-u)+o.rawRgb[c]![iy+1]![ix+1]!*u)*v));}await mkdir(SITE_DIR,{recursive:true});await sharp(out,{raw:{width,height,channels:3}}).png().toFile(SITE_DIR+'horalek-world.png');const pins=pinsFor(36).map(pin=>{const{direction}=rayInBody(o.rayAt(pin.x*2+.5,pin.y*2+.5)),depth=-dot(direction,view.back);need(depth>0,'Owner pin is behind the camera');return{...pin,siteX:cx+focal*dot(direction,view.right)/depth,siteY:cy+focal*dot(direction,view.down)/depth};});await writeFile(SITE_DIR+'pins.json',JSON.stringify({method:'Measured sky registration only. The physical world camera is right-handed; the old registered raster was viewed from the opposite side of its tangent plane. No source shape or fitted parameter changes.',pins},null,2)+'\n');console.log('LMC_SITE_PHOTO_COMPLETE');return pins;}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await sitePhoto();
