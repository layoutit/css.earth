import test from'node:test';import assert from'node:assert/strict';import{readFile,mkdtemp,rm}from'node:fs/promises';import{tmpdir}from'node:os';import{join}from'node:path';import{bankSpec,planeLayout,writeGalaxyModelBank}from'../../milky-way-dust/galaxy-fitted-bank.mts';import{compileGalaxySliceVolume}from'../../milky-way-dust/galaxy-slice-compile.mts';import{presentPhysicalPoseInVolume,worldRotationFromQuaternion,rotateWorldPosition}from'@cssearth/engine';import{deliveryPhysicalFrame,bodyDirectionToIcrs,KPC_M}from'./delivery-frame.mts';import{DISTANCE,skyToBody,icrsToSky}from'../geometry.mts';
test('shared slice compiler places one model kpc at the measured ICRF distance and orientation',async()=>{const directory=await mkdtemp(join(tmpdir(),'lmc-frame-'));try{const spec=bankSpec({box:{min:[-1,-1,-1],max:[1,1,1]},counts:[1,1,1],size:16,record:'source/preparation/l36/fit.json',texturePrefix:'l36-near'}),planes=([0,1,2]as const).map(axis=>{const p=planeLayout(spec,axis,0);return{...p,rgb:new Float64Array(p.width*p.height*3),tau:new Float64Array(p.width*p.height)};});await writeGalaxyModelBank(directory+'/',spec,planes,Array.from({length:3},()=>({rgb:[1,1,1]as[number,number,number],gamma:1,dust:1})));const input:unknown=JSON.parse(await readFile(directory+'/prototype.json','utf8')),volume=compileGalaxySliceVolume(input,deliveryPhysicalFrame(),directory,'lmc-volume',{record:'source/preparation/l36/fit.json',texturePrefix:'l36-near'});assert.equal(volume.frame.metersPerUnit,KPC_M);const local=presentPhysicalPoseInVolume({positionM:[0,0,0],orientationXyzw:[0,0,0,1]},volume.frame),expected=skyToBody(icrsToSky([0,0,0]));for(let c=0;c<3;c++)assert.ok(Math.abs(local.positionUnits[c]!-expected[c]!)<1e-12);assert.ok(Math.abs(Math.hypot(...local.positionUnits)-DISTANCE)<1e-12);const rotation=worldRotationFromQuaternion(volume.frame.localToReferenceXyzw);for(const axis of[[1,0,0],[0,1,0],[0,0,1]]as[number,number,number][]){const actual=rotateWorldPosition(rotation,axis),expected=bodyDirectionToIcrs(axis);for(let c=0;c<3;c++)assert.ok(Math.abs(actual[c]!-expected[c]!)<1e-12);}}finally{await rm(directory,{recursive:true,force:true});}});
