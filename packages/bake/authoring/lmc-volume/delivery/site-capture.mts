/** Capture the real running application. This does not create a separate viewer. */
import{mkdir,writeFile,readFile}from'node:fs/promises';import{pathToFileURL}from'node:url';import{chromium}from'playwright';import sharp from'sharp';import{SITE_DIR,siteViewLinks,VIEW_WIDTH_KPC}from'./site-views.mts';import{sitePhoto}from'./site-photo.mts';import{need}from'../inputs.mts';import{parseEmbedPageMessage,EMBED_BRIDGE_PROTOCOL}from'@cssearth/renderer/embed/embed-bridge.ts';import{cameraPoseFromReferenceFrame,presentPhysicalPoseInVolume}from'@cssearth/engine';import{deliveryPhysicalFrame,KPC_M}from'./delivery-frame.mts';
export async function captureSite(origin:string){const views=await siteViewLinks(origin);let pins:Awaited<ReturnType<typeof sitePhoto>>=[];await mkdir(SITE_DIR,{recursive:true});const browser=await chromium.launch({headless:true,executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'}),rows=[];try{const page=await browser.newPage({viewport:{width:1024,height:768},deviceScaleFactor:1});const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));for(const view of views){const start=performance.now();const captureUrl=view.url+'&embed';await page.goto(captureUrl,{waitUntil:'domcontentloaded',timeout:120000});console.log('LMC_SITE_DOCUMENT '+view.id);await page.waitForFunction(()=>document.documentElement.dataset.ready==='true',{},{timeout:120000});console.log('LMC_SITE_READY '+view.id);await page.waitForSelector('[data-volume-dataset-object="lmc-volume"]',{state:'attached',timeout:120000});await page.waitForFunction(id=>{const bank=document.querySelector<HTMLElement>('[data-volume-dataset-object="lmc-volume"]');if(!bank||getComputedStyle(bank).display==='none'||Number(getComputedStyle(bank).opacity)<.9)return false;const node=bank.querySelector<HTMLElement>(id==='earth'?'.css-volume-impostors':'.css-volume-detail');return node!==null&&getComputedStyle(node).display!=='none'&&Number(getComputedStyle(node).opacity)>.9;},view.id,{timeout:120000});await page.evaluate(async()=>{await document.fonts.ready;const urls=new Set([...document.querySelectorAll<HTMLElement>('[data-volume-dataset-object="lmc-volume"] .css-volume-detail s,[data-volume-dataset-object="lmc-volume"] .css-volume-impostors s')].flatMap(n=>[...getComputedStyle(n).backgroundImage.matchAll(/url\("?([^"\)]+)"?\)/gu)].map(m=>m[1]!)));await Promise.all([...urls].map(async url=>{const image=new Image();image.src=url;await image.decode();}));await new Promise<void>(r=>requestAnimationFrame(()=>requestAnimationFrame(()=>r())));});const optics=await page.evaluate(()=>{const api:unknown=Reflect.get(window,'__lmc');if(!api||typeof api!=='object')throw Error('Missing real object diagnostics');const read:unknown=Reflect.get(api,'view');if(typeof read!=='function')throw Error('Missing real camera state');const state:unknown=read.call(api);if(!state||typeof state!=='object')throw Error('Missing camera state');const focal:unknown=Reflect.get(state,'focal'),offset:unknown=Reflect.get(state,'principalOffset');if(typeof focal!=='number'||!Number.isFinite(focal)||!Array.isArray(offset)||offset.length!==2)throw Error('Invalid actual camera optics');const x:unknown=offset[0],y:unknown=offset[1];if(typeof x!=='number'||typeof y!=='number'||!Number.isFinite(x)||!Number.isFinite(y))throw Error('Invalid actual principal offset');const principalOffsetPixels:[number,number]=[x,y],runtime:unknown=Reflect.get(api,'runtime');if(!runtime||typeof runtime!=='object')throw Error('Missing runtime diagnostics');const readRuntime:unknown=Reflect.get(runtime,'view');if(typeof readRuntime!=='function')throw Error('Missing published view');const published:unknown=readRuntime.call(runtime);if(!published||typeof published!=='object')throw Error('No published camera');return{focal,principalOffsetPixels,world:Reflect.get(published,'worldCamera'),viewport:Reflect.get(published,'stageViewport')};});const actual=parseEmbedPageMessage({protocol:EMBED_BRIDGE_PROTOCOL,type:'camera',camera:{world:optics.world,viewport:optics.viewport},moving:false});need(actual?.type==='camera','The real site did not expose a valid published physical camera');const delta=cameraPoseFromReferenceFrame(actual.camera.world.pose,{originM:view.world.pose.positionM,localToReferenceXyzw:view.world.pose.orientationXyzw});need(Math.hypot(...delta.positionM)/KPC_M<1e-6&&Math.abs(delta.orientationXyzw[3])>1-1e-8,'The real site moved the saved physical observer');const local=presentPhysicalPoseInVolume(actual.camera.world.pose,{...deliveryPhysicalFrame(),metersPerUnit:KPC_M,boundsUnits:{min:[-10,-10,-2.1],max:[10,10,2.1]}}),widthKpc=1024*Math.hypot(...local.positionUnits)/actual.camera.viewport.focalPixels;need(Math.abs(widthKpc/VIEW_WIDTH_KPC-1)<1e-4,'The real site changed the requested physical scale');if(view.id==='earth')pins=await sitePhoto({focal:actual.camera.viewport.focalPixels,principalOffsetPixels:[actual.camera.viewport.principalOffsetPixels[0],actual.camera.viewport.principalOffsetPixels[1]]});const state=await page.evaluate(()=>({ready:document.documentElement.dataset.ready,detail:[...document.querySelectorAll<HTMLElement>('[data-volume-dataset-object="lmc-volume"] .css-volume-detail')].map(n=>({display:getComputedStyle(n).display,opacity:getComputedStyle(n).opacity,leaves:n.querySelectorAll('s').length})),far:[...document.querySelectorAll<HTMLElement>('[data-volume-dataset-object="lmc-volume"] .css-volume-impostors')].map(n=>({display:getComputedStyle(n).display,opacity:getComputedStyle(n).opacity,views:[...n.querySelectorAll<HTMLElement>('s')].filter(v=>getComputedStyle(v).display!=='none').map(v=>v.dataset.volumeImpostor)}))}));need(state.ready==='true'&&state.far.length>0,'The real site did not mount the volume bank');need(view.id==='earth'?state.far.some(n=>n.display!=='none'&&n.views.includes('earth')):state.detail.some(n=>n.display!=='none'),'The real site did not select its expected far/near presentation');await page.screenshot({path:SITE_DIR+view.id+'.png'});rows.push({id:view.id,url:view.url,captureUrl,state,optics:{focalPixels:actual.camera.viewport.focalPixels,principalOffsetPixels:actual.camera.viewport.principalOffsetPixels,physicalWidthKpc:widthKpc,world:actual.camera.world},loadSeconds:(performance.now()-start)/1000});console.log('LMC_SITE_VIEW_CAPTURED '+view.id);}need(errors.length===0,'Real-site errors: '+errors.join('; '));}finally{await browser.close();}
 const images=[SITE_DIR+'earth.png',SITE_DIR+'horalek-world.png',SITE_DIR+'pz.png',SITE_DIR+'tilt45.png',SITE_DIR+'py.png'],panels=await Promise.all(images.map(path=>sharp(path).resize(768,576).png().toBuffer())),title=Buffer.from('<svg xmlns="http://www.w3.org/2000/svg" width="2304" height="1232"><rect width="100%" height="100%" fill="#101216"/><g fill="white" font-family="Arial" font-size="24"><text x="12" y="30">Real site: Earth distance</text><text x="780" y="30">Horálek: measured sky registration</text><text x="1548" y="30">Face-on: near slabs</text><text x="12" y="646">45 degrees: near slabs</text><text x="780" y="646">Edge-on: near slabs</text><text x="1548" y="646">All views: 9.47 kpc across at 1024 px</text></g></svg>');await sharp(title).composite(panels.map((input,i)=>({input,left:i%3*768,top:Math.floor(i/3)*616+40}))).png().toFile(SITE_DIR+'sheet.png');
 for(const pin of pins){const left=Math.round(pin.siteX)-30,top=Math.round(pin.siteY)-30;if(left<0||top<0||left+61>1024||top+61>768)continue;const crops=await Promise.all(['horalek-world','earth'].map(id=>sharp(SITE_DIR+id+'.png').extract({left,top,width:61,height:61}).resize(305,305,{kernel:'nearest'}).png().toBuffer()));await sharp({create:{width:610,height:305,channels:3,background:'#000'}}).composite(crops.map((input,i)=>({input,left:i*305,top:0}))).png().toFile(SITE_DIR+'pin-'+pin.id+'.png');}
 await writeFile(SITE_DIR+'result.json',JSON.stringify({complete:true,realSite:true,viewport:{width:1024,height:768,dpr:1},physicalWidthKpc:9.472846397112237,pcPerPixel:9.250826559679918,views:rows,pinCropWidth:61,comparison:'Horálek is reprojected using its recorded astrometric registration. The physical camera remains right-handed. The photograph includes its display sky; galaxy textures do not bake that background into the model.'},null,2)+'\n');need((await readFile(SITE_DIR+'sheet.png')).length>100000,'The site sheet is empty');console.log('LMC_REAL_SITE_CAPTURE_COMPLETE');}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await captureSite(process.argv[2]??'http://127.0.0.1:4312');
