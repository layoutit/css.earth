import test from'node:test';import assert from'node:assert/strict';import{parsePreparedWorldCameraFrame}from'@cssearth/objects';import{parseSharedView,savedWorldCamera}from'@cssearth/renderer/navigation';import{cameraPoseFromReferenceFrame}from'@cssearth/engine';import{siteViewLinks,VIEW_WIDTH_KPC}from'./site-views.mts';import{json,rec,need}from'../inputs.mts';import{KPC_M}from'./delivery-frame.mts';
test('real-site saved URLs restore the physical Earth observer and equal-scale near cameras',async()=>{const frame=parsePreparedWorldCameraFrame(rec(rec(await json('src/objects/lmc/object.json')).properties).worldFrame);need(frame,'Missing fixture world frame');const views=await siteViewLinks('http://127.0.0.1:4312');assert.equal(views.length,4);assert.deepEqual(views[0]!.world.pose.positionM,[0,0,0]);for(const v of views){const saved=parseSharedView(new URL(v.url).search);assert.ok(saved);const restored=savedWorldCamera(saved,frame,{focalPixels:1024*Math.sqrt(3)/2,principalOffsetPixels:[0,0]}),delta=cameraPoseFromReferenceFrame(restored.pose,{originM:v.world.pose.positionM,localToReferenceXyzw:v.world.pose.orientationXyzw});assert.ok(Math.hypot(...delta.positionM)/KPC_M<1e-9,'Saved camera must preserve the physical eye');assert.ok(Math.abs(delta.orientationXyzw[3])>1-1e-12);assert.equal(restored.projectionScale,v.world.projectionScale);assert.equal(v.pcPerPixelAt1024,VIEW_WIDTH_KPC/1024*1000);}});
