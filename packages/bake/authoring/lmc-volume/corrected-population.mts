/** Apply published, image-independent completeness to the saved l20 tracer. */
import {readFile,writeFile} from 'node:fs/promises';import sharp from 'sharp';
import {L21,loadCompleteness,tcgCompleteness} from './completeness.mts';import {loadOld,insidePolygon,RC_POLYGON} from './gaia-old.mts';
import {at,num,rec,json,makeRaster,need,type Raster,type Sources} from './inputs.mts';import {gaiaWarpLocator} from './gaia-plane.mts';
import {densityFromMembers} from './gaia-density.mts';import {splitOldDensity,densityMoments,saveGaiaPoints,vmcCheck} from './gaia-old-model.mts';
import type {CatalogueScene} from './catalogue-scene.mts';export function correctedLightDensity(stars:Parameters<typeof densityFromMembers>[0],sources:Sources,flux:ArrayLike<number>,probability:ArrayLike<number>,n=512,half=10){need(stars.length===flux.length&&stars.length===probability.length,'Completeness dimensions differ');const weights=Float64Array.from({length:stars.length},(_,i)=>{need(Number.isFinite(probability[i])&&probability[i]>.005&&probability[i]<=1,'Invalid inclusion probability');return flux[i]/probability[i];});return densityFromMembers(stars,sources,n,half,undefined,.1,weights);}
export async function correctedPopulationSamples(scene:CatalogueScene,allTracers=false){const old=await loadOld(),stars=[...old.points,...old.density.filter(s=>s.g>=18)],survey=await loadCompleteness(),stat=rec(await json(L21+'crowding-statistics.json')),n=num(stat.n),half=num(stat.halfKpc),maps:Raster[]=[];for(let k=0;k<3;k++){const raw=await readFile(L21+`crowding-${k}.f32le`),mask=await readFile(L21+`crowding-${k}.mask.u8`);need(raw.length===n*n*4&&mask.length===n*n,'Incomplete crowding map');maps.push({n,half,values:new Float32Array(Uint8Array.from(raw).buffer),mask:Uint8Array.from(mask)});}const locate=gaiaWarpLocator(scene.sources),weights=new Float64Array(stars.length),rawWeights=new Float64Array(stars.length),probabilities=new Float64Array(stars.length),summary=Array.from({length:3},()=>({n:0,min:1,flux:0,corrected:0,low:0,unknown:0}));
 for(let i=0;i<stars.length;i++){const s=stars[i],p=locate(s.ra,s.dec),r=Math.hypot(p[0],p[1]),g=s.g<18?0:s.bp!==null&&s.rp!==null&&insidePolygon(s.bp-s.rp,s.g,RC_POLYGON)?1:2;let probability=1;if(r<9){probability=tcgCompleteness(s.g,survey.atStar(s.id));if(g===1||allTracers){const crowd=at(maps[g],p[0],p[1]);if(crowd>0)probability=Math.min(probability,crowd);else summary[r<1.5?0:r<4?1:2].unknown++;}need(probability>.005,'A completeness below 0.5 percent is too uncertain to invert');}const flux=10**(-.4*(s.g-20))*(s.g<18?1:18.11709771);rawWeights[i]=flux;probabilities[i]=probability;weights[i]=flux/probability;if(r<9){const a=summary[r<1.5?0:r<4?1:2];a.n++;a.flux+=flux;a.corrected+=weights[i];a.min=Math.min(a.min,probability);}}
 return{stars,rawWeights,probabilities,maps,stat,summary,n,half,survey};
}
export async function correctedPopulation(scene:CatalogueScene,allTracers=false){need(scene.oldPopulation,'Missing l20 stellar field');const parent=scene.oldPopulation,{stars,rawWeights,probabilities,maps,stat,summary,n,survey}=await correctedPopulationSamples(scene,allTracers);
 const raw=densityFromMembers(stars,scene.sources,512,10,undefined,.1,rawWeights),total=correctedLightDensity(stars,scene.sources,rawWeights,probabilities),split=splitOldDensity(total),oldMeta=rec(await json(L21+'../l20/old-population.json')),points={...parent.points,rgb:parent.points.rgb.slice()},sums=[0,0,0,0],budget=[split.discMass*1.2842040336717868,split.barMass*1.2842040336717868,0,.15];for(let i=0;i<points.count;i++)sums[points.components[i]]+=points.rgb[i*3+1];for(let i=0;i<points.count;i++){const component=points.components[i];if(component===3)continue;for(let c=0;c<3;c++)points.rgb[i*3+c]*=budget[component]/sums[component];}scene.oldPopulation={...parent,disc:split.disc,bar:split.bar,points};const vmc=await vmcCheck(total,scene.sources);await writeFile(L21+'vmc-check.json',JSON.stringify(vmc,null,2)+'\n');const metadata={...oldMeta,version:21,parent:20,barMass:split.barMass,discMass:split.discMass,barMeasured:densityMoments(split.bar),vmcCheck:{regions:vmc.regions,correlation:vmc.pearsonCorrelation},completeness:{method:allTracers?'Rathore/Olsen crowding model applied to each old tracer, with measured intrinsic RGB scatters.':'Rathore/Olsen HST-tested crowding recovery for RC; Cantat-Gaudin parent selection for RGB. The union is corrected by individual inverse inclusion probability.',allTracers,parentFunction:survey.summary,crowding:stat,regions:summary.map((v,i)=>({region:i,stars:v.n,minimumCompleteness:v.min,fluxCorrection:v.corrected/v.flux,unknownCrowding:v.unknown})),combination:'The lower of parent catalogue inclusion and the crowding recovery estimate is used, avoiding an independence assumption and double multiplication. No completeness parameter is fitted to the photo.',sourceLimits:'Rathore calibrates red-clump completeness. RGB extrapolation is an explicit alternative only. The parent Gaia function alone does not qualify extra CMD, BP/RP or proper-motion selection completeness.'},preservation:'Point positions, component assignments, colors relative to each population, adopted thicknesses, young density, catalogue objects, dust, plane and warp stay at l20. Point RGB is globally renormalized per old component to share the corrected smooth-light budget.'};await writeFile(L21+'old-population.json',JSON.stringify(metadata,null,2)+'\n');for(const [name,map]of [['old-disc',split.disc],['old-bar',split.bar]] as const)await writeFile(L21+name+'.f32le',Buffer.from(map.values.buffer));await saveGaiaPoints(L21,points);
 const max=Array.from(raw.values).sort((a,b)=>a-b)[Math.floor(raw.values.length*.995)],panels=[];for(const map of [raw,total,maps[1]]){const image=Buffer.alloc(n*n*3);for(let y=0;y<n;y++)for(let x=0;x<n;x++){const i=y*n+x,j=((n-1-y)*n+x)*3,q=map.values[i];if(!map.mask[i]){image[j]=image[j+1]=image[j+2]=50;continue;}if(map===maps[1]){image[j]=Math.round(225*(1-q)+25*q);image[j+1]=Math.round(70*(1-q)+225*q);image[j+2]=Math.round(40*(1-q)+230*q);}else{const v=Math.max(0,Math.min(1,Math.asinh(12*q/max)/Math.asinh(12)));image[j]=Math.round(255*v);image[j+1]=Math.round(242*v);image[j+2]=Math.round(215*v);}}panels.push(await sharp(image,{raw:{width:n,height:n,channels:3}}).png().toBuffer());}const title=Buffer.from('<svg xmlns="http://www.w3.org/2000/svg" width="1536" height="610"><rect width="100%" height="100%" fill="#101216"/><g fill="white" font-family="Arial" font-size="20"><text x="12" y="28">l20 · observed Gaia light density</text><text x="524" y="28">l21 · completeness-corrected density</text><text x="1036" y="28">RC recovery fraction · red low, cyan high</text><text x="12" y="582" font-size="16">Disc plane, 20 kpc across. First two maps have unit integral and the same display scale. Grey: no crowding measurement.</text><text x="12" y="604" font-size="16">Published completeness, not an image-fitted weight. Adaptive C* measurements: 100–400 pc. Fractions span 0–100%.</text></g></svg>');await sharp(title).composite(panels.map((input,i)=>({input,left:i*n,top:40}))).png().toFile(L21+'completeness-map.png');console.log(JSON.stringify({sentinel:'L21_CORRECTED_POPULATION_READY',regions:metadata.completeness.regions,bar:metadata.barMeasured,vmc:metadata.vmcCheck}));return metadata;
}
