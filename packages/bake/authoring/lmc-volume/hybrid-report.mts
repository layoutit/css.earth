/** Inspect saved l12 geometry and evidence. This never fits or renders a model. */
import {readFile,writeFile} from 'node:fs/promises';
import sharp from 'sharp';
import {LOCAL,json,rec,array,num,numbers,need} from './inputs.mts';
import {L12} from './hybrid-model.mts';
import {unit,rayInBody,normalize,dot,bodyToIcrs,DEG,type V3} from './geometry.mts';
const vector=(v:unknown):V3=>{const a=numbers(v,3);return[a[0],a[1],a[2]];};
interface Clump {p:V3;r:number;weight:number;}
const model=rec(await json(L12+'structure.json')),old=rec(await json(LOCAL+'versions/l11/structure.json')),shapes=array(await json(L12+'object-shapes.json')).map(rec),groups=new Map<string,Clump[]>();
need(JSON.stringify(model.dust)===JSON.stringify(old.dust),'l12 changed l11 dust geometry');
const meta=rec(model.metadata),oldMeta=rec(old.metadata);need(JSON.stringify(meta.dustNormalization)===JSON.stringify(oldMeta.dustNormalization),'l12 changed the Bell column normalization');
for(const entry of array(model.objects)){const v=rec(entry);need(typeof v.id==='string','Missing primitive identity');const id=/^(.*)-shape-\d+$/u.exec(v.id)?.[1];if(!id)continue;const axes=vector(v.axes);need(axes[0]===axes[1]&&axes[1]===axes[2],'An object-local clump became extruded');const list=groups.get(id)??[];list.push({p:vector(v.center),r:axes[0],weight:num(v.weight)});groups.set(id,list);}
let maxWidthError=0,maxFootprintRadius=0,maxSkySupportBound=0;const checks=[];
for(const shape of shapes){need(typeof shape.id==='string','Missing shape identity');const list=groups.get(shape.id);need(list?.length,'A shaped catalogue object is missing');const f=rec(shape.footprint),ra=num(f.ra),dec=num(f.dec),pa=num(f.positionAngleDeg)*DEG,sky=unit(ra,dec),east:V3=[-Math.sin(ra*DEG),Math.cos(ra*DEG),0],north:V3=[-Math.sin(dec*DEG)*Math.cos(ra*DEG),-Math.sin(dec*DEG)*Math.sin(ra*DEG),Math.cos(dec*DEG)],dir=normalize(rayInBody(sky).direction),sum=list.reduce((a,b)=>a+b.weight,0),mean:V3=[0,0,0];
 for(const v of list)for(let c=0;c<3;c++)mean[c]+=v.p[c]*v.weight/sum;let depth=0,width=0;
 for(const v of list){const d:V3=[v.p[0]-mean[0],v.p[1]-mean[1],v.p[2]-mean[2]],z=dot(d,dir),kernel=v.r*v.r/9;depth+=(z*z+kernel)*v.weight/sum;width+=((dot(d,d)-z*z)/2+kernel)*v.weight/sum;
  const position=bodyToIcrs(v.p),distance=Math.hypot(...position),q=normalize(position),den=dot(q,sky),e=dot(q,east)/den,n=dot(q,north)/den,major=num(f.majorDiameterArcmin)/120*DEG,minor=num(f.minorDiameterArcmin)/120*DEG,u=(e*Math.sin(pa)+n*Math.cos(pa))/major,w=(e*Math.cos(pa)-n*Math.sin(pa))/minor,centre=Math.hypot(u,w),support=centre+v.r*Math.sqrt(1+e*e+n*n)/((distance*den-v.r)*Math.min(major,minor));maxFootprintRadius=Math.max(maxFootprintRadius,centre);maxSkySupportBound=Math.max(maxSkySupportBound,support);}
 const error=Math.abs(Math.sqrt(depth/width)-1);maxWidthError=Math.max(maxWidthError,error);checks.push({id:shape.id,depthToSkyRms:Math.sqrt(depth/width),coverage:num(shape.coverage)});
}
need(maxWidthError<.02,'An observed shape has excessive line-of-sight depth');need(maxSkySupportBound<1,'A cutout escaped its own catalogue footprint');
const preservation={dustGeometryMatchesL11:true,bellColumnsMatchL11:true,shapedObjects:shapes.length,maxActualDepthToSkyRmsError:maxWidthError,maxClumpCentreEllipticalFootprintRadius:maxFootprintRadius,maxFullClumpSkySupportBound:maxSkySupportBound,allShapeClumpsIsotropic:true,checks};await writeFile(L12+'geometry-check.json',JSON.stringify(preservation,null,2)+'\n');
const result=rec(await json(L12+'result.json')),r=rec(result.residuals),prior=rec(rec(await json(LOCAL+'versions/l11/result.json')).residuals),l10=rec(rec(await json(LOCAL+'versions/l10/result.json')).residuals),tiny=rec(await json(L12+'tiny/result.json')),population=rec(await json(L12+'young-density.json')),brightness=array(await json(L12+'object-brightness.json')).map(rec),global=brightness.find(v=>v.kind==='population');
const tableRow=(name:string,key:string,format:(v:number)=>string)=>`| ${name} | ${format(num(l10[key]))} | ${format(num(prior[key]))} | ${format(num(r[key]))} |`,notes=`# l12: observed object shapes and a young population\n\nThe catalogue geometry now carries object-local scalar photo or Hα shapes as finite isotropic clumps. ${shapes.length} catalogue entries are shaped; ${shapes.filter(s=>String(s.source).includes('DeMCELS')).length} use DeMCELS. Unresolved or unobserved objects keep their l11 priors. Published 30 Dor substructure remains present.\n\nDiffuse young light comes from ${num(population.selectedBlueCandidates).toLocaleString('en-US')} SMASH blue candidates, with independent catalogue occupancy, normalized gap smoothing and a 150 pc warped layer. The paper continuation is normalized to observed outer counts and blended across the survey boundary. It has one global gain (${global?num(global.amplitude).toFixed(3):'missing'}), separate from cluster luminosities. No photo supplies this population map.\n\n| Earth appearance residual | l10 | l11 | l12 |\n| --- | --- | --- | --- |\n${tableRow('RGB RMS, first checkerboard','trainRelativeRms',v=>v.toFixed(6))}\n${tableRow('RGB RMS, second checkerboard','heldoutRelativeRms',v=>v.toFixed(6))}\n${tableRow('Total diffuse light difference','totalLightDifferencePercent',v=>v.toFixed(2)+'%')}\n\nBoth checkerboards were calibrated. These are appearance residuals, not independent validation. Annular light errors from the centre outward are ${array(r.annularDifferencePercent).map(v=>num(v).toFixed(2)+'%').join(', ')}.\n\nThe old disc, bar, warp, adopted thicknesses and all 424 molecular dust clouds remain l11. Bell columns are unchanged. Actual clump geometry matches depth RMS to sky RMS within ${(maxWidthError*100).toFixed(2)}%; all centres remain inside their own catalogue footprint. Individual depths are adopted, not measured.\n\nTiny took ${num(tiny.seconds).toFixed(1)} seconds; 512 px took ${num(result.seconds).toFixed(1)} seconds. The first round exposed sampling bands and a compact-kernel depth error; the final round fixes both and fades the survey boundary.\n\nSee visual-review.md for the inspection of extrusion, remaining round priors and the northern arm. No full-resolution fit, GPU training, slab bake or external write ran.\n`;
await writeFile(L12+'notes.md',notes);
await sharp({create:{width:3072,height:1668,channels:3,background:'#101216'}}).composite([{input:await readFile(LOCAL+'versions/l11/sheet.png'),left:0,top:0},{input:await readFile(L12+'sheet.png'),left:1536,top:0}]).png().toFile(L12+'l11-l12-side-by-side.png');
console.log(JSON.stringify({sentinel:'L12_SAVED_OUTPUTS_VERIFIED',shapes:shapes.length,maxWidthError,maxFootprintRadius,dustUnchanged:true}));
