/** HERITAGE supplies relative columns; Bell fixes their one global optical-depth budget. */
import {writeFile} from 'node:fs/promises';
import {loadHeritage,L19} from './heritage-input.mts';
import {at,makeRaster,need,type Raster} from './inputs.mts';
import {bodyToIcrs,skyOf,DEG} from './geometry.mts';
import {discSurface} from './model.mts';
import {blur} from './young-density.mts';
import {chord,column} from './catalogue-volume.mts';
import type {CatalogueScene} from './catalogue-scene.mts';
import type {VolumeObject} from './catalogue-volume.mts';
export interface DustLayer {column:Raster;strength:number;retainMolecular?:boolean;clouds?:VolumeObject[];cloudExtinctionRgb?:Float32Array;extinctionRgb?:readonly[number,number,number];}
export function sampleDensity(values:Float64Array,width:number,height:number,x:number,y:number){const i=Math.floor(x),j=Math.floor(y),u=x-i,v=y-j;let mass=0,coverage=0;for(let b=0;b<2;b++)for(let a=0;a<2;a++){if(i+a<0||j+b<0||i+a>=width||j+b>=height)continue;const log=values[(j+b)*width+i+a],w=(a?u:1-u)*(b?v:1-v);if(Number.isFinite(log)){need(log> -10&&log<3,'Implausible HERITAGE log density');mass+=10**log*w;coverage+=w;}}return{value:coverage>0?mass/coverage:0,coverage};}
export function normalizeToBell(map:Raster,bell:Raster){let measured=0,model=0,n=0;for(let y=0;y<bell.n;y+=2)for(let x=0;x<bell.n;x+=2){const i=y*bell.n+x;if(!bell.mask[i])continue;const px=((x+.5)/bell.n*2-1)*bell.half,py=((y+.5)/bell.n*2-1)*bell.half;if(Math.abs(px)>=map.half||Math.abs(py)>=map.half)continue;measured+=bell.values[i];model+=at(map,px,py);n++;}need(n>100&&model>0,'No Bell/HERITAGE calibration overlap');const factor=measured/model;for(let i=0;i<map.values.length;i++)map.values[i]*=factor;return{samples:n,factor,bellMeanFaceOnTauV:measured/n,beforeMeanFaceOnTauV:model/n,afterMeanFaceOnTauV:measured/n};}
export async function makeHeritageLayer(scene:CatalogueScene){
 const {image,wcs,summary}=await loadHeritage(),map=makeRaster(2048,10),molecular=makeRaster(map.n,map.half),coverage=makeRaster(map.n,map.half),cell=2*map.half/map.n,cos=Math.cos(25.86*DEG);map.mask.fill(1);molecular.mask.fill(1);coverage.mask.fill(1);
 const nativeWeights=Float64Array.from(image.values,v=>Number.isFinite(v)?1:0),nativeMass=Float64Array.from(image.values,v=>Number.isFinite(v)?10**v:0),sigma=5*60/56/2.354820045,broadMass=blur(nativeMass,image.width,image.height,sigma),broadWeight=blur(nativeWeights,image.width,image.height,sigma),broadLogs=Float64Array.from(broadMass,(v,i)=>broadWeight[i]>.05&&v>0?Math.log10(v/broadWeight[i]):NaN);
 const sample=(x:number,y:number)=>{const [ra,dec]=skyOf(bodyToIcrs([x,y,at(scene.sources.warp,x,y)])),p=wcs.pixelOf(ra,dec);if(!p)return{value:0,coverage:0,relativeFine:1};const fine=sampleDensity(image.values,image.width,image.height,p[0],p[1]),broad=sampleDensity(broadLogs,image.width,image.height,p[0],p[1]);return{...fine,relativeFine:broad.value>0?fine.value/broad.value:1};};
 let tau=0,mass=0,overlap=0;const bell=scene.sources.dust;for(let y=0;y<bell.n;y+=2)for(let x=0;x<bell.n;x+=2){const i=y*bell.n+x;if(!bell.mask[i])continue;const p=sample(((x+.5)/bell.n*2-1)*bell.half,((y+.5)/bell.n*2-1)*bell.half);if(p.coverage<.999)continue;tau+=bell.values[i];mass+=p.value*cos;overlap++;}need(overlap>100&&mass>0,'Insufficient Bell overlap');const opticalConversion=tau/mass;
 // Preserve the old complete vertical column where the emission-model map is unknown.
 for(let y=0;y<map.n;y++)for(let x=0;x<map.n;x++){const px=((x+.5)/map.n*2-1)*map.half,py=((y+.5)/map.n*2-1)*map.half;map.values[y*map.n+x]=scene.dustArea*(1-scene.molecularFraction)*discSurface(Math.hypot(px,py));}
 for(const d of scene.dust){const rx=Math.sqrt(d.basis.reduce((s,b,k)=>s+(b[0]*d.axes[k])**2,0)),ry=Math.sqrt(d.basis.reduce((s,b,k)=>s+(b[1]*d.axes[k])**2,0)),ix=(x:number)=>Math.floor((x/map.half+1)*map.n/2);for(let y=Math.max(0,ix(d.center[1]-ry)-1);y<=Math.min(map.n-1,ix(d.center[1]+ry)+1);y++)for(let x=Math.max(0,ix(d.center[0]-rx)-1);x<=Math.min(map.n-1,ix(d.center[0]+rx)+1);x++){const p:[number,number,number]=[((x+.5)/map.n*2-1)*map.half,((y+.5)/map.n*2-1)*map.half,30],hit=chord(d,p,[0,0,-1]);if(hit)molecular.values[y*map.n+x]+=scene.dustArea*scene.molecularFraction*d.weight*column(d,hit);}}
 let available=0,floorExcess=0,targetMass=0;for(let y=0;y<map.n;y++)for(let x=0;x<map.n;x++){const i=y*map.n+x,p=sample(((x+.5)/map.n*2-1)*map.half,((y+.5)/map.n*2-1)*map.half),target=p.value*cos*opticalConversion;coverage.values[i]=p.coverage;map.values[i]*=1-p.coverage+p.relativeFine*p.coverage;floorExcess+=Math.max(0,molecular.values[i]-target)*p.coverage;targetMass+=target*p.coverage;if(p.coverage>.999)available++;}
 let measured=0,diffuse=0,clouds=0,samples=0;for(let y=0;y<bell.n;y+=2)for(let x=0;x<bell.n;x+=2){const i=y*bell.n+x,px=((x+.5)/bell.n*2-1)*bell.half,py=((y+.5)/bell.n*2-1)*bell.half;if(!bell.mask[i]||Math.abs(px)>=map.half||Math.abs(py)>=map.half)continue;measured+=bell.values[i];diffuse+=at(map,px,py);clouds+=at(molecular,px,py);samples++;}need(samples>100&&diffuse>0&&measured>clouds,'Bell budget cannot support the retained molecular clouds');const factor=(measured-clouds)/diffuse;for(let i=0;i<map.values.length;i++)map.values[i]*=factor;
 let actual=0;for(let y=0;y<bell.n;y+=2)for(let x=0;x<bell.n;x+=2){const i=y*bell.n+x,px=((x+.5)/bell.n*2-1)*bell.half,py=((y+.5)/bell.n*2-1)*bell.half;if(bell.mask[i]&&Math.abs(px)<map.half&&Math.abs(py)<map.half)actual+=at(map,px,py)+at(molecular,px,py);}need(Math.abs(actual/measured-1)<1e-6,'The combined dust column lost its Bell normalization');
 const normalization={samples,factor,bellMeanFaceOnTauV:measured/samples,beforeMeanFaceOnTauV:(diffuse+clouds)/samples,retainedMolecularMeanFaceOnTauV:clouds/samples,afterMeanFaceOnTauV:actual/samples},metadata={source:summary,paper:'https://doi.org/10.1088/0004-637X/797/2/85',erratum:'https://doi.org/10.3847/1538-4357/aa6042',authorRelease:'https://karllark.github.io/data_magclouds_dustmaps.html',product:'BEMBB, unconstrained beta, expectation estimator, 19 April 2014 release',n:map.n,halfKpc:map.half,cellKpc:cell,availableCells:available,overlapSamples:overlap,rawColumnOpticalConversion:opticalConversion,normalization,layerSigmaKpc:.25,retainMolecular:true,rawMolecularFloorExcessFraction:floorExcess/targetMass,strengthBounds:[.25,2],reconciliationScaleArcmin:5,meaning:'Controlled fine-structure reconciliation: the parent diffuse column is multiplied by HERITAGE Sigma divided by its coverage-normalized five-arcminute Gaussian mean. One global diffuse normalization restores the combined Bell mean, with molecular geometry and opacity retained. This replaces no measured cloud column and adds no independent molecular column twice. Missing HERITAGE cells receive identity modulation.',limits:'This final candidate uses HERITAGE fine structure, not its discrepant coarse column. The two full-column trials failed the fixed RMS guard and are archived. The footprint is detection limited. The unchanged 250 pc vertical layer may wash out fine extinction. No photograph enters density.'};
 await writeFile(L19+'dust-column.f32le',Buffer.from(map.values.buffer));await writeFile(L19+'molecular-column.f32le',Buffer.from(molecular.values.buffer));await writeFile(L19+'dust-coverage.f32le',Buffer.from(coverage.values.buffer));await writeFile(L19+'dust-column.json',JSON.stringify(metadata,null,2)+'\n');return{column:map,strength:1,retainMolecular:true,metadata};
}
