/** Read one completed linear projection. This module never renders or fits. */
import {readFile} from 'node:fs/promises';import {L21} from './completeness.mts';import {json,rec,num,need} from './inputs.mts';import type {StellarFamily} from './stellar-grade.mts';
export async function readFamily(name:string):Promise<StellarFamily>{const path=L21+'cache/'+name+'/',m=rec(await json(path+'metadata.json')),width=num(m.width),height=num(m.height);need(width*height<=512*512,'Unexpected cache size');const read=async(prefix:string)=>{const out=[];for(let i=0;i<5;i++){const b=await readFile(path+prefix+i+'.f64le');need(b.length===width*height*3*8,'Truncated projection cache');const a=new Float64Array(Uint8Array.from(b).buffer);need(a.every(Number.isFinite),'Non-finite projection cache');out.push(a);}return out;};return{base:{width,height,dustGain:1,planes:await read('base')},old:await read('old'),young:await read('young')};}
