/** Seven global contrast controls: old/bar RGB and the single display stretch. */
import {rayPlane} from './geometry.mts';
import {gradedPrediction,type Grade} from './grade.mts';import {displayRgb,ratios,barAperture,photoRgb} from './bar-ratios.mts';
import {makeCutPlan,profileValues,cutStatistics,type CutPlan} from './contrast-profiles.mts';import type {Basis} from './render.mts';import type {Observation} from './report.mts';import type {BarGeometry} from './bar-geometry.mts';import type {CatalogueRow} from './catalogue-data.mts';
export function gradeContrast(basis:Basis,initial:Grade,o:Observation,b:BarGeometry,rows:CatalogueRow[],allowStretch=true){
 const plan=makeCutPlan(o,b,rows),aperture=barAperture(o,b,rows),photo=ratios(photoRgb(o),aperture.mask),selected=new Set<number>(),outerIds:number[]=[];for(let p=0;p<aperture.mask.length;p++){const x=p%o.width,y=Math.floor(p/o.width);if(!o.mask[y][x])continue;const q=rayPlane(o.rayAt(x+.5,y+.5));if(Math.hypot(q[0],q[1])>=4){selected.add(p);outerIds.push(p);}}for(let p=0;p<aperture.mask.length;p++)if(aperture.mask[p])selected.add(p);for(const cut of plan.ids)for(const bin of cut)for(const p of bin)selected.add(p);const ids=[...selected],lookup=new Map(ids.map((p,i)=>[p,i])),sample:Basis={...basis,width:ids.length,height:1,planes:basis.planes.map(v=>Float64Array.from({length:ids.length*3},(_,i)=>v[ids[Math.floor(i/3)]*3+i%3]))},mask=Uint8Array.from(ids,p=>aperture.mask[p]),samplePlan:CutPlan={...plan,ids:plan.ids.map(c=>c.map(v=>v.map(p=>lookup.get(p)!)))},sky=o.metadata.sky.rgbLinearDisplay;
 const outer=outerIds.map(p=>lookup.get(p)!),outerTarget=outerIds.reduce((s,p)=>s+[0,1,2].reduce((a,c)=>a+o.target[c][Math.floor(p/o.width)][p%o.width]/o.metadata.normalization.commonFactor,0),0);
 const evaluate=(grade:Grade)=>{const prediction=gradedPrediction(sample,grade),linear=Float64Array.from(prediction,(v,i)=>v+sky[i%3]),values=profileValues(linear,samplePlan),stats=cutStatistics(values,samplePlan),color=ratios(displayRgb(prediction,sky),mask),outerRatio=outer.reduce((s,p)=>s+prediction[p*3]+prediction[p*3+1]+prediction[p*3+2],0)/Math.max(1e-12,outerTarget),score=4*Math.max(0,Math.abs(Math.log(Math.max(1e-12,outerRatio)))-Math.log(1.075))**2+stats.meanProfileRelativeRms**2+2*stats.meanGapDepthError**2+100*[color.rg/photo.rg-1,color.bg/photo.bg-1].reduce((s,e)=>s+Math.max(0,Math.abs(e)-.008)**2,0);return{score,stats,color,outerRatio};};let grade=structuredClone(initial),best=evaluate(grade);
 for(const stretch of allowStretch?[2,8]:[]){let lo=.1,hi=20,trial=structuredClone(grade);trial.stretch=stretch;for(let i=0;i<12;i++){const gain=(lo+hi)/2;trial=structuredClone(grade);trial.stretch=stretch;for(let k=0;k<2;k++)for(let c=0;c<3;c++)trial.coefficients[k][c]=Math.max(.001,Math.min(100,grade.coefficients[k][c]*gain));if(evaluate(trial).color.meanG>best.color.meanG)hi=gain;else lo=gain;}const value=evaluate(trial);if(value.score<best.score){grade=trial;best=value;}}
 for(const step of [.5,.25,.1,.04,.015,.005])for(let repeat=0;repeat<3;repeat++){for(let k=0;k<2;k++)for(let c=0;c<3;c++)for(const sign of [-1,1]){const trial=structuredClone(grade);trial.coefficients[k][c]=Math.max(.001,Math.min(100,grade.coefficients[k][c]+sign*step*Math.max(.05,grade.coefficients[k][c])));const value=evaluate(trial);if(value.score<best.score){grade=trial;best=value;}}if(allowStretch)for(const sign of [-1,1]){const trial={...grade,stretch:Math.max(0,Math.min(20,grade.stretch+sign*step*10))},value=evaluate(trial);if(value.score<best.score){grade=trial;best=value;}}}
 grade.score=best.score;return{grade,prediction:gradedPrediction(basis,grade),plan,diagnostics:{...best,freeParameters:allowStretch?7:6,coefficientBounds:[.001,100],stretchBounds:[0,20],saturation:grade.saturation,objective:'Fixed five-cut brightness profiles and gap/core depth, with masked bar color. The accepted outer light is preserved through a global-coefficient constraint. Whole-image RMS is reported separately and never gates this step.',pixels:ids.length}};
}
