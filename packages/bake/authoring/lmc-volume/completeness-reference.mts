/** Compare the TypeScript port and Gaia source-id indexing with unmodified vendor functions. */
import {readFile,writeFile} from 'node:fs/promises';import {spawnSync} from 'node:child_process';import {astroqueryToolchain} from '@cssearth/telescope-core/node';
import {L21,tcgCompleteness,gaiaPixel12} from './completeness.mts';import {acquireCalibration} from './rathore-calibration.mts';import {correctedExcess} from './crowding.mts';import {rec,array,num,need} from './inputs.mts';
const original=await readFile(L21+'inputs/surveyTCG.py','utf8'),start=original.indexOf('def sigmoid(');need(start>0,'Missing published completeness functions');const vendor=L21+'inputs/tcg_vendor_functions.py';await writeFile(vendor,'import numpy as np\n'+original.slice(start));const stars=(await acquireCalibration(true)).slice(0,20),cases=[{g:18,m:19},{g:19,m:19},{g:20,m:20},{g:21,m:21},{g:20.5,m:20.519369625540833}],tc=await astroqueryToolchain(),bridge="import json,sys,runpy; import astropy_healpix as hp; from astropy import units as u; r=json.load(sys.stdin); f=runpy.run_path(r['vendor']); json.dump({'probabilities':[float(f['m10_to_completeness'](v['g'],float(v['m'])).item()) for v in r['cases']], 'pixels':[int(hp.lonlat_to_healpix(v['ra']*u.deg,v['dec']*u.deg,2**12,order='nested')) for v in r['stars']]},sys.stdout)",r=spawnSync(tc.python,['-c',bridge],{input:JSON.stringify({vendor,cases,stars}),encoding:'utf8',env:tc.env,timeout:30000});need(r.status===0,'Vendor reference failed: '+r.stderr);const result=rec(JSON.parse(r.stdout)),probs=array(result.probabilities).map(num),pixels=array(result.pixels).map(num);for(let i=0;i<cases.length;i++)need(Math.abs(tcgCompleteness(cases[i].g,cases[i].m)-probs[i])<1e-12,'Completeness equation differs from GaiaUnlimited');for(let i=0;i<stars.length;i++)need(Math.floor(gaiaPixel12(stars[i].id)/16)===Math.floor(pixels[i]/16),`Gaia M10 cell differs from Astropy: ${JSON.stringify({star:stars[i],idPixel:gaiaPixel12(stars[i].id),positionPixel:pixels[i]})}`);let maximumExcessDifference=0;for(const s of stars){const direct=correctedExcess(s),recomputed=correctedExcess({g:s.g,bp:s.bp,rp:s.rp});maximumExcessDifference=Math.max(maximumExcessDifference,Math.abs(direct-recomputed));}need(maximumExcessDifference<1e-4,'Photometric zero points do not reproduce the published excess factor');const evidence={sentinel:'L21_VENDOR_REFERENCE_VERIFIED',cases:cases.map((v,i)=>({...v,expected:probs[i]})),sourceIdChecks:stars.length,maximumExcessDifference,software:'Unmodified GaiaUnlimited sigmoid/m10_to_completeness; astropy-healpix '+tc.astropyHealpixVersion};await writeFile(L21+'vendor-reference.json',JSON.stringify(evidence,null,2)+'\n');console.log(JSON.stringify(evidence));
