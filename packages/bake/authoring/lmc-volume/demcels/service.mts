/** Bounded, resumable Data Lab requests. Published bytes remain local and unchanged. */
import {spawn} from 'node:child_process';import {readFile,writeFile,mkdir,stat} from 'node:fs/promises';import {need} from '../inputs.mts';
export async function retrieve(url:string,path:string,cap:number,seconds=90){await mkdir(path.slice(0,path.lastIndexOf('/')),{recursive:true});const saved=await stat(path).catch(()=>null);if(saved&&saved.size>0&&saved.size<=cap)return{bytes:saved.size,cached:true,seconds:0};const began=performance.now(),bytes=await new Promise<Buffer>((resolve,reject)=>{const child=spawn('curl',['--fail','--location','--silent','--show-error','--connect-timeout','10','--max-time',String(seconds),url],{stdio:['ignore','pipe','pipe']}),chunks:Buffer[]=[],errors:Buffer[]=[];let count=0,overflow=false;child.stdout.on('data',(v:Buffer)=>{count+=v.length;if(count>cap){overflow=true;child.kill('SIGTERM');}else chunks.push(v);});child.stderr.on('data',(v:Buffer)=>{if(errors.reduce((s,b)=>s+b.length,0)<4096)errors.push(v);});child.on('error',reject);child.on('close',code=>code===0&&!overflow?resolve(Buffer.concat(chunks)):reject(Error(overflow?'Request byte cap exceeded':Buffer.concat(errors).toString('utf8').slice(-2048))));});need(bytes.length>0,'Empty Data Lab response');await writeFile(path,bytes);return{bytes:bytes.length,cached:false,seconds:(performance.now()-began)/1000};}
const decode=(s:string)=>s.replaceAll('&amp;','&').replaceAll('&lt;','<').replaceAll('&gt;','>').replaceAll('&quot;','"');
export function siaRows(xml:string){need(xml.includes('VOTABLE'),'Data Lab did not return a VOTable');need(!/value="ERROR"/u.test(xml),'SIA returned an error');const names=[...xml.matchAll(/<FIELD\b[^>]*\bname="([^"]+)"/gu)].map(v=>v[1]);return[...xml.matchAll(/<TR>([\s\S]*?)<\/TR>/gu)].map(v=>{const cells=[...v[1].matchAll(/<TD>([\s\S]*?)<\/TD>/gu)].map(c=>decode(c[1]));need(cells.length===names.length,'Malformed SIA row');return Object.fromEntries(names.map((name,i)=>[name,cells[i]]));});}
export async function querySia(url:string,path:string){await retrieve(url,path,8*1024**2,60);return siaRows(await readFile(path,'utf8'));}
