/** Flux-calibrated, feathered sky mosaic, with explicit no-exposure pixels. */
import {overlapOffsets} from './offsets.mts';
import {pathToFileURL} from 'node:url';
import {readFile,writeFile,readdir} from 'node:fs/promises';
import sharp from 'sharp';
import {skyProjection,type FitsHeader} from '@cssearth/fits';
import {json,rec,num,need} from '../inputs.mts';
import {versionDir} from '../sequence-state.mts';
import {loadShassa} from '../ionized/input.mts';
import {bilinear} from '../ionized/pixels.mts';
export const MOSAIC_N=12000;
export const MOSAIC_HEADER:FitsHeader={CTYPE1:'RA---TAN',CTYPE2:'DEC--TAN',CRVAL1:80.89,CRVAL2:-69.76,CRPIX1:6000.5,CRPIX2:6000.5,CDELT1:-3/3600,CDELT2:3/3600};
export function feather(x:number,y:number,width:number,height:number){return Math.min(1,Math.max(0,Math.min(x,y,width-1-x,height-1-y)/20));}
export function sourceOffset(samples:readonly number[]){if(samples.length<40)return 0;const a=[...samples].sort((a,b)=>a-b);return a[Math.floor(a.length/2)];}
export function coverageDistance(values:ArrayLike<number>,w:number,h:number){need(values.length===w*h,'Coverage dimensions differ');const d=new Float32Array(values.length);for(let i=0;i<d.length;i++)d[i]=Number.isFinite(values[i])?20:0;for(let y=0;y<h;y++)for(let x=0;x<w;x++){const i=y*w+x;d[i]=Math.min(d[i],x?d[i-1]+1:1,y?d[i-w]+1:1);}for(let y=h-1;y>=0;y--)for(let x=w-1;x>=0;x--){const i=y*w+x;d[i]=Math.min(d[i],x+1<w?d[i+1]+1:1,y+1<h?d[i+w]+1:1);}return d;}
async function main(){const dir=versionDir(35);if(!process.argv.some(v=>v.startsWith('--limit='))){const acquisition=rec(await json(dir+'inputs/acquisition.json')),discovery=rec(await json(dir+'inputs/discovery.json'));need(acquisition.complete===true&&Array.isArray(discovery.tiles)&&acquisition.requested===discovery.tiles.length,'Finish the entire released-tile acquisition pass first');}const files=(await readdir(dir+'inputs/native/')).filter(f=>f.endsWith('.fits.f32le')).sort(),limit=Number(process.argv.find(v=>v.startsWith('--limit='))?.split('=')[1]??files.length),sum=new Float32Array(MOSAIC_N**2),weight=new Float32Array(sum.length),wcs=skyProjection(MOSAIC_HEADER),fallback=await loadShassa(),tiles=[],overlap=await overlapOffsets(files.slice(0,limit).map(f=>dir+'inputs/native/'+f),wcs);
for(const file of files.slice(0,limit)){const path=dir+'inputs/native/'+file,meta=rec(await json(path.replace('.f32le','.json'))),width=num(meta.width),height=num(meta.height),h=rec(meta.header),header:FitsHeader={};for(const [k,v]of Object.entries(h))if(typeof v==='number'||typeof v==='string'||typeof v==='boolean')header[k]=v;const source=skyProjection(header),buf=await readFile(path),values=new Float32Array(buf.buffer.slice(buf.byteOffset,buf.byteOffset+buf.byteLength));need(values.length===width*height,'Reduced tile dimensions changed');
 const offsets:number[]=[];for(let y=20;y<height-20;y+=8)for(let x=20;x<width-20;x+=8){const value=values[y*width+x],p=fallback.wcs.pixelOf(...source.skyOf(x,y)),reference=p?bilinear(fallback.image,...p)*.1:NaN;if(Number.isFinite(value)&&Number.isFinite(reference)&&reference<40)offsets.push(value-reference);}
 const measuredOffset=sourceOffset(offsets),offset=overlap.offsets.get(file.replace('.f32le',''))??0,distance=coverageDistance(values,width,height);let pixels=0;for(let y=1;y<height-1;y++)for(let x=1;x<width-1;x++){const value=values[y*width+x];if(!Number.isFinite(value))continue;const p=wcs.pixelOf(...source.skyOf(x,y));if(!p)continue;const xx=Math.floor(p[0]),yy=Math.floor(p[1]),u=p[0]-xx,v=p[1]-yy,f=Math.min(feather(x,y,width,height),distance[y*width+x]/20);if(xx<0||yy<0||xx+1>=MOSAIC_N||yy+1>=MOSAIC_N)continue;for(let dy=0;dy<=1;dy++)for(let dx=0;dx<=1;dx++){const i=(yy+dy)*MOSAIC_N+xx+dx,q=f*(dx?u:1-u)*(dy?v:1-v);sum[i]+=(value-offset)*q;weight[i]+=q;}pixels++;}
 tiles.push({id:file.replace('.f32le',''),width,height,pixels,measuredOffsetRayleigh:measuredOffset,appliedOffsetRayleigh:offset,offsetSamples:offsets.length});console.log(JSON.stringify({sentinel:'MOSAIC_TILE_STITCHED',done:tiles.length,total:Math.min(limit,files.length),...tiles.at(-1)}));}
let covered=0,optical=0,opticalCovered=0;for(let y=0;y<MOSAIC_N;y++)for(let x=0;x<MOSAIC_N;x++){const i=y*MOSAIC_N+x;if(weight[i]>0){sum[i]/=weight[i];covered++;}else sum[i]=NaN;if(Math.hypot(x-5999.5,y-5999.5)<=4800){optical++;}}
const globalOffset=0;const unionDistance=coverageDistance(sum,MOSAIC_N,MOSAIC_N);for(let i=0;i<weight.length;i++){weight[i]=Math.min(1,unionDistance[i]/20);if(weight[i]>=.5&&Math.hypot(i%MOSAIC_N-5999.5,Math.floor(i/MOSAIC_N)-5999.5)<=4800)opticalCovered++;}await writeFile(dir+'mosaic.f32le',Buffer.from(sum.buffer));await writeFile(dir+'coverage.f32le',Buffer.from(weight.buffer));
const metadata={schema:'lmc-demcels-mosaic@1',width:MOSAIC_N,height:MOSAIC_N,header:MOSAIC_HEADER,units:'Rayleigh-equivalent H-alpha+[NII]',samplingArcsec:3,globalOffsetRayleigh:globalOffset,overlapCalibration:overlap.record,tiles,coveredPixels:covered,fieldCoverage:covered/sum.length,opticalDiameterDeg:8,opticalCoverage:opticalCovered/optical,coverageRule:'The union no-data boundary is distance-tapered over60 arcseconds after stitching. Interior coverage is exactly one, independent of splat density or overlap count.',featherArcsec:60,method:'Native 0.27 arcsecond DN are area-averaged in 11x11 blocks (2.97 arcseconds), converted with the published DR1 flux scale, then bilinearly deposited on a 3 arcsecond TAN grid. Overlapping tiles are edge-weighted; any uncovered output pixels remain absent and use SHASSA in the field loader. Relative additive sky offsets come only from matching DeMCELS overlap pixels. Each connected component has one SHASSA absolute-zero anchor. Native gains and local filament contrast stay fixed; this is survey calibration, not an appearance fit. The overlap graph and residuals are recorded.',calibration:'Points et al. 2024 DR1: 2.4e-18 erg/s/cm2 per released DN, divided by native pixel solid angle and 5.661e-18 per Rayleigh per square arcsecond. No exposure-time division. N662 includes [NII]; no unmeasured spatial [NII] correction is claimed.',limitations:'DR1 covers 54 square degrees, not every point in the 10-degree field. Tile and chip gaps use the low-resolution fallback. Continuum subtraction can retain stellar residuals. Native 1.3 arcsecond seeing is reduced to 3 arcsecond sampling; the physical model and 512-pixel display are coarser.'};
await writeFile(dir+'mosaic.json',JSON.stringify(metadata,null,2)+'\n');
const preview=new Uint8Array(sum.length);for(let i=0;i<sum.length;i++)preview[i]=Number.isFinite(sum[i])?Math.min(255,Math.log1p(Math.max(0,sum[i]))/Math.log(1001)*255):0;
await sharp(preview,{raw:{width:MOSAIC_N,height:MOSAIC_N,channels:1}}).resize(1200,1200).png().toFile(dir+'ha-mosaic.png');
for(let i=0;i<preview.length;i++)preview[i]=weight[i]*255;
await sharp(preview,{raw:{width:MOSAIC_N,height:MOSAIC_N,channels:1}}).resize(1200,1200).png().toFile(dir+'coverage.png');
console.log(JSON.stringify({sentinel:'FULL_MOSAIC_READY',tiles:tiles.length,covered,opticalCoverage:metadata.opticalCoverage}));
}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await main();
