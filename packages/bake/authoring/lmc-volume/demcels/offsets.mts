/** Survey-only additive overlap calibration; no image target or local gain enters it. */
import {readFile} from 'node:fs/promises';
import {skyProjection,type SkyProjection,type FitsHeader} from '@cssearth/fits';
import {json,rec,num,need} from '../inputs.mts';
import {bilinear} from '../ionized/pixels.mts';
import {loadShassa} from '../ionized/input.mts';
export interface Edge {a:number;b:number;difference:number;samples:number;scatter:number;}
export const median=(a:readonly number[])=>{need(a.length>0,'Empty overlap statistic');const b=[...a].sort((a,b)=>a-b);return b[Math.floor(b.length/2)];};
export function solveOffsets(n:number,edges:readonly Edge[]){const adjacency=Array.from({length:n},()=>[] as {other:number;delta:number;weight:number}[]);for(const e of edges){const weight=Math.min(1000,e.samples)/Math.max(.25,e.scatter**2);adjacency[e.a].push({other:e.b,delta:e.difference,weight});adjacency[e.b].push({other:e.a,delta:-e.difference,weight});}const components=new Int32Array(n).fill(-1),anchors:number[]=[];for(let i=0;i<n;i++)if(components[i]<0){const group=anchors.length;anchors.push(i);const todo=[i];components[i]=group;while(todo.length){const node=todo.pop()!;for(const e of adjacency[node])if(components[e.other]<0){components[e.other]=group;todo.push(e.other);}}}const offsets=new Float64Array(n),fixed=new Set(anchors);for(let round=0;round<2000;round++){let change=0;for(let i=0;i<n;i++){if(fixed.has(i)||adjacency[i].length===0)continue;let s=0,w=0;for(const e of adjacency[i]){s+=(offsets[e.other]+e.delta)*e.weight;w+=e.weight;}const value=s/w;change=Math.max(change,Math.abs(value-offsets[i]));offsets[i]=value;}if(change<1e-7)break;}return{offsets,components,anchors};}
export interface Tile {id:string;width:number;height:number;values:Float32Array;wcs:SkyProjection;bounds:number[];}
export async function overlapOffsets(paths:readonly string[],mosaic:SkyProjection){const tiles:Tile[]=[];for(const path of paths){const m=rec(await json(path.replace('.f32le','.json'))),width=num(m.width),height=num(m.height),header:FitsHeader={};need(Number.isSafeInteger(width)&&width>0&&width<=900&&Number.isSafeInteger(height)&&height>0&&height<=900,'Invalid reduced dimensions');for(const [k,v]of Object.entries(rec(m.header)))if(typeof v==='number'||typeof v==='string'||typeof v==='boolean')header[k]=v;const wcs=skyProjection(header),bytes=await readFile(path),values=new Float32Array(bytes.buffer.slice(bytes.byteOffset,bytes.byteOffset+bytes.byteLength));need(values.length===width*height,'Invalid reduced byte count');const corners=[[0,0],[width-1,0],[width-1,height-1],[0,height-1]].map(([x,y])=>mosaic.pixelOf(...wcs.skyOf(x,y)));const points=corners.flatMap(v=>v?[v]:[]);need(points.length===4,'Tile outside sky hemisphere');tiles.push({id:path.split('/').at(-1)!.replace('.f32le',''),width,height,values,wcs,bounds:[Math.min(...points.map(p=>p[0])),Math.max(...points.map(p=>p[0])),Math.min(...points.map(p=>p[1])),Math.max(...points.map(p=>p[1]))]});}
 const edges:Edge[]=[];for(let a=0;a<tiles.length;a++)for(let b=a+1;b<tiles.length;b++){const t=tiles[a],u=tiles[b];if(t.bounds[1]<u.bounds[0]||u.bounds[1]<t.bounds[0]||t.bounds[3]<u.bounds[2]||u.bounds[3]<t.bounds[2])continue;const differences:number[]=[];for(let y=12;y<t.height-12;y+=8)for(let x=12;x<t.width-12;x+=8){const v=t.values[y*t.width+x];if(!Number.isFinite(v))continue;const p=u.wcs.pixelOf(...t.wcs.skyOf(x,y)),other=p?bilinear(u,...p):NaN;if(Number.isFinite(other))differences.push(v-other);}if(differences.length>=40){const difference=median(differences),scatter=1.4826*median(differences.map(v=>Math.abs(v-difference)));edges.push({a,b,difference,samples:differences.length,scatter});}}
 const solved=solveOffsets(tiles.length,edges),fallback=await loadShassa(),anchorSamples=solved.anchors.map(()=>[] as number[]);for(let i=0;i<tiles.length;i++){const t=tiles[i],samples=anchorSamples[solved.components[i]];for(let y=20;y<t.height-20;y+=16)for(let x=20;x<t.width-20;x+=16){const v=t.values[y*t.width+x],p=fallback.wcs.pixelOf(...t.wcs.skyOf(x,y)),reference=p?bilinear(fallback.image,...p)*.1:NaN;if(Number.isFinite(v)&&Number.isFinite(reference)&&reference<40)samples.push(v-solved.offsets[i]-reference);}}
 const anchors=anchorSamples.map(a=>{need(a.length>=40,'Unanchored survey component');return median(a);});for(let i=0;i<solved.offsets.length;i++)solved.offsets[i]+=anchors[solved.components[i]];
 const residuals=edges.map(e=>Math.abs(solved.offsets[e.a]-solved.offsets[e.b]-e.difference)),record={method:'Robust additive differences at matching sky coordinates in overlapping DeMCELS tiles. A weighted graph solution fixes relative zeros. Each connected survey component then gets one additive absolute zero from SHASSA low-emission (<40 R) samples. Native gains, line ratios and filament structure are unchanged. No Horálek pixels.',components:anchors.length,anchorsRayleigh:anchors,anchorSampleCounts:anchorSamples.map(a=>a.length),edges,medianEdgeResidualRayleigh:residuals.length?median(residuals):0,maximumEdgeResidualRayleigh:residuals.length?Math.max(...residuals):0,tiles:tiles.map((t,i)=>({id:t.id,offsetRayleigh:solved.offsets[i],component:solved.components[i]}))};
 return{offsets:new Map(tiles.map((t,i)=>[t.id,solved.offsets[i]])),record};}
