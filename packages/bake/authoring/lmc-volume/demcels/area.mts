/** Integrate native sky pixels inside a projected physical cell, without sparse point sampling. */
import {need} from '../inputs.mts';
export type Point=readonly[number,number];
export function polygonArea(p:readonly Point[]){let a=0;for(let i=0;i<p.length;i++){const b=p[(i+1)%p.length];a+=p[i][0]*b[1]-b[0]*p[i][1];}return Math.abs(a)/2;}
function inside(x:number,y:number,p:readonly Point[]){let yes=false;for(let i=0,j=p.length-1;i<p.length;j=i++){const a=p[i],b=p[j];if((a[1]>y)!==(b[1]>y)&&x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0])yes=!yes;}return yes;}
export function areaMean(values:ArrayLike<number>,coverage:ArrayLike<number>,width:number,height:number,polygon:readonly Point[]){need(values.length===width*height&&coverage.length===values.length&&polygon.length===4,'Invalid area sampling inputs');const x0=Math.max(0,Math.ceil(Math.min(...polygon.map(p=>p[0])))),x1=Math.min(width-1,Math.floor(Math.max(...polygon.map(p=>p[0])))),y0=Math.max(0,Math.ceil(Math.min(...polygon.map(p=>p[1])))),y1=Math.min(height-1,Math.floor(Math.max(...polygon.map(p=>p[1]))));let sum=0,weight=0;for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++){if(!inside(x,y,polygon))continue;const i=y*width+x,v=values[i];if(!Number.isFinite(v))continue;const w=Math.max(0,Math.min(1,coverage[i]));sum+=v*w;weight+=w;}return{mean:weight>0?sum/weight:NaN,coverage:Math.min(1,weight/Math.max(1,polygonArea(polygon))),samples:weight};}
