/** Independent line-survey agreement rejects background artifacts before volume construction. */
import {readFile,writeFile} from 'node:fs/promises';import {pathToFileURL} from 'node:url';import sharp from 'sharp';
import {skyProjection,type FitsHeader} from '@cssearth/fits';import {json,rec,num,need} from '../inputs.mts';import {versionDir} from '../sequence-state.mts';import {loadShassa} from '../ionized/input.mts';import {bilinear} from '../ionized/pixels.mts';
export function surveyAgreement(native:number,reference:number){if(!Number.isFinite(native)||!Number.isFinite(reference))return 0;const tolerance=Math.max(5,.5*Math.max(0,reference)),x=Math.max(0,Math.min(1,(Math.abs(native-reference)-tolerance)/tolerance));return 1-x*x*(3-2*x);}
export function matchedMeans(a:Float32Array,b:Float32Array,w:Float32Array,n:number,r=2){need(a.length===n*n&&b.length===a.length&&w.length===a.length,'Invalid matched-survey grid');const first=new Float32Array(a.length).fill(NaN),second=new Float32Array(a.length).fill(NaN);for(let y=0;y<n;y++)for(let x=0;x<n;x++){let sum=0,t=0,u=0;for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){const xx=x+dx,yy=y+dy;if(xx<0||xx>=n||yy<0||yy>=n)continue;const i=yy*n+xx;if(!Number.isFinite(a[i])||!Number.isFinite(b[i]))continue;sum+=w[i];t+=a[i]*w[i];u+=b[i]*w[i];}if(sum>0){first[y*n+x]=t/sum;second[y*n+x]=u/sum;}}return{first,second};}
async function main(){const dir=versionDir(35),m=rec(await json(dir+'mosaic.json')),width=num(m.width),height=num(m.height);need(width===12000&&height===12000,'Unexpected mosaic');const header:FitsHeader={};for(const [k,v]of Object.entries(rec(m.header)))if(typeof v==='number'||typeof v==='string'||typeof v==='boolean')header[k]=v;const wcs=skyProjection(header),read=async(name:string)=>{const b=await readFile(dir+name+'.f32le');need(b.length===width*height*4,'Wrong mosaic byte count');return new Float32Array(b.buffer.slice(b.byteOffset,b.byteOffset+b.byteLength));},values=await read('mosaic'),coverage=await read('coverage'),shassa=await loadShassa(),n=600,block=20,a=new Float32Array(n*n).fill(NaN),b=new Float32Array(n*n).fill(NaN),weights=new Float32Array(n*n);
 for(let y=0;y<n;y++)for(let x=0;x<n;x++){const i=y*n+x;let sum=0,total=0;for(let dy=0;dy<block;dy++)for(let dx=0;dx<block;dx++){const j=(y*block+dy)*width+x*block+dx;if(Number.isFinite(values[j])){sum+=values[j]*coverage[j];total+=coverage[j];}}const p=shassa.wcs.pixelOf(...wcs.skyOf(x*block+9.5,y*block+9.5));b[i]=p?bilinear(shassa.image,...p)*.1:NaN;if(total>0){a[i]=sum/total;weights[i]=total/(block*block);}}
 const smoothed=matchedMeans(a,b,weights,n),quality=Float32Array.from(a,(_,i)=>surveyAgreement(smoothed.first[i],smoothed.second[i])),qualified=new Float32Array(coverage.length);let geometric=0,kept=0;
 for(let y=0;y<height;y++)for(let x=0;x<width;x++){const i=y*width+x,u=(x-9.5)/block,v=(y-9.5)/block,q=bilinear({width:n,height:n,values:quality},u,v);qualified[i]=coverage[i]*(Number.isFinite(q)?q:0);geometric+=coverage[i];kept+=qualified[i];}
 await writeFile(dir+'qualified-coverage.f32le',Buffer.from(qualified.buffer));const metadata={source:'DeMCELS DR1 checked against independently calibrated SHASSA Field013.',comparisonSamplingArcmin:1,comparisonBoxArcmin:5,tolerance:'Adopted data-quality bound: the larger of 5 R and 50% of the reference surface brightness. Full confidence below that disagreement; a smooth transition to zero at twice the bound. These are source-quality tolerances, not parameters fitted to Horálek.',method:'Both line surveys are compared over exactly the same covered sky cells after a 5 arcminute box mean. Inconsistent DeMCELS background is excluded from the sharp-data weight, leaving the measured SHASSA fill. This does not claim to recover the missing exposure masks or remove every stellar continuum residual.',geometricWeightPixels:geometric,qualifiedWeightPixels:kept,retainedGeometricFraction:kept/geometric,photoSpatialData:false,limitations:'A valid sharp feature may lose confidence if the broad-bandpasses or local background disagree. The fallback is coarse. This conservative selection cannot turn incomplete data into complete 3 arcsecond coverage.'};await writeFile(dir+'quality.json',JSON.stringify(metadata,null,2)+'\n');
 const p=1200,preview=new Uint8Array(p*p),mask=new Uint8Array(p*p);for(let y=0;y<p;y++)for(let x=0;x<p;x++){const xx=x*10+5,yy=y*10+5,i=yy*width+xx,sky=shassa.wcs.pixelOf(...wcs.skyOf(xx,yy)),fallback=sky?bilinear(shassa.image,...sky)*.1:0,q=qualified[i],value=Number.isFinite(values[i])?values[i]*q+fallback*(1-q):fallback;preview[y*p+x]=Math.min(255,Math.log1p(Math.max(0,value))/Math.log(1001)*255);mask[y*p+x]=q*255;}await sharp(preview,{raw:{width:p,height:p,channels:1}}).png().toFile(dir+'ha-qualified.png');await sharp(mask,{raw:{width:p,height:p,channels:1}}).png().toFile(dir+'qualified-coverage.png');console.log(JSON.stringify({sentinel:'INDEPENDENT_H_ALPHA_QUALITY_CHECK_COMPLETE',...metadata}));}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await main();
