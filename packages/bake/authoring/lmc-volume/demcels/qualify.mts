const dir=versionDir(35),m=rec(await json(dir+'mosaic.json')),width=num(m.width),height=num(m.height),header:FitsHeader={};for(const [k,v]of Object.entries(rec(m.header)))if(typeof v==='number'||typeof v==='string'||typeof v==='boolean')header[k]=v;
const wcs=skyProjection(header),buffer=await readFile(dir+'qualified-coverage.f32le'),values=new Float32Array(buffer.buffer.slice(buffer.byteOffset,buffer.byteOffset+buffer.byteLength)),o=await loadObservation(8),sample=(x:number,y:number)=>{const p=wcs.pixelOf(...skyOf(o.rayAt(x+.5,y+.5)));return p?Math.max(0,Math.min(1,bilinear({width,height,values},...p))):0;};
let fraction=0;for(let y=0;y<384;y++)for(let x=0;x<512;x++){const v=sample(x,y);if(Number.isFinite(v))fraction+=v/(512*384);}
