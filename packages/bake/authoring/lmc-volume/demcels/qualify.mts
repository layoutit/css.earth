const record={mosaic:m,quality:await json(dir+'quality.json'),acquisition,native,photoCoverage:fraction,redPins:pins,failedTiles:tiles.filter(t=>t.complete!==true),references:['https://datalab.noirlab.edu/data/demcels','https://arxiv.org/abs/2409.04846','https://doi.org/10.1086/117304','https://doi.org/10.1086/323969'],credit:'DeMCELS DR1, Points et al. 2024. DECam at the CTIO Blanco 4-m telescope, NSF NOIRLab, operated by AURA under an NSF cooperative agreement. Puzia programmes2018A-0909 and2018B-0908; Points programme 2021B-0060. Archive services: NOIRLab Astro Data Lab. SHASSA: Gaustad et al. 2001, NSF-supported survey.',limitations:'DR1 has uneven exposure depth and continuum-subtraction residuals. Published sky removal may suppress very extended emission; an additive SHASSA anchor does not reconstruct a removed spatial gradient. Absolute units follow the published calibration because BUNIT is absent. The rendering uses relative templates and a global gas RGB grade.',geometry:'The images constrain sky morphology, not depth. Finite parent-region widths and published shell chords constrain compact cloud depths; diffuse gas uses the adopted 150 pc Gaussian height.',coverageMeaning:'Effective sharp-data weight averaged over the stated area, including the 60 arcsecond edge taper and the independent SHASSA agreement weight. The complement uses SHASSA. There is no claim that DeMCELS covers every pixel of the 10 degree field.'};
await writeFile(dir+'inputs/qualification.json',JSON.stringify(record,null,2)+'\n');console.log(JSON.stringify({sentinel:'DEM CELS COVERAGE QUALIFIED',tiles:tiles.length,photoCoverage:fraction,pins}));
