export async function reducedComplete(path:string){try{const metadata=rec(JSON.parse(await readFile(path+'.json','utf8'))),w=num(metadata.width),h=num(metadata.height),bytes=await stat(path+'.f32le');return metadata.maskVersion===3&&Number.isSafeInteger(w)&&w>0&&w<=900&&Number.isSafeInteger(h)&&h>0&&h<=900&&bytes.size===w*h*4;}catch{return false;}}
