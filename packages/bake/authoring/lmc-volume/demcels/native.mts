/** Native DeMCELS bytes are area-averaged to approximately three arcseconds, in physical surface units. */
import {readFile,writeFile,stat,mkdir,rename,unlink} from 'node:fs/promises';import {createWriteStream} from 'node:fs';import {spawn} from 'node:child_process';import {Transform} from 'node:stream';import {pipeline} from 'node:stream/promises';import {readFitsImage,skyProjection,type FitsHeader} from '@cssearth/fits';import {normalizeEquinox} from '../qualify-gas.mts';import {need,num,rec} from '../inputs.mts';
export const NATIVE_CAP=340*1024**2,COUNTS_TO_FLUX=2.4e-18,RAYLEIGH_ARCSEC2=5.661e-18;
export async function retrieveNative(url:string,path:string){const previous=await stat(path).catch(()=>null);if(previous&&previous.size>10000&&previous.size<=NATIVE_CAP)return{bytes:previous.size,seconds:0,cached:true};await mkdir(path.slice(0,path.lastIndexOf('/')),{recursive:true});const tmp=path+'.partial',began=performance.now(),child=spawn('curl',['--fail','--location','--silent','--show-error','--connect-timeout','10','--max-time','300',url],{stdio:['ignore','pipe','pipe']}),errors:Buffer[]=[];let count=0;child.stderr.on('data',(b:Buffer)=>{if(errors.reduce((s,v)=>s+v.length,0)<8192)errors.push(b);});const closed=new Promise<void>((resolve,reject)=>{child.on('error',reject);child.on('close',code=>code===0?resolve():reject(Error('Native transfer failed: '+Buffer.concat(errors).toString('utf8'))));});try{await Promise.all([pipeline(child.stdout,new Transform({transform(chunk:Buffer,_encoding,callback){count+=chunk.length;callback(count>NATIVE_CAP?Error('Native tile cap exceeded'):null,chunk);}}),createWriteStream(tmp)),closed]);need(count>10000,'Empty native tile');await rename(tmp,path);return{bytes:count,seconds:(performance.now()-began)/1000,cached:false};}catch(e){child.kill('SIGTERM');await unlink(tmp).catch(()=>undefined);throw e;}}
export function constantPadding(values:ArrayLike<number>,w:number,h:number,x:number,y:number){const i=y*w+x,v=values[i];return(x>0&&x+1<w&&values[i-1]===v&&values[i+1]===v)||(y>0&&y+1<h&&values[i-w]===v&&values[i+w]===v)||(x+2<w&&values[i+1]===v&&values[i+2]===v)||(x>1&&values[i-1]===v&&values[i-2]===v)||(y+2<h&&values[i+w]===v&&values[i+2*w]===v)||(y>1&&values[i-w]===v&&values[i-2*w]===v);}
export function binNative(values:ArrayLike<number>,width:number,height:number,block=11){const n=Math.ceil(width/block),m=Math.ceil(height/block),out=new Float32Array(n*m).fill(NaN);let covered=0;for(let y=0;y<m;y++)for(let x=0;x<n;x++){let sum=0,finite=0,nonzero=0,total=0;for(let j=y*block;j<Math.min(height,(y+1)*block);j++)for(let i=x*block;i<Math.min(width,(x+1)*block);i++){total++;const v=values[j*width+i];const blank=constantPadding(values,width,height,i,j);if(Number.isFinite(v)&&!blank){sum+=v;finite++;if(v!==0)nonzero++;}}if(finite>=total*.5&&nonzero>0){out[y*n+x]=sum/finite;covered++;}}return{width:n,height:m,values:out,covered};}
export function surfaceBrightness(values:Float32Array,pixelAreaArcsec2:number){need(pixelAreaArcsec2>0&&Number.isFinite(pixelAreaArcsec2),'Invalid pixel area');const factor=COUNTS_TO_FLUX/pixelAreaArcsec2/RAYLEIGH_ARCSEC2;return Float32Array.from(values,v=>Number.isFinite(v)?v*factor:NaN);}
export function binnedHeader(header:FitsHeader,block:number):FitsHeader{const h={...header};for(const k of ['NAXIS1','NAXIS2'])if(typeof h[k]==='number')h[k]=Math.ceil(num(h[k])/block);for(const k of ['CDELT1','CDELT2','CROTA1','CROTA2'])delete h[k];for(const k of ['CD1_1','CD1_2','CD2_1','CD2_2'])h[k]=num(h[k])*block;for(const k of ['CRPIX1','CRPIX2'])h[k]=(num(h[k])+(block-1)/2)/block;return h;}
export async function reduceNative(path:string){const bytes=await readFile(path);need(bytes.length<=NATIVE_CAP&&bytes.subarray(0,8).toString('ascii')==='SIMPLE  ','Native response is not bounded FITS');const normalized=normalizeEquinox(bytes),image=readFitsImage(normalized.bytes,{maxDecodedBytes:1024**3});need(image.bitpix===-32&&image.width>=100&&image.height>=100&&image.width<=9000&&image.height<=9000,'Unexpected DeMCELS native image');need(image.header.PROCTYPE==='StarSubtracted'&&String(image.header.FILTER).startsWith('N662'),'Not a continuum-subtracted H-alpha image');const area=Math.abs(num(image.header.CD1_1)*num(image.header.CD2_2)-num(image.header.CD1_2)*num(image.header.CD2_1))*3600**2;need(area>.03&&area<.15,'Unexpected native pixel area');const block=11,binned=binNative(image.values,image.width,image.height,block),calibrated=surfaceBrightness(binned.values,area);binned.values=calibrated;const header=binnedHeader(image.header,block),wcs=skyProjection(header),metadata={maskVersion:3,width:binned.width,height:binned.height,nativeWidth:image.width,nativeHeight:image.height,nativeBytes:bytes.length,nativePixelAreaArcsec2:area,block,samplingArcsec:wcs.scaleArcsec,coveredBins:binned.covered,header,normalizedDuplicateCards:normalized.cards,units:'Rayleigh-equivalent H-alpha+[NII] surface brightness, after the released r-continuum subtraction.',conversion:'Published DR1 calibration:2.4e-18 erg/s/cm2 per output DN, divided by native pixel area and 5.661e-18 erg/s/cm2/arcsec2 per Rayleigh. EXPTIME is not divided out; the released images share a photometric normalization.',paper:'https://arxiv.org/abs/2409.04846',bunitPresent:image.header.BUNIT!==undefined,coverage:'A bin needs at least 50% finite native pixels. Runs of at least three exactly identical native float pixels are synthetic no-exposure padding, even when continuum subtraction has shifted their fill away from zero. Those pixels and entirely constant blocks are excluded before area averaging. Isolated meas