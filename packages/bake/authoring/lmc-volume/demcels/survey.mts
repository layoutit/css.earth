export function blendSurvey(sharp:number,fallback:number,coverage:number){const t=Math.max(0,Math.min(1,coverage));return Number.isFinite(sharp)?sharp*t+fallback*(1-t):fallback;}
export function skyAreaJacobian(warp:Raster,x:number,y:number){const sky=(px:number,py:number)=>skyOf(bodyToIcrs([px,py,at(warp,px,py)])),a=sky(x,y),b=sky(x+.01,y),c=sky(x,y+.01),cos=Math.cos(a[1]*DEG),unwrap=(ra:number)=>((ra-a[0]+540)%360)-180;const p=bodyToIcrs([x,y,at(warp,x,y)]),d2=p.reduce((s,v)=>s+v*v,0);return Math.abs(unwrap(b[0])*cos*(c[1]-a[1])-unwrap(c[0])*cos*(b[1]-a[1]))/.0001*d2;}
export async function surveyField(sources:Sources,n=1024){const dir=versionDir(35),meta=rec(await json(dir+'mosaic.json')),width=num(meta.width),height=num(meta.height),header:FitsHeader={};need(meta.schema==='lmc-demcels-mosaic@1'&&Number.isFinite(num(meta.globalOffsetRayleigh)),'Complete the qualified mosaic before the source field');for(const [k,v]of Object.entries(rec(meta.header)))if(typeof v==='number'||typeof v==='string'||typeof v==='boolean')header[k]=v;const wcs=skyProjection(header),read=async(name:string)=>{const b=await readFile(dir+name+'.f32le');need(b.length===width*height*4,'Mosaic dimension mismatch');return new Float32Array(b.buffer.slice(b.byteOffset,b.byteOffset+b.byteLength));},values=await read('mosaic'),coverage=await read('qualified-coverage'),fallback=await fallbackField(sources,n),map=makeRaster(n,10),ogle=await loadOgle();let covered=0,partial=0,unsupported=0;
 for(let y=0;y<n;y++)for(let x=0;x<n;x++){const i=y*n+x,px=((x+.5)/n*2-1)*10,py=((y+.5)/n*2-1)*10,cell=20/n,r=Math.hypot(px,py);if(r>=6.5)continue;
  const corners: [number,number][]=[];for(const [dx,dy]of [[-.5,-.5],[.5,-.5],[.5,.5],[-.5,.5]]){const xx=px+dx*cell,yy=py+dy*cell,p=wcs.pixelOf(...skyOf(bodyToIcrs([xx,yy,at(sources.warp,xx,yy)])));if(p)corners.push(p);}
  const sample=corners.length===4?areaMean(values,coverage,width,height,corners):{mean:NaN,coverage:0},[ra,dec]=skyOf(bodyToIcrs([px,py,at(sources.warp,px,py)])),rc=ogle.sample(ra,dec),av=rc?Math.min(3,internalAv(rc.evi)):0,support=1-smoothstep((r-5.5)/1),corrected=Math.max(0,sample.mean-.1*fallback.metadata.backgroundDeciRayleigh)*support*Math.exp(.75*av/1.0857362047581296);
  const fallbackAvailable=fallback.map.mask[i]===1;if(sample.coverage===0&&!fallbackAvailable){unsupported++;continue;}map.values[i]=(fallbackAvailable?blendSurvey(corrected,fallback.map.values[i],sample.coverage):corrected)*skyAreaJacobian(sources.warp,px,py);map.mask[i]=1;if(sample.coverage>.99)covered++;else if(sample.coverage>0)partial++;
 }
 const split=splitDiffuse(map.values,n,20/n),metadata={...meta,quality:await json(dir+'quality.json'),n,halfKpc:10,cellPc:20000/n,source:'DeMCELS DR1 continuum-subtracted full-field mosaic; SHASSA outside coverage.',coveredModelCells:covered,partiallyCoveredModelCells:partial,unsupportedModelCells:unsupported,unsupportedRule:'Cells outside both observed footprints remain unmodelled, with a false source mask; they are not measured zero emission. The adopted physical support fade is unchanged.',diffuseFraction:split.measuredFraction,diffuseMorphologyHalfWidthPc:split.halfWidthPc,photoSpatialData:false,paper:'https://doi.org/10.1086/117304',diffuseMethod:'A broad 200 pc half-width mean supplies DIG morphology. A single coefficient partitions 35% of integrated line emission into DIG, following the 30–40% Kennicutt et al. 1995 range. Unassigned catalogue emission is recorded separately.',transport:'Every 3 arcsecond sky-pixel centre inside each projected physical-cell quadrilateral is area-averaged, with coverage weights. Signed emission is averaged before the positive-emission clamp. The measured warp supplies projected sky area; multiplication by squared heliocentric distance converts solid angle to projected physical area before the field is lifted. The global normalization removes the constant angular unit.',dustCorrection:'The same OGLE foreground internal A_V correction and adopted 5.5–6.5 kpc support fade as l34. No Horálek spatial pixels.',fallback:'SHASSA Field013 supplies gaps, with the 60 arcsecond native-tile edge taper. The same SHASSA exterior sky zero is subtracted from both sources before blending. No-data is never interpreted as zero emission.'};return{map,compact:{...map,values:split.compact} as Raster,diffuse:{...map,values:split.diffuse} as Raster,metadata};}
