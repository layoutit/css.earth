/** Representative native tiles exercise the same transfer, mask, calibration and binning as acquisition. */
import {writeFile,mkdir} from 'node:fs/promises';import {versionDir} from '../sequence-state.mts';import {json,rec,array,need} from '../inputs.mts';import {retrieveNative,reduceNative,saveReduced} from './native.mts';
const dir=versionDir(35)+'inputs/';await mkdir(dir+'native/',{recursive:true});const rows=array(rec(await json(dir+'discovery.json')).tiles).map(rec),results=[];
for(const id of ['LMC_c41_T06.ha_sub_r.dr01.fits','LMC_c45_T01.ha_sub_r.dr01.fits','LMC_c37_T16.ha_sub_r.dr01.fits']){const row=rows.find(r=>r.id===id);need(row&&typeof row.access_url==='string'&&typeof row.s_ra==='string'&&typeof row.s_dec==='string','Representative release tile missing');const url=new URL(row.access_url);url.searchParams.set('POS',row.s_ra+','+row.s_dec);url.searchParams.set('SIZE','0.7,0.7');const path=dir+'native/'+id,transfer=await retrieveNative(url.href,path),reduced=await reduceNative(path);await saveReduced(path,reduced);need(reduced.covered>0,'Pilot contains no observed pixels');results.push({id,url:url.href,...transfer,...reduced.metadata});console.log(JSON.stringify({sentinel:'FULL_NATIVE_TILE_PILOT_PASSED',id,...transfer,native:[reduced.metadata.nativeWidth,reduced.metadata.nativeHeight],binned:[reduced.width,reduced.height],covered:reduced.covered}));}
await writeFile(dir+'native-pilot.json',JSON.stringify(results,null,2)+'\n');
