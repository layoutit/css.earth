/** Three global bar RGB coefficients; all spatial fields and other colors are frozen. */
import {gradedPrediction,inverseTone,appearanceLoss,LUMA,type Grade} from './grade.mts';
import {loss,type Basis,type Target} from './render.mts';
import {rayPlane} from './geometry.mts';
import type {Observation} from './report.mts';
import type {BarGeometry} from './bar-geometry.mts';
export function fitBarColor(basis:Basis,initial:Grade,target:Target,o:Pick<Observation,'width'|'height'|'rayAt'>,b:BarGeometry,referenceColorRatio:readonly number[]=[1,1,1]){
 const grade=structuredClone(initial),transformed=inverseTone(target.data,grade.stretch,grade.saturation),mask=new Uint8Array(target.train.length),baseline=[...grade.coefficients[1]],fixed=new Float64Array(target.data.length),bounds=baseline.map(v=>[v*.5,v*2]);
 for(let y=0;y<o.height;y++)for(let x=0;x<o.width;x++){const i=y*o.width+x;if(!(target.train[i]||target.holdout[i]))continue;const p=rayPlane(o.rayAt(x+.5,y+.5)),dx=p[0]-b.center[0],dy=p[1]-b.center[1],u=(Math.cos(b.angle)*dx+Math.sin(b.angle)*dy)/b.sigma,v=(-Math.sin(b.angle)*dx+Math.cos(b.angle)*dy)/(b.sigma*b.ratio);mask[i]=u*u+v*v<(2.13*49.59/49.9/b.sigma)**2?1:0;}
 for(let i=0;i<fixed.length;i++){const c=i%3;fixed[i]=(basis.planes[0][i]+basis.planes[2][i])*grade.coefficients[0][c]+basis.planes[3][i]*grade.coefficients[2][c]+basis.planes[4][i]*grade.coefficients[3][c];}
 for(let c=0;c<3;c++){let a=0,b=0;for(let p=0;p<mask.length;p++)if(mask[p]){const i=p*3+c,w=1/(.01+target.data[p*3]*LUMA[0]+target.data[p*3+1]*LUMA[1]+target.data[p*3+2]*LUMA[2]),x=basis.planes[1][i];a+=w*x*(transformed[i]-fixed[i]);b+=w*x*x;}if(b>0)grade.coefficients[1][c]=Math.max(bounds[c][0],Math.min(bounds[c][1],a/b));}
 const comparison={...target,train:Uint8Array.from(target.train,(v,i)=>v||target.holdout[i]?1:0)},score=(g:Grade)=>{const p=gradedPrediction(basis,g);let model=0,observed=0;for(let i=0;i<comparison.train.length;i++)if(comparison.train[i])for(let c=0;c<3;c++){model+=p[i*3+c];observed+=target.data[i*3+c];}return appearanceLoss(p,comparison)**2+.15*loss(p,comparison)**2+.25*Math.log(model/observed)**2;};const reference=structuredClone(initial);for(let c=0;c<3;c++)reference.coefficients[1][c]*=referenceColorRatio[c];if(score(reference)<score(grade))grade.coefficients[1]=[...reference.coefficients[1]];let best=score(grade);
 for(const step of [.2,.1,.04,.01])for(let repeat=0;repeat<2;repeat++)for(let c=0;c<3;c++)for(const sign of [-1,1]){const candidate=structuredClone(grade);candidate.coefficients[1][c]=Math.max(bounds[c][0],Math.min(bounds[c][1],candidate.coefficients[1][c]*(1+sign*step)));const s=score(candidate);if(s<best){best=s;grade.coefficients[1][c]=candidate.coefficients[1][c];}}
 const prediction=gradedPrediction(basis,grade);grade.score=appearanceLoss(prediction,{...target,train:Uint8Array.from(target.train,(v,i)=>v||target.holdout[i]?1:0)});return{grade,prediction,diagnostics:{freeParameters:3,pixelParameters:0,component:'Bar only',coefficientBounds:bounds,before:baseline,after:grade.coefficients[1],displayCurveFixed:true,geometryFixed:true,aperture:'Whole valid Earth image and total-light objective; the measured bar footprint supplies the initial color estimate only'}};
}
