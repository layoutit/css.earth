/** l18 uses the owner's color gate, not a requirement that whole-image RMS improve. */
import {readFile,writeFile} from 'node:fs/promises';
import {ROOT,json,rec,num,array,need} from './inputs.mts';
import {versionDir} from './sequence-state.mts';
import {BAR_COLOR_TOLERANCE,MAX_RMS_REGRESSION} from './bar-ratios.mts';
const dir=versionDir(18),result=rec(await json(dir+'result.json')),bar=rec(result.barColor),photo=rec(bar.photo),parent=rec(bar.parent),candidate=rec(bar.candidate),rungs=array(await json(dir+'rungs.json')),before=rec(rec(await json(versionDir(17)+'result.json')).residuals),after=rec(result.residuals);
need(rungs.length===2&&num(result.size)===512,'l18 has not completed both rungs');
const visual=rec(await json(dir+'visual-review.json'));need(typeof visual.coherent==='boolean','A completed visual inspection is required');
const oldStructure=rec(await json(versionDir(17)+'structure.json')),newStructure=rec(await json(dir+'structure.json')),oldConfig=rec(await json(versionDir(17)+'configuration.json')),newConfig=rec(await json(dir+'configuration.json')),oldResult=rec(await json(versionDir(17)+'result.json')),oldGrade=rec(oldResult.grade),newGrade=rec(result.grade),same=(a:unknown,b:unknown)=>JSON.stringify(a)===JSON.stringify(b);
for(const key of ['objects','dust','owners','barGeometry'])need(same(oldStructure[key],newStructure[key]),'l18 changed frozen '+key);
for(const key of ['stretch','saturation','dustStrength','dustTint'])need(same(oldGrade[key],newGrade[key]),'l18 changed the display or dust');
for(const k of [0,2,3]){need(same(array(oldGrade.coefficients)[k],array(newGrade.coefficients)[k]),'l18 changed another component grade');need(same(array(oldConfig.colors)[k],array(newConfig.colors)[k]),'l18 changed another population spectrum');}
need(same(newConfig.innerDiscColor,oldConfig.innerDiscColor??array(oldConfig.colors)[0])&&same(oldResult.sceneControls,result.sceneControls),'l18 changed the inner disc or another gain');
for(const file of ['young-density.f32le','object-shapes.json','object-brightness.json'])need((await readFile(versionDir(17)+file)).equals(await readFile(dir+file)),'l18 changed frozen '+file);
await writeFile(dir+'preservation.json',JSON.stringify({geometryUnchanged:true,objectLuminositiesUnchanged:true,gaiaMapUnchanged:true,innerDiscAndOutskirtsUnchanged:true,otherColorsAndDisplayCurveUnchanged:true},null,2)+'\n');
const retained=bar.colorPassed===true&&bar.rmsPassed===true&&visual.coherent,reason=retained?'Both masked bar color ratios pass; whole-image RMS stays within its declared regression limit; side views remain coherent.':'The candidate fails at least one declared color, RMS or side-view condition. Retain l17.';
const decision={version:18,parent:17,retained,nextParent:retained?18:17,reason,colorToleranceRelative:BAR_COLOR_TOLERANCE,maximumWholeImageRmsRegressionRelative:MAX_RMS_REGRESSION,sideViewsInspected:true};
await writeFile(dir+'decision.json',JSON.stringify(decision,null,2)+'\n');
const f=(v:unknown)=>num(v).toFixed(5),change=(key:string)=>(100*(num(after[key])/num(before[key])-1)).toFixed(2)+'%',colorRows=['rg','bg'].map(key=>`| ${key==='rg'?'R/G':'B/G'} | ${f(photo[key])} | ${f(parent[key])} | ${f(candidate[key])} | ${(100*(num(candidate[key])/num(photo[key])-1)).toFixed(2)}% |`).join('\n');
await writeFile(dir+'notes.md',`# l18: yellow bar\n\n**${retained?'Retained':'Rejected; retain l17'}**. ${reason}\n\nOnly the bar's population spectrum and three global bar RGB coefficients change. VMC ages and metallicities supply its spectrum. Two tiny trials also changed the inner-disc spectrum and failed the RMS guard; that change is excluded. Geometry, young populations, gas, dust, inner disc, outskirts and the display curve remain at l17.\n\n| Masked bar ratio | Photo | l17 | l18 | l18 error |\n| --- | --- | --- | --- | --- |\n${colorRows}\n\nRatios are sums of displayed sRGB channels within the fixed two-sigma projected bar, excluding catalogue gas and stellar-object footprints. ${num(bar.aperturePixels).toLocaleString('en-US')} clean pixels remain out of ${num(bar.barPixels).toLocaleString('en-US')}. The same mask applies to all three measurements. The declared tolerance is ±2% relative for each ratio. These are publisher-appearance colors, not calibrated physical passbands.\n\n| Whole-image RGB RMS | l17 | l18 | Relative change |\n| --- | --- | --- | --- |\n| First checkerboard | ${f(before.trainRelativeRms)} | ${f(after.trainRelativeRms)} | ${change('trainRelativeRms')} |\n| Second checkerboard | ${f(before.heldoutRelativeRms)} | ${f(after.heldoutRelativeRms)} | ${change('heldoutRelativeRms')} |\n\nThe declared limit is no more than +1% relative on either residual; improvement is not required. Both checkerboards have supplied calibration pixels and are not independent validation.\n\nTiny took ${num(rec(rungs[0]).seconds).toFixed(1)} seconds; 512 px took ${num(result.seconds).toFixed(1)} seconds. [Method](method.md) and [visual review](visual-review.md) record the limits. No full-resolution fit or slab bake ran.\n`);
const path=ROOT+'src/objects/lmc-volume/source/preparation/l18/recipe.json',recipe=rec(await json(path));await writeFile(path,JSON.stringify({...recipe,decision},null,2)+'\n');console.log(JSON.stringify({sentinel:'L18_COLOR_REPORT_COMPLETE',...decision}));
