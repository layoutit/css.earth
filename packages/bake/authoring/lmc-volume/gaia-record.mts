/** l13 records retain l12 lineage and name the replacement Gaia population. */
import {mkdir,copyFile,writeFile} from 'node:fs/promises';
import {ROOT,json,rec,array} from './inputs.mts';
import type {CatalogueScene} from './catalogue-scene.mts';
import {L13,SELECTION_PAPER} from './gaia-young.mts';
export async function recordGaiaVersion(scene:CatalogueScene,runs:unknown[],fit:unknown){const base=ROOT+'src/objects/lmc-volume/source/preparation/',dir=base+'l13/',oldLineage=rec(await json(base+'l12/lineage.json'));await mkdir(dir,{recursive:true});const write=(name:string,value:unknown)=>writeFile(dir+name+'.json',JSON.stringify(value,null,2)+'\n');
 oldLineage.inputProducts=[...array(oldLineage.inputProducts).map(v=>{const r=rec(v);return typeof r.product==='string'&&r.product.startsWith('SMASH')?{...r,role:'Independent morphology check only; no l13 emission or attenuation comes from this input.'}:r;}),...await Promise.all(['calibration','young'].map(async name=>{const r=rec(await json(L13+`inputs/${name}.request.json`));return{path:`src/objects/lmc-volume/.local/versions/l13/inputs/${name}.rows.json`,product:r.product,url:r.service,query:r.query,rows:r.rows,bytes:r.bytes,complete:r.complete,acquisitionRoute:r.route,role:name==='calibration'?'Learn the global LMC proper-motion membership ellipse.':'Selected Young 1 and Young 2 source counts supply the diffuse population density.'};}))];
 await Promise.all([
 write('recipe',{schema:'lmc-gaia-population@1',generator:'packages/bake/authoring/lmc-volume/catalogue-run.mts',generatorArguments:['--version=13'],acceptedByOwner:false,parent:'l12',physicalChange:'Replace only diffuse young density with Gaia DR3 Young 1 + Young 2 members.',geometry:scene.metadata,calibration:'Same per-object brightness, one global population gain, component RGB grades and shared tone curve as l12.',replayStages:['gaia-young.mts --pilot','gaia-young.mts','catalogue-run.mts --version=13','gaia-report.mts','record-manifest.mts']}),
 write('fit',fit),copyFile(base+'l12/frame.json',dir+'frame.json'),
 write('field',{generator:'packages/bake/authoring/lmc-volume/frozen-l12.mts',workingGeometry:'src/objects/lmc-volume/.local/versions/l13/structure.json',...scene.metadata}),
 write('lineage',{...oldLineage,parentModel:'src/objects/lmc-volume/source/preparation/l12/',gaia:{product:'Gaia DR3 gaiadr3.gaia_source',selectionPaper:SELECTION_PAPER,selection:'src/objects/lmc-volume/.local/versions/l13/selection.md',queryRecords:['src/objects/lmc-volume/.local/versions/l13/inputs/calibration.request.json','src/objects/lmc-volume/.local/versions/l13/inputs/young.request.json'],generator:'packages/bake/authoring/lmc-volume/gaia-young.mts'},hybridSources:{objectShapes:'src/objects/lmc-volume/.local/versions/l12/object-shapes.json',populationMap:'src/objects/lmc-volume/.local/versions/l13/young-density.json',photoObservation:rec(scene.metadata.hybrid).photoObservation},references:[...array(oldLineage.references).map(v=>rec(v).id==='SMASH'?{...rec(v),role:'Independent morphology check only in l13; never supplies density, normalization or missing support.'}:v),{id:'GaiaLuri2021',url:SELECTION_PAPER,role:'Young 1 + Young 2 CMD polygons and conditional orthographic proper-motion membership method.'},{id:'GaiaDR3',url:'https://www.cosmos.esa.int/web/gaia/dr3',role:'DR3 source astrometry and photometry; EDR3 astrometry retained, G corrections already included.'}]}),
 write('provenance',{status:'Unaccepted l13 Gaia-population prototype',rungs:runs,sheet:'src/objects/lmc-volume/.local/versions/l13/sheet.png',preservation:'src/objects/lmc-volume/.local/versions/l13/preservation.json',outerLightControl:'src/objects/lmc-volume/.local/versions/l13/outer-control-small.json',fullFit:false,slabs:false})]);
}
