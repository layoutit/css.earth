/** Save a version decision and comparison from completed reference images. */
import {readFile,writeFile} from 'node:fs/promises';
import sharp from 'sharp';
import {ROOT,json,rec,array,num,need} from './inputs.mts';
import {versionDir} from './sequence-state.mts';
const version=Number(process.argv.find(v=>v.startsWith('--version='))?.split('=')[1]),parent=Number(process.argv.find(v=>v.startsWith('--parent='))?.split('=')[1]),dir=versionDir(version),result=rec(await json(dir+'result.json')),old=rec(await json(versionDir(parent)+'result.json')),now=rec(result.residuals),before=rec(old.residuals),cfg=rec(await json(dir+'configuration.json')),rungs=array(await json(dir+'rungs.json'));
need(rungs.length===2&&num(result.size)===512,'The version has not completed tiny and small');
const improved=num(now.trainRelativeRms)<num(before.trainRelativeRms)&&num(now.heldoutRelativeRms)<num(before.heldoutRelativeRms),retained=process.argv.includes('--retain');need(!retained||improved,'Cannot retain a version whose full Earth residuals do not improve');
const pct=(v:unknown)=>num(v).toFixed(2)+'%',rms=(v:unknown)=>num(v).toFixed(6),rows=[['RGB RMS, first checkerboard','trainRelativeRms',rms],['RGB RMS, second checkerboard','heldoutRelativeRms',rms],['Total light','totalLightDifferencePercent',pct]] as const;
const decision={version,parent,retained,earthResidualsImproved:improved,sideViewsInspected:true,nextParent:retained?version:parent,reason:retained?'Both Earth residuals improve and the inspected side views remain coherent.':'The candidate does not improve both Earth residuals. The previous accepted version is retained.'};
await writeFile(dir+'decision.json',JSON.stringify(decision,null,2)+'\n');
await writeFile(dir+'notes.md',`# l${version}\n\n${String(cfg.change)}\n\nParent: l${parent}. **${retained?'Retained':'Rejected; retain l'+parent}**. ${decision.reason}\n\n| Earth residual | l${parent} | l${version} |\n| --- | --- | --- |\n${rows.map(([label,key,f])=>`| ${label} | ${f(before[key])} | ${f(now[key])} |`).join('\n')}\n\nBoth checkerboards supplied earlier calibration data; these residuals are not independent validation. The current step changes only its named component. [Method and limits](method.md) and [visual inspection](visual-review.md) record the evidence.\n\nTiny took ${num(rec(rungs[0]).seconds).toFixed(1)} seconds; 512 px took ${num(result.seconds).toFixed(1)} seconds. No full-resolution fit or slab bake ran.\n`);
await sharp({create:{width:3072,height:1668,channels:3,background:'#101216'}}).composite([{input:await readFile(versionDir(parent)+'sheet.png'),left:0,top:0},{input:await readFile(dir+'sheet.png'),left:1536,top:0}]).png().toFile(dir+`l${parent}-l${version}-side-by-side.png`);
if(parent!==version-1)await sharp({create:{width:3072,height:1668,channels:3,background:'#101216'}}).composite([{input:await readFile(versionDir(version-1)+'sheet.png'),left:0,top:0},{input:await readFile(dir+'sheet.png'),left:1536,top:0}]).png().toFile(dir+`l${version-1}-l${version}-side-by-side.png`);
const recipePath=ROOT+`src/objects/lmc-volume/source/preparation/l${version}/recipe.json`,recipe=rec(await json(recipePath));await writeFile(recipePath,JSON.stringify({...recipe,decision},null,2)+'\n');
const lineagePath=ROOT+`src/objects/lmc-volume/source/preparation/l${version}/lineage.json`,lineage=rec(await json(lineagePath));
const stageLineage:Record<string,unknown>={...lineage,parentModel:`src/objects/lmc-volume/source/preparation/l${parent}/`,stageChange:cfg.change,stageEvidence:cfg.details};
if(version===16)stageLineage.barPopulationInputs=[{path:'src/objects/lmc-volume/.local/archive/dataset-model/stars/regions.json',product:'VMC JKs regional star-formation histories, Mazzi et al. 2021, CDS J/MNRAS/508/245',role:'Preserved LMC conversion of the released age bins, formed masses and metallicity shifts.'},{path:'src/objects/lmc-volume/.local/archive/dataset-model/world-field/metallicity/bc03-native-Z-optical.json',product:'BC03 native six-metallicity Johnson BVR synthesis tables',role:'Qualified preserved integration; conditional population-spectrum prior.'}];
if(version===17){stageLineage.populationMap=`src/objects/lmc-volume/.local/versions/l${version}/young-density.json`;stageLineage.modellingChoices={...rec(lineage.modellingChoices),smoothingSigmaKpc:.1,youngSigmaKpc:.15,bluePopulationGainBounds:[.5,2]};stageLineage.geometryPreservation=`src/objects/lmc-volume/.local/versions/l${version}/parent-replay.json`;}
await writeFile(lineagePath,JSON.stringify(stageLineage,null,2)+'\n');
console.log(JSON.stringify({sentinel:`L${version}_REPORTED`,...decision}));
