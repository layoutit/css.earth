/** LMC-specific crowding: Rathore 2025, Riello 2021 C*, Olsen 2003 recovery calibration. */
import {writeFile} from 'node:fs/promises';
import {pathToFileURL} from 'node:url';
import {L21,loadCompleteness,tcgCompleteness} from './completeness.mts';
import {loadOld,insidePolygon,RC_POLYGON} from './gaia-old.mts';
import {loadParent} from './sequence-state.mts';
import {gaiaWarpLocator} from './gaia-plane.mts';
import {blur} from './young-density.mts';
import {at,makeRaster,need,type Raster,type Sources} from './inputs.mts';
import type {GaiaStar} from './gaia-young.mts';
import {acquireCalibration} from './rathore-calibration.mts';
type PhotometricStar=Pick<GaiaStar,'id'|'ra'|'dec'|'g'|'bp'|'rp'>&{fluxExcess?:number};
export function correctedExcess(s:Pick<GaiaStar,'g'|'bp'|'rp'>&{fluxExcess?:number}){need(s.bp!==null&&s.rp!==null,'Missing Gaia photometry');const c=s.bp-s.rp,excess=s.fluxExcess??(10**(-.4*(s.bp-s.g+25.6873668671-25.3385422158))+10**(-.4*(s.rp-s.g+25.6873668671-24.7478955012))),expected=c<.5?1.154360+.033772*c+.032277*c*c:c<4?1.162004+.011464*c+.049255*c*c-.005879*c**3:1.057572+.140537*c;return excess-expected;}
export function recovery(sigma:number,intrinsic=.04){const crowd=Math.sqrt(Math.max(0,sigma*sigma-intrinsic*intrinsic));return .5*(1-Math.tanh((crowd-.13)/.07));}
const group=(s:PhotometricStar)=>s.fluxExcess!==undefined?1:s.g<18?0:s.bp!==null&&s.rp!==null&&insidePolygon(s.bp-s.rp,s.g,RC_POLYGON)?1:2;
export async function crowdingFields(stars:PhotometricStar[],sources:Sources){const calibration=await acquireCalibration(),input:PhotometricStar[]=[...stars.filter(s=>group(s)!==1),...calibration];stars=input;const n=512,half=10,cell=2*half/n,locate=gaiaWarpLocator(sources),points=stars.map(s=>locate(s.ra,s.dec)),groups=stars.map(group),c=Float64Array.from(stars,correctedExcess),stats=Array.from({length:3},()=>({n:0,sum:0,square:0,outer:[] as number[]}));for(let i=0;i<stars.length;i++){const p=points[i],r=Math.hypot(p[0],p[1]);if(r>9)continue;const a=stats[groups[i]];a.n++;a.sum+=c[i];a.square+=c[i]**2;if(r>4&&r<7)a.outer.push(c[i]);}const summaries=stats.map((v,k)=>{const mean=v.sum/v.n,sigma=Math.sqrt(v.square/v.n-mean*mean),values=v.outer.filter(x=>Math.abs(x-mean)<3*sigma),m=values.reduce((a,b)=>a+b,0)/values.length,sd=Math.sqrt(values.reduce((a,b)=>a+(b-m)**2,0)/values.length);need(values.length>100,'Missing uncrowded C* reference');return{population:['Bright RGB','RC','Faint RGB'][k],n:v.n,mean,sigma,outerStars:values.length,outerSigma:sd,intrinsicSigma:k===1?.04:sd};}),maps:Raster[]=[],support:Raster[]=[];
 for(let k=0;k<3;k++){const count=new Float64Array(n*n),sum=new Float64Array(n*n),square=new Float64Array(n*n),s=summaries[k];for(let i=0;i<stars.length;i++){if(groups[i]!==k||Math.abs(c[i]-s.mean)>=3*s.sigma)continue;const p=points[i],x=(p[0]/half+1)*n/2-.5,y=(p[1]/half+1)*n/2-.5,ix=Math.floor(x),iy=Math.floor(y),u=x-ix,v=y-iy;for(let b=0;b<2;b++)for(let a=0;a<2;a++){const xx=ix+a,yy=iy+b;if(xx<0||yy<0||xx>=n||yy>=n)continue;const j=yy*n+xx,w=(a?u:1-u)*(b?v:1-v);count[j]+=w;sum[j]+=w*c[i];square[j]+=w*c[i]**2;}}
  const map=makeRaster(n,half),covered=makeRaster(n,half);covered.mask.fill(1);for(const sigma of [.1,.2,.4]){const px=sigma/cell,nn=blur(count,n,n,px),ss=blur(sum,n,n,px),qq=blur(square,n,n,px);for(let i=0;i<n*n;i++){if(map.mask[i]||nn[i]*4*Math.PI*px*px<30)continue;const mean=ss[i]/nn[i],sd=Math.sqrt(Math.max(0,qq[i]/nn[i]-mean*mean));map.values[i]=recovery(sd,s.intrinsicSigma);map.mask[i]=1;covered.values[i]=sigma;}}maps.push(map);support.push(covered);await writeFile(L21+`crowding-${k}.f32le`,Buffer.from(map.values.buffer));await writeFile(L21+`crowding-${k}.mask.u8`,Buffer.from(map.mask));await writeFile(L21+`crowding-${k}-scale.f32le`,Buffer.from(covered.values.buffer));}
 await writeFile(L21+'crowding-statistics.json',JSON.stringify({summaries,n,halfKpc:half,rcCalibrationStars:calibration.length,rcSelection:'Rathore Appendix A: full Gaia DR3, G 18.6–19.3, BP–RP 1.0–1.3, astrometric_excess_noise <0.2, parallax <0.1 and parallax/error <5, raw proper-motion circle radius 1.5 mas/yr, 10-degree footprint.',method:'Gaussian local C* moments at the finest of 100, 200 or 400 pc reaching 30 effective stars. RC intrinsic sigma 0.04 is published. RGB moments are retained as diagnostics; the adopted RGB correction uses parent completeness only.',paper:'https://arxiv.org/html/2410.18182',calibration:'https://arxiv.org/abs/astro-ph/0304163',limitations:'The Olsen recovery relation uses LMC-field-like artificial stars, including HST/WFPC2 images of NGC 1835. Adaptive smoothing and applying the narrow calibration to the wider l20 clump tracer are adopted extensions. Unknown RC crowding cells use parent completeness only.'},null,2)+'\n');return{maps,support,groups,points,summaries};}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url){const old=await loadOld(),{scene}=await loadParent(20),stars=[...old.points,...old.density.filter(s=>s.g>=18)],fields=await crowdingFields(stars,scene.sources),parent=await loadCompleteness(),locate=gaiaWarpLocator(scene.sources),summary=Array.from({length:3},()=>({n:0,prob:0,min:1,flux:0,corrected:0,low:0,unknown:0}));for(let i=0;i<stars.length;i++){const p=locate(stars[i].ra,stars[i].dec),r=Math.hypot(p[0],p[1]);if(r>9)continue;const s=stars[i],j=r<1.5?0:r<4?1:2,a=summary[j],map=fields.maps[group(s)],raw=at(map,p[0],p[1]),catalogue=tcgCompleteness(s.g,parent.atStar(s.id)),prob=raw>0?Math.min(catalogue,raw):catalogue,flux=10**(-.4*(s.g-20))*(s.g<18?1:18.11709771);a.n++;a.prob+=prob;a.min=Math.min(a.min,prob);a.flux+=flux;a.corrected+=flux/Math.max(.005,prob);a.low+=Number(prob<.005);a.unknown+=Number(raw===0);}console.log(JSON.stringify({sentinel:'L21_CROWDING_PROBED',summary:summary.map((a,i)=>({region:i,stars:a.n,meanCompleteness:a.prob/a.n,min:a.min,fluxCorrection:a.corrected/a.flux,belowPointFivePercent:a.low,unknown:a.unknown})),tracers:fields.summaries}));}
