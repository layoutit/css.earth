function normal(id:number){let x=Math.sin(id*12.9898+78.233)*43758.5453,y=Math.sin(id*39.3467+12.345)*23421.631;x-=Math.floor(x);y-=Math.floor(y);return Math.max(-3,Math.min(3,Math.sqrt(-2*Math.log(Math.max(1e-10,x)))*Math.cos(2*Math.PI*y)));}
export function splitFineDust(map:Raster,coverage:Raster){const cell=2*map.half/map.n,broad=blur(Float64Array.from(map.values),map.n,map.n,.031/cell),diffuse=makeRaster(map.n,map.half),excess=makeRaster(map.n,map.half);diffuse.mask.fill(1);excess.mask.fill(1);for(let y=0;y<map.n;y++)for(let x=0;x<map.n;x++){const i=y*map.n+x,px=((x+.5)/map.n*2-1)*map.half,py=((y+.5)/map.n*2-1)*map.half,covered=at(coverage,px,py)>.999,base=covered?Math.min(map.values[i],broad[i]):map.values[i];diffuse.values[i]=base;excess.values[i]=map.values[i]-base;}return{diffuse,excess};}
export function dustCloud(id:string,center:V3,radius:number,mass:number){return volumeObject({id,owner:'HERITAGE-fine',kind:'dust',component:0,center,basis:planarBasis(0),axes:[radius,radius,radius],inner:0,color:[1,1,1],weight:mass,source:'Gordon2014 BEMBB fine excess; Bell2022 global column; adopted spherical depth and height prior'});}
function skyIndex(clouds:VolumeObject[]){const size=.1,map=new Map<string,VolumeObject[]>();for(const cloud of clouds){const p=rayPlane(earthRayOfBody(cloud.center)),key=Math.floor(p[0]/size)+','+Math.floor(p[1]/size),items=map.get(key)??[];items.push(cloud);map.set(key,items);}return(p:V3)=>{const key=[Math.floor(p[0]/size),Math.floor(p[1]/size)],items:VolumeObject[]=[];for(let y=-2;y<=2;y++)for(let x=-2;x<=2;x++)items.push(...(map.get((key[0]+x)+','+(key[1]+y))??[]));return items;};}
export function normalizePhysicalDust(diffuse:Raster,clouds:VolumeObject[],scene:CatalogueScene){const lookup=skyIndex(clouds),bell=scene.sources.dust;let measured=0,model=0,samples=0;for(let y=0;y<bell.n;y+=2)for(let x=0;x<bell.n;x+=2){const i=y*bell.n+x,px=((x+.5)/bell.n*2-1)*bell.half,py=((y+.5)/bell.n*2-1)*bell.half;if(!bell.mask[i]||Math.abs(px)>=diffuse.half||Math.abs(py)>=diffuse.half)continue;const anchor:V3=[px,py,at(scene.sources.warp,px,py)],sky=earthRayOfBody(anchor),ray=rayInBody(sky),dir=normalize(ray.direction),bounds=boundsInterval(ray.origin,dir);if(!bounds)continue;let tau=0;const steps=Math.ceil((bounds[1]-bounds[0])/.04),ds=(bounds[1]-bounds[0])/steps;for(let k=0;k<steps;k++){const p=add(ray.origin,mul(dir,bounds[0]+(k+.5)*ds)),z=p[2]-at(scene.sources.warp,p[0],p[1]);tau+=at(diffuse,p[0],p[1])*gaussian(z,.25)*ds;}for(const cloud of lookup(rayPlane(sky))){const c=chord(cloud,ray.origin,dir);if(c)tau+=cloud.weight*column(cloud,c);}model+=tau*Math.cos(INCLINATION);measured+=bell.values[i];samples++;}need(samples>100&&model>0,'Dust lost Bell support');const factor=measured/model;for(let i=0;i<diffuse.values.length;i++)diffuse.values[i]*=factor;for(const cloud of clouds)cloud.weight*=factor;return{samples,factor,bellMeanFaceOnTauV:measured/samples,beforeMeanFaceOnTauV:model/samples,afterMeanFaceOnTauV:model*factor/samples,meaning:'Same actual Earth rays through finite clouds and diffuse layer, projected to face-on equivalent with the retained inclination. One common scalar matches the Bell mean.'};}
export async function buildContrastDust(scene:CatalogueScene){need(scene.dustLayer,'Missing accepted dust');const parent=scene.dustLayer.column,n=1024,half=parent.half,map=makeRaster(n,half);map.mask.fill(1);for(let y=0;y<n;y++)for(let x=0;x<n;x++)map.values[y*n+x]=at(parent,((x+.5)/n*2-1)*half,((y+.5)/n*2-1)*half);const bytes=await readFile(L22+'../l19/dust-coverage.f32le');need(bytes.length===2048**2*4,'Invalid HERITAGE support');const coverage:Raster={n:2048,half:10,values:new Float32Array(Uint8Array.from(bytes).buffer),mask:new Uint8Array(2048**2).fill(1)},split=splitFineDust(map,coverage),cell=2*half/n,radius=cell*1.8,locate=gaiaWarpLocator(scene.sources),clouds:VolumeObject[]=[],{rows}=await catalogueRows(),tara=rows.find(r=>r.aliases.includes('30 Doradus'));need(tara,'Missing 30 Dor footprint');let cloudMass=0,totalMass=0,nearClouds=0,sum=0,square=0;
 for(let y=0;y<n;y++)for(let x=0;x<n;x++){const i=y*n+x,px=((x+.5)/n*2-1)*half,py=((y+.5)/n*2-1)*half,mass=split.excess.values[i]*cell*cell;totalMass+=map.values[i]*cell*cell;if(mass<1e-12)continue;const [ra,dec]=skyOf(bodyToIcrs([px,py,at(scene.sources.warp,px,py)])),separation=Math.hypot((ra-tara.ra)*Math.cos(tara.dec*Math.PI/180),dec-tara.dec),foreground=separation<.15,offset=foreground?.4:0,height=.25*normal(i+1)+offset,center=locate(ra,dec,height,.25);clouds.push(dustCloud('HERITAGE-'+i,center,radius,mass));cloudMass+=mass;sum+=mass*(height-offset);square+=mass*(height-offset)**2;if(foreground)nearClouds++;}
 need(clouds.length>1000&&cloudMass>0,'No measured fine dust excess');const normalization=normalizePhysicalDust(split.diffuse,clouds,scene);scene.dustLayer={column:split.diffuse,strength:1.025,retainMolecular:false,clouds};const metadata={version:22,parent:21,n,halfKpc:half,finiteClouds:true,clouds:clouds.length,radiusPc:radius*1000,skyAndDepthDiameterPc:radius*2000,cloudMassFraction:cloudMass/totalMass,normalization,strengthBounds:[.25,2],strength:1.025,layerSigmaKpc:.25,cloudCentreSigmaKpc:.25,actualMassWeightedHeightSigmaKpc:Math.sqrt(square/cloudMass-(sum/cloudMass)**2),nearClouds,foreground:{region:'Only the measured HERITAGE pixels within 0.15 degree of catalogued 30 Doradus',orderingSource:'https://arxiv.org/html/2203.03206',normalOffsetKpc:.4,assumptions:'The paper supports foreground ordering there, not this 400 pc offset or our smaller circular footprint. The offset is an adopted representative placement. There is no measured whole-bar foreground offset, so no such offset is applied.'},source:'l21 HERITAGE fine structure normalized to Bell, decomposed into nonnegative diffuse floor and positive fine excess at 5 arcmin. Source gaps retain the entire parent diffuse column.',depth:'Finite spherical cloud kernels have equal sky and line-of-sight widths, with deterministic draws from the adopted 250 pc centre-height prior. Each centre preserves its observed HERITAGE sky direction. Individual depths are assumed, never obtained from the photo. The diffuse remainder keeps the 250 pc Gaussian layer on the warp.',geometry:'No camera-facing opacity sheet and no Earth-direction columns. The same finite clouds attenuate all views.',limits:'HERITAGE gives a projected model dust column, not a measured depth map. The cloud prior preserves fine on-sky structure conditionally. Bell provides only the global column normalization.'};await writeFile(L22+'dust-column.f32le',Buffer.from(split.diffuse.values.buffer));await writeFile(L22+'dust-clouds.json',JSON.stringify(clouds)+'\n');await writeFile(L22+'dust-column.json',JSON.stringify(metadata,null,2)+'\n');return metadata;
}
