/** Exact Appendix A calibration RC sample, independent of the LMC light tracer. */
import {mkdir,writeFile,stat} from 'node:fs/promises';import {pathToFileURL} from 'node:url';
import {tapRows} from '@cssearth/telescope-core/node';import {json,rec,array,num,need} from './inputs.mts';import {L21} from './completeness.mts';import {GAIA_SERVICE} from './gaia-young.mts';
export interface CalibrationStar {id:string;ra:number;dec:number;g:number;bp:number;rp:number;fluxExcess:number;}
export function calibrationQuery(lo:number,hi:number,pilot=false){return `SELECT TOP 800001 source_id,ra,dec,phot_g_mean_mag,phot_bp_mean_mag,phot_rp_mean_mag,phot_bp_rp_excess_factor FROM gaiadr3.gaia_source WHERE ra>=50 AND ra<=110 AND dec>=-80 AND dec<=-55 AND parallax<0.1 AND parallax_error>0 AND parallax/parallax_error<5 AND POWER(pmra-1.8593,2)+POWER(pmdec-0.3747,2)<2.25 AND astrometric_excess_noise<0.2 AND phot_g_mean_mag>=${lo} AND phot_g_mean_mag<${hi} AND phot_bp_mean_mag-phot_rp_mean_mag>=1 AND phot_bp_mean_mag-phot_rp_mean_mag<=1.3 AND 1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',80.443,-69.272,${pilot?.2:10}))`;}
export function parseCalibration(raw:unknown):CalibrationStar[]{return array(raw).map(v=>{const r=rec(v),n=(k:string)=>{const v=r[k];need(typeof v==='string'||typeof v==='number','Missing calibration number');const x=Number(v);need(Number.isFinite(x),'Invalid calibration number');return x;};need(typeof r.source_id==='string'&&/^\d{10,20}$/u.test(r.source_id),'Invalid source identity');const s={id:r.source_id,ra:n('ra'),dec:n('dec'),g:n('phot_g_mean_mag'),bp:n('phot_bp_mean_mag'),rp:n('phot_rp_mean_mag'),fluxExcess:n('phot_bp_rp_excess_factor')};need(s.ra>=50&&s.ra<=110&&s.dec>=-80&&s.dec<=-55&&s.g>=18.6-2e-6&&s.g<=19.3+2e-6&&s.fluxExcess>0&&s.bp-s.rp>=1-4e-6&&s.bp-s.rp<=1.3+4e-6,'Calibration answer violates the selection: '+JSON.stringify(s));return s;});}
export async function acquireCalibration(pilot=false){await mkdir(L21+'inputs/',{recursive:true});const parts=await Promise.allSettled([[18.6,18.95],[18.95,19.3]].map(async([lo,hi])=>{const path=L21+`inputs/rathore-${lo}-${hi}${pilot?'-pilot':''}`,query=calibrationQuery(lo,hi,pilot),cached=await json(path+'.request.json').then(rec).catch(()=>null);if(cached?.complete===true&&cached.query===query&&await stat(path+'.rows.json').catch(()=>null)){const stars=parseCalibration(await json(path+'.rows.json'));need(stars.length===num(cached.rows),'Incomplete RC cache');return stars;}const start=performance.now();console.log(JSON.stringify({sentinel:'L21_RC_CALIBRATION_QUERY_STARTED',lo,hi,pilot}));const raw=await tapRows(GAIA_SERVICE,query,800003,'async');need(raw.length>0&&raw.length<800000,'Calibration query truncated; do not continue');const bytes=Buffer.from(JSON.stringify(raw));need(bytes.length<350*1024**2,'Calibration query exceeds byte budget');await writeFile(path+'.rows.json',bytes);const stars=parseCalibration(raw);await writeFile(path+'.request.json',JSON.stringify({query,service:GAIA_SERVICE,product:'Gaia DR3 Rathore Appendix A calibration RC selection',rows:stars.length,bytes:bytes.length,seconds:(performance.now()-start)/1000,complete:true,pilot,paper:'https://arxiv.org/html/2410.18182'},null,2)+'\n');console.log(JSON.stringify({sentinel:'L21_RC_CALIBRATION_QUERY_COMPLETE',lo,hi,pilot,rows:stars.length,seconds:(performance.now()-start)/1000}));return stars;}));const result:CalibrationStar[]=[];for(const p of parts){if(p.status==='rejected')throw p.reason;for(const s of p.value)result.push(s);}need(new Set(result.map(s=>s.id)).size===result.length,'Repeated calibration star');return result;}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url){const stars=await acquireCalibration(process.argv.includes('--pilot'));console.log(JSON.stringify({sentinel:'L21_RC_CALIBRATION_READY',stars:stars.length}));}
