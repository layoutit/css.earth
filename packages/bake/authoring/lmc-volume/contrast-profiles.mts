/** Five fixed perpendicular cuts. Photo-selected gap bins are diagnostics, never density. */
import {bodyToIcrs,add,mul,type V3} from './geometry.mts';import {perspectiveBarMoments,type BarGeometry} from './bar-geometry.mts';
import {barAperture,photoRgb} from './bar-ratios.mts';import {LUMA} from './grade.mts';import {need} from './inputs.mts';import type {CatalogueRow} from './catalogue-data.mts';import type {Observation} from './report.mts';
export const decode=(x:number)=>x<=.04045?x/12.92:((x+.055)/1.055)**2.4;
export interface CutPlan {bins:number;positions:number[];ids:number[][][];coordinate:number[];gapBins:number[][];photo:number[][];widthKpc:number;}
export function cutCoordinates(o:Observation,b:BarGeometry){const center=o.pixelOf(bodyToIcrs(b.center));need(center,'Missing bar centre');const axes:V3[]=[[b.sigma*Math.cos(b.angle),b.sigma*Math.sin(b.angle),0],[-b.sigma*b.ratio*Math.sin(b.angle),b.sigma*b.ratio*Math.cos(b.angle),0],[0,0,b.sigmaZ]];let xx=0,yy=0,xy=0;for(const axis of axes){const p=o.pixelOf(bodyToIcrs(add(b.center,axis))),q=o.pixelOf(bodyToIcrs(add(b.center,mul(axis,-1))));need(p&&q,'Missing bar axis');const x=(p[0]-q[0])/2,y=(p[1]-q[1])/2;xx+=x*x;yy+=y*y;xy+=x*y;}const d=Math.hypot(xx-yy,2*xy),angle=.5*Math.atan2(2*xy,xx-yy),pixelSigma=Math.sqrt((xx+yy+d)/2),scale=perspectiveBarMoments(b).sigmaMajorKpc/pixelSigma;return{center,angle,scale,at(x:number,y:number){const dx=x-center[0],dy=y-center[1];return[(dx*Math.cos(angle)+dy*Math.sin(angle))*scale,(-dx*Math.sin(angle)+dy*Math.cos(angle))*scale];}};}
export function profileValues(rgb:Float64Array,plan:CutPlan){return plan.ids.map(cut=>cut.map(ids=>ids.length?ids.reduce((s,p)=>s+rgb[p*3]*LUMA[0]+rgb[p*3+1]*LUMA[1]+rgb[p*3+2]*LUMA[2],0)/ids.length:NaN));}
export function makeCutPlan(o:Observation,b:BarGeometry,rows:CatalogueRow[]):CutPlan{const bins=o.width<128?16:64,positions=[-1,-.5,0,.5,1],coordinates=cutCoordinates(o,b),widthKpc=Math.max(.18,coordinates.scale*1.1),aperture=barAperture(o,b,rows),ids=positions.map(()=>Array.from({length:bins},()=>[] as number[])),coordinate=Array.from({length:bins},(_,i)=>-2+(i+.5)*4/bins);for(let y=0;y<o.height;y++)for(let x=0;x<o.width;x++){const p=y*o.width+x;if(!o.mask[y][x])continue;const [u,v]=coordinates.at(x+.5,y+.5);if(Math.abs(v)>=2)continue;for(let k=0;k<positions.length;k++)if(Math.abs(u-positions[k])<=widthKpc/2)ids[k][Math.floor((v+2)/4*bins)].push(p);}const plan:CutPlan={bins,positions,ids,coordinate,gapBins:[],photo:[],widthKpc};plan.photo=profileValues(Float64Array.from(photoRgb(o),decode),plan);plan.gapBins=plan.photo.map(values=>[-1,1].map(sign=>{let best=-1,value=Infinity;for(let i=0;i<bins;i++)if(coordinate[i]*sign>=.7&&coordinate[i]*sign<=1.6&&Number.isFinite(values[i])&&values[i]<value){value=values[i];best=i;}need(best>=0,'A cut lacks a measured gap');return best;}));return plan;}
function core(profile:number[],plan:CutPlan){const values=profile.filter((v,i)=>Math.abs(plan.coordinate[i])<.3&&Number.isFinite(v));need(values.length>0,'Missing measured cut core');return values.reduce((a,b)=>a+b,0)/values.length;}
export function cutStatistics(values:number[][],plan:CutPlan){const cuts=values.map((profile,k)=>{const peak=core(profile,plan),target=core(plan.photo[k],plan),gaps=plan.gapBins[k].map(i=>profile[i]/peak),photoGaps=plan.gapBins[k].map(i=>plan.photo[k][i]/target);let s=0,n=0;for(let i=0;i<plan.bins;i++)if(Number.isFinite(profile[i])&&Number.isFinite(plan.photo[k][i])){s+=((profile[i]-plan.photo[k][i])/target)**2;n++;}return{alongBarKpc:plan.positions[k],core:peak,photoCore:target,profileRelativeRms:Math.sqrt(s/n),gapToCore:gaps,photoGapToCore:photoGaps,gapDepthAbsoluteError:gaps.reduce((s,v,i)=>s+Math.abs(v-photoGaps[i]),0)/2};});return{cuts,meanProfileRelativeRms:cuts.reduce((s,v)=>s+v.profileRelativeRms,0)/cuts.length,meanGapDepthError:cuts.reduce((s,v)=>s+v.gapDepthAbsoluteError,0)/cuts.length};}
