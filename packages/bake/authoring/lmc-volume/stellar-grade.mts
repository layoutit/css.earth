/** Eight global controls: two population RGB grades and two resolved-light fractions. */
import {catalogueBasis,type CatalogueProjection} from './catalogue-render.mts';
import type {CatalogueScene} from './catalogue-scene.mts';
import {gradedPrediction,inverseTone,type Grade} from './grade.mts';
import {loss,type Basis,type Target} from './render.mts';
import {displayRgb,ratios,colorPass,rmsPass,type Aperture} from './bar-ratios.mts';
import {need} from './inputs.mts';
export interface StellarFitOptions {freezeFractions?:boolean;iterations?:number;colorDeadzone?:number;colorWeight?:number;coefficientBounds?:readonly[number,number];regions?:{mask:Uint8Array;weight:number;deadzone?:number}[];regionalColors?:{mask:Uint8Array;rg:number;bg:number;weight:number}[];}
export const FRACTION_BOUNDS=[[.01,.4],[.005,.25]] as const;
export function stellarBasisFamily(projection:CatalogueProjection,scene:CatalogueScene,amplitudes:Float64Array){need(scene.oldPopulation&&projection.grain,'Missing Gaia point field');const pop=scene.oldPopulation,old=pop.oldFraction,young=pop.youngFraction;pop.oldFraction=0;pop.youngFraction=0;const base=catalogueBasis(projection,scene,amplitudes);pop.oldFraction=1;const a=catalogueBasis(projection,scene,amplitudes);pop.oldFraction=0;pop.youngFraction=1;const b=catalogueBasis(projection,scene,amplitudes);pop.oldFraction=old;pop.youngFraction=young;return{base,old:a.planes.map((v,k)=>Float64Array.from(v,(x,i)=>x-base.planes[k][i])),young:b.planes.map((v,k)=>Float64Array.from(v,(x,i)=>x-base.planes[k][i]))};}
export type StellarFamily=ReturnType<typeof stellarBasisFamily>;
export function stellarBasis(f:StellarFamily,old:number,young:number):Basis{return{...f.base,planes:f.base.planes.map((v,k)=>Float64Array.from(v,(x,i)=>x+old*f.old[k][i]+young*f.young[k][i]))};}
export function fitStellarGrade(f:StellarFamily,initial:Grade,target:Target,aperture:Aperture,photo:ReturnType<typeof ratios>,sky:readonly number[],parentRms:readonly number[],fractions:readonly number[]=[.1,.05],options:StellarFitOptions={}){
 const grade=structuredClone(initial),bounds=grade.coefficients.slice(0,2).map(v=>v.map(x=>options.coefficientBounds?[...options.coefficientBounds]:[Math.max(.001,x*.03),Math.min(100,x*30)])),fraction=[...fractions],basis=stellarBasis(f,fraction[0],fraction[1]),inverse=inverseTone(target.data,grade.stretch,grade.saturation);
 // Two-component non-negative least squares initializes global colors only.
 for(let c=0;c<3;c++){let aa=0,bb=0,ab=0,ay=0,by=0;for(let p=0;p<target.train.length;p++)if(target.train[p]){const i=p*3+c,a=basis.planes[0][i]+basis.planes[2][i],b=basis.planes[1][i],y=inverse[i]-basis.planes[3][i]*grade.coefficients[2][c]-basis.planes[4][i]*grade.coefficients[3][c];aa+=a*a;bb+=b*b;ab+=a*b;ay+=a*y;by+=b*y;}for(let k=0;k<50;k++){if(aa>0)grade.coefficients[0][c]=Math.max(bounds[0][c][0],Math.min(bounds[0][c][1],(ay-ab*grade.coefficients[1][c])/aa));if(bb>0)grade.coefficients[1][c]=Math.max(bounds[1][c][0],Math.min(bounds[1][c][1],(by-ab*grade.coefficients[0][c])/bb));}}
 const evaluate=(g:Grade,b:Basis)=>{const prediction=gradedPrediction(b,g),color=ratios(displayRgb(prediction,sky),aperture.mask),rms=[loss(prediction,target),loss(prediction,target,true)],error=[color.rg/photo.rg-1,color.bg/photo.bg-1],score=rms[0]**2+(options.colorWeight??20)*error.reduce((s,e)=>s+Math.max(0,Math.abs(e)-(options.colorDeadzone??.004))**2,0);return{prediction,color,rms,score};};let current=basis,best=evaluate(grade,current);
 for(const step of [.3,.15,.06,.025,.01,.004])for(let repeat=0;repeat<2;repeat++){for(let k=0;k<2;k++)for(let c=0;c<3;c++)for(const sign of [-1,1]){const trial=structuredClone(grade);trial.coefficients[k][c]=Math.max(bounds[k][c][0],Math.min(bounds[k][c][1],trial.coefficients[k][c]*Math.exp(sign*step)));const candidate=evaluate(trial,current);if(candidate.score<best.score){grade.coefficients[k][c]=trial.coefficients[k][c];best=candidate;}}
  // Tiny can choose a global grain fraction, without moving any star or its color.
  if(!options.freezeFractions)for(let k=0;k<2;k++)for(const sign of [-1,1]){const values=[...fraction];values[k]=Math.max(FRACTION_BOUNDS[k][0],Math.min(FRACTION_BOUNDS[k][1],values[k]+sign*step*.25));const b=stellarBasis(f,values[0],values[1]),candidate=evaluate(grade,b);if(candidate.score<best.score){fraction[k]=values[k];current=b;best=candidate;}}}
 const polish=polishStellar(f,grade,fraction,target,aperture,photo,sky,bounds,options);grade.coefficients=polish.grade.coefficients;fraction[0]=polish.fractions[0];fraction[1]=polish.fractions[1];current=stellarBasis(f,fraction[0],fraction[1]);best=evaluate(grade,current);
 grade.score=best.rms[0];return{grade,prediction:best.prediction,fractions:fraction,basis:current,diagnostics:{freeParameters:options.freezeFractions?6:8,optimizer:'Non-negative initialization, bounded coordinate search, then joint damped Gauss–Newton over '+(options.freezeFractions?'six global RGB controls.':'eight global controls.'),coefficientBounds:bounds,resolvedFractionBounds:FRACTION_BOUNDS,photo,candidate:best.color,colorPassed:colorPass(best.color,photo),rmsPassed:rmsPass(best.rms,parentRms),rmsParent:parentRms,rmsCandidate:best.rms,colorToleranceRelative:.02,maximumRelativeRmsRegression:.01,aperturePixels:aperture.pixels}};
}
function solve(matrix:number[][],rhs:number[]){const n=rhs.length,a=matrix.map((v,i)=>[...v,rhs[i]]);for(let k=0;k<n;k++){let pivot=k;for(let i=k+1;i<n;i++)if(Math.abs(a[i][k])>Math.abs(a[pivot][k]))pivot=i;if(Math.abs(a[pivot][k])<1e-15)return null;[a[k],a[pivot]]=[a[pivot],a[k]];const d=a[k][k];for(let j=k;j<=n;j++)a[k][j]/=d;for(let i=0;i<n;i++)if(i!==k){const m=a[i][k];for(let j=k;j<=n;j++)a[i][j]-=m*a[k][j];}}return a.map(v=>v[n]);}
export function regionalColorResiduals(prediction:Float64Array,sky:readonly number[],regions:NonNullable<StellarFitOptions['regionalColors']>){if(!regions.length)return [];const rgb=displayRgb(prediction,sky);return regions.flatMap(r=>{const c=ratios(rgb,r.mask);return[Math.log(c.rg/r.rg),Math.log(c.bg/r.bg)].map(e=>e*Math.sqrt(r.weight));});}
function polishStellar(f:StellarFamily,initial:Grade,fractions:number[],target:Target,aperture:Aperture,photo:ReturnType<typeof ratios>,sky:readonly number[],bounds:number[][][],options:StellarFitOptions={}){
 const range=[...bounds.flat(),...FRACTION_BOUNDS].map(v=>v.map(Math.log)),ids:number[]=[];let denominator=0;for(let p=0;p<target.train.length;p++)if(target.train[p])for(let c=0;c<3;c++){ids.push(p*3+c);denominator+=target.data[p*3+c]**2;}const scale=1/Math.sqrt(denominator),x=[...initial.coefficients.slice(0,2).flat(),...fractions].map(Math.log);
 const evaluate=(v:number[])=>{const grade=structuredClone(initial);for(let k=0;k<2;k++)for(let c=0;c<3;c++)grade.coefficients[k][c]=Math.exp(v[k*3+c]);const fractions=v.slice(6).map(Math.exp),prediction=gradedPrediction(stellarBasis(f,fractions[0],fractions[1]),grade),color=ratios(displayRgb(prediction,sky),aperture.mask),r=Float64Array.from([...ids.map(i=>(prediction[i]-target.data[i])*scale),...[Math.log(color.rg/photo.rg),Math.log(color.bg/photo.bg)].map(e=>Math.sqrt(options.colorWeight??20)*Math.sign(e)*Math.max(0,Math.abs(e)-(options.colorDeadzone??0))),...regionalColorResiduals(prediction,sky,options.regionalColors??[]),...(options.regions??[]).map(region=>{let a=0,b=0;for(let p=0;p<region.mask.length;p++)if(region.mask[p])for(let c=0;c<3;c++){a+=prediction[p*3+c];b+=target.data[p*3+c];}const error=Math.log(Math.max(1e-12,a)/Math.max(1e-12,b));return Math.sqrt(region.weight)*Math.sign(error)*Math.max(0,Math.abs(error)-(region.deadzone??0));})]);return{grade,fractions,r,score:r.reduce((s,a)=>s+a*a,0)};};let best=evaluate(x),lambda=.001;const dimensions=options.freezeFractions?6:8;
 for(let iteration=0;iteration<(options.iterations??35);iteration++){const jac=[];for(let k=0;k<dimensions;k++){const trial=[...x];trial[k]+=.002;const value=evaluate(trial);jac.push(Float64Array.from(value.r,(r,i)=>(r-best.r[i])/.002));}const gram=Array.from({length:dimensions},()=>Array(dimensions).fill(0)),rhs=Array(dimensions).fill(0);for(let k=0;k<dimensions;k++){for(let i=0;i<best.r.length;i++)rhs[k]-=jac[k][i]*best.r[i];for(let j=0;j<=k;j++){let v=0;for(let i=0;i<best.r.length;i++)v+=jac[k][i]*jac[j][i];gram[k][j]=gram[j][k]=v;}gram[k][k]+=lambda*Math.max(1e-6,gram[k][k]);}const delta=solve(gram,rhs);if(!delta)break;let accepted=false;for(const step of [1,.5,.2]){const trial=x.map((v,k)=>Math.max(range[k][0],Math.min(range[k][1],v+(k<dimensions?step*Math.max(-.5,Math.min(.5,delta[k])):0)))),value=evaluate(trial);if(value.score<best.score){for(let k=0;k<dimensions;k++)x[k]=trial[k];best=value;accepted=true;lambda=Math.max(1e-7,lambda/3);break;}}if(!accepted)lambda*=10;if(lambda>1e7)break;}return best;
}
