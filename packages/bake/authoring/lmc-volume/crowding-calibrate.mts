/** Refit six population RGB values; a single global grain scale is measured from a native crop. */
import {stellarBasis,fitStellarGrade,type StellarFamily} from './stellar-grade.mts';import {gradedPrediction,type Grade} from './grade.mts';
import {ratios,photoRgb,barAperture,displayRgb,type Aperture} from './bar-ratios.mts';import {contrast} from './dust-contrast.mts';
import type {Target} from './render.mts';import type {Observation} from './report.mts';import type {BarGeometry} from './bar-geometry.mts';import type {CatalogueRow} from './catalogue-data.mts';
import {rayPlane} from './geometry.mts';
export function fitColors(f:StellarFamily,initial:Grade,target:Target,aperture:Aperture,photo:ReturnType<typeof ratios>,o:Observation,baseline:readonly number[],fractions:number[],tiny=false,limits:{colorDeadzone?:number;outerTolerance?:number;stride?:number;iterations?:number}={}){const stride=limits.stride??(tiny?1:8),ids:number[]=[];for(let p=0;p<target.train.length;p++)if((p%o.width+3*Math.floor(p/o.width))%stride===0)ids.push(p);const pick=(v:Float64Array)=>Float64Array.from({length:ids.length*3},(_,i)=>v[ids[Math.floor(i/3)]*3+i%3]),family:StellarFamily={base:{...f.base,width:ids.length,height:1,planes:f.base.planes.map(pick)},old:f.old.map(pick),young:f.young.map(pick)},sample:Target={data:pick(target.data),train:Uint8Array.from(ids,p=>target.train[p]),holdout:Uint8Array.from(ids,p=>target.holdout[p])},mask=Uint8Array.from(ids,p=>aperture.mask[p]),outer=Uint8Array.from(ids,p=>{const q=rayPlane(o.rayAt(p%o.width+.5,Math.floor(p/o.width)+.5));return Number(Math.hypot(q[0],q[1])>=4&&(target.train[p]||target.holdout[p]));}),sampleAperture={...aperture,mask,bar:Uint8Array.from(ids,p=>aperture.bar[p]),excluded:Uint8Array.from(ids,p=>aperture.excluded[p])},result=fitStellarGrade(family,initial,sample,sampleAperture,photo,o.metadata.sky.rgbLinearDisplay,baseline,fractions,{freezeFractions:true,iterations:limits.iterations??28,colorDeadzone:limits.colorDeadzone,coefficientBounds:[.001,100],regions:[{mask:outer,weight:1,deadzone:Math.log(1+(limits.outerTolerance??.05))}]});return{grade:result.grade,prediction:gradedPrediction(stellarBasis(f,fractions[0],fractions[1]),result.grade),diagnostics:result.diagnostics,sampling:{stride,pixels:ids.length,freeRgbCoefficients:6,fractionsFixed:fractions,outerAnnulusConstraint:true}};}
export function grainPower(f:StellarFamily,grade:Grade,fractions:number[],o:Observation,mask:Uint8Array){return contrast(displayRgb(gradedPrediction(stellarBasis(f,fractions[0],fractions[1]),grade),o.metadata.sky.rgbLinearDisplay),o,mask).power;}
export function matchGrain(f:StellarFamily,grade:Grade,parentFractions:number[],o:Observation,geometry:BarGeometry,rows:CatalogueRow[]){const mask=barAperture(o,geometry,rows).mask,target=contrast(photoRgb(o),o,mask).power,trials=[];let low=.02,high=1,best={scale:1,power:Infinity,error:Infinity};for(let iteration=0;iteration<10;iteration++){const scale=iteration===0?low:iteration===1?high:(low+high)/2,power=grainPower(f,grade,parentFractions.map(v=>v*scale),o,mask),error=Math.abs(power/target-1);trials.push({scale,power,error});if(error<best.error)best={scale,power,error};if(power>target)high=scale;else low=scale;}return{...best,target,trials,toleranceRelative:.1,passed:best.error<=.1};}
