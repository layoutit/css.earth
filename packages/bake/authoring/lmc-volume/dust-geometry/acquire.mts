/** Restore only the owner-approved OGLE tables. An HTML login is never accepted as science. */
import {mkdir,readFile,writeFile,rename} from 'node:fs/promises';
import {need} from '../inputs.mts';import {L25,OGLE_INPUT,parseCells,loadOgle} from './ogle.mts';
await mkdir(L25+'inputs/',{recursive:true});for(const name of OGLE_INPUT.files){const path=L25+'inputs/'+name,cached=await readFile(path,'utf8').catch(()=>null);if(cached!==null){need(parseCells(cached).length>100,'Invalid cached OGLE table');continue;}const response=await fetch(OGLE_INPUT.url+name,{signal:AbortSignal.timeout(30000)});need(response.ok&&response.body,'OGLE table download failed');const chunks:Uint8Array[]=[],reader=response.body.getReader();let size=0;try{while(true){const c=await reader.read();if(c.done)break;size+=c.value.length;need(size<=10*1024**2,'OGLE table exceeds bounded size');chunks.push(c.value);}}finally{reader.releaseLock();}const bytes=Buffer.concat(chunks),text=bytes.toString('utf8');need(parseCells(text).length>100,'Downloaded content is not the published OGLE table');await writeFile(path+'.pending',bytes);await rename(path+'.pending',path);}
const loaded=await loadOgle();await writeFile(L25+'inputs/ogle-intake.json',JSON.stringify(loaded.inputs,null,2)+'\n');console.log(JSON.stringify({sentinel:'L25_OGLE_INPUTS_QUALIFIED',rows:loaded.cells.length,inputs:loaded.inputs}));
