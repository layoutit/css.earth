/** Published OGLE adaptive cells. No foreground or dust depth is hidden in this loader. */
import {readFile,stat} from 'node:fs/promises';
import {LOCAL,need} from '../inputs.mts';
import {DEG} from '../geometry.mts';
export const L25=LOCAL+'versions/l25/',FOREGROUND=.06,RV=3.41,EVI_PER_EBV=1.318;
export const OGLE_INPUT={paper:'https://doi.org/10.3847/1538-4365/abcb81',release:'https://ogle.astrouw.edu.pl/cgi-ogle/get_ms_ext.py',url:'https://ogle.astrouw.edu.pl/ms_ext/txt/',files:['03.4','06.9','13.8','27.5'].map(v=>'skowron2020_'+v+'_arcmin.txt'),quantity:'Median E(V-I) to red-clump stars, including Milky Way foreground.',resolution:'Released text cells are 3.4, 6.9, 13.8 and 27.5 arcminutes wide, with overlapping shifted grids. The paper quotes effective central resolution down to 1.7 arcminutes. This model reports the text cell width actually used.'};
export interface Cell {id:number;ra:number;dec:number;evi:number;lower:number;upper:number;box:number;x:number;y:number;width:number;}
export function hammer(ra:number,dec:number){need(Number.isFinite(ra)&&Number.isFinite(dec)&&Math.abs(dec)<=90,'Invalid OGLE sky coordinate');const r=(ra-49.5)*DEG,d=dec*DEG,d0=-70*DEG,east=Math.cos(d)*Math.sin(r),center=Math.sin(d)*Math.sin(d0)+Math.cos(d)*Math.cos(d0)*Math.cos(r),north=Math.sin(d)*Math.cos(d0)-Math.cos(d)*Math.sin(d0)*Math.cos(r),phi=Math.atan2(east,center),theta=Math.asin(Math.max(-1,Math.min(1,north))),den=Math.sqrt(1+Math.cos(theta)*Math.cos(phi/2));return{x:2*Math.SQRT2*Math.cos(theta)*Math.sin(phi/2)/den,y:Math.SQRT2*Math.sin(theta)/den};}
export function parseCells(text:string,firstId=0){return text.split(/\r?\n/u).filter(v=>v.trim()&&!v.startsWith('#')).map((line,i)=>{const a=line.trim().split(/\s+/u).map(Number);need(a.length===10&&a.every(Number.isFinite)&&a[0]>-24&&a[0]<24&&a[1]>=-90&&a[1]<=90&&a[2]>=0&&a[3]>0&&a[4]>0,'Invalid OGLE table row');const widths=new Map([[3.4,.001],[6.9,.002],[13.8,.004],[27.5,.008]]),width=widths.get(a[9]);need(width!==undefined&&Math.abs(Math.max(0,a[5]-a[6])-a[2])<.00151,'Invalid OGLE color identity or cell width');return{id:firstId+i,ra:(a[0]*15+360)%360,dec:a[1],evi:a[2],lower:a[3],upper:a[4],box:a[9],...hammer(a[0]*15,a[1]),width};});}
export function cellSampler(cells:Cell[]){const bins=new Map<string,Cell[]>(),step=.001,key=(x:number,y:number)=>x+','+y;for(const c of cells){const h=c.width/2+2e-7;for(let y=Math.floor((c.y-h)/step);y<=Math.floor((c.y+h)/step);y++)for(let x=Math.floor((c.x-h)/step);x<=Math.floor((c.x+h)/step);x++){const k=key(x,y),v=bins.get(k)??[];v.push(c);bins.set(k,v);}}const containing=(ra:number,dec:number)=>{const p=hammer(ra,dec);return(bins.get(key(Math.floor(p.x/step),Math.floor(p.y/step)))??[]).filter(c=>Math.abs(p.x-c.x)<=c.width/2+2e-7&&Math.abs(p.y-c.y)<=c.width/2+2e-7);},sample=(ra:number,dec:number)=>{const p=hammer(ra,dec);let best:Cell|undefined,distance=Infinity;for(const c of containing(ra,dec)){const d=(p.x-c.x)**2+(p.y-c.y)**2;if(!best||c.width<best.width||c.width===best.width&&(d<distance||d===distance&&c.id<best.id)){best=c;distance=d;}}return best;};return Object.assign(sample,{containing});}
export function internalAv(evi:number){need(Number.isFinite(evi)&&evi>=0,'Invalid red-clump reddening');return RV*Math.max(0,evi/EVI_PER_EBV-FOREGROUND);}
export async function loadOgle(){const cells:Cell[]=[],files=[];for(const name of OGLE_INPUT.files){const path=L25+'inputs/'+name,parsed=parseCells(await readFile(path,'utf8'),cells.length);need(parsed.length>100,'Incomplete OGLE input');cells.push(...parsed);files.push({name,bytes:(await stat(path)).size,rows:parsed.length,url:OGLE_INPUT.url+name});}need(cells.length===81684,'Unexpected OGLE table release');return{cells,sample:cellSampler(cells),inputs:{...OGLE_INPUT,files,foregroundEbv:FOREGROUND,chen:{paper:'https://doi.org/10.1093/mnras/stac072',regionalMaps:'Unavailable check. Published endpoints time out. The cached mcmap-nadc.fits is an NADC login HTML page, never a science input.',ownerDecision:'Use the published LMC mean Milky Way foreground E(B-V)=0.06 mag. No local Chen copy exists.'}}};}
