/** l25: full HERITAGE columns and OGLE-constrained ordering, without random dust depths. */
import {mkdir,writeFile} from 'node:fs/promises';
import {at,makeRaster,smooth,rec,json,num,need} from '../inputs.mts';
import {bodyToIcrs,skyOf,unit,cross,add,mul,rayInBody,normalize,dot} from '../geometry.mts';
import {loadHeritage} from '../heritage-input.mts';
import {gaiaWarpLocator} from '../gaia-plane.mts';
import {L24,sigmaToAv,MAG_PER_TAU,HERITAGE_INPUT} from '../dust-native/field.mts';
import {loadOgle,internalAv,L25,RV,EVI_PER_EBV} from './ogle.mts';
import {inferHeight,DUST_SIGMA,DEPTH_NODES} from './depth.mts';
import {regionalColumns,type DustPixel} from './regions.mts';
import {volumeObject,type VolumeObject} from '../catalogue-volume.mts';
import type {CatalogueScene} from '../catalogue-scene.mts';
export async function buildGeometryDust(scene:CatalogueScene){
 need(scene.dustLayer,'Missing l24 dust work');await mkdir(L25,{recursive:true});const started=performance.now(),ogle=await loadOgle(),{image,wcs,summary}=await loadHeritage(),normalization=rec(rec(await json(L24+'dust-column.json')).normalization),factor=num(normalization.factor),locate=gaiaWarpLocator(scene.sources),pixels:DustPixel[]=[];
 for(let y=0;y<image.height;y++)for(let x=0;x<image.width;x++){const log=image.values[y*image.width+x];if(!Number.isFinite(log))continue;const [ra,dec]=wcs.skyOf(x,y),a=unit(...wcs.skyOf(x+.5,y)),b=unit(...wcs.skyOf(x-.5,y)),c=unit(...wcs.skyOf(x,y+.5)),d=unit(...wcs.skyOf(x,y-.5)),area=Math.hypot(...cross(add(a,mul(b,-1)),add(c,mul(d,-1))));pixels.push({ra,dec,av:sigmaToAv(10**log)*factor,area});}const native=pixels.length,{groups,matched}=regionalColumns(pixels,ogle.sample);
 need(native===86690&&matched>60000,'Too little measured OGLE/HERITAGE overlap');const regions=Array.from(groups.values()).map(g=>{const total=g.sum/g.area,front=internalAv(g.cell.evi);return{...g.cell,totalAv:total,frontAv:front,rcColorSpreadAv:RV/EVI_PER_EBV*(g.cell.lower+g.cell.upper)/2,...inferHeight(front,total),nativeSamples:g.count};}),byId=new Map(regions.map(r=>[r.id,r]));
 // Region boundaries are not cloud walls. A fixed 50 pc Gaussian blends only the depth prior.
 const raw=makeRaster(1024,10);for(let y=0;y<raw.n;y++)for(let x=0;x<raw.n;x++){const px=((x+.5)/raw.n*2-1)*raw.half,py=((y+.5)/raw.n*2-1)*raw.half,[ra,dec]=skyOf(bodyToIcrs([px,py,at(scene.sources.warp,px,py)])),cell=ogle.sample(ra,dec),r=cell&&byId.get(cell.id),i=y*raw.n+x;if(r){raw.values[i]=r.height;raw.mask[i]=1;}}
 const height=smooth(raw,.05/(20/raw.n)),column=scene.dustLayer.column,clouds:VolumeObject[]=[];height.mask.fill(1);
 for(let y=0;y<image.height;y++)for(let x=0;x<image.width;x++){const id=y*image.width+x,log=image.values[id];if(!Number.isFinite(log))continue;const [ra,dec]=wcs.skyOf(x,y),flat=locate(ra,dec),mean=at(height,flat[0],flat[1]),av=sigmaToAv(10**log)*factor,a=unit(...wcs.skyOf(x+.5,y)),b=unit(...wcs.skyOf(x-.5,y)),c=unit(...wcs.skyOf(x,y+.5)),d=unit(...wcs.skyOf(x,y-.5)),area=Math.hypot(...cross(add(a,mul(b,-1)),add(c,mul(d,-1)))),z=normalize(rayInBody(unit(ra,dec)).direction),q=normalize(rayInBody(unit(...wcs.skyOf(x+1,y))).direction),u=normalize(add(q,mul(z,-dot(q,z)))),v=cross(z,u);
  for(const [k,node]of DEPTH_NODES.entries()){const center=locate(ra,dec,mean+node.z*DUST_SIGMA,DUST_SIGMA),width=Math.hypot(...bodyToIcrs(center))*Math.sqrt(area);clouds.push(volumeObject({id:'OGLE-HERITAGE-'+id+'-'+k,owner:'OGLE-HERITAGE',kind:'dust-tent',component:0,center,basis:[u,v,z],axes:[width,width,width],inner:0,color:[1,1,1],weight:av/MAG_PER_TAU*width*width*node.weight,source:'HERITAGE native column; one Bell normalization; OGLE regional stellar reddening; fixed Gaussian depth quadrature with 250 pc sigma. Compact sky and depth kernels have equal FWHM.'}));}
 }
 // Store registered native samples as checks, never as rendering primitives.
 const controls=regions.map(r=>{const p=locate(r.ra,r.dec);return{id:r.id,bodyXY:[p[0],p[1]],boxArcmin:r.box,frontFraction:r.fraction,rawFraction:r.rawFraction,heightKpc:r.height,totalAv:r.totalAv,frontAv:r.frontAv,clipped:r.clipped,nativeSamples:r.nativeSamples};});
 const metadata={version:25,parent:24,stellarBase:21,n:column.n,halfKpc:column.half,finiteClouds:true,retainMolecular:false,layerSigmaKpc:DUST_SIGMA,clouds:clouds.length,depthQuadrature:DEPTH_NODES,heightN:height.n,heightHalfKpc:height.half,strengthBounds:[.8,1.2],input:HERITAGE_INPUT,source:summary,normalization,ogle:ogle.inputs,regions:controls.length,nativeOverlap:{total:native,matched},clippedRegions:regions.filter(r=>r.clipped).length,aboveTotalRegions:regions.filter(r=>r.rawFraction>1).length,foregroundFraction:{definition:'max(0,3.41*(OGLE E(V-I)/1.318 - 0.06)) divided by the area-weighted HERITAGE A_V in each full published adaptive square. Fractions are restricted to 0.02–0.98 to keep finite depths. Conflicting columns and zero internal reddening remain explicitly counted.',eviConversionSource:'https://arxiv.org/html/2006.02448',foregroundSource:'https://doi.org/10.1093/mnras/stac072',width:'Full published square apertures, using all measured HERITAGE samples within each box. Missing dust samples stay unknown. For depth assignment, overlapping cells are resolved by the smallest containing cell, then closest centre. Native HERITAGE brightness is never divided by an OGLE cell median.'},geometry:{method:'Five fixed positive quadrature samples represent a Gaussian dust depth distribution of sigma 250 pc around a regional mean on the warped plane. The mean solves the dust-weighted probability that a Gaussian 367 pc old-bar tracer lies behind it. Positive height is nearer Earth. A fixed 50 pc Gaussian smooths regional mean transitions. Every patch keeps its measured sky position and compact depth equal to its transverse width. No random clump displacement is used.',assumed:'The red-clump median is treated as an effective mean foreground column for the old light. The vertical distribution and shared depths of neighbouring patches are priors, not cloud tomography. The five quadrature surfaces correlate the unmeasured far-side morphology with the observed foreground; they are a finite approximation, not five measured physical sheets. All cameras integrate the same finite 3D objects.',limitations:'The 250 pc width is represented by five weighted depths. This preserves the source column and avoids normal-direction smoothing of measured narrow filaments, at the cost of unresolved depth-correlation ambiguity. Fraction saturation exposes disagreement or optical selection bias. The same geometry is used for all stellar populations, although red clump stars constrain old light best.'},randomDustDepths:false,molecularExtraOpacity:false,seconds:(performance.now()-started)/1000};
 scene.dustLayer={column,strength:1,retainMolecular:false,clouds};await writeFile(L25+'dust-column.f32le',Buffer.from(column.values.buffer));await writeFile(L25+'dust-height.f32le',Buffer.from(height.values.buffer));await writeFile(L25+'dust-clouds.json',JSON.stringify(clouds)+'\n');await writeFile(L25+'dust-column.json',JSON.stringify(metadata,null,2)+'\n');await writeFile(L25+'regions.json',JSON.stringify(controls,null,2)+'\n');console.log(JSON.stringify({sentinel:'L25_REGIONAL_DUST_READY',regions:regions.length,matched,clipped:metadata.clippedRegions,seconds:metadata.seconds}));return metadata;
}
