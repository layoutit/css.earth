const dir=versionDir(33),cal=rec(await json(dir+'calibration.json')),old=num(cal.previousFraction),current=num(cal.youngResolvedFraction),a=await readContrastBasis('earth',versionDir(32)),b=await readContrastBasis('pins',dir),end=(f:number)=>({...a,planes:a.planes.map((p,k)=>k===3?Float64Array.from(p,(v,i)=>v+(b.planes[k][i]-v)*(f-old)/(current-old)):p)}),o=await loadObservation(8),fit=fitGrain(end(0),end(1),readGrade(cal.grade),await pngRgb(versionDir(32)+'horalek.png'),await pngRgb(versionDir(32)+'earth.png'),o.metadata.sky.rgbLinearDisplay,old),feasible=fit.curve.filter(v=>v.pins.every(p=>p.error<=p.previousError+1e-8));await writeFile(dir+'grain-audit.json',JSON.stringify({method:'Exact linear recombination of unchanged old/star/gas projections and two resolved-share projections. Fractions 0 to 0.60 in 0.01 steps.',baselineReplay:fit.baseline,feasibleNonregressingFractions:feasible,curve:fit.curve},null,2)+'\n');console.log(JSON.stringify({sentinel:'YOUNG_SHARE_AUDITED',feasible:feasible.map(v=>v.fraction),best:fit.best.fraction}));
