/** Resolved young Gaia stars replace part of the unresolved budget; their own colors stay fixed. */
import {mkdir,writeFile,copyFile} from 'node:fs/promises';import {pathToFileURL} from 'node:url';
import {need,ROOT,num} from '../inputs.mts';import {loadParent,parentRung,versionDir,saveConfiguration,type Configuration} from '../sequence-state.mts';import type {CatalogueScene} from '../catalogue-scene.mts';import type {Basis} from '../render.mts';import {earthCamera} from '../render.mts';import {projectCatalogue,catalogueBasis} from '../catalogue-render.mts';import {writeContrastBasis} from '../contrast-cache.mts';import {loadObservation} from '../observation.mts';import {readGrade,gradedPrediction,type Grade} from '../grade.mts';import {encodeDisplay} from '../bar-ratios.mts';import {pinsFor,maskPins,pngRgb,measure,colorError,pinScore} from '../owner-rounds/pins.mts';import {blueSamples,measureBlue} from './color.mts';
export const YOUNG_FRACTION_BOUNDS=[0,.6] as const;
export function applyYoungFraction(scene:CatalogueScene,value:unknown){if(value===undefined)return;const fraction=num(value);need(scene.oldPopulation&&fraction>=YOUNG_FRACTION_BOUNDS[0]&&fraction<=YOUNG_FRACTION_BOUNDS[1],'Invalid young resolved-light fraction');scene.oldPopulation.youngFraction=fraction;}
export function interpolateYoung(a:Basis,b:Basis,fraction:number):Basis{need(fraction>=0&&fraction<=1&&a.width===b.width&&a.height===b.height,'Invalid young light interpolation');return{...a,planes:a.planes.map((p,k)=>k===3?Float64Array.from(p,(v,i)=>v*(1-fraction)+b.planes[k][i]*fraction):p)};}
export function grainObjective(rgb:Float64Array,photo:Float64Array,previous:Float64Array){const pins=pinsFor(33),targets=pins.filter(p=>p.theme===33),measurements=targets.map(p=>{const samples=blueSamples(photo,p);return{pin:p,photo:measureBlue(photo,p,samples),previous:measureBlue(previous,p,samples),new:measureBlue(rgb,p,samples)};}),targetScore=measurements.reduce((s,m)=>s+pinScore(m.new,m.photo,33),0);let penalty=0;for(const p of pins){const samples=p.theme===33?blueSamples(photo,p):null,a=samples?measureBlue(rgb,p,samples):measure(rgb,p),b=samples?measureBlue(previous,p,samples):measure(previous,p),c=samples?measureBlue(photo,p,samples):measure(photo,p);penalty+=1000*Math.max(0,colorError(a,c)-colorError(b,c)-.025)**2;}return{targetScore,objective:targetScore+penalty,measurements};}
export function fitGrain(a:Basis,b:Basis,grade:Grade,photo:Float64Array,previous:Float64Array,sky:readonly number[],baselineFraction:number){const mask=maskPins(pinsFor(33)),evaluate=(fraction:number)=>{const prediction=gradedPrediction(interpolateYoung(a,b,fraction),grade,mask),rgb=new Float64Array(prediction.length);for(let p=0;p<mask.length;p++)if(mask[p])for(let c=0;c<3;c++)rgb[p*3+c]=Math.round(255*encodeDisplay(prediction[p*3+c]+sky[c]))/255;return{fraction,...grainObjective(rgb,photo,previous),rgb};};const base=evaluate(baselineFraction);let baselineMaximumError=0;for(let p=0;p<mask.length;p++)if(mask[p])for(let c=0;c<3;c++)baselineMaximumError=Math.max(baselineMaximumError,Math.abs(base.rgb[p*3+c]-previous[p*3+c]));need(baselineMaximumError<=1/255,'Grain calibration does not replay its parent');let best=evaluate(0);const curve=[];for(let i=0;i<=60;i++){const row=evaluate(i/100);curve.push({fraction:row.fraction,objective:row.objective,targetScore:row.targetScore,pins:row.measurements.map(m=>({id:m.pin.id,error:pinScore(m.new,m.photo,33),previousError:pinScore(m.previous,m.photo,33)}))});if(row.objective<best.objective)best=row;}const {rgb,...savedBest}=best;return{best:savedBest,curve,baseline:{fraction:baselineFraction,maximumDisplayError:baselineMaximumError,score:base.targetScore}};}
async function main(){const version=33,parent=32,dir=versionDir(version),{scene,cfg:base}=await loadParent(parent),rung=await parentRung(parent,false,scene),grade=readGrade(rung.result.grade),o=await loadObservation(8),photo=await pngRgb(versionDir(parent)+'horalek.png'),previous=await pngRgb(versionDir(parent)+'earth.png'),mask=maskPins(pinsFor(33));need(scene.oldPopulation,'Missing measured point field');const oldFraction=scene.oldPopulation.youngFraction,projection=projectCatalogue(scene,earthCamera(o.width,o.height,o.rayAt,o.pixelOf),.06,mask);applyYoungFraction(scene,0);const a=catalogueBasis(projection,scene,rung.amplitudes);applyYoungFraction(scene,1/2);const half=catalogueBasis(projection,scene,rung.amplitudes),b={...half,planes:half.planes.map((p,k)=>k===3?Float64Array.from(p,(v,i)=>2*v-a.planes[k][i]):p)};const fit=fitGrain(a,b,grade,photo,previous,o.metadata.sky.rgbLinearDisplay,oldFraction),cfg:Configuration={...base,version,parent,change:'Match blue-population grain with measured Gaia stars and one resolved-light fraction.',details:{ownerAcceptedBase:31,freeParameters:1,grain:'The existing native Gaia young-member points retain their positions, adopted 150 pc heights and individual RP/G/BP flux colors. Only their share of the conserved young luminosity changes.',selection:'Gaia Collaboration, Luri et al. 2021 Young 1 and Young 2; same accepted member bank as l21 and l29.',frozen:'All densities, point coordinates and colors, dust, object amplitudes, and the l32 component and global grades.',maximumCorrectionRounds:3}};await saveConfiguration(cfg,base.densityVersion);await writeContrastBasis('pins',interpolateYoung(a,b,fit.best.fraction),dir);const count=scene.oldPopulation.points.components.reduce((n,c)=>n+Number(c===3),0),calibration={version,parent,freeParameters:1,grade,youngResolvedFraction:fit.best.fraction,previousFraction:oldFraction,bounds:YOUNG_FRACTION_BOUNDS,gaiaYoungPoints:count,photometry:'Individual Gaia RP/G/BP flux-density ratios, with the accepted conditional dust correction. No star colors or positions fitted.',youngPopulationIntrinsicGIntegral:scene.oldPopulation.points.components.reduce((sum,c,i)=>sum+(c===3?scene.oldPopulation!.points.rgb[i*3+1]:0),0),smoothYoungIntrinsicGIntegral:scene.youngDensity!.values.reduce((sum,v)=>sum+v,0)*(2*scene.youngDensity!.half/scene.youngDensity!.n)**2*.15,luminosityUnits:'Arbitrary intrinsic integrated G luminosity, shared by the smooth and resolved young templates. This is not a ceiling on the resolved fraction.',baselineReplay:fit.baseline,objective:fit.best.objective,targetScore:fit.best.targetScore,previousScore:fit.best.measurements.reduce((s,m)=>s+pinScore(m.previous,m.photo,33),0),measurements:fit.best.measurements,curve:fit.curve};await writeFile(dir+'calibration.json',JSON.stringify(calibration,null,2)+'\n');const source=ROOT+'src/objects/lmc-volume/source/preparation/l33/';await mkdir(source,{recursive:true});await copyFile(ROOT+'src/objects/lmc-volume/source/preparation/l32/frame.json',source+'frame.json');await writeFile(source+'field.json',JSON.stringify({version,parent,configuration:cfg},null,2)+'\n');console.log(JSON.stringify({sentinel:'L33_GRAIN_CALIBRATED',points:count,fraction:fit.best.fraction,previousFraction:oldFraction,objective:fit.best.objective,previousScore:calibration.previousScore,targetScore:calibration.targetScore}));}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await main();
