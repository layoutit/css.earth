/** The l36 regression test must fail if calibration stops selecting its seven targets. */
import {readFile,writeFile} from 'node:fs/promises';import {spawnSync} from 'node:child_process';import {fileURLToPath} from 'node:url';import {need} from '../inputs.mts';
const path=fileURLToPath(new URL('./color.mts',import.meta.url)),test=fileURLToPath(new URL('./color.test.mts',import.meta.url)),source=await readFile(path,'utf8'),before='pins=pinsFor(version)';need(source.includes(before),'Missing color removal target');
try{await writeFile(path,source.replace(before,'pins=pinsFor(32)'));const r=spawnSync(process.execPath,['--test','--test-name-pattern=l36',test],{encoding:'utf8',timeout:90000});need(r.status!==0&&r.stdout.includes('not ok'),'Removing l36 target selection did not fail its behavior test');}finally{await writeFile(path,source);}
const defaultPath=fileURLToPath(new URL('./color-step.mts',import.meta.url)),defaults=await readFile(defaultPath,'utf8');need(defaults.includes('(version===36?32:31)'),'Missing default-parent removal target');try{await writeFile(defaultPath,defaults.replace('(version===36?32:31)','31'));const r=spawnSync(process.execPath,['--test','--test-name-pattern=l36 defaults',test],{encoding:'utf8',timeout:15000});need(r.status!==0&&r.stdout.includes('not ok'),'Removing the default parent did not fail its behavior test');}finally{await writeFile(defaultPath,defaults);}
console.log(JSON.stringify({sentinel:'L36_COLOR_REMOVAL_CHECK_PASSED',removed:['Version-specific seven-pin calibration','l32 default parent for l36'],failedAsExpected:true}));
