/** Young-population color calibration samples blue light, excluding mixed white/pink cores. */
import {colorStep} from './color-step.mts';
import {minimizeBox} from './search.mts';import {writeFile,mkdir} from 'node:fs/promises';import {pathToFileURL} from 'node:url';
import {need,type Raster} from '../inputs.mts';import {readGrade,gradedPrediction,appearanceLoss,sourceTarget,type Grade} from '../grade.mts';import type {Basis} from '../render.mts';import {displayRgb,encodeDisplay} from '../bar-ratios.mts';import {targetOf} from '../report.mts';import {loadObservation} from '../observation.mts';import {versionDir,parentRung,loadParent} from '../sequence-state.mts';import {readContrastBasis,writeContrastBasis} from '../contrast-cache.mts';import {pinsFor,maskPins,measure,pngRgb,colorError,saturationOf,pinScore,type Pin,type Measurement} from '../owner-rounds/pins.mts';
export function blueSamples(photo:ArrayLike<number>,pin:Pin){const candidates:{pixel:number;ratio:number}[]=[];for(let y=pin.y-14;y<=pin.y+14;y++)for(let x=pin.x-14;x<=pin.x+14;x++){const i=(y*512+x)*3,r=photo[i],g=photo[i+1],b=photo[i+2];if(g>.04&&b/g>=1.12&&b/r>=1.08)candidates.push({pixel:y*512+x,ratio:b/g});}candidates.sort((a,b)=>b.ratio-a.ratio);const selected=candidates.slice(0,Math.min(240,candidates.length));need(selected.length>=24,'Too few measured blue pixels at '+pin.id);return selected.map(v=>v.pixel);}
export function measureBlue(rgb:ArrayLike<number>,pin:Pin,samples:readonly number[]):Measurement{const m=measure(rgb,pin),mean=[0,0,0];let power=0;for(const p of samples){for(let c=0;c<3;c++)mean[c]+=rgb[p*3+c]/samples.length;let smooth=0;for(let dy=-1;dy<=1;dy++)for(let dx=-1;dx<=1;dx++)smooth+=rgb[(p+dy*512+dx)*3+2]/9;power+=(rgb[p*3+2]-smooth)**2;}return{...m,rgb:mean,rg:mean[0]/mean[1],bg:mean[2]/mean[1],light:mean.reduce((a,b)=>a+b,0)/3,texture:Math.sqrt(power/samples.length)/mean[2]};}
export const COLOR_BOUNDS={red:[.02,2],blue:[.5,6],saturation:[.5,5]};
export function sameRaster(a:Raster,b:Raster){if(a.n!==b.n||a.half!==b.half||a.values.length!==b.values.length)return false;for(let i=0;i<a.values.length;i++)if(a.values[i]!==b.values[i])return false;return true;}
export function fitYoungColor(basis:Basis,initial:Grade,photo:Float64Array,previous:Float64Array,sky:readonly number[],version=32){need(version===32||version===36,'Unknown young color version');const boundsFor=version===36?{red:[.02,2],blue:[.5,8],saturation:[.5,6]}:COLOR_BOUNDS,pins=pinsFor(version),targets=pins.filter(p=>p.theme===version),guards=pins.filter(p=>p.theme!==version),samples=targets.map(p=>blueSamples(photo,p)),mask=maskPins(pins),rgbOf=(g:Grade)=>{const prediction=gradedPrediction(basis,g,mask),out=new Float64Array(prediction.length);for(let p=0;p<mask.length;p++)if(mask[p])for(let c=0;c<3;c++)out[p*3+c]=encodeDisplay(prediction[p*3+c]+sky[c]);return out;},reference=targets.map((p,i)=>measureBlue(photo,p,samples[i]));
 const objective=(g:Grade)=>{const rgb=rgbOf(g);let value=targets.reduce((sum,p,i)=>{const score=pinScore(measureBlue(rgb,p,samples[i]),reference[i],32),prior=pinScore(measureBlue(previous,p,samples[i]),reference[i],32);return sum+score+(version===36?4000*Math.max(0,score-prior)**2:0);},0);for(const p of guards){const old=measure(previous,p),a=measure(rgb,p),b=measure(photo,p),regression=colorError(a,b)-colorError(old,b)-.03;value+=4000*Math.max(0,regression)**2;}return value;};
 let best=readGrade(initial),value=objective(best);const start=readGrade(initial);start.youngColor={tint:[1,1,1],saturation:1};const candidates:Grade[]=[start];for(const saturation of (version===36?[1,2,4,6]:[1,2,4]))for(const red of [.05,.3,1])for(const blue of [1,2,4]){const g=readGrade(start);g.youngColor={tint:[red,1,blue],saturation};candidates.push(g);}for(const g of candidates){const s=objective(g);if(s<value){best=g;value=s;}}
 if(!best.youngColor)best.youngColor={tint:[1,1,1],saturation:1};for(const step of [.3,.15,.06,.02,.005])for(let repeat=0;repeat<3;repeat++){let changed=false;for(const key of ['red','blue','saturation'] as const)for(const sign of [-1,1]){const g=readGrade(best),m=g.youngColor!;if(key==='saturation')m.saturation=Math.max(.5,Math.min(boundsFor.saturation[1],m.saturation+sign*step));else{const c=key==='red'?0:2,b=boundsFor[key];m.tint[c]=Math.max(b[0],Math.min(b[1],m.tint[c]*Math.exp(sign*step)));}const s=objective(g);if(s<value){best=g;value=s;changed=true;}}if(!changed)break;}
 const bounds:readonly(readonly[number,number])[]=[[Math.log(.02),Math.log(2)],[Math.log(.5),Math.log(boundsFor.blue[1])],[Math.log(.5),Math.log(boundsFor.saturation[1])]],from=(x:number[])=>{const g=readGrade(initial);g.youngColor={tint:[Math.exp(x[0]),1,Math.exp(x[1])],saturation:Math.exp(x[2])};return g;},seeds=[best,...candidates.sort((a,b)=>objective(a)-objective(b)).slice(0,5)];for(const seed of seeds){const m=seed.youngColor??{tint:[1,1,1],saturation:1},fit=minimizeBox(x=>objective(from(x)),[Math.log(m.tint[0]),Math.log(m.tint[2]),Math.log(m.saturation)],bounds,120);if(fit.value<value){best=from(fit.x);value=fit.value;}}const output=rgbOf(best),measurements=targets.map((p,i)=>({pin:p,sampleCount:samples[i].length,photo:reference[i],previous:measureBlue(previous,p,samples[i]),new:measureBlue(output,p,samples[i]),photoSaturation:saturationOf(reference[i]),newSaturation:saturationOf(measureBlue(output,p,samples[i]))}));return{grade:best,objective:value,targetScore:measurements.reduce((s,m)=>s+pinScore(m.new,m.photo,32),0),previousScore:measurements.reduce((s,m)=>s+pinScore(m.previous,m.photo,32),0),measurements,output};}
async function main(){const {version,parent}=colorStep(process.argv[2],process.argv[3]);const dir=versionDir(version),{scene}=await loadParent(parent),rung=await parentRung(parent,false,scene),o=await loadObservation(8),basis=await readContrastBasis('earth',versionDir(parent)),photo=await pngRgb(versionDir(parent)+'horalek.png'),previous=await pngRgb(versionDir(parent)+'earth.png'),fit=fitYoungColor(basis,readGrade(rung.result.grade),photo,previous,o.metadata.sky.rgbLinearDisplay,version);fit.grade.score=appearanceLoss(gradedPrediction(basis,fit.grade),sourceTarget(targetOf(o),o.metadata.normalization.commonFactor));await mkdir(dir+'preview/',{recursive:true});await writeContrastBasis('pins',basis,dir);await writeFile(dir+'preview/earth-rgb.f64le',Buffer.from(fit.output.buffer));const {output,...saved}=fit;await writeFile(dir+'calibration.json',JSON.stringify({version,parent,freeParameters:3,bounds:version===36?{red:[.02,2],blue:[.5,8],saturation:[.5,6]}:COLOR_BOUNDS,brightness:'Young linear photopic luminance is preserved at every pixel, before the unchanged global tone curve.',method:'One global R/G tint, B/G tint and component saturation. The bluest 240 eligible pixels in each 29 by 29 sampling area are fixed from the reference; no spatial model data come from the photo. Earlier-pin color guards and per-target non-regression penalties constrain l36.',...saved},null,2)+'\n');console.log(JSON.stringify({sentinel:'YOUNG_COLOR_CALIBRATED',version,parent,previous:fit.previousScore,current:fit.targetScore,material:fit.grade.youngColor}));}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await main();
