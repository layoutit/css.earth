/** Remove each new material guarantee and require its behavioral test to fail. */
import {readFile,writeFile} from 'node:fs/promises';import {spawnSync} from 'node:child_process';import {fileURLToPath} from 'node:url';import {need} from '../inputs.mts';
const sourcePath=fileURLToPath(new URL('../grade.mts',import.meta.url)),tests=fileURLToPath(new URL('./color.test.mts',import.meta.url)),source=await readFile(sourcePath,'utf8'),results=[];for(const [before,after,property] of [['if(grade.youngColor){','if(false){','Young material reaches the canonical renderer.'],['out[0]*original/after,out[1]*original/after,out[2]*original/after','out[0],out[1],out[2]','Color grading preserves photopic brightness.']]){need(source.includes(before),'Removal target missing');try{await writeFile(sourcePath,source.replace(before,after));const r=spawnSync(process.execPath,['--test',tests],{encoding:'utf8',timeout:20000});need(r.status!==0&&r.stdout.includes('not ok'),'Removed guarantee did not fail');results.push({property,failedAsExpected:true});}finally{await writeFile(sourcePath,source);}}console.log(JSON.stringify({sentinel:'APPEARANCE_REMOVAL_CHECKS_PASSED',results}));
