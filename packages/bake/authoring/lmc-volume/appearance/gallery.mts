/** Local PNG comparison of completed version sheets; no new rendering or hosted viewer. */
import {readFile} from 'node:fs/promises';import sharp from 'sharp';import {json,rec,need} from '../inputs.mts';import {versionDir} from '../sequence-state.mts';
const versions=process.argv.slice(2).map(Number);need(versions.length>=2&&versions.length<=5&&versions.every(v=>Number.isSafeInteger(v)&&v>0&&v<=100),'Supply two to five completed versions');const rows=await Promise.all(versions.map(async version=>{const result=rec(await json(versionDir(version)+'result.json')),accepted=rec(result.acceptance);need(typeof accepted.retained==='boolean'&&result.complete===true,'Incomplete version sheet');const input=await readFile(versionDir(version)+'sheet.png'),size=await sharp(input).metadata();need(size.width===1536&&size.height===1668,'Unexpected version sheet dimensions');return{version,input,retained:accepted.retained};})),width=1536*rows.length,title=Buffer.from('<svg xmlns="http://www.w3.org/2000/svg" width="'+width+'" height="1722"><rect width="100%" height="100%" fill="#101216"/><g font-family="Arial" font-size="28" fill="white">'+rows.map((r,i)=>'<text x="'+(i*1536+18)+'" y="36">l'+r.version+' · '+(r.retained?'retained':'rejected diagnostic')+'</text>').join('')+'</g></svg>'),path=versionDir(versions.at(-1)!)+versions.map(v=>'l'+v).join('-')+'.png';await sharp(title).composite(rows.map((r,i)=>({input:r.input,left:i*1536,top:54}))).png().toFile(path);console.log(JSON.stringify({sentinel:'VERSION_GALLERY_WRITTEN',path,versions}));
