const small=process.argv.includes('--small'),scale=Number(process.argv.find(v=>v.startsWith('--foreground='))?.split('=')[1]??1),etas=(process.argv.find(v=>v.startsWith('--etas='))?.split('=')[1]??(small?'2,6,15':'4')).split(',').map(Number);await mkdir(L26+'porous/',{recursive:true});
