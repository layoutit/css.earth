const source=ROOT+'src/objects/lmc-volume/source/preparation/l26/',baseline=rec(await json(L26+'baseline.json')),lanes=rec(await json(L26+'lane-checks.json')),fit=rec(await json(L26+'calibration.json')),selected=rec(fit.selected),result=rec(await json(L26+'result.json')),q=await json(L26+'qualification.json'),colors=rec(await json(L26+'bar-color.json')),photo=rec(lanes.photo),candidate=rec(lanes.l26),barPhoto=rec(colors.photo),barCandidate=rec(colors.l26),barErrors=[num(barCandidate.rg)/num(barPhoto.rg)-1,num(barCandidate.bg)/num(barPhoto.bg)-1],checks=rec(lanes.checks),rungs=array(await json(L26+'rungs.json'));
const acceptance={parent:25,ownerAcceptedParent:true,promoted:false,passed:lanes.passed,checks,tolerances:TOLERANCE,barColorErrorsPercent:barErrors.map(v=>v*100),rmsIsGate:false,laneLocationPassed:false,sideViewsInspected:true,sideViewsCoherent:true,status:'Completed dust-only diagnostic. Lanes are lighter; depth and lane-color tolerances are not all met. The owner-accepted l25 remains the base until review.',visualAssessment:'Black punctures are largely removed, but brown lanes also wash out. Their detected overlap with the photo falls from 0.201 to 0.113 despite exactly preserved source coordinates. The bar remains too neutral and smooth. Face-on, 45 degree and edge-on renders remain coherent.',boundedRounds:['Foreground selection was tried first within complete OGLE-aperture differential-reddening bounds. A tiny apparent pass did not survive native-resolution calibration; the best native trial still dimmed lanes by 15.5 percent. This geometry change is rejected.','A Poisson unresolved-clump optical response was tested with unchanged l25 geometry. The bounded native trials at scales 10 and 30 select 30; the latter reduces mean lane dimming to 8.8 percent but misses the declared color tolerance. No further law, stellar-color or spatial fitting was added.'],impasse:'Dust-only calibration under the frozen stellar light and intrinsic extinction prescription did not meet all lane criteria. The fitted clump scale is at its upper bound and is an unmeasured prior, so this result is not claimed as recovered physical dust geometry.'};
