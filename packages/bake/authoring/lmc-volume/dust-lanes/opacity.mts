/** Poisson unresolved-clump attenuation, with the intrinsic Gordon law unchanged. */
import {need} from '../inputs.mts';import {EXTINCTION_RGB} from '../model.mts';
import {MAG_PER_TAU} from '../dust-native/field.mts';import {denseGate} from './geometry.mts';
import type {CatalogueScene} from '../catalogue-scene.mts';
export function escapeRatio(t:number){need(Number.isFinite(t)&&t>=0,'Invalid clump optical depth');return t===0?1:t<1e-5?1-t/2+t*t/6:-Math.expm1(-t)/t;}
export function nativeCloudColumns(scene:CatalogueScene){const clouds=scene.dustLayer?.clouds;need(clouds&&clouds.length%5===0,'Missing five-depth native field');const tau=new Float64Array(clouds.length);for(let i=0;i<clouds.length;i+=5){let total=0;for(let j=0;j<5;j++)total+=clouds[i+j].weight/clouds[i+j].axes[0]**2;for(let j=0;j<5;j++)tau[i+j]=total;}return tau;}
export function cloudCoefficients(tau:Float64Array,scale:number){need(Number.isFinite(scale)&&scale>=0&&scale<=30,'Clump scale must lie in 0–30');const rgb=new Float32Array(tau.length*3);for(let i=0;i<tau.length;i++){const clump=scale*tau[i]*denseGate(tau[i]*MAG_PER_TAU);for(let c=0;c<3;c++)rgb[i*3+c]=EXTINCTION_RGB[c]*escapeRatio(clump*EXTINCTION_RGB[c]);}return rgb;}
export function applyOpacity(scene:CatalogueScene,tau:Float64Array,scale:number){need(scene.dustLayer,'Missing dust layer');if(scale===0)delete scene.dustLayer.cloudExtinctionRgb;else scene.dustLayer.cloudExtinctionRgb=cloudCoefficients(tau,scale);return{scale,source:'https://doi.org/10.1086/162681',equation:'Mean transmission exp[-N(1-exp(-tau_clump,lambda))], with N=tau_mean,V/tau_clump,V. The intrinsic lambda dependence is Gordon LMC; the emergent attenuation is less opaque and greyer.',assumption:'One global unresolved-clump optical-depth scale, active smoothly above native A_V=0.2–0.5 mag. No random positions are generated. Native mean columns, bulk geometry and dust width are unchanged. This is an ensemble transmission, not a measured clump-size distribution. Scattering back into the beam is omitted.'};}
