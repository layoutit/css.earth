export function gaiaColor(s:Pick<GaiaStar,'g'|'bp'|'rp'>):V3{need(s.bp!==null&&s.rp!==null,'Missing Gaia color');const abG=s.g+.1136,abB=s.bp+.0155,abR=s.rp+.3561;return[10**(-.4*(abR-abG)),1,10**(-.4*(abB-abG))];}
