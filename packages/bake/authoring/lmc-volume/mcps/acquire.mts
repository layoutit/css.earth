/** Restore the exact published MCPS release and the two empirical HST comparison fields. */
import {mkdir,stat,rename,writeFile} from 'node:fs/promises';import {createWriteStream} from 'node:fs';import {Readable} from 'node:stream';import {pipeline} from 'node:stream/promises';import {pathToFileURL} from 'node:url';
import {L23,mcpsPilot} from './input.mts';import {need} from '../inputs.mts';
export async function acquireMcps(pilot=false){const directory=L23+'inputs/';await mkdir(directory,{recursive:true});const inputs=[
 {name:'table1.dat.gz',url:'https://cdsarc.cds.unistra.fr/ftp/J/AJ/128/1606/table1.dat.gz',bytes:494324354,product:'MCPS J/AJ/128/1606, 24,107,002 native rows, Zaritsky et al. 2004'},
 ...(['bar','disc'] as const).flatMap(kind=>['ubvri.out','comp'].map(extension=>{const id=kind==='bar'?'lmc_u2o901':'lmc_u2c501',sizes=kind==='bar'?[4797443,58231538]:[1409918,15186959];return{name:`hst-${kind}.${extension}`,url:`http://astronomy.nmsu.edu/holtz/archival/lmc/${id}/phot/${id}.${extension}`,bytes:sizes[extension==='comp'?1:0],product:'Holtzman, Afonso and Dolphin 2006; phot-2.03; '+(extension==='comp'?'artificial-star summary':'transformed Johnson V / Cousins I PSF photometry')};}))];
 const records=[];for(const input of inputs){if(pilot&&input.name==='table1.dat.gz')continue;const target=directory+input.name,existing=await stat(target).catch(()=>null);if(!existing||input.bytes&&existing.size!==input.bytes){const response=await fetch(input.url,{signal:AbortSignal.timeout(300000)});need(response.ok&&response.body,'Published photometry download failed');const body=response.body;await pipeline(Readable.from((async function*(){const reader=body.getReader();try{while(true){const chunk=await reader.read();if(chunk.done)break;yield chunk.value;}}finally{reader.releaseLock();}})()),createWriteStream(target+'.pending'));const size=(await stat(target+'.pending')).size;need(input.bytes?size===input.bytes:size>100000,'Photometry input is incomplete');await rename(target+'.pending',target);}records.push({...input,bytes:(await stat(target)).size,route:'Public provider file; local cache reused only after its size check.',complete:true});}
 if(pilot)await mcpsPilot();await writeFile(directory+'acquisition.json',JSON.stringify({inputs:records,hstTransport:'The author archive is publicly served over HTTP. These files carry no authentication or private information.',time:new Date().toISOString()},null,2)+'\n');console.log('L23_PUBLISHED_PHOTOMETRY_ACQUIRED');return records;}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await acquireMcps(process.argv.includes('--pilot'));
