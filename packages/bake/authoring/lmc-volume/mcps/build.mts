import {loadParent} from '../sequence-state.mts';
const dir=L23+'inputs/',write=(p:string,v:unknown)=>writeFile(p,JSON.stringify(v,null,2)+'\n');
async function* source(pilot:boolean):AsyncGenerator<McpsStar>{if(pilot){for(const name of ['bar','disc'])for(const s of parseMcpsTap(await json(dir+name+'-pilot.rows.json')))yield s;return;}need((await stat(dir+'table1.dat.gz')).size===494324354,'Native MCPS release is incomplete');let count=0;const lines=createInterface({input:createReadStream(dir+'table1.dat.gz').pipe(createGunzip()),crlfDelay:Infinity});for await(const line of lines){if(!line)continue;yield parseMcpsLine(line);count++;}need(count===24107002,'Native MCPS row count differs from the published release');}
const hess=(b:number,v:number,i:number)=>[Math.max(13,Math.min(18,Math.floor(v))),Math.floor((b-v)/.25),Math.floor((v-i)/.3)];
function key(v:number[]){return v.join(',');}
export async function buildMcps(scene:CatalogueScene,pilot=false){
 need(scene.oldPopulation&&scene.dustLayer,'MCPS colors require the frozen l21 populations and dust');
 const started=performance.now(),calibration=await membershipSample(),matches:Record<string,unknown>[]=[],bins=new Map<string,[number,number]>(),colorLocus=Array.from({length:30},()=>[0,0]);let rows=0,usable=0;
 for await(const s of source(pilot)){rows++;const m=bvi(s);if(!m)continue;usable++;const [b,v,i]=m,matched=calibration.match(s);if(!matched)continue;const k=key(hess(b,v,i)),bin=bins.get(k)??[0,0];bin[0]++;bin[1]+=Number(matched.member);bins.set(k,bin);if(matched.member){const index=Math.max(0,Math.min(29,Math.floor((v-i+.5)/.15)));colorLocus[index][0]+=b-v;colorLocus[index][1]++;}matches.push({ra:s.ra,dec:s.dec,b,v,i,bp:matched.star.bp,rp:matched.star.rp,g:matched.star.g,member:matched.member,distance:matched.distance});}
 need(matches.length>(pilot?5:1000),'MCPS/Gaia astrometric check has too few matches');await write(L23+(pilot?'pilot-':'')+'mcps-gaia-matches.json',matches);
 function probability(m:readonly[number,number,number]){const h=hess(...m);let total=0,members=0;for(let a=-1;a<=1;a++)for(let b=-1;b<=1;b++){const s=bins.get(key([h[0],h[1]+a,h[2]+b]));if(s){total+=s[0];members+=s[1];}}if(total<5){for(const [k,s] of bins){const q=k.split(',').map(Number);if(Math.abs(q[1]-h[1])<=1&&Math.abs(q[2]-h[2])<=1){total+=s[0];members+=s[1];}}}return total?members/total:1;}
 const bvOfVi=(vi:number)=>{let total=0,sum=0;for(let k=0;k<colorLocus.length;k++){const d=(k*.15-.425-vi)/.25,w=Math.exp(-.5*d*d)*colorLocus[k][1];total+=w;sum+=w*(colorLocus[k][1]?colorLocus[k][0]/colorLocus[k][1]:0);}need(total>0,'No measured MCPS color locus');return sum/total;};
 const n=256,half=8,grids=Array.from({length:7},()=>makeRaster(n,half)),fluxGrids=grids.slice(0,3).map(g=>g.values),totals=[0,0,0],removed=[0,0,0];let used=0;
 for await(const s of source(pilot)){const m=bvi(s);if(!m)continue;const [,v,i]=m,p=locate(s.ra,s.dec,scene.sources),x=Math.floor((p[0]/half+1)*n/2),y=Math.floor((p[1]/half+1)*n/2);if(x<0||y<0||x>=n||y>=n)continue;const index=y*n+x,weight=probability(m),rgb=addMeasuredFlux(fluxGrids,index,m,weight);used++;for(let c=0;c<3;c++){totals[c]+=rgb[c];removed[c]+=rgb[c]*(1-weight);}grids[3].values[index]++;if(v>=18.5){grids[4].values[index]+=ZERO_JY[2]*flux(v)*weight;grids[5].values[index]+=ZERO_JY[3]*flux(i)*weight;}grids[6].values[index]+=weight;}
