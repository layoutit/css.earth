 for(const g of grids)g.mask.fill(1);const smoothed=grids.map(g=>smooth(g,.15/(2*half/n))),support=smoothed[3];
 const fields:PhotometryMaterial={old:[makeRaster(n,half),makeRaster(n,half)],bar:[makeRaster(n,half),makeRaster(n,half)]},means={old:[0,0,0],bar:[0,0,0]},details=[];
 for(const kind of ['old','bar'] as const){const population=kind==='old'?scene.oldPopulation.disc:scene.oldPopulation.bar,sigma=kind==='old'?.41010570629613075:.36656497062880344,template=kind==='old'?lf.disc:lf.bar,colors=[new Float64Array(n*n),new Float64Array(n*n)],weights=new Float64Array(n*n);let sumWeight=0;
  for(let y=0;y<n;y++)for(let x=0;x<n;x++){const j=y*n+x,bx=((x+.5)/n*2-1)*half,by=((y+.5)/n*2-1)*half;if(support.values[j]<3||grids[3].values[j]<1)continue;const resolved=smoothed.slice(0,3).map(g=>g.values[j]),integrated=addUnresolved(resolved,smoothed[4].values[j],smoothed[5].values[j],template,bvOfVi),tau=at(scene.dustLayer.column,bx,by)*scene.dustLayer.strength,tg=transmission(tau,sigma,1),w=at(population,bx,by);if(w<=0||integrated[1]<=0)continue;for(let c=0;c<2;c++){const channel=c===0?0:2,ratio=integrated[channel]/integrated[1]*tg/transmission(tau,sigma,channel);colors[c][j]=Math.log(ratio);means[kind][c===0?0:2]+=w*ratio;}means[kind][1]+=w;weights[j]=w;sumWeight+=w;if(kind==='bar')details.push({xKpc:bx,yKpc:by,resolvedRgb:resolved,unresolvedRgb:integrated.map((v,c)=>v-resolved[c]),members:smoothed[6].values[j],stars:support.values[j]});}
  need(sumWeight>0,'MCPS colors have no population overlap');means[kind][0]/=sumWeight;means[kind][2]/=sumWeight;means[kind][1]=1;
  for(let c=0;c<2;c++){const g=fields[kind][c];g.mask.fill(1);for(let j=0;j<n*n;j++){// Wide support taper preserves the original global color beyond the MCPS footprint.
    const confidence=Math.min(1,grids[3].values[j]/3)*Math.min(1,support.values[j]/10);g.values[j]=weights[j]>0?confidence*(colors[c][j]-Math.log(means[kind][c===0?0:2])):0;}}
 }
 scene.photometryMaterial=fields;scene.innerDiscColor=[means.old[0],1,means.old[2]];scene.colors[0]=[...scene.innerDiscColor];scene.colors[1]=[means.bar[0],1,means.bar[2]];
 const metadata={version:23,pilot,rows,qualityRows:usable,used,seconds:(performance.now()-started)/1000,regionalSmoothingSigmaPc:150,gridPixelPc:62.5,means,calibration:calibration.summary,matchedStars:matches.length,foregroundFluxFraction:removed.map((x,c)=>x/totals[c]),membershipEstimate:'Gaia random-index astrometry, matched within one arcsecond. Smoothed MCPS color–magnitude cells estimate the foreground fraction; sparse bins borrow the global CMD. Faint V>19 extrapolates the last Gaia-calibrated magnitude bin. This is statistical membership, not individual certainty.',selection:'Common BVI support, 13.5<=V<20, each uncertainty<=0.15 mag. U is retained in the native input but rejected from grading because of published scan offsets and a color-term systematic. Saturated V<13.5 is excluded.',lf,unresolvedEstimate:'HST V/I artificial-star-corrected faint flux is normalized to local MCPS 18.5<=V<20 flux. A geometric tail beyond V=25 (bar) or 26 (disc) is explicitly extrapolated from the last two magnitude bins with a ratio bounded 0.2–0.8. Faint B is estimated from the measured MCPS B−V versus V−I locus. This is a conditional missing-light estimate, not a direct unresolved-light measurement.',depth:'Observed colors are conditionally dereddened with the retained l21 mixed dust/stars geometry, then attenuated by the same canonical renderer. The local plane approximation is used for this color correction.',changes:'Only the smooth old/disc and bar spectral ratios change. l21 density, luminosity budgets, catalogue objects, Gaia point photometry, grain fractions, heights, warp and dust are unchanged. None of l22 is retained.',sources:{mcps:'https://cdsarc.cds.unistra.fr/ftp/J/AJ/128/1606/ReadMe',paper:'https://doi.org/10.1086/423910',hst:'http://astronomy.nmsu.edu/holtz/archival/html/lg.html',hstPaper:'https://doi.org/10.1086/507074',zeroPoints:'https://svo2.cab.inta-csic.es/theory/fps/'} };
 await saveMaterial(L23,fields,metadata);await write(L23+'regional-flux.json',details);console.log(JSON.stringify({sentinel:'L23_MCPS_MATERIAL_READY',...metadata}));return metadata;
}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await buildMcps((await loadParent(21)).scene,process.argv.includes('--pilot'));
