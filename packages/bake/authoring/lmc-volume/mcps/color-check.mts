/** Fixed regional color measurements. The apertures are geometric and catalogue-masked. */
import {barAperture,photoRgb,displayRgb,ratios} from '../bar-ratios.mts';
import {rayPlane} from '../geometry.mts';import type {Observation} from '../report.mts';import type {BarGeometry} from '../bar-geometry.mts';import type {CatalogueRow} from '../catalogue-data.mts';
export function colorRegions(o:Observation,b:BarGeometry,rows:CatalogueRow[]){const aperture=barAperture(o,b,rows),core=new Uint8Array(aperture.mask.length),edges=new Uint8Array(core.length);for(let p=0;p<core.length;p++)if(aperture.mask[p]){const q=rayPlane(o.rayAt(p%o.width+.5,Math.floor(p/o.width)+.5)),x=q[0]-b.center[0],y=q[1]-b.center[1],u=x*Math.cos(b.angle)+y*Math.sin(b.angle),v=-x*Math.sin(b.angle)+y*Math.cos(b.angle),radius=(u/b.sigma)**2+(v/(b.sigma*b.ratio))**2;if(radius<1)core[p]=1;else if(radius<4)edges[p]=1;}return{bar:aperture.mask,core,edges};}
export function regionalRatios(rgb:Float64Array,regions:ReturnType<typeof colorRegions>){return{bar:ratios(rgb,regions.bar),core:ratios(rgb,regions.core),edges:ratios(rgb,regions.edges)};}
export function colorTrendPass(model:{core:{rg:number;bg:number};edges:{rg:number;bg:number}},photo:typeof model){return (['rg','bg'] as const).every(c=>(model.core[c]-model.edges[c])*(photo.core[c]-photo.edges[c])>0);}
export function colorComparison(o:Observation,b:BarGeometry,rows:CatalogueRow[],parent:Float64Array,current:Float64Array){const regions=colorRegions(o,b,rows),photo=regionalRatios(photoRgb(o),regions),before=regionalRatios(displayRgb(parent,o.metadata.sky.rgbLinearDisplay),regions),after=regionalRatios(displayRgb(current,o.metadata.sky.rgbLinearDisplay),regions),error=(model:typeof photo)=>{let e=0;for(const region of ['core','edges'] as const)for(const c of ['rg','bg'] as const)e+=Math.log(model[region][c]/photo[region][c])**2;return Math.sqrt(e/4);};return{photo,l21:before,l23:after,relativeBarTolerance:.02,l21RegionalColorError:error(before),l23RegionalColorError:error(after),variationImproved:error(after)<error(before)};}
