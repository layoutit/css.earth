/** Replay the completed projections and compare measured regional colors without fitting. */
import {writeFile,readFile} from 'node:fs/promises';import {pathToFileURL} from 'node:url';
import {L23} from './input.mts';import {json,rec,num,need,array} from '../inputs.mts';import {loadParent,parentRung} from '../sequence-state.mts';
import {readFamily} from '../projection-cache.mts';import {stellarBasis} from '../stellar-grade.mts';import {readContrastBasis} from '../contrast-cache.mts';import {readGrade,gradedPrediction} from '../grade.mts';
import {loadObservation} from '../observation.mts';import {catalogueRows} from '../catalogue-data.mts';import {colorComparison} from './color-check.mts';import {metrics,targetOf} from '../report.mts';import {normalized} from '../grade-report.mts';
import {locate} from '../catalogue-scene.mts';
export async function qualifyMcps(){const {scene}=await loadParent(21),parent=await parentRung(21,false,scene);need(scene.oldPopulation&&scene.barGeometry,'Missing accepted l21');const o=await loadObservation(8),current=rec(await json(L23+'result.json')),grade=readGrade(current.grade),basis=await readContrastBasis('earth',L23),oldBasis=stellarBasis(await readFamily('earth'),scene.oldPopulation.oldFraction,scene.oldPopulation.youngFraction),prediction=gradedPrediction(basis,grade),old=gradedPrediction(oldBasis,readGrade(parent.result.grade)),colors=colorComparison(o,scene.barGeometry,(await catalogueRows()).rows,old,prediction),replay=metrics(normalized(prediction,o),targetOf(o),o),saved=rec(current.residuals);need(Math.abs(replay.trainRelativeRms-num(saved.trainRelativeRms))<1e-10,'Saved MCPS field does not replay its residual');
 let greenDelta=0,greenScale=0;for(let k=0;k<5;k++)for(let i=1;i<basis.planes[k].length;i+=3){greenDelta=Math.max(greenDelta,Math.abs(basis.planes[k][i]-oldBasis.planes[k][i]));greenScale=Math.max(greenScale,Math.abs(oldBasis.planes[k][i]));}
 const gaia={core:{bp:0,rp:0,n:0},edges:{bp:0,rp:0,n:0}},mcps={core:{resolved:[0,0,0],unresolved:[0,0,0]},edges:{resolved:[0,0,0],unresolved:[0,0,0]}},b=scene.barGeometry;
 const region=(x:number,y:number)=>{const dx=x-b.center[0],dy=y-b.center[1],u=dx*Math.cos(b.angle)+dy*Math.sin(b.angle),v=-dx*Math.sin(b.angle)+dy*Math.cos(b.angle),r=(u/b.sigma)**2+(v/(b.sigma*b.ratio))**2;return r<1?'core':r<4?'edges':null;};
 for(const value of array(await json(L23+'mcps-gaia-matches.json'))){const r=rec(value);if(r.member!==true||r.bp===null||r.rp===null)continue;const p=locate(num(r.ra),num(r.dec),scene.sources),key=region(p[0],p[1]);if(key){gaia[key].n++;gaia[key].bp+=10**(-.4*(num(r.bp)-20));gaia[key].rp+=10**(-.4*(num(r.rp)-20));}}
 for(const value of array(await json(L23+'regional-flux.json'))){const r=rec(value),key=region(num(r.xKpc),num(r.yKpc));if(key)for(let c=0;c<3;c++){mcps[key].resolved[c]+=num(array(r.resolvedRgb)[c]);mcps[key].unresolved[c]+=num(array(r.unresolvedRgb)[c]);}}
 const check=(key:'core'|'edges')=>{const g=gaia[key],m=mcps[key],sum=m.resolved.map((v,c)=>v+m.unresolved[c]);return{gaiaMembers:g.n,gaiaIntegratedBpMinusRp:-2.5*Math.log10(g.bp/g.rp),mcpsResolvedBMinusV:-2.5*Math.log10(m.resolved[2]/4323.91/(m.resolved[1]/3617.5)),mcpsWithEstimatedUnresolvedBMinusV:-2.5*Math.log10(sum[2]/4323.91/(sum[1]/3617.5)),estimatedUnresolvedFractionV:m.unresolved[1]/sum[1]};};
 const result={nativeReplay:replay,colors,greenLightBeforeGrade:{maximumAbsoluteDifference:greenDelta,maximumRelativeDifference:greenDelta/greenScale,unchanged:greenDelta/greenScale<1e-10},gaiaCheck:{core:check('core'),edges:check('edges'),meaning:'Gaia BP–RP and MCPS B–V are different filters and magnitude selections. They check the direction of the regional color trend, not numerical equality. Gaia is not an independent membership check because its astrometry supplies the foreground estimate.'},input:rec(await json(L23+'mcps-material.json')),acceptance:{barColorPassed:Math.abs(colors.l23.bar.rg/colors.photo.bar.rg-1)<=.02&&Math.abs(colors.l23.bar.bg/colors.photo.bar.bg-1)<=.02,regionalColorImproved:colors.variationImproved,rmsIsGate:false,sideViews:'Requires inspection of the saved face-on, 45-degree and edge-on images.'}};
 need(result.greenLightBeforeGrade.unchanged,'The color change altered the l21 green-light field');await writeFile(L23+'qualification.json',JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({sentinel:'L23_PROJECTION_QUALIFIED',nativeReplay:replay,colors,green:result.greenLightBeforeGrade,gaia:result.gaiaCheck}));return result;}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await qualifyMcps();
