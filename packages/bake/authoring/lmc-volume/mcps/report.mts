const acceptance={status:'Diagnostic only. l21 remains the owner-accepted base.',acceptedBase:21,promoted:false,barColorPassed:error.every(v=>Math.abs(v)<=.02),barColorErrorPercent:error.map(v=>v*100),coreToEdgeMeanErrorImproved:num(crop.l23RegionalColorError)<num(crop.l21RegionalColorError),coreToEdgeDirectionPassed:trend,outerLightPassed:Math.abs(outer)<=10,sideGeometryCoherent:true,sideColorPassed:false,reason:'The mean color improves, but the B/G core-to-edge trend stays reversed. Old-disc green and blue grades reach their lower bounds, producing reddish outer light. The outskirts are 11.8 percent too bright. The stronger outer-color trial repaired the outskirts but worsened the bar gradient. Three calibration trials are preserved; no further fit ran.'};
