/** MCPS native photometry, with missing bands preserved and a bounded archive pilot. */
import {mkdir,readFile,writeFile} from 'node:fs/promises';import {pathToFileURL} from 'node:url';import {tapRows} from '@cssearth/telescope-core/node';import {LOCAL,need,rec,array} from '../inputs.mts';
export const L23=LOCAL+'versions/l23/',MCPS_SERVICE='https://tapvizier.cds.unistra.fr/TAPVizieR/tap',MCPS_TABLE='"J/AJ/128/1606/lmcps"';
export interface McpsStar {ra:number;dec:number;magnitudes:(number|null)[];errors:(number|null)[];flag:number;}
export function mcpsStar(ra:number,dec:number,magnitudes:(number|null)[],errors:(number|null)[],flag:number):McpsStar{need(Number.isFinite(ra)&&ra>=0&&ra<360&&Number.isFinite(dec)&&Math.abs(dec)<90&&magnitudes.length===4&&errors.length===4&&[0,1,10,11,20,21].includes(flag),'Invalid MCPS row');for(let c=0;c<4;c++){need(magnitudes[c]===null||Number.isFinite(magnitudes[c])&&magnitudes[c]!>0&&magnitudes[c]!<35,'Invalid MCPS magnitude');need(errors[c]===null||Number.isFinite(errors[c])&&errors[c]!>=0&&errors[c]!<10,'Invalid MCPS error');}return{ra,dec,magnitudes,errors,flag};}
export function parseMcpsLine(line:string){need(line.length===73,'Unexpected native MCPS row width');const n=(a:number,b:number)=>{const s=line.slice(a-1,b).trim(),v=Number(s);need(s!==''&&Number.isFinite(v),'Invalid MCPS numeric cell');return v;},magnitudes=[n(20,25),n(33,38),n(46,51),n(59,64)].map(v=>v===0?null:v),errors=[n(27,31),n(40,44),n(53,57),n(66,70)].map((v,i)=>magnitudes[i]===null?null:v);return mcpsStar(n(1,8)*15,n(10,18),magnitudes,errors,n(72,73));}
export function parseMcpsTap(value:unknown){return array(value).map(v=>{const r=rec(v),n=(key:string)=>{const raw=r[key],s=typeof raw==='string'?raw:typeof raw==='number'?String(raw):'';if(s.trim()==='')return null;const x=Number(s);need(Number.isFinite(x),'Invalid TAP photometry');return x;},ra=n('RAJ2000'),dec=n('DEJ2000'),flag=Number(r.Flag),magnitudes=['Umag','Bmag','Vmag','Imag'].map(n).map(v=>v===0?null:v);need(ra!==null&&dec!==null,'Missing MCPS coordinates');return mcpsStar(ra,dec,magnitudes,['e_Umag','e_Bmag','e_Vmag','e_Imag'].map(n).map((v,c)=>magnitudes[c]===null?null:v),flag);});}
export function flux(magnitude:number){need(Number.isFinite(magnitude),'Invalid magnitude');return 10**(-.4*(magnitude-20));}
export async function mcpsPilot(){const directory=L23+'inputs/';await mkdir(directory,{recursive:true});const regions=[{id:'bar',ra:80.27,dec:-69.65},{id:'disc',ra:78,dec:-68}],all=[];for(const region of regions){const query=`SELECT TOP 100001 * FROM ${MCPS_TABLE} WHERE 1=CONTAINS(POINT('ICRS',RAJ2000,DEJ2000),CIRCLE('ICRS',${region.ra},${region.dec},0.08))`,path=directory+region.id+'-pilot.rows.json',cached=await readFile(path,'utf8').then(JSON.parse).catch(()=>null),started=performance.now(),raw=cached??await tapRows(MCPS_SERVICE,query,100002,'async'),stars=parseMcpsTap(raw);need(stars.length>100&&stars.length<100001,'Incomplete MCPS pilot');await writeFile(path,JSON.stringify(raw)+'\n');const counts=[0,0,0,0],sums=[0,0,0,0];for(const s of stars)for(let c=0;c<4;c++){const m=s.magnitudes[c];if(m!==null){counts[c]++;sums[c]+=flux(m);}}const record={...region,query,service:MCPS_SERVICE,rows:stars.length,counts,fluxRelativeToMag20:sums,seconds:(performance.now()-started)/1000,complete:true};await writeFile(directory+region.id+'-pilot.request.json',JSON.stringify(record,null,2)+'\n');all.push(record);console.log(JSON.stringify({sentinel:'L23_MCPS_PILOT_ACQUIRED',...record}));}return all;}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await mcpsPilot();
