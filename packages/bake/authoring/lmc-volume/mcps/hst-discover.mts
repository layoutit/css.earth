/** Locate deep public HST fields for an empirical unresolved-light estimate. */
import {readFile,writeFile} from 'node:fs/promises';import {L23} from './input.mts';import {need} from '../inputs.mts';
interface Field {id:string;ra:number;dec:number;vSeconds:number;iSeconds:number;url:string;}
const source=await readFile(L23+'inputs/hst-lmc.html','utf8'),fields:Field[]=[];
for(const line of source.split('\n')){if(!/^<TR><td><font color=green/iu.test(line))continue;const cells=[...line.matchAll(/<td[^>]*>(.*?)(?=<td|$)/giu)].map(v=>v[1].replace(/<[^>]*>/gu,'').trim());if(cells.length<19)continue;const id=cells[1],ra=cells[2].split(/\s+/u).map(Number),dec=cells[3].split(/\s+/u).map(Number);need(ra.length===3&&dec.length===3,'Unexpected HST coordinates');const a=(ra[0]+ra[1]/60+ra[2]/3600)*15,d=Math.sign(dec[0])*(Math.abs(dec[0])+dec[1]/60+dec[2]/3600),v=Number(cells[12]),i=Number(cells[14]);if(v<2500||i<2500)continue;fields.push({id,ra:a,dec:d,vSeconds:v,iSeconds:i,url:`http://astronomy.nmsu.edu/holtz/archival/lmc/${id}/html/${id}main.html`});}
const distance=(p:typeof fields[number],ra:number,dec:number)=>Math.hypot((p.ra-ra)*Math.cos(dec*Math.PI/180),p.dec-dec),bar=[...fields].sort((a,b)=>distance(a,80.9,-69.78)-distance(b,80.9,-69.78)).slice(0,8),disc=[...fields].sort((a,b)=>distance(a,78.7,-65.25)-distance(b,78.7,-65.25)).slice(0,8);await writeFile(L23+'inputs/hst-candidates.json',JSON.stringify({fields:fields.length,bar,disc},null,2)+'\n');console.log(JSON.stringify({sentinel:'L23_HST_FIELD_CANDIDATES',fields:fields.length,bar,disc}));
