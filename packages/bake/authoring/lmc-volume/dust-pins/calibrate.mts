/** Exact pinned Earth rays, first a tiny pilot, then a bounded two-parameter fit. */
import {mkdir,writeFile} from 'node:fs/promises';import {loadParent,parentRung,versionDir} from '../sequence-state.mts';import {loadObservation} from '../observation.mts';import {earthCamera} from '../render.mts';import {projectCatalogue,catalogueBasis} from '../catalogue-render.mts';import {readGrade,gradedPrediction} from '../grade.mts';import {displayRgb,photoRgb} from '../bar-ratios.mts';import {readContrastBasis} from '../contrast-cache.mts';import {json,rec,need} from '../inputs.mts';
import {L28,annotations,calibrationMask,measure,quantized} from './measure.mts';import {applyDust,compare,BOUNDS,TOLERANCE} from './model.mts';
const pilot=process.argv.includes('--pilot');await annotations();await mkdir(L28+'calibration/',{recursive:true});if(!pilot)need(rec(await json(L28+'pilot.json')).pilotPassed===true,'The exact pin-ray pilot must pass before calibration');
const {scene}=await loadParent(25),parent=await parentRung(25,false,scene),grade=readGrade(parent.result.grade),o=await loadObservation(8),pixels=calibrationMask(),target=measure(quantized(photoRgb(o))).filter(p=>p.calibrated),old=gradedPrediction(await readContrastBasis('earth',versionDir(25)),grade),baseline=compare(measure(quantized(displayRgb(old,o.metadata.sky.rgbLinearDisplay))),target),trials:Record<string,unknown>[]=[],cache=new Map<string,{score:number;strength:number;reddening:number;prediction:Float64Array;detail:unknown}>();
async function evaluate(strength:number,reddening:number){const key=strength.toFixed(6)+','+reddening.toFixed(6),cached=cache.get(key);if(cached)return cached;const started=performance.now(),parameters=applyDust(scene,strength,reddening),prediction=gradedPrediction(catalogueBasis(projectCatalogue(scene,earthCamera(o.width,o.height,o.rayAt,o.pixelOf),.06,pixels),scene,parent.amplitudes),grade);let replay:number|undefined;if(strength===1&&reddening===1){replay=0;for(let i=0;i<prediction.length;i++)if(pixels[Math.floor(i/3)])replay=Math.max(replay,Math.abs(prediction[i]-old[i]));need(replay===0,'The unmodified pins do not exactly replay l25');}const measured=measure(quantized(displayRgb(prediction,o.metadata.sky.rgbLinearDisplay))).filter(p=>p.calibrated),comparison=compare(measured,target),detail={...parameters,measurement:measured,...comparison,parentReplay:replay,seconds:(performance.now()-started)/1000},value={score:comparison.score,strength,reddening,prediction,detail};cache.set(key,value);trials.push(detail);await writeFile(L28+'calibration/'+(pilot?'pilot':'fit')+'-trials.json',JSON.stringify({target,baseline,trials},null,2)+'\n');console.log(JSON.stringify({sentinel:'L28_PIN_TRIAL',pilot,...detail}));return value;}
let best=await evaluate(1,1);
for(const [s,r]of pilot?[[.6,2]]:[[.4,1],[.6,2],[.4,3],[.7,3],[1,2],[1,3]]){const trial=await evaluate(s,r);if(trial.score<best.score)best=trial;}
if(!pilot)for(const [ds,dr]of [[.15,.5],[.06,.2]]){const anchor=best;for(const [s,r]of [[anchor.strength-ds,anchor.reddening],[anchor.strength+ds,anchor.reddening],[anchor.strength,anchor.reddening-dr],[anchor.strength,anchor.reddening+dr]]){const trial=await evaluate(Math.max(.2,Math.min(1,s)),Math.max(.5,Math.min(3,r)));if(trial.score<best.score)best=trial;}}
const result={parent:25,freeParameters:2,bounds:BOUNDS,tolerances:TOLERANCE,target,baseline,trials,selected:best.detail,pilotPassed:best.score<baseline.score,scope:'Only local color and local contrast at H5 and F4. No global lane-dimming, global RMS, G5, or core pixels enter the objective.'};await writeFile(L28+(pilot?'pilot.json':'calibration.json'),JSON.stringify(result,null,2)+'\n');await writeFile(L28+'calibration/'+(pilot?'pilot':'selected')+'-prediction.f64le',Buffer.from(best.prediction.buffer));console.log(JSON.stringify({sentinel:'L28_PIN_CALIBRATION_COMPLETE',pilot,pilotPassed:result.pilotPassed,strength:best.strength,reddening:best.reddening}));
