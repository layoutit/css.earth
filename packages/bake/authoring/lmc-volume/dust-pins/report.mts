/** Save the owner-pin evidence without treating partial color matches as acceptance. */
import {writeFile} from 'node:fs/promises';import {ROOT,json,rec,num,array} from '../inputs.mts';import {L28,PINS,WINDOW,CORE} from './measure.mts';import {TOLERANCE,BOUNDS} from './model.mts';
const write=(p:string,v:unknown)=>writeFile(p,JSON.stringify(v,null,2)+'\n'),source=ROOT+'src/objects/lmc-volume/source/preparation/l28/',cfg=rec(await json(L28+'configuration.json')),fit=rec(await json(L28+'calibration.json')),selected=rec(fit.selected),result=rec(await json(L28+'result.json')),q=rec(await json(L28+'qualification.json')),comparison=rec(q.pinComparison),png=rec(q.pngMeasurements),rungs=array(await json(L28+'rungs.json')),residuals=rec(result.residuals);
const acceptance={acceptedBase:25,promoted:false,numericalPinsPassed:comparison.passed,errors:comparison.errors,tolerances:TOLERANCE,pinFitImproved:num(comparison.score)<num(rec(q.baselineComparison).score),dustStructureExactlyRetained:true,onlyGlobalDustStrengthAndReddening:true,G5Excluded:true,coreExcluded:true,visualPinsInspected:true,barCloseUpInspected:true,sideViewsInspected:true,sideViewsCoherent:true,visualAssessment:'H5 knots retain their shape and are brown rather than nearly black. F4 lanes are warmer and stay visible. G5 is an excluded diagnostic, with its dust retained and lighter. H5 remains cooler and darker than the photo; the central median samples do not meet every declared numerical tolerance.',status:comparison.passed?'Pin numerical targets pass; owner visual review is pending.':'The local fit improves, with visible dust retained, but does not meet every pin tolerance. The result awaits owner review; l25 remains the accepted base.',rmsIsGate:false,reddeningAtUpperBound:num(selected.reddeningGrade)===BOUNDS.reddening[1]};
result.acceptance=acceptance;result.grade={...rec(result.grade),score:residuals.trainRelativeRms};const barTime=num(rec(await json(L28+'bar-timing.json')).seconds);result.viewSeconds=result.viewSeconds??result.seconds;result.barSeconds=barTime;result.seconds=num(result.viewSeconds)+barTime;rungs[rungs.length-1]=result;await write(L28+'acceptance.json',acceptance);await write(L28+'result.json',result);await write(L28+'rungs.json',rungs);
const method={nativeGrid:[512,384],ownerPins:PINS,window:WINDOW,excludedCore:CORE,definition:'Only H5 and F4 central 5 by 5 pixel color medians and local contrast against their 5–7 pixel square annuli enter the fit. G5 and the core ellipse have zero weight. R/G, B/G and median linear-luminance contrast are compared with the corresponding photo pixels.',material:'kappa_lambda = 1 + q (kappa_Gordon,lambda - 1), kappa_G=1; one global strength multiplies optical depth. q is a global RGB dust appearance grade for the processed Horálek photo, not a newly measured extinction law or R_V.',geometry:'All native clouds, diffuse fallback columns, foreground depths and adopted thicknesses are inherited exactly from l25. No clumping, smoothing, spatial optical-depth remapping or pixel transfer is introduced.',optimization:'One bounded global strength and one bounded global selective-reddening grade; finite initial grid and two decreasing coordinate steps. No parameters per pin, pixel or region. Global lane dimming, whole-image RMS, G5 and the core do not enter the objective.'};
const records={recipe:{generator:'packages/bake/authoring/lmc-volume/dust-pins/render.mts',preparation:'packages/bake/authoring/lmc-volume/dust-pins/prepare.mts',configuration:cfg,method,replay:['measure.mts','calibrate.mts --pilot','calibrate.mts','prepare.mts','preview.mts','render.mts --tiny-only','render.mts','crops.mts','qualify.mts','mutations.mts','report.mts'],execution:'Use node --max-old-space-size=8192 for the calibration, field-loader and render processes. This is a source-only reference experiment, not a package-build setting.'},field:{version:28,parent:25,configuration:cfg,method},fit:result,lineage:{parent:'src/objects/lmc-volume/source/preparation/l25/',acceptedParent:true,ownerAnnotations:rec(cfg.details).ownerAnnotations,baselineExtinction:{paper:'Gordon et al. 2003',url:'https://doi.org/10.1086/376774',coefficients:[.75,1,1+1/3.41]},rawDustSources:'HERITAGE native structure and the original Bell normalization, with the exact l25 OGLE ordering. Original acquisition records and citations remain with the parent.',appearanceCalibration:method.material,unchanged:'All Gaia stellar fields and points, catalogue objects, source amplitudes, component RGB coefficients and display curve are retained.'},provenance:{calibration:fit,pilot:await json(L28+'pilot.json'),rungs,qualification:q,acceptance,method,removalChecks:await json(L28+'removal-checks.json'),maximumCorrectionRounds:3,fullResolutionFit:false,slabs:false}};
for(const [name,v]of Object.entries(records))await write(source+name+'.json',v);
function row(pin:string,name:string,values:unknown){const p=array(values).map(rec).find(v=>v.id===pin);if(!p)throw new Error('Missing pin report');const lane=rec(p.lane);return`| ${pin} | ${name} | ${num(lane.rg).toFixed(4)} | ${num(lane.bg).toFixed(4)} | ${(100*num(p.contrast)).toFixed(2)}% |`;}
await writeFile(L28+'notes.md',`l28 starts from l25. Its global strength factor is ${num(selected.strengthFactor).toFixed(2)} and its selective-reddening grade is ${num(selected.reddeningGrade).toFixed(2)}. Every dust shape, position, depth, weight and relative native column is unchanged. The lanes remain visible and are browner in the inspected crops.\n\nCalibration uses 15×15-pixel windows around H5 (331, 229) and F4 (226, 184), on the original 512×384 Earth grid. Color comes from the central 5×5 pixels; nearby bar light comes from the square annulus at radii 5–7 pixels. G5 (280, 214) and the core ellipse with radii 32×24 pixels are excluded. Enlarged crops show 31×31 native pixels at 10× size.\n\n| Pin | Image | R/G | B/G | Local contrast |\n| --- | --- | --- | --- | --- |\n${['H5','F4'].flatMap(pin=>[row(pin,'Horálek',png.photo),row(pin,'l25',png.l25),row(pin,'l28',png.l28)]).join('\n')}\n\nThe goals are ±3% in each local color ratio and ±5 percentage points in local contrast. The fit improves, but H5's B/G remains 5.05% too high; local contrast errors are 5.47 percentage points at H5 and 6.44 at F4. Reddening reaches its declared upper bound. This is an appearance grade along the Gordon optical direction, not a measured change in the physical extinction law.\n\nG5 is shown only as a diagnostic; it never influences calibration. Stellar light and its grades remain fixed. Side views stay coherent. Training and held-out RMS are ${num(residuals.trainRelativeRms).toFixed(6)} and ${num(residuals.heldoutRelativeRms).toFixed(6)}, and are not fitting targets. The version awaits owner review. No full-resolution fit or slab bake ran.\n`);
console.log(JSON.stringify({sentinel:'L28_REPORTED',acceptance,material:selected,residuals}));
