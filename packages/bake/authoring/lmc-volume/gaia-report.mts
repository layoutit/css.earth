/** Saved l13 evidence and comparison; no fitting or new reference rendering. */
import {readFile,writeFile,appendFile} from 'node:fs/promises';
import sharp from 'sharp';
import {LOCAL,json,rec,array,num,need} from './inputs.mts';
import {L13,SELECTION_PAPER} from './gaia-young.mts';
const result=rec(await json(L13+'result.json')),stats=rec(result.residuals),tiny=rec(await json(L13+'tiny/result.json')),selection=rec(await json(L13+'gaia-selection.json')),membership=rec(selection.membership),cov=array(membership.covariance).map(num),control=rec(await json(L13+'outer-control-small.json')),prior=rec(rec(await json(LOCAL+'versions/l12/result.json')).residuals),l10=rec(rec(await json(LOCAL+'versions/l10/result.json')).residuals),smash=rec(await json(L13+'smash-check.json')),preservation=rec(await json(L13+'preservation.json'));
need(preservation.catalogueGeometryMatchesL12===true&&preservation.dustGeometryMatchesL12===true,'Missing l12 preservation evidence');
const selectionText=`# l13 Gaia selection\n\nWe follow [Gaia Collaboration, Luri et al. 2021, A&A 649 A7](${SELECTION_PAPER}), sections 2 and 7. DR3 retains the EDR3 astrometry; its small G corrections are already applied, as described by [ESA](https://www.cosmos.esa.int/web/gaia/dr3).\n\n| Selection | Rule |\n| --- | --- |\n| Field | Within 20 degrees of RA 81.28, declination −69.78 degrees |\n| Upper main sequence | Young 1 plus Young 2: 10 ≤ G < 18; −1 ≤ BP−RP ≤ 0.08G−1.10 |\n| Foreground rejection | Signed parallax divided by its error < 5 |\n| Proper motion | Orthographic, conditional on the sample median parallax; two-dimensional Mahalanobis distance squared < 9.21 |\n| Calibration | Central 5 degrees, G < 19, uniform random_index < 20,000,000 subset |\n\nThe random calibration subset is our computational adaptation; the paper used the full central sample. It contains ${num(membership.calibrationRows).toLocaleString('en-US')} stars before proper-motion clipping and ${num(membership.retainedCalibration).toLocaleString('en-US')} after it. The learned projected-motion centre is ${array(membership.mean).map(v=>num(v).toFixed(5)).join(', ')} mas/year, with marginal dispersions ${Math.sqrt(cov[0]).toFixed(4)}, ${Math.sqrt(cov[2]).toFixed(4)} mas/year. Median raw parallax is ${num(membership.parallaxMedian).toFixed(6)} mas.\n\nThe complete query contains ${num(selection.candidateRows).toLocaleString('en-US')} candidates. Membership retains ${num(selection.selectedStars).toLocaleString('en-US')}: ${num(selection.young1).toLocaleString('en-US')} Young 1 and ${num(selection.young2).toLocaleString('en-US')} Young 2. These are approximate age groups, not individual age measurements.\n\nThe same public DR3 table was acquired through the [ARI mirror](https://gaia.ari.uni-heidelberg.de/tap.html) after ESA's large asynchronous job failed. Query records preserve the exact requests and archive completeness status. A truncated brightest-star cone is never used to make the density map.\n\nSelected stars are placed on the existing warped plane, binned and smoothed at 150 pc, and assigned the unchanged 150 pc Gaussian height. Their parallaxes select membership; they do not set distances. No analytic young-disc continuation or survey-gap filling is added. Gaia's all-sky coverage still has crowding and selection incompleteness. SMASH is only an independent check.\n`;
const placement=rec(rec(await json(L13+'young-density.json')).warpPlacement);
await writeFile(L13+'selection.md',selectionText+`\nThe existing warp has discontinuous support-mask edges. ${num(placement.bracketed)} stars needed bilinear-cell intersection solving; ${num(placement.finiteLayerAnchors)} of these had no exact midplane crossing. For those, the adopted 150 pc Gaussian height prior chooses the most plausible ray position, with a maximum offset of ${(num(placement.maximumFiniteLayerOffsetKpc)*1000).toFixed(1)} pc. These cases are ${(100*num(placement.finiteLayerAnchors)/num(selection.selectedStars)).toFixed(4)}% of the sample. The warp values and all catalogue positions remain unchanged. This is a placement assumption, not a measured stellar depth.\n`);
const outer=(v:unknown)=>num(array(rec(v).annularDifferencePercent)[3]),row=(title:string,key:string,format:(x:number)=>string)=>`| ${title} | ${format(num(l10[key]))} | ${format(num(prior[key]))} | ${format(num(stats[key]))} |`;
await writeFile(L13+'notes.md',`# l13: Gaia diffuse young stars\n\nOnly the diffuse young density changes. The ${num(preservation.objects).toLocaleString('en-US')} l12 primitives, all ${num(preservation.dustClouds)} dust clouds, old disc, bar, warp and adopted widths are preserved. Per-object brightness, component RGB grades and the shared tone curve use the same calibration code.\n\nThe layer uses ${num(selection.selectedStars).toLocaleString('en-US')} Gaia DR3 Young 1 + Young 2 members selected using [Luri et al. 2021](${SELECTION_PAPER}). Selection details and the random-calibration adaptation are in [selection.md](selection.md). There is no SMASH-driven extrapolation in this layer. The inner 4 kpc map correlation with l12's SMASH check is ${num(smash.inner4KpcMapCorrelation).toFixed(3)}; the samples have different magnitude and membership cuts.\n\n| Earth appearance residual | l10 | l12 | l13 |\n| --- | --- | --- | --- |\n${row('RGB RMS, first checkerboard','trainRelativeRms',v=>v.toFixed(6))}\n${row('RGB RMS, second checkerboard','heldoutRelativeRms',v=>v.toFixed(6))}\n${row('Total light difference','totalLightDifferencePercent',v=>v.toFixed(2)+'%')}\n\nBoth checkerboards supplied calibration pixels. These are appearance residuals, not independent validation. Final annular light errors from the centre outward are ${array(stats.annularDifferencePercent).map(v=>num(v).toFixed(2)+'%').join(', ')}.\n\nAt frozen l12 calibration, the outer-annulus error is ${outer(control.l12Reproduced).toFixed(2)}% with the original layer, ${outer(control.withoutDiffuse).toFixed(2)}% with that layer disabled, and ${outer(control.gaiaAtL12Settings).toFixed(2)}% with Gaia substituted. The unchanged-model control reproduces the saved l12 result.\n\nTiny took ${num(tiny.seconds).toFixed(1)} seconds; the 512 px rung took ${num(result.seconds).toFixed(1)} seconds, including its fixed-calibration controls. [Visual inspection](visual-review.md) records the northern arm and side views. Individual depths remain adopted. No full-resolution fit, GPU training, slab bake, commit, publication or external message ran.\n`);
let balance:Record<string,unknown>|undefined;try{balance=rec(await json(L13+'research/balance/global-balance.json'));}catch(error){if(!(error instanceof Error&&'code'in error&&error.code==='ENOENT'))throw error;}
await appendFile(L13+'notes.md',`\nRemaining issues: the outer region is ${Math.abs(outer(stats)).toFixed(2)}% too faint, and the northern arm remains broader and weaker than the photo.\n`);
if(balance){const candidate=rec(balance.candidateResiduals);await appendFile(L13+'notes.md',`\nA six-control global grading check failed at tiny size: its Earth RMS rose to ${num(candidate.trainRelativeRms).toFixed(6)} / ${num(candidate.heldoutRelativeRms).toFixed(6)}, and total light reached ${num(candidate.totalLightDifferencePercent).toFixed(2)}% above the target. It was rejected and was not scaled to 512 px. Its evidence is in research/balance/.\n`);}
await sharp({create:{width:4608,height:1668,channels:3,background:'#101216'}}).composite(await Promise.all([10,12,13].map(async(v,i)=>({input:await readFile(LOCAL+`versions/l${v}/sheet.png`),left:i*1536,top:0})))).png().toFile(L13+'l10-l12-l13-side-by-side.png');
console.log(JSON.stringify({sentinel:'L13_SAVED_EVIDENCE_COMPLETE',selectedStars:selection.selectedStars,outerError:array(stats.annularDifferencePercent)[3]}));
