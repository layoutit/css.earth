/** Record the dust-only evidence and distinguish column preservation from visual acceptance. */
import {writeFile,readFile} from 'node:fs/promises';
import {ROOT,rec,json,num,array,need} from '../inputs.mts';import {L24,HERITAGE_INPUT} from './field.mts';
const write=(p:string,v:unknown)=>writeFile(p,JSON.stringify(v,null,2)+'\n'),source=ROOT+'src/objects/lmc-volume/source/preparation/l24/';
const result=rec(await json(L24+'result.json')),m=rec(result.residuals),color=rec(await json(L24+'bar-color.json')),photo=rec(color.photo),candidate=rec(color.l24),q=rec(await json(L24+'qualification.json')),lanes=rec(q.lanes),pLane=rec(lanes.photo),cLane=rec(lanes.l24),oldLane=rec(lanes.l21),dust=rec(await json(L24+'dust-column.json')),normalization=rec(dust.normalization),strength=num(result.dustStrength),errors=[num(candidate.rg)/num(photo.rg)-1,num(candidate.bg)/num(photo.bg)-1],brownError=(r:Record<string,unknown>)=>Math.abs(num(r.brownColorRatio)-num(pLane.brownColorRatio));
