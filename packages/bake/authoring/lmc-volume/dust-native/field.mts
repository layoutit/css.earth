/** l24: full HERITAGE columns, one galaxy-wide Bell scale, compact 3D dust cells. */
import {mkdir,writeFile} from 'node:fs/promises';
import {LOCAL,at,makeRaster,need,type Raster} from '../inputs.mts';
import {loadHeritage,HERITAGE_FILE} from '../heritage-input.mts';
import {sampleDensity} from '../heritage-layer.mts';
import {gaiaWarpLocator} from '../gaia-plane.mts';
import {normalFromId} from '../native.mts';
import {blur} from '../young-density.mts';
import {smoothstep} from '../model.mts';
import {bodyToIcrs,skyOf,rayInBody,unit,normalize,add,mul,dot,cross,DEG,DISTANCE,INCLINATION,type V3} from '../geometry.mts';
import {volumeObject,type VolumeObject} from '../catalogue-volume.mts';
import type {CatalogueScene} from '../catalogue-scene.mts';
export const L24=LOCAL+'versions/l24/',AV_PER_SIGMA=7.394,MAG_PER_TAU=2.5/Math.log(10);
export const HERITAGE_INPUT={path:'src/objects/lmc-volume/.local/versions/l19/inputs/'+HERITAGE_FILE,product:'Gordon 2014 HERITAGE BEMBB expectation, unconstrained beta, 19 April 2014 author release',url:'https://www.stsci.edu/~kgordon/heritage/heritage_lmc_rebin_dust_fit_maps_bembb_19apr14.tar.gz',paper:'https://doi.org/10.1088/0004-637X/797/2/85',release:'https://karllark.github.io/data_magclouds_dustmaps.html',erratum:'https://doi.org/10.3847/1538-4357/aa6042',erratumEffect:'The 2017 erratum corrects quoted emissivities by pi and states that the released surface-density maps and conclusions are unaffected. The released map is used directly; no emissivity refit is done.'};
export function sigmaToAv(sigma:number){need(Number.isFinite(sigma)&&sigma>=0,'Invalid dust surface density');return AV_PER_SIGMA*sigma;}
export function oneGlobalScale(model:readonly number[],measured:readonly number[],area:readonly number[]){need(model.length===measured.length&&model.length===area.length&&model.length>0,'Invalid broad dust calibration');let a=0,b=0;for(let i=0;i<model.length;i++){need(model[i]>0&&measured[i]>=0&&area[i]>0&&[model[i],measured[i],area[i]].every(Number.isFinite),'Invalid column calibration sample');a+=measured[i]*area[i];b+=model[i]*area[i];}need(a>0&&b>0,'No positive Bell overlap');return{factor:a/b,area:area.reduce((a,b)=>a+b,0),measuredIntegral:a,beforeIntegral:b,afterIntegral:a,samples:model.length};}
function supported(map:Raster,x:number,y:number){const i=Math.floor((x/map.half+1)*map.n/2-.5),j=Math.floor((y/map.half+1)*map.n/2-.5);return i>=0&&j>=0&&i+1<map.n&&j+1<map.n&&[j*map.n+i,j*map.n+i+1,(j+1)*map.n+i,(j+1)*map.n+i+1].every(k=>map.mask[k]);}
export function laneOffset(x:number,y:number,av:number,scene:Pick<CatalogueScene,'barGeometry'>){const b=scene.barGeometry;need(b,'Missing published bar footprint');const dx=x-b.center[0],dy=y-b.center[1],u=dx*Math.cos(b.angle)+dy*Math.sin(b.angle),v=-dx*Math.sin(b.angle)+dy*Math.cos(b.angle),r=Math.hypot(u/b.sigma,v/(b.sigma*b.ratio)),inside=1-smoothstep((r-1.5)/1);return .3*inside*smoothstep((av-.05)/.15);}
export function correlatedHeights(){const map=makeRaster(512,10),cell=20/512,raw=Float64Array.from(map.values,(_,i)=>normalFromId('l24-correlated-depth:'+i)),values=blur(raw,512,512,.1/cell);let variance=0;for(const v of values)variance+=v*v;const rms=Math.sqrt(variance/values.length);map.mask.fill(1);for(let i=0;i<values.length;i++)map.values[i]=.25*values[i]/rms;return map;}
function pixelBasis(ra:number,dec:number,nextRa:number,nextDec:number):[V3,V3,V3]{const z=normalize(rayInBody(unit(ra,dec)).direction),q=normalize(rayInBody(unit(nextRa,nextDec)).direction),x=normalize(add(q,mul(z,-dot(q,z)))),y=cross(z,x);return[x,y,z];}
export async function buildNativeDust(scene:CatalogueScene){
 need(scene.dustLayer&&scene.barGeometry,'l24 requires the accepted l21 field');await mkdir(L24,{recursive:true});
 const started=performance.now(),{image,wcs,summary}=await loadHeritage(),locate=gaiaWarpLocator(scene.sources),bell=scene.sources.dust,cos=Math.cos(INCLINATION),raw:number[]=[],measured:number[]=[],areas:number[]=[];
 const pixels:{id:number;ra:number;dec:number;sigma:number;flat:V3;area:number}[]=[];
 for(let y=0;y<image.height;y++)for(let x=0;x<image.width;x++){
  const id=y*image.width+x,log=image.values[id];if(!Number.isFinite(log))continue;
  const [ra,dec]=wcs.skyOf(x,y),flat=locate(ra,dec),a=unit(...wcs.skyOf(x+.5,y)),b=unit(...wcs.skyOf(x-.5,y)),c=unit(...wcs.skyOf(x,y+.5)),d=unit(...wcs.skyOf(x,y-.5)),area=Math.hypot(...cross(add(a,mul(b,-1)),add(c,mul(d,-1)))),sigma=10**log;
  pixels.push({id,ra,dec,sigma,flat,area});if(supported(bell,flat[0],flat[1])){raw.push(sigmaToAv(sigma)/MAG_PER_TAU);measured.push(at(bell,flat[0],flat[1])/cos);areas.push(area);}
 }
 need(pixels.length===86690&&raw.length>10000,'Unexpected HERITAGE release or missing Bell footprint');const normalization=oneGlobalScale(raw,measured,areas),clouds:VolumeObject[]=[],avs:number[]=[],laneAvs:number[]=[],heights=correlatedHeights();let foreground=0;
 for(const p of pixels){const x=p.id%image.width,y=Math.floor(p.id/image.width),av=sigmaToAv(p.sigma)*normalization.factor,offset=laneOffset(p.flat[0],p.flat[1],av,scene),height=at(heights,p.flat[0],p.flat[1])+offset,center=locate(p.ra,p.dec,height,.25),distance=Math.hypot(...bodyToIcrs(center)),angular=Math.sqrt(p.area),width=distance*angular,basis=pixelBasis(p.ra,p.dec,...wcs.skyOf(x+1,y));
  // A compact separable tent reproduces linear interpolation at the released pixel centres.
  // Sky and line-of-sight FWHM are equal. There is no depth column or camera-facing screen.
  clouds.push(volumeObject({id:'HERITAGE-native-'+p.id,owner:'HERITAGE-native',kind:'dust-tent',component:0,center,basis,axes:[width,width,width],inner:0,color:[1,1,1],weight:av/MAG_PER_TAU*width*width,source:'Gordon2014 BEMBB expectation; Bell2022 equation 1 conversion and one global normalization; adopted compact depth'}));avs.push(av);if(offset>.15){foreground++;laneAvs.push(av);}
 }
 const parent=scene.dustLayer.column,diffuse=makeRaster(2048,10);diffuse.mask.fill(1);let missing=0;
 for(let y=0;y<diffuse.n;y++)for(let x=0;x<diffuse.n;x++){const i=y*diffuse.n+x,px=((x+.5)/diffuse.n*2-1)*diffuse.half,py=((y+.5)/diffuse.n*2-1)*diffuse.half,[ra,dec]=skyOf(bodyToIcrs([px,py,at(scene.sources.warp,px,py)])),p=wcs.pixelOf(ra,dec),coverage=p?sampleDensity(image.values,image.width,image.height,p[0],p[1]).coverage:0;diffuse.values[i]=at(parent,px,py)*(1-coverage);if(coverage<.999)missing++;}
 avs.sort((a,b)=>a-b);laneAvs.sort((a,b)=>a-b);const quantile=(a:number[],p:number)=>a[Math.floor((a.length-1)*p)]??0;
 const metadata={version:24,parent:21,input:HERITAGE_INPUT,n:diffuse.n,halfKpc:diffuse.half,finiteClouds:true,retainMolecular:false,source:summary,clouds:clouds.length,nativePixelArcsec:summary.pixelArcsec,nominalNativePixelPc:DISTANCE*1000*summary.pixelArcsec/3600*DEG,conversion:{avMagPerSolarMassPerPc2:AV_PER_SIGMA,source:'https://doi.org/10.1093/mnras/stac1545',equation:'Bell et al. 2022 equation 1: A_V=0.7394 [Sigma_d/(10^5 solar masses per square kiloparsec)] mag, following Draine et al. 2014. This equals 7.394 Sigma_d for solar masses per square parsec.',status:'A model-dependent optical conversion, then reconciled with Bell using one common scale. No native pixel has its own scale.'},normalization,columns:{minimumAv:avs[0],medianAv:quantile(avs,.5),p90Av:quantile(avs,.9),p99Av:quantile(avs,.99),maximumAv:avs.at(-1),pixelsAvAtLeastOne:avs.filter(a=>a>=1).length,foregroundCells:foreground,foregroundMedianAv:quantile(laneAvs,.5)},layerSigmaKpc:.25,strengthBounds:[.25,2],foreground:{maximumNormalOffsetKpc:.3,depthCorrelationSigmaPc:100,positiveZ:'The disc normal has a positive dot product with the Earth-facing direction, so positive height is nearer the observer.',footprint:'The published bar ellipse, with a smooth taper from 1.5 to 2.5 major-axis sigma.',columnSelection:'Foreground offset rises smoothly from A_V=0.05 to 0.2 mag; lower-column dust remains centred on the warped plane.',assumption:'The 300 pc near-side offset is adopted to put dense lanes before the thick 367 pc bar. It is not an individual cloud distance measurement. The unchanged 250 pc Gaussian is the dispersion of cloud centres. Heights are spatially correlated with an adopted 100 pc Gaussian scale so adjacent cells do not receive unrelated depths; each cloud has a finite depth equal to its native transverse FWHM.'},interpolation:'Compact positive 3D separable tents. Native-pixel weights are direct HERITAGE columns times projected cell area; their projected footprints implement linear interpolation. No five-arcminute high-pass division or local Bell rescaling is used.',missingHeritage:'Only missing HERITAGE support retains the full l21 diffuse column. No extra molecular attenuation is added.',missingCells:missing,seconds:(performance.now()-started)/1000,limits:'HERITAGE measures modelled projected dust surface density. Three-dimensional depths, compact kernel shape and foreground placement remain adopted priors. Optical scattering into the sightline is not modelled.'};
 scene.dustLayer={column:diffuse,strength:1.025,retainMolecular:false,clouds};await writeFile(L24+'dust-column.f32le',Buffer.from(diffuse.values.buffer));await writeFile(L24+'dust-clouds.json',JSON.stringify(clouds)+'\n');await writeFile(L24+'dust-column.json',JSON.stringify(metadata,null,2)+'\n');console.log(JSON.stringify({sentinel:'L24_NATIVE_DUST_READY',...metadata}));return metadata;
}
