for(const tiny of process.argv.includes('--small-only')?[false]:[true,false]){
 const started=performance.now(),size=tiny?64:512,step=tiny?.12:.06,out=L24+(tiny?'tiny/':'');await mkdir(out,{recursive:true});
 // The accepted l21 parameters are its final small result. Its historical tiny fit predates acceptance.
 const parent=await parentRung(21,false,scene),o=await loadObservation(tiny?1:8),grade=readGrade(parent.result.grade);grade.dustStrength=strength;
 console.log(JSON.stringify({sentinel:'L24_RUNG_STARTED',tiny,strength}));const projection=projectCatalogue(scene,earthCamera(o.width,o.height,o.rayAt,o.pixelOf),step),basis=catalogueBasis(projection,scene,parent.amplitudes),prediction=gradedPrediction(basis,grade),residuals=metrics(normalized(prediction,o),targetOf(o),o),aperture=barAperture(o,scene.barGeometry,rows),photo=ratios(photoRgb(o),aperture.mask),candidate=ratios(displayRgb(prediction,o.metadata.sky.rgbLinearDisplay),aperture.mask);
 await writeContrastBasis(tiny?'tiny-earth':'earth',basis,L24);console.log(JSON.stringify({sentinel:'L24_EARTH_READY',tiny,strength,residuals,photo,candidate,colorPassed:colorPass(candidate,photo),projection:projection.metadata}));
