const write=(p:string,v:unknown)=>writeFile(p,JSON.stringify(v,null,2)+'\n'),strength=Number(process.argv.find(a=>a.startsWith('--strength='))?.split('=')[1]??1.025);
need(strength>=.25&&strength<=2,'Dust strength must stay between 0.25 and 2');const {scene,cfg}=await loadParent(24);need(scene.dustLayer&&scene.barGeometry&&scene.oldPopulation,'Missing prepared l24 dust');scene.dustLayer.strength=strength;
const {rows}=await catalogueRows(),runs=[],frozen=JSON.stringify([scene.colors,scene.innerDiscColor,scene.barGeometry,scene.objects,scene.owners]);
