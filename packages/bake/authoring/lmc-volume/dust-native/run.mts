 await saveGradedSheet(out,24,o,prediction,views,grade,'Dust only; full native HERITAGE columns and finite foreground lanes.','native-column dust · frozen l21 light');
 if(!tiny)await finishSheet(out,24,['Accepted parent: l21.','Only dust changes in l24.','Full HERITAGE BEMBB columns.','Native 56 arcsecond samples.','One Bell scale for the entire map.','No local column normalization.','Dense cells retain A_V above 1 mag.','Compact dust depths equal sky widths.','Centre-height dispersion: 250 pc.','Dense bar dust adopts near-side depth.','All stellar grades remain at l21.','RMS is reported, never a gate.']);
 const result={version:24,parent:21,rung:tiny?'tiny':'small',size,rayStepKpc:step,seconds:(performance.now()-started)/1000,dustStrength:strength,grade,residuals,sceneControls:sceneControls(scene),photo,candidate,colorPassed:colorPass(candidate,photo),rmsIsGate:false};
 await write(out+'result.json',result);await write(out+'object-brightness.json',scene.owners.map((v,i)=>({...v,amplitude:parent.amplitudes[i]})));runs.push(result);await write(L24+'rungs.json',runs);cfg.dustStrength=strength;await write(L24+'configuration.json',cfg);
 need(JSON.stringify([scene.colors,scene.innerDiscColor,scene.barGeometry,scene.objects,scene.owners])===frozen,'The dust step changed emission or geometry');console.log(JSON.stringify({sentinel:'L24_RUNG_COMPLETE',tiny,...result}));
 const window=barWindow(o,scene.barGeometry,rows),crop=await loadObservation(tiny?2:8,window,{sky:o.metadata.sky.rgbLinearDisplay,commonFactor:o.metadata.normalization.commonFactor}),barBasis=catalogueBasis(projectCatalogue(scene,earthCamera(crop.width,crop.height,crop.rayAt,crop.pixelOf),.03),scene,parent.amplitudes),bar=gradedPrediction(barBasis,grade);
 await writeContrastBasis(tiny?'tiny-bar':'bar',barBasis,L24);await writeFile(out+'bar-prediction.f64le',Buffer.from(bar.buffer));await sharp(imageBytes(normalized(bar,crop),crop,true),{raw:{width:crop.width,height:crop.height,channels:3}}).png().toFile(out+'bar-l24.png');console.log(JSON.stringify({sentinel:'L24_BAR_READY',tiny,width:crop.width,height:crop.height}));
 if(!tiny){const old=await readFile(versionDir(21)+'bar-prediction.f64le');need(old.length===bar.byteLength,'The accepted bar crop changed dimensions');const before=new Float64Array(Uint8Array.from(old).buffer),color={photo:ratios(photoRgb(crop),barAperture(crop,scene.barGeometry,rows).mask),l21:ratios(displayRgb(before,crop.metadata.sky.rgbLinearDisplay),barAperture(crop,scene.barGeometry,rows).mask),l24:ratios(displayRgb(bar,crop.metadata.sky.rgbLinearDisplay),barAperture(crop,scene.barGeometry,rows).mask)},rawTexture=compareTexture(crop,scene.barGeometry,rows,before,bar);const {l18:l21,l19:l24,...rest}=rawTexture,texture={...rest,l21,l24};await write(L24+'bar-color.json',color);await write(L24+'bar-contrast.json',texture);
  const labels=Buffer.from('<svg xmlns="http://www.w3.org/2000/svg" width="1536" height="424"><rect width="100%" height="100%" fill="#101216"/><g fill="white" font-family="Arial" font-size="21"><text x="12" y="27">Horálek · bar</text><text x="524" y="27">l21 · accepted base</text><text x="1036" y="27">l24 · native foreground dust</text></g></svg>');await sharp(labels).composite(await Promise.all([versionDir(20)+'bar-photo.png',versionDir(21)+'bar-l21.png',L24+'bar-l24.png'].map(async(p,i)=>({input:await readFile(p),left:i*512,top:40})))).png().toFile(L24+'bar-close-up.png');
 }
 if(process.argv.includes('--tiny-only'))break;if(tiny)need(result.colorPassed||process.argv.includes('--diagnostic'),'The tiny bar color gate failed. Change only bounded dust controls before proceeding.');
}
if(runs.some(r=>rec(r).rung==='small')){const source=ROOT+'src/objects/lmc-volume/source/preparation/l24/',parent=ROOT+'src/objects/lmc-volume/source/preparation/l21/';await mkdir(source,{recursive:true});await copyFile(parent+'frame.json',source+'frame.json');await write(source+'recipe.json',{generator:'packages/bake/authoring/lmc-volume/dust-native/run.mts',preparation:'packages/bake/authoring/lmc-volume/dust-native/prepare.mts',configuration:cfg});await write(source+'fit.json',runs.at(-1));await write(source+'field.json',{...scene.metadata,configuration:cfg});await write(source+'lineage.json',{...rec(await json(parent+'lineage.json')),parentModel:'src/objects/lmc-volume/source/preparation/l21/',stageChange:cfg.change,stageEvidence:cfg.details});await write(source+'provenance.json',{rungs:runs,barColor:await json(L24+'bar-color.json'),texture:await json(L24+'bar-contrast.json'),slabs:false,fullFit:false});await sharp({create:{width:3072,height:1668,channels:3,background:'#101216'}}).composite([{input:await readFile(versionDir(21)+'sheet.png'),left:0,top:0},{input:await readFile(L24+'sheet.png'),left:1536,top:0}]).png().toFile(L24+'l21-l24-side-by-side.png');}
console.log('L24_REQUESTED_RUNGS_COMPLETE');
