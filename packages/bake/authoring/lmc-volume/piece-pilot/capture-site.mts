/** Temporary local-data swap. Restore after capture; recover interrupted swaps before another run. */
import { cp, mkdir, readFile, writeFile, rename, rm, access } from 'node:fs/promises';
import { dirname } from 'node:path';import { spawn } from 'node:child_process';import { isDeepStrictEqual } from 'node:util';import { pathToFileURL } from 'node:url';
import { readVolumeDatasetBank, writeVolumeDatasetBank, inventoryPreparedAssets } from '@cssearth/objects/node';
import { validatePreparedCssVolume } from '@cssearth/objects';
import { prepareCatalog } from '../../../../../site/build/prepare/catalog/prepare-catalog.mts';
import { capturePiecePilot } from './capture.mts';import { PILOT_DIR } from './source.mts';import { need, json, rec } from '../inputs.mts';
const object='src/objects/lmc-volume/',prepared=object+'prepared',stage=PILOT_DIR+'site-stage',backup=PILOT_DIR+'site-backup';
async function exists(path:string){try{await access(path);return true;}catch(e){if(e&&typeof e==='object'&&'code'in e&&e.code==='ENOENT')return false;throw e;}}
export async function sitePilot(interruptAfterBackup=false){
 if(await exists(backup))await restoreInterruptedPilot();need(rec(await json(PILOT_DIR+'encoding.json')).complete===true,'Finish the tiny bank before installation');
 const original=await readVolumeDatasetBank(prepared),inventory=await readFile(object+'inventory.json'),contextBefore=await readFile('site/prepared/prepared-context-bank-assets.json'),native=original.datasets[0]!.volume,candidate=validatePreparedCssVolume(await json(PILOT_DIR+'volume.json'));
 need(native.impostors,'Use the identical generic near/far rendering path');const volume=validatePreparedCssVolume({...candidate,impostors:native.impostors,resources:[...candidate.resources,...native.resources.filter(r=>r.path.startsWith('l36-far/'))]});
 await rm(stage,{recursive:true,force:true});await cp(prepared,stage,{recursive:true});await rm(stage+'/l36-near',{recursive:true});
 for(const r of candidate.resources){const id=['background','tarantula','compact'].find(id=>r.path.startsWith('l36-piece-'+id+'/'));need(id,'Unknown pilot texture');const relative=r.path.slice(('l36-piece-'+id+'/').length),source=PILOT_DIR+'banks/'+id+'/'+relative;need((await readFile(source)).length===r.bytes,'Pilot texture size changed');await mkdir(dirname(stage+'/'+r.path),{recursive:true});await cp(source,stage+'/'+r.path);}
 await writeVolumeDatasetBank(stage,{...original,datasets:[{...original.datasets[0]!,volume}]});await mkdir(PILOT_DIR+'original-inventory',{recursive:true});await writeFile(PILOT_DIR+'original-inventory/inventory.json',inventory);await writeFile(PILOT_DIR+'original-inventory/context-assets.json',contextBefore);
 let server:ReturnType<typeof spawn>|undefined;
 try{await rename(prepared,backup);if(interruptAfterBackup){await writeFile(PILOT_DIR+'interrupted-site.json',JSON.stringify({checkpoint:'accepted prepared directory moved intact to backup',intentional:true})+'\n');process.kill(process.pid,'SIGKILL');}await rename(stage,prepared);await inventoryPreparedAssets({objectId:'lmc-volume',objectDirectory:object});await prepareCatalog();
  const origin='http://127.0.0.1:4313';try{await fetch(origin);throw Error('Port 4313 is already occupied');}catch(e){if(e instanceof Error&&e.message.includes('already occupied'))throw e;}
  server=spawn('pnpm',['exec','astro','dev','--config','site/astro.config.mts','--host','127.0.0.1','--port','4313','--ignore-lock'],{stdio:['ignore','pipe','pipe'],detached:true,env:{...process.env,ASTRO_DEV_BACKGROUND:'1'}});let output='';for(const stream of[server.stdout,server.stderr])stream?.on('data',(v:Buffer)=>{output+=v.toString();process.stdout.write(v);});
  const deadline=Date.now()+120000;while(true){need(server.exitCode===null,'The real site exited: '+output.slice(-2000));try{const r=await fetch(origin+'/lmc/');if(r.ok)break;}catch{}need(Date.now()<deadline,'Real-site startup timed out: '+output.slice(-2000));await new Promise(r=>setTimeout(r,500));}
  await capturePiecePilot('candidate',origin);console.log('PIECE_REAL_SITE_COMPLETE');
 }finally{if(server?.pid){try{process.kill(-server.pid,'SIGTERM');}catch{}await new Promise(r=>setTimeout(r,500));}if(await exists(backup)){await rm(prepared,{recursive:true,force:true});await rename(backup,prepared);}await writeFile(object+'inventory.json',inventory);await prepareCatalog();need((await readFile('site/prepared/prepared-context-bank-assets.json')).equals(contextBefore),'The generated context asset table did not restore');need(isDeepStrictEqual(await readVolumeDatasetBank(prepared),original)&&(await readFile(object+'inventory.json')).equals(inventory),'Accepted delivery did not restore');await writeFile(PILOT_DIR+'site-restored.json',JSON.stringify({complete:true,originalBankRestored:true,inventoryBytesIdentical:true,contextAssetTableBytesIdentical:true})+'\n');console.log('PIECE_ACCEPTED_DELIVERY_RESTORED');}
}
export async function restoreInterruptedPilot(){need(await exists(backup),'No interrupted accepted-bank backup exists');const original=await readVolumeDatasetBank(backup),inventory=await readFile(PILOT_DIR+'original-inventory/inventory.json');await rm(prepared,{recursive:true,force:true});await rename(backup,prepared);await writeFile(object+'inventory.json',inventory);await prepareCatalog();need(isDeepStrictEqual(await readVolumeDatasetBank(prepared),original),'Interrupted bank did not restore');console.log('PIECE_INTERRUPTED_DELIVERY_RESTORED');}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url){if(process.argv[2]==='restore')await restoreInterruptedPilot();else await sitePilot(process.argv.includes('--interrupt-after-backup'));}
