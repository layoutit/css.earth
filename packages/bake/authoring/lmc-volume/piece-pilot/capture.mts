/** The real site is the viewer. Screenshots use one common black diagnostic backdrop behind all axis groups. */
import { mkdir, writeFile } from 'node:fs/promises';import { pathToFileURL } from 'node:url';
import { chromium } from 'playwright';import sharp from 'sharp';
import { parseEmbedPageMessage, EMBED_BRIDGE_PROTOCOL } from '@cssearth/renderer/embed/embed-bridge.ts';
import { cameraPoseFromReferenceFrame } from '@cssearth/engine';
import { readPilotRegions, PILOT_DIR } from './source.mts';import { regionCameras, pilotCamera, cameraUrl, cameraWorld } from './cameras.mts';
import { KPC_M } from '../delivery/delivery-frame.mts';import { need } from '../inputs.mts';
export async function capturePiecePilot(variant:string,origin='http://127.0.0.1:4312'){
 need(['baseline','candidate'].includes(variant),'Unknown comparison variant');const source={regions:await readPilotRegions()},directory=PILOT_DIR+variant+'/';await mkdir(directory,{recursive:true});
 const cameras=[...source.regions.flatMap(r=>regionCameras(r.id,r.box)),...[[0,0],[45,0],[90,45]].map(([t,a])=>pilotCamera('galaxy-'+t+'-'+a,128,[0,0,0],10,t!,a!))],browser=await chromium.launch({headless:true,executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'}),rows=[];
 try{const page=await browser.newPage({viewport:{width:512,height:784},deviceScaleFactor:1}),errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));
  for(const c of cameras){const url=await cameraUrl(origin,c);await page.goto(url,{waitUntil:'domcontentloaded',timeout:120000});await page.waitForFunction(()=>document.documentElement.dataset.ready==='true',{},{timeout:120000});
   console.log('PIECE_SITE_STATE '+c.name+' '+JSON.stringify(await page.evaluate(()=>({detail:[...document.querySelectorAll<HTMLElement>('.css-volume-detail')].map(n=>({display:getComputedStyle(n).display,opacity:getComputedStyle(n).opacity,leaves:n.querySelectorAll('s').length})),far:[...document.querySelectorAll<HTMLElement>('.css-volume-impostors')].map(n=>({display:getComputedStyle(n).display,opacity:getComputedStyle(n).opacity})),banks:[...document.querySelectorAll<HTMLElement>('[data-volume-dataset-object]')].map(n=>n.dataset.volumeDatasetObject)}))));
   await page.waitForFunction(()=>{const n=document.querySelector<HTMLElement>('[data-volume-dataset-object="lmc-volume"] .css-volume-detail');return n&&getComputedStyle(n).display!=='none'&&Number(getComputedStyle(n).opacity)>.9;},{},{timeout:120000});
   const raw=await page.evaluate(async()=>{const bank=document.querySelector<HTMLElement>('[data-volume-dataset-object="lmc-volume"]')!,detail=bank.querySelector<HTMLElement>('.css-volume-detail')!;detail.style.background='#000';const urls=[...detail.querySelectorAll<HTMLElement>('s')].flatMap(n=>[...getComputedStyle(n).backgroundImage.matchAll(/url\("?([^"\)]+)"?\)/gu)].map(m=>m[1]!));await Promise.all([...new Set(urls)].map(async url=>{const im=new Image();im.src=url;await im.decode();}));await new Promise<void>(r=>requestAnimationFrame(()=>requestAnimationFrame(()=>r())));const api:unknown=Reflect.get(window,'__lmc');if(!api||typeof api!=='object')throw Error('Missing object diagnostics');const runtime:unknown=Reflect.get(api,'runtime');if(!runtime||typeof runtime!=='object')throw Error('Missing runtime');const read:unknown=Reflect.get(runtime,'view');if(typeof read!=='function')throw Error('Missing view');const p:unknown=read.call(runtime);if(!p||typeof p!=='object')throw Error('No physical view');return{world:Reflect.get(p,'worldCamera'),viewport:Reflect.get(p,'stageViewport'),layers:detail.querySelectorAll('s').length,stacks:[...detail.querySelectorAll<HTMLElement>('.css-volume-projection')].map(n=>({opacity:getComputedStyle(n).opacity,background:getComputedStyle(n).backgroundColor,layers:n.querySelectorAll('s').length})),far:[...bank.querySelectorAll<HTMLElement>('.css-volume-impostors')].map(n=>getComputedStyle(n).display)};});
   const actual=parseEmbedPageMessage({protocol:EMBED_BRIDGE_PROTOCOL,type:'camera',camera:{world:raw.world,viewport:raw.viewport},moving:false});need(actual?.type==='camera','Missing physical camera publication');const expected=cameraWorld(c),delta=cameraPoseFromReferenceFrame(actual.camera.world.pose,{originM:expected.pose.positionM,localToReferenceXyzw:expected.pose.orientationXyzw});need(Math.hypot(...delta.positionM)/KPC_M<1e-6&&Math.abs(delta.orientationXyzw[3])>1-1e-8,'The site moved the source camera');need(raw.layers===33&&raw.far.every(v=>v==='none'),'The pilot must be 33 real layers, never an impostor');need(Math.abs(actual.camera.viewport.focalPixels/(4*c.focal)-1)<1e-4,'The actual physical camera scale differs');
   const stage=await page.locator('.object-viewport').boundingBox();need(stage,'Missing actual scene viewport');const optics=actual.camera.viewport;need(typeof optics.widthPixels==='number'&&typeof optics.heightPixels==='number','Missing real viewport size');const clip={x:stage.x+optics.widthPixels/2+optics.principalOffsetPixels[0]-256,y:stage.y+optics.heightPixels/2+optics.principalOffsetPixels[1]-256,width:512,height:512};need(clip.x>=stage.x&&clip.y>=stage.y&&clip.x+512<=stage.x+stage.width&&clip.y+512<=stage.y+stage.height,'The physical square is outside the real scene');const png=await page.screenshot({path:directory+c.name+'.png',clip});await sharp(png).resize(128,128).png().toFile(directory+c.name+'-128.png');rows.push({name:c.name,url,physicalWidthKpc:c.widthKpc,pixelPc:c.widthKpc/128*1000,state:raw,optics:actual.camera.viewport,squareCenteredOnOpticalAxis:true});console.log('PIECE_SITE_CAPTURE '+variant+' '+c.name);
  }need(errors.length===0,'Page errors: '+errors.join('; '));
 }finally{await browser.close();}
 await writeFile(directory+'result.json',JSON.stringify({complete:true,variant,size:128,viewport:{width:512,height:784},capture:512,realSite:true,commonBlackBackdrop:true,axisMatteUnmodified:true,rows},null,2)+'\n');console.log('PIECE_SITE_CAPTURE_COMPLETE '+variant);
}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await capturePiecePilot(process.argv[2]??'baseline',process.argv[3]);
