/** Luri 2021 RGB/RC selection, Gaia DR3 photometry, and bounded archive acquisition. */
import {mkdir,readFile,writeFile,stat} from 'node:fs/promises';
import {pathToFileURL} from 'node:url';
import {tapRows} from '@cssearth/telescope-core/node';
import {LOCAL,json,rec,array,num,need} from './inputs.mts';
import {parseStars,learnMembership,projectedMotion,mahalanobis,L13,GAIA_SERVICE,SELECTION_PAPER,type GaiaStar,type Membership} from './gaia-young.mts';
export const L20=LOCAL+'versions/l20/';
export const RGB_POLYGON=[[.8,20.5],[.9,19.5],[1.6,19.8],[1.6,19],[1.05,18.41],[1.3,16.56],[1.6,15.3],[2.4,15.97],[1.95,17.75],[1.85,19],[2,20.5]];
export const RC_POLYGON=[[.9,19.5],[.9,18.25],[1.6,19],[1.6,19.8]];
export function insidePolygon(x:number,y:number,p:number[][]){let inside=false;for(let i=0,j=p.length-1;i<p.length;j=i++){const a=p[i],b=p[j];if((a[1]>y)!==(b[1]>y)&&x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0])inside=!inside;}return inside;}
export function oldPhase(g:number,color:number){return insidePolygon(color,g,RGB_POLYGON)?'RGB':insidePolygon(color,g,RC_POLYGON)?'RC':null;}
export function member(s:GaiaStar,m:Membership){return s.parallax/s.parallaxError<5&&mahalanobis(projectedMotion(s,m.parallaxMedian),m)<9.21;}
const columns='source_id,ra,dec,phot_g_mean_mag,phot_bp_mean_mag,phot_rp_mean_mag,parallax,parallax_error,pmra,pmdec,pmra_error,pmdec_error,parallax_pmra_corr,parallax_pmdec_corr';
export function polygonSql(p:number[][]){const ys=[...new Set(p.map(v=>v[1]))].sort((a,b)=>a-b),clauses:string[]=[];for(let k=1;k<ys.length;k++){const lo=ys[k-1],hi=ys[k],mid=(lo+hi)/2,edges=p.map((a,i)=>({a,b:p[(i+1)%p.length]})).filter(({a,b})=>(a[1]>mid)!==(b[1]>mid)).sort((u,v)=>{const x=({a,b}:typeof u)=>a[0]+(mid-a[1])*(b[0]-a[0])/(b[1]-a[1]);return x(u)-x(v);}),line=({a,b}:typeof edges[number])=>`(${a[0]}+(phot_g_mean_mag-${a[1]})*(${(b[0]-a[0])/(b[1]-a[1])}))`;for(let i=0;i+1<edges.length;i+=2)clauses.push(`(phot_g_mean_mag>=${lo} AND phot_g_mean_mag<${hi} AND phot_bp_mean_mag-phot_rp_mean_mag>=${line(edges[i])} AND phot_bp_mean_mag-phot_rp_mean_mag<=${line(edges[i+1])})`);}return '('+clauses.join(' OR ')+')';}
export function oldQuery(kind:'density'|'points'|'count',pilot=false){const radius=pilot?.25:20,where=[`1=CONTAINS(POINT('ICRS',ra,dec),CIRCLE('ICRS',81.28,-69.78,${radius}))`,'parallax IS NOT NULL','parallax_error>0','parallax/parallax_error<5','pmra IS NOT NULL','pmdec IS NOT NULL',`(${polygonSql(RGB_POLYGON)} OR ${polygonSql(RC_POLYGON)})`];if(kind==='density')where.push('random_index<100000000');else where.push('phot_g_mean_mag<18');return `SELECT ${kind==='count'?'COUNT(*) AS n':'TOP 800001 '+columns} FROM gaiadr3.gaia_source WHERE ${where.join(' AND ')}`;}
export async function acquireOld(kind:'density'|'points',pilot=false,range?:readonly[number,number]):Promise<GaiaStar[]>{await mkdir(L20+'inputs/',{recursive:true});if(kind==='points'&&!pilot&&!range){const ranges:readonly[number,number][]=[[15.3,17],[17,17.5],[17.5,18]],parts=await Promise.allSettled(ranges.map(r=>acquireOld(kind,pilot,r))),all:GaiaStar[]=[];for(const part of parts){if(part.status==='rejected')throw part.reason;for(const star of part.value)all.push(star);}need(new Set(all.map(s=>s.id)).size===all.length,'Repeated old Gaia point identity across magnitude partitions');await writeFile(L20+'inputs/points.request.json',JSON.stringify({complete:true,partitioned:true,ranges,rows:all.length,pilot:false,product:'Gaia DR3 RGB old points',reason:'The single bounded query hit its row cap. Disjoint magnitude intervals cover the exact original selection.'},null,2)+'\n');return all;}
 const name=kind+(pilot?'-pilot':'')+(range?`-${range[0]}-${range[1]}`:''),path=L20+'inputs/'+name+'.rows.json',query=oldQuery(kind,pilot)+(range?` AND phot_g_mean_mag>=${range[0]} AND phot_g_mean_mag<${range[1]}`:''),request=L20+'inputs/'+name+'.request.json',cached=await json(request).then(rec).catch(()=>null);if(cached?.complete===true&&cached.query===query&&await stat(path).catch(()=>null)){const raw=await json(path),stars=parseStars(raw);need(stars.length===num(cached.rows),'Old Gaia cache count mismatch');return stars;}
 const started=performance.now();console.log(JSON.stringify({sentinel:'L20_GAIA_QUERY_STARTED',kind,pilot,range}));const raw=await tapRows(GAIA_SERVICE,query,800003,'async');need(raw.length>0&&raw.length<800000,'Old Gaia query empty or truncated; split the archive request before continuing');const stars=parseStars(raw),bytes=Buffer.from(JSON.stringify(raw));need(bytes.length<500*1024**2,'Old Gaia input exceeds its byte budget');await writeFile(path,bytes);await writeFile(request,JSON.stringify({product:'Gaia DR3 gaiadr3.gaia_source',service:GAIA_SERVICE,query,rows:stars.length,bytes:bytes.length,seconds:(performance.now()-started)/1000,complete:true,pilot,range,paper:SELECTION_PAPER},null,2)+'\n');console.log(JSON.stringify({sentinel:'L20_GAIA_QUERY_COMPLETE',kind,pilot,range,rows:stars.length,seconds:(performance.now()-started)/1000}));return stars;
}
export async function loadOld(pilot=false){const calibration=parseStars(await json(L13+'inputs/calibration.rows.json')),membership=learnMembership(calibration),density=(await acquireOld('density',pilot)).filter(s=>s.bp!==null&&s.rp!==null&&oldPhase(s.g,s.bp-s.rp)&&member(s,membership)),points=(await acquireOld('points',pilot)).filter(s=>s.bp!==null&&s.rp!==null&&oldPhase(s.g,s.bp-s.rp)&&member(s,membership));need(density.length>(pilot?10:10000)&&points.length>(pilot?5:1000),'Insufficient old Gaia members');const summary={paper:SELECTION_PAPER,densityStars:density.length,resolvedOldStars:points.length,densitySampling:'Uniform random_index <100,000,000, approximately 5.52% of Gaia DR3; the spatial sample is complete to its declared random-index threshold.',pointSampling:'All selected old members with G<18 within 20 degrees; no random-index cut.',membership,selection:'Published RGB and RC polygons; signed parallax/error <5 and conditional orthographic proper-motion ellipse chi-square <9.21.',limitations:'CMD phase proxies are not exact ages. Crowding, extinction and the magnitude limit affect completeness. No survey hole is filled from the photo.'};await writeFile(L20+'old-selection.json',JSON.stringify(summary,null,2)+'\n');return{density,points,summary};}
if(process.argv[1]&&pathToFileURL(process.argv[1]).href===import.meta.url)await loadOld(process.argv.includes('--pilot'));
