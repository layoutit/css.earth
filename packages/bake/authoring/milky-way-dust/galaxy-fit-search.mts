/** Small bounded Nelder–Mead search for correlated global appearance parameters. */
function need(value:unknown,message:string):asserts value {if(!value)throw new TypeError(message);}
export function minimizeBox(objective:(x:number[])=>number,start:number[],bounds:readonly(readonly[number,number])[],iterations=100){const n=start.length;need(n>0&&bounds.length===n,'Invalid optimizer dimensions');const clamp=(x:number[])=>x.map((v,i)=>Math.max(bounds[i][0],Math.min(bounds[i][1],v))),point=(x:number[])=>{const p=clamp(x),value=objective(p);need(Number.isFinite(value),'Nonfinite global fit objective');return{x:p,value};},simplex=[point(start),...start.map((_,i)=>point(start.map((v,j)=>v+(i===j?.08*(bounds[j][1]-bounds[j][0]):0))))];
 for(let round=0;round<iterations;round++){simplex.sort((a,b)=>a.value-b.value);const best=simplex[0],worst=simplex[n],center=Array.from({length:n},(_,i)=>simplex.slice(0,n).reduce((s,p)=>s+p.x[i]/n,0)),reflected=point(center.map((v,i)=>2*v-worst.x[i]));if(reflected.value<best.value){const expanded=point(center.map((v,i)=>v+2*(reflected.x[i]-v)));simplex[n]=expanded.value<reflected.value?expanded:reflected;}else if(reflected.value<simplex[n-1].value)simplex[n]=reflected;else{const contracted=point(center.map((v,i)=>v+.5*((reflected.value<worst.value?reflected.x[i]:worst.x[i])-v)));if(contracted.value<Math.min(worst.value,reflected.value))simplex[n]=contracted;else for(let k=1;k<=n;k++)simplex[k]=point(simplex[k].x.map((v,i)=>best.x[i]+.5*(v-best.x[i])));}}
 simplex.sort((a,b)=>a.value-b.value);return simplex[0];}
