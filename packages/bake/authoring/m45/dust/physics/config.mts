import { readFile } from 'node:fs/promises';
import { requireRecord,requireArray,requireFiniteNumber } from '@cssearth/core';
import { PC,YEAR,unit,scale,dot,type Inputs,type Vec,type Star } from './types.mts';
const rad=Math.PI/180;
export const skyDirection=(ra:number,dec:number):Vec=>[Math.cos(dec*rad)*Math.cos(ra*rad),Math.cos(dec*rad)*Math.sin(ra*rad),Math.sin(dec*rad)];
const spectral=(temperature:number,radiusSolar:number,wavelengthNm:number)=>{const h=6.62607015e-34,c=299792458,k=1.380649e-23,w=wavelengthNm*1e-9,r=radiusSolar*6.957e8;return 8*Math.PI*Math.PI*h*c*c*r*r/(w**5*Math.expm1(h*c/(w*k*temperature)))*1e-9;};
export async function loadInputs():Promise<Inputs> {
 const normal=skyDirection(56.67978318,24.10845447),ra=56.67978318*rad,dec=24.10845447*rad,east:Vec=[-Math.sin(ra),Math.cos(ra),0],north:Vec=[-Math.sin(dec)*Math.cos(ra),-Math.sin(dec)*Math.sin(ra),Math.cos(dec)];
 const rows=(await readFile('src/objects/milky-way-pleiades-dust/source/inputs/named-stars.csv','utf8')).trim().split(/\r?\n/).slice(1).map(line=>{const p=line.split(',');return {hip:Number(p[0]),ra:Number(p[1]),dec:Number(p[2])};});
 const raw=requireRecord(JSON.parse(await readFile('src/objects/milky-way-pleiades-dust/source/inputs/stellar-inputs.json','utf8'))),masses=[5.9,4.74,3.42,4.7,4.22,4.25,4.41,3.8];
 const stars:Star[]=requireArray(raw.stars).map((v,i)=>{const s=requireRecord(v),name=String(s.name),hip=requireFiniteNumber(s.hip),row=rows.find(r=>r.hip===hip);if(!row)throw Error('Missing star');const ray=skyDirection(row.ra,row.dec),distance=136.7/dot(ray,normal),at:Vec=[distance*dot(ray,east),distance*dot(ray,north),.7],temperatureK=requireFiniteNumber(s.temperatureK),radiusSolar=requireFiniteNumber(s.publishedRadiusSolar)*distance/requireFiniteNumber(s.publishedReferenceDistancePc);return {name,hip,at,temperatureK,radiusSolar,massSolar:masses[i]!,luminositySolar:radiusSolar**2*(temperatureK/5772)**4,spectralWNm:[spectral(temperatureK,radiusSolar,805),spectral(temperatureK,radiusSolar,537),spectral(temperatureK,radiusSolar,436)]};});
 const grainRows=(await readFile('src/objects/milky-way-pleiades-dust/source/inputs/draine-rv31.txt','utf8')).split('\n').map(l=>l.trim().split(/\s+/).slice(0,6).map(Number)).filter(r=>r.length===6&&r.every(Number.isFinite)&&r[0]!>0).sort((l,r)=>l[0]!-r[0]!);
 const at=(w:number,c:number)=>{const i=grainRows.findIndex(r=>r[0]!>=w);if(i<1)throw Error('Missing grain data');const lo=grainRows[i-1]!,hi=grainRows[i]!,f=(w-lo[0]!)/(hi[0]!-lo[0]!);return lo[c]!*(1-f)+hi[c]!*f;};
 const wavelengths=[.805,.537,.436],optical={albedo:wavelengths.map(w=>at(w,1)) as Vec,g:wavelengths.map(w=>at(w,2)) as Vec,extinctionRatio:wavelengths.map(w=>at(w,3)/at(.537,3)) as Vec};
 const meta=requireRecord(JSON.parse(await readFile('src/objects/milky-way-pleiades-dust/source/inputs/extinction/columns.json','utf8'))),mw=requireFiniteNumber(meta.width),mh=requireFiniteNumber(meta.height),ra0=requireFiniteNumber(meta.ra0),dec0=requireFiniteNumber(meta.dec0),dra=requireFiniteNumber(meta.raStep),ddec=requireFiniteNumber(meta.decStep);
 const maps=await Promise.all(['edenhofer','leike'].map(async n=>{const buf=await readFile(`src/objects/milky-way-pleiades-dust/source/inputs/extinction/${n}-column.f32`),out=new Float32Array(buf.length/4);for(let i=0;i<out.length;i++)out[i]=buf.readFloatLE(i*4);if(out.length!==mw*mh)throw Error('Column dimensions');return out;}));
 const members=requireArray(JSON.parse(await readFile('src/objects/milky-way-pleiades-dust/source/inputs/member-reddening.json','utf8'))).map(v=>{const s=requireRecord(v);return {ra:requireFiniteNumber(s.ra),dec:requireFiniteNumber(s.dec),ebv:requireFiniteNumber(s.ebv)};});
 const mapAt=(m:Float32Array,ra:number,dec:number)=>{const x=Math.max(0,Math.min(mw-1.001,(ra-ra0)/dra)),y=Math.max(0,Math.min(mh-1.001,(dec-dec0)/ddec)),ix=Math.floor(x),iy=Math.floor(y),u=x-ix,v=y-iy;return m[iy*mw+ix]!*(1-u)*(1-v)+m[iy*mw+ix+1]!*u*(1-v)+m[(iy+1)*mw+ix]!*(1-u)*v+m[(iy+1)*mw+ix+1]!*u*v;};
 const columnEbv=(x:number,y:number)=>{const p:Vec=[136*normal[0]+x*east[0]+y*north[0],136*normal[1]+x*east[1]+y*north[1],136*normal[2]+x*east[2]+y*north[2]],r=Math.hypot(...p),ra=Math.atan2(p[1],p[0])/rad,dec=Math.asin(p[2]/r)/rad;let sum=0,weight=0;for(const m of members){const d2=((ra-m.ra)*Math.cos(dec*rad))**2+(dec-m.dec)**2,w=Math.exp(-d2/(2*.12**2));sum+=w*Math.max(0,m.ebv-.035);weight+=w;}const member=weight>1e-8?sum/weight:0;return Math.max(0,(mapAt(maps[0]!,ra,dec)+mapAt(maps[1]!,ra,dec)+member)/3);};
 const velocity:Vec=[-5.3,10,10.8],speedKmS=Math.hypot(...velocity),gasVelocityPcYr=scale(velocity,1000*YEAR/PC),upstream=scale(unit(velocity),-1);
 return {stars,grains:[{radiusMicron:.05,weight:.25,materialDensityGcm3:3,qPr:1},{radiusMicron:.1,weight:.5,materialDensityGcm3:3,qPr:1},{radiusMicron:.2,weight:.25,materialDensityGcm3:3,qPr:1}],gasVelocityPcYr,upstream,speedKmS,columnEbv,grainOptical:optical,reference:{normal,east,north},metadata:{starSource:'White2017Table1; radii scaled consistently to adopted136.7pc normal-depth realization',columnSource:'mean Edenhofer/Leike120to150pc columns plus Breger excess above.035; member interpolation sigma.12deg',photoDensityDependency:false,flow:'conditional Herbig vector at historical118pc retained as a scenario, not a new measured global space motion',grainForce:'Qpr1 and coarse optical grain weights adopted'}};
}
