 const outgoingAt=(x:number,y:number,z:number)=>{if(finiteEscape){const g=finiteEscape.find(g=>contains(g,x,y,z));if(!g)return 0;sample(g,x,y,z,scratch);return scratch[0]!;}let sum=0,p:Vec=[x,y,z];for(let i=0;i<outgoing.length;i++){const g=outgoing[i]!;if(!contains(g,...p))continue;sample(g,...p,scratch);sum+=scratch[0]!;p[axis]=positive?g.max[axis]!:g.min[axis]!;}return sum;};
 for(const[gIndex,g]of grids.entries()){for(let z=0;z<g.shape[2];z++)for(let y=0;y<g.shape[1];y++)for(let x=0;x<g.shape[0];x++){const p=position(g,x,y,z);let view=back;if(eye){const dx=eye[0]-p[0],dy=eye[1]-p[1],dz=eye[2]-p[2],d=Math.hypot(dx,dy,dz);if(d>1e-9)view=[dx/d,dy/d,dz/d];}illuminate(view,...p,v,component);const tau=outgoingAt(...p);for(let c=0;c<3;c++)v[c]!*=Math.exp(-tau*opt.extinctionRatio[c]!);g.data.set(v,((z*g.shape[1]+y)*g.shape[0]+x)*3);}console.log('PLEIADES_SOURCE_CACHE_READY',JSON.stringify({back,grid:gIndex,seconds:(Date.now()-start)/1000}));}return{at(x,y,z,out){const g=grids.find(g=>contains(g,x,y,z));if(!g){out.fill(0);return;}sample(g,x,y,z,out);}};},metadata:{isrf:'fixed published Draine2021modifiedMMPU1; same isotropic boundary intensity everywhere; six-direction HG-weighted incoming attenuation, normalized to recover unattenuated isotropy exactly',lighting:'published B-star spectral luminosities, exact1/r² and HG at cache nodes, same Draine grains; incident and complete outgoing Beer-Lambert',densityCacheShapes:densityGrids.map(g=>g.shape),incidentCacheShapes:opticalGrids.map(g=>g.shape),incidentSteps:'16–96 midpoint samples, using prepared three-resolution density; no fitted radiation amplitude',finiteStationOutgoing:'Finite camera-to-dust rays,8–128midpoints and three optical-cache levels; extinction stops at actual prepared observer, phase uses point-to-observer direction',outgoing:'For distant reference photometry: cardinal cumulative trapezoids, stitched fine→regional→wide at actual domain exits; each point already attenuated before cellular partition, no duplicated front extinction',limitations:['Incident attenuation and radiance interpolated from finite caches; unresolved cavities smaller than a cache cell remain uncertain.','Six angular rays approximate the attenuated Galactic field; the boundary lies on this finite regional map.','Only the fixed Earth-reference scattering field is installed; source calculations run offline.']}};
}
