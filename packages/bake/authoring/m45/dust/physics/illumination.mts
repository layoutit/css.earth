export type LightComponent='all'|'stellar'|'galactic';
export interface Transport {density(x:number,y:number,z:number):number;source(back:Vec,eye?:Vec,component?:LightComponent):{at(x:number,y:number,z:number,out:Float64Array):void};metadata:Record<string,unknown>}
const contains=(g:Grid,x:number,y:number,z:number)=>x>=g.min[0]&&x<=g.max[0]&&y>=g.min[1]&&y<=g.max[1]&&z>=g.min[2]&&z<=g.max[2];
function outgoingGrid(g:Grid,back:Vec):Grid{const axis=back.findIndex(v=>v!==0),positive=back[axis]!>0,result=grid(g.min,g.max,g.shape),step=(g.max[axis]!-g.min[axis]!)/(g.shape[axis]!-1),other=[0,1,2].filter(a=>a!==axis),p=[0,0,0],index=()=>((p[2]!*g.shape[1]+p[1]!)*g.shape[0]+p[0]!);for(let u=0;u<g.shape[other[0]!]!;u++)for(let v=0;v<g.shape[other[1]!]!;v++){p[other[0]!]=u;p[other[1]!]=v;let sum=0,previous=0;for(let k=0;k<g.shape[axis]!;k++){p[axis]=positive?g.shape[axis]!-1-k:k;const i=index(),rho=g.data[i]!;if(k)sum+=(previous+rho)*step/2;result.data[i]=sum;previous=rho;}}return result;}
export async function prepareTransport(field:Field):Promise<Transport>{
 const start=Date.now(),isrf=await loadIsrf(),densityGrids=[grid([-4,-4,-6],[4,4,6],[129,129,193]),grid([-12,-12,-16],[12,12,12],[65,65,65]),grid(field.bounds.min,field.bounds.max,[65,65,65])];
