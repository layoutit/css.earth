import {readFile} from 'node:fs/promises';
import {requireRecord,requireFiniteNumber} from '@cssearth/core';
import type {FitsHeader} from '@cssearth/fits';
import type {IrCube,IrBand,BandName} from './types.mts';
import {f32} from './intake.mts';
export async function loadCube(root='src/objects/milky-way-pleiades-dust/source/inputs/column'):Promise<IrCube>{const r=requireRecord(JSON.parse(await readFile(`${root}/ir-intake.json`,'utf8'))),width=requireFiniteNumber(r.width),height=requireFiniteNumber(r.height),h=requireRecord(r.header),header:FitsHeader={};for(const[k,v]of Object.entries(h)){if(typeof v!=='number'&&typeof v!=='string'&&typeof v!=='boolean'&&v!==undefined)throw Error('Header');header[k]=v;}const bands:IrBand[]=[];for(const name of ['WISE3','WISE4','MIPS24','MIPS70']as BandName[]){const b:IrBand={name,data:await f32(`${root}/${name}-data.f32`),variance:await f32(`${root}/${name}-variance.f32`),validity:await readFile(`${root}/${name}-validity.u8`)};if(name==='MIPS70'){b.coarseData=await f32(`${root}/${name}-coarse.f32`);b.coarseValidity=await readFile(`${root}/${name}-coarse-validity.u8`);b.coarseVariance=await f32(`${root}/${name}-coarse-variance.f32`);}bands.push(b);}return {width,height,header,bands,NHprior:await f32(`${root}/NHprior.f32`),fcoarse:await f32(`${root}/fcoarse.f32`),Ustar0:await f32(`${root}/Ustar0.f32`),Ustar1:await f32(`${root}/Ustar1.f32`)};}
