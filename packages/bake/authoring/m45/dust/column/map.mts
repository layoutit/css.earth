 for(const p of fill)NH[p]=Math.exp(logs[p]!);
 const distance=Float32Array.from(outside,v=>v?0:1e6);if(options.respectProcessingBoundary){for(let x=0;x<width;x++){distance[x]=0;distance[(height-1)*width+x]=0;}for(let y=0;y<height;y++){distance[y*width]=0;distance[y*width+width-1]=0;}}const relax=(p:number,q:number,w:number)=>{if(q>=0&&q<n)distance[p]=Math.min(distance[p]!,distance[q]!+w);};
 for(let y=0;y<height;y++)for(let x=0;x<width;x++){const p=y*width+x;if(x>0)relax(p,p-1,1);if(y>0)relax(p,p-width,1);if(x>0&&y>0)relax(p,p-width-1,Math.SQRT2);}
