import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {dirname} from 'node:path';
import {requireRecord,requireFiniteNumber} from '@cssearth/core';
import {skyProjection,type FitsHeader} from '@cssearth/fits';
import {f32} from './intake.mts';
function header(v:unknown):FitsHeader{const r=requireRecord(v),out:FitsHeader={};for(const[k,x]of Object.entries(r)){if(typeof x!=='string'&&typeof x!=='number'&&typeof x!=='boolean'&&x!==undefined)throw Error('Invalid WCS header');out[k]=x;}return out;}
export interface ColumnMap {width:number;height:number;projection:ReturnType<typeof skyProjection>;NH:Float32Array;prior:Float32Array;f:Float32Array;alpha:Float32Array;metadata:Record<string,unknown>}
export async function loadColumnMap(root='src/objects/milky-way-pleiades-dust/source/inputs/column',nhOverride?:Float32Array,options:{respectProcessingBoundary?:boolean;transitionPixels?:number;assumptionsPath?:string}={}):Promise<ColumnMap>{const intake=requireRecord(JSON.parse(await readFile(`${root}/ir-intake.json`,'utf8'))),width=requireFiniteNumber(intake.width),height=requireFiniteNumber(intake.height),NH=nhOverride?.slice()??await f32(`${root}/column-NH.f32`),prior=await f32(`${root}/NHprior.f32`),f=await f32(`${root}/fcoarse.f32`),valids=await Promise.all(['WISE3','WISE4','MIPS24'].map(n=>readFile(`${root}/${n}-validity.u8`)));if(NH.length!==width*height||prior.length!==NH.length||f.length!==NH.length)throw Error('Column shapes');
 const n=NH.length,support=Uint8Array.from(NH,(_,i)=>valids.reduce((sum,a)=>sum+Number(a[i]!>0),0)>=2?1:0),outside=new Uint8Array(n),queue=new Uint32Array(n);let head=0,tail=0;
 const add=(p:number)=>{if(!support[p]&&!outside[p]){outside[p]=1;queue[tail++]=p;}};
 for(let x=0;x<width;x++){add(x);add((height-1)*width+x);}for(let y=0;y<height;y++){add(y*width);add(y*width+width-1);}while(head<tail){const p=queue[head++]!,x=p%width,y=Math.floor(p/width);if(x>0)add(p-1);if(x<width-1)add(p+1);if(y>0)add(p-width);if(y<height-1)add(p+width);}
 const fill:number[]=[];let fineCount=0;for(let p=0;p<n;p++){if(!support[p])NH[p]=prior[p]!;if(!support[p]&&!outside[p])fill.push(p);if(support[p])fineCount++;}
 // Beam-scale IR gaps are conditionally interpolated in log column; their observational flags remain missing.
 const logs=Float32Array.from(NH,v=>Math.log(Math.max(v,1e17)));
