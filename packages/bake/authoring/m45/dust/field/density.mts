 for(let y=0;y<193;y++)for(let x=0;x<193;x++){const p=position(coarse,x,y,0),uv=irWcs.pixelOf(...sky(p[0],p[1]));let heat=1;for(const star of inputs.stars){const d2=(p[0]-star.at[0])**2+(p[1]-star.at[1])**2+star.at[2]**2;heat+=star.luminositySolar*3.828e26/(4*Math.PI*Math.max(d2,.01)*PC*PC)/(299792458*1.043e-13);}const temperature=18*Math.pow(heat,1/6),thermal=1/Math.expm1(143.877/temperature);irRatio[y*193+x]=(uv?imageSample(iris,iw,ih,...uv):0)/thermal;}
 for(let y=0;y<193;y++)for(let x=0;x<193;x++){let sum=0,n=0;for(let j=Math.max(0,y-4);j<=Math.min(192,y+4);j++)for(let i=Math.max(0,x-4);i<=Math.min(192,x+4);i++){sum+=irRatio[j*193+i]!;n++;}const relative=sum>0?irRatio[y*193+x]!/(sum/n):1;const o=y*193+x;coarse.data[o]!*=relative;coarse.data[193*193+o]=coarse.data[o]!;}
