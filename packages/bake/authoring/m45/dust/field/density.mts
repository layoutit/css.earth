 for(let y=0;y<fineN;y++)for(let x=0;x<fineN;x++){const px=-4+(x+.5)*8/fineN,py=-4+(y+.5)*8/fineN,uv=column.projection.pixelOf(...sky(px,py));sample(coarse,px,py,.5,probe);let tau=probe[0]!;if(uv){const a=smooth(imageSample(column.alpha,column.width,column.height,...uv));tau=tau*(1-a)+CXV*imageSample(column.NH,column.width,column.height,...uv)*136/Math.hypot(136,px,py)*a;}fine[y*fineN+x]=tau;}
 const columnAt=(x:number,y:number)=>{if(Math.abs(x)<4&&Math.abs(y)<4)return imageSample(fine,fineN,fineN,(x+4)*fineN/8-.5,(y+4)*fineN/8-.5);sample(coarse,x,y,.5,probe);return probe[0]!;};
 const cavity=grid([-4,-4,-6],[4,4,6],[129,129,193]);for(let z=0;z<cavity.shape[2];z++)for(let y=0;y<129;y++)for(let x=0;x<129;x++){const p=position(cavity,x,y,z);cavity.data[(z*129+y)*129+x]=cavities.factor(...p,.0625);}const cavityProbe=new Float64Array(1);
 const cavityAt=(x:number,y:number,z:number)=>{if(inputs.stars.some(s=>(x-s.at[0])**2+(y-s.at[1])**2+(z-s.at[2])**2<.09))return cavities.factor(x,y,z,.015625);if(Math.abs(x)>4||Math.abs(y)>4||Math.abs(z)>6)return cavities.factor(x,y,z,.125);sample(cavity,x,y,z,cavityProbe);return cavityProbe[0]!;};
 const norm=grid([-12,-12,0],[12,12,1],[129,129,2]);for(let y=0;y<129;y++)for(let x=0;x<129;x++){const p=position(norm,x,y,0);let sum=0;for(let z=-15.875;z<12;z+=.25)sum+=prior.sampleRay(p[0],p[1],z)*cavityAt(p[0]*(136+z)/136,p[1]*(136+z)/136,z)*.25;const q=sum>1e-12?1/sum:0;norm.data[y*129+x]=q;norm.data[129*129+y*129+x]=q;}
 const normalization=new Float64Array(1),near=(x:number,y:number,z:number)=>{const w=nearWeight(x,y,z);if(w===0)return 0;const f=136/(136+z);sample(norm,x*f,y*f,.5,normalization);return Math.max(0,columnAt(x*f,y*f)*prior.sample(x,y,z)*cavityAt(x,y,z)*normalization[0]!*w);},removed=(x:number,y:number,z:number)=>raw(x,y,z)*nearWeight(x,y,z),far=(x:number,y:number,z:number)=>raw(x,y,z)*(1-nearWeight(x,y,z));
