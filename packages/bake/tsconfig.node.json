{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "../../output/tsbuildinfo/packages-bake-node.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ]
  },
  "include": [
    "src/volume/node",
    "src/photometry",
    "src/raster",
    "src/scene",
    "src/presentation",
    "src/volume-leaves",
    "src/stars",
    "src/shell",
    "src/sky",
    "src/density",
    "src/image-layers",
    "src/environment",
    "src/objects",
    "src/galaxy-catalog",
    "src/cluster-catalog",
    "src/world-context",
    "src/nebula",
    "src/runtime-source",
    "src/prepared-presentation",
    "src/delivery",
    "src/sources",
    "src/contract",
    "src/thread-pool",
    "src/astronomy",
    "src/navigation",
    "src/site-assets",
    "src/facility-renders",
    "src/asset-publication",
    "src/surface-previews",
    "src/preparation",
    "src/run-implemented-objects",
    "src/prepare-objects",
    "src/prepare-object",
    "src/refresh-shape-lighting",
    "src/refresh-shape-materials",
    "src/refresh-surface-observations",
    "src/refresh-terrain-photographs"
