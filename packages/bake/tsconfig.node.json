{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "../../output/tsbuildinfo/packages-bake-node.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/volume/node",
    "src/photometry",
    "src/raster",
    "src/scene",
    "src/presentation",
    "src/volume-leaves",
    "src/stars",
    "src/shell",
    "src/sky"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
