{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "outDir": "dist/types",
    "incremental": false,
    "tsBuildInfoFile": null
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
