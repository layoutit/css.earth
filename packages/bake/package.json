{
  "name": "@cssearth/bake",
  "version": "0.0.0",
  "private": true,
  "description": "Build-time preparation code, never imported by the runtime: the volume contracts, coordinates, fields, materials and sampling, the Node-only volume bake (compact inputs, slices and the compiler), the photometric models that preparation draws limbs from, the raster lane, and the geometry scene and CSS presentation compilers.",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./volume": {
      "types": "./dist/volume.d.ts",
      "import": "./dist/volume.js",
      "default": "./dist/volume.js"
    },
    "./volume/node": {
      "types": "./dist/volume/node.d.ts",
      "import": "./dist/volume/node.js",
      "default": "./dist/volume/node.js"
    },
    "./photometry": {
      "types": "./dist/photometry.d.ts",
      "import": "./dist/photometry.js",
      "default": "./dist/photometry.js"
    },
    "./raster": {
      "types": "./dist/raster.d.ts",
      "import": "./dist/raster.js",
      "default": "./dist/raster.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "import": "./dist/scene.js",
      "default": "./dist/scene.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js",
      "default": "./dist/presentation.js"
    },
    "./volume-leaves": {
      "types": "./dist/volume-leaves.d.ts",
      "import": "./dist/volume-leaves.js",
      "default": "./dist/volume-leaves.js"
    },
    "./stars": {
      "types": "./dist/stars.d.ts",
      "import": "./dist/stars.js",
      "default": "./dist/stars.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js",
      "default": "./dist/shell.js"
    },
    "./sky": {
      "types": "./dist/sky.d.ts",
      "import": "./dist/sky.js",
      "default": "./dist/sky.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cssearth/astronomy": "workspace:*",
    "@cssearth/catalog": "workspace:*",
    "@cssearth/core": "workspace:*",
    "@cssearth/engine": "workspace:*",
    "@cssearth/objects": "workspace:*",
    "@cssearth/renderer": "workspace:*",
    "@layoutit/polycss": "0.2.11",
    "playwright": "1.60.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "nebulaImplementation": {
    "directories": [
      "src/volume"
    ],
    "extensions": [
      ".ts"
    ],
    "excludedSuffixes": [
      ".test.ts"
    ]
  }
}
