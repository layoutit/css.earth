{
  "name": "@cssearth/bake",
  "version": "0.0.0",
  "private": true,
  "description": "Build-time preparation code, never imported by the runtime: the volume contracts, coordinates, fields, materials and sampling, and the Node-only volume bake (compact inputs, slices and the compiler).",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./volume": {
      "types": "./dist/volume.d.ts",
      "import": "./dist/volume.js"
    },
    "./volume/node": {
      "types": "./dist/volume/node.d.ts",
      "import": "./dist/volume/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cssearth/core": "workspace:*",
    "@cssearth/objects": "workspace:*",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "nebulaImplementation": {
    "directories": [
      "src/volume"
    ],
    "extensions": [
      ".ts"
    ],
    "excludedSuffixes": [
      ".test.ts"
    ]
  }
}
