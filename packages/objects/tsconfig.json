{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": [
      "ES2022"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "allowJs": false,
    "types": ["node"],
    "incremental": true,
    "tsBuildInfoFile": "../../output/tsbuildinfo/packages-objects.tsbuildinfo"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/node",
    "src/**/*.test.mts"
  ]
}
