{
  "name": "@cssearth/telescope",
  "version": "0.1.0",
  "description": "The telescope library: product records, PDS labels, and the archive and astronomy-package clients the workspace shares.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/layoutit/css.earth.git",
    "directory": "packages/telescope"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@cssearth/core": "workspace:*",
    "@cssearth/fits": "workspace:*",
    "@cssearth/objects": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.1",
    "typescript": "5.9.3"
  }
}
