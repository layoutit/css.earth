{
  "name": "@cssearth/telescope",
  "version": "0.1.0",
  "description": "Query and retrieve pinned telescope products with their scientific evidence.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "bin": {
    "telescope": "dist/telescope.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/layoutit/css.earth.git",
    "directory": "packages/telescope"
  },
  "scripts": {
    "build": "node build.mts && tsup",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cssearth/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  }
}
