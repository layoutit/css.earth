{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../node_modules/.pnpm/node_modules/@types"
    ]
  },
  "include": [
    "packages/**/*.test.ts",
    "packages/**/*.test.mts",
    "../../node_modules/vite/client.d.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
