{
  "schema": "cssearth-nebula-compiler@1",
  "id": "m8",
  "label": "Lagoon · M8",
  "observationRecipe": "labs/nebula/models/m8/processing-observations.json",
  "observationCatalogue": ".local/nebula-lab/observations/m8-processed/observations.json",
  "structureRecipe": "labs/nebula/models/m8/processing-structures.json",
  "structureCatalogue": ".local/nebula-lab/observations/m8-processed/structures/catalogue.json",
  "defaultSourceId": "eso-optical",
  "maximumStars": 650,
  "starCatalogue": {
    "sourceIds": ["eso-optical", "eso-vista"],
    "mergeRadiusArcsec": 3
  },
  "interpretation": "Relative display emission on one authored coherent front, with locally paper-guided topology. Foreground extinction, separate molecular clouds and unknown front/back distances are not reconstructed. Shared RGB lenses and image-detected compact lights retain one geometry; no gas velocity is converted to depth.",
  "depthRecipe": "labs/nebula/models/m8/depth-model.json",
  "defaultControls": {
    "detail": 1,
    "faint": 0.15,
    "depth": 1
  },
  "sourceWeights": {
    "eso-optical": 1,
    "eso-vista": 0.04,
    "spitzer-mid-infrared": 0.8
  },
  "targetControls": {
    "minimumWeightNormalization": 1,
    "sources": {
      "eso-optical": {
        "backgroundSpread": 0.75,
        "edgeTaperArcsec": 0
      },
      "eso-vista": {
        "backgroundSpread": 1.5,
        "edgeTaperArcsec": 180
      }
    }
  }
}
